// Generator strips full-line // comments and emits proto/fixtures/demo/agents.json.
{
  "_meta": {
    "domain": "agents",
    "description": "AgentsService demo seed — index, summaries, detail, get (raw doc), wire canvas, settings, catalogs, templates, permission presets, harnesses, sessions, watch stream, control results, CRUD mutations, canvas writes, errors, and empty states. Three agents from the harbor project on feat/checkout-flow."
