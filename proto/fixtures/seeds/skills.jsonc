  // q="checkout" filter — 2 project-scope task matches.
  "Summaries.filtered_q_checkout": {
    "q": "checkout",
    "kind": "",
    "tag": "",
    "groups": [
      {
        "scope": "project",
        "kinds": [
          {
            "kind": "task",
            "count": 2,
            "skills": [
              {
                "id": "checkout-validator",
                "name": "Checkout Validator",
                "description": "Validates the checkout service implementation against the contract spec.",
                "tags": ["checkout", "validation", "task"]
              },
              {
                "id": "code-review",
