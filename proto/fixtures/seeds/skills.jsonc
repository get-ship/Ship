                "tags": ["checkout", "validation", "task"]
              },
              {
                "id": "code-review",
                "name": "Code Review",
                "description": "Review a unified diff for correctness, security, and architecture drift.",
                "tags": ["review", "task", "quality"]
              },
              {
                "id": "run",
                "name": "Run",
                "description": "Launch and drive this project's app to see a change working.",
                "tags": ["run", "task", "dev"]
              }
            ]
          },
          {
            "kind": "reference",
            "count": 2,
            "skills": [
              {
                "id": "ship-architecture",
                "name": "Ship Architecture",
                "description": "Architecture reference for the four-layer Ship system.",
                "tags": ["reference", "architecture", "docs"]
              },
              {
                "id": "commit-style",
                "name": "Commit Style",
                "description": "Commit message conventions — type(scope): subject, body, footer.",
                "tags": ["reference", "git", "style"]
              }
            ]
          },
          {
            "kind": "workflow",
            "count": 1,
            "skills": [
              {
                "id": "deep-research",
                "name": "Deep Research",
                "description": "Fan-out web searches, fetch sources, adversarially verify claims, synthesize a cited report.",
                "tags": ["research", "workflow", "docs"]
              }
            ]
          }
        ]
      },
      {
        "scope": "user",
        "kinds": [
          {
            "kind": "task",
            "count": 1,
            "skills": [
              {
                "id": "verify",
                "name": "Verify",
                "description": "Verify that a code change actually does what it is supposed to by running the app and observing behavior.",
                "tags": ["verify", "task", "test"]
              }
            ]
          },
          {
            "kind": "workflow",
            "count": 2,
            "skills": [
              {
                "id": "spawn-agent",
                "name": "Spawn Agent",
                "description": "Dispatch a job to a specialist agent in a git worktree. Write the spec, create the worktree, launch the agent.",
                "tags": ["dispatch", "workflow", "agent"]
