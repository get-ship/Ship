// Skills domain seed — realistic demo values for the ship-skills-* component pack.
// World: 'harbor' project mid-feature on feat/checkout-flow; agents rust-lane + code-reviewer.
// Generator strips full-line // comments and emits proto/fixtures/demo/skills.json.
{
  "_meta": {
    "domain": "skills",
    "description": "Skill index + rail summaries (unfiltered + q-filtered) + 3 full detail shapes (task/reference/workflow) + SKILL.md and script file responses + mutations (Create/Rename/Duplicate/MoveScope/Delete) + scaffold results for all three shape templates + live stream (snapshot → 2 appends → 1 remove → heartbeat) + empty and error states."
  },

  // ── SkillsService.List → SkillsIndexResponse ────────────────────────────────
  // 9 entries: 6 project scope (task×3, reference×2, workflow×1) + 3 user scope (task×1, workflow×2).
  // Matches the index the rail populates before grouping by kind.

  "List.response": {
    "items": [
      { "id": "checkout-validator", "scope": "project" },
      { "id": "code-review",        "scope": "project" },
      { "id": "run",                "scope": "project" },
      { "id": "deep-research",      "scope": "project" },
      { "id": "ship-architecture",  "scope": "project" },
      { "id": "commit-style",       "scope": "project" },
      { "id": "verify",             "scope": "user" },
      { "id": "spawn-agent",        "scope": "user" },
      { "id": "cmdr",               "scope": "user" }
    ]
  },

  // ── SkillsService.Summaries → JsonResponse (decoded payload) ────────────────
  // Rail shape: grouped by scope then kind; kind counts; flat tag cloud.
  // Two variants: unfiltered (all 9 skills) and q="checkout" (2 matches).

  "Summaries.unfiltered": {
    "q": "",
    "kind": "",
    "tag": "",
    "groups": [
