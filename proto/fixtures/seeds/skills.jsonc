                "description": "Review a unified diff for correctness, security, and architecture drift.",
                "tags": ["review", "task", "quality"]
              }
            ]
          }
        ]
      }
    ],
    "total": 2,
    "tags": ["checkout", "validation", "task", "review", "quality"]
  },

  // ── SkillsService.Detail → JsonResponse (decoded payload) ───────────────────
  // Three full detail shapes covering task / reference / workflow kinds.

  // (a) checkout-validator: task skill, 2 vars, 1 extra script file.
  "Detail.checkout_validator": {
    "id": "checkout-validator",
    "scope": "project",
    "kind": "task",
    "name": "Checkout Validator",
    "description": "Validates the checkout service implementation against the contract spec.",
    "audience": "agent",
    "tags": ["checkout", "validation", "task"],
    "authors": ["Ada Lovelace <ada@getship.dev>"],
    "vars": {
      "model_override": "claude-opus-4-7",
      "max_files": 20
    },
    "files": [
      { "path": "SKILL.md",           "name": "SKILL.md",      "ext": "md" },
      { "path": "scripts/validate.sh", "name": "validate.sh",  "ext": "sh" }
    ],
    "updated_at": "2026-05-31T22:10:00Z"
  },

  // (b) ship-architecture: reference skill, no vars, SKILL.md + references/ dir (2 docs).
  "Detail.ship_architecture": {
    "id": "ship-architecture",
    "scope": "project",
    "kind": "reference",
    "name": "Ship Architecture",
    "description": "Architecture reference for the four-layer Ship system.",
    "audience": "agent",
    "tags": ["reference", "architecture", "docs"],
    "authors": [],
    "vars": {},
    "files": [
      { "path": "SKILL.md",                      "name": "SKILL.md",       "ext": "md" },
      { "path": "references/layer-map.md",        "name": "layer-map.md",   "ext": "md" },
      { "path": "references/adr-index.md",        "name": "adr-index.md",   "ext": "md" }
    ],
    "updated_at": "2026-05-24T10:00:00Z"
  },

  // (c) deep-research: workflow skill, no vars, 4 files across prompts/ and scripts/.
  "Detail.deep_research": {
    "id": "deep-research",
    "scope": "project",
    "kind": "workflow",
    "name": "Deep Research",
    "description": "Fan-out web searches, fetch sources, adversarially verify claims, synthesize a cited report.",
    "audience": "agent",
    "tags": ["research", "workflow", "docs"],
    "authors": ["Ada Lovelace <ada@getship.dev>"],
    "vars": {},
    "files": [
      { "path": "SKILL.md",             "name": "SKILL.md",       "ext": "md" },
      { "path": "prompts/fan-out.md",   "name": "fan-out.md",     "ext": "md" },
      { "path": "prompts/synthesis.md", "name": "synthesis.md",   "ext": "md" },
      { "path": "scripts/fetch.sh",     "name": "fetch.sh",       "ext": "sh" }
    ],
    "updated_at": "2026-05-30T14:22:00Z"
  },

  // ── SkillsService.File → SkillFileResponse ──────────────────────────────────
  // Content is HTML-escaped (& → &amp;  < → &lt;  > → &gt;  " → &quot;).
  // Four responses: SKILL.md for each of the three detail skills + the validate.sh script.

  "File.checkout_validator_SKILL_md": {
    "path": "SKILL.md",
    "name": "SKILL.md",
    "ext": "md",
    "content": "---\nname: Checkout Validator\nkind: task\ndescription: Validates the checkout service implementation against the contract spec.\naudience: agent\ntags: [checkout, validation, task]\nauthors:\n  - Ada Lovelace &lt;ada@getship.dev&gt;\n---\n\n# Checkout Validator\n\nValidate that the checkout service satisfies the happy-path contract test.\n\n## Steps\n\n1. Read `crates/core/ship-platform/src/services/checkout.rs`.\n2. Run `cargo test -p ship-platform checkout` and capture output.\n3. If any test fails, identify the gap and surface a concise report.\n4. If all tests pass, emit a short &quot;green&quot; confirmation with the coverage line count.\n\n## Variables\n\n- `model_override` — harness model override (default: `claude-opus-4-7`)\n- `max_files` — maximum source files to read per run (default: `20`)\n"
  },

  "File.ship_architecture_SKILL_md": {
    "path": "SKILL.md",
    "name": "SKILL.md",
    "ext": "md",
    "content": "---\nname: Ship Architecture\nkind: reference\ndescription: Architecture reference for the four-layer Ship system.\naudience: agent\ntags: [reference, architecture, docs]\n---\n\n# Ship Architecture\n\nFour layers:\n\n| Layer | Name | Role |\n|-------|------|------|\n| L0 | substrate | event log, actor kernel, supervisor |\n| L1 | platform | compiler, registry, sessions, agents |\n| L2 | built-in apps | shipd daemon, shell, gateway |\n| L3 | user apps | skills, views, pipelines, collections |\n\nL2 has **no privileged access** — it consumes the same SDK as L3.\n\nSee `references/layer-map.md` for the full module map and `references/adr-index.md` for architectural decisions that constrain future work.\n"
  },

  "File.deep_research_SKILL_md": {
    "path": "SKILL.md",
    "name": "SKILL.md",
    "ext": "md",
    "content": "---\nname: Deep Research\nkind: workflow\ndescription: Fan-out web searches, fetch sources, adversarially verify claims, synthesize a cited report.\naudience: agent\ntags: [research, workflow, docs]\nauthors:\n  - Ada Lovelace &lt;ada@getship.dev&gt;\n---\n\n# Deep Research\n\nMulti-source, fact-checked research harness.\n\n## Workflow\n\n1. **Clarify** — confirm scope is specific enough; ask 2-3 questions if underspecified.\n2. **Fan-out** — generate 4-6 search queries covering different angles (see `prompts/fan-out.md`).\n3. **Fetch** — retrieve top sources per query via `scripts/fetch.sh`.\n4. **Verify** — adversarially check key claims against each other; note disagreements.\n5. **Synthesize** — write a cited report following `prompts/synthesis.md`.\n"
  },

  // validate.sh — extra file for the task skill; exercises ext=sh in the file tree.
  "File.checkout_validator_validate_sh": {
    "path": "scripts/validate.sh",
    "name": "validate.sh",
    "ext": "sh",
    "content": "#!/usr/bin/env bash\nset -euo pipefail\n\n# validate.sh - run the checkout service contract tests and emit a summary.\n# Called by the checkout-validator skill; run from the repo root.\n\nCARGO_FLAGS=&quot;--quiet&quot;\nPKG=&quot;ship-platform&quot;\nFILTER=&quot;checkout&quot;\n\necho &quot;=== checkout-validator: running tests ===&quot;\ncargo test ${CARGO_FLAGS} -p ${PKG} ${FILTER}\nSTATUS=$?\necho &quot;=== done (exit ${STATUS}) ===&quot;\nexit ${STATUS}\n"
  },

  // ── ScopedMutation — one per write surface ───────────────────────────────────
  // Covers the full write surface: Create, Rename, Duplicate, MoveScope,
  // WriteFrontmatter, WriteBody, WriteFile, DeleteFile, Delete.

  "mutations": {
    "Create":           { "id": "checkout-validator", "scope": "project" },
    "Rename":           { "id": "diff-review",         "scope": "project" },
    "Duplicate":        { "id": "code-review-copy",    "scope": "project" },
    "MoveScope":        { "id": "verify",              "scope": "project" },
    "WriteFrontmatter": { "id": "checkout-validator",  "scope": "project" },
    "WriteBody":        { "id": "checkout-validator",  "scope": "project" },
    "WriteFile":        { "id": "checkout-validator",  "scope": "project" },
    "DeleteFile":       { "id": "checkout-validator",  "scope": "project" },
    "Delete":           { "id": "verify",              "scope": "user" }
  },

  // ── SkillScaffoldResponse — one per shape template ──────────────────────────

  "Scaffold.task": {
    "route": "/skills/checkout-validator",
    "path": "/home/dev/harbor/.ship/skills/checkout-validator/SKILL.md"
  },

  "Scaffold.reference": {
    "route": "/skills/harbor-notes",
    "path": "/home/dev/harbor/.ship/skills/harbor-notes/SKILL.md"
  },

  "Scaffold.workflow": {
    "route": "/skills/feature-lane",
    "path": "/home/dev/harbor/.ship/skills/feature-lane/SKILL.md"
  },

  // ── Live stream (ListLive / SummariesLive JsonResponse frames) ───────────────
  // Sequence: snapshot (7 skills) → append (deep-research by rust-lane) →
  // append (cmdr at user scope) → remove (code-review-copy deleted) → heartbeat.

  "live_stream": {
    "frames": [
      {
        "seq": 1,
        "kind": "snapshot",
        "items": [
          { "id": "checkout-validator", "scope": "project" },
          { "id": "code-review",        "scope": "project" },
          { "id": "run",                "scope": "project" },
          { "id": "ship-architecture",  "scope": "project" },
          { "id": "commit-style",       "scope": "project" },
          { "id": "verify",             "scope": "user" },
          { "id": "spawn-agent",        "scope": "user" }
        ]
      },
      {
        "seq": 2,
        "kind": "append",
        "_why": "rust-lane scaffolded deep-research mid-session",
        "item": { "id": "deep-research", "scope": "project" }
      },
      {
        "seq": 3,
        "kind": "append",
        "_why": "user installed cmdr at user scope",
        "item": { "id": "cmdr", "scope": "user" }
      },
      {
        "seq": 4,
        "kind": "remove",
        "_why": "code-review-copy deleted after being merged back into code-review",
        "id": "code-review-copy",
        "scope": "project"
      },
      {
        "seq": 5,
        "kind": "heartbeat",
        "ts": "2026-05-31T22:45:00Z"
      }
    ]
  },

  // ── Empty states ─────────────────────────────────────────────────────────────

  "empty_states": {
    "no_skills": {
      "list_response": { "items": [] },
      "prompt": "No skills yet — scaffold your first",
      "cta": "Scaffold skill"
    },
    "empty_filtered": {
      "summaries_response": {
        "q": "payment-gateway",
        "kind": "",
        "tag": "",
        "groups": [],
        "total": 0,
        "tags": []
      },
      "prompt": "No skills match this filter",
      "cta": "Clear filters"
    }
  },

  // ── Error states ─────────────────────────────────────────────────────────────

  "errors": {
    "retryable_network": {
      "rpc": "List",
      "tone": "destructive",
      "retryable": true,
      "message": "Failed to read skill index: connection to daemon lost. Check that shipd is running."
    },
    "id_collision_create": {
      "rpc": "Create",
      "tone": "warning",
      "retryable": false,
      "message": "Skill 'code-review' already exists in project scope. Choose a different id or duplicate the existing skill."
    },
    "scope_not_found_get": {
      "rpc": "Get",
      "tone": "destructive",
      "retryable": false,
      "message": "Skill 'checkout-validator' not found in user scope. It exists in project scope — omit the scope parameter to walk project then user."
    }
  }
}
