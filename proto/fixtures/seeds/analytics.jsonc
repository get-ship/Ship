  // ── Empty states ─────────────────────────────────────────────────────────────
  // UI copy for the zero-data surfaces each component must handle.

  "empty_states": {
    "no_sessions": {
      "rpc": "ListSessions",
      "sessions": [],
      "title": "No sessions recorded yet.",
      "body": "Sessions appear here once an agent runs."
    },
    "no_sessions_filtered": {
      "rpc": "ListSessions",
      "sessions": [],
      "title": "No sessions match the current filter.",
      "cta": "Clear filter"
    },
    "no_tools": {
      "rpc": "ToolUsage",
      "tools": [],
      "title": "No tool calls recorded yet.",
      "body": "Tool usage aggregates here once agents start calling tools."
    },
    "no_tools_since": {
      "rpc": "ToolUsage",
      "tools": [],
      "title": "No tool calls in this time window.",
      "cta": "Clear date filter"
    }
  },

  // ── Error states ─────────────────────────────────────────────────────────────
  // Non-OK gRPC statuses the UI error banner must render with a retry affordance.

  "errors": {
    "projection_rebuilding": {
      "rpc": "ListSessions",
      "grpc_status": "UNAVAILABLE",
      "tone": "retryable",
      "message": "Analytics projection is rebuilding after a space restore. Retry in a moment."
    },
    "invalid_since_timestamp": {
      "rpc": "ToolUsage",
      "grpc_status": "INVALID_ARGUMENT",
      "tone": "warning",
      "message": "Invalid 'since' value: '2026-13-01T00:00:00Z' is not a valid RFC3339 timestamp."
    },
    "session_turns_not_found": {
      "rpc": "SessionTurns",
      "grpc_status": "NOT_FOUND",
      "tone": "destructive",
      "message": "Session 'sess-rust-lane-missing' not found."
    }
  }
}
