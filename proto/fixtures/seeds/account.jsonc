// Account domain seed — realistic demo values for the ship-account-* component pack.
// World: 'harbor' project on feat/checkout-flow; operator identity = Ada Lovelace.
// Generator strips full-line // comments and emits proto/fixtures/demo/account.json.
{
  "_meta": {
    "domain": "account",
    "description": "Ship Cloud identity — logged-out, pending PKCE, logged-in (avatar + initials variants). Covers all four AccountService RPCs plus error + empty states."
  },

  // ── AccountService.State ─────────────────────────────────────────────────────
  // Four status variants the ship-account-card orchestrates.

  "State.logged_out": {
    "status": "LOGGED_OUT",
    "user_id": "",
    "state_id": "",
    "me": null
  },

  "State.pending": {
    "status": "PENDING",
    "user_id": "",
    "state_id": "st_a1b2c3d4",
    "me": null
  },

  // LOGGED_IN — Me fully populated including image URL (avatar render path).
  "State.logged_in_with_avatar": {
    "status": "LOGGED_IN",
    "user_id": "usr_7Fk2Qd",
    "state_id": "",
    "me": {
      "id": "usr_7Fk2Qd",
      "name": "Ada Lovelace",
      "email": "ada@getship.dev",
      "image": "https://avatars.getship.dev/usr_7Fk2Qd/avatar.png"
    }
  },

  // LOGGED_IN — Me.image empty string → initials-fallback path ("AL").
  "State.logged_in_initials": {
    "status": "LOGGED_IN",
    "user_id": "usr_7Fk2Qd",
    "state_id": "",
    "me": {
      "id": "usr_7Fk2Qd",
      "name": "Ada Lovelace",
      "email": "ada@getship.dev",
      "image": ""
    }
  },

  // ── AccountService.Login ─────────────────────────────────────────────────────
  // LoginStarted — PKCE start; shell opens browser_url; state_id held for LoginComplete.

  "Login.started": {
    "state_id": "st_a1b2c3d4",
    "browser_url": "https://api.getship.dev/v1/auth/cli?code_challenge=Xq9kRmP4&code_challenge_method=S256&redirect_uri=http%3A%2F%2F127.0.0.1%3A51763%2Fcallback&state=st_a1b2c3d4"
  },

  // ── AccountService.LoginComplete ────────────────────────────────────────────

  // LoginCompleted — Me populated; normal happy path.
  "LoginComplete.with_identity": {
    "user_id": "usr_7Fk2Qd",
    "me": {
      "id": "usr_7Fk2Qd",
      "name": "Ada Lovelace",
      "email": "ada@getship.dev",
      "image": "https://avatars.getship.dev/usr_7Fk2Qd/avatar.png"
    }
  },

  // LoginCompleted — me absent (gateway returned identity unavailable; still a success).
  "LoginComplete.no_identity": {
    "user_id": "usr_7Fk2Qd",
    "me": null
  },

  // ── AccountService.Logout ────────────────────────────────────────────────────

  // Normal: token was present, gateway key revoked cleanly.
  "Logout.clean": {
    "had_token": true,
    "key_revoked": true
  },

  // Offline logout: token cleared locally, gateway unreachable — key may still be live.
  "Logout.offline": {
    "had_token": true,
    "key_revoked": false
  },

  // Idempotent: already logged out when Logout was called.
  "Logout.already_out": {
    "had_token": false,
    "key_revoked": false
  },

  // ── Error states ─────────────────────────────────────────────────────────────
  // These are not proto response messages — they describe the UI error surface
  // the component renders when an RPC fails. Keyed for the designer.

  "errors": {
    "state_daemon_unreachable": {
      "rpc": "State",
      "tone": "destructive",
      "message": "Couldn't reach the Ship daemon. Make sure shipd is running.",
      "retry": true
    },
    "login_c2_refused": {
      "rpc": "Login",
      "tone": "destructive",
      "message": "Operator credentials required to connect Ship Cloud.",
      "retry": false
    },
    "login_complete_expired": {
      "rpc": "LoginComplete",
      "tone": "warning",
      "message": "Login session expired or state was not found. Start a new login.",
      "retry": true
    }
  },

  // ── Empty state copy ─────────────────────────────────────────────────────────
  // Rendered by ship-account-card when State returns LOGGED_OUT.

  "empty_states": {
    "logged_out": {
      "title": "Not connected",
      "body": "Connect this workspace to Ship Cloud to enable cloud sync and agent billing.",
      "cta": "Connect to Ship Cloud"
    }
  }
}
