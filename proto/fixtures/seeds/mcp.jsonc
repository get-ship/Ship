// MCP domain seed — realistic demo values for the ship-mcp-* component pack.
// World: 'harbor' project mid-feature on feat/checkout-flow; agents rust-lane + code-reviewer; operator = Ada Lovelace.
// Four registered MCP servers: ship (project/stdio), github (user/stdio), linear (project/http), filesystem (user/stdio).
// Generator strips full-line // comments and emits proto/fixtures/demo/mcp.json.
{
  "_meta": {
    "domain": "mcp",
    "description": "McpService List / Get / Create / Put / Patch / Delete. Covers the registry list (two scopes, two transport types), full entry detail (stdio + http), all six mutation echoes (ScopedMutation), scope-filtered empty state, and all error surfaces the ship-mcp-* pack must render."
  },

  // ── McpService.List → McpIndexResponse ──────────────────────────────────────
  // 4 entries: 2 project scope (ship/stdio, linear/http) + 2 user scope (github/stdio, filesystem/stdio).
  // The list panel renders id + scope badge + transport type extracted from the entry body.
  // Transport type is NOT in McpIndexResponse — the component reads it from the entry body via Get on selection.
  // The seed marks each entry with a _transport hint so the designer can model the row chip without a live Get.

  "List.response": {
    "items": [
      { "id": "ship",       "scope": "project" },
      { "id": "linear",     "scope": "project" },
      { "id": "github",     "scope": "user" },
      { "id": "filesystem", "scope": "user" }
    ]
  },

  // Annotated list — same items with _transport hints for the row-chip mockup.
  // NOT a proto response; use for design only.
  "List.annotated": {
    "items": [
      { "id": "ship",       "scope": "project", "_transport": "stdio" },
      { "id": "linear",     "scope": "project", "_transport": "http" },
      { "id": "github",     "scope": "user",    "_transport": "stdio" },
      { "id": "filesystem", "scope": "user",    "_transport": "stdio" }
    ]
  },

  // Scope-filtered: project only (ship-mcp-scope-filter set to project).
  "List.filtered_project": {
    "items": [
      { "id": "ship",   "scope": "project" },
      { "id": "linear", "scope": "project" }
    ]
  },

  // Scope-filtered: user only.
  "List.filtered_user": {
    "items": [
      { "id": "github",     "scope": "user" },
      { "id": "filesystem", "scope": "user" }
    ]
  },

  // ── McpService.Get → JsonResponse ───────────────────────────────────────────
  // json field carries the raw MCP server config body (the server_json stored on disk).
  // UI decodes json before rendering the detail panel and the entry-form in Put mode.
  // Two entries shown: ship (stdio) and linear (http) — exercises both transport displays.

  // ship — stdio transport. json is the serialized server_json body.
  "Get.response_ship": {
    "json": "{\"name\":\"Ship\",\"type\":\"stdio\",\"command\":\"ship\",\"args\":[\"mcp\",\"serve\"]}"
  },

  // Decoded form of Get.response_ship — how ship-mcp-detail renders it.
  // NOT a proto message; designer-readable only.
  "Get.decoded_ship": {
    "id": "ship",
    "scope": "project",
    "name": "Ship",
    "type": "stdio",
    "command": "ship",
    "args": ["mcp", "serve"]
  },

  // linear — http transport. Includes url + auth header (value redacted in display).
  "Get.response_linear": {
    "json": "{\"name\":\"Linear\",\"type\":\"http\",\"url\":\"https://mcp.linear.app/v1\",\"headers\":{\"Authorization\":\"Bearer lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}}"
  },

  // Decoded form of Get.response_linear.
  "Get.decoded_linear": {
    "id": "linear",
    "scope": "project",
    "name": "Linear",
    "type": "http",
    "url": "https://mcp.linear.app/v1",
    "headers": {
      "Authorization": "Bearer lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  },

  // github — user scope / stdio. gh CLI extension pattern.
  "Get.response_github": {
    "json": "{\"name\":\"GitHub\",\"type\":\"stdio\",\"command\":\"gh\",\"args\":[\"mcp\",\"serve\"]}"
  },

  // Decoded form of Get.response_github.
  "Get.decoded_github": {
    "id": "github",
    "scope": "user",
    "name": "GitHub",
    "type": "stdio",
    "command": "gh",
    "args": ["mcp", "serve"]
  },

  // filesystem — user scope / stdio. Standard MCP filesystem server.
  "Get.response_filesystem": {
    "json": "{\"name\":\"Filesystem\",\"type\":\"stdio\",\"command\":\"npx\",\"args\":[\"-y\",\"@modelcontextprotocol/server-filesystem\",\"/home/dev\"]}"
  },

  // ── McpService.Create → ScopedMutation ──────────────────────────────────────
  // Echoes the id and resolved scope after registering a new server.
  // Example: operator registers a new 'postgres' server at project scope.

  "Create.response": {
    "id": "postgres",
    "scope": "project"
  },

  // The server_json body that was sent in CreateMcpRequest (for the form pre-fill in Put mode).
  "Create.request_body_decoded": {
    "name": "Postgres",
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/harbor_dev"]
  },

  // ── McpService.Put → ScopedMutation ─────────────────────────────────────────
  // Echoes id + scope after replacing an existing server's full config.
  // Example: operator replaces ship's args to add --verbose.

  "Put.response": {
    "id": "ship",
    "scope": "project"
  },

  // ── McpService.Patch → ScopedMutation ───────────────────────────────────────
  // Echoes id + scope after applying RFC-6902 ops to the config body.
  // Example: operator patches linear's auth header in place.

  "Patch.response": {
    "id": "linear",
    "scope": "project"
  },

  // The patch_json sent in PatchMcpRequest (for the patch editor mockup).
  "Patch.request_patch_json_decoded": [
    {
      "op": "replace",
      "path": "/headers/Authorization",
      "value": "Bearer lin_api_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
    }
  ],

  // ── McpService.Delete → ScopedMutation ──────────────────────────────────────
  // Echoes id + scope of the removed server.

  "Delete.response": {
    "id": "postgres",
    "scope": "project"
  },

  // ── Empty state ──────────────────────────────────────────────────────────────
  // McpIndexResponse with zero items — first-run or all servers removed.
  // ship-mcp-registry renders sui-empty-state with primary CTA 'Add server'.

  "empty_state": {
    "items": [],
    "_copy": {
      "title": "No MCP servers registered",
      "body": "Add an external MCP server to make its tools available to agents.",
      "cta": "Add server"
    }
  },

  // Scope-filtered empty state — scope filter active but no servers in that scope.
  "empty_state_filtered_user": {
    "items": [],
    "_copy": {
      "title": "No servers in user scope",
      "body": "Add a user-scoped server, or switch the filter to project.",
      "cta": "Add to user"
    }
  },

  // ── Error states ─────────────────────────────────────────────────────────────
  // NOT proto response messages — describe the error surface each RPC failure renders.
  // Write-op errors surface inline in the form, not as page-level errors (ui-spec §5).

  "errors": {
    "already_exists": {
      "rpc": "Create",
      "tone": "warning",
      "retryable": false,
      "message": "Server id 'ship' is already registered in project scope. Choose a different id or use Put to replace the existing entry.",
      "_trigger": "CreateMcpRequest with an id already present in the target scope"
    },
    "not_found_get": {
      "rpc": "Get",
      "tone": "destructive",
      "retryable": false,
      "message": "Server 'postgres' not found. It may have been removed or the scope walk (project → user) found no match.",
      "_trigger": "GetMcpRequest for an id not registered in either scope"
    },
    "not_found_delete": {
      "rpc": "Delete",
      "tone": "destructive",
      "retryable": false,
      "message": "Server 'postgres' not found in project scope. It may have already been removed.",
      "_trigger": "DeleteMcpRequest with explicit scope and no matching entry"
    },
    "bad_id": {
      "rpc": "Create",
      "tone": "warning",
      "retryable": true,
      "message": "Invalid server id 'my server!'. Ids must be lowercase alphanumeric with hyphens only (e.g. 'my-server').",
      "_trigger": "CreateMcpRequest with an id containing spaces or disallowed characters"
    },
    "invalid_patch_json": {
      "rpc": "Patch",
      "tone": "warning",
      "retryable": true,
      "message": "patch_json is not valid RFC-6902. Expected an array of operation objects.",
      "_trigger": "PatchMcpRequest with malformed patch_json"
    },
    "list_retryable": {
      "rpc": "List",
      "tone": "destructive",
      "retryable": true,
      "message": "Failed to read MCP registry: connection to daemon lost. Check that shipd is running.",
      "_trigger": "Network or daemon-down condition during List; Retry button re-calls the RPC"
    }
  }
}
