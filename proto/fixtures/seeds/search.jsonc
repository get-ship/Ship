// Search domain seed — realistic demo values for the ship-search-* component pack.
// World: 'harbor' project mid-feature on branch feat/checkout-flow; operator = Ada Lovelace.
// Agents: rust-lane (active) + code-reviewer. Query anchor: "checkout".
// Generator strips full-line // comments and emits proto/fixtures/demo/search.json.
{
  "_meta": {
    "domain": "search",
    "description": "Universal entity search across all seven kinds. Covers: mixed-kind ok result, COLLECTION_ITEM with collection_id, GLOBAL hits with space_id, paginated first/second page, kind-filtered result, empty-filtered state, error state."
  },

  // ── SearchService.Search — mixed kinds, THIS_SPACE, query "checkout" ──────────
  // The canonical palette view: all seven EntityKind values in one ranked list.
  // Scores are plausible BM25 + recency values the scorer might emit.

  "Search.mixed_kinds": {
    "hits": [
      {
        "kind": "ENTITY_KIND_COLLECTION_ITEM",
        "id": "note-checkout-notes",
        "label": "Checkout service notes",
        "path": "/collections/notes/note-checkout-notes",
        "icon": "file-text",
        "snippet": "Auth via JWT; idempotency key on POST /checkout.",
        "score": 0.95,
        "collection_id": "notes",
        "space_id": ""
      },
      {
        "kind": "ENTITY_KIND_VIEW",
        "id": "checkout-summary",
        "label": "Checkout Summary",
        "path": "/views/checkout-summary",
        "icon": "layout",
        "snippet": "Live summary of checkout service metrics and recent sessions.",
        "score": 0.91,
        "collection_id": "",
