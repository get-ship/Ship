  // ── Search.kind_filtered — AGENT kind only ───────────────────────────────────
  // Query "lane", kinds=[ENTITY_KIND_AGENT]. The filter bar drives this.
  // Exercises ship-search-filter-bar narrowing the palette to one kind.

  "Search.kind_filtered_agents": {
    "hits": [
      {
        "kind": "ENTITY_KIND_AGENT",
        "id": "rust-lane",
        "label": "Rust Lane",
        "path": "/.ship/agents/rust-lane.md",
        "icon": "hammer",
