  // ── Search.empty — no hits, query had results possible but none match ─────────
  // Exercises the empty-filtered state: "No results for <q>" copy + broaden hint.
  // Triggered when hits=[] and next_cursor="".

  "Search.empty_filtered": {
    "hits": [],
    "next_cursor": ""
  },

  // ── Error states ──────────────────────────────────────────────────────────────
  // Not proto response messages — describe the UI error surface when Search fails.
  // ship-search-palette renders these inline with a Retry action.

  "errors": {
    "network_timeout": {
      "rpc": "Search",
      "tone": "destructive",
      "message": "Search timed out. Check your connection and try again.",
      "retry": true
    },
    "daemon_unreachable": {
      "rpc": "Search",
      "tone": "destructive",
      "message": "Couldn't reach the Ship daemon. Make sure shipd is running.",
      "retry": true
    },
    "permission_denied": {
      "rpc": "Search",
      "tone": "warning",
      "message": "You don't have permission to search this space.",
      "retry": false
    }
  },

  // ── Empty states ──────────────────────────────────────────────────────────────
  // UI copy rendered by ship-search-palette for no-query and filtered-no-results states.

  "empty_states": {
    "idle": {
      "title": "Jump to anything",
      "body": "Type to search views, collections, agents, skills, sessions, and artifacts."
    },
    "empty_filtered": {
      "title": "No results for \"checkout ui\"",
      "body": "Try broadening the kind filter or searching across all spaces.",
      "cta": "Search all spaces"
    }
  }
}
