        "label": "Rust Lane",
        "path": "/.ship/agents/rust-lane.md",
        "icon": "hammer",
        "snippet": "Full Rust implementation lane — compiler, runtime, MCP server.",
        "score": 0.82,
        "collection_id": "",
        "space_id": ""
      },
      {
        "kind": "ENTITY_KIND_SKILL",
        "id": "code-review",
        "label": "code-review",
        "path": "/.ship/skills/code-review/SKILL.md",
        "icon": "git-pull-request",
        "snippet": "Reviews diffs for security, correctness, and architecture drift.",
        "score": 0.74,
        "collection_id": "",
        "space_id": ""
      },
      {
        "kind": "ENTITY_KIND_SESSION",
        "id": "sess-rust-lane-1",
        "label": "rust-lane · feat/checkout-flow",
        "path": "/sessions/sess-rust-lane-1",
        "icon": "terminal",
        "snippet": "Completed 30 min ago · 42 tool calls · exit 0.",
        "score": 0.68,
        "collection_id": "",
        "space_id": ""
