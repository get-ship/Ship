// Pipelines domain seed — realistic demo values for the ship-pipelines-* component pack.
// World: 'harbor' project on feat/checkout-flow; agents rust-lane + code-reviewer.
// Run shapes are shown DECODED (JsonResponse carries opaque JSON; the designer reads the decoded form).
// Generator strips full-line // comments and emits proto/fixtures/demo/pipelines.json.
{
  "_meta": {
    "domain": "pipelines",
    "description": "Pipelines control plane for the harbor project: 4-entry catalog (ship-feature + code-review at project scope; ship-fix + audit-cycle at user scope), one active run of ship-feature for the checkout-flow spec, a completed run with 3 steps, 8-row paginated history, live stream frames, dispatch + step-done acks, Put/Patch/Delete mutations at both scopes, plus all error and empty states."
  },

  // ── List.response ─────────────────────────────────────────────────────────
  // PipelinesIndexResponse {items: IndexEntry[]}.
  // Consumed by ship-pipelines-list. 4 entries; project scope first, user scope last.

  "List.response": {
    "items": [
      { "id": "ship-feature", "scope": "project" },
      { "id": "code-review",  "scope": "project" },
      { "id": "ship-fix",     "scope": "user" },
      { "id": "audit-cycle",  "scope": "user" }
    ]
  },

  // ── Summaries.response ────────────────────────────────────────────────────
  // JsonResponse carrying the index-view shape: per-pipeline summary with active-run pill,
  // last-run status, run count, and agent list.
  // ship-feature: active run running. ship-fix: last run failed. audit-cycle: no runs.

  "Summaries.response": {
    "items": [
      {
        "id": "ship-feature",
        "scope": "project",
        "name": "ship-feature",
        "description": "End-to-end feature lane: implement, review, gate.",
        "step_count": 3,
        "agents": ["rust-lane", "code-reviewer"],
        "active_run": {
          "id": "run-checkout-flow-a1b2c3",
          "slug": "checkout-flow-a1b2c3",
          "status": "running",
          "current_step": "implement",
          "started_at": "2026-05-24T18:00:00Z",
          "agent": "rust-lane"
        },
        "last_completed_run": {
          "id": "run-checkout-flow-prev",
          "status": "completed",
          "completed_at": "2026-05-24T16:00:00Z",
          "duration_ms": 7200000
        },
        "run_count": 7,
        "failed_count": 1
      },
      {
        "id": "code-review",
        "scope": "project",
        "name": "code-review",
        "description": "Review a diff for correctness, security, and architecture drift.",
        "step_count": 2,
        "agents": ["code-reviewer"],
        "active_run": null,
        "last_completed_run": {
          "id": "run-code-review-001",
          "status": "completed",
          "completed_at": "2026-05-24T16:05:00Z",
          "duration_ms": 300000
        },
        "run_count": 4,
        "failed_count": 0
      },
      {
        "id": "ship-fix",
        "scope": "user",
        "name": "ship-fix",
        "description": "Fast-path fix lane: diagnose, implement, verify.",
        "step_count": 3,
        "agents": ["rust-lane"],
        "active_run": null,
        "last_completed_run": {
          "id": "run-ship-fix-003",
          "status": "failed",
          "completed_at": "2026-05-23T14:20:00Z",
          "duration_ms": 2880000
        },
        "run_count": 3,
        "failed_count": 1
      },
      {
        "id": "audit-cycle",
        "scope": "user",
        "name": "audit-cycle",
        "description": "Periodic codebase audit: scan, report, triage.",
        "step_count": 3,
        "agents": ["rust-lane"],
        "active_run": null,
        "last_completed_run": null,
        "run_count": 0,
        "failed_count": 0
      }
    ]
  },

  // ── SummariesLive.stream ──────────────────────────────────────────────────
  // Stream frames for the catalog sidebar (ship-pipelines-list + ship-pipelines-card).
  // Frame 1: full snapshot. Frame 2: implement step done, review step starts.
  // Frame 3: run completes, active_run pill clears.

  "SummariesLive.stream": {
    "frames": [
      {
        "seq": 1,
        "kind": "snapshot",
        "_note": "same shape as Summaries.response; omitted here to avoid duplication",
        "patches": [
          { "op": "set", "path": "", "value": "<see Summaries.response above>" }
        ]
      },
      {
        "seq": 2,
        "kind": "patch",
        "_why": "rust-lane called StepDone on implement; code-reviewer starts review",
        "patches": [
          {
            "op": "merge",
            "path": "items[0].active_run",
            "value": { "current_step": "review", "agent": "code-reviewer" }
          }
        ]
      },
      {
        "seq": 3,
        "kind": "patch",
        "_why": "run completed; active_run pill clears, last_completed_run updates",
        "patches": [
          {
            "op": "merge",
            "path": "items[0]",
            "value": {
              "active_run": null,
              "last_completed_run": {
                "id": "run-checkout-flow-a1b2c3",
                "status": "completed",
                "completed_at": "2026-05-24T18:58:00Z",
                "duration_ms": 3480000
              },
              "run_count": 8
            }
          }
        ]
      }
    ]
  },

  // ── Run.response ──────────────────────────────────────────────────────────
  // JsonResponse carrying a completed run with 3 steps.
  // Consumed by ship-pipelines-run-console (snapshot mode via Run rpc).
  // Each step has: slug, status, agent, started_at, completed_at, summary, outputs.

  "Run.response": {
    "id": "run-checkout-flow-prev",
    "pipeline": "ship-feature",
    "slug": "checkout-flow-prev",
    "status": "completed",
    "worktree": "/home/dev/harbor/.ship/worktrees/checkout-flow-prev",
    "spec": "checkout-flow",
    "vars": { "area": "platform" },
    "started_at": "2026-05-24T14:00:00Z",
    "completed_at": "2026-05-24T16:00:00Z",
    "duration_ms": 7200000,
    "steps": [
      {
        "slug": "implement",
        "status": "done",
        "agent": "rust-lane",
        "started_at": "2026-05-24T14:00:00Z",
        "completed_at": "2026-05-24T15:20:00Z",
        "summary": "Scaffolded CheckoutService with happy-path handler; 3 contract tests passing.",
        "outputs": {
          "files_changed": "3",
          "tests_added": "3",
          "branch": "feat/checkout-flow"
        }
      },
      {
        "slug": "review",
        "status": "done",
        "agent": "code-reviewer",
        "started_at": "2026-05-24T15:21:00Z",
        "completed_at": "2026-05-24T15:55:00Z",
        "summary": "No blocking issues. Two minor style suggestions filed as annotations.",
        "outputs": {
          "annotations": "2",
          "verdict": "approved"
        }
      },
      {
        "slug": "gate",
        "status": "done",
        "agent": "rust-lane",
        "started_at": "2026-05-24T15:56:00Z",
        "completed_at": "2026-05-24T16:00:00Z",
        "summary": "Gate passed: tests green, review approved, diff within scope.",
        "outputs": {
          "gate": "passed",
          "commit": "f4e5d6c"
        }
      }
    ]
  },

  // ── RunLive.stream ────────────────────────────────────────────────────────
  // Stream frames for run-checkout-flow-a1b2c3 (the active run).
  // Consumed by ship-pipelines-run-console via RunLive rpc.
  // Sequence per spec: step running -> step done -> step running -> run completed.

  "RunLive.stream": {
    "frames": [
      {
        "seq": 1,
        "kind": "snapshot",
        "_why": "initial poll; implement step is running, review + gate are pending",
        "value": {
          "id": "run-checkout-flow-a1b2c3",
          "pipeline": "ship-feature",
          "slug": "checkout-flow-a1b2c3",
          "status": "running",
          "worktree": "/home/dev/harbor/.ship/worktrees/checkout-flow-a1b2c3",
          "spec": "checkout-flow",
          "vars": { "area": "platform" },
          "started_at": "2026-05-24T18:00:00Z",
          "completed_at": null,
          "steps": [
            {
              "slug": "implement",
              "status": "running",
              "agent": "rust-lane",
              "started_at": "2026-05-24T18:00:00Z",
              "completed_at": null,
              "summary": null,
              "outputs": {}
            },
            {
              "slug": "review",
              "status": "pending",
              "agent": "code-reviewer",
              "started_at": null,
              "completed_at": null,
              "summary": null,
              "outputs": {}
            },
            {
              "slug": "gate",
              "status": "pending",
              "agent": "rust-lane",
              "started_at": null,
              "completed_at": null,
              "summary": null,
              "outputs": {}
            }
          ]
        }
      },
      {
        "seq": 2,
        "kind": "patch",
        "_why": "rust-lane called StepDone; implement marked done",
        "patches": [
          {
            "op": "merge",
            "path": "steps[0]",
            "value": {
              "status": "done",
              "completed_at": "2026-05-24T18:42:00Z",
              "summary": "CheckoutService scaffolded; 3 tests passing. Diff staged on feat/checkout-flow.",
              "outputs": {
                "files_changed": "3",
                "tests_added": "3",
                "branch": "feat/checkout-flow"
              }
            }
          }
        ]
      },
      {
        "seq": 3,
        "kind": "patch",
        "_why": "review step started; code-reviewer agent spawned",
        "patches": [
          {
            "op": "merge",
            "path": "steps[1]",
            "value": {
              "status": "running",
              "started_at": "2026-05-24T18:43:00Z"
            }
          }
        ]
      },
      {
        "seq": 4,
        "kind": "patch",
        "_why": "run completed: review done, gate done, run status updated",
        "patches": [
          {
            "op": "merge",
            "path": "steps[1]",
            "value": {
              "status": "done",
              "completed_at": "2026-05-24T18:54:00Z",
              "summary": "No blocking issues. One annotation filed.",
              "outputs": { "annotations": "1", "verdict": "approved" }
            }
          },
          {
            "op": "merge",
            "path": "steps[2]",
            "value": {
              "status": "done",
              "started_at": "2026-05-24T18:55:00Z",
              "completed_at": "2026-05-24T18:58:00Z",
              "summary": "Gate passed.",
              "outputs": { "gate": "passed", "commit": "a1b2c3d" }
            }
          },
          {
            "op": "merge",
            "path": "",
            "value": { "status": "completed", "completed_at": "2026-05-24T18:58:00Z" }
          }
        ]
      }
    ]
  },

  // ── History.response ──────────────────────────────────────────────────────
  // JsonResponse carrying paginated run history.
  // 8 rows: completed x4, failed x2, running x1, cancelled x1.
  // Consumed by ship-pipelines-history; columns: id, pipeline, status, started_at, duration_ms.

  "History.response": {
    "items": [
      {
        "id": "run-checkout-flow-a1b2c3",
        "pipeline": "ship-feature",
        "slug": "checkout-flow-a1b2c3",
        "status": "running",
        "started_at": "2026-05-24T18:00:00Z",
        "completed_at": null,
        "duration_ms": null,
        "spec": "checkout-flow"
      },
      {
        "id": "run-checkout-flow-prev",
        "pipeline": "ship-feature",
        "slug": "checkout-flow-prev",
        "status": "completed",
        "started_at": "2026-05-24T14:00:00Z",
        "completed_at": "2026-05-24T16:00:00Z",
        "duration_ms": 7200000,
        "spec": "checkout-flow"
      },
      {
        "id": "run-code-review-001",
        "pipeline": "code-review",
        "slug": "code-review-001",
        "status": "completed",
        "started_at": "2026-05-24T15:21:00Z",
        "completed_at": "2026-05-24T16:05:00Z",
        "duration_ms": 2640000,
        "spec": null
      },
      {
        "id": "run-ship-fix-003",
        "pipeline": "ship-fix",
        "slug": "ship-fix-003",
        "status": "failed",
        "started_at": "2026-05-23T13:32:00Z",
        "completed_at": "2026-05-23T14:20:00Z",
        "duration_ms": 2880000,
        "spec": null
      },
      {
        "id": "run-ship-feature-002",
        "pipeline": "ship-feature",
        "slug": "ship-feature-002",
        "status": "completed",
        "started_at": "2026-05-22T10:00:00Z",
        "completed_at": "2026-05-22T12:30:00Z",
        "duration_ms": 9000000,
        "spec": null
      },
      {
        "id": "run-ship-feature-003",
        "pipeline": "ship-feature",
        "slug": "ship-feature-003",
        "status": "failed",
        "started_at": "2026-05-21T09:00:00Z",
        "completed_at": "2026-05-21T09:45:00Z",
        "duration_ms": 2700000,
        "spec": null
      },
      {
        "id": "run-code-review-002",
        "pipeline": "code-review",
        "slug": "code-review-002",
        "status": "completed",
        "started_at": "2026-05-20T14:00:00Z",
        "completed_at": "2026-05-20T14:22:00Z",
        "duration_ms": 1320000,
        "spec": null
      },
      {
        "id": "run-audit-cycle-001",
        "pipeline": "audit-cycle",
        "slug": "audit-cycle-001",
        "status": "cancelled",
        "started_at": "2026-05-19T08:00:00Z",
        "completed_at": "2026-05-19T08:05:00Z",
        "duration_ms": 300000,
        "spec": null
      }
    ],
    "total": 8,
    "limit": 10,
    "offset": 0,
    "pipeline_options": ["ship-feature", "code-review", "ship-fix", "audit-cycle"]
  },

  // ── HistoryLive.stream ────────────────────────────────────────────────────
  // One new run prepended after the initial page.
  // Consumed by ship-pipelines-history via HistoryLive rpc.

  "HistoryLive.stream": {
    "frames": [
      {
        "seq": 1,
        "kind": "snapshot",
        "_note": "same shape as History.response above; omitted here to avoid duplication",
        "patches": [
          { "op": "set", "path": "", "value": "<see History.response above>" }
        ]
      },
      {
        "seq": 2,
        "kind": "patch",
        "_why": "operator dispatched ship-fix manually from the dispatch form",
        "patches": [
          {
            "op": "prepend",
            "path": "items",
            "value": {
              "id": "run-ship-fix-004",
              "pipeline": "ship-fix",
              "slug": "ship-fix-004",
              "status": "running",
              "started_at": "2026-05-24T19:05:00Z",
              "completed_at": null,
              "duration_ms": null,
              "spec": null
            }
          },
          { "op": "merge", "path": "", "value": { "total": 9 } }
        ]
      }
    ]
  },

  // ── Dispatch.response ─────────────────────────────────────────────────────
  // JsonResponse returned when operator dispatches a pipeline via ship-pipelines-dispatch-form.
  // Used by the form to navigate to the new run's console.

  "Dispatch.response": {
    "run_id": "run-ship-feature-004",
    "slug": "ship-feature-004",
    "pipeline": "ship-feature",
    "status": "running",
    "worktree": "/home/dev/harbor/.ship/worktrees/ship-feature-004",
    "started_at": "2026-05-24T19:00:00Z"
  },

  // ── StepDone.response ─────────────────────────────────────────────────────
  // JsonResponse acknowledgement when an agent calls StepDone (advance step).

  "StepDone.response": {
    "ok": true,
    "slug": "checkout-flow-a1b2c3",
    "step": "implement",
    "next_step": "review"
  },

  // ── EndTurn.response ──────────────────────────────────────────────────────
  // JsonResponse acknowledgement when agent calls EndTurn (single-step job end).

  "EndTurn.response": {
    "ok": true,
    "slug": "checkout-flow-a1b2c3"
  },

  // ── Put.response ──────────────────────────────────────────────────────────
  // ScopedMutation — create or replace a pipeline definition.
  // Two scope examples per spec requirement.

  "Put.response": {
    "project_scope": { "id": "ship-feature", "scope": "project" },
    "user_scope":    { "id": "ship-fix",     "scope": "user" }
  },

  // ── Patch.response ────────────────────────────────────────────────────────
  // ScopedMutation — apply RFC-6902 patch to a pipeline definition.

  "Patch.response": {
    "project_scope": { "id": "ship-feature", "scope": "project" },
    "user_scope":    { "id": "ship-fix",     "scope": "user" }
  },

  // ── Delete.response ───────────────────────────────────────────────────────
  // ScopedMutation — delete a pipeline definition.
  // ship-pipelines-delete-confirm shows scope before the operator confirms.

  "Delete.response": {
    "project_scope": { "id": "code-review", "scope": "project" },
    "user_scope":    { "id": "audit-cycle", "scope": "user" }
  },

  // ── Get.response ──────────────────────────────────────────────────────────
  // JsonResponse carrying the raw pipeline doc — consumed by ship-pipelines-editor.
  // doc is shown decoded; on the wire it is a JSON-encoded string in doc_json.

  "Get.response": {
    "id": "ship-feature",
    "scope": "project",
    "doc": {
      "name": "ship-feature",
      "description": "End-to-end feature lane: implement, review, gate.",
      "steps": [
        { "slug": "implement", "agent": "rust-lane",     "harness": "claude" },
        { "slug": "review",    "agent": "code-reviewer", "harness": "claude" },
        { "slug": "gate",      "agent": "rust-lane",     "harness": "claude" }
      ]
    }
  },

  // ── error_states ──────────────────────────────────────────────────────────
  // Per §5: retryable (stream disconnect) and non-retryable (permission denied).
  // ship-pipelines-watch-badge reflects the stream connection state.

  "error_states": {
    "stream_disconnect": {
      "rpc": "SummariesLive",
      "tone": "warning",
      "retryable": true,
      "message": "Live connection dropped. Reconnecting...",
      "_note": "ship-pipelines-watch-badge shows reconnecting spinner; catalog retains last-known state"
    },
    "run_live_interrupt": {
      "rpc": "RunLive",
      "tone": "warning",
      "retryable": true,
      "message": "Run stream interrupted. Retrying...",
      "_note": "console keeps last known step state; watch-badge shows reconnecting"
    },
    "permission_denied": {
      "rpc": "Dispatch",
      "tone": "destructive",
      "retryable": false,
      "message": "Permission denied: ship.runtime.dispatch not granted.",
      "_note": "dispatch button disabled; inline error below the form"
    },
    "pipeline_not_found": {
      "rpc": "Get",
      "tone": "destructive",
      "retryable": false,
      "message": "Pipeline 'audit-cycle' not found at project scope.",
      "_note": "editor falls back to empty state with a New Pipeline CTA"
    }
  },

  // ── empty_states ──────────────────────────────────────────────────────────
  // Three empty states per §5: no definitions, no history, filtered-empty history.

  "empty_states": {
    "no_definitions": {
      "surface": "ship-pipelines-list",
      "title": "No pipelines defined",
      "body": "Create a pipeline to automate your agent workflows.",
      "cta": "New pipeline"
    },
    "no_history": {
      "surface": "ship-pipelines-history",
      "title": "No runs yet",
      "body": "Dispatch a pipeline to see its run history here.",
      "cta": "Dispatch"
    },
    "filtered_empty": {
      "surface": "ship-pipelines-history",
      "title": "No runs match the filter",
      "body": "8 runs stored; none match pipeline='audit-cycle' with q='checkout'.",
      "cta": "Clear filters",
      "_note": "triggered when History(pipeline, q) returns zero items"
    }
  }
}
