// Artifacts domain seed — realistic demo values for the sui-artifact-* component pack.
// World: 'harbor' project on feat/checkout-flow, agents rust-lane + code-reviewer.
// Generator strips full-line // comments and emits proto/fixtures/demo/artifacts.json.
// Field names follow ArtifactRecord / ArtifactsListResponse / Deletion in types.proto;
// Watch frames follow WatchEvent / PatchFrame / Patch in reactive.proto (values decoded).
{
  "_meta": {
    "domain": "artifacts",
    "description": "Demo data for the artifacts file browser + sui-artifact-* pack. Five artifacts spanning image / markdown / json / wasm / text mime classes. Covers List, Patch, Promote, Delete, Watch (snapshot → append → merge → remove → heartbeat), and error + empty states."
  },

  // ── ArtifactsService.List ────────────────────────────────────────────────────
  // ArtifactsListResponse { items: [ArtifactRecord], count, scope }
  // Scoped to the active run; exercises all mime classes + optional-field variety.

  "List.response": {
    "items": [
      {
        "id": "art-arch-png",
        "name": "architecture.png",
        "mime": "image/png",
        "size": 184320,
        "path": ".artifacts/architecture.png",
        "scope": "run",
        "space_id": "harbor",
        "run_id": "job-checkout-flow-a1b2c3d",
        "user_id": null,
        "content_hash": "sha256:4a8f2c1d9e3b7f6a0c5d2e1f8a3b9c4d7e2f1a0b5c8d3e6f9a4b7c0d1e2f3a48",
        "expires_at": null,
        "owner_actor": "rust-lane",
        "collection_id": null,
        "item_id": null,
        "created_at": "2026-05-31T20:10:00Z"
      },
      {
        "id": "art-spike-md",
        "name": "kysely-spike-findings.md",
        "mime": "text/markdown",
        "size": 6144,
        "path": ".artifacts/kysely-spike-findings.md",
        "scope": "space",
        "space_id": "harbor",
        "run_id": "job-checkout-flow-a1b2c3d",
        "user_id": null,
        "content_hash": "sha256:b3c1d9e2f4a7b0c5d8e3f1a4b7c0d2e5f8a1b4c7d0e3f6a9b2c5d8e1f4a7b0c5",
        "expires_at": null,
        "owner_actor": "rust-lane",
        "collection_id": "notes",
        "item_id": "note-kysely",
        "created_at": "2026-05-31T19:00:00Z"
      },
      {
        "id": "art-cov-json",
        "name": "coverage-report.json",
        "mime": "application/json",
        "size": 20480,
        "path": ".artifacts/coverage-report.json",
        "scope": "run",
        "space_id": "harbor",
        "run_id": "job-checkout-flow-a1b2c3d",
        "user_id": null,
        "content_hash": "sha256:c7d5e3f1a2b0c4d8e6f3a1b5c9d7e2f4a8b2c6d0e4f8a3b7c1d5e9f2a6b0c4d8",
        "expires_at": null,
        "owner_actor": "rust-lane",
        "collection_id": null,
        "item_id": null,
        "created_at": "2026-05-30T11:00:00Z"
      },
      {
        "id": "art-mod-wasm",
        "name": "module.wasm",
        "mime": "application/wasm",
        "size": 1048576,
        "path": ".artifacts/module.wasm",
        "scope": "run",
        "space_id": "harbor",
        "run_id": "job-checkout-flow-a1b2c3d",
        "user_id": null,
        "content_hash": "sha256:d9e7f5a3b1c8d6e4f2a0b7c5d3e1f8a6b4c2d0e8f6a4b2c0d8e6f4a2b0c8d6e4",
