#!/bin/sh
# Ship launcher — Ship.app stub.
#
# Finder runs this script when the user clicks the Ship icon in
# Launchpad / Applications. Two jobs:
#   1. Make sure the daemon is actually running. The launchd user agent
#      starts it on login, but the user may have stopped it or logged in
#      before the agent loaded.
#   2. Open the default browser at the Ship dashboard.
#
# Intentionally minimal: no Terminal window appears because Finder
# launches .app bundles without attaching a TTY.

set -eu

LABEL="dev.getship.shipd"
URL="http://127.0.0.1:9315/"

# Best-effort kickstart. `launchctl print` lists registered agents;
# `kickstart -k` restarts a registered one (no-op if the agent is
# already running and healthy).
if /bin/launchctl print "gui/$(id -u)/${LABEL}" >/dev/null 2>&1; then
    /bin/launchctl kickstart "gui/$(id -u)/${LABEL}" >/dev/null 2>&1 || true
fi

exec /usr/bin/open "${URL}"
