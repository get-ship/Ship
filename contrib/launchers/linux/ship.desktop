[Desktop Entry]
Type=Application
Name=Ship
GenericName=Agent Configuration Platform
Comment=Open the Ship dashboard in your browser
Categories=Development;Utility;
Icon=ship
Terminal=false
StartupNotify=false
# Best-effort start of the systemd --user unit so the icon works even if
# the daemon was stopped; then open the browser at the dashboard.
Exec=sh -c 'systemctl --user start shipd.service 2>/dev/null; xdg-open http://127.0.0.1:9315/'
