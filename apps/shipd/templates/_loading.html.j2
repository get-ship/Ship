{#-
  Skeleton loading group.

  Context fields consumed:
    - variant : rect|circle|text     (default: rect)
    - lines   : integer              (default: 3)
    - width   : CSS length string    (optional)
    - height  : CSS length string    (optional)
-#}
<ship-skeleton
  variant="{{ variant | default('rect') }}"
  lines="{{ lines | default(3) }}"
  {% if width is defined %} width="{{ width }}"{% endif %}
  {% if height is defined %} height="{{ height }}"{% endif %}>
</ship-skeleton>
