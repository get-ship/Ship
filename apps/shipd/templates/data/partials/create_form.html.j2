{#-
  Create form — generated from schema fields.
  POST to collection items endpoint. SSE auto-refreshes the table.
-#}
{% from '_urls.html.j2' import create_collection_item %}
<div class="ship-data-form" id="data-create-form">
  <div class="ship-data-form-title">New {{ schema.id }}</div>

  {% for field_name, field_def in schema.fields.items() %}
  <div class="ship-data-form-row">
    <label class="ship-data-form-label">
      {{ field_name }}{% if field_def.required %}<span class="req"> *</span>{% endif %}
    </label>

    {% if field_def.field_type == "enum" and field_def.values %}
    <select class="ship-data-form-select" id="create-{{ field_name }}">
      <option value="">—</option>
      {% for v in field_def.values %}
      <option value="{{ v }}">{{ v }}</option>
      {% endfor %}
    </select>

    {% elif field_def.field_type == "boolean" %}
    <label style="display:flex;align-items:center;gap:6px">
      <input type="checkbox" id="create-{{ field_name }}"> Yes
    </label>

    {% elif field_def.field_type == "number" %}
    <input type="number" step="any" class="ship-data-form-input"
           id="create-{{ field_name }}" placeholder="{{ field_name }}">

    {% elif field_def.field_type == "markdown" %}
    <textarea class="ship-data-form-input" rows="3"
              id="create-{{ field_name }}" placeholder="{{ field_name }}"></textarea>

    {% else %}
    <input type="text" class="ship-data-form-input"
           id="create-{{ field_name }}" placeholder="{{ field_name }}">
    {% endif %}
  </div>
  {% endfor %}

  <div class="ship-data-form-actions">
    <button class="ship-data-btn" id="data-create-submit"
            data-on-click="
              let data = {};
              {% for field_name, field_def in schema.fields.items() %}
              {% if field_def.field_type == 'boolean' %}
              data['{{ field_name }}'] = document.getElementById('create-{{ field_name }}').checked;
              {% elif field_def.field_type == 'number' %}
              { let v = document.getElementById('create-{{ field_name }}').value; if (v) data['{{ field_name }}'] = Number(v); }
              {% else %}
              { let v = document.getElementById('create-{{ field_name }}').value; if (v) data['{{ field_name }}'] = v; }
              {% endif %}
              {% endfor %}
              @post('{{ create_collection_item(active_collection) }}', {contentType: 'json', body: JSON.stringify({data: data})});
              $showCreateForm = false;
            ">Create</button>
    <button class="ship-data-btn ship-data-btn-ghost"
            data-on-click="$showCreateForm = false">Cancel</button>
  </div>
</div>
