{#-
  Single item row — used in content.html.j2 and pushed via SSE for updates.
  Includes delete action per row.
-#}
{% from '_urls.html.j2' import delete_collection_item %}
<tr id="item-{{ item.id }}">
  <td class="ship-data-cell-id" title="{{ item.id }}">{{ item.id[:12] }}</td>
  {% for field_name, field_def in schema.fields.items() %}
  <td id="item-{{ item.id }}-{{ field_name }}">
    {% set val = item.data[field_name] if item.data[field_name] is defined else none %}
    {% if field_def.field_type == "enum" and val %}
    <ship-chip>{{ val }}</ship-chip>
    {% elif field_def.field_type == "boolean" %}
    {{ "Yes" if val else "No" }}
    {% elif field_def.field_type == "number" and val is not none %}
    {{ val }}
    {% elif field_def.field_type == "markdown" and val %}
    <span title="{{ val }}">{{ val[:80] }}{{ "..." if val | length > 80 else "" }}</span>
    {% elif field_def.field_type == "date" and val %}
    {{ val[:10] }}
    {% elif val is not none and val != "" %}
    {{ val }}
    {% else %}
    <span style="color:var(--muted-foreground)">—</span>
    {% endif %}
  </td>
  {% endfor %}
  <td style="font-size:11px;color:var(--muted-foreground)">{{ item.updated_at[:16] }}</td>
  <td class="ship-data-cell-actions">
    <button class="ship-data-btn ship-data-btn-danger ship-data-btn-sm"
            data-on-click="@delete('{{ delete_collection_item(active_collection, item.id) }}')"
            title="Delete">✕</button>
  </td>
</tr>
