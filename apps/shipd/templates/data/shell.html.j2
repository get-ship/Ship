{#-
  Data browser — schema-aware collection viewer/editor.

  Structure:
    collection picker → filter bar → table with schema-derived columns →
    #data-content (SSE target for live updates).
-#}
{% from '_urls.html.j2' import list_collections %}
<div id="data-root" class="ship-view ship-view-data">
  <style>
    .ship-view-data { color: var(--foreground); }
    .ship-data-wrap { max-width: 72rem; margin: 0 auto; padding: 24px 16px; }
    .ship-data-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin: 0 0 20px; padding: 0 12px; }
    .ship-data-title { font-family: var(--font-display); font-size: 20px; font-weight: 600; letter-spacing: -0.01em; margin: 0; }
    .ship-data-sub { font-size: 12px; color: var(--muted-foreground); margin-top: 4px; }
    .ship-data-toolbar { display: flex; align-items: center; gap: 10px; padding: 0 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .ship-data-select { font-size: 13px; padding: 6px 10px; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--card); color: var(--foreground); }
    .ship-data-filter { font-size: 12px; padding: 5px 8px; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--card); color: var(--foreground); flex: 1; min-width: 120px; max-width: 240px; }
    .ship-data-btn { font-size: 12px; padding: 5px 12px; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--primary); color: var(--primary-foreground); cursor: pointer; font-weight: 500; }
    .ship-data-btn:hover { opacity: 0.9; }
    .ship-data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .ship-data-table th { text-align: left; padding: 8px 12px; border-bottom: 2px solid var(--border); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted-foreground); }
    .ship-data-table td { padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .ship-data-table tr:hover td { background: color-mix(in oklch, var(--muted) 30%, transparent); }
    .ship-data-cell-id { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); max-width: 100px; overflow: hidden; text-overflow: ellipsis; }
    .ship-data-cell-enum ship-chip { font-size: 11px; }
    .ship-data-empty { text-align: center; padding: 48px 16px; color: var(--muted-foreground); }
    .ship-data-count { font-size: 11px; color: var(--muted-foreground); margin-left: auto; }
  </style>

  <div class="ship-data-wrap">
    <div class="ship-data-head">
      <div>
        <h2 class="ship-data-title">Data</h2>
        <p class="ship-data-sub">{{ total_items }} item{{ "s" if total_items != 1 else "" }} across {{ collections | length }} collection{{ "s" if collections | length != 1 else "" }}</p>
      </div>
    </div>

    <div class="ship-data-toolbar">
      <select class="ship-data-select"
              data-on-change="@get('/api/runtime/view/data/sse?collection=' + this.value)">
        {% for c in collections %}
        <option value="{{ c.id }}" {{ "selected" if c.id == active_collection else "" }}>{{ c.name or c.id }}</option>
        {% endfor %}
        {% if collections | length == 0 %}
        <option disabled>No collections</option>
        {% endif %}
      </select>
      <span class="ship-data-count" id="data-count">{{ items | length }} item{{ "s" if items | length != 1 else "" }}</span>
    </div>

    <div id="data-content" data-init="@get('/api/runtime/view/data/sse?collection={{ active_collection }}', {requestCancellation: 'disabled'})">
      {% include 'data/content.html.j2' %}
    </div>
  </div>
</div>
