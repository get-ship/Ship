{#-
  Wrapper shell for `/api/runtime/view/{name}/raw`. Renders a full HTML
  document around an already-rendered SDK view fragment. Served both to
  direct-browser visitors and to Studio, which embeds it via <iframe>
  so cross-origin concerns stay inside a single request per mount.

  Required context:
    - title : string
    - inner : string (pre-rendered HTML, injected verbatim via |safe)
-#}
{% from '_urls.html.j2' import asset_view_tokens_css, asset_datastar_js, asset_ship_elements_js %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ asset_view_tokens_css() }}">
  <script type="module" src="{{ asset_datastar_js() }}"></script>
  <script type="module" src="{{ asset_ship_elements_js() }}"></script>
  <script>
    // Forward Studio-level keybindings to the parent window when embedded.
    // Only fires when this document is in a frame; standalone loads are
    // unaffected.
    (function () {
      if (window.parent === window) return;
      window.addEventListener('keydown', function (e) {
        var mod = e.metaKey || e.ctrlKey;
        if (mod && (e.key === 'k' || e.key === 'K')) {
          e.preventDefault();
          window.parent.postMessage({ source: 'ship-view', type: 'cmdk' }, '*');
        }
      });
    })();
  </script>
</head>
<body>
{{ inner | safe }}
</body>
</html>
