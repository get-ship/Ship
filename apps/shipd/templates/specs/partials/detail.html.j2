{#-
  Full spec editor. Expects `selected` (SpecDetail) in scope. Initializes
  datastar signals from the server-rendered context via data-signals-*
  attributes on a wrapper element.
-#}
<div class="specs-detail"
     data-signals-title="'{{ selected.title_js }}'"
     data-signals-body="'{{ selected.body_js }}'"
     data-signals-pipeline="'{{ selected.pipeline_js }}'"
     data-signals-status="'{{ selected.status }}'"
     data-signals-criteria-text="'{{ selected.criteria_text_js }}'"
     data-signals-scope-text="'{{ selected.scope_text_js }}'"
     data-signals-vars-text="'{{ selected.vars_text_js }}'"
     data-signals-dirty="false">

  <header class="specs-detail-header">
    <ship-input variant="ghost" size="lg" placeholder="Spec title"
                style="flex: 1;"
                value="{{ selected.title }}"
                data-bind-title
                data-on:ship-input="$dirty = true"></ship-input>
    <ship-select value="{{ selected.pipeline | default('') }}"
                 data-bind-pipeline
                 data-on:ship-change="$dirty = true">
      <option value="">No pipeline</option>
      {% for name in pipelines %}
        <option value="{{ name }}" {% if selected.pipeline == name %}selected{% endif %}>{{ name }}</option>
      {% endfor %}
    </ship-select>
    <ship-badge tone="{{ selected.tone }}">{{ selected.status }}</ship-badge>
  </header>

  <div class="specs-detail-body">
    <div class="specs-editor-wrap">
      <ship-label>Markdown body</ship-label>
      <ship-textarea variant="code" placeholder="# Spec body..."
                     data-bind-body
                     data-on:ship-input="$dirty = true"></ship-textarea>
    </div>

    <aside class="specs-meta">
      <ship-field>
        <ship-label slot="label">Acceptance criteria</ship-label>
        <div class="specs-meta-hint">One per line</div>
        <ship-textarea size="sm" rows="4"
                       data-bind-criteria-text
                       data-on:ship-input="$dirty = true"
                       placeholder="Tests pass&#10;Docs updated"></ship-textarea>
      </ship-field>

      <ship-field>
        <ship-label slot="label">Scope</ship-label>
        <div class="specs-meta-hint">One path per line</div>
        <ship-textarea size="sm" rows="3"
                       data-bind-scope-text
                       data-on:ship-input="$dirty = true"
                       placeholder="crates/core/runtime/&#10;apps/shipd/"></ship-textarea>
      </ship-field>

      <ship-field>
        <ship-label slot="label">Variables</ship-label>
        <div class="specs-meta-hint">KEY=value per line</div>
        <ship-textarea size="sm" rows="3"
                       data-bind-vars-text
                       data-on:ship-input="$dirty = true"
                       placeholder="TARGET=stable&#10;VERSION=1.0"></ship-textarea>
      </ship-field>
    </aside>
  </div>

  <div class="specs-footer">
    <ship-toolbar variant="bordered" justify="end">
      <span class="specs-dirty" data-show="$dirty">Unsaved changes</span>
      <ship-button variant="outline" tone="destructive" size="sm"
                   data-on:click="$confirmDelete = true">Delete</ship-button>
      <ship-button variant="outline" size="sm"
                   data-show="$status === 'draft' || $status === 'ready'"
                   data-on:click="@post('/api/runtime/specs/{{ selected.id }}/launch')">
        Launch
      </ship-button>
      <ship-button variant="solid" tone="accent" size="sm"
                   data-attr-loading="$dirty ? null : null"
                   data-on:click="@put('/api/runtime/specs/{{ selected.id }}', {contentType: 'json', body: JSON.stringify({title: $title, body: $body, pipeline: $pipeline ? $pipeline : null, status: $status, criteria: ($criteriaText || '').split('\n').filter(l => l.trim()), scope: ($scopeText || '').split('\n').filter(l => l.trim()), vars: Object.fromEntries(($varsText || '').split('\n').filter(l => l.includes('=')).map(l => { const i = l.indexOf('='); return [l.slice(0,i).trim(), l.slice(i+1).trim()]; }))})}); $dirty = false">
        Save
      </ship-button>
    </ship-toolbar>
  </div>
</div>
