{#- Message list fragment. Re-rendered wholesale on SSE patch. -#}
<div id="chat-messages-inner" class="chat-messages-inner">
  {% if messages|length == 0 %}
    <div class="chat-empty">
      <p>No messages yet</p>
      <p style="font-size:10px;opacity:0.7">Send a message to the agent to get started.</p>
    </div>
  {% else %}
    {% for m in messages %}
      {% include 'chat/partials/message.html.j2' %}
    {% endfor %}
  {% endif %}
</div>
