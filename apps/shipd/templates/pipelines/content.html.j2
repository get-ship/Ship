{#-
  Dispatches on `active_tab` to render the appropriate partial. Always
  wrapped in `#pipelines-content` so SSE morph targets match.
-#}
<div id="pipelines-content">
  {% if active_tab == 'definitions' %}
    {% include 'pipelines/partials/definitions.html.j2' %}
  {% elif active_tab == 'history' %}
    {% include 'pipelines/partials/history.html.j2' %}
  {% else %}
    {% include 'pipelines/partials/active.html.j2' %}
  {% endif %}
</div>
