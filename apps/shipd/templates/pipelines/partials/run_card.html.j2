{#- Expects `run` in scope. -#}
<ship-pipeline-run id="run-{{ run.slug }}" state="{{ run.state }}" slug="{{ run.slug }}" agent="{{ run.agent }}">
  <div slot="header-actions">
    <ship-button size="sm" variant="ghost"
      data-on:click="@post('/api/runtime/jobs/end', {contentType: 'json', body: JSON.stringify({job_id: '{{ run.job_id }}'})})">
      Stop
    </ship-button>
  </div>
  {% if run.steps and run.steps | length > 0 %}
  <ship-pipeline-dag>
    {% for step in run.steps %}
    <ship-pipeline-step name="{{ step.id }}" step-type="{{ step.step_type }}" state="{{ step.state }}"
      {% if step.agent %}agent="{{ step.agent }}"{% endif %}></ship-pipeline-step>
    {% endfor %}
  </ship-pipeline-dag>
  {% endif %}
</ship-pipeline-run>
