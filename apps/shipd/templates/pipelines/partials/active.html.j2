{#- Active runs list — spec-parity empty state and run cards. -#}
{% if active_runs and active_runs | length > 0 %}
<div class="ship-pipelines-run-list" style="display: flex; flex-direction: column; gap: 0.5rem;">
  {% for run in active_runs %}
    {% include 'pipelines/partials/run_card.html.j2' %}
  {% endfor %}
</div>
{% else %}
<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem 0; text-align: center;">
  <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; border: 1px solid color-mix(in oklch, var(--border) 60%, transparent); background: color-mix(in oklch, var(--muted) 40%, transparent); display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
    <ship-icon name="play" size="md" tone="muted"></ship-icon>
  </div>
  <span style="font-size: 0.875rem; font-weight: 500; color: var(--foreground);">No active runs</span>
  <span style="font-size: 0.75rem; color: var(--muted-foreground); max-width: 20rem; margin-top: 0.25rem;">Launch a run from a pipeline template or create one manually.</span>
  <ship-button size="sm" tone="accent" variant="solid" style="margin-top: 1rem;"
    data-on:click="window.location.href='/api/runtime/view/pipelines'">
    <ship-icon slot="leading" name="list" size="sm"></ship-icon>
    View pipelines
  </ship-button>
</div>
{% endif %}
