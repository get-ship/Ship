{#-
  History row — compact variant. Kept for backward compatibility.
  Expects `run` (RunView) in scope.
-#}
<div class="ship-history-row" data-state="{{ run.state }}">
  <ship-status-dot tone="{{ run.tone }}"></ship-status-dot>
  <span class="ship-history-slug">{{ run.slug }}</span>
  <span class="ship-history-status" style="color: var(--{{ run.tone }})">{{ run.status_text }}</span>
  <span class="ship-history-detail">
    {{ run.agent }}{% if run.branch %} / {{ run.branch }}{% endif %}{% if run.provider %} / {{ run.provider }}{% endif %}
  </span>
  {% if run.error %}
  <div class="ship-run-banner error" style="margin-top: 0; margin-left: 0.5rem;">{{ run.error }}</div>
  {% endif %}
  {% if run.segments and run.segments | length > 0 %}
  <ship-step-segments values="{{ run.segments | join(',') }}" size="sm"
    aria-label="{{ run.segments | length }} step outcomes"></ship-step-segments>
  {% endif %}
  {% if run.steps and run.steps | length > 0 %}
  <div class="ship-run-steps" style="margin-top: 0;">
    {% for step in run.steps %}
    <span class="ship-step-pill {{ step.state }}">{{ step.id }}</span>
    {% endfor %}
  </div>
  {% endif %}
  {% if run.depends_on and run.depends_on | length > 0 %}
  <div class="ship-run-deps" style="margin-top: 0;">
    <span class="ship-run-deps-label">depends on:</span>
    {% for dep in run.depends_on %}
    <span class="ship-run-dep-tag">{{ dep }}</span>
    {% endfor %}
  </div>
  {% endif %}
  <span class="ship-history-when">
    <ship-timestamp value="{{ run.updated_at }}" relative></ship-timestamp>
  </span>
</div>
