{#-
  Empty-state partial.

  Context fields consumed:
    - variant : default|connecting|placeholder  (default: default)
    - icon    : ship-icon name, e.g. "inbox"    (optional)
    - title   : short heading                   (required)
    - body    : supporting text / HTML          (optional)
    - cta     : { label, onclick } for a primary call-to-action (optional)
-#}
<ship-empty-state variant="{{ variant | default('default') }}">
  {% if icon is defined %}
    <ship-icon slot="icon" name="{{ icon }}"></ship-icon>
  {% endif %}
  <span slot="title">{{ title }}</span>
  {% if body is defined %}{{ body | safe }}{% endif %}
  {% if cta is defined %}
    <ship-button slot="actions" tone="accent" variant="solid"
      {% if cta.onclick is defined %} data-on-click="{{ cta.onclick }}"{% endif %}>
      {{ cta.label }}
    </ship-button>
  {% endif %}
</ship-empty-state>
