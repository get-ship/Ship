{#-
  Dispatches on `active_tab`. Always wrapped in `#settings-panel` so SSE
  morph targets match. Unknown tab → workspace.
-#}
<div id="settings-panel">
  {% if active_tab == 'project' %}
    {% include 'settings/partials/project.html.j2' %}
  {% elif active_tab == 'agents' %}
    {% include 'settings/partials/agents.html.j2' %}
  {% elif active_tab == 'providers' %}
    {% include 'settings/partials/providers.html.j2' %}
  {% elif active_tab == 'mcp' %}
    {% include 'settings/partials/mcp.html.j2' %}
  {% elif active_tab == 'permissions' %}
    {% include 'settings/partials/permissions.html.j2' %}
  {% elif active_tab == 'integrations' %}
    {% include 'settings/partials/integrations.html.j2' %}
  {% else %}
    {% include 'settings/partials/workspace.html.j2' %}
  {% endif %}
</div>
