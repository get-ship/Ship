{#- MCP tab: list of registered MCP servers from config. -#}
{% if mcp_servers and mcp_servers | length > 0 %}
<div class="ship-settings-group">
  {% for s in mcp_servers %}
  <ship-card class="ship-settings-card" accent-bar>
    <span slot="header">
      <ship-status-dot tone="{% if s.disabled %}muted{% else %}success{% endif %}"></ship-status-dot>
      {{ s.name }}
      <ship-badge tone="muted">{{ s.server_type }}</ship-badge>
    </span>
    <ship-field class="ship-settings-row">
      <ship-label>Command</ship-label>
      <ship-input value="{{ s.command }}" disabled></ship-input>
    </ship-field>
    {% if s.url %}
    <ship-field class="ship-settings-row" style="margin-top:8px">
      <ship-label>URL</ship-label>
      <ship-input value="{{ s.url }}" disabled></ship-input>
    </ship-field>
    {% endif %}
    <ship-field class="ship-settings-row" style="margin-top:8px">
      <ship-label>Scope</ship-label>
      <ship-input value="{{ s.scope }}" disabled></ship-input>
    </ship-field>
  </ship-card>
  {% endfor %}
</div>
{% else %}
<ship-empty-state variant="placeholder">
  <ship-icon slot="icon" name="server"></ship-icon>
  <span slot="title">No MCP servers</span>
  Register MCP servers in <ship-code inline>.ship/mcp.yaml</ship-code>.
</ship-empty-state>
{% endif %}
