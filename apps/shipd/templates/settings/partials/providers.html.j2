{#- Providers section. Radio list of detected LLM provider CLIs +
    default-model input. -#}
{% from '_urls.html.j2' import update_setting %}
<section class="settings-section" aria-labelledby="settings-providers-head">
  <div id="settings-providers-head" class="settings-section-head">PROVIDERS</div>
  <p class="settings-section-desc">
    LLM provider CLIs detected on PATH. Configuration lives in
    <code>.ship/</code> and keys, when used, in <code>.ship/secrets/</code>.
  </p>

  <ship-card class="settings-card">
    <div class="settings-card-inner">
      {% if providers and providers | length > 0 %}
        {% for p in providers %}
          {% include 'settings/partials/provider_row.html.j2' %}
        {% endfor %}
      {% else %}
        <div class="settings-empty">No provider CLIs found on PATH.</div>
      {% endif %}

      <div class="settings-row">
        <div class="settings-row-label">
          Default model
          <span class="settings-row-sub">Model id passed to the default provider</span>
        </div>
        <div class="settings-row-control">
          <ship-input size="sm" placeholder="sonnet" value="{{ default_model }}"
            data-on:ship-input__debounce.500ms="@put('{{ update_setting() }}', {contentType: 'json', body: JSON.stringify({key: 'defaults.model', value: evt.detail.value})})"></ship-input>
        </div>
      </div>
    </div>
  </ship-card>
</section>
