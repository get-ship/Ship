{#- Permissions tab: project.permissions allow/deny from ProjectConfig.agent. -#}
{% if permissions.loaded %}
<ship-card class="ship-settings-card" accent-bar>
  <span slot="header">Allow rules</span>
  {% if permissions.allow and permissions.allow | length > 0 %}
  <div class="ship-pipelines-filters">
    {% for rule in permissions.allow %}
    <ship-chip tone="success">{{ rule }}</ship-chip>
    {% endfor %}
  </div>
  {% else %}
  <p style="margin:6px 0;color:var(--muted-fg)">No allow rules.</p>
  {% endif %}
</ship-card>
<ship-card class="ship-settings-card">
  <span slot="header">Deny rules</span>
  {% if permissions.deny and permissions.deny | length > 0 %}
  <div class="ship-pipelines-filters">
    {% for rule in permissions.deny %}
    <ship-chip tone="destructive">{{ rule }}</ship-chip>
    {% endfor %}
  </div>
  {% else %}
  <p style="margin:6px 0;color:var(--muted-fg)">No deny rules.</p>
  {% endif %}
</ship-card>
{% else %}
{% include 'settings/partials/_not_configured.html.j2' %}
{% endif %}
