{#- Settings view — grouped sections with two-column label/control rows.
    Fragment mounted inline in Studio. -#}
<div id="ship-view-root" class="ship-view ship-view-settings">
  <style>
    .ship-view-settings { color: var(--foreground); }
    .settings-wrap {
      max-width: 768px;
      margin: 0 auto;
      padding: 24px 20px 48px;
      width: 100%;
    }
    .settings-header { margin-bottom: 20px; }
    .settings-header h1 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin: 0;
      color: var(--foreground);
    }
    .settings-header p {
      font-size: 13px;
      color: var(--muted-foreground);
      margin: 4px 0 0;
    }
    .settings-section { margin: 24px 0 0; display: flex; flex-direction: column; gap: 8px; }
    .settings-section-head {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted-foreground);
      margin: 0;
    }
    .settings-section-desc {
      font-size: 12px;
      color: var(--muted-foreground);
      margin: 0 0 4px;
    }
    .settings-section-desc code {
      font-family: var(--font-mono);
      font-size: 11px;
      background: color-mix(in oklch, var(--muted) 45%, transparent);
      padding: 1px 4px;
      border-radius: 3px;
    }
    ship-card.settings-card { display: block; }
    .settings-card-inner { padding: 4px 16px; }
    .settings-row {
      display: grid;
      grid-template-columns: minmax(180px, 220px) 1fr;
      gap: 16px;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    }
    .settings-row:last-child { border-bottom: 0; }
    .settings-row-label {
      font-size: 12px;
      color: var(--foreground);
      min-width: 0;
    }
    .settings-row-sub {
      display: block;
      font-size: 11px;
      color: var(--muted-foreground);
      margin-top: 2px;
    }
    .settings-row-control {
      display: flex;
      align-items: center;
      gap: 8px;
      justify-content: flex-end;
      min-width: 0;
    }
    @media (max-width: 700px) {
      .settings-row { grid-template-columns: 1fr; gap: 6px; }
      .settings-row-control { justify-content: flex-start; }
    }
    .provider-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    }
    .provider-row:last-child { border-bottom: 0; }
    .provider-main {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .provider-name {
      font-size: 13px;
      font-weight: 500;
      color: var(--foreground);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .provider-meta {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--muted-foreground);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .provider-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      display: inline-block;
      background: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
    }
    .provider-dot.on { background: var(--success); }
    .provider-radio {
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 1.5px solid color-mix(in oklch, var(--border) 80%, transparent);
      background: transparent;
      cursor: pointer;
      display: inline-block;
      position: relative;
      margin: 0;
    }
    .provider-radio:checked {
      border-color: var(--primary);
    }
    .provider-radio:checked::after {
      content: '';
      position: absolute;
      inset: 3px;
      border-radius: 50%;
      background: var(--primary);
    }
    .about-list {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 8px 16px;
      font-size: 12px;
      margin: 0;
      padding: 12px 0;
    }
    .about-list dt {
      color: var(--muted-foreground);
      font-weight: 500;
    }
    .about-list dd {
      margin: 0;
      color: var(--foreground);
      font-family: var(--font-mono);
      font-size: 11px;
    }
    .about-list a {
      color: var(--primary);
      text-decoration: none;
    }
    .about-list a:hover { text-decoration: underline; }
    .settings-empty {
      font-size: 12px;
      color: var(--muted-foreground);
      padding: 12px 0;
    }
  </style>

  <main class="settings-wrap">
    <header class="settings-header">
      <h1>Settings</h1>
      <p>CLI and studio configuration</p>
    </header>

    {% from '_urls.html.j2' import view_settings_sse %}
    <div id="settings-panel"
         data-init="@get('{{ view_settings_sse() }}', {requestCancellation: 'disabled'})">
      {% include 'settings/partials/providers.html.j2' %}
      {% include 'settings/partials/terminal.html.j2' %}
      {% include 'settings/partials/advanced.html.j2' %}
      {% include 'settings/partials/about.html.j2' %}
    </div>
  </main>
</div>
