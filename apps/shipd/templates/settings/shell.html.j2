{#- Settings view — single column, four stacked sections.
    Fragment mounted inline in Studio. -#}
<div id="settings-root" class="ship-view ship-view-settings">
  <style>
    .ship-view-settings { color: var(--foreground); }
    .settings-wrap {
      max-width: 768px;
      margin: 0 auto;
      padding: 24px 20px 48px;
      width: 100%;
    }
    .settings-header { margin-bottom: 20px; }
    .settings-header h1 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin: 0;
      color: var(--foreground);
    }
    .settings-header p {
      font-size: 13px;
      color: var(--muted-foreground);
      margin: 4px 0 0;
    }
    .settings-section { margin: 24px 0 0; }
    .settings-section-head {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted-foreground);
      margin: 0 0 6px;
    }
    .settings-section-desc {
      font-size: 12px;
      color: var(--muted-foreground);
      margin: 0 0 12px;
    }
    .settings-section-desc code {
      font-family: var(--font-mono);
      font-size: 11px;
      background: color-mix(in oklch, var(--muted) 45%, transparent);
      padding: 1px 4px;
      border-radius: 3px;
    }
    .settings-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    }
    .settings-row:last-child { border-bottom: 0; }
    .settings-row-label {
      font-size: 12px;
      color: var(--foreground);
      flex: 0 0 auto;
      min-width: 180px;
    }
    .settings-row-sub {
      display: block;
      font-size: 11px;
      color: var(--muted-foreground);
      margin-top: 2px;
    }
    .settings-row-control {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 240px;
      justify-content: flex-end;
    }
    .provider-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    }
    .provider-row:last-child { border-bottom: 0; }
    .provider-glyph {
      font-size: 16px;
      width: 24px;
      text-align: center;
      color: var(--muted-foreground);
      flex-shrink: 0;
    }
    .provider-main {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
      flex: 1;
    }
    .provider-name {
      font-size: 12px;
      font-weight: 500;
      color: var(--foreground);
    }
    .provider-meta {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--muted-foreground);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .provider-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      display: inline-block;
      background: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
    }
    .provider-dot.on { background: var(--success, #22c55e); }
    .about-list {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 8px 16px;
      font-size: 12px;
    }
    .about-list dt {
      color: var(--muted-foreground);
      font-weight: 500;
    }
    .about-list dd {
      margin: 0;
      color: var(--foreground);
      font-family: var(--font-mono);
      font-size: 11px;
    }
    .about-list a {
      color: var(--primary, currentColor);
      text-decoration: none;
    }
    .about-list a:hover { text-decoration: underline; }
    .settings-empty {
      font-size: 12px;
      color: var(--muted-foreground);
      padding: 12px 0;
    }
  </style>

  <main class="settings-wrap">
    <header class="settings-header">
      <h1>Settings</h1>
      <p>CLI and studio configuration</p>
    </header>

    <div id="settings-panel"
         data-init="@get('{{ daemon_origin | safe }}/api/runtime/view/settings/sse?token={{ token | safe }}', {requestCancellation: 'disabled'})">
      {% include 'settings/partials/providers.html.j2' %}
      {% include 'settings/partials/terminal.html.j2' %}
      {% include 'settings/partials/advanced.html.j2' %}
      {% include 'settings/partials/about.html.j2' %}
    </div>
  </main>
</div>
