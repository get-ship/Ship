{#- Ship View SDK — import macros to build views without raw Datastar/URLs.
    Usage: {% from '_ship.html.j2' import head, signal, show, live %}
    Macros output HTML attributes so they compose on elements:
      <button {{ create('tasks', '$form') }} {{ loading('_saving') }}>Save</button>
-#}

{#- === Page Setup === -#}

{# Emit standard <head> contents: meta, title, CSS, Datastar, ship-elements #}
{% macro head(title='Ship View') %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/api/runtime/assets/view-tokens.css">
  <script type="module" src="/api/runtime/assets/datastar.js"></script>
  <script type="module" src="/api/runtime/assets/ship-elements.js"></script>
{% endmacro %}

{#- === Signals & Reactivity === -#}

{# Declare a reactive signal with a default value #}
{% macro signal(name, default='') %}data-signals:{{ name }}="{{ default | tojson if default is not string else "'" ~ default ~ "'" }}"{% endmacro %}

{# Show element only when expression is true (hidden by default to prevent flash) #}
{% macro show(expr) %}data-show="{{ expr }}" style="display:none"{% endmacro %}

{# Toggle class based on expression #}
{% macro toggle_class(cls, expr) %}data-class:{{ cls }}="{{ expr }}"{% endmacro %}

{# Bind an attribute reactively #}
{% macro attr(name, expr) %}data-attr:{{ name }}="{{ expr }}"{% endmacro %}

{#- === SSE & Live Updates === -#}

{# Subscribe to SSE stream for a view (long-lived read connection) #}
{% macro live(view_name) %}data-init="@get('/api/runtime/view/{{ view_name }}/sse')"{% endmacro %}

{#- === Loading & Indicators === -#}

{# Mark an element as having a loading indicator signal #}
{% macro loading(signal_name) %}data-indicator="{{ signal_name }}"{% endmacro %}

{# Render a spinner that shows during loading #}
{% macro spinner(signal_name) %}<span data-show="${{ signal_name }}" style="display:none"><span class="ship-spinner"></span></span>{% endmacro %}

{#- === Collection Actions === -#}

{# Create an item in a collection. data is a Datastar signal expression (e.g. '$form') #}
{% macro create(collection, data) %}data-on:click="@post('/api/collections/{{ collection }}/items', {payload: {data: {{ data }}}})"{% endmacro %}

{# Update an item in a collection #}
{% macro update(collection, id, data) %}data-on:click="@put('/api/collections/{{ collection }}/items/{{ id }}', {payload: {data: {{ data }}}})"{% endmacro %}

{# Delete an item from a collection #}
{% macro delete(collection, id) %}data-on:click="@delete('/api/collections/{{ collection }}/items/{{ id }}')"{% endmacro %}

{#- === Navigation === -#}

{# Navigate to another view via GET (replaces content via Datastar morph) #}
{% macro navigate(url) %}data-on:click="@get('{{ url }}')"{% endmacro %}

{# Navigate to a named view #}
{% macro view(name) %}data-on:click="@get('/api/runtime/view/{{ name }}')"{% endmacro %}

{#- === Generic Actions === -#}

{# GET request on click #}
{% macro get(url) %}data-on:click="@get('{{ url }}')"{% endmacro %}

{# POST request on click with payload #}
{% macro post(url, payload='{}') %}data-on:click="@post('{{ url }}', {payload: {{ payload }}})"{% endmacro %}

{# PUT request on click with payload #}
{% macro put(url, payload='{}') %}data-on:click="@put('{{ url }}', {payload: {{ payload }}})"{% endmacro %}

{# PUT request on change (for settings/config updates) #}
{% macro put_on_change(url, payload='{}') %}data-on:change="@put('{{ url }}', {payload: {{ payload }}})"{% endmacro %}

{# POST on submit (for forms) #}
{% macro submit(url, payload='{}') %}data-on:submit="@post('{{ url }}', {payload: {{ payload }}})"{% endmacro %}

{# Bind a signal to an input element's value #}
{% macro bind(signal_name) %}data-bind="{{ signal_name }}"{% endmacro %}

{#- === Job Actions === -#}

{# Create a new job. agent_expr is a signal expression, pipeline is optional. #}
{% macro create_job(agent_expr, pipeline='') %}data-on:click="@post('/api/runtime/jobs', {payload: {agent: {{ agent_expr }}{% if pipeline %}, pipeline: '{{ pipeline }}'{% endif %}}})"{% endmacro %}

{# Emit a kernel event #}
{% macro emit(event_type, data_expr='{}') %}data-on:click="@post('/api/events/emit', {payload: {event_type: '{{ event_type }}', data: {{ data_expr }}}})"{% endmacro %}

{#- === Data Macros === -#}

{# Auto-form: generate typed form fields from a collection schema #}
{% macro form(schema, collection, form_signal='form') %}
<div class="ship-form">
  {% for field_name, field_def in schema.fields %}
  <div class="ship-form-field">
    <label class="ship-form-label">
      {{ field_name }}{% if field_def.required %}<span style="color:var(--destructive)"> *</span>{% endif %}
    </label>
    {% if field_def.field_type == "enum" and field_def.values %}
    <ship-select size="sm" data-bind="{{ form_signal }}.{{ field_name }}">
      <ship-option value="">--</ship-option>
      {% for v in field_def.values %}<ship-option value="{{ v }}">{{ v }}</ship-option>{% endfor %}
    </ship-select>
    {% elif field_def.field_type == "boolean" %}
    <ship-switch data-bind="{{ form_signal }}.{{ field_name }}"></ship-switch>
    {% elif field_def.field_type == "number" %}
    <ship-input size="sm" type="number" data-bind="{{ form_signal }}.{{ field_name }}" placeholder="0"></ship-input>
    {% elif field_def.field_type == "markdown" %}
    <ship-textarea size="sm" data-bind="{{ form_signal }}.{{ field_name }}" rows="3" placeholder="{{ field_name }}"></ship-textarea>
    {% else %}
    <ship-input size="sm" data-bind="{{ form_signal }}.{{ field_name }}" placeholder="{{ field_name }}"></ship-input>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endmacro %}

{# Auto-table: generate a data table from schema + items #}
{% macro table(schema, items, collection) %}
<table class="ship-table">
  <thead><tr>
    <th style="width:90px">ID</th>
    {% for field_name, _ in schema.fields %}<th>{{ field_name }}</th>{% endfor %}
    <th style="width:100px">Updated</th>
    <th style="width:40px"></th>
  </tr></thead>
  <tbody>
    {% for item in items %}
    <tr id="item-{{ item.id }}">
      <td class="mono muted" title="{{ item.id }}">{{ item.id[:10] }}</td>
      {% for field_name, field_def in schema.fields %}
      <td>
        {% set val = item.data[field_name] if item.data[field_name] is defined else none %}
        {% if val is none or val == "" %}<span class="null">--</span>
        {% elif field_def.field_type == "enum" %}<ship-chip>{{ val }}</ship-chip>
        {% elif field_def.field_type == "boolean" %}<ship-badge variant="{{ 'success' if val else 'secondary' }}">{{ "Yes" if val else "No" }}</ship-badge>
        {% elif field_def.field_type == "number" %}<span class="mono">{{ val }}</span>
        {% elif field_def.field_type == "array" and val is iterable and val is not string %}{% for v in val[:4] %}<ship-chip>{{ v }}</ship-chip> {% endfor %}{% if val | length > 4 %}<ship-badge variant="secondary">+{{ val | length - 4 }}</ship-badge>{% endif %}
        {% else %}{{ val }}{% endif %}
      </td>
      {% endfor %}
      <td class="mono muted">{{ item.updated_at[:16] if item.updated_at else "--" }}</td>
      <td><ship-button size="sm" variant="destructive" {{ delete(collection, item.id) }} {{ loading('_deleting') }}>x</ship-button></td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endmacro %}

{# Shared styles for ship-form and ship-table #}
{% macro styles() %}
<style>
.ship-form-field { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 10px; }
.ship-form-label { font-size: 12px; font-weight: 500; min-width: 110px; padding-top: 7px; color: var(--muted-foreground); }
.ship-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.ship-table th { text-align: left; padding: 8px 12px; border-bottom: 2px solid var(--border); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted-foreground); }
.ship-table td { padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
.ship-table tr:hover td { background: color-mix(in oklch, var(--muted) 40%, transparent); }
.mono { font-family: var(--font-mono); font-size: 11px; }
.muted { color: var(--muted-foreground); }
.null { color: var(--muted-foreground); font-style: italic; }
</style>
{% endmacro %}
