{#- Shared section shell.
    Context:
      title     — section heading
      items     — list of strings (skill refs, mcp names, rule ids, etc.)
      empty     — empty-state message
      add_label — CTA label (e.g. "+ Add skill")
-#}
<section class="agent-section">
  <header class="agent-section-head">
    <h2>{{ title }}</h2>
    <ship-button size="sm" tone="neutral" variant="ghost" disabled>{{ add_label }}</ship-button>
  </header>
  {% if items|length == 0 %}
    <div class="agent-section-empty">{{ empty }}</div>
  {% else %}
    <ul class="agent-section-list">
      {% for it in items %}
        <li class="agent-section-item">
          <span class="agent-section-item-name">{{ it }}</span>
          <span class="agent-section-chevron" aria-hidden="true">›</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
