{#- Skills index — IDE-style three-pane split.
    Context (index): `rail`.
    Context (detail): `skill`, `body_html`, `tabs`, `rail`. -#}
<div id="skills-root" class="ship-view ship-view-skills">
  <style>
    .ship-view-skills { color: var(--foreground); height: 100%; }
    .skills-layout { display: grid; grid-template-columns: 320px 1fr; height: 100%; min-height: 500px; }
    .skills-layout.detail { grid-template-columns: 320px 1fr 320px; }
    .skills-left { border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; background: var(--card); }
    .skills-center { padding: 20px 24px; overflow: auto; }
    .skills-right { border-left: 1px solid var(--border); padding: 16px; background: var(--card); overflow: auto; }
    .skills-rail-head { padding: 12px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 8px; }
    .skills-filter-row { display: flex; flex-wrap: wrap; gap: 4px; }
    .skills-group { padding: 8px 0; }
    .skills-group-head { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); padding: 6px 12px; }
    .skills-row { display: flex; align-items: center; gap: 8px; padding: 6px 12px; font-size: 12px; cursor: pointer; }
    .skills-row:hover { background: color-mix(in oklch, var(--muted) 40%, transparent); }
    .skills-row.active { background: color-mix(in oklch, var(--primary) 12%, transparent); }
    .skills-caret { color: var(--muted-foreground); font-size: 10px; width: 10px; }
    .skills-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success, #22c55e); margin-left: auto; }
    .skills-dot.docs { background: var(--muted-foreground); }
    .skills-empty-hint { font-size: 12px; color: var(--muted-foreground); padding: 16px; text-align: center; }
    .skill-detail-head h1 { font-family: var(--font-display); font-size: 20px; font-weight: 700; margin: 0; }
    .skill-detail-desc { font-size: 12px; color: var(--muted-foreground); margin: 4px 0 18px; }
    .skill-body { background: color-mix(in oklch, var(--muted) 30%, transparent); padding: 16px; border-radius: var(--radius-md); font-family: var(--font-mono); font-size: 12px; white-space: pre-wrap; line-height: 1.55; color: var(--foreground); }
    .meta-head { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: 0 0 8px; }
    .meta-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 16px; }
    .meta-tab-row { display: flex; gap: 4px; margin-bottom: 10px; border-bottom: 1px solid var(--border); }
    .meta-tab { font-size: 11px; padding: 6px 8px; cursor: pointer; color: var(--muted-foreground); border-bottom: 2px solid transparent; }
    .meta-tab.active { color: var(--foreground); border-bottom-color: var(--primary, #f97316); }
    .meta-list { list-style: none; padding: 0; margin: 0; font-family: var(--font-mono); font-size: 11px; }
    .meta-list li { padding: 4px 0; border-top: 1px solid color-mix(in oklch, var(--border) 60%, transparent); }
    .meta-list li:first-child { border-top: 0; }
  </style>

  <div class="skills-layout {% if skill is defined %}detail{% endif %}">
    <aside class="skills-left">
      {% include 'skills/partials/rail.html.j2' with context %}
    </aside>

    {% if skill is defined %}
      <main class="skills-center">
        {% include 'skills/partials/detail_pane.html.j2' %}
      </main>
      <aside class="skills-right">
        {% include 'skills/partials/metadata_sidebar.html.j2' %}
      </aside>
    {% else %}
      <main class="skills-center" style="display:flex;align-items:center;justify-content:center;">
        <ship-empty-state
          icon="sparkles"
          title="Pick a skill"
          body="Select a skill from the left to see its SKILL.md and metadata."></ship-empty-state>
      </main>
    {% endif %}
  </div>
</div>
