{#- Skills index — two-pane layout (rail + detail).
    Context (index): `rail`.
    Context (detail): `skill`, `rail`. -#}
<div id="skills-root" class="ship-view ship-view-skills">
  <style>
    .ship-view-skills { color: var(--foreground); height: 100%; }
    .skills-layout { display: grid; grid-template-columns: 260px 1fr; height: 100%; min-height: 500px; }
    .skills-left { border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; background: var(--card); overflow: hidden; }
    .skills-left > :nth-child(2) { overflow: auto; flex: 1 1 auto; }
    .skills-detail { padding: 24px 28px; overflow: auto; display: flex; flex-direction: column; gap: 16px; }
    .skills-detail.empty { padding: 0; align-items: center; justify-content: center; }
    .skills-rail-head { padding: 10px 12px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 8px; }
    .skills-filter-row { display: flex; flex-wrap: wrap; gap: 4px; }
    .skills-group { padding: 6px 0; }
    .skills-group-head { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); padding: 6px 12px; }
    .skills-row { display: flex; align-items: center; gap: 6px; padding: 4px 12px; min-height: 28px; font-size: 12px; cursor: pointer; }
    .skills-row:hover { background: color-mix(in oklch, var(--muted) 40%, transparent); }
    .skills-row.active { background: color-mix(in oklch, var(--primary) 12%, transparent); }
    .skills-caret { color: var(--muted-foreground); font-size: 10px; width: 10px; }
    .skills-row > .skills-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .skills-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); margin-left: auto; flex-shrink: 0; }
    .skills-dot.docs { background: var(--muted-foreground); }
    .skills-source-tag { width: 8px; height: 8px; border-radius: 2px; background: var(--primary); flex-shrink: 0; }
    .skills-empty-hint { font-size: 12px; color: var(--muted-foreground); padding: 16px; text-align: center; }
    .skill-detail-head h1 { font-family: var(--font-display); font-size: 22px; font-weight: 700; margin: 0; }
    .skill-detail-desc { font-size: 13px; color: var(--muted-foreground); margin: 4px 0 0; }
    .skill-frontmatter-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  </style>

  <div class="skills-layout">
    <aside class="skills-left">
      {% include 'skills/partials/rail.html.j2' with context %}
    </aside>

    {% if skill is defined %}
      <main class="skills-detail">
        {% include 'skills/partials/detail_pane.html.j2' %}
      </main>
    {% else %}
      <main class="skills-detail empty">
        <ship-empty-state
          icon="sparkles"
          title="No skill open"
          body="Select a skill from the rail to start reading."></ship-empty-state>
      </main>
    {% endif %}
  </div>
</div>
