{#-
  Main pane dispatcher. Wrapped in #git-main so SSE morphs target match.
-#}
<div id="git-main">
  {% if error %}
    {% include '_error.html.j2' %}
  {% elif selected_commit %}
    {% include 'git/partials/commit_detail.html.j2' %}
  {% else %}
    <ship-empty-state>
      <ship-icon slot="icon" name="git-commit"></ship-icon>
      <span slot="title">Select a commit to view</span>
      Pick a commit from the log on the left, or a file from Status to see its diff against HEAD.
    </ship-empty-state>
  {% endif %}
</div>
