{#- Expects selected_commit: {sha, short_sha, author, committer, date, message, files:[{path,additions,deletions,status,tone,label,diff}]}. -#}
<div class="git-commit-header">
  <div style="display:flex;align-items:center;gap:10px;">
    <ship-code inline>{{ selected_commit.short_sha }}</ship-code>
    <ship-copy-button value="{{ selected_commit.sha }}" size="sm"></ship-copy-button>
    <ship-badge tone="muted">{{ selected_commit.files | length }} files</ship-badge>
  </div>
  <div class="git-commit-meta">
    <span>{{ selected_commit.author }}</span>
    {% if selected_commit.committer and selected_commit.committer != selected_commit.author %}
      <span>committed by {{ selected_commit.committer }}</span>
    {% endif %}
    <ship-timestamp value="{{ selected_commit.date }}"></ship-timestamp>
  </div>
  <div style="white-space:pre-wrap;font-size:14px;">{{ selected_commit.message }}</div>
</div>

{% if selected_commit.files and selected_commit.files | length > 0 %}
<ship-table hoverable>
  <tr slot="head"><th>File</th><th>Status</th><th>+</th><th>&minus;</th></tr>
  {% for f in selected_commit.files %}
  <tr>
    <td><ship-code inline>{{ f.path }}</ship-code></td>
    <td><ship-badge tone="{{ f.tone }}" size="sm">{{ f.label }}</ship-badge></td>
    <td>{{ f.additions }}</td>
    <td>{{ f.deletions }}</td>
  </tr>
  {% endfor %}
</ship-table>

<div style="margin-top:18px;">
  {% for f in selected_commit.files %}
    {% include 'git/partials/file_diff.html.j2' %}
  {% endfor %}
</div>
{% endif %}
