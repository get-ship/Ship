{#-
  History tab — commit list using ship-history-row.
  Clicking a row loads that commit's diff into the Changes > diff pane
  and switches to the Changes tab so the diff is visible.
  Expects: commits[], workspace_id
-#}
{% from '_urls.html.j2' import view_git %}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}

{% if commits %}
  {% for c in commits %}
    <ship-history-row
      sha="{{ c.short_sha }}"
      subject="{{ c.subject | e }}"
      author="{{ c.author | e }}"
      timestamp="{{ c.date }}"
      additions="{{ c.additions }}"
      deletions="{{ c.deletions }}"
      {% if selected_commit and selected_commit.sha == c.sha %}active{% endif %}
      data-on:ship-select="$tab = 'changes'; @get('{{ view_git() }}?commit={{ c.sha }}{{ ws_qs }}')"
    ></ship-history-row>
  {% endfor %}
{% else %}
  <div style="padding:32px;text-align:center;color:var(--muted-foreground);font-size:13px">
    <ship-icon name="git-commit" size="lg" style="display:block;margin:0 auto 10px;opacity:.4"></ship-icon>
    No commits yet.
  </div>
{% endif %}
