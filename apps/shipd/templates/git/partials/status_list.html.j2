{#- Expects status_files (list of {path, status, tone, label}). -#}
{% if status_files and status_files | length > 0 %}
  {% for f in status_files %}
    <ship-list-item interactive
      data-on:click="@get('{{ daemon_origin | safe }}/api/runtime/view/git?tab=status&file={{ f.path }}{% if workspace_id %}&workspace_id={{ workspace_id }}{% endif %}')">
      <div class="git-file-row">
        <ship-badge tone="{{ f.tone }}" size="sm">{{ f.label }}</ship-badge>
        <span class="path" title="{{ f.path }}">{{ f.path }}</span>
      </div>
    </ship-list-item>
  {% endfor %}
{% else %}
  <ship-empty-state variant="placeholder">
    <ship-icon slot="icon" name="check"></ship-icon>
    <span slot="title">Working tree clean</span>
    No uncommitted changes.
  </ship-empty-state>
{% endif %}
