{#-
  Branches tab — list of local branches with ahead/behind + detail panel.
  Branch selection is client-side via $activeBranch signal (branch name).
  Expects: branches[], branch (active branch name)
-#}
<div class="git-branch-list" data-signals:activeBranch="'{{ branch | e }}'">

  {% for b in branches %}
    <div class="git-branch-row {% if b.active %}active{% endif %}"
      data-on:click="$activeBranch = '{{ b.name | e }}'">
      <ship-icon name="git-branch" size="xs"
        style="color:{% if b.active %}var(--primary){% else %}var(--muted-foreground){% endif %};flex-shrink:0">
      </ship-icon>
      <div class="git-branch-info">
        <div class="git-branch-name" title="{{ b.name }}">{{ b.name }}</div>
        {% if b.upstream %}
          <div class="git-branch-sub">{{ b.upstream }}</div>
        {% endif %}
      </div>
      <div class="git-branch-counters">
        {% if b.ahead > 0 %}<span class="add">↑{{ b.ahead }}</span>{% endif %}
        {% if b.behind > 0 %}<span class="del">↓{{ b.behind }}</span>{% endif %}
      </div>
    </div>
  {% else %}
    <div style="padding:16px 12px;font-size:11.5px;color:var(--muted-foreground)">
      No local branches found.
    </div>
  {% endfor %}

</div>

{#- Detail panel — shows info for whichever branch is selected -#}
<div class="git-branch-detail">
  {% for b in branches %}
    <div data-show="$activeBranch == '{{ b.name | e }}'"
      {% if not loop.first %}style="display:none"{% endif %}>
      <div class="git-branch-detail-head">
        <span class="git-branch-detail-name">{{ b.name }}</span>
        {% if b.active %}
          <ship-chip tone="success">active</ship-chip>
        {% endif %}
      </div>
      <div style="font-size:11.5px;color:var(--muted-foreground);margin-bottom:16px">
        {% if b.upstream %}Tracking <code>{{ b.upstream }}</code>.{% endif %}
        {% if b.ahead > 0 or b.behind > 0 %}
          <span class="add">{{ b.ahead }} ahead</span> · <span class="del">{{ b.behind }} behind</span>.
        {% elif b.upstream %}
          Up to date.
        {% endif %}
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        {% if not b.active %}
          <ship-button variant="ghost" size="sm">
            <ship-icon name="git-branch" size="xs"></ship-icon> Check out
          </ship-button>
        {% endif %}
        {% if b.ahead > 0 %}
          <ship-button variant="ghost" size="sm">
            <ship-icon name="upload" size="xs"></ship-icon> Push
          </ship-button>
        {% endif %}
        {% if b.behind > 0 %}
          <ship-button variant="ghost" size="sm">
            <ship-icon name="download" size="xs"></ship-icon> Pull
          </ship-button>
        {% endif %}
      </div>
    </div>
  {% endfor %}

  {% if not branches %}
    <div style="color:var(--muted-foreground);font-size:12px">No branch selected.</div>
  {% endif %}
</div>
