{#- Expects commits: list of {sha, short_sha, author, date, subject}. -#}
{% if commits and commits | length > 0 %}
<ship-timeline>
  {% for c in commits %}
  <ship-timeline-item interactive tone="muted" at="{{ c.date }}"
    data-on:click="@get('/api/runtime/view/git?tab=log&commit={{ c.sha }}{% if workspace_id %}&workspace_id={{ workspace_id }}{% endif %}')">
    <div slot="header">
      <ship-code inline class="git-commit-sha">{{ c.short_sha }}</ship-code>
      <ship-copy-button value="{{ c.sha }}" size="sm"></ship-copy-button>
    </div>
    <ship-tooltip text="{{ c.subject }}">
      <div>{{ c.subject | truncate(72) }}</div>
    </ship-tooltip>
    <div slot="meta">{{ c.author }} &middot; <ship-timestamp value="{{ c.date }}"></ship-timestamp></div>
  </ship-timeline-item>
  {% endfor %}
</ship-timeline>
{% else %}
<ship-empty-state variant="placeholder">
  <ship-icon slot="icon" name="git-commit"></ship-icon>
  <span slot="title">No commits yet</span>
  This branch has no history.
</ship-empty-state>
{% endif %}
