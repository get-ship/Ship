{#-
  Working-tree status block. Expects:
    branch, clean (bool), total_changed, staged[], modified[], untracked[]
    workspace_id
  Each file row drills into the working-tree diff (commit="" → unstaged HEAD diff).
-#}
{% from '_urls.html.j2' import view_git %}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}
{%- set diff_url = view_git() ~ '?commit=WORKING' ~ ws_qs -%}

<div class="ship-git-section">
  {% if branch %}
  <div class="ship-git-toolbar" role="toolbar" aria-label="Branch">
    <span class="ship-git-toolbar-chip">
      <ship-icon name="git-branch" size="xs"></ship-icon>
      {{ branch }}
    </span>
    <span class="ship-git-toolbar-meta">
      {{ modified | length }} modified / {{ untracked | length }} untracked
    </span>
    {% if total_changed and total_changed > 0 %}
      <span class="ship-git-toolbar-meta">·</span>
      <span class="ship-git-toolbar-meta">{{ total_changed }} file{% if total_changed != 1 %}s{% endif %} changed</span>
    {% endif %}
    <span class="ship-git-toolbar-spacer"></span>
    {% if total_changed and total_changed > 0 %}
      <button type="button" class="ship-git-toolbar-link"
        data-on:click="@get('{{ diff_url | safe }}')">
        <ship-icon name="git-compare" size="xs"></ship-icon>
        View diff
      </button>
    {% endif %}
  </div>
  {% endif %}

  {% if not clean %}
    <div class="ship-git-breakdown">
      {% if staged | length > 0 %}<span><ship-status-dot tone="success" size="sm"></ship-status-dot>{{ staged | length }} staged</span>{% endif %}
      {% if modified | length > 0 %}<span><ship-status-dot tone="warning" size="sm"></ship-status-dot>{{ modified | length }} modified</span>{% endif %}
      {% if untracked | length > 0 %}<span><ship-status-dot tone="destructive" size="sm"></ship-status-dot>{{ untracked | length }} untracked</span>{% endif %}
    </div>

    <div class="ship-git-file-list" role="list">
      {% for f in staged %}
        <button type="button" role="listitem" class="ship-git-file-row"
          data-on:click="@get('{{ diff_url | safe }}')">
          <ship-status-dot tone="{{ f.tone }}" size="sm"></ship-status-dot>
          <span class="ship-git-file-name" title="{{ f.path }}">{{ f.path }}</span>
        </button>
      {% endfor %}
      {% for f in modified %}
        <button type="button" role="listitem" class="ship-git-file-row"
          data-on:click="@get('{{ diff_url | safe }}')">
          <ship-status-dot tone="{{ f.tone }}" size="sm"></ship-status-dot>
          <span class="ship-git-file-name" title="{{ f.path }}">{{ f.path }}</span>
        </button>
      {% endfor %}
      {% for f in untracked %}
        <button type="button" role="listitem" class="ship-git-file-row"
          data-on:click="@get('{{ diff_url | safe }}')">
          <ship-status-dot tone="{{ f.tone }}" size="sm"></ship-status-dot>
          <span class="ship-git-file-name" title="{{ f.path }}">{{ f.path }}</span>
        </button>
      {% endfor %}
    </div>
  {% endif %}

  {% if total_changed and total_changed > 0 %}
    <div class="ship-git-view-diff">
      <ship-button tone="accent" variant="solid" size="md"
        data-on:click="@get('{{ diff_url | safe }}')">
        <ship-icon name="git-compare" size="xs"></ship-icon>
        View diff
      </ship-button>
    </div>
  {% endif %}
</div>
