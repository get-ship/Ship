{#-
  Diff pane — right side of the Changes tab.
  Renders the selected commit/working diff using ship-git-diff component tree.
  Annotations (inline comments) from the annotations collection are threaded
  between diff lines keyed by selector = "{sha}:{line}".
  Expects: selected_commit, annotations, workspace_id
-#}
{% from '_urls.html.j2' import view_git %}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}

<div class="git-pane-right">
  {% if selected_commit %}
    {#- Diff header -#}
    <div class="git-panel-head">
      {% if selected_commit.is_working %}
        <ship-icon name="git-compare" size="xs"></ship-icon>
        <strong>Working tree</strong>
        <span>HEAD → worktree</span>
      {% else %}
        <ship-icon name="git-commit" size="xs"></ship-icon>
        <strong>{{ selected_commit.short_sha }}</strong>
        <span style="font-size:10.5px;color:var(--muted-foreground)">
          {{ selected_commit.parsed.total_additions }} additions ·
          {{ selected_commit.parsed.total_deletions }} deletions ·
          {{ selected_commit.parsed.files | length }} file{% if selected_commit.parsed.files | length != 1 %}s{% endif %}
        </span>
        <span class="spacer"></span>
        <ship-button variant="ghost" size="sm"
          data-on:click="@get('{{ view_git() }}?commit=WORKING{{ ws_qs }}')">
          <ship-icon name="git-compare" size="xs"></ship-icon>
          Working tree
        </ship-button>
      {% endif %}
      <span class="spacer"></span>
      <ship-button variant="ghost" size="sm"
        data-on:click="@get('{{ view_git() }}{{ ws_qs and ('?' ~ ws_qs[1:]) or '' }}')">
        <ship-icon name="x" size="xs"></ship-icon>
      </ship-button>
    </div>

    {#- Diff body -#}
    <div class="git-diff-scroll">
      {% if selected_commit.parsed.files | length > 0 %}
        <ship-git-diff
          files="{{ selected_commit.parsed.files | length }}"
          additions="{{ selected_commit.parsed.total_additions }}"
          deletions="{{ selected_commit.parsed.total_deletions }}">
          {% for file in selected_commit.parsed.files %}
            <ship-git-diff-file
              path="{{ file.path }}"
              additions="{{ file.additions }}"
              deletions="{{ file.deletions }}">
              {% for hunk in file.hunks %}
                <ship-git-diff-hunk header="{{ hunk.header | e }}">
                  {% for line in hunk.lines %}
                    {%- set line_key = selected_commit.sha ~ ':' ~ (line.new_num if line.new_num is not none else line.old_num) -%}
                    {%- set line_annotations = annotations[line_key] if annotations and line_key in annotations else [] -%}
                    <ship-git-diff-line
                      type="{{ line.kind }}"
                      old="{{ line.old_num if line.old_num is not none else '' }}"
                      new="{{ line.new_num if line.new_num is not none else '' }}"
                      {% if line_annotations | length > 0 %}comment-count="{{ line_annotations | length }}"{% endif %}
                    >{{ line.content }}</ship-git-diff-line>
                    {%- if line_annotations %}
                      <div class="git-annotation-thread" style="padding:8px 52px;background:color-mix(in oklch,var(--accent) 6%,transparent);border-bottom:1px solid color-mix(in oklch,var(--border) 40%,transparent)">
                        {% for ann in line_annotations %}
                          <div style="display:flex;gap:8px;align-items:flex-start;padding:4px 0">
                            <div style="width:18px;height:18px;border-radius:50%;background:var(--muted);display:grid;place-items:center;font-size:9px;font-weight:600;flex-shrink:0">
                              {{ ann.author_kind[:1] | upper }}
                            </div>
                            <div style="flex:1;min-width:0">
                              <div style="font-size:10.5px;color:var(--muted-foreground);margin-bottom:2px">
                                <span style="color:var(--foreground);font-weight:500">{{ ann.author_kind }}</span>
                                <ship-timestamp style="margin-left:6px">{{ ann.created_at }}</ship-timestamp>
                                {% if ann.intent %}<span style="margin-left:6px;font-size:9px;padding:1px 4px;border-radius:3px;background:color-mix(in oklch,var(--accent) 18%,transparent);color:var(--accent)">{{ ann.intent }}</span>{% endif %}
                              </div>
                              {% if ann.note %}
                                <div style="font-size:12px;color:var(--foreground);white-space:pre-wrap">{{ ann.note | e }}</div>
                              {% endif %}
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                    {%- endif %}
                  {% endfor %}
                </ship-git-diff-hunk>
              {% endfor %}
            </ship-git-diff-file>
          {% endfor %}
        </ship-git-diff>
      {% else %}
        <div class="git-diff-empty">
          <ship-icon name="file-diff" size="lg"></ship-icon>
          No diff content.
        </div>
      {% endif %}
    </div>

  {% else %}
    {#- Empty state: no file selected -#}
    <div class="git-diff-empty">
      <ship-icon name="git-compare" size="lg" style="opacity:.4"></ship-icon>
      <span>Select a file to view its diff.</span>
    </div>
  {% endif %}
</div>
