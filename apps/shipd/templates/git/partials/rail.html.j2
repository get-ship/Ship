{#- Left rail: tabs + status/log lists. Expects active_tab, status_files, commits, selected_commit, workspace_id. -#}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}
<ship-tabs variant="segmented" active="{{ active_tab }}"
  data-on:ship-tab-change="@get('{{ daemon_origin | safe }}/api/runtime/view/git?tab=' + evt.detail.name + '{{ ws_qs }}')">
  <ship-tab name="status" label="Status" count="{{ status_files | length }}"></ship-tab>
  <ship-tab name="log" label="Log" count="{{ commits | length }}"></ship-tab>
</ship-tabs>

<div class="git-rail-section">
  {% if active_tab == 'status' %}
    {% include 'git/partials/status_list.html.j2' %}
  {% else %}
    {% include 'git/partials/log_timeline.html.j2' %}
  {% endif %}
</div>
