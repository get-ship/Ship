{#-
  Git viewer — three-tab layout (Changes / History / Branches).
  Tab switching is client-side via Datastar `$tab` signal; diff selection
  triggers a server roundtrip so the SSE stream re-renders the full view.
  Root element id="ship-view-root" is the SSE morph target.
-#}
{% from '_urls.html.j2' import view_git %}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}
<div id="ship-view-root" class="ship-view-git"
  data-signals:tab="'changes'"
  data-signals:viewMode="'tree'">
  <style>
    .ship-view-git {
      display: flex; flex-direction: column; height: 100%; overflow: hidden;
      color: var(--foreground); font-family: var(--font-body);
    }

    /* Top chrome */
    .git-topbar {
      display: flex; align-items: center; gap: 10px;
      padding: 7px 14px 0;
      border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
      flex-shrink: 0;
    }
    .git-crumbs { font-size: 11.5px; color: var(--muted-foreground); display: flex; align-items: center; gap: 4px; }
    .git-crumbs .cur { color: var(--foreground); font-weight: 500; }
    .git-crumbs .sep { opacity: 0.4; }
    .git-branch-pill {
      display: inline-flex; align-items: center; gap: 5px;
      font-family: var(--font-mono); font-size: 11px; font-weight: 500;
      padding: 2px 8px; border-radius: 9999px;
      border: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
      background: var(--background); color: var(--foreground);
      margin-left: 4px;
    }
    .git-branch-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); }
    .git-branch-dot.warn { background: var(--warning); }
    .git-topbar-right { margin-left: auto; display: flex; align-items: center; gap: 4px; }
    .git-tabs { display: flex; align-items: flex-end; gap: 0; padding: 0 2px; }
    .git-tab {
      appearance: none; border: 0; background: transparent; cursor: pointer;
      font: inherit; font-size: 12.5px; color: var(--muted-foreground);
      padding: 7px 12px 8px; border-bottom: 2px solid transparent;
      transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
      display: inline-flex; align-items: center; gap: 5px;
    }
    .git-tab:hover { color: var(--foreground); }
    .git-tab.active { color: var(--foreground); border-bottom-color: var(--primary); }
    .git-tab .cnt {
      font-size: 10px; padding: 1px 5px; border-radius: 9999px;
      background: color-mix(in oklch, var(--muted) 80%, transparent);
      color: var(--muted-foreground);
    }

    /* Main content area */
    .git-body { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }

    /* Changes tab — 2-column split */
    .git-split { flex: 1; display: flex; min-height: 0; overflow: hidden; }
    .git-pane-left {
      width: 280px; min-width: 200px; max-width: 380px;
      display: flex; flex-direction: column;
      border-right: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
      flex-shrink: 0;
    }
    .git-pane-right { flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }

    /* Panel header */
    .git-panel-head {
      display: flex; align-items: center; gap: 8px;
      padding: 7px 10px 6px;
      border-bottom: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
      font-size: 11.5px; color: var(--muted-foreground); flex-shrink: 0;
    }
    .git-panel-head strong { color: var(--foreground); font-weight: 500; }
    .git-panel-head .spacer { flex: 1; }
    .git-view-toggle {
      display: inline-flex; border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
      border-radius: var(--radius-sm); overflow: hidden;
    }
    .git-view-toggle button {
      appearance: none; border: 0; border-radius: 0; background: transparent;
      padding: 2px 6px; font-size: 10px; cursor: pointer; color: var(--muted-foreground);
      transition: background var(--duration-fast) ease, color var(--duration-fast) ease;
    }
    .git-view-toggle button.active { background: var(--muted); color: var(--foreground); }
    .git-view-toggle button + button { border-left: 1px solid color-mix(in oklch, var(--border) 60%, transparent); }

    /* File list */
    .git-file-scroll { flex: 1; overflow-y: auto; }
    .git-group-label {
      padding: 4px 10px 2px;
      font-size: 10px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--muted-foreground); background: var(--background); position: sticky; top: 0;
    }
    .git-file-row {
      display: flex; align-items: center; gap: 6px;
      width: 100%; padding: 4px 10px; min-height: 26px;
      appearance: none; border: 0; background: transparent;
      font-family: var(--font-mono); font-size: 11px; color: var(--foreground);
      cursor: pointer; text-align: left;
      transition: background var(--duration-fast) ease;
      border-top: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
    }
    .git-file-row:first-child { border-top: none; }
    .git-file-row:hover { background: color-mix(in oklch, var(--muted) 50%, transparent); }
    .git-file-row.active { background: color-mix(in oklch, var(--primary) 10%, transparent); }
    .git-file-badge {
      font-size: 9px; padding: 1px 4px; border-radius: 3px; font-weight: 700;
      flex-shrink: 0; letter-spacing: 0.02em;
    }
    .git-file-badge.M { background: color-mix(in oklch, var(--warning) 18%, transparent); color: var(--warning); }
    .git-file-badge.A { background: color-mix(in oklch, var(--success) 18%, transparent); color: var(--success); }
    .git-file-badge.D { background: color-mix(in oklch, var(--destructive) 18%, transparent); color: var(--destructive); }
    .git-file-badge.R { background: color-mix(in oklch, var(--info) 18%, transparent); color: var(--info); }
    .git-file-badge.Q { background: color-mix(in oklch, var(--muted-foreground) 18%, transparent); color: var(--muted-foreground); }
    .git-file-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .git-file-dir { color: var(--muted-foreground); }
    .git-file-stats { display: flex; gap: 4px; font-size: 10px; flex-shrink: 0; }
    .git-file-stats .a { color: var(--success); }
    .git-file-stats .d { color: var(--destructive); }

    /* Commit composer */
    .git-commit-bar {
      border-top: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
      padding: 8px 10px; flex-shrink: 0;
    }
    .git-commit-input {
      width: 100%; resize: none; font: inherit; font-size: 11.5px;
      background: var(--input); border: 1px solid var(--border);
      border-radius: var(--radius-md); padding: 5px 8px; color: var(--foreground);
      outline: none; box-sizing: border-box; margin-bottom: 6px;
      transition: border-color var(--duration-fast) ease;
    }
    .git-commit-input:focus { border-color: var(--primary); }
    .git-commit-actions { display: flex; align-items: center; gap: 6px; }
    .git-suggest {
      flex: 1; font-size: 10.5px; color: var(--muted-foreground);
      font-family: var(--font-mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      cursor: pointer; padding: 2px 4px; border-radius: var(--radius-sm);
      transition: color var(--duration-fast) ease;
    }
    .git-suggest:hover { color: var(--foreground); }

    /* Diff pane */
    .git-diff-scroll { flex: 1; overflow: auto; }
    .git-diff-empty {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      height: 100%; gap: 10px; color: var(--muted-foreground); font-size: 13px;
    }

    /* History tab */
    .git-history { flex: 1; overflow-y: auto; }

    /* Branches tab */
    .git-branches { flex: 1; display: flex; min-height: 0; overflow: hidden; }
    .git-branch-list {
      width: 240px; min-width: 180px; flex-shrink: 0;
      border-right: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
      overflow-y: auto;
    }
    .git-branch-row {
      display: flex; align-items: center; gap: 8px;
      padding: 7px 12px; cursor: pointer;
      border-top: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
      transition: background var(--duration-fast) ease; font-size: 12px;
    }
    .git-branch-row:first-child { border-top: none; }
    .git-branch-row:hover { background: color-mix(in oklch, var(--muted) 50%, transparent); }
    .git-branch-row.active { background: color-mix(in oklch, var(--primary) 8%, transparent); }
    .git-branch-info { flex: 1; min-width: 0; }
    .git-branch-name { font-family: var(--font-mono); font-size: 11.5px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .git-branch-sub { font-size: 10px; color: var(--muted-foreground); margin-top: 1px; }
    .git-branch-counters { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; font-family: var(--font-mono); font-size: 10px; }
    .git-branch-detail { flex: 1; overflow-y: auto; padding: 16px; }
    .git-branch-detail-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; }
    .git-branch-detail-name { font-family: var(--font-mono); font-size: 15px; font-weight: 600; }
    .git-branch-detail-meta { font-size: 11.5px; color: var(--muted-foreground); }

    /* Status bar */
    .git-statusbar {
      display: flex; align-items: center; gap: 10px;
      padding: 3px 12px;
      border-top: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
      font-size: 10.5px; color: var(--muted-foreground);
      background: color-mix(in oklch, var(--muted) 30%, transparent);
      flex-shrink: 0;
    }
    .git-statusbar .spacer { flex: 1; }
    .git-statusbar .seg { display: inline-flex; align-items: center; gap: 4px; }
    .git-statusbar .mono { font-family: var(--font-mono); }

    /* Shared utilities */
    .add { color: var(--success); }
    .del { color: var(--destructive); }
  </style>

  {#- Top chrome -#}
  <div class="git-topbar">
    <div class="git-crumbs">
      <span>git</span>
      {% if branch %}
        <span class="sep">/</span>
        <span class="cur">{{ branch }}</span>
      {% endif %}
    </div>
    {% if branch %}
    <span class="git-branch-pill">
      <span class="git-branch-dot {% if not clean %}warn{% endif %}"></span>
      {{ branch }}
      {% if ahead > 0 or behind > 0 %}
        <span style="color:var(--muted-foreground)">·</span>
        {% if ahead > 0 %}<span class="add">↑{{ ahead }}</span>{% endif %}
        {% if behind > 0 %}<span class="del">↓{{ behind }}</span>{% endif %}
      {% endif %}
    </span>
    {% endif %}

    <div class="git-tabs">
      <button type="button" class="git-tab"
        data-class:active="$tab == 'changes'"
        data-on:click="$tab = 'changes'">
        Changes <span class="cnt">{{ total_changed }}</span>
      </button>
      <button type="button" class="git-tab"
        data-class:active="$tab == 'history'"
        data-on:click="$tab = 'history'">
        History <span class="cnt">{{ commits | length }}</span>
      </button>
      <button type="button" class="git-tab"
        data-class:active="$tab == 'branches'"
        data-on:click="$tab = 'branches'">
        Branches <span class="cnt">{{ branches | length }}</span>
      </button>
    </div>

    <div class="git-topbar-right">
      <ship-button variant="ghost" size="sm" title="Fetch"
        data-on:click="@get('{{ view_git() }}{{ ws_qs and ('?' ~ ws_qs[1:]) or '' }}')">
        <ship-icon name="refresh-cw" size="xs"></ship-icon>
      </ship-button>
    </div>
  </div>

  {#- Tab bodies -#}
  <div class="git-body">

    {#- Changes tab -#}
    <div class="git-split" data-show="$tab == 'changes'">
      {% include 'git/partials/changes_panel.html.j2' %}
      {% include 'git/partials/diff_pane.html.j2' %}
    </div>

    {#- History tab -#}
    <div class="git-history" data-show="$tab == 'history'" style="display:none">
      {% include 'git/partials/history_tab.html.j2' %}
    </div>

    {#- Branches tab -#}
    <div class="git-branches" data-show="$tab == 'branches'" style="display:none">
      {% include 'git/partials/branches_tab.html.j2' %}
    </div>

  </div>

  {#- Status bar -#}
  <div class="git-statusbar">
    {% if branch %}
    <span class="seg">
      <ship-status-dot tone="{% if clean %}success{% else %}warning{% endif %}" size="sm"></ship-status-dot>
      <span class="mono">{{ branch }}</span>
    </span>
    {% endif %}
    {% if ahead > 0 or behind > 0 %}
      <span class="seg mono">{% if ahead > 0 %}↑{{ ahead }}{% endif %}{% if behind > 0 %} ↓{{ behind }}{% endif %}</span>
    {% endif %}
    <span class="spacer"></span>
    {% if selected_commit %}
      <span class="seg mono" style="opacity:.7">{{ selected_commit.short_sha }}</span>
    {% endif %}
  </div>
</div>
