// apps.jsonc — the Ship monorepo's app list. Read by shipd at startup
// and by the Justfile's build orchestrator. NOT read by deck (L1) —
// deck is per-app, the host owns the list.
//
// Each entry is the shape deck's `AppServeConfig` consumes directly.
// `name` is the app's URL namespace — the framework serves the app's
// assets under `/<name>/<file>` (no separate `assetPrefix` field, the
// name is the prefix). `source` is repo-relative (the path the
// bundler wrote to, e.g. `apps/hub/.deck`). `route` is the URL prefix
// the app serves at. `injectGlobals` injects `window.<key>=<value>;`
// into the HTML, with `$<param>` substituted from URL path captures
// declared in `route`.
{
  "apps": [
    {
      "name": "hub",
      "root": "apps/hub",
      "source": "apps/hub/.deck",
      "route": "/"
    },
    {
      "name": "spaces",
      "root": "apps/spaces",
      "source": "apps/spaces/.deck",
      "route": "/space/{id}",
      "injectGlobals": { "DECK_APP_ID": "$id" }
    }
  ]
}
