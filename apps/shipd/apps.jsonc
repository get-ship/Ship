// apps.jsonc — the Ship monorepo's app ORCHESTRATION list: which apps to
// serve and which package each one resolves to. Read by shipd at startup,
// which resolves each entry's `package` via the `AppSource` resolver
// (Phase 1: node_modules; future phases: CDN / registry), then loads each
// package's `deck.jsonc` (if any) into its serve config and pairs it
// with the host's bind (name/route/source) here. NOT read by deck (L1) —
// deck is per-app, the host owns the list.
//
// Schema (per entry):
//   { "name": string,   // app handle (logging/orchestration). The
//                       // authoritative URL namespace is the RESOLVED
//                       // PACKAGE DIR's basename (`@ship/hub` ⇒ `hub`);
//                       // a mismatch with `name` is logged and the
//                       // basename wins.
//     "package": string,// Package reference resolved via AppSource
//                       // (Phase 1: looks up `<base>/node_modules/<pkg>`).
//                       // Scoped (`@ship/hub`) and unscoped (`spaces`)
//                       // both supported.
//     "route": string,  // URL route pattern shipd mounts the app at.
//                       // AUTHORITATIVE — the per-app `deck.jsonc`
//                       // cannot override it (the host composes many
//                       // apps; the app does not decide where it
//                       // mounts). `{id}` is a path capture.
//     "source"?: string // OPTIONAL override for the convention
//                       // `<resolved-pkg-dir-basename>/.deck`. When
//                       // present, must be a path relative to the
//                       // resolved package dir. Rare; default tracks
//                       // the bundler's out_dir.
//   }
//
// Per-app config (render, injectGlobals, entry) lives in each package's
// `<package>/deck.jsonc` — the package declares only the NON-conventional
// pieces (its URL-capture → window globals, its host-owned entry
// bootstrap). Conventional defaults — name/route/source — come from this
// orchestration list + the resolved package dir's basename + the bundler
// convention.
//
// Phase 1 (node resolution):
//   The host sets `SHIP_APPS_BASE_DIR` (or `--apps-base-dir`) to a
//   directory whose `node_modules/` contains the referenced packages.
//   Dev: ship-apps workspace (`/home/madvib/dev/Ship/ship-apps`). The
//   workspace's `package.json` self-declares `@ship/hub` + `spaces` as
//   workspace dependencies so `bun install` materializes them as
//   `node_modules/@ship/hub` and `node_modules/spaces` symlinks/dirs.
//   The default in production is the host's installed `node_modules/`.
//
// Phase 2/3: a `Cdn { url, hash }` or `Registry { url }` resolver will
//   slot into `AppSource` without touching this file or the serve chain.
{
  "apps": [
    { "name": "hub", "package": "@ship/hub", "route": "/" },
    { "name": "spaces", "package": "spaces", "route": "/space/{id}" }
  ]
}
