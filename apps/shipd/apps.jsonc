// apps.jsonc — the Ship monorepo's app ORCHESTRATION list: which apps to
// serve and where each one's `deck.jsonc` lives. Read by shipd at startup
// (which loads each app's `deck.jsonc` into its serve config) and by the
// Justfile build orchestrator. NOT read by deck (L1) — deck is per-app, the
// host owns the list.
//
// Schema (per entry):
//   { "name": string,   // app handle (logging/orchestration)
//     "root": string,    // repo-relative dir holding the app's deck.jsonc
//     "route": string }  // build-orchestration hint (root app, "/", bundles
//                        // the /_deck/* framework surface)
//
// Per-app config (source, render, injectGlobals, viewOutput) lives in each
// app's `apps/<root>/deck.jsonc` — the app defines the app. shipd serves using
// the route declared in each app's deck.jsonc, which is authoritative.
{
  "apps": [
    { "name": "hub", "root": "apps/hub", "route": "/" },
    { "name": "spaces", "root": "apps/spaces", "route": "/space/{id}" }
  ]
}
