// apps.jsonc — the Ship monorepo's app ORCHESTRATION list: which apps to
// serve and where each one's `deck.jsonc` lives. Read by shipd at startup,
// which loads each app's `deck.jsonc` (if any) into its serve config and
// pairs it with the host's bind (name/route/source) here. NOT read by
// deck (L1) — deck is per-app, the host owns the list.
//
// Schema (per entry):
//   { "name": string,   // app handle (logging/orchestration). MUST match
//                       // the directory basename (`apps/hub` ⇒ `hub`);
//                       // the directory basename is authoritative for
//                       // the URL namespace — the framework derives
//                       // identity from the dir.
//     "root": string,    // repo-relative dir holding the app's deck.jsonc
//                        // (or just the app source, when the app's
//                        // config is fully conventional and ships no
//                        // deck.jsonc).
//     "route": string }  // URL route pattern shipd mounts the app at.
//                        // AUTHORITATIVE — the per-app `deck.jsonc`
//                        // cannot override it (the host composes many
//                        // apps; the app does not decide where it
//                        // mounts). `{id}` is a path capture.
//
// Per-app config (render, injectGlobals, entry) lives in each app's
// `apps/<root>/deck.jsonc` — the app declares only the NON-conventional
// pieces (its URL-capture → window globals, its host-owned entry
// bootstrap). Conventional defaults — name/route/source — come from this
// orchestration list + the directory basename + the bundler convention.
{
  "apps": [
    { "name": "hub", "root": "/home/madvib/dev/ship-apps/apps/hub", "route": "/" },
    { "name": "spaces", "root": "/home/madvib/dev/ship-apps/apps/spaces", "route": "/space/{id}" }
  ]
}
