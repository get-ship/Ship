---
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<header class="set-top">
  <div class="set-top-inner">
    <a href="/" class="set-brand" aria-label="SHIP SET home">
      <img src="/ship-logo.svg" alt="" width="24" height="24" class="set-brand-logo" />
      <span class="set-brand-name">SHIP <strong>SET</strong></span>
      <ship-badge tone="muted" variant="outline" size="sm" class="set-brand-ver">docs</ship-badge>
    </a>

    <div class="set-search">
      <button type="button" class="set-search-btn" data-open-palette>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
          <path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span>Search components…</span>
        <kbd class="set-kbd">&#8984;K</kbd>
      </button>
    </div>

    <div class="set-top-actions">
      <ThemeSwitcher />
      <a class="set-top-link" href="https://getship.dev">getship.dev</a>
    </div>
  </div>
</header>

<style>
  .set-top {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 60px;
    background: color-mix(in oklch, var(--background) 80%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .set-top-inner {
    height: 100%;
    padding: 0 20px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }
  .set-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }
  .set-brand-logo { width: 22px; height: 22px; border-radius: 5px; }
  .set-brand-name {
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--muted-foreground);
  }
  .set-brand-name strong {
    color: var(--foreground);
    font-weight: 800;
    letter-spacing: 0;
  }
  .set-brand-ver { margin-left: 4px; }

  .set-search { display: flex; justify-content: center; }
  .set-search-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px 6px 12px;
    height: 34px;
    width: min(420px, 100%);
    border: 1px solid color-mix(in oklch, var(--border) 65%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--muted) 45%, var(--card));
    color: var(--muted-foreground);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .set-search-btn:hover {
    border-color: color-mix(in oklch, var(--primary) 35%, transparent);
  }
  .set-search-btn span {
    flex: 1;
    text-align: left;
  }
  .set-kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 5px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--border) 35%, transparent);
    color: var(--foreground);
  }

  .set-top-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .set-top-link {
    font-size: 13px;
    color: var(--muted-foreground);
    border-bottom: 1px dashed color-mix(in oklch, var(--border) 70%, transparent);
    padding-bottom: 1px;
  }
  .set-top-link:hover { color: var(--foreground); }

  @media (max-width: 820px) {
    .set-top-inner { grid-template-columns: auto 1fr auto; gap: 12px; padding: 0 14px; }
    .set-search, .set-top-link { display: none; }
  }
</style>
