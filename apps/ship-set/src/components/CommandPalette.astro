---
import { COMPONENTS, CATEGORY_LABELS } from '../lib/components';
import { THEMES } from '@ship/set/themes';

// Build a flat list of jumpable entries at build time. Each row has a
// category, title, a href, and a search haystack.
const items = [
  ...COMPONENTS.map((c) => ({
    kind: 'Component',
    title: c.tag,
    sub: CATEGORY_LABELS[c.category] + ' · ' + c.summary,
    href: `/components/${c.tag}`,
    haystack: `${c.tag} ${c.summary}`.toLowerCase(),
  })),
  ...THEMES.map((t) => ({
    kind: 'Theme',
    title: t.label,
    sub: t.group + ' · ' + (t.dark ? 'Dark' : 'Light'),
    href: `/themes#${t.id}`,
    haystack: `${t.label} ${t.id} theme`.toLowerCase(),
  })),
  { kind: 'Page', title: 'Overview',    sub: 'Home',                href: '/',           haystack: 'overview home' },
  { kind: 'Page', title: 'Components',  sub: 'All components',      href: '/components', haystack: 'components index' },
  { kind: 'Page', title: 'Themes',      sub: 'Theme catalog',       href: '/themes',     haystack: 'themes' },
  { kind: 'Page', title: 'Tokens',      sub: 'Design tokens',       href: '/tokens',     haystack: 'tokens design' },
  { kind: 'Page', title: 'Cookbook',    sub: 'Recipes',             href: '/cookbook',   haystack: 'cookbook recipes' },
  { kind: 'Page', title: 'Installing',  sub: 'Getting started',     href: '/installing', haystack: 'install setup' },
];
---

<ship-dialog class="set-palette" size="md" backdrop="blur" data-command-palette>
  <div slot="header" class="set-palette-head">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
      <path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      class="set-palette-input"
      placeholder="Jump to anything…"
      autocomplete="off"
      data-palette-input
    />
    <kbd class="set-palette-esc">Esc</kbd>
  </div>

  <div class="set-palette-list" role="listbox" data-palette-list>
    {items.map((it, i) => (
      <a
        href={it.href}
        class="set-palette-row"
        role="option"
        data-palette-row
        data-haystack={it.haystack}
        data-idx={i}
      >
        <span class="set-palette-kind">{it.kind}</span>
        <span class="set-palette-title">{it.title}</span>
        <span class="set-palette-sub">{it.sub}</span>
      </a>
    ))}
    <div class="set-palette-empty" data-palette-empty hidden>No matches.</div>
  </div>
</ship-dialog>

<script>
  const dialog = document.querySelector<HTMLElement & { show?: () => void; close?: () => void; open?: boolean }>('[data-command-palette]');
  const input = document.querySelector<HTMLInputElement>('[data-palette-input]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-palette-row]'));
  const empty = document.querySelector<HTMLElement>('[data-palette-empty]');

  let active = 0;

  const setActive = (i: number) => {
    const visible = rows.filter((r) => r.style.display !== 'none');
    if (!visible.length) return;
    active = (i + visible.length) % visible.length;
    for (const r of rows) r.removeAttribute('aria-selected');
    visible[active].setAttribute('aria-selected', 'true');
    visible[active].scrollIntoView({ block: 'nearest' });
  };

  const filter = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const r of rows) {
      const hay = r.dataset.haystack ?? '';
      const visible = !q || hay.includes(q);
      r.style.display = visible ? '' : 'none';
      if (visible) shown++;
    }
    if (empty) empty.hidden = shown > 0;
    active = 0;
    setActive(0);
  };

  const open = () => {
    if (!dialog) return;
    dialog.setAttribute('open', '');
    setTimeout(() => input?.focus(), 40);
  };
  const close = () => {
    if (!dialog) return;
    (dialog as any).close?.();
    dialog.removeAttribute('open');
  };

  document.addEventListener('keydown', (e) => {
    const meta = e.metaKey || e.ctrlKey;
    if (meta && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      if (dialog?.hasAttribute('open')) close();
      else open();
      return;
    }
    if (!dialog?.hasAttribute('open')) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') {
      const visible = rows.filter((r) => r.style.display !== 'none');
      const target = visible[active];
      if (target) { e.preventDefault(); location.href = (target as HTMLAnchorElement).href; }
    }
  });

  for (const btn of document.querySelectorAll('[data-open-palette]')) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      open();
    });
  }

  input?.addEventListener('input', filter);
  filter();
</script>

<style>
  .set-palette-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 4px 0;
    color: var(--muted-foreground);
  }
  .set-palette-input {
    flex: 1;
    height: 36px;
    padding: 0 6px;
    border: 0;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    font-size: 14.5px;
    outline: none;
  }
  .set-palette-esc {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 2px 5px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--border) 30%, transparent);
    color: var(--foreground);
  }

  .set-palette-list {
    max-height: 360px;
    overflow-y: auto;
    padding: 6px 4px 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .set-palette-row {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--foreground);
    text-decoration: none;
    cursor: pointer;
  }
  .set-palette-row:hover,
  .set-palette-row[aria-selected='true'] {
    background: color-mix(in oklch, var(--primary) 12%, transparent);
  }
  .set-palette-kind {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .set-palette-title {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--foreground);
  }
  .set-palette-sub {
    font-size: 11.5px;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }
  .set-palette-empty {
    padding: 16px;
    text-align: center;
    color: var(--muted-foreground);
    font-size: 13px;
  }
</style>
