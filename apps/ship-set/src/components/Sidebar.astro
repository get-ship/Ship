---
import {
  componentsByCategory,
  CATEGORY_LABELS,
  CATEGORY_ORDER,
} from '../lib/components';

interface Props { active?: string; }
const { active = '' } = Astro.props;

const buckets = componentsByCategory();

const chrome = [
  { href: '/',           label: 'Overview' },
  { href: '/installing', label: 'Installing' },
  { href: '/themes',     label: 'Themes' },
  { href: '/tokens',     label: 'Tokens' },
  { href: '/cookbook',   label: 'Cookbook' },
];
---

<aside class="set-sidebar" aria-label="Navigation">
  <nav class="set-nav">
    <section class="set-nav-group">
      <ul>
        {chrome.map((c) => (
          <li>
            <a href={c.href} class:list={['set-nav-link', active === c.href && 'is-active']}>
              {c.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    {CATEGORY_ORDER.filter((cat) => buckets[cat].length > 0).map((cat) => (
      <section class="set-nav-group">
        <header class="set-nav-head">{CATEGORY_LABELS[cat]}</header>
        <ul>
          {buckets[cat].map((c) => {
            const href = `/components/${c.tag}`;
            return (
              <li>
                <a href={href} class:list={['set-nav-link set-nav-link-tag', active === href && 'is-active']}>
                  {c.tag}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </nav>
</aside>

<style>
  .set-sidebar {
    position: sticky;
    top: 60px;
    align-self: start;
    width: var(--set-sidebar-width);
    height: calc(100vh - 60px);
    overflow-y: auto;
    padding: 18px 8px 48px 4px;
    border-right: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    background: var(--background);
  }
  .set-nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .set-nav-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .set-nav-head {
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    padding: 0 12px;
    margin-bottom: 6px;
  }
  .set-nav-link {
    display: block;
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted-foreground);
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .set-nav-link:hover {
    color: var(--foreground);
    background: color-mix(in oklch, var(--border) 22%, transparent);
  }
  .set-nav-link.is-active {
    color: var(--foreground);
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--primary);
  }
  .set-nav-link-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in oklch, var(--muted-foreground) 85%, var(--foreground));
  }
  @media (max-width: 900px) {
    .set-sidebar {
      position: static;
      width: 100%;
      height: auto;
      max-height: 260px;
      border-right: 0;
      border-bottom: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    }
  }
</style>
