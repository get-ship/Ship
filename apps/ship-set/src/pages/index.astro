---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COMPONENTS,
  componentsByCategory,
  CATEGORY_LABELS,
  CATEGORY_ORDER,
} from '../lib/components';

const buckets = componentsByCategory();
const totalComponents = COMPONENTS.length;
const populatedCategories = CATEGORY_ORDER.filter((c) => buckets[c].length > 0);
---

<BaseLayout title="SHIP SET — component library for AI-native apps" active="/">
  <section class="set-hero">
    <ship-badge tone="primary" variant="soft" size="sm">Docs</ship-badge>
    <h1 class="set-hero-title">
      The component library behind SHIP.
    </h1>
    <p class="set-hero-body">
      {totalComponents} web components, {populatedCategories.length} categories, eight themes, one
      set of design tokens &mdash; the same primitives the SHIP app,
      daemon-served views, and your own extensions render with.
    </p>

    <div class="set-hero-ctas">
      <ship-button
        tone="primary"
        variant="solid"
        size="md"
        onclick="location.href='/components'"
      >Browse components</ship-button>
      <ship-button
        variant="ghost"
        size="md"
        onclick="location.href='/installing'"
      >Install &rarr;</ship-button>
    </div>
  </section>

  <section class="set-categories">
    <h2 class="set-h2">Categories</h2>
    <div class="set-cat-grid">
      {populatedCategories.map((cat) => (
        <a class="set-cat" href={`/components#${cat}`}>
          <div class="set-cat-head">
            <span class="set-cat-label">{CATEGORY_LABELS[cat]}</span>
            <span class="set-cat-count">{buckets[cat].length}</span>
          </div>
          <div class="set-cat-tags">
            {buckets[cat].slice(0, 5).map((c) => (
              <code class="set-cat-tag">{c.tag}</code>
            ))}
            {buckets[cat].length > 5 && (
              <span class="set-cat-more">+{buckets[cat].length - 5}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .set-hero {
    padding: 40px 0 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 52rem;
  }
  .set-hero-title {
    font-size: clamp(32px, 4.5vw, 52px);
    letter-spacing: -0.028em;
    line-height: 1.1;
  }
  .set-hero-body {
    color: var(--muted-foreground);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.55;
  }
  .set-hero-ctas {
    display: inline-flex;
    gap: 10px;
    margin-top: 4px;
  }

  .set-h2 {
    font-size: 22px;
    margin-bottom: 16px;
    letter-spacing: -0.015em;
  }
  .set-categories {
    padding: 16px 0 48px;
  }
  .set-cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
  }
  .set-cat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    background: var(--card);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .set-cat:hover {
    border-color: color-mix(in oklch, var(--primary) 50%, transparent);
    transform: translateY(-1px);
  }
  .set-cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .set-cat-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .set-cat-count {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--primary) 12%, transparent);
    color: var(--primary);
  }
  .set-cat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .set-cat-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--border) 30%, transparent);
    color: var(--muted-foreground);
  }
  .set-cat-more {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-foreground);
    align-self: center;
  }
</style>
