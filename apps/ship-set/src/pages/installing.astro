---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Installing · SHIP SET" active="/installing">
  <section class="in-head">
    <h1 class="in-title">Installing</h1>
    <p class="in-sub">
      SHIP SET is published as <code>@ship/ui</code> today. Install
      into any Vite / Astro / plain-HTML app, import the elements
      bundle once, use them anywhere.
    </p>
  </section>

  <section class="in-section">
    <h2 class="in-h2">1 · Install</h2>
    <div class="in-code">
      <pre><code>pnpm add @ship/ui</code></pre>
      <button type="button" class="in-copy" data-copy="pnpm add @ship/ui">Copy</button>
    </div>
    <p class="in-note">
      Works with npm, yarn, bun, and any package manager that reads
      <code>package.json</code>.
    </p>
  </section>

  <section class="in-section">
    <h2 class="in-h2">2 · Import once</h2>
    <div class="in-code">
<pre><code>import '@ship/ui/elements'
import '@ship/ui/tokens.css'
import '@ship/ui/themes.css'</code></pre>
      <button type="button" class="in-copy" data-copy={`import '@ship/ui/elements'
import '@ship/ui/tokens.css'
import '@ship/ui/themes.css'`}>Copy</button>
    </div>
    <p class="in-note">
      The elements module registers every <code>&lt;ship-*&gt;</code>
      tag via side-effect. Tokens and themes are plain CSS files —
      drop them into your global stylesheet.
    </p>
  </section>

  <section class="in-section">
    <h2 class="in-h2">3 · Use</h2>
    <div class="in-code">
<pre><code>&lt;ship-card variant="outline" padding="lg"&gt;
  &lt;strong slot="header"&gt;Hello&lt;/strong&gt;
  Any framework, any template engine, any file format that renders HTML.
&lt;/ship-card&gt;</code></pre>
      <button type="button" class="in-copy" data-copy={`<ship-card variant="outline" padding="lg">
  <strong slot="header">Hello</strong>
  Any framework, any template engine, any file format that renders HTML.
</ship-card>`}>Copy</button>
    </div>
    <div class="in-preview">
      <ship-card variant="outline" padding="lg">
        <strong slot="header" style="font-family:var(--font-display);font-weight:700;font-size:16px;">Hello</strong>
        Any framework, any template engine, any file format that renders HTML.
      </ship-card>
    </div>
  </section>

  <section class="in-section">
    <h2 class="in-h2">Applying a theme</h2>
    <p class="in-note">
      Themes are opt-in via <code>data-theme</code> on <code>&lt;html&gt;</code>.
      Pair with the <code>.dark</code> class for inherently-dark themes
      so shadow/elevation tokens flip too.
    </p>
    <div class="in-code">
<pre><code>import &#123; applyTheme, persistTheme &#125; from '@ship/ui/themes'

applyTheme('gruvbox-dark')   // sets data-theme + .dark on &lt;html&gt;
persistTheme('gruvbox-dark') // localStorage for next load</code></pre>
      <button type="button" class="in-copy" data-copy={`import { applyTheme, persistTheme } from '@ship/ui/themes'

applyTheme('gruvbox-dark')
persistTheme('gruvbox-dark')`}>Copy</button>
    </div>
  </section>
</BaseLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    btn.addEventListener('click', async (ev) => {
      ev.preventDefault();
      try {
        await navigator.clipboard.writeText(btn.getAttribute('data-copy') ?? '');
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch {}
    });
  }
</script>

<style>
  .in-head { padding: 24px 0 18px; display: flex; flex-direction: column; gap: 10px; }
  .in-title { font-size: clamp(30px, 4vw, 44px); letter-spacing: -0.024em; }
  .in-sub { color: var(--muted-foreground); max-width: 60ch; }
  .in-sub code,
  .in-note code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--border) 30%, transparent);
    color: var(--foreground);
  }

  .in-section { padding: 18px 0; display: flex; flex-direction: column; gap: 12px; }
  .in-h2 { font-size: 18px; letter-spacing: -0.01em; }
  .in-note { color: var(--muted-foreground); font-size: 13.5px; max-width: 62ch; }

  .in-code {
    position: relative;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    overflow: hidden;
  }
  .in-code pre {
    margin: 0;
    padding: 14px 16px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    overflow: auto;
    color: var(--foreground);
    tab-size: 2;
  }
  .in-copy {
    position: absolute;
    top: 10px; right: 10px;
    padding: 3px 9px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
  }
  .in-copy:hover { border-color: var(--primary); color: var(--primary); }

  .in-preview {
    display: grid;
    place-items: center;
    padding: 24px;
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
</style>
