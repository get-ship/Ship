---
import BaseLayout from '../layouts/BaseLayout.astro';

// Each recipe is a self-contained composition of ship-* components.
// Rendered live, with a collapsible source block.
const recipes = [
  {
    id: 'sign-in-card',
    title: 'Sign-in card',
    blurb: 'ship-card as a shell, ship-input for email/password, ship-button for submit + provider.',
    html: `<ship-card variant="outline" padding="lg" style="max-width:380px;">
  <div slot="header" style="font-family:var(--font-display);font-weight:700;font-size:18px;">Welcome back</div>
  <div style="display:flex;flex-direction:column;gap:10px;margin:10px 0 14px;">
    <ship-input placeholder="you@company.com" type="email"></ship-input>
    <ship-input placeholder="Password" type="password"></ship-input>
  </div>
  <ship-toolbar slot="footer" justify="between">
    <ship-button variant="outline" size="sm">GitHub</ship-button>
    <ship-button tone="primary" variant="solid" size="sm">Sign in</ship-button>
  </ship-toolbar>
</ship-card>`,
  },
  {
    id: 'dashboard-tile',
    title: 'Dashboard tile',
    blurb: 'Stat + sparkline + status badge. Two minutes to ship.',
    html: `<ship-card variant="outline" padding="lg" style="max-width:320px;">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
    <div>
      <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted-foreground);">Runs this week</div>
      <div style="font-family:var(--font-display);font-weight:800;font-size:32px;margin-top:4px;">58</div>
    </div>
    <ship-badge tone="success" variant="soft" size="sm">on budget</ship-badge>
  </div>
  <ship-sparkline data="3,7,5,11,8,14,10" tone="accent" width="280" height="36"></ship-sparkline>
</ship-card>`,
  },
  {
    id: 'filtered-row',
    title: 'Filter bar',
    blurb: 'Search + select + toggle group in a ship-toolbar.',
    html: `<ship-toolbar gap="sm" style="padding:8px 10px;border:1px solid color-mix(in oklch,var(--border) 55%,transparent);border-radius:var(--radius-lg);background:var(--card);">
  <ship-input placeholder="Filter…" style="flex:1;min-width:160px;"></ship-input>
  <ship-select size="sm">
    <option>All</option>
    <option>Active</option>
    <option>Archived</option>
  </ship-select>
  <ship-toggle-group>
    <button data-value="list" aria-pressed="true">List</button>
    <button data-value="grid">Grid</button>
  </ship-toggle-group>
</ship-toolbar>`,
  },
  {
    id: 'pipeline-status',
    title: 'Pipeline status',
    blurb: 'ship-pipeline-dag + ship-pipeline-step with live states.',
    html: `<ship-pipeline-dag>
  <ship-pipeline-step name="collect" step-type="run" state="completed" agent="git log"></ship-pipeline-step>
  <span class="arrow">&rarr;</span>
  <ship-pipeline-step name="review" step-type="agent" state="completed" agent="Claude"></ship-pipeline-step>
  <span class="arrow">&rarr;</span>
  <ship-pipeline-step name="gate" step-type="gate" state="running" agent="acceptance"></ship-pipeline-step>
  <span class="arrow">&rarr;</span>
  <ship-pipeline-step name="merge" step-type="merge" state="pending" agent="fast-forward"></ship-pipeline-step>
</ship-pipeline-dag>`,
  },
  {
    id: 'command-palette',
    title: 'Command palette',
    blurb: 'ship-dialog + ship-input + ship-list-item + ship-kbd. Exact pattern the site uses.',
    html: `<ship-card variant="outline" padding="none" style="max-width:420px;box-shadow:var(--shadow-md);">
  <div style="padding:10px 14px;border-bottom:1px solid var(--border);">
    <ship-input placeholder="Jump to…" style="width:100%;"></ship-input>
  </div>
  <div style="padding:6px 6px 10px;display:flex;flex-direction:column;gap:2px;">
    <ship-list-item selected>
      <span>Components</span>
      <ship-kbd slot="trailing" keys="G C"></ship-kbd>
    </ship-list-item>
    <ship-list-item>
      <span>Themes</span>
      <ship-kbd slot="trailing" keys="G T"></ship-kbd>
    </ship-list-item>
    <ship-list-item>
      <span>Tokens</span>
      <ship-kbd slot="trailing" keys="G D"></ship-kbd>
    </ship-list-item>
  </div>
</ship-card>`,
  },
  {
    id: 'chat-row',
    title: 'Chat row',
    blurb: 'ship-avatar + agent badge + body. Drop into any conversation view.',
    html: `<div style="display:grid;grid-template-columns:auto 1fr;gap:12px;max-width:560px;padding:10px 12px;border:1px solid color-mix(in oklch,var(--border) 45%,transparent);border-radius:var(--radius-lg);background:var(--card);">
  <ship-avatar name="Claude" tone="accent"></ship-avatar>
  <div>
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
      <strong style="font-size:13px;">Claude</strong>
      <ship-badge tone="accent" variant="soft" size="sm">agent</ship-badge>
      <span style="font-family:var(--font-mono);font-size:11px;color:var(--muted-foreground);">09:14</span>
    </div>
    <div style="font-size:14px;line-height:1.55;color:var(--foreground);">
      Merged your three drafts. Release notes ready for review &mdash; flagged two items as breaking.
    </div>
  </div>
</div>`,
  },
];
---

<BaseLayout title="Cookbook · SHIP SET" active="/cookbook">
  <section class="cb-head">
    <h1 class="cb-title">Cookbook</h1>
    <p class="cb-sub">
      Compositions, not docs. Paste the source, tweak the copy, ship
      the thing. Every recipe is live below.
    </p>
  </section>

  <div class="cb-list">
    {recipes.map((r) => (
      <article class="cb-recipe" id={r.id}>
        <header class="cb-recipe-head">
          <h2>{r.title}</h2>
          <p>{r.blurb}</p>
        </header>

        <div class="cb-preview-surface" set:html={r.html}></div>

        <details class="cb-code">
          <summary>
            <span>Source</span>
            <button type="button" class="cb-copy" data-copy={r.html}>Copy</button>
          </summary>
          <pre><code>{r.html}</code></pre>
        </details>
      </article>
    ))}
  </div>
</BaseLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    btn.addEventListener('click', async (ev) => {
      ev.preventDefault();
      try {
        await navigator.clipboard.writeText(btn.getAttribute('data-copy') ?? '');
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch {}
    });
  }
</script>

<style>
  .cb-head { padding: 24px 0 18px; display: flex; flex-direction: column; gap: 10px; }
  .cb-title { font-size: clamp(30px, 4vw, 44px); letter-spacing: -0.024em; }
  .cb-sub { color: var(--muted-foreground); max-width: 60ch; }

  .cb-list { display: flex; flex-direction: column; gap: 28px; padding-bottom: 48px; }
  .cb-recipe {
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    background: var(--card);
    overflow: hidden;
    scroll-margin-top: 80px;
  }
  .cb-recipe-head {
    padding: 14px 18px 10px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 35%, transparent);
  }
  .cb-recipe-head h2 { font-size: 18px; letter-spacing: -0.012em; }
  .cb-recipe-head p { color: var(--muted-foreground); font-size: 13px; margin-top: 4px; }

  .cb-preview-surface {
    padding: clamp(24px, 4vw, 48px);
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        45deg,
        color-mix(in oklch, var(--border) 18%, transparent) 0 1px,
        transparent 1px 10px
      );
    border-bottom: 1px solid color-mix(in oklch, var(--border) 35%, transparent);
  }
  .cb-preview-surface .arrow { color: var(--muted-foreground); padding: 0 4px; }

  .cb-code summary {
    list-style: none;
    cursor: pointer;
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted-foreground);
  }
  .cb-code summary::-webkit-details-marker { display: none; }
  .cb-code[open] summary { color: var(--foreground); }
  .cb-copy {
    padding: 4px 10px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
  }
  .cb-copy:hover { border-color: var(--primary); color: var(--primary); }
  .cb-code pre {
    margin: 0;
    padding: 14px 16px 18px;
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    overflow: auto;
    border-top: 1px solid color-mix(in oklch, var(--border) 35%, transparent);
  }
</style>
