---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  componentsByCategory,
  CATEGORY_LABELS,
  CATEGORY_ORDER,
  COMPONENTS,
} from '../../lib/components';
import { getShots } from '../../lib/samples';

const buckets = componentsByCategory();
const populated = CATEGORY_ORDER.filter((c) => buckets[c].length > 0);
---

<BaseLayout title="Components · SHIP SET" active="/components">
  <section class="idx-head">
    <h1 class="idx-title">Components</h1>
    <p class="idx-sub">
      {COMPONENTS.length} web components, grouped. Click any card for
      the full API, source, and variants.
    </p>
    <div class="idx-controls">
      <input
        type="search"
        class="idx-search"
        placeholder="Search components…"
        data-idx-search
        autocomplete="off"
      />
      <div class="idx-pills" role="tablist">
        <button type="button" class="idx-pill is-active" data-cat="all">All</button>
        {populated.map((cat) => (
          <button type="button" class="idx-pill" data-cat={cat}>{CATEGORY_LABELS[cat]}</button>
        ))}
      </div>
    </div>
  </section>

  {populated.map((cat) => (
    <section class="idx-group" id={cat} data-idx-group={cat}>
      <header class="idx-group-head">
        <h2>{CATEGORY_LABELS[cat]}</h2>
        <span class="idx-count">{buckets[cat].length}</span>
      </header>
      <div class="idx-grid">
        {buckets[cat].map((c) => {
          const firstShot = getShots(c.tag)[0];
          const attrs = firstShot.attrs
            ? Object.entries(firstShot.attrs)
                .map(([k, v]) => (v === '' ? ` ${k}` : ` ${k}="${v}"`))
                .join('')
            : '';
          const body = firstShot.innerHTML ?? '';
          return (
            <a
              class="idx-card"
              href={`/components/${c.tag}`}
              data-idx-card
              data-idx-tag={c.tag}
              data-idx-summary={c.summary.toLowerCase()}
            >
              <div class="idx-card-preview" set:html={`<${c.tag}${attrs}>${body}</${c.tag}>`}></div>
              <div class="idx-card-meta">
                <code class="idx-card-tag">{c.tag}</code>
              </div>
              {c.summary && <p class="idx-card-sum">{c.summary}</p>}
            </a>
          );
        })}
      </div>
    </section>
  ))}
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-idx-search]');
  const pills = document.querySelectorAll<HTMLButtonElement>('.idx-pill');
  const cards = document.querySelectorAll<HTMLElement>('[data-idx-card]');
  const groups = document.querySelectorAll<HTMLElement>('[data-idx-group]');

  let query = '';
  let cat = 'all';

  const apply = () => {
    const q = query.trim().toLowerCase();
    for (const card of cards) {
      const tag = card.dataset.idxTag ?? '';
      const sum = card.dataset.idxSummary ?? '';
      const group = card.closest<HTMLElement>('[data-idx-group]');
      const inCat = cat === 'all' || group?.dataset.idxGroup === cat;
      const inQ = !q || tag.includes(q) || sum.includes(q);
      card.style.display = inCat && inQ ? '' : 'none';
    }
    for (const g of groups) {
      const visible = Array.from(g.querySelectorAll<HTMLElement>('[data-idx-card]')).some((c) => c.style.display !== 'none');
      g.style.display = visible ? '' : 'none';
    }
  };

  input?.addEventListener('input', () => { query = input.value; apply(); });
  for (const pill of pills) {
    pill.addEventListener('click', () => {
      cat = pill.dataset.cat ?? 'all';
      for (const p of pills) p.classList.toggle('is-active', p === pill);
      apply();
    });
  }
</script>

<style>
  .idx-head {
    padding: 24px 0 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .idx-title {
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -0.024em;
  }
  .idx-sub { color: var(--muted-foreground); max-width: 56ch; }

  .idx-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 6px;
  }
  .idx-search {
    height: 38px;
    padding: 0 14px;
    border: 1px solid color-mix(in oklch, var(--border) 65%, transparent);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--foreground);
    font: inherit;
    font-size: 14px;
  }
  .idx-search:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 22%, transparent);
  }
  .idx-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .idx-pill {
    appearance: none;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    background: var(--card);
    color: var(--muted-foreground);
    padding: 5px 11px;
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    border-radius: 999px;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  .idx-pill:hover { color: var(--foreground); }
  .idx-pill.is-active {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }

  .idx-group {
    padding: 22px 0 8px;
    scroll-margin-top: 70px;
  }
  .idx-group-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
  }
  .idx-group-head h2 {
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .idx-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-foreground);
  }
  .idx-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .idx-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    background: var(--card);
    text-decoration: none;
    color: inherit;
    min-height: 140px;
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .idx-card:hover {
    border-color: color-mix(in oklch, var(--primary) 45%, transparent);
    transform: translateY(-1px);
  }
  .idx-card-preview {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 10px 4px;
    min-height: 56px;
  }
  .idx-card-meta { display: flex; align-items: center; gap: 8px; }
  .idx-card-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--foreground);
    font-weight: 600;
  }
  .idx-card-sum {
    font-size: 12px;
    color: var(--muted-foreground);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
