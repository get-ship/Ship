---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  COMPONENTS,
  COMPONENTS_BY_TAG,
  CATEGORY_LABELS,
} from '../../lib/components';
import { getShots, type ComponentShot } from '../../lib/samples';

export function getStaticPaths() {
  return COMPONENTS.map((c) => ({ params: { tag: c.tag } }));
}

const { tag } = Astro.params;
const doc = COMPONENTS_BY_TAG[tag!];
if (!doc) throw new Error(`Missing component doc for ${tag}`);

const shots = getShots(doc.tag);

// Render an attribute list as a string for the code sample.
function attrsToString(attrs?: Record<string, string>): string {
  if (!attrs) return '';
  return Object.entries(attrs)
    .map(([k, v]) => (v === '' ? ` ${k}` : ` ${k}="${v}"`))
    .join('');
}

function shotMarkup(tag: string, shot: ComponentShot): string {
  const open = `<${tag}${attrsToString(shot.attrs)}>`;
  const close = `</${tag}>`;
  const body = shot.innerHTML ?? '';
  return body.includes('\n')
    ? `${open}\n${body.trim()
        .split('\n')
        .map((l) => '  ' + l)
        .join('\n')}\n${close}`
    : `${open}${body}${close}`;
}

const allCode = shots.map((s) => shotMarkup(doc.tag, s)).join('\n\n');
---

<BaseLayout title={`${doc.tag} · SHIP SET`} active={`/components/${doc.tag}`}>
  <article class="cmp-page">
    <header class="cmp-head">
      <div class="cmp-breadcrumb">
        <a href="/components">Components</a>
        <span>/</span>
        <span>{CATEGORY_LABELS[doc.category]}</span>
      </div>
      <h1 class="cmp-title"><code>{doc.tag}</code></h1>
      {doc.summary && <p class="cmp-summary">{doc.summary}</p>}
      <div class="cmp-meta">
        <ship-badge tone="muted" variant="outline" size="sm">{doc.className}</ship-badge>
        <ship-badge tone="muted" variant="outline" size="sm">{CATEGORY_LABELS[doc.category]}</ship-badge>
        <code class="cmp-meta-path">{doc.path}</code>
      </div>
    </header>

    <!-- ===== Preview + code ===== -->

    <section class="cmp-section">
      <h2 class="cmp-h2">Preview</h2>
      <div class="cmp-preview">
        <div class="cmp-preview-surface">
          <div class="cmp-shots">
            {shots.map((s) => (
              <div class="cmp-shot">
                <div class="cmp-shot-body" set:html={shotMarkup(doc.tag, s)}></div>
                <div class="cmp-shot-label">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <details class="cmp-code">
          <summary>
            <span>View source</span>
            <button
              type="button"
              class="cmp-copy"
              data-copy={allCode}
              aria-label="Copy source"
            >Copy</button>
          </summary>
          <pre class="cmp-code-pre"><code>{allCode}</code></pre>
        </details>
      </div>
    </section>

    <!-- ===== API ===== -->

    {doc.attributes.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">Attributes</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.attributes.map((a) => (
                <tr>
                  <td><code>{a.name}</code></td>
                  <td><code class="cmp-muted">{a.type ?? '—'}</code></td>
                  <td><code class="cmp-muted">{a.default ?? '—'}</code></td>
                  <td>{a.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.slots.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">Slots</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.slots.map((s) => (
                <tr>
                  <td><code>{s.name || '(default)'}</code></td>
                  <td>{s.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.events.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">Events</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Detail</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.events.map((e) => (
                <tr>
                  <td><code>{e.name}</code></td>
                  <td><code class="cmp-muted">{e.type ?? 'CustomEvent'}</code></td>
                  <td>{e.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.parts.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">CSS parts</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.parts.map((p) => (
                <tr>
                  <td><code>::part({p.name})</code></td>
                  <td>{p.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.cssProperties.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">CSS custom properties</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Default</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.cssProperties.map((c) => (
                <tr>
                  <td><code>{c.name}</code></td>
                  <td><code class="cmp-muted">{c.default ?? '—'}</code></td>
                  <td>{c.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // Click-to-copy on the "Copy" button next to each "View source".
  for (const btn of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    btn.addEventListener('click', async (ev) => {
      ev.preventDefault();
      const text = btn.getAttribute('data-copy') ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch {}
    });
  }
</script>

<style>
  .cmp-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-bottom: 64px;
  }

  /* Header -------------------------------------------------------- */
  .cmp-head {
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cmp-breadcrumb {
    display: inline-flex;
    gap: 8px;
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .cmp-breadcrumb a { text-decoration: none; border-bottom: 1px dashed color-mix(in oklch, var(--border) 70%, transparent); padding-bottom: 1px; }
  .cmp-breadcrumb a:hover { color: var(--foreground); }

  .cmp-title {
    font-size: clamp(28px, 3.6vw, 40px);
    letter-spacing: -0.024em;
    line-height: 1.1;
    margin-top: 2px;
  }
  .cmp-title code {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--foreground);
  }
  .cmp-summary {
    color: var(--muted-foreground);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.55;
    max-width: 64ch;
  }
  .cmp-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }
  .cmp-meta-path {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-foreground);
  }

  /* Sections ------------------------------------------------------ */
  .cmp-section { display: flex; flex-direction: column; gap: 12px; }
  .cmp-h2 {
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  /* Preview surface ---------------------------------------------- */
  .cmp-preview {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--card);
  }
  .cmp-preview-surface {
    padding: clamp(24px, 4vw, 48px);
    min-height: 180px;
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        45deg,
        color-mix(in oklch, var(--border) 18%, transparent) 0 1px,
        transparent 1px 10px
      );
  }
  .cmp-shots {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 18px;
    align-items: flex-end;
    justify-content: center;
    max-width: 100%;
  }
  .cmp-shot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 80px;
  }
  .cmp-shot-body {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
  }
  .cmp-shot-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
  }

  /* Code block ---------------------------------------------------- */
  .cmp-code {
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
  }
  .cmp-code summary {
    cursor: pointer;
    list-style: none;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted-foreground);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .cmp-code summary::-webkit-details-marker { display: none; }
  .cmp-code[open] summary { color: var(--foreground); }
  .cmp-copy {
    appearance: none;
    padding: 4px 10px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .cmp-copy:hover { border-color: var(--primary); color: var(--primary); }
  .cmp-code-pre {
    margin: 0;
    padding: 14px 16px 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    overflow: auto;
    color: var(--foreground);
    background: transparent;
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    tab-size: 2;
  }

  /* API tables ---------------------------------------------------- */
  .cmp-table {
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cmp-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .cmp-table th,
  .cmp-table td {
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .cmp-table tr:last-child td { border-bottom: 0; }
  .cmp-table th {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--muted-foreground);
    background: color-mix(in oklch, var(--muted) 30%, transparent);
  }
  .cmp-table td code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--border) 22%, transparent);
  }
  .cmp-table td code.cmp-muted { color: var(--muted-foreground); }
</style>
