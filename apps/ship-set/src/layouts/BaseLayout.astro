---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { THEMES, DEFAULT_THEME, THEME_STORAGE_KEY } from '@ship/set/themes';

interface Props {
  title: string;
  description?: string;
  active?: string;
  noSidebar?: boolean;
}

const {
  title,
  description = 'SHIP SET — the component library for AI-native apps. Web components, themes, and tokens shared across the SHIP platform.',
  active,
  noSidebar = false,
} = Astro.props;

const themePreload = JSON.stringify({
  key: THEME_STORAGE_KEY,
  default: DEFAULT_THEME,
  ids: THEMES.map((t) => t.id),
  darks: THEMES.filter((t) => t.dark).map((t) => t.id),
});
---

<!doctype html>
<html lang="en" data-theme="ship-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/ship-logo.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ themes: themePreload }}>
      (() => {
        const cfg = JSON.parse(themes);
        const ok = new Set(cfg.ids);
        const darks = new Set(cfg.darks);
        let theme = cfg.default;
        try {
          const v = localStorage.getItem(cfg.key);
          if (ok.has(v)) theme = v;
        } catch (_) {}
        const r = document.documentElement;
        r.dataset.theme = theme;
        r.classList.toggle('dark', darks.has(theme));
        r.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <TopBar />
    <div class:list={['set-shell', noSidebar && 'set-shell-flat']}>
      {!noSidebar && <Sidebar active={active} />}
      <main class="set-main">
        <slot />
      </main>
    </div>

    <CommandPalette />

    <script>
      import '../scripts/register-elements';
    </script>
  </body>
</html>

<style is:global>
  .set-shell {
    display: grid;
    grid-template-columns: var(--set-sidebar-width) minmax(0, 1fr);
    align-items: start;
    min-height: calc(100vh - 60px);
  }
  .set-shell-flat { grid-template-columns: 1fr; }
  .set-main {
    padding: 28px var(--set-gutter) 72px;
    max-width: var(--set-content-max);
    margin-inline: auto;
    width: 100%;
  }
  @media (max-width: 900px) {
    .set-shell { grid-template-columns: 1fr; }
  }
</style>
