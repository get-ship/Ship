{
  "name": "ship-ui",
  "displayName": "SUI (.sui)",
  "description": "Syntax highlighting and language server support for SUI (.sui) template files.",
  "version": "0.1.0",
  "publisher": "ship",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sui"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sui",
        "aliases": [
          "SUI",
          "sui"
        ],
        "extensions": [
          ".sui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sui",
        "scopeName": "source.sui",
        "path": "./syntaxes/sui.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SUI",
      "properties": {
        "sui.serverPath": {
          "type": "string",
          "default": "",
          "description": "Optional override path to the sui-lsp executable (absolute path or PATH-resolved name). When empty, the extension launches the bundled `@ship/sui-lsp` server module directly."
        },
        "sui.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication between VS Code and sui-lsp."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "~5.4.5"
  }
}
