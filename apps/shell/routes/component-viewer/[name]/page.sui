<!--
  /component-viewer/[name] — the first launch-surface route under the
  unified file-based routing. Mounts <sui-component-viewer> for the
  component named in the [name] segment. The viewer takes a single
  `component-name` prop and renders the live, reactive preview.

  URL: /component-viewer/sui-button
       /component-viewer/sui-card
       /component-viewer/ship-artifact-list
       ...

  This is the workbench the user wanted for "return to the mechanical
  work and get the components stable first." It's the entry point for
  stabilizing components without leaving the routing session.

  The route IS the viewer URL. The path is the component name. Single
  segment, no nested params. To preview a variant, change the prop
  knobs in the viewer.
-->

<sui-component-viewer prop:component-name={name()}>
  <sui-empty-state
    slot="fallback"
    title="No component"
    description="No component named {name()}."
  ></sui-empty-state>
</sui-component-viewer>

<style>
  :host {
    display: block;
    width: 100%;
    min-height: 100vh;
    background: var(--surface-0);
    color: var(--foreground);
    font-family: var(--font-body);
  }
</style>
