{
  "name": "shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "cargo run -q -p deck-cli -- build --shell-root . --out ../../.deck/hub-scaffold --bundle-framework",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 3200",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ship/sui-charts": "workspace:*",
    "@ship/code": "workspace:*",
    "@ship/deck-host": "workspace:*",
    "@ship/markdown": "workspace:*",
    "@ship/pipelines": "workspace:*",
    "@ship/sui-primitives": "workspace:*",
    "@ship/sdk": "workspace:*",
    "@ship/sdk-client": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/ui-components": "workspace:*",
    "@ship/sui-lsp-browser": "workspace:*",
    "@ship/sui-runtime": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "@tauri-apps/cli": "^2",
    "playwright": "^1.59.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
