{
  "name": "shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "sui-build && bun ../../packages/deck/bundler/shell-app.ts --shell-root . --out dist",
    "pretest": "sui-build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 3200",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@ship/charts": "workspace:*",
    "@ship/deck-host": "workspace:*",
    "@ship/pipelines": "workspace:*",
    "@ship/primitives": "workspace:*",
    "@ship/sdk": "workspace:*",
    "@ship/sdk-client": "workspace:*",
    "@ship/sui-build": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/ui-components": "workspace:*",
    "@ship/sui-lsp-browser": "workspace:*",
    "@ship/sui-runtime": "workspace:*",
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-code-block-lowlight": "^3.21.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/extension-table": "^3.21.0",
    "@tiptap/extension-task-item": "^3.21.0",
    "@tiptap/extension-task-list": "^3.21.0",
    "@tiptap/extension-typography": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lowlight": "^3.3.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
