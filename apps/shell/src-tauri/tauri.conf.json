{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ship",
  "version": "0.1.0",
  "identifier": "com.micahcotton.ship",
  "build": {
    "beforeDevCommand": "VITE_PORT=3200 bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3200"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ship",
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Ship native shell",
    "longDescription": "Ship — agent orchestration platform, native desktop shell."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/madvib/Shipwright/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
