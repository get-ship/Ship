<!--
  <sui-devtools-source> — view source explorer + single editor.

  Two-column layout: file explorer (200px) on the left, one
  ship-code-editor on the right. Explorer lists every textual file
  under the active view's directory plus any `[id]/`-shaped subroute,
  fetched from /api/v1/views/{name}/files. Selecting a file loads its
  contents into the editor.

  Replaces the prior stacked page.sui + manifest.jsonc layout which
  cramped each editor to ~3-4 lines of source.

  Save: Cmd/Ctrl+S writes the currently-selected file via the
  /api/v1/views/{name}/template endpoint (which accepts any of the
  ALLOWED_EXT extensions post j2 → SUI cutover).
-->

<style>
  :host {
    /* The dock's slotted-active rule forces flex-direction: column on
     * every body element so the standard header + body + footer chain
     * works. We're a two-COLUMN layout (file explorer + editor) so
     * wrap our actual content in an inner row container below. */
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-size: var(--text-sm);
  }
  :host([hidden]) { display: none; }

  .row {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
  }

  .explorer {
    flex: 0 0 220px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    background: var(--sidebar, var(--card));
  }
  .explorer-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
  .explorer-head .name {
    color: var(--foreground);
    font-weight: var(--font-weight-medium, 500);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .file-list {
    list-style: none;
    margin: 0;
    padding: var(--space-1) 0;
    overflow: auto;
    flex: 1;
    min-height: 0;
  }
  .file-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px var(--space-3, 12px);
    cursor: pointer;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    color: var(--foreground);
    border-left: 2px solid transparent;
  }
  .file-row:hover { background: color-mix(in oklch, var(--foreground) 6%, transparent); }
  .file-row[aria-current="true"] {
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    border-left-color: var(--primary);
    color: var(--primary);
  }
  .file-row .kind {
    font-size: 9px;
    padding: 1px var(--space-1);
    border-radius: var(--radius-sm, 3px);
    background: color-mix(in oklch, var(--foreground) 10%, transparent);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .file-row .subroute {
    font-size: 9.5px;
    color: var(--muted-foreground);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
    padding: 1px var(--space-1);
    border-radius: var(--radius-sm, 3px);
  }
  .file-row .name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .editor-col {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .editor-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
  .editor-head .path {
    font-family: var(--font-mono);
    color: var(--foreground);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .editor-head .dirty-dot {
    width: 6px; height: 6px; border-radius: 999px;
    background: var(--primary); flex-shrink: 0;
  }
  .editor-head .state {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--muted);
    color: var(--muted-foreground);
  }
  .editor-head .state[data-saved="true"] {
    background: color-mix(in oklab, var(--success) 22%, var(--muted));
    color: var(--foreground);
  }
  /* Compile chip — appears next to .state when the bundler is busy
     or has reported a result for this view via the SSE bridge. */
  .editor-head .compile-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
  }
  .editor-head .compile-chip sui-icon { width: 11px; height: 11px; }
  .editor-head .compile-chip[data-status="compiling"] {
    background: color-mix(in oklab, var(--warning) 18%, var(--muted));
    color: var(--warning);
  }
  .editor-head .compile-chip[data-status="compiled"] {
    background: color-mix(in oklab, var(--success) 22%, var(--muted));
    color: var(--success);
  }
  .editor-head .compile-chip[data-status="errored"] {
    background: color-mix(in oklab, var(--destructive) 22%, var(--muted));
    color: var(--destructive);
  }
  .save-btn {
    appearance: none;
    font: inherit;
    font-size: var(--text-xs);
    padding: 2px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
    cursor: pointer;
  }
  .hist-btn {
    appearance: none;
    font: inherit;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    height: 22px;
    display: inline-flex;
    align-items: center;
  }
  .hist-btn:hover { color: var(--foreground); background: color-mix(in oklch, var(--foreground) 8%, transparent); }
  .hist-btn[aria-expanded="true"] { color: var(--primary); border-color: var(--primary); }

  .snap-panel {
    border-top: 1px solid var(--border);
    background: var(--sidebar, var(--card));
    max-height: 220px;
    overflow: auto;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }
  .snap-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--border);
  }
  .snap-head .snap-count {
    margin-left: auto;
    font-family: var(--font-mono);
    text-transform: none;
    letter-spacing: 0;
  }
  .snap-empty { padding: var(--space-3); text-align: center; color: var(--muted-foreground); font-size: 11px; }
  .snap-empty.snap-error { color: var(--destructive); }
  .snap-list { list-style: none; margin: 0; padding: var(--space-1) 0; }
  .snap-row {
    display: grid;
    grid-template-columns: 160px 1fr auto auto;
    gap: var(--space-2);
    align-items: center;
    padding: 3px var(--space-3);
    font-size: 11px;
    color: var(--foreground);
  }
  .snap-row:hover { background: color-mix(in oklch, var(--foreground) 6%, transparent); }
  .snap-row .snap-ts { font-family: var(--font-mono); color: var(--muted-foreground); }
  .snap-row .snap-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .snap-row .snap-agent {
    font-size: 10px;
    color: var(--muted-foreground);
    background: var(--muted);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
  }
  .snap-restore {
    appearance: none;
    font: inherit;
    font-size: var(--text-xs);
    padding: 1px var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--primary);
    cursor: pointer;
  }
  .snap-restore:hover { background: color-mix(in oklch, var(--primary) 12%, transparent); }
  .save-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .editor-pane {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .editor-pane ship-code-editor { flex: 1; min-height: 0; }

  .empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    padding: var(--space-3);
    text-align: center;
  }

  .diagnostics {
    padding: var(--space-1) var(--space-3, 12px);
    background: color-mix(in oklch, var(--destructive) 10%, transparent);
    color: var(--destructive);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    border-top: 1px solid var(--destructive);
    max-height: 120px;
    overflow: auto;
    flex-shrink: 0;
  }
</style>

<div class="row">
<aside class="explorer" part="explorer">
  <div class="explorer-head">
    <sui-icon name="folder" size="sm"></sui-icon>
    {#if viewName()}
      <span class="name">{viewName()}</span>
    {:else}
      <span>no view</span>
    {/if}
  </div>
  {#if files().length === 0}
    <div class="empty">
      {#if loading()}Loading…{:else}{loadError() ?? 'No files.'}{/if}
    </div>
  {:else}
    <ul class="file-list" role="listbox" aria-label="View files">
      {#for f of files() key={f.path}}
        <li
          class="file-row"
          role="option"
          aria-current={f.path === selectedPath() ? 'true' : 'false'}
          data-path={f.path}
          on:click={(e) => onPickFile(e)}>
          {#if f.subroute}<span class="subroute">{f.subroute}</span>{/if}
          <span class="name">{f.name}</span>
          <span class="kind">{f.kind}</span>
        </li>
      {/for}
    </ul>
  {/if}
</aside>

<div class="editor-col" part="editor-col">
  {#if selectedPath()}
    <div class="editor-head">
      <span class="path">{selectedPath()}</span>
      {#if isDirty()}<span class="dirty-dot" title="Unsaved changes"></span>{/if}
      <span class="state" data-saved={saved() ? 'true' : 'false'}>
        {isDirty() ? 'unsaved' : (saved() ? 'saved' : 'clean')}
      </span>
      {#if compileStatus() !== 'idle'}
        <span class="compile-chip" data-status={compileStatus()} title={compileError() ?? ''}>
          {#if compileStatus() === 'compiling'}<sui-icon name="loader" size="sm"></sui-icon> Compiling…{/if}
          {#if compileStatus() === 'compiled'}<sui-icon name="check" size="sm"></sui-icon> Compiled{/if}
          {#if compileStatus() === 'errored'}<sui-icon name="alert-triangle" size="sm"></sui-icon> Compile error{/if}
        </span>
      {/if}
      <button class="hist-btn" type="button"
        on:click={onOpenSnapshots}
        title="Snapshot history"
        aria-label="Snapshot history"
        aria-expanded={snapshotsOpen() ? 'true' : 'false'}>
        <sui-icon name="history" size="sm"></sui-icon>
      </button>
      <button class="save-btn" type="button"
        on:click={onSave}
        disabled={saving() || !isDirty()}
        title="Save (⌘/Ctrl+S)">{saving() ? 'Saving…' : 'Save'}</button>
    </div>
    {#if snapshotsOpen()}
      <div class="snap-panel" transition:slide={{ duration: 160 }} part="snapshots">
        <div class="snap-head">
          <sui-icon name="history" size="sm"></sui-icon>
          <span>Snapshot history</span>
          <span class="snap-count">{snapshots().length}</span>
        </div>
        {#if snapshotsLoading()}
          <div class="snap-empty">Loading…</div>
        {:else if snapshotsError()}
          <div class="snap-empty snap-error">{snapshotsError()}</div>
        {:else if snapshots().length === 0}
          <div class="snap-empty">No snapshots yet. Every save creates one.</div>
        {:else}
          <ul class="snap-list" role="listbox" aria-label="Snapshots">
            {#for s of snapshots() key={s.snapshot_id}}
              <li class="snap-row" role="option" data-snap-id={s.snapshot_id}>
                <span class="snap-ts">{s.timestamp}</span>
                <span class="snap-label">{s.label || '(unlabeled)'}</span>
                <span class="snap-agent">{s.agent_id}</span>
                <button class="snap-restore" type="button" on:click={() => onRestoreSnapshot(s.snapshot_id)} title="Restore this snapshot">Restore</button>
              </li>
            {/for}
          </ul>
        {/if}
      </div>
    {/if}
    <div class="editor-pane">
      <ship-code-editor
        bind:this={editorEl}
        language={editorLang()}
        on:sui-change={onChange}
        on:sui-save={onSave}>
      </ship-code-editor>
    </div>
    {#if errorMsg() || compileError()}
      <div class="diagnostics" transition:slide={{ duration: 180 }}>{errorMsg() ?? compileError()}</div>
    {/if}
  {:else}
    <div class="empty">
      {#if loading()}Loading view files…{:else if files().length > 0}Select a file to edit.{:else}No view active.{/if}
    </div>
  {/if}
</div>
</div>
