<bundle separate />
<!--
  <sui-va-compile> — Compile tab in the view-authoring dev panel.
  Lists current compile errors for the current view (subscribes to
  `sui:view:errored` and `sui:view:compiled`). Clicking an error jumps
  to the Source tab (fires `sui:dock:activate` + `sui:va:goto-line`).
-->

<prop name="view" type="string" default="" reflect />

<style>
  :host { display: block; height: 100%; overflow: auto; }
  :host([hidden]) { display: none; }
  .empty {
    padding: 24px;
    text-align: center;
    color: var(--muted-foreground);
    font-size: 12px;
  }
  .empty .ok {
    color: var(--success, #16a34a);
    font-weight: var(--font-weight-medium, 500);
    display: block;
    margin-bottom: 4px;
  }
  .list { display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 8px;
    align-items: baseline;
    padding: 8px 12px;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
    cursor: pointer;
    font-size: 12px;
  }
  .row:hover { background: var(--hover-bg, var(--sidebar-accent)); }
  .row .loc {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
  .row .msg {
    color: var(--foreground);
    font-family: var(--font-mono);
    white-space: pre-wrap;
  }
  .row[data-severity="warning"] .loc { color: var(--warning, #ca8a04); }
  .row[data-severity="error"]   .loc { color: var(--destructive, #ef4444); }
</style>

{#if errors().length === 0}
  <div class="empty">
    <span class="ok">All clear</span>
    No compile errors for this view. Save a file in the Source tab
    (⌘/Ctrl+S) to trigger a recompile; results land here.
  </div>
{:else}
  <div class="list">
    {#for err of errors() key={err.id}}
      <div class="row"
           data-severity={err.severity}
           data-line={err.line}
           on:click={() => onClickRow(err)}>
        <span class="loc">{err.line}:{err.col}</span>
        <span class="msg">{err.message}</span>
      </div>
    {/for}
  </div>
{/if}
