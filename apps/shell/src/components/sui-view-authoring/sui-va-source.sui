<!--
  <sui-va-source> — Source tab content for the view-authoring dev panel.
  Wraps <ship-code-editor>, loads source for the current view via the
  MCP shim `window.__viewMcp.readSource()`, and saves on Cmd+S via
  `writeSource()`. Compile errors arrive on `sui:view:errored` events
  and surface as gutter diagnostics.
-->

<prop name="view" type="string" default="" reflect />

<style>
  :host { display: flex; flex-direction: column; height: 100%; min-height: 0; }
  :host([hidden]) { display: none; }
  .header {
    display: flex; align-items: center; gap: var(--space-2);
    padding: 6px var(--space-3);
    border-bottom: 1px solid var(--border-subtle, var(--border));
    background: var(--sidebar, var(--card));
    font-size: 11px;
    color: var(--muted-foreground);
  }
  .header .path { font-family: var(--font-mono); color: var(--foreground); }
  .header .state {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--muted);
    color: var(--muted-foreground);
  }
  .header .state[data-dirty="true"] {
    background: color-mix(in oklab, var(--warning) 24%, var(--muted));
    color: var(--foreground);
  }
  .header .state[data-saved="true"] {
    background: color-mix(in oklab, var(--success) 22%, var(--muted));
    color: var(--foreground);
  }
  .editor-host { flex: 1; min-height: 0; display: flex; }
  ship-code-editor { flex: 1; min-height: 0; }
</style>

<div class="header">
  <span>view:</span>
  <span class="path">{view() || '(no view active)'}</span>
  <span class="state" data-dirty={dirty() ? 'true' : 'false'} data-saved={saved() ? 'true' : 'false'}>
    {dirty() ? 'unsaved' : (saved() ? 'saved' : 'clean')}
  </span>
</div>
<div class="editor-host">
  <ship-code-editor
    bind:this={editorEl}
    language="html"
    prop:value={source()}
    on:sui-change={onChange}
    on:sui-save={onSave}>
  </ship-code-editor>
</div>
