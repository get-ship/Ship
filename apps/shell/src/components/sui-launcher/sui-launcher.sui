<!--
  <sui-launcher> — SUI port of <ship-launcher>.
  Floating panel showing all registered views with pin/unpin, fuzzy filter,
  keyboard navigation, and drag-reorder of pinned rows.

  Prop / event surface
  ─────────────────────────────────────────────────────────────────────────────
  Props:
    open (bool, false, reflect)  panel visible state
  ─────────────────────────────────────────────────────────────────────────────
  Methods (callable on the element):
    open()   — show the launcher and load data
    close()  — hide the launcher and clear filter
  ─────────────────────────────────────────────────────────────────────────────
  Events dispatched (bubbling, composed):
    sui:launcher:open-pane  { detail: { name } }  — ⌘+Enter on a row
  ─────────────────────────────────────────────────────────────────────────────
  Listens on document:
    sui:launcher:open   — calls open()
    sui:launcher:close  — calls close()
    keydown             — keyboard nav + Escape when open
  ─────────────────────────────────────────────────────────────────────────────
  Parts: mask, panel, head, filter, body, foot
  ─────────────────────────────────────────────────────────────────────────────
  Parity vs Lit ship-launcher:
    isOpen                → [open] attribute (reflected)           ✓
    views (ApiView[])     → fetched on open                        ✓
    pins (string[])       → fetched + saved via /api/v1/settings   ✓
    filter                → filter input                           ✓
    cursor                → keyboard cursor on rows                ✓
    project               → fetched from /api/v1/projects          ✓
    drag-reorder          → pinned rows draggable                  ✓
    ship:launcher:open-pane → sui:launcher:open-pane               ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />

<style>
  :host { display: contents; }
  :host([hidden]) { display: none; }

  :host(:not([open])) .launcher-mask,
  :host(:not([open])) .launcher-panel { display: none; }

  .launcher-mask {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay, 900);
    background: color-mix(in oklch, var(--foreground) 35%, transparent);
    animation: launcher-fade-in var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }

  .launcher-panel {
    position: fixed;
    top: 64px;
    left: 50%;
    transform: translateX(-50%);
    z-index: calc(var(--z-overlay, 900) + 1);
    width: min(560px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 96px));
    background: var(--card);
    color: var(--card-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 8px);
    box-shadow: var(--shadow-xl);
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: var(--text-sm, 13px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: launcher-slide-in var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }

  @keyframes launcher-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes launcher-slide-in {
    from { opacity: 0; transform: translateX(-50%) translateY(-8px) scale(0.97); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
  }

  /* head */
  .launcher-head {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: var(--space-3, 12px) var(--space-4, 16px);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  /* filter row */
  .launcher-filter {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: var(--space-2, 8px) var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .launcher-filter-input {
    flex: 1;
    border: none;
    background: transparent;
    font: inherit;
    font-size: var(--text-sm, 13px);
    color: var(--foreground);
    outline: none;
    min-width: 0;
  }
  .launcher-filter-input::placeholder { color: var(--muted-foreground); }
  .launcher-count {
    font-size: 11px;
    color: var(--muted-foreground);
    flex-shrink: 0;
  }

  /* body */
  .launcher-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 0;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--foreground) 15%, transparent) transparent;
  }

  /* foot */
  .launcher-foot {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: var(--space-2, 8px) var(--space-3, 12px);
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .launcher-mask, .launcher-panel { animation: none; }
  }
</style>

<div class="launcher-mask" part="mask" bind:this={maskEl}></div>
<div class="launcher-panel" role="dialog" aria-label="App launcher" aria-modal="true" part="panel" bind:this={panelEl}>
  <div class="launcher-head" part="head" bind:this={headEl}></div>
  <div class="launcher-filter" part="filter">
    <sui-icon name="search" size="sm" aria-hidden="true"></sui-icon>
    <input
      type="text"
      class="launcher-filter-input"
      placeholder="Filter views…"
      aria-label="Filter views"
      bind:this={filterInput}
    />
    <span class="launcher-count" bind:this={countEl}>0</span>
  </div>
  <div class="launcher-body" part="body" bind:this={bodyEl}></div>
  <div class="launcher-foot" part="foot" bind:this={footEl}></div>
</div>
