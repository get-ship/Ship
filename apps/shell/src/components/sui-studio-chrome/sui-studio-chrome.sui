<!--
  <sui-studio-chrome> — chrome wrapper for the /studio/* subtree.

  Registered as a custom element (see sui-studio-chrome.controller.ts) and
  used as the LAYOUTS chrome for /studio/*. The route's mount() target
  (a <div slot="route">) fills the inner <slot name="route"> via the
  SUI runtime's resolveSlots() at mount time.

  Slots:
    rail-top    optional left rail (sui-launcher)
    route       the route content (filled by the host)
    bottom      status bar / footer (sui-status-bar)
-->

<style>
  :host {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr auto;
    min-height: 100vh;
    background: var(--surface-0);
    color: var(--foreground);
    font-family: var(--font-body);
  }
  :host([hidden]) { display: none; }

  .main {
    grid-row: 1;
    grid-column: 1;
    overflow: auto;
    min-height: 0;
  }
  .bottom {
    grid-row: 2;
    grid-column: 1;
    flex-shrink: 0;
  }
</style>

<main class="main" part="main">
  <slot name="route"></slot>
</main>
<footer class="bottom" part="bottom">
  <slot name="bottom"></slot>
</footer>
