<!--
  <sui-edit-mode-pill> — corner indicator + control for edit mode +
  annotation sub-mode. Expandable queue review panel beneath.

  Closed (no queue):
    [● Editing home | ⌖ | ×]
  With queue:
    [● Editing home | ⌖ | N ▾ | Send | ×]
    when N is clicked, the panel below expands and shows each
    annotation with a comment input and a remove button.

  Prop surface
  ─────────────────────────────────────────────────────────────────────
  on          (bool, false, reflect)
  annotating  (bool, false, reflect)
  view        (string, '')
  count       (number, 0, reflect)
  queue-json  (string, '[]') — JSON-serialized [{id,tag,selector,preview,comment}]
  expanded    (bool, false, reflect)
  ─────────────────────────────────────────────────────────────────────
  Events:
    sui:edit-mode:exit             {}
    sui:annotation-mode:toggle     {}
    sui:annotations:send           {}  (chrome reads its in-memory queue)
    sui:annotations:remove         { id }
    sui:annotations:comment-update { id, comment }
-->

<prop name="on" type="bool" default="false" reflect />
<prop name="annotating" type="bool" default="false" reflect />
<prop name="view" type="string" default="" />
<prop name="count" type="number" default="0" reflect />
<prop name="queue-json" type="string" default="[]" />
<prop name="expanded" type="bool" default="false" reflect />

<style>
  :host {
    display: none;
    position: fixed;
    top: calc(var(--ship-top-bar-h, 40px) + 8px);
    right: 8px;
    z-index: var(--z-toast, 1100);
    pointer-events: none;
  }
  :host([on]) { display: block; }

  .pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 var(--space-1) 0 10px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--warning) 14%, var(--card));
    color: var(--warning);
    border: 1px solid color-mix(in oklch, var(--warning) 36%, transparent);
    font-family: var(--font-body, system-ui);
    font-size: 11px;
    line-height: 1;
    box-shadow: var(--shadow-md);
  }

  .dot {
    width: 7px; height: 7px;
    border-radius: 999px;
    background: var(--warning);
    flex-shrink: 0;
    animation: edit-pulse 1.6s var(--ease-in-out, ease-in-out) infinite;
  }
  @keyframes edit-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(0.78); }
  }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }

  .label { font-weight: 500; letter-spacing: 0.01em; }
  .label .view {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    padding: 1px 5px;
    margin-left: var(--space-1);
    background: color-mix(in oklch, var(--warning) 22%, transparent);
    border-radius: var(--radius-sm, 4px);
  }

  .sep {
    width: 1px;
    align-self: stretch;
    background: color-mix(in oklch, var(--warning) 28%, transparent);
    margin: var(--space-1) 2px;
  }

  .btn {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    line-height: 1;
    padding: 0 6px;
    height: 22px;
    border-radius: 999px;
    opacity: 0.85;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .btn:hover { opacity: 1; background: color-mix(in oklch, var(--foreground) 10%, transparent); }
  .btn:focus-visible { outline: none; box-shadow: 0 0 0 2px color-mix(in oklch, var(--warning) 50%, transparent); }
  .btn[aria-pressed="true"] {
    background: var(--warning);
    color: var(--warning-foreground, var(--card));
    opacity: 1;
  }

  .send {
    background: var(--primary);
    color: var(--primary-foreground);
    opacity: 1;
    padding: 0 10px;
    height: 22px;
    font-weight: 500;
  }
  .send:hover { background: color-mix(in oklch, var(--primary) 80%, white); }

  .qcount-btn {
    background: color-mix(in oklch, var(--primary) 22%, transparent);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 1px var(--space-2);
    font-weight: 500;
  }
  .qcount-btn:hover { background: color-mix(in oklch, var(--primary) 32%, transparent); }
  .qcount-btn[aria-expanded="true"] { background: var(--primary); color: var(--primary-foreground); }

  .close-btn { padding: 0 var(--space-2); font-size: 14px; line-height: 1; }

  /* ── Expanded queue panel ───────────────────────────────────────── */
  .queue {
    pointer-events: auto;
    margin-top: 6px;
    width: 380px;
    max-height: min(440px, calc(100vh - 100px));
    overflow: auto;
    background: var(--card);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 8px);
    box-shadow: var(--shadow-lg);
  }
  .q-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .q-head .clear-all {
    margin-left: auto;
    background: transparent; border: 0; color: var(--muted-foreground);
    font: inherit; font-size: 10.5px; cursor: pointer;
    text-transform: none; letter-spacing: 0;
  }
  .q-head .clear-all:hover { color: var(--destructive); }
  .q-empty { padding: var(--space-3); text-align: center; color: var(--muted-foreground); font-size: 11px; }
  .q-list { list-style: none; margin: 0; padding: 0; }
  .q-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) 6px;
    padding: var(--space-2) 10px 10px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
  }
  .q-row .selector {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--primary);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .q-row .remove {
    background: transparent; border: 0; color: var(--muted-foreground);
    cursor: pointer; font-size: 14px; line-height: 1; padding: 0 6px;
    border-radius: var(--radius-sm); align-self: start;
  }
  .q-row .remove:hover { color: var(--destructive); background: color-mix(in oklch, var(--destructive) 12%, transparent); }
  .q-row .preview {
    grid-column: 1 / -1;
    font-size: 10.5px;
    color: var(--muted-foreground);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .q-row .comment {
    grid-column: 1 / -1;
    font: inherit;
    font-size: 11px;
    padding: var(--space-1) 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--background);
    color: var(--foreground);
    resize: vertical;
    min-height: 28px;
    margin-top: var(--space-1);
  }
  .q-row .comment:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 22%, transparent); }
  .q-foot {
    display: flex; justify-content: flex-end; gap: 6px;
    padding: var(--space-2) 10px;
    border-top: 1px solid var(--border);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
  }
  .q-foot .send {
    appearance: none;
    border: 1px solid var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
</style>

<div class="pill" part="pill" role="status" aria-live="polite">
  <span class="dot" part="dot" aria-hidden="true"></span>
  <span class="label" part="label">
    Editing<span class="view" part="view">{view() || 'view'}</span>
  </span>
  <span class="sep" aria-hidden="true"></span>
  <button class="btn" part="annotate" type="button"
    aria-pressed={annotating() ? 'true' : 'false'}
    title={annotating() ? 'Stop annotating (Shift+Alt+E)' : 'Start annotating (Shift+Alt+E)'}
    aria-label={annotating() ? 'Stop annotating' : 'Start annotating'}
    on:click={onAnnotateToggle}>
    <sui-icon name="crosshair" size="sm"></sui-icon>
  </button>
  {#if count() > 0}
    <button class="btn qcount-btn" part="queue-toggle" type="button"
      aria-expanded={expanded() ? 'true' : 'false'}
      title="Review {count()} annotation{count() === 1 ? '' : 's'}"
      on:click={onToggleExpand}>
      {count()}
      <sui-icon name={expanded() ? 'chevron-up' : 'chevron-down'} size="sm"></sui-icon>
    </button>
  {/if}
  <button class="btn close-btn" part="close" type="button"
    title="Exit edit mode (Alt+E)"
    aria-label="Exit edit mode"
    on:click={onExit}>×</button>
</div>

{#if expanded() && count() > 0}
  <div class="queue" part="queue" role="region" aria-label="Captured annotations">
    <div class="q-head">
      <sui-icon name="message-square" size="sm"></sui-icon>
      <span>{count()} annotation{count() === 1 ? '' : 's'} queued</span>
      <button class="clear-all" type="button" on:click={onClearAll}>Clear all</button>
    </div>
    <ul class="q-list">
      {#for q of queue() key={q.id}}
        <li class="q-row">
          <code class="selector">{q.selector}</code>
          <button class="remove" type="button" title="Remove" aria-label="Remove annotation" on:click={() => onRemove(q.id)}>×</button>
          {#if q.preview}<span class="preview">"{q.preview}"</span>{/if}
          <textarea class="comment" placeholder="Add a comment for the agent…"
            data-anno-id={q.id}
            on:input={(e) => onCommentInput(e, q.id)}>{q.comment || ''}</textarea>
        </li>
      {/for}
    </ul>
    <div class="q-foot">
      <button class="send" type="button" on:click={onSend}>Send to agent</button>
    </div>
  </div>
{/if}
