<!--
  <sui-blank-canvas> — Ship's empty-state surface.

  Rendered when no view is mounted. Centered column with the brand mark,
  the wordmark "Blank canvas", a sub-copy hinting at ⌘K, and four hint
  pills for the primary hotkeys. The host paints the dotted-grid
  background that fills the canvas region.

  Each hint pill dispatches the same event the global hotkey would so
  click + key produce identical effects.
-->

<style>
  :host {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    width: 100%;
    height: 100%;
    padding: 0 var(--space-6, 24px);
    box-sizing: border-box;
    background:
      radial-gradient(circle at 1px 1px, var(--border-subtle) 1px, transparent 0)
      0 0 / 32px 32px,
      var(--background);
    color: var(--foreground);
    font-family: var(--font-body, system-ui, sans-serif);
  }
  :host([hidden]) { display: none; }

  .mark {
    width: 64px; height: 64px;
    border-radius: var(--radius-lg, 12px);
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--primary);
    color: var(--primary-foreground);
    font-family: var(--heading-font, var(--font-body));
    font-size: 30px;
    font-weight: var(--heading-weight, 600);
    line-height: 1;
    margin-bottom: var(--space-4, 16px);
    position: relative;
    isolation: isolate;
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, var(--primary-foreground) 22%, transparent),
      0 6px 20px color-mix(in oklch, var(--primary) 24%, transparent);
  }
  .mark::before {
    content: '';
    position: absolute; inset: 0;
    border-radius: inherit;
    background: linear-gradient(160deg, color-mix(in oklch, var(--primary-foreground) 16%, transparent) 0%, transparent 55%);
  }

  .title {
    font-family: var(--heading-font, var(--font-body));
    font-size: 32px;
    font-weight: var(--heading-weight, 600);
    letter-spacing: var(--heading-tracking, -0.02em);
    line-height: 1.05;
    margin: 0 0 var(--space-2);
    color: var(--foreground);
  }

  .rule {
    width: 96px;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--primary), transparent);
    margin: 0 auto var(--space-6, 24px);
  }

  .sub {
    font-size: 15px;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-6, 24px);
    max-width: 56ch;
    line-height: 1.5;
  }
  .sub code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    padding: 1px 6px;
    background: var(--muted);
    border-radius: var(--radius-sm, 4px);
    color: var(--foreground);
  }

  .hints {
    display: flex;
    gap: var(--space-3, 12px);
    flex-wrap: wrap;
    justify-content: center;
  }

  .hint {
    appearance: none;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full, 9999px);
    background: var(--surface-1);
    font: inherit;
    font-size: 12.5px;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: border-color var(--duration-fast, 120ms),
                color var(--duration-fast, 120ms),
                background-color var(--duration-fast, 120ms);
  }
  .hint:hover { color: var(--foreground); border-color: var(--border); }
  .hint:focus-visible {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 22%, transparent);
  }
  .hint kbd {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    padding: 1px 5px;
    border-radius: var(--radius-sm, 4px);
    background: var(--background);
    border: 1px solid var(--border-subtle);
    color: var(--muted-foreground);
  }

  @media (forced-colors: active) {
    :host {
      background: Canvas;
      color: CanvasText;
    }
    .mark { background: Highlight; color: HighlightText; forced-color-adjust: none; }
    .rule { background: CanvasText; }
    .hint { background: Canvas; border-color: CanvasText; color: CanvasText; }
    .hint kbd { background: Canvas; border-color: CanvasText; color: CanvasText; }
    .sub code { background: Canvas; color: CanvasText; border: 1px solid CanvasText; }
  }
</style>

<span class="mark" part="mark" aria-hidden="true">S</span>
<h1 class="title" part="title">Blank canvas</h1>
<div class="rule" part="rule" aria-hidden="true"></div>
<p class="sub" part="sub">
  Open <code>⌘K</code> to begin, or press <code>⌘.</code> to configure Ship.
</p>
<div class="hints" part="hints" role="group" aria-label="Hotkey hints">
  <button class="hint" type="button" data-hint="palette"
    on:click={onPaletteHint}
    title="Open command palette (⌘K)">
    <kbd>⌘K</kbd>
    <span>palette</span>
  </button>
  <button class="hint" type="button" data-hint="studio"
    on:click={onStudioHint}
    title="Open Studio (⌘.)">
    <kbd>⌘.</kbd>
    <span>Studio</span>
  </button>
  <button class="hint" type="button" data-hint="terminal"
    on:click={onTerminalHint}
    title="Toggle terminal (⌃`)">
    <kbd>⌃`</kbd>
    <span>terminal</span>
  </button>
  <button class="hint" type="button" data-hint="help"
    on:click={onHelpHint}
    title="Open help (⌘?)">
    <kbd>⌘?</kbd>
    <span>help</span>
  </button>
</div>
