<!--
  <sui-home> — Ship's per-space desktop. First-party CHROME (apps/shell): the
  shell renders it at `/`. Owns its dock; the shell hides the status strip for
  it. Fixed 12x6 grid (no scroll) + bottom dock + per-theme background.
  Data via the controller's @ship/sdk-client live sources.
-->
<style>
  :host { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden;
    color: var(--foreground); font-family: var(--font-body); }

  .home-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: var(--background); }
  .home-bg::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle at 1px 1px, color-mix(in oklch, var(--foreground) 8%, transparent) 1px, transparent 0);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, var(--foreground) 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, var(--foreground) 45%, transparent 100%);
  }
  .home-bg::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 45% at 82% 10%, color-mix(in oklch, var(--primary) 13%, transparent), transparent 70%);
  }

  .home-grid {
    position: relative; z-index: 1; flex: 1; min-height: 0;
    display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(6, 1fr);
    gap: var(--space-3); padding: var(--space-5) var(--space-6) var(--space-3);
  }
  .hw {
    background: color-mix(in oklch, var(--card) 92%, transparent); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: var(--space-4); display: flex; flex-direction: column;
    overflow: hidden; min-width: 0; min-height: 0; box-shadow: var(--shadow-sm); backdrop-filter: blur(10px);
  }
  .hw-greet { justify-content: center; gap: var(--space-2); }
  .hw-greet-line { font-family: var(--heading-font, var(--font-display)); font-size: var(--text-3xl); font-weight: var(--heading-weight, var(--font-weight-semibold)); letter-spacing: -0.03em; line-height: 1.05; margin: 0; text-wrap: balance; }
  .hw-greet-sub { margin: 0; color: var(--muted-foreground); font-size: var(--text-md); }
  .hw-h { display: flex; align-items: baseline; gap: var(--space-2); margin: 0 0 var(--space-3); font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted-foreground); font-weight: var(--font-weight-semibold); }
  .hw-link { margin-left: auto; font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-size: var(--text-xs); color: var(--primary); text-decoration: none; cursor: pointer; }
  .hw-link:hover { text-decoration: underline; }
  .hw-stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); flex: 1; align-content: center; }
  .hw-stat { display: flex; flex-direction: column; }
  .hw-n { font-family: var(--heading-font, var(--font-display)); font-size: var(--text-xl); font-weight: var(--font-weight-semibold); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .hw-l { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted-foreground); }
  .hw-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); flex: 1; min-height: 0; overflow-y: auto; }
  .hw-list-wide { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-1) var(--space-5); align-content: start; }
  .hw-row { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); min-width: 0; }
  .hw-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hw-mono { font-family: var(--font-mono); font-size: var(--text-xs); }
  .hw-muted { color: var(--muted-foreground); }
  .hw-git { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); flex-wrap: wrap; }
  .home-glance-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--warning); flex-shrink: 0; }
  .home-glance-dot[data-clean='1'] { background: var(--success); }

  .home-dock { position: relative; z-index: 1; flex: 0 0 auto; display: flex; justify-content: center; padding: 0 0 var(--space-4); }
  .home-dock-tray { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); border-radius: var(--radius-lg); background: color-mix(in oklch, var(--card) 65%, transparent); backdrop-filter: blur(20px) saturate(1.3); border: 1px solid color-mix(in oklch, var(--border) 80%, transparent); box-shadow: var(--shadow-md, var(--shadow-sm)); }
  .d-app { position: relative; background: transparent; border: 0; cursor: pointer; padding: 0; }
  .d-ico { width: 44px; height: 44px; border-radius: var(--radius-md); background: var(--card); border: 1px solid var(--border); display: grid; place-items: center; color: var(--foreground); transition: transform 220ms var(--ease-out, ease); }
  .d-ico sui-icon { --size: 20px; width: 20px; height: 20px; }
  .d-app:hover .d-ico { transform: scale(1.15) translateY(-4px); }
  .d-tip { position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%); background: var(--foreground); color: var(--background); font-family: var(--font-mono); font-size: var(--text-xs); padding: 2px 8px; border-radius: var(--radius-sm); white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 130ms; }
  .d-app:hover .d-tip { opacity: 1; }
  .home-empty { margin: auto; }
</style>

<div class="home-bg" aria-hidden="true"></div>

{#async dash}
  {:loading}
  <div class="home-grid" data-test="home-loading" aria-busy="true" aria-label="Loading workspace">
    {#for n of [0, 1, 2, 3, 4] key={n}}
      <sui-skeleton shape="block" size="md"></sui-skeleton>
    {/for}
  </div>

  {:error err}
  <sui-error-state title="Couldn't load workspace" data-test="home-error" role="alert" aria-live="assertive">
    {err.message}
    <sui-button slot="action" tone="primary" variant="solid" on:click={() => window.location.reload()}>Retry</sui-button>
  </sui-error-state>

  {:ok}
  {#if isFirstRun()}
    <sui-empty-state icon="sparkles" variant="default" size="lg" data-test="home-empty" role="status" class="home-empty">
      <span slot="title">Welcome to Ship</span>
      This space is empty.
      <sui-button slot="action" tone="primary" variant="solid" on:click={() => navigate('/studio/agents/create')} data-test="home-empty-agent">
        <sui-icon slot="leading" name="user-plus"></sui-icon>
        Add an agent
      </sui-button>
    </sui-empty-state>
  {:else}
    <div class="home-grid" data-test="home-widgets" data-view-enter>
      <article class="hw hw-greet" style="grid-column: 1 / span 8; grid-row: 1 / span 2;">
        <h1 class="hw-greet-line" data-test="home-hero">{greeting()}.</h1>
        <p class="hw-greet-sub">{heroLine()}</p>
      </article>

      <article class="hw" style="grid-column: 9 / span 4; grid-row: 1 / span 2;">
        <h2 class="hw-h">Workspace</h2>
        <div class="hw-stat-row">
          <div class="hw-stat"><span class="hw-n">{totalJobs()}</span><span class="hw-l">jobs</span></div>
          <div class="hw-stat"><span class="hw-n">{agentCount()}</span><span class="hw-l">agents</span></div>
          <div class="hw-stat"><span class="hw-n">{totalEvents()}</span><span class="hw-l">events</span></div>
          <div class="hw-stat"><span class="hw-n">{collectionsCount()}</span><span class="hw-l">colls</span></div>
        </div>
      </article>

      <article class="hw" style="grid-column: 1 / span 5; grid-row: 3 / span 2;">
        <h2 class="hw-h">Recent jobs<a class="hw-link" on:click={() => navigate('/studio/pipelines')}>all</a></h2>
        {#if recentJobs().length > 0}
          <ul class="hw-list">
            {#for run of recentJobs() key={run.id}}
              <li class="hw-row" data-test="home-job">
                <sui-status-dot prop:tone={run.tone ?? 'muted'} size="sm"></sui-status-dot>
                <span class="hw-name">{run.slug ?? run.id}</span>
              </li>
            {/for}
          </ul>
        {:else}
          <span class="hw-muted">No jobs yet.</span>
        {/if}
      </article>

      <article class="hw" style="grid-column: 6 / span 3; grid-row: 3 / span 2;">
        <h2 class="hw-h">Git<a class="hw-link" on:click={() => navigate('/git')}>open</a></h2>
        {#async git}
          {:loading}
          <span class="hw-muted" data-test="git-loading">Loading&hellip;</span>
          {:error err}
          <span class="hw-muted" data-test="git-error">offline</span>
          {:ok}
          <div class="hw-git" data-test="git-summary">
            <span class="home-glance-dot" data-clean={isClean() ? '1' : '0'} aria-hidden="true"></span>
            <strong class="hw-mono" data-test="git-branch">{branchName()}</strong>
            <span class="hw-mono hw-muted" data-test="git-head">{headShort()}</span>
            <span class="hw-mono hw-muted" data-test="git-status">{isClean() ? 'clean' : changedSummary()}</span>
          </div>
        {/async}
      </article>

      <article class="hw" style="grid-column: 9 / span 4; grid-row: 3 / span 2;">
        <h2 class="hw-h">Agents<a class="hw-link" on:click={() => navigate('/studio/agents')}>manage</a></h2>
        {#if agentSlice().length > 0}
          <ul class="hw-list">
            {#for agent of agentSlice() key={agent.id}}
              <li class="hw-row" data-test="home-agent">
                <sui-avatar size="sm" shape="square" attr:name={agent.name ?? agent.id} attr:initials={agent.initials}></sui-avatar>
                <span class="hw-name">{agent.name ?? agent.id}</span>
              </li>
            {/for}
          </ul>
        {:else}
          <span class="hw-muted">No agents.</span>
        {/if}
      </article>

      <article class="hw" style="grid-column: 1 / span 12; grid-row: 5 / span 2;">
        <h2 class="hw-h">Activity<a class="hw-link" on:click={() => navigate('/activity')}>stream</a></h2>
        {#if recentEvents().length > 0}
          <ul class="hw-list hw-list-wide">
            {#for r of recentEvents() key={r.id ?? r.timestamp}}
              <li class="hw-row" data-test="home-activity-row">
                <span class="hw-mono hw-muted">{r.timestamp}</span>
                <span class="hw-name">{r.event_type}</span>
              </li>
            {/for}
          </ul>
        {:else}
          <span class="hw-muted">Waiting for activity.</span>
        {/if}
      </article>
    </div>

    <footer class="home-dock">
      <div class="home-dock-tray">
        {#for app of apps() key={app.href}}
          <button class="d-app" on:click={() => navigate(app.href)} data-test="home-launch">
            <span class="d-ico"><sui-icon name={app.icon} aria-hidden="true"></sui-icon></span>
            <span class="d-tip">{app.name}</span>
          </button>
        {/for}
      </div>
    </footer>
  {/if}
{/async}
