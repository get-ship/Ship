<!-- <sui-setup> — first-run onboarding wizard. First-party CHROME (apps/shell); shell renders it at /setup. Relocated from views/setup. -->
<style>
:host { display: block; }
.setup-view {
  color: var(--foreground);
  background: var(--background);
  font-family: var(--font-body);
  min-height: 100vh;
}

.setup-wizard {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  padding: var(--space-4) var(--space-2) var(--space-2);
  min-height: 480px;
}

.setup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--border);
}

.setup-step {
  display: flex;
  flex-direction: column;
}

.setup-eyebrow {
  font-size: var(--text-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted-foreground);
  font-weight: var(--font-weight-semibold);
  margin: 0 0 var(--space-3);
}

.setup-title {
  font-family: var(--heading-font);
  font-size: var(--text-2xl);
  font-weight: var(--heading-weight);
  line-height: var(--leading-tight);
  letter-spacing: var(--heading-tracking);
  margin: 0 0 var(--space-3);
  color: var(--foreground);
}

.setup-lede {
  font-size: var(--text-md);
  line-height: var(--leading-normal);
  color: var(--muted-foreground);
  margin: 0 0 var(--space-4);
}

.setup-hint {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}

.setup-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-6);
}
.setup-actions--end { justify-content: flex-end; }

.setup-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
@media (max-width: 480px) {
  .setup-grid-2 { grid-template-columns: 1fr; }
}

.setup-provider-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}
.setup-provider-name {
  font-size: var(--text-md);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}
.setup-provider-sub {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  margin-top: 2px;
}

.setup-provider-status {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-height: 28px;
  margin-bottom: var(--space-2);
}

.setup-progress {
  list-style: none;
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0;
  margin: 0;
}

.setup-progress-dot {
  width: 7px;
  height: 7px;
  border-radius: var(--radius-full);
  background: color-mix(in oklch, var(--muted-foreground) 35%, transparent);
  transition: all var(--duration-medium) var(--ease-out);
  flex-shrink: 0;
}

.setup-progress-dot.current {
  width: 22px;
  background: var(--primary);
}

.setup-progress-dot.done {
  background: color-mix(in oklch, var(--primary) 55%, transparent);
}

@media (prefers-reduced-motion: reduce) {
  .setup-progress-dot { transition: none; }
}
</style>

<div class="ship-view setup-view" data-test="setup-view">
  <sui-dialog
    prop:open={open()}
    backdrop="blur"
    size="lg"
    no-close-button
    no-header
    no-footer
    dismissible="false">

    <div class="setup-wizard" data-test="setup-wizard" attr:data-step={step()}>

      <header class="setup-head">
        <ol class="setup-progress" role="progressbar" aria-label="Setup progress" attr:aria-valuenow={step()} aria-valuemin="1" aria-valuemax="6">
          {#for stepNum of [1, 2, 3, 4, 5, 6] key={stepNum}}
            <li class="setup-progress-dot" class:current={step() === stepNum} class:done={step() > stepNum}></li>
          {/for}
        </ol>
        <sui-button variant="ghost" size="sm" data-test="setup-skip"
          on:click={requestExit}>
          Skip setup
        </sui-button>
      </header>

      <!-- Step 1: Welcome -->
      {#if step() === 1}
        <section class="setup-step" data-test="step-welcome">
          <p class="setup-eyebrow">Step 1 of 6</p>
          <h1 class="setup-title">Welcome to Ship</h1>
          <p class="setup-lede">
            Ship is the workbench for shipping software with agents. It runs
            locally — you own the data, the agents, and the pipelines.
          </p>
          <p class="setup-lede">
            The next five steps set up an identity, connect a provider, and
            create your first project. You can change any of it later.
          </p>
          <div class="setup-actions setup-actions--end">
            <sui-button tone="primary" variant="solid" size="md"
              data-test="step-welcome-next"
              on:click={goNext}>
              Let's set it up
              <sui-icon slot="trailing" name="arrow-right"></sui-icon>
            </sui-button>
          </div>
        </section>
      {/if}

      <!-- Step 2: Identity -->
      {#if step() === 2}
        <section class="setup-step" data-test="step-identity">
          <p class="setup-eyebrow">Step 2 of 6</p>
          <h2 class="setup-title">What should we call you?</h2>
          <p class="setup-lede">
            Your display name shows up next to agent activity, sessions, and
            git commits Ship makes on your behalf.
          </p>
          <sui-field>
            <sui-label for="setup-identity-name">Display name</sui-label>
            <sui-input id="setup-identity-name" size="md"
              placeholder="e.g. Ada Lovelace"
              data-test="step-identity-name"
              bind:value={identityName}
              on:keydown={onFieldKeydown}></sui-input>
          </sui-field>
          {#if identityError()}
            <sui-alert tone="destructive" data-test="step-identity-error"
              style="margin-top:var(--space-3)">
              {identityError()}
            </sui-alert>
          {/if}
          <div class="setup-actions">
            <sui-button variant="ghost" size="md" on:click={goBack}>
              <sui-icon slot="leading" name="arrow-left"></sui-icon>Back
            </sui-button>
            <sui-button tone="primary" variant="solid" size="md"
              data-test="step-identity-next"
              on:click={submitIdentity}>
              Continue
              <sui-icon slot="trailing" name="arrow-right"></sui-icon>
            </sui-button>
          </div>
        </section>
      {/if}

      <!-- Step 3: Provider -->
      {#if step() === 3}
        <section class="setup-step" data-test="step-provider">
          <p class="setup-eyebrow">Step 3 of 6</p>
          <h2 class="setup-title">Connect a provider</h2>
          <p class="setup-lede">
            Ship drives whichever provider CLIs you have installed. Pick one
            to start with — add more later from Settings.
          </p>
          <div class="setup-grid-2" role="radiogroup" aria-label="AI provider">
            {#for p of providerList key={p.id}}
              <sui-card interactive padding="md" role="radio"
                attr:data-test={'provider-' + p.id}
                attr:aria-checked={provider() === p.id ? 'true' : 'false'}
                prop:tone={provider() === p.id ? 'primary' : ''}
                prop:fill={provider() === p.id}
                on:click={() => selectProvider(p.id)}>
                <div class="setup-provider-row">
                  <sui-provider-blob prop:provider={p.id} size="md" variant="glyph"></sui-provider-blob>
                  <div style="min-width:0">
                    <div class="setup-provider-name">{p.name}</div>
                    <div class="setup-provider-sub">{p.sub}</div>
                  </div>
                </div>
              </sui-card>
            {/for}
          </div>
          <div class="setup-provider-status">
            {#if providerTesting()}
              <sui-badge tone="info" variant="soft" size="sm">Validating…</sui-badge>
            {/if}
            {#if providerTestOk()}
              <sui-badge tone="success" variant="soft" size="sm"
                data-test="provider-ok">
                <sui-icon slot="leading" name="check"></sui-icon>{providerOkLabel()}
              </sui-badge>
            {/if}
            {#if providerError()}
              <sui-alert tone="destructive" data-test="provider-error">
                {providerError()}
                <sui-button slot="actions" size="sm" variant="outline"
                  data-test="provider-retry" on:click={validateProvider}>
                  Retry
                </sui-button>
              </sui-alert>
            {/if}
          </div>
          <div class="setup-actions">
            <sui-button variant="ghost" size="md" on:click={goBack}>
              <sui-icon slot="leading" name="arrow-left"></sui-icon>Back
            </sui-button>
            <sui-button tone="primary" variant="solid" size="md"
              data-test="step-provider-next"
              prop:disabled={!provider() || providerTesting()}
              on:click={submitProvider}>
              Continue
              <sui-icon slot="trailing" name="arrow-right"></sui-icon>
            </sui-button>
          </div>
        </section>
      {/if}

      <!-- Step 4: Project -->
      {#if step() === 4}
        <section class="setup-step" data-test="step-project">
          <p class="setup-eyebrow">Step 4 of 6</p>
          <h2 class="setup-title">Create your first project</h2>
          <p class="setup-lede">
            A project is a folder Ship watches. Agents and pipelines work
            inside it; you can have many.
          </p>
          <sui-field>
            <sui-label for="setup-project-name">Project name</sui-label>
            <sui-input id="setup-project-name" size="md"
              placeholder="my-first-project"
              data-test="step-project-name"
              bind:value={projectName}
              on:keydown={onFieldKeydown}></sui-input>
          </sui-field>
          <sui-field>
            <sui-label for="setup-project-path">Location</sui-label>
            <sui-input id="setup-project-path" size="md"
              placeholder="~/Documents/ShipProjects/<name>"
              data-test="step-project-path"
              bind:value={projectPath}
              on:keydown={onFieldKeydown}></sui-input>
            <span slot="hint" class="setup-hint">
              Defaults to <sui-code>~/Documents/ShipProjects/&lt;name&gt;</sui-code>.
              The folder is created if it doesn't exist.
            </span>
          </sui-field>
          {#if projectWarning()}
            <sui-alert tone="warning" data-test="project-warning"
              style="margin-top:var(--space-3)">
              {projectWarning()}
            </sui-alert>
          {/if}
          {#if projectError()}
            <sui-alert tone="destructive" data-test="project-error"
              style="margin-top:var(--space-3)">
              {projectError()}
            </sui-alert>
          {/if}
          <div class="setup-actions">
            <sui-button variant="ghost" size="md" on:click={goBack}>
              <sui-icon slot="leading" name="arrow-left"></sui-icon>Back
            </sui-button>
            <sui-button tone="primary" variant="solid" size="md"
              data-test="step-project-next"
              prop:loading={projectSubmitting()}
              prop:disabled={!projectName().length}
              on:click={submitProject}>
              Create project
              <sui-icon slot="trailing" name="arrow-right"></sui-icon>
            </sui-button>
          </div>
        </section>
      {/if}

      <!-- Step 5: Sample app -->
      {#if step() === 5}
        <section class="setup-step" data-test="step-sample">
          <p class="setup-eyebrow">Step 5 of 6</p>
          <h2 class="setup-title">Want a sample app to start with?</h2>
          <p class="setup-lede">
            Scaffolds a "Hello, Ship" view in your project so the first time
            you open it isn't empty. Easy to delete later.
          </p>
          <sui-field>
            <sui-checkbox
              data-test="step-sample-toggle"
              bind:checked={sampleApp}>
              Add the Hello, Ship sample app
            </sui-checkbox>
          </sui-field>
          <div class="setup-actions">
            <sui-button variant="ghost" size="md" on:click={goBack}>
              <sui-icon slot="leading" name="arrow-left"></sui-icon>Back
            </sui-button>
            <sui-button tone="primary" variant="solid" size="md"
              data-test="step-sample-next"
              on:click={submitSample}>
              Continue
              <sui-icon slot="trailing" name="arrow-right"></sui-icon>
            </sui-button>
          </div>
        </section>
      {/if}

      <!-- Step 6: Done -->
      {#if step() === 6}
        <section class="setup-step" data-test="step-done">
          <p class="setup-eyebrow">Step 6 of 6</p>
          <h2 class="setup-title">Ship is ready</h2>
          <p class="setup-lede">
            Hi {identityName() || 'there'}, your project
            <strong>{projectName()}</strong> is set up
            {#if sampleApp()}with the Hello, Ship sample app{/if}.
          </p>
          <p class="setup-lede">
            Jump in — the rail on the left navigates to Agents, Pipelines,
            and the rest of Ship.
          </p>
          <div class="setup-actions setup-actions--end">
            <sui-button tone="primary" variant="solid" size="lg"
              data-test="step-done-finish"
              on:click={finish}>
              Open Ship
              <sui-icon slot="trailing" name="arrow-right"></sui-icon>
            </sui-button>
          </div>
        </section>
      {/if}

    </div>
  </sui-dialog>

  <sui-alert-dialog
    prop:open={confirmingExit()}
    tone="default"
    confirm-label="Skip setup"
    cancel-label="Keep going"
    data-test="setup-confirm-exit"
    on:sui-confirm={confirmExit}
    on:sui-cancel={cancelExit}>
    <span slot="title">Skip setup?</span>
    <p>
      We'll apply sensible defaults for the steps you haven't filled in.
      You can run setup again from Settings → About.
    </p>
  </sui-alert-dialog>
</div>
