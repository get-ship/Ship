<!-- <sui-settings> — CLI + studio config. First-party CHROME (apps/shell); rendered at /settings. -->
<style>
:host { display: block; height: 100%; overflow: auto; }
.ship-view-settings { color: var(--foreground); }
.settings-wrap {
  max-width: 768px;
  margin: 0 auto;
  padding: 24px 24px 96px;
  width: 100%;
}
.settings-header { margin-bottom: 24px; position: relative; }
.settings-header h1 {
  font-family: var(--heading-font);
  font-size: var(--text-xl);
  font-weight: var(--heading-weight);
  letter-spacing: var(--heading-tracking);
  line-height: 28px;
  margin: 0;
  color: var(--foreground);
}
.settings-header::after {
  content: '';
  display: block;
  width: 60px;
  height: 4px;
  margin-top: var(--space-2);
  border-radius: 2px;
  background: linear-gradient(90deg, var(--primary), transparent);
}
.settings-header p {
  font-size: var(--text-base);
  line-height: 19.5px;
  color: var(--muted-foreground);
  margin: 2px 0 0;
}

.list-tile {
  width: 100%;
  text-align: start;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: inherit;
  font: inherit;
  text-decoration: none;
  box-sizing: border-box;
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}
.list-tile--compact { padding: 6px 8px; }
.list-tile--normal { padding: 10px 10px; }
.list-tile--relaxed { padding: 16px 14px; }
.list-tile--row { min-height: auto; }
.list-tile-row { display: flex; align-items: center; gap: 8px; }
.list-tile-primary {
  flex: 1;
  min-width: 0;
  font-weight: var(--font-weight-medium);
  font-size: var(--text-base);
}
.list-tile-secondary {
  display: flex;
  gap: 6px;
  align-items: center;
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}
.list-tile-secondary:empty { display: none; }
.list-tile :is([slot='leading'], [slot='trailing']) {
  display: inline-flex;
  align-items: center;
}

.s-loading { color: var(--muted-foreground); padding: var(--space-4); }

/* .s-skel / .s-skel-head / .s-skel-body / .s-sections layout is delegated
   to <sui-stack> + <sui-cluster>. .s-skel-card keeps its visual chrome. */
.s-skel-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: var(--space-4) var(--space-5);
}

.s-section-body { padding: var(--space-1) var(--space-4); }

.s-section-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--space-3); padding: var(--space-4) var(--space-5);
}
.s-section-title {
  display: flex; align-items: center; gap: var(--space-2);
  margin: 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}
.s-section-title sui-icon { color: var(--muted-foreground); width: 16px; height: 16px; }

.s-row-label {
  font-size: var(--text-sm);
  color: color-mix(in oklch, var(--foreground) 80%, transparent);
  font-weight: var(--font-weight-normal);
}

.s-row-trailing {
  display: inline-flex; align-items: center; gap: var(--space-2);
  flex-shrink: 0;
}

.s-provider-list { padding: var(--space-1) 0 var(--space-2); }
.s-provider-label {
  font-size: var(--text-xs); font-weight: var(--font-weight-semibold);
  text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--muted-foreground);
  padding: var(--space-2) var(--space-2) var(--space-1);
}
.s-prov-name {
  font-size: var(--text-xs);
  color: color-mix(in oklch, var(--foreground) 80%, transparent);
  font-family: var(--font-mono);
  font-weight: var(--font-weight-normal);
}
.s-prov-right {
  display: inline-flex; align-items: center; gap: var(--space-2);
  font-size: var(--text-xs); color: var(--muted-foreground);
}
.s-prov-right .mono { font-family: var(--font-mono); }

.s-collapse-trigger {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: var(--space-4) var(--space-5); cursor: pointer;
  box-sizing: border-box;
}
.s-collapse-trigger:focus-visible {
  outline: var(--ring-width) solid color-mix(in oklch, var(--ring) 50%, transparent);
  outline-offset: -3px; border-radius: var(--radius-xl);
}
.s-chevron {
  width: var(--space-4); height: var(--space-4);
  color: var(--muted-foreground);
  transition: transform var(--duration-medium) var(--ease-out);
}
.s-chevron.open { transform: rotate(180deg); }
.s-collapse-inner {
  border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
}

.s-save-badge { opacity: 0; transition: opacity var(--duration-slow) var(--ease-out); }
.s-save-badge.visible { opacity: 1; }

.s-mono-val {
  font-family: var(--font-mono); font-size: var(--text-xs);
  color: var(--foreground);
}
.s-status-text { font-size: var(--text-xs); color: var(--foreground); }

sui-input { width: 160px; }

@media (max-width: 640px) {
  .s-row-trailing { width: 100%; flex-wrap: wrap; }
  sui-input { width: 100%; }
}

.s-account-body { gap: 0; }
.s-account-avatar,
.s-account-avatar-fallback {
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 0 0 1px color-mix(in oklch, var(--foreground) 15%, transparent);
}
.s-account-avatar { object-fit: cover; }
.s-account-avatar-fallback {
  background: color-mix(in oklch, var(--primary) 18%, var(--muted));
  color: var(--primary);
  font-size: var(--text-xs);
  font-weight: 600;
}
.s-account-avatar-fallback.signed-out {
  background: color-mix(in oklch, currentColor 8%, transparent);
  color: var(--muted-foreground);
}
.s-row-label.err { color: var(--destructive); }
.s-row-label.muted { color: var(--muted-foreground); }
</style>

<!-- Live subscriptions live at the top per SUI hard rule #2 (subscriptions
     Both signals are accessed via the auto-generated scope in the controller. -->

<div class="ship-view ship-view-settings">
  <main class="settings-wrap">
    <header class="settings-header">
      <h1>Settings</h1>
      <p>CLI and studio configuration</p>
    </header>

    {#async settings}
      {:loading}
      <sui-stack gap="4" aria-busy="true" aria-label="Loading settings">
        {#for n of [0, 1, 2] key={n}}
          <sui-stack class="s-skel-card" gap="3">
            <sui-cluster gap="2" align="center">
              <sui-skeleton shape="circle" size="sm"></sui-skeleton>
              <sui-skeleton shape="line" size="md" style="width:120px"></sui-skeleton>
            </sui-cluster>
            <sui-stack gap="2">
              <sui-skeleton shape="line" size="md"></sui-skeleton>
              <sui-skeleton shape="line" size="md"></sui-skeleton>
            </sui-stack>
          </sui-stack>
        {/for}
      </sui-stack>
    
      {:error err}
      <sui-error-state variant="default" size="md" title="Couldn't load settings">
        {err.message}
      </sui-error-state>
    
      {:ok}
      <sui-stack gap="4">

        <!-- Account -->
        <sui-card id="account" padding="none">
          <div slot="header" class="s-section-head">
            <h2 class="s-section-title">
              <sui-icon name="user"></sui-icon>Account
            </h2>
          </div>
          <div class="s-section-body s-account-body">
            {#if account().kind === 'loading'}
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  <span class="list-tile-primary s-row-label muted">Loading account…</span>
                </div>
              </div>
            {:else if account().kind === 'error'}
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  <span class="list-tile-primary s-row-label">Ship Cloud</span>
                </div>
                <div class="list-tile-secondary">Daemon unreachable. Account features unavailable while offline.</div>
              </div>
            {:else if accountIdentity().status === 'logged_in'}
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  {#if accountIdentity().me?.image}
                    <img class="s-account-avatar"
                      src={accountIdentity().me?.image ?? ''} alt="" />
                  {:else}
                    <span class="s-account-avatar-fallback">{accountInitials()}</span>
                  {/if}
                  <span class="list-tile-primary s-row-label">{accountName()}</span>
                  <span class="s-row-trailing">
                    {#if accountPlan()}
                      <sui-badge tone="info" variant="soft" size="sm">{accountPlan()}</sui-badge>
                    {/if}
                  </span>
                </div>
                <div class="list-tile-secondary">
                  {#if accountIdentity().me?.email}
                    {accountIdentity().me?.email}
                  {:else}
                    Signed in to Ship Cloud
                  {/if}
                </div>
              </div>
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  <span class="list-tile-primary s-row-label">Billing</span>
                  <span class="s-row-trailing">
                    <sui-button variant="outline" size="sm" on:click={() => openBilling()}>
                      <sui-icon slot="leading" name="external-link" size="sm"></sui-icon>
                      Open billing
                    </sui-button>
                  </span>
                </div>
                <div class="list-tile-secondary">Manage your plan and payment method</div>
              </div>
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  <span class="list-tile-primary s-row-label">Session</span>
                  <span class="s-row-trailing">
                    <sui-button variant="outline" tone="destructive" size="sm"
                      disabled={accountBusy()}
                      on:click={onAccountSignOut}>
                      Sign out
                    </sui-button>
                  </span>
                </div>
                <div class="list-tile-secondary">Sign out clears the API key stored by this daemon</div>
              </div>
            {:else if accountIdentity().status === 'pending'}
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  <span class="s-account-avatar-fallback signed-out">
                    <sui-icon name="loader" size="sm"></sui-icon>
                  </span>
                  <span class="list-tile-primary s-row-label">Completing sign-in…</span>
                </div>
                <div class="list-tile-secondary">Finish the flow in your browser, then return here.</div>
              </div>
            {:else}
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  <span class="s-account-avatar-fallback signed-out">
                    <sui-icon name="user" size="sm"></sui-icon>
                  </span>
                  <span class="list-tile-primary s-row-label">Not signed in</span>
                  <span class="s-row-trailing">
                    <sui-button variant="solid" tone="primary" size="sm"
                      disabled={accountBusy()}
                      on:click={onAccountSignIn}>
                      Sign in
                    </sui-button>
                  </span>
                </div>
                <div class="list-tile-secondary">Connect this workspace to Ship Cloud to unlock publish + sync.</div>
              </div>
            {/if}
            {#if accountError()}
              <div class="list-tile list-tile--compact">
                <div class="list-tile-row">
                  <span class="list-tile-primary s-row-label err">{accountError()}</span>
                </div>
              </div>
            {/if}
          </div>
        </sui-card>

        <!-- Theme -->
        <sui-card padding="none">
          <div slot="header" class="s-section-head">
            <h2 class="s-section-title">
              <sui-icon name="eye"></sui-icon>Theme
            </h2>
          </div>
          <div class="s-section-body">
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label">Customize design tokens</span>
                <span class="s-row-trailing">
                  <sui-link href="/theme-studio" data-test="settings-theme-studio-link">
                    Open Theme Studio
                  </sui-link>
                </span>
              </div>
              <div class="list-tile-secondary">Tweak palette, surfaces, motion, typography — overrides ride on top of the active pack.</div>
            </div>
          </div>
        </sui-card>

        <!-- Providers -->
        <sui-card padding="none">
          <div slot="header" class="s-section-head">
            <h2 class="s-section-title">
              <sui-icon name="cpu"></sui-icon>Providers
            </h2>
          </div>
          <div class="s-section-body">
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label" id="s-label-provider">Default provider</span>
                <span class="s-row-trailing">
                  <form mutation="ship.settings.update" on:success={() => flashSaved(savedProvider)}>
                    <input type="hidden" name="key" value="defaults.provider" />
                    <sui-badge tone="success" variant="soft" size="sm"
                      class="s-save-badge" class:visible={savedProvider()}>
                      <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                    </sui-badge>
                    <sui-select name="value" size="sm" aria-labelledby="s-label-provider"
                      prop:value={settings().value.default_provider}
                      on:sui-change={(e) => e.target.closest('form')?.requestSubmit()}>
                      {#for p of (settings().value.providers ?? []) key={p.id}}
                        <option value={p.id}>{p.id}</option>
                      {/for}
                    </sui-select>
                  </form>
                </span>
              </div>
              <div class="list-tile-secondary">Used when no provider is specified</div>
            </div>

            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label" id="s-label-model">Default model</span>
                <span class="s-row-trailing">
                  <form mutation="ship.settings.update" on:success={() => flashSaved(savedModel)}>
                    <input type="hidden" name="key" value="defaults.model" />
                    <sui-badge tone="success" variant="soft" size="sm"
                      class="s-save-badge" class:visible={savedModel()}>
                      <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                    </sui-badge>
                    <sui-input name="value" size="sm" aria-labelledby="s-label-model"
                      prop:value={settings().value.default_model}
                      placeholder="e.g. sonnet"
                      on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                      on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                  </form>
                </span>
              </div>
              <div class="list-tile-secondary">Model name passed to the provider</div>
            </div>

            {#if (settings().value.providers ?? []).length > 0}
              <div class="s-provider-list">
                <div class="s-provider-label">Installed providers</div>
                {#for p of (settings().value.providers ?? []) key={p.id}}
                  <div class="list-tile list-tile--compact s-prov-tile">
                    <div class="list-tile-row">
                      <span class="list-tile-primary s-prov-name">{p.id}</span>
                      <span class="s-prov-right">
                        <span>{p.available ? 'installed' : 'not found'}</span>
                        {#if p.version}
                          <span class="mono">v{p.version}{p.label ? ' (' + p.label + ')' : ''}</span>
                        {/if}
                      </span>
                    </div>
                  </div>
                {/for}
              </div>
            {/if}
          </div>
        </sui-card>

        <!-- Terminal -->
        <sui-card padding="none">
          <div slot="header" class="s-section-head">
            <h2 class="s-section-title">
              <sui-icon name="terminal"></sui-icon>Terminal
            </h2>
          </div>
          <div class="s-section-body">
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label" id="s-label-term">Terminal program</span>
                <span class="s-row-trailing">
                  <form mutation="ship.settings.update" on:success={() => flashSaved(savedTerminal)}>
                    <input type="hidden" name="key" value="terminal.program" />
                    <sui-badge tone="success" variant="soft" size="sm"
                      class="s-save-badge" class:visible={savedTerminal()}>
                      <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                    </sui-badge>
                    <sui-select name="value" size="sm" aria-labelledby="s-label-term"
                      prop:value={settings().value.terminal.program}
                      on:sui-change={(e) => e.target.closest('form')?.requestSubmit()}>
                      {#for opt of (settings().value.terminal?.options ?? []) key={opt.value}}
                        <option value={opt.value}>{opt.label}</option>
                      {/for}
                    </sui-select>
                  </form>
                </span>
              </div>
              <div class="list-tile-secondary">Used when launching sessions</div>
            </div>

            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label" id="s-label-worktree">Worktree base directory</span>
                <span class="s-row-trailing">
                  <form mutation="ship.settings.update" on:success={() => flashSaved(savedWorktree)}>
                    <input type="hidden" name="key" value="worktree.base_dir" />
                    <sui-badge tone="success" variant="soft" size="sm"
                      class="s-save-badge" class:visible={savedWorktree()}>
                      <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                    </sui-badge>
                    <sui-input name="value" size="sm" aria-labelledby="s-label-worktree"
                      prop:value={settings().value.terminal.worktree_base}
                      placeholder="/path/to/worktrees"
                      on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                      on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                  </form>
                </span>
              </div>
              <div class="list-tile-secondary">Root for git worktrees</div>
            </div>
          </div>
        </sui-card>

        <!-- Harness defaults -->
        <sui-card padding="none">
          <div slot="header" class="s-section-head">
            <h2 class="s-section-title">
              <sui-icon name="cpu"></sui-icon>Harness defaults
            </h2>
          </div>
          <div class="s-section-body">
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label" id="s-label-harness-default">Default harness</span>
                <span class="s-row-trailing">
                  <form mutation="ship.settings.update" on:success={() => flashSaved(savedHarnessDefault)}>
                    <input type="hidden" name="key" value="harness.default" />
                    <sui-badge tone="success" variant="soft" size="sm"
                      class="s-save-badge" class:visible={savedHarnessDefault()}>
                      <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                    </sui-badge>
                    <sui-input name="value" size="sm" aria-labelledby="s-label-harness-default"
                      prop:value={settings().value.harness_default}
                      placeholder="e.g. claude, codex, gemini"
                      on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                      on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                  </form>
                </span>
              </div>
              <div class="list-tile-secondary">Harness used when `ship use --launch` runs with no `--harness` flag</div>
            </div>

            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label" id="s-label-harness-default-model">Default harness model</span>
                <span class="s-row-trailing">
                  <form mutation="ship.settings.update" on:success={() => flashSaved(savedHarnessModel)}>
                    <input type="hidden" name="key" value="harness.default_model" />
                    <sui-badge tone="success" variant="soft" size="sm"
                      class="s-save-badge" class:visible={savedHarnessModel()}>
                      <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                    </sui-badge>
                    <sui-input name="value" size="sm" aria-labelledby="s-label-harness-default-model"
                      prop:value={settings().value.harness_default_model}
                      placeholder="e.g. sonnet, opus"
                      on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                      on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                  </form>
                </span>
              </div>
              <div class="list-tile-secondary">Model passed to the launched harness when no `--model` flag is set</div>
            </div>
          </div>
        </sui-card>

        <!-- Sessions -->
        <sui-card padding="none">
          <div slot="header" class="s-section-head">
            <h2 class="s-section-title">
              <sui-icon name="play"></sui-icon>Sessions
            </h2>
          </div>
          <div class="s-section-body">
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label" id="s-label-auto-resume">Auto-resume agent sessions</span>
                <span class="s-row-trailing">
                  <form mutation="ship.settings.update" on:success={() => flashSaved(savedAutoResume)}>
                    <input type="hidden" name="key" value="agent_session.auto_resume" />
                    <sui-badge tone="success" variant="soft" size="sm"
                      class="s-save-badge" class:visible={savedAutoResume()}>
                      <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                    </sui-badge>
                    <sui-switch name="value" size="sm" aria-labelledby="s-label-auto-resume"
                      prop:checked={settings().value.agent_session_auto_resume}
                      on:sui-change={(e) => e.target.closest('form')?.requestSubmit()}></sui-switch>
                  </form>
                </span>
              </div>
              <div class="list-tile-secondary">When on, `ship use --launch` re-enters an existing (agent, path) session instead of spawning fresh</div>
            </div>
          </div>
        </sui-card>

        <!-- Advanced (collapsible) -->
        <sui-card padding="none">
          <sui-collapsible
            on:sui-toggle={() => advancedOpen.set(!advancedOpen())}>
            <div slot="trigger" class="s-collapse-trigger">
              <h2 class="s-section-title">
                <sui-icon name="settings"></sui-icon>Advanced
              </h2>
              <sui-icon name="chevron-down" class="s-chevron" class:open={advancedOpen()}></sui-icon>
            </div>
            <div class="s-collapse-inner">
              <div class="s-section-body">
                <div class="list-tile list-tile--compact">
                  <div class="list-tile-row">
                    <span class="list-tile-primary s-row-label">Daemon status</span>
                    <span class="s-row-trailing">
                      <sui-status-dot
                        tone={settings().kind === 'ok' ? 'success' : 'destructive'}
                        label={settings().kind === 'ok' ? 'Connected' : 'Disconnected'}></sui-status-dot>
                      <span class="s-status-text">{settings().kind === 'ok' ? 'Connected' : 'Disconnected'}</span>
                    </span>
                  </div>
                </div>
                <div class="list-tile list-tile--compact">
                  <div class="list-tile-row">
                    <span class="list-tile-primary s-row-label">Daemon endpoint</span>
                    <span class="s-mono-val">{settings().value.daemon_endpoint}</span>
                  </div>
                </div>
                <div class="list-tile list-tile--compact">
                  <div class="list-tile-row">
                    <span class="list-tile-primary s-row-label" id="s-label-registry">Registry endpoint</span>
                    <span class="s-row-trailing">
                      <form mutation="ship.settings.update" on:success={() => flashSaved(savedRegistry)}>
                        <input type="hidden" name="key" value="registry.endpoint" />
                        <sui-badge tone="success" variant="soft" size="sm"
                          class="s-save-badge" class:visible={savedRegistry()}>
                          <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                        </sui-badge>
                        <sui-input name="value" size="sm" aria-labelledby="s-label-registry"
                          prop:value={settings().value.advanced_registry}
                          placeholder="https://registry.getship.dev"
                          on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                          on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                      </form>
                    </span>
                  </div>
                  <div class="list-tile-secondary">Package registry URL</div>
                </div>
                <div class="list-tile list-tile--compact">
                  <div class="list-tile-row">
                    <span class="list-tile-primary s-row-label" id="s-label-watcher-debounce">Watcher debounce (ms)</span>
                    <span class="s-row-trailing">
                      <form mutation="ship.settings.update" on:success={() => flashSaved(savedWatcherDebounce)}>
                        <input type="hidden" name="key" value="watcher.debounce_ms" />
                        <sui-badge tone="success" variant="soft" size="sm"
                          class="s-save-badge" class:visible={savedWatcherDebounce()}>
                          <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                        </sui-badge>
                        <sui-input type="number" name="value" size="sm" aria-labelledby="s-label-watcher-debounce"
                          prop:value={settings().value.watcher_debounce_ms}
                          placeholder="200"
                          on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                          on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                      </form>
                    </span>
                  </div>
                  <div class="list-tile-secondary">Debounce window for the declarative `.ship/` file watcher</div>
                </div>
                <div class="list-tile list-tile--compact">
                  <div class="list-tile-row">
                    <span class="list-tile-primary s-row-label" id="s-label-git-log-limit">Git log limit</span>
                    <span class="s-row-trailing">
                      <form mutation="ship.settings.update" on:success={() => flashSaved(savedGitLogLimit)}>
                        <input type="hidden" name="key" value="git.log_limit" />
                        <sui-badge tone="success" variant="soft" size="sm"
                          class="s-save-badge" class:visible={savedGitLogLimit()}>
                          <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                        </sui-badge>
                        <sui-input type="number" name="value" size="sm" aria-labelledby="s-label-git-log-limit"
                          prop:value={settings().value.git_log_limit}
                          placeholder="50"
                          on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                          on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                      </form>
                    </span>
                  </div>
                  <div class="list-tile-secondary">Default row count for `git log` reads when callers omit a limit</div>
                </div>
                <div class="list-tile list-tile--compact">
                  <div class="list-tile-row">
                    <span class="list-tile-primary s-row-label" id="s-label-hooks-max-depth">Hooks max depth</span>
                    <span class="s-row-trailing">
                      <form mutation="ship.settings.update" on:success={() => flashSaved(savedHooksMaxDepth)}>
                        <input type="hidden" name="key" value="hooks.max_depth" />
                        <sui-badge tone="success" variant="soft" size="sm"
                          class="s-save-badge" class:visible={savedHooksMaxDepth()}>
                          <sui-icon slot="leading" name="check" size="sm"></sui-icon>Saved
                        </sui-badge>
                        <sui-input type="number" name="value" size="sm" aria-labelledby="s-label-hooks-max-depth"
                          prop:value={settings().value.hooks_max_depth}
                          placeholder="3"
                          on:blur={(e) => e.target.closest('form')?.requestSubmit()}
                          on:keydown={(e) => { if (e.key === 'Enter') e.target.blur() }}></sui-input>
                      </form>
                    </span>
                  </div>
                  <div class="list-tile-secondary">Max hook recursion depth before the engine drops further events</div>
                </div>
              </div>
            </div>
          </sui-collapsible>
        </sui-card>

        <!-- About -->
        <sui-card padding="none">
          <div slot="header" class="s-section-head">
            <h2 class="s-section-title">
              <sui-icon name="info"></sui-icon>About
            </h2>
          </div>
          <div class="s-section-body">
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label">Documentation</span>
                <sui-link prop:href={settings().value.about.docs} external>getship.dev/docs</sui-link>
              </div>
            </div>
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label">Source</span>
                <sui-link prop:href={settings().value.about.source} external>GitHub</sui-link>
              </div>
            </div>
            <div class="list-tile list-tile--compact">
              <div class="list-tile-row">
                <span class="list-tile-primary s-row-label">First-run setup</span>
                <span class="s-row-trailing">
                  <sui-button variant="outline" size="sm" data-test="settings-rerun-setup"
                    on:click={rerunSetup}>
                    Run setup again
                  </sui-button>
                </span>
              </div>
              <div class="list-tile-secondary">Run the welcome wizard again</div>
            </div>
          </div>
        </sui-card>

      </sui-stack>
    
    {/async}
  </main>
</div>
