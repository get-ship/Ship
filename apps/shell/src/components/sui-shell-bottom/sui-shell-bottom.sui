<!--
  <sui-shell-bottom> — Ship's 28px bottom strip.

  Left zone: [● connected] · [branch] · [workspace]
  Spacer
  Right zone: [terminal · devtools · annotate] · [theme] · [v X.Y.Z] · [MODE chip]

  Glance-only system status. Click on tool icons emits the corresponding
  toggle events the shell listens for. Click on the connection dot bubbles
  `sui:dock:toggle` (matching the legacy status-bar dot behavior).

  Prop surface
  ─────────────────────────────────────────────────────────────────────
  branch     (string, '')           — git branch text
  workspace  (string, '')           — workspace label (mono)
  theme      (string, '')           — current theme id
  version    (string, '')           — daemon/app version label
  online     (bool, false, reflect) — connection state colors the dot
  mode       (string, '', reflect)  — 'development' | 'release' | 'production'
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="branch" type="string" default="" />
<prop name="workspace" type="string" default="" />
<prop name="theme" type="string" default="" />
<prop name="version" type="string" default="" />
<prop name="online" type="bool" default="false" reflect />
<prop name="mode" type="string" default="" reflect />

<style>
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-3, 12px);
    height: 28px;
    padding: 0 var(--space-4, 16px);
    box-sizing: border-box;
    background: var(--surface-1);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    color: var(--muted-foreground);
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
  }
  :host([hidden]) { display: none; }

  .cell { display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0; white-space: nowrap; }
  .cell:empty { display: none; }

  .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--destructive);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--destructive) 22%, transparent);
    transition: background-color var(--duration-fast, 120ms),
                box-shadow var(--duration-fast, 120ms);
  }
  :host([online]) .dot {
    background: var(--success);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--success) 22%, transparent);
  }

  .sep { color: var(--border); flex-shrink: 0; }
  .spacer { flex: 1; }

  button {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .dot-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 0 2px;
    border-radius: var(--radius-sm, 4px);
  }
  .dot-btn:hover { color: var(--foreground); }
  .dot-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 50%, transparent);
  }

  .tools { display: flex; align-items: center; gap: 2px; flex-shrink: 0; }
  .tool {
    width: 22px; height: 22px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--muted-foreground);
    border-radius: var(--radius-sm, 4px);
    transition: background-color var(--duration-fast, 120ms),
                color var(--duration-fast, 120ms);
  }
  .tool:hover { color: var(--foreground); background: var(--hover-bg, color-mix(in oklch, var(--foreground) 8%, transparent)); }
  .tool:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 50%, transparent);
  }

  .theme-btn {
    padding: 0 5px;
    height: 20px;
    border-radius: var(--radius-sm, 4px);
  }
  .theme-btn:hover { color: var(--foreground); background: var(--hover-bg, color-mix(in oklch, var(--foreground) 8%, transparent)); }
  .theme-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 50%, transparent);
  }
  .theme-btn:empty { display: none; }

  /* Mode chip — colored by host[mode]. */
  .mode {
    padding: 0 5px;
    height: 18px;
    border-radius: var(--radius-sm, 4px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: var(--font-weight-semibold, 600);
    display: none;
    align-items: center;
    flex-shrink: 0;
  }
  :host([mode]) .mode { display: inline-flex; }
  :host([mode="development"]) .mode {
    background: color-mix(in oklch, var(--warning) 14%, transparent);
    color: var(--warning);
    border: 1px solid color-mix(in oklch, var(--warning) 32%, transparent);
  }
  :host([mode="release"]) .mode {
    background: color-mix(in oklch, var(--success) 14%, transparent);
    color: var(--success);
    border: 1px solid color-mix(in oklch, var(--success) 32%, transparent);
  }
  :host([mode="production"]) .mode {
    background: color-mix(in oklch, var(--muted) 60%, transparent);
    color: var(--muted-foreground);
    border: 1px solid var(--border-subtle);
  }

  @media (forced-colors: active) {
    :host { background: Canvas; border-top-color: CanvasText; color: CanvasText; }
    .dot { background: CanvasText; forced-color-adjust: none; }
    .mode { background: Canvas; color: CanvasText; border-color: CanvasText; }
  }
</style>

<button class="dot-btn" part="dot-btn" type="button"
  on:click={onDotClick}
  title={online() ? 'Connected — click to toggle devtools' : 'Offline'}
  aria-label="Daemon connection status. Click to toggle devtools.">
  <span class="dot" part="dot" aria-hidden="true"></span>
  <span>{online() ? 'connected' : 'offline'}</span>
</button>

{#if branch()}
  <span class="sep" aria-hidden="true">·</span>
  <span class="cell" part="branch">
    <sui-icon name="git-branch" size="xs"></sui-icon>
    {branch()}
  </span>
{/if}

{#if workspace()}
  <span class="sep" aria-hidden="true">·</span>
  <span class="cell" part="workspace">{workspace()}</span>
{/if}

<span class="spacer"></span>

<div class="tools" part="tools">
  <button class="tool" part="terminal-btn" type="button"
    on:click={onTerminalClick}
    title="Terminal (⌃`)"
    aria-label="Toggle terminal">
    <sui-icon name="terminal" size="xs"></sui-icon>
  </button>
  <button class="tool" part="devtools-btn" type="button"
    on:click={onDevtoolsClick}
    title="Devtools panel"
    aria-label="Toggle devtools panel">
    <sui-icon name="panel-bottom" size="xs"></sui-icon>
  </button>
  <button class="tool" part="annotate-btn" type="button"
    on:click={onAnnotateClick}
    title="Annotate"
    aria-label="Toggle annotation mode">
    <sui-icon name="activity" size="xs"></sui-icon>
  </button>
</div>

<span class="sep" aria-hidden="true">·</span>
<button class="theme-btn" part="theme-btn" type="button"
  on:click={onThemeClick}
  title="Active theme — click to open theme picker"
  aria-label="Open theme picker">{theme()}</button>

{#if version()}
  <span class="sep" aria-hidden="true">·</span>
  <span class="cell" part="version">v {version()}</span>
{/if}

<span class="mode" part="mode" aria-label="Daemon mode">{mode()}</span>
