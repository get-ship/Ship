<!--
  <sui-command-palette> — inner command palette panel.
  Consumed inside <sui-command-bar>. Accesses harness state via useShared.
-->

<style>
  :host { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }

  /* ── Input row ────────────────────────────────────────────────── */
  .cb-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-mode-glyph {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--muted-foreground);
    flex-shrink: 0;
    min-width: 16px;
    text-align: center;
  }
  .cb-mode-glyph.ai {
    font-size: 10px;
    padding: 1px var(--space-1);
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
  }
  .cb-search {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font: inherit;
    font-size: var(--text-md);
    color: var(--foreground);
    caret-color: var(--foreground);
  }
  .cb-search::placeholder { color: var(--muted-foreground); }
  .cb-esc {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
    flex-shrink: 0;
  }

  /* ── Session chip ─────────────────────────────────────────────── */
  .cb-chip-wrap { position: relative; flex-shrink: 0; }
  .cb-session-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 11px;
    color: var(--muted-foreground);
    cursor: pointer;
    user-select: none;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cb-session-chip:hover { background: var(--muted); }
  .cb-dot {
    width: 6px; height: 6px;
    border-radius: 999px;
    flex-shrink: 0;
    display: inline-block;
  }

  /* ── Session popover ──────────────────────────────────────────── */
  .cb-session-popover {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 280px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    box-shadow: var(--shadow-lg);
    z-index: var(--z-dropdown);
    padding: var(--space-1) 0;
    overflow: hidden;
  }
  .cb-session-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 7px var(--space-3);
    cursor: pointer;
    font-size: var(--text-sm);
  }
  .cb-session-row:hover { background: var(--muted); }
  .cb-session-row.current { background: color-mix(in oklch, var(--primary) 8%, transparent); }
  .cb-session-row .meta { color: var(--muted-foreground); font-size: 11px; }
  .cb-session-end {
    background: transparent; border: none; cursor: pointer;
    color: var(--muted-foreground); font-size: var(--text-md); padding: 0 2px;
  }
  .cb-session-end:hover { color: var(--destructive); }
  .cb-session-sep { height: 1px; background: var(--border); margin: var(--space-1) 0; }
  .cb-session-action {
    display: flex; align-items: center; gap: var(--space-2);
    padding: 7px var(--space-3); cursor: pointer; font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .cb-session-action:hover { background: var(--muted); color: var(--foreground); }

  /* ── Body / list ──────────────────────────────────────────────── */
  .cb-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 6px 0;
  }
  .cb-mode-hint {
    padding: var(--space-1) 14px 2px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cb-list { padding: 2px 6px; }
  .cb-item {
    display: grid;
    grid-template-columns: 16px 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 7px var(--space-2);
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
    font-size: var(--text-base);
  }
  .cb-item:hover,
  .cb-item[aria-selected='true'] { background: var(--muted); }
  .cb-item .hint {
    color: var(--muted-foreground);
    font-size: 11px;
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cb-empty {
    padding: var(--space-6) var(--space-4);
    text-align: center;
    color: var(--muted-foreground);
    font-size: var(--text-base);
  }

  /* ── Create form ──────────────────────────────────────────────── */
  .cb-create-surfaces {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: var(--space-2) 14px;
  }
  .cb-surface-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: var(--space-1) 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .cb-surface-btn[aria-pressed='true'] {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
  .cb-surface-btn:hover:not([aria-pressed='true']):not([disabled]) { background: var(--muted); }
  .cb-surface-btn[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .cb-surface-hint {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--muted-foreground);
    padding-left: var(--space-1);
    border-left: 1px solid var(--border);
    margin-left: 2px;
  }
  .cb-create-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0 14px 10px;
  }
  .cb-create-grid label { display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); color: var(--muted-foreground); }
  .cb-create-grid input,
  .cb-create-grid select {
    height: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: var(--text-base);
    padding: 0 var(--space-2);
  }
  .span-2 { grid-column: span 2; }
  .cb-create-error { padding: 0 14px 6px; font-size: var(--text-sm); color: var(--destructive); }
  .cb-create-actions { padding: 0 14px 14px; display: flex; justify-content: flex-end; }
  .cb-create-submit {
    height: 32px;
    padding: 0 var(--space-4);
    border: none;
    border-radius: var(--radius-sm, 4px);
    background: var(--primary);
    color: var(--primary-foreground);
    font: inherit;
    font-size: var(--text-base);
    cursor: pointer;
  }
  .cb-create-submit:disabled { opacity: 0.5; cursor: not-allowed; }

</style>

<!-- Input row -->
<div class="cb-input-row">
  <span class="cb-mode-glyph" class:ai={bar.mode() === 'ai'}>{modeGlyph()}</span>
  <input
    class="cb-search"
    type="text"
    autocomplete="off"
    spellcheck="false"
    placeholder={searchPlaceholder()}
    bind:value={bar.value}
    aria-label="Command bar search"
    aria-autocomplete="list"
    aria-activedescendant={activeDescendantId()}
    on:input={onInput}
  />
  <kbd class="cb-esc" aria-label="Escape to close">esc</kbd>
  <div class="cb-chip-wrap">
    <span class="cb-session-chip" role="button" aria-haspopup="listbox" on:click={toggleSessionPicker}>
      <span class="cb-dot" style:background={chipDotBg()}></span>
      <span>{chipLabel()}</span>
    </span>
    {#if bar.sessionPickerOpen()}
      <div class="cb-session-popover" role="listbox" aria-label="Sessions">
        {#for s of activeSessions() key={s.id}}
          <div
            class="cb-session-row"
            class:current={bar.session()?.id === s.id}
            role="option"
            on:click={() => selectSession(s.id)}
          >
            <span class="cb-dot" style:background={s.status === 'thinking' ? 'var(--warning)' : 'var(--success)'}></span>
            <span><strong>{s.agent_id ?? ''}</strong><span class="meta"> · {s.harness ?? ''} · {s.workspace_id}</span></span>
            <button class="cb-session-end" type="button" aria-label="End session" on:click={(e) => { e.stopPropagation(); endSession(s.id) }}>×</button>
          </div>
        {/for}
        {#if activeSessions().length === 0}
          <div class="cb-session-row"><span></span><span class="meta">No active sessions</span><span></span></div>
        {/if}
        <div class="cb-session-sep" role="separator"></div>
        <div class="cb-session-action" on:click={startNewSession}>
          <sui-icon name="plus" size="sm" aria-hidden="true"></sui-icon>
          <span>Start new session</span>
        </div>
        <div class="cb-session-action" on:click={viewChats}>
          <sui-icon name="columns" size="sm" aria-hidden="true"></sui-icon>
          <span>View all chats</span>
        </div>
      </div>
    {/if}
  </div>
</div>

<!-- Body — mode-switched content -->
<div class="cb-body">
  {#match bar.mode()}
    {:case 'find'}
      {#for group of searchGroups() key={group.kind}}
        <div class="cb-mode-hint">{group.label}</div>
        <div class="cb-list" role="listbox" aria-label={group.label}>
          {#for item of group.items key={item.kind + ':' + item.id}}
            <div
              class="cb-item"
              role="option"
              id={'cb-item-' + item.idx}
              aria-selected={bar.selectedIdx() === item.idx ? 'true' : 'false'}
              data-path={item.path}
              data-kind={item.kind}
              data-id={item.id}
              on:click={() => activateNavItem(item.path)}
            >
              <sui-icon name={item.icon ?? 'app-window'} size="sm" aria-hidden="true"></sui-icon>
              <span>{item.label}</span>
              <span class="hint">{group.label}</span>
            </div>
          {/for}
        </div>
      {/for}
      {#if !findHasResults() && findSearching()}
        <div class="cb-empty">Searching…</div>
      {/if}
      {#if !findHasResults() && !findSearching()}
        <div class="cb-empty">No matches.</div>
      {/if}

    {:case 'command'}
      {#if cmdItems().length > 0}
        <div class="cb-mode-hint">Actions</div>
        <div class="cb-list" role="listbox">
          {#for item of cmdItems() key={item.key}}
            <div
              class="cb-item"
              role="option"
              id={'cb-item-' + item.idx}
              aria-selected={bar.selectedIdx() === item.idx ? 'true' : 'false'}
              data-cmd={item.key}
              on:click={() => activateCmd(item.key)}
            >
              <span style="font-family:var(--font-mono)">{item.label}</span>
              <span></span>
              <span class="hint">{item.hint}</span>
            </div>
          {/for}
        </div>
      {:else}
        <div class="cb-empty">No commands match.</div>
      {/if}

    {:case 'mention'}
      {#if mentionItems().length > 0}
        <div class="cb-mode-hint">Reference</div>
        <div class="cb-list" role="listbox">
          {#for item of mentionItems() key={item.id + item.kind}}
            <div
              class="cb-item"
              role="option"
              id={'cb-item-' + item.idx}
              aria-selected={bar.selectedIdx() === item.idx ? 'true' : 'false'}
              data-mention-kind={item.kind}
              data-mention-id={item.id}
              on:click={() => activateMention(item)}
            >
              <sui-icon name={item.icon} size="sm" aria-hidden="true"></sui-icon>
              <span>{item.label}</span>
              <span class="hint">{item.kind}</span>
            </div>
          {/for}
        </div>
      {:else}
        <div class="cb-empty">No matching views or agents.</div>
      {/if}

    {:case 'create'}
      <div class="cb-mode-hint">Create</div>
      <div class="cb-create-surfaces" role="group" aria-label="Surface type">
        {#for surf of createSurfaces() key={surf.id}}
          <button
            class="cb-surface-btn"
            type="button"
            data-surface={surf.id}
            aria-pressed={bar.createSurface() === surf.id ? 'true' : 'false'}
            aria-disabled={surf.disabled ? 'true' : 'false'}
            disabled={surf.disabled}
            title={surf.disabled ? 'post-launch' : surf.label}
            on:click={() => selectSurface(surf.id)}
          >
            <sui-icon name={surf.icon} aria-hidden="true"></sui-icon>
            <span>{surf.label}</span>
            {#if surf.disabled}
              <span class="cb-surface-hint">post-launch</span>
            {/if}
          </button>
        {/for}
      </div>
      <div class="cb-create-grid">
        <label>
          <span>Name (kebab-case)</span>
          <input type="text" class="cb-create-name" placeholder={'my-' + bar.createSurface()} bind:value={bar.createName} autocomplete="off" />
        </label>
        <label>
          <span>{currentSurfaceDef().shapeLabel}</span>
          <select class="cb-create-shape" bind:value={bar.createShape}>
            {#for sh of currentSurfaceDef().shapes key={sh}}
              <option value={sh}>{sh}</option>
            {/for}
          </select>
        </label>
        <label class="span-2">
          <span>Purpose (optional)</span>
          <input type="text" class="cb-create-purpose" placeholder="One-line description" bind:value={bar.createPurpose} autocomplete="off" />
        </label>
      </div>
      {#if bar.createError()}
        <div class="cb-create-error">{bar.createError()}</div>
      {/if}
      <div class="cb-create-actions">
        <button
          class="cb-create-submit"
          type="button"
          disabled={bar.createSubmitting() || !createNameValid()}
          on:click={submitCreate}
        >{bar.createSubmitting() ? 'Creating…' : 'Create ' + currentSurfaceDef().label}</button>
      </div>

    {:default}
      <!-- ai mode is owned by <sui-command-chat> via isChat(); palette
           never renders for mode='ai'. This branch is a defensive
           no-op for any transient unknown mode. -->
      <div class="cb-empty">…</div>
  {/match}
</div>
