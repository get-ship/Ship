<bundle separate />
<!--
  <sui-command-chat> — chat panel for the unified ai mode.
  Always rendered when bar.mode = 'ai'. Body branches:
    daemonOffline → "Daemon unreachable" empty state
    no agents     → "Set an active agent in /agents"
    no session    → inline spawn picker (agent + harness + Start)
    session       → message thread
  Composer is always present so prefill text from `ship:bar:open`
  is visible + editable before submission.
-->

<style>
  :host { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }

  /* ── Header ───────────────────────────────────────────────────── */
  .cb-chat-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-dot {
    width: 8px; height: 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .cb-chat-header .title { font-size: var(--text-base); font-weight: 600; }
  .cb-chat-header .sub { font-size: 11px; color: var(--muted-foreground); }
  .cb-chip-wrap { position: relative; flex-shrink: 0; }
  .cb-session-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 11px;
    color: var(--muted-foreground);
    cursor: pointer;
    user-select: none;
  }
  .cb-session-chip:hover { background: var(--muted); }
  .cb-esc {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }

  /* ── Session picker ───────────────────────────────────────────── */
  .cb-session-popover {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 280px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    box-shadow: var(--shadow-lg);
    z-index: var(--z-dropdown);
    padding: var(--space-1) 0;
  }
  .cb-session-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 7px var(--space-3);
    cursor: pointer;
    font-size: var(--text-sm);
  }
  .cb-session-row:hover { background: var(--muted); }
  .cb-session-row.current { background: color-mix(in oklch, var(--primary) 8%, transparent); }
  .cb-session-row .meta { color: var(--muted-foreground); font-size: 11px; }
  .cb-session-end {
    background: transparent; border: none; cursor: pointer;
    color: var(--muted-foreground); font-size: var(--text-md); padding: 0 2px;
  }
  .cb-session-end:hover { color: var(--destructive); }
  .cb-session-sep { height: 1px; background: var(--border); margin: var(--space-1) 0; }
  .cb-session-action {
    display: flex; align-items: center; gap: var(--space-2);
    padding: 7px var(--space-3); cursor: pointer; font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .cb-session-action:hover { background: var(--muted); color: var(--foreground); }

  /* ── Body shell ──────────────────────────────────────────────── */
  .cb-chat-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: var(--space-3) 14px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* ── Messages ─────────────────────────────────────────────────── */
  .cb-chat-empty {
    color: var(--muted-foreground);
    font-size: var(--text-base);
    text-align: center;
    margin-top: var(--space-6);
    padding: 0 var(--space-4);
    line-height: 1.5;
  }
  .cb-chat-empty .title { color: var(--foreground); font-weight: 600; margin-bottom: 6px; }
  .cb-chat-empty a, .cb-chat-empty button.link {
    color: var(--primary);
    background: transparent;
    border: none;
    padding: 0;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .cb-chat-turn { display: flex; flex-direction: column; }
  .cb-chat-turn[data-sender='user'] { align-items: flex-end; }
  .cb-chat-turn[data-sender='agent'] { align-items: flex-start; }
  .cb-chat-turn[data-sender='system'] { align-items: center; }
  .cb-chat-bubble {
    max-width: 80%;
    padding: 7px 10px;
    border-radius: var(--radius-md, 6px);
    font-size: var(--text-base);
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .cb-chat-turn[data-sender='user'] .cb-chat-bubble {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .cb-chat-turn[data-sender='agent'] .cb-chat-bubble {
    background: var(--muted);
    color: var(--foreground);
  }
  .cb-chat-turn[data-sender='system'] .cb-chat-bubble {
    background: transparent;
    color: var(--muted-foreground);
    font-size: 11px;
    font-family: var(--font-mono);
  }

  /* ── Inline spawn picker ──────────────────────────────────────── */
  .cb-spawn-card {
    margin: var(--space-2) 0;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--muted);
  }
  .cb-spawn-title { font-weight: 600; font-size: var(--text-base); margin-bottom: var(--space-3); }
  .cb-spawn-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .cb-spawn-row label { font-size: var(--text-sm); color: var(--muted-foreground); }
  .cb-spawn-row select {
    height: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: var(--text-base);
    padding: 0 6px;
  }
  .cb-spawn-error { font-size: var(--text-sm); color: var(--destructive); margin-bottom: var(--space-2); }
  .cb-spawn-start {
    margin-top: var(--space-1);
    height: 32px;
    width: 100%;
    border: none;
    border-radius: var(--radius-sm, 4px);
    background: var(--primary);
    color: var(--primary-foreground);
    font: inherit;
    font-size: var(--text-base);
    cursor: pointer;
  }
  .cb-spawn-start:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Banners ─────────────────────────────────────────────────── */
  .cb-banner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 14px;
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-banner.warn {
    background: color-mix(in oklch, var(--warning) 12%, var(--background));
    color: var(--warning);
  }
  .cb-banner.error {
    background: color-mix(in oklch, var(--destructive) 12%, var(--background));
    color: var(--destructive);
  }
  .cb-banner button.dismiss {
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    font: inherit;
    padding: 0 var(--space-1);
    margin-left: auto;
  }

  /* ── Composer ─────────────────────────────────────────────────── */
  .cb-chat-composer {
    display: flex;
    gap: var(--space-2);
    align-items: flex-end;
    padding: 10px 14px;
    border-top: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-chat-input {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: var(--text-base);
    padding: 6px var(--space-2);
    resize: none;
    line-height: 1.4;
    min-height: 56px;
    max-height: 200px;
  }
  .cb-chat-input:focus { outline: none; border-color: var(--primary); }
  .cb-chat-send {
    height: 32px;
    padding: 0 14px;
    border: none;
    border-radius: var(--radius-sm, 4px);
    background: var(--primary);
    color: var(--primary-foreground);
    font: inherit;
    font-size: var(--text-base);
    cursor: pointer;
    flex-shrink: 0;
    align-self: flex-end;
  }
  .cb-chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<!-- Header -->
<div class="cb-chat-header">
  <span class="cb-dot" style:background={headerDotBg()} aria-hidden="true"></span>
  <div style="display:grid;line-height:1.25">
    <span class="title">{bar.session()?.agent_id ?? 'No session'}</span>
    <span class="sub">{bar.session()?.harness ?? '—'} · {bar.session()?.workspace_id ?? ''}</span>
  </div>
  <span style="flex:1"></span>
  <div class="cb-chip-wrap">
    <span class="cb-session-chip" role="button" aria-haspopup="listbox" on:click={toggleSessionPicker}>Switch</span>
    {#if bar.sessionPickerOpen()}
      <div class="cb-session-popover" role="listbox" aria-label="Sessions">
        {#for s of activeSessions() key={s.id}}
          <div
            class="cb-session-row"
            class:current={bar.session()?.id === s.id}
            role="option"
            on:click={() => selectSession(s.id)}
          >
            <span class="cb-dot" style:background={s.status === 'thinking' ? 'var(--warning)' : 'var(--success)'}></span>
            <span><strong>{s.agent_id ?? ''}</strong><span class="meta"> · {s.harness ?? ''} · {s.workspace_id}</span></span>
            <button class="cb-session-end" type="button" aria-label="End session" on:click={(e) => { e.stopPropagation(); endSession(s.id) }}>×</button>
          </div>
        {/for}
        {#if activeSessions().length === 0}
          <div class="cb-session-row"><span></span><span class="meta">No active sessions</span><span></span></div>
        {/if}
        <div class="cb-session-sep" role="separator"></div>
        <div class="cb-session-action" on:click={startNewSession}>
          <sui-icon name="plus" size="sm" aria-hidden="true"></sui-icon>
          <span>Start new session</span>
        </div>
        <div class="cb-session-action" on:click={viewChats}>
          <sui-icon name="columns" size="sm" aria-hidden="true"></sui-icon>
          <span>View all chats</span>
        </div>
      </div>
    {/if}
  </div>
  <kbd class="cb-esc" aria-label="Escape to close">esc</kbd>
</div>

<!-- Banners -->
{#if daemonOffline()}
  <div class="cb-banner warn" role="status">
    <sui-icon name="alert-triangle" size="sm" aria-hidden="true"></sui-icon>
    <span>Daemon unreachable. Reconnect to send messages.</span>
  </div>
{/if}
{#if bar.sendError()}
  <div class="cb-banner error" role="alert">
    <sui-icon name="alert-circle" size="sm" aria-hidden="true"></sui-icon>
    <span>{bar.sendError()}</span>
    <button class="dismiss" type="button" aria-label="Dismiss" on:click={dismissSendError}>×</button>
  </div>
{/if}

<!-- Body — branches on session / agents state -->
<div class="cb-chat-body">
  {#if hasSession()}
    {#if bar.thread().length === 0}
      <div class="cb-chat-empty">
        <div class="title">Connected to {bar.session()?.agent_id ?? 'agent'}</div>
        <div>Type below and press Enter. ArrowUp recalls recent messages.</div>
      </div>
    {:else}
      {#for msg of bar.thread() key={msg.id}}
        <div class="cb-chat-turn" data-sender={msg.sender}>
          <div class="cb-chat-bubble">{msg.text}</div>
        </div>
      {/for}
    {/if}
  {:else if !hasAgents()}
    <div class="cb-chat-empty">
      <div class="title">No agents configured</div>
      <div>Open <button class="link" type="button" on:click={goToAgents}>/agents</button> to add one, then start a session.</div>
    </div>
  {:else}
    <div class="cb-spawn-card">
      <div class="cb-spawn-title">Start a session</div>
      <div class="cb-spawn-row">
        <label>Agent</label>
        <select class="cb-spawn-agent" bind:value={bar.spawnAgent}>
          {#for a of bar.agents() key={a.id}}
            <option value={a.id}>{a.name ?? a.label ?? a.id}</option>
          {/for}
        </select>
      </div>
      <div class="cb-spawn-row">
        <label>Harness</label>
        {#if hasProviders()}
          <select class="cb-spawn-harness" bind:value={bar.spawnHarness}>
            {#for p of bar.harnesses() key={p}}
              <option value={p}>{p}</option>
            {/for}
          </select>
        {:else}
          <span style="font-size:12px;color:var(--muted-foreground)">No harnesses installed</span>
        {/if}
      </div>
      {#if bar.spawnError()}
        <div class="cb-spawn-error">{bar.spawnError()}</div>
      {/if}
      <button
        class="cb-spawn-start"
        type="button"
        disabled={bar.spawning() || !bar.spawnAgent() || !bar.spawnHarness()}
        on:click={spawnSession}
      >{bar.spawning() ? 'Starting…' : 'Start session'}</button>
    </div>
  {/if}
</div>

<!-- Composer (always present so prefill is visible + editable) -->
<div class="cb-chat-composer">
  <textarea
    class="cb-chat-input"
    rows="2"
    placeholder={hasSession() ? 'Message the agent…' : 'Draft a message — start a session above to send'}
    bind:value={bar.value}
    on:keydown={onComposerKeydown}
  ></textarea>
  <button
    class="cb-chat-send"
    type="button"
    disabled={!bar.value().trim() || !hasSession()}
    on:click={sendMessage}
  >Send</button>
</div>
