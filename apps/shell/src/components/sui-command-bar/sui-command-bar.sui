<bundle separate />
<!--
  <sui-command-bar> — harness shell for the command palette.
  Renders the trigger pill + sui-dialog. Wraps state in shared() so
  <sui-command-palette> and <sui-command-chat> consume via useShared.

  Props   : open (bool, reflect), mode (string, reflect)
  Methods : show(mode?, query?), hide(), toggle(mode?), setMode(mode)
  Events  : sui-command:select  { detail: { mode, item } }  bubbles+composed
            sui-command:cancel  { detail: { mode } }         bubbles+composed
  Modes   : ai, command, find, mention, create
  Keyboard: ⌘K open-find, space+space open-ai, ↑/↓ navigate, Enter activate, Esc close
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="mode" type="string" default="ai" reflect />

<style>
  /* Host participates in layout so the trigger pill carries its own
     box (probes asserting commandBar.offsetWidth need a non-zero
     measurement). Inline-flex keeps the pill sized to its content
     while the explicit min-width matches the trigger's design width. */
  :host {
    display: inline-flex;
    align-items: center;
    min-width: 200px;
    max-width: 320px;
  }

  /* ── Trigger pill ─────────────────────────────────────────────── */
  .cb-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--background);
    color: var(--muted-foreground);
    font: inherit;
    font-size: var(--text-xs, 12px);
    cursor: pointer;
    min-width: 200px;
    max-width: 320px;
    width: 100%;
    text-align: left;
    transition: border-color var(--duration-fast, 120ms) var(--ease-out, ease);
  }
  .cb-trigger:hover {
    border-color: color-mix(in oklch, var(--foreground) 30%, var(--border));
  }
  .cb-label { flex: 1; }
  .cb-trigger kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }

  /* ── Status dot ───────────────────────────────────────────────── */
  .cb-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--muted-foreground);
    flex-shrink: 0;
    display: inline-block;
  }

  /* ── Dialog host override ─────────────────────────────────────── */
  .cb-dialog::part(body) {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* ── Wrap (inside dialog body slot) ──────────────────────────── */
  .cb-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
</style>

<button
  class="cb-trigger"
  type="button"
  aria-label="Open command bar"
  aria-haspopup="dialog"
  aria-controls="cb-dialog-root"
  aria-expanded={open() ? 'true' : 'false'}
  on:click={openFind}
>
  <sui-icon name="search" size="sm"></sui-icon>
  <span class="cb-label">{triggerLabel()}</span>
  <span class="cb-dot" style:background={dotBg()}></span>
  <kbd>⌘K</kbd>
</button>

<sui-dialog
  class="cb-dialog"
  id="cb-dialog-root"
  no-header
  no-footer
  no-close-button
  backdrop="blur"
  size="full"
  style="--dlg-max-w: min(840px, 94vw)"
  bind:this={dialogRef}
>
  <div class="cb-wrap">
    {#if isChat()}
      <sui-command-chat></sui-command-chat>
    {:else}
      <sui-command-palette></sui-command-palette>
    {/if}
  </div>
</sui-dialog>
