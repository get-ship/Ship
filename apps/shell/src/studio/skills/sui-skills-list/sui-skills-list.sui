<!--
  <sui-skills-list> — filterable index of skills available to agents.
  Data from ship.skills.summaries() SSE. Filter pills: All / Project / User.
-->

<style>
  :host { display: block; }
  .list { max-width: 1024px; margin: 0 auto; padding: var(--space-2) 0 64px; }

  .list-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-7); }
  .list-title { font-family: var(--heading-font); font-size: var(--text-3xl); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); line-height: 1.05; margin: 0 0 var(--space-2); }
  .list-sub { display: flex; align-items: center; gap: var(--space-2); font-size: 13.5px; color: var(--muted-foreground); margin: 0; flex-wrap: wrap; }
  .list-sub strong { font-weight: var(--font-weight-semibold); color: var(--foreground); }
  .list-sub-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--border); display: inline-block; }
  .list-rule { width: 96px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--primary), transparent); margin-top: var(--space-3); }

  .list-filters { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-5); flex-wrap: wrap; }
  .list-search { display: inline-flex; align-items: center; gap: var(--space-2); flex: 1 1 320px; min-width: 240px; padding: 7px var(--space-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-1); }
  .list-search:focus-within { border-color: var(--primary); background: var(--background); }
  .list-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 13.5px; color: var(--foreground); }
  .list-search input::placeholder { color: var(--muted-foreground); }
  .list-pills { display: inline-flex; gap: var(--space-1); flex-wrap: wrap; }
  .list-pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px var(--space-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-full); background: var(--surface-1); color: var(--muted-foreground); font: inherit; font-size: 12.5px; cursor: pointer; transition: color 120ms, background 120ms, border-color 120ms; }
  .list-pill:hover { color: var(--foreground); border-color: var(--border); }
  .list-pill[data-active] { color: var(--primary-foreground); background: var(--primary); border-color: var(--primary); }
  .list-pill-count { font-variant-numeric: tabular-nums; font-size: 10.5px; padding: 1px 6px; border-radius: var(--radius-full); background: color-mix(in oklch, currentColor 18%, transparent); }

  .skills-list { display: flex; flex-direction: column; gap: 1px; }
  .skill { display: grid; grid-template-columns: 44px 1fr auto 16px; gap: var(--space-3); align-items: start; padding: 14px var(--space-3); border-radius: var(--radius-md); text-align: left; color: var(--foreground); cursor: pointer; font: inherit; border-top: 1px solid var(--border-subtle); background: transparent; transition: background 120ms; }
  .skill:first-child { border-top: 0; }
  .skill:hover { background: var(--surface-1); }
  .skill:hover .skill-chev { opacity: 1; transform: translateX(2px); }

  .skill-tile { width: 44px; height: 44px; border-radius: var(--radius-md); display: inline-flex; align-items: center; justify-content: center; color: var(--primary-foreground); font-family: var(--font-mono); font-size: 18px; font-weight: var(--font-weight-bold); letter-spacing: -0.02em; position: relative; isolation: isolate; box-shadow: inset 0 1px 0 color-mix(in oklch, var(--primary-foreground) 22%, transparent), inset 0 -1px 0 color-mix(in oklch, var(--foreground) 8%, transparent), 0 2px 6px color-mix(in oklch, var(--foreground) 14%, transparent); }
  .skill-tile::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(160deg, color-mix(in oklch, var(--primary-foreground) 14%, transparent) 0%, transparent 55%); pointer-events: none; }

  .skill-body { min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .skill-name { font-family: var(--font-mono); font-size: 14px; font-weight: var(--font-weight-semibold); color: var(--foreground); }
  .skill-desc { font-size: 13.5px; color: var(--muted-foreground); line-height: 1.45; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .skill-scope { align-self: start; margin-top: 3px; font-family: var(--font-mono); font-size: 10px; padding: 1px 6px; border-radius: var(--radius-sm); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .skill-scope[data-scope="project"] { background: var(--surface-2); color: var(--muted-foreground); }
  .skill-scope[data-scope="user"] { background: color-mix(in oklch, var(--info) 14%, transparent); color: var(--info); }

  .skill-chev { align-self: center; color: var(--muted-foreground); opacity: 0; transition: opacity 120ms, transform 120ms; }

  .list-skel { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4) 0; }
  .list-group-label { font-size: 11px; font-weight: var(--font-weight-semibold); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-foreground); padding: var(--space-4) var(--space-3) var(--space-2); }
</style>

<div class="list" data-test="skills-list">

  <header class="list-head">
    <div>
      <h1 class="list-title">Skills</h1>
      <p class="list-sub">
        {#if summaries().kind === 'ok'}
          <strong>{counts().all}</strong> skills
          {#if counts().project > 0}
            <span class="list-sub-sep"></span>
            <strong>{counts().project}</strong> project
          {/if}
          {#if counts().user > 0}
            <span class="list-sub-sep"></span>
            <strong>{counts().user}</strong> user
          {/if}
        {:else}
          Skills available to agents in this project.
        {/if}
      </p>
      <div class="list-rule"></div>
    </div>
    <sui-button tone="primary" variant="solid" size="md" data-test="cta-new"
      on:click={() => newSkill()}>
      <sui-icon slot="leading" name="plus" size="xs"></sui-icon>
      New skill
    </sui-button>
  </header>

  <div class="list-filters" data-test="filter">
    <label class="list-search">
      <sui-icon name="search" size="sm" tone="muted"></sui-icon>
      <input type="search" placeholder="Filter skills…" aria-label="Filter skills"
        data-test="search"
        on:input={(e) => onSearch(e)} />
    </label>
    <div class="list-pills" role="tablist">
      <button class="list-pill" type="button" data-test="pill-all"
        attr:data-active={activeKind() === 'all'}
        on:click={() => setKind('all')}>
        All <span class="list-pill-count">{counts().all}</span>
      </button>
      <button class="list-pill" type="button" data-test="pill-project"
        attr:data-active={activeKind() === 'project'}
        on:click={() => setKind('project')}>
        Project <span class="list-pill-count">{counts().project}</span>
      </button>
      <button class="list-pill" type="button" data-test="pill-user"
        attr:data-active={activeKind() === 'user'}
        on:click={() => setKind('user')}>
        User <span class="list-pill-count">{counts().user}</span>
      </button>
    </div>
  </div>

  {#async summaries}
    {:loading}
    <div class="list-skel" role="status" aria-busy="true" aria-label="Loading skills">
      {#for n of [1, 2, 3, 4, 5] key={n}}
        <sui-skeleton shape="line" size="md"></sui-skeleton>
      {/for}
    </div>

    {:error err}
    <sui-error-state variant="inline" size="md" title="Couldn't load skills" role="alert">
      {err.message}
    </sui-error-state>

    {:ok}
    {#if groups().length === 0}
      <sui-empty-state variant="placeholder" size="md" data-test="skills-empty">
        <sui-icon slot="icon" name="zap"></sui-icon>
        <span slot="title">No skills found</span>
        {query() ? 'No skills match.' : 'No skills configured for this project.'}
      </sui-empty-state>
    {:else}
      <div class="skills-list">
        {#for g of groups() key={g.source}}
          {#if groups().length > 1}
            <div class="list-group-label">{g.label}</div>
          {/if}
          {#for skill of g.skills key={skill.id}}
            <button type="button" class="skill" data-test="skill"
              attr:data-skill-id={skill.id}
              on:click={() => open(skill.id)}>
              <span class="skill-tile"
                style:background={skill.color}
                aria-hidden="true">
                {skill.char}
              </span>
              <span class="skill-body">
                <span class="skill-name">{skill.name}</span>
                {#if skill.description}
                  <span class="skill-desc">{skill.description}</span>
                {/if}
              </span>
              <span class="skill-scope" attr:data-scope={skill.scope}>
                {skill.scopeLabel}
              </span>
              <span class="skill-chev" aria-hidden="true">
                <sui-icon name="chevron-right" size="sm"></sui-icon>
              </span>
            </button>
          {/for}
        {/for}
      </div>
    {/if}
  {/async}

</div>
