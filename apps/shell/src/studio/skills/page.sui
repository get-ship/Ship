<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
    <div class="ship-view skills-view">
      <div class="skills-wrap">

        <header class="skills-head">
          <div class="skills-head-titles">
            <h1 class="skills-title">Skills</h1>
            <p class="skills-sub">
              <strong>{items().length}</strong> of {total()}
              <span class="skills-sub-sep" aria-hidden="true"></span>
              capabilities agents can attach
            </p>
            <div class="skills-rule" aria-hidden="true"></div>
          </div>
        </header>

        <div class="skills-filters">
          <div class="skills-search">
            <sui-icon name="search" size="sm" tone="muted"></sui-icon>
            <input type="text" placeholder="Search skills…" aria-label="Search skills"
              spellcheck="false" data-test="search" value={q()} on:input={onSearchInput} />
            {#if q()}
              <button type="button" class="skills-search-clear" aria-label="Clear search" on:click={clearSearch}>
                <sui-icon name="x" size="xs"></sui-icon>
              </button>
            {/if}
          </div>
          <sui-toggle-group variant="segmented" type="single" value={kind()} size="sm" aria-label="Filter by kind"
            on:sui-change={(e) => setKind(e.detail.value)}>
            <sui-toggle value="all">All</sui-toggle>
            <sui-toggle value="smart">Smart</sui-toggle>
            <sui-toggle value="docs">Docs</sui-toggle>
          </sui-toggle-group>
        </div>

        {#if loading()}
          <div class="skills-loading"><sui-spinner size="md" centered></sui-spinner></div>
        {:else if items().length === 0}
          <sui-empty-state icon="search-x" variant="default" size="sm" data-test="empty">
            <span slot="title">No matching skills</span>
            Nothing matches your search.
            <sui-button slot="action" variant="outline" size="sm" on:click={clearSearch}>Clear search</sui-button>
          </sui-empty-state>
        {:else}
          <div class="skills-list" data-test="skills-list">
            {#for s of items() key={s.id}}
              <a class="skill-card" data-test="skill-card"
                attr:data-id={s.id} attr:href={'/studio/skills/' + s.id}>
                <span class="skill-art" attr:data-kind={s.kind} aria-hidden="true">
                  <sui-icon name={s.kind === 'docs' ? 'file-text' : 'sparkles'} size="sm"></sui-icon>
                </span>
                <div class="skill-body">
                  <div class="skill-head">
                    <span class="skill-name">{s.name}</span>
                    <sui-badge tone="muted" variant="outline" size="sm">{s.kind}</sui-badge>
                    <span class="skill-source">{s.source}</span>
                  </div>
                  <p class="skill-desc">{s.description}</p>
                  <div class="skill-meta">
                    <span class="skill-meta-item">
                      <sui-icon name="file" size="xs" tone="muted"></sui-icon>
                      {s.files.length} file{s.files.length === 1 ? '' : 's'}
                    </span>
                    {#if s.has_vars}
                      <span class="skill-meta-item"><sui-icon name="braces" size="xs" tone="muted"></sui-icon> vars</span>
                    {/if}
                    {#for t of s.tags key={t}}
                      <sui-chip tone="muted" variant="soft" size="sm">{t}</sui-chip>
                    {/for}
                  </div>
                </div>
                <sui-icon class="skill-chev" name="chevron-right" size="sm" tone="muted"></sui-icon>
              </a>
            {/for}
          </div>
        {/if}

      </div>
    </div>
  </main>
</div>
