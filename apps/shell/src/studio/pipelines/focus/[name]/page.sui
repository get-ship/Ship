<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
{#async focusCtx}
  {:loading}
  <sui-spinner size="md" centered></sui-spinner>

  {:error err}
  <sui-error-state title="Couldn't load pipeline" data-test="error" role="alert">
    {err.message}
    <sui-button slot="action" tone="primary" variant="solid" on:click={() => window.location.reload()}>Retry</sui-button>
  </sui-error-state>

  {:ok}
{#if def()}
<div class="ship-view ship-view-pipeline-focus">
  <div class="ship-focus-wrap">
    <header class="ship-focus-head">
      <div class="ship-focus-title-block">
        <h1 class="ship-focus-title">
          {#if def().active_runs > 0}<sui-status-dot tone="info" pulse></sui-status-dot>
          {:else if def().last_run_tone}<sui-status-dot attr:tone={def().last_run_tone_safe}></sui-status-dot>
          {:else}<sui-status-dot tone="muted"></sui-status-dot>{/if}
          <span class="ship-focus-name">{name()}</span>
          <sui-chip size="sm">{def().step_count} step{def().step_count !== 1 ? 's' : ''}</sui-chip>
          {#if doc().auto_merge}<sui-chip size="sm" tone="accent">auto-merge</sui-chip>{/if}
          {#if def().active_runs > 0}<sui-badge tone="info">{def().active_runs} running</sui-badge>{/if}
        </h1>
        {#if def().description}<p class="ship-focus-desc">{def().description}</p>{/if}
      </div>
      <div class="ship-focus-actions">
        {#if workspaceId()}
          {#if !editMode()}
          <sui-button variant="outline" on:click={startEdit}>
            <sui-icon slot="leading" name="edit-3" size="sm"></sui-icon>Edit
          </sui-button>
          {/if}
          {#if editMode()}
          <sui-button variant="outline" on:click={cancelEdit}>Cancel</sui-button>
          <sui-button tone="primary" variant="solid" prop:loading={editSaving()} prop:disabled={editSaving()} on:click={savePipeline}>
            <sui-icon slot="leading" name="check" size="sm"></sui-icon>Save
          </sui-button>
          <sui-button variant="outline" tone="destructive" size="sm" on:click={openDelete}>
            <sui-icon slot="leading" name="trash-2" size="sm"></sui-icon>Delete
          </sui-button>
          {/if}
        {/if}
        {#if !editMode()}
        <sui-button tone="primary" variant="solid" on:click={openDispatch}>
          <sui-icon slot="leading" name="play" size="sm"></sui-icon>Dispatch
        </sui-button>
        {/if}
      </div>
    </header>

    {#if opsMode() && activeForPipeline().length > 0}
    <section>
      <h2 class="ship-focus-section-label ship-focus-section-label-spaced">Ops · active now</h2>
      <div class="ship-focus-stack">
        {#for run of activeForPipeline() key={run.slug}}
          <sui-pipeline-run class="ship-live-run" attr:state={run.state_attr} attr:slug={run.slug} attr:agent={run.agent} on:ship-log-tick={(e) => pulseRun(e.currentTarget)}>
            <time slot="actions" datetime={run.updated_at}>{run.updatedLabel}</time>
            <sui-button slot="actions" variant="ghost" size="sm" on:click={() => navigate('/studio/pipelines/run/' + run.slug)}>
              <sui-icon slot="leading" name="chevron-right"></sui-icon>Open
            </sui-button>
            <sui-button slot="actions" variant="outline" size="sm" tone="destructive" on:click={() => stopRun(run.job_id)}>
              <sui-icon slot="leading" name="stop"></sui-icon>Stop
            </sui-button>
            {#if run.steps && run.steps.length > 0}
            <sui-pipeline-dag>
              {#for step of run.steps key={step.id}}
                <sui-pipeline-step attr:name={step.id} attr:state={step.state} attr:step-type={step.step_type} attr:agent={step.agent}></sui-pipeline-step>
                {#if !step.isLast}<span class="arrow" aria-hidden="true">→</span>{/if}
              {/for}
            </sui-pipeline-dag>
            {/if}
            <sui-log-stream slot="footer" attr:url={'/api/v1/pipelines/runs/' + run.slug + '/log/stream'} active autoscroll></sui-log-stream>
          </sui-pipeline-run>
        {/for}
      </div>
    </section>
    {/if}

    <section>
      <h2 class="ship-focus-section-label ship-focus-section-label-spaced">{opsMode() ? 'Overview' : 'Stats'}</h2>
      <div class="ship-focus-stats">
        <div class="ship-focus-stat">
          <span class="ship-focus-stat-label">Total runs</span>
          <span class="ship-focus-stat-value">{def().total_runs ?? 0}</span>
        </div>
        <div class="ship-focus-stat" attr:data-accent={def().success_accent}>
          <span class="ship-focus-stat-label">Success rate</span>
          <span class="ship-focus-stat-value">{def().success_pct}%</span>
        </div>
        <div class="ship-focus-stat" attr:data-accent={def().active_accent}>
          <span class="ship-focus-stat-label">Active now</span>
          <span class="ship-focus-stat-value">{def().active_runs ?? 0}</span>
        </div>
        <div class="ship-focus-stat">
          <span class="ship-focus-stat-label">Last run</span>
          <span class="ship-focus-stat-value-row">
            {#if def().last_run_at}
              <time datetime={def().last_run_at}>{relLastRun()}</time>
              {#if def().last_run_status}<sui-badge size="sm" attr:tone={def().last_run_tone_safe}>{def().last_run_status}</sui-badge>{/if}
            {:else}—{/if}
          </span>
        </div>
      </div>
    </section>

    {#if editMode()}
    <sui-card>
      <div slot="header" class="ship-focus-header-row">
        <h3 class="ship-focus-section-label">Edit {format()}</h3>
        <div class="ship-focus-editing">
          <span class="ship-focus-kbd-hint"><kbd class="ship-focus-kbd">⌘S</kbd> save · <kbd class="ship-focus-kbd">Esc</kbd> cancel</span>
          <sui-chip size="sm" tone="info">editing</sui-chip>
        </div>
      </div>
      {#if editError()}
      <sui-alert tone="destructive" compact>
        <sui-icon slot="leading" name="triangle-alert" size="sm"></sui-icon>
        {editError()}{editErrorLine() > 0 ? ' at line ' + editErrorLine() + ':' + editErrorCol() : ''}
        {#if editIssueCount() > 1}<span slot="actions">+{editIssueCount() - 1} more — see inline markers</span>{/if}
      </sui-alert>
      {/if}
      <ship-code-editor id="pipeline-editor" bind:this={editorRef}
        attr:language={format() === 'jsonc' ? 'jsonc' : format() === 'json' ? 'json' : 'yaml'}
        attr:value={raw()} on:ship-save={savePipeline} on:ship-cancel={cancelEdit}
        class="ship-focus-editor"></ship-code-editor>
    </sui-card>
    {/if}

    {#if !editMode()}
    <sui-card>
      <h3 slot="header" class="ship-focus-section-label">Steps</h3>
      {#if doc().steps && doc().steps.length > 0}
        <div class="ship-focus-steps">
        {#for step of doc().steps key={step.id}}
          <div class="ship-focus-step">
            <div class="ship-focus-step-head">
              <span class="ship-focus-step-index">{step.index}</span>
              <span class="ship-focus-step-name">{step.id}</span>
              <sui-chip size="sm">{step.step_type}</sui-chip>
              {#if step.agent}<sui-chip size="sm" tone="accent">{step.agent}</sui-chip>{/if}
              {#if step.model}<sui-chip size="sm" tone="info">{step.model}</sui-chip>{/if}
              {#if step.after_joined}<sui-chip size="sm" tone="muted">after: {step.after_joined}</sui-chip>{/if}
            </div>
            {#if step.run}<code class="ship-focus-step-cmd">{step.run}</code>{/if}
            {#if step.gate}
            <div class="ship-focus-step-gate">
              {#if step.gate.require_changed}<sui-chip size="sm" tone="info">require{step.gate.require_changed.match ? ' ' + step.gate.require_changed.match : ''}{step.gate.require_changed.min !== undefined ? ' ≥ ' + step.gate.require_changed.min : ''}</sui-chip>{/if}
              {#if step.gate.forbid_changed}<sui-chip size="sm" tone="warning">forbid{step.gate.forbid_changed.match ? ' ' + step.gate.forbid_changed.match : ''}{step.gate.forbid_changed.min !== undefined ? ' > ' + step.gate.forbid_changed.min : ''}</sui-chip>{/if}
            </div>
            {/if}
          </div>
        {/for}
        </div>
      {:else}
        <sui-empty-state icon="list" heading="No steps" description="This pipeline file doesn't declare any steps."></sui-empty-state>
      {/if}
    </sui-card>
    {/if}

    {#if runs().length > 0}
    <sui-card>
      <h3 slot="header" class="ship-focus-section-label">{opsMode() ? 'Recent runs (history)' : 'Recent runs'}</h3>
      <div class="ship-focus-stack">
        {#for run of runs() key={run.slug}}
          {#if !opsMode() || (run.state !== 'dispatched' && run.state !== 'pending' && run.state !== 'gate-pending')}
          <sui-pipeline-run attr:state={run.state_attr} attr:slug={run.slug} attr:agent={run.agent}>
            <time slot="actions" datetime={run.updated_at}>{run.updatedLabel}</time>
            <sui-button slot="actions" variant="ghost" size="sm" on:click={() => navigate('/studio/pipelines/run/' + run.slug)}>
              <sui-icon slot="leading" name="chevron-right"></sui-icon>Open
            </sui-button>
            {#if run.error}
            <sui-collapsible>
              <sui-alert slot="trigger" tone="destructive" compact>Error (expand for details)</sui-alert>
              <sui-code language="text">{run.error}</sui-code>
            </sui-collapsible>
            {/if}
            {#if run.steps && run.steps.length > 0}
            <sui-pipeline-dag>
              {#for step of run.steps key={step.id}}
                <sui-pipeline-step attr:name={step.id} attr:state={step.state} attr:step-type={step.step_type} attr:agent={step.agent}></sui-pipeline-step>
                {#if !step.isLast}<span class="arrow" aria-hidden="true">→</span>{/if}
              {/for}
            </sui-pipeline-dag>
            {/if}
          </sui-pipeline-run>
          {/if}
        {/for}
      </div>
    </sui-card>
    {/if}
  </div>

  <sui-dialog prop:open={dispatchOpen()} size="lg" on:sui-close={closeDispatch}>
    <span slot="header">Dispatch {name()}</span>
    <sui-field label="Spec" hint="Plain text or markdown — what the run should do.">
      <sui-textarea bind:value={dispatchSpec} rows="10" placeholder="Describe the work in one or two paragraphs..."></sui-textarea>
    </sui-field>
    <sui-field label="Provider override" hint="Optional — leave blank to use the pipeline's declared providers.">
      <sui-select bind:value={dispatchProvider}>
        <option value="">(from pipeline)</option>
        {#for p of providers() key={p}}<option attr:value={p}>{p}</option>{/for}
      </sui-select>
    </sui-field>
    <sui-field><sui-checkbox bind:checked={dispatchHeadless}>Headless (run without tmux)</sui-checkbox></sui-field>
    <div class="toolbar toolbar--footer" slot="footer">
      <sui-button variant="outline" on:click={closeDispatch}>Cancel</sui-button>
      <sui-button tone="primary" variant="solid" on:click={dispatchRun}>
        <sui-icon slot="leading" name="play" size="sm"></sui-icon>Dispatch
      </sui-button>
    </div>
  </sui-dialog>

  {#if workspaceId()}
  <sui-alert-dialog prop:open={deleteOpen()} tone="destructive" confirm-label="Delete pipeline" cancel-label="Keep it" on:sui-confirm={deletePipeline} on:sui-cancel={closeDelete}>
    <span slot="title">Delete <code>{name()}</code>?</span>
    <p class="ship-focus-delete-note">This removes the pipeline file from <code>.ship/pipelines/</code>. Any runs already in flight keep going — only the definition is deleted.</p>
  </sui-alert-dialog>
  {/if}
</div>
{/if}
{/async}
  </main>
</div>
