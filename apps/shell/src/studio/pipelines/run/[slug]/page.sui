<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
{#async runCtx}
  {:loading}
  <sui-spinner size="md" centered></sui-spinner>

  {:error err}
  <sui-error-state title="Couldn't load run" data-test="error" role="alert">
    {err.message}
    <sui-button slot="action" tone="primary" variant="solid" on:click={() => window.location.reload()}>Retry</sui-button>
  </sui-error-state>

  {:ok}
{#if run().slug}
<div class="ship-view ship-view-run-detail">
  <div class="ship-run-detail-wrap">
    <div class="ship-run-detail-head">
      <div>
        <div class="ship-run-detail-title-row">
          <span class="ship-run-detail-slug">{run().slug}</span>
          <sui-badge attr:tone={run().tone}>{run().status_text}</sui-badge>
        </div>
        <div class="ship-run-detail-meta">
          {#if run().agent}<code>{run().agent}</code>{/if}
          {#if run().branch}<span>{run().branch}</span>{/if}
          {#if run().provider}<span>{run().provider}</span>{/if}
          {#if run().model}<span>{run().model}</span>{/if}
          <sui-timestamp attr:value={run().updated_at} relative></sui-timestamp>
        </div>
      </div>
      {#if run().state === 'dispatched' || run().state === 'pending'}
      <div class="ship-run-detail-actions">
        <sui-button variant="outline" size="sm" tone="destructive" on:click={() => stopRun(run().job_id)}>
          <sui-icon slot="leading" name="stop"></sui-icon>Stop
        </sui-button>
      </div>
      {/if}
    </div>

    {#if run().error}
      {#if errorMultiline()}
      <sui-collapsible>
        <sui-alert slot="trigger" tone="destructive" compact>Error: {errorFirstLine()}</sui-alert>
        <sui-code language="text">{run().error}</sui-code>
      </sui-collapsible>
      {:else}
      <sui-alert tone="destructive" compact>Error: {run().error}</sui-alert>
      {/if}
    {/if}

    {#if steps().length > 0}
    <sui-card>
      <h3 slot="header" class="ship-run-detail-section-title">Pipeline</h3>
      <sui-pipeline-dag>
        {#for step of steps() key={step.id}}
          <sui-pipeline-step attr:name={step.id} attr:state={step.state} attr:step-type={step.step_type} attr:agent={step.agent}></sui-pipeline-step>
          {#if !step.isLast}<span class="arrow" aria-hidden="true">→</span>{/if}
        {/for}
      </sui-pipeline-dag>
    </sui-card>
    {/if}

    {#if observations().length > 0}
    <sui-card>
      <h3 slot="header" class="ship-run-detail-section-title">Step observations</h3>
      {#for obs of observations() key={obs.step_name}}
      <div class="ship-obs-row">
        <span class="ship-obs-name">{obs.step_name}</span>
        <div class="ship-obs-meta">
          <span>{obs.trigger}</span>
          <span>{obs.duration_secs}s</span>
          {#if obs.exit_code !== undefined && obs.exit_code !== null}<span>exit {obs.exit_code}</span>{/if}
          {#if obs.commits > 0}<span>{obs.commits} commit{obs.commits !== 1 ? 's' : ''}</span>{/if}
          {#if obs.done_declared}<sui-badge size="sm" tone="success">step_done</sui-badge>{/if}
        </div>
        <sui-badge attr:tone={obs.succeeded ? 'success' : obs.verdict === 'Block' ? 'destructive' : 'muted'}>{obs.verdict}</sui-badge>
        <span></span>
      </div>
      {#if obs.log_tail}
      <sui-collapsible>
        <span slot="trigger" class="ship-obs-meta ship-obs-log-trigger">log tail</span>
        <sui-code language="text">{obs.log_tail}</sui-code>
      </sui-collapsible>
      {/if}
      {/for}
    </sui-card>
    {/if}

    <sui-card>
      <h3 slot="header" class="ship-run-detail-section-title">Live log</h3>
      <sui-log-stream attr:url={'/api/v1/pipelines/runs/' + run().slug + '/log/stream'} autoscroll active></sui-log-stream>
    </sui-card>

    {#if timeline().length > 0}
    <sui-card>
      <h3 slot="header" class="ship-run-detail-section-title">Event timeline</h3>
      <div class="ship-timeline-scroll">
        <sui-timeline>
          {#for ev of timeline() key={ev.at + ev.event_type}}
          <sui-timeline-item>
            <span slot="timestamp"><sui-timestamp attr:value={ev.at} relative></sui-timestamp></span>
            <span slot="title">{ev.event_type}</span>
            <span>{ev.summary}</span>
          </sui-timeline-item>
          {/for}
        </sui-timeline>
      </div>
    </sui-card>
    {/if}
  </div>
</div>
{/if}
{/async}
  </main>
</div>
