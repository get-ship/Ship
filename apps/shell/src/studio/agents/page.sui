<data name="agents" source="ship.agents.summaries()" live />

<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
<div class="ship-view agents-view">
  <div class="agents-wrap">

    <header class="agents-head">
      <div class="agents-head-titles">
        <h1 class="agents-title">Agents</h1>
        <p class="agents-sub">
          <strong>{items().length}</strong> agent{items().length === 1 ? '' : 's'}
          <span class="agents-sub-sep" aria-hidden="true"></span>
          <strong>{kindFilters()[1].count}</strong> project
          <span class="agents-sub-sep" aria-hidden="true"></span>
          <strong>{kindFilters()[2].count}</strong> library
          <span class="agents-sub-sep" aria-hidden="true"></span>
          <code class="agents-sub-code">.ship/agents/</code>
          {#if activeId()}
            <span class="agents-sub-sep" aria-hidden="true"></span>
            <span class="agents-sub-active" data-test="active-summary">active: {activeId()}</span>
          {/if}
        </p>
        <div class="agents-rule" aria-hidden="true"></div>
      </div>
      <sui-button tone="primary" variant="solid" on:click={goCreate} data-test="cta-new">
        <sui-icon slot="leading" name="plus"></sui-icon>
        New agent
      </sui-button>
    </header>

    <div class="agents-filters">
      <div class="agents-search">
        <sui-icon name="search" size="sm" tone="muted"></sui-icon>
        <input type="text" placeholder="Search by name, description, or tag…"
          aria-label="Search agents"
          spellcheck="false"
          data-test="search"
          value={q()}
          on:input={onSearchInput} />
        {#if q()}
          <button type="button" class="agents-search-clear" aria-label="Clear search"
            on:click={clearSearch}>
            <sui-icon name="x" size="xs"></sui-icon>
          </button>
        {/if}
      </div>
      <sui-segmented value={kind()} size="sm" aria-label="Filter by source"
        on:sui-change={(e) => kind.set(e.detail.value)}>
        {#for f of kindFilters() key={f.id}}
          <sui-segmented-option attr:value={f.id} data-test="filter" attr:data-filter={f.id}>
            {f.label}
          </sui-segmented-option>
        {/for}
      </sui-segmented>
    </div>

    {#async agents}
      {:loading}
      <div class="agents-grid" data-test="loading" role="status" aria-live="polite" aria-busy="true" aria-label="Loading agents">
        {#for n of [0,1,2,3,4,5] key={n}}
          <div class="agents-skel-card" aria-hidden="true">
            <sui-skeleton shape="block" size="md" class="agents-skel-icon"></sui-skeleton>
            <div class="agents-skel-body">
              <sui-skeleton shape="line" size="md" style="width:70%"></sui-skeleton>
              <sui-skeleton shape="line" size="sm" style="width:95%"></sui-skeleton>
              <sui-skeleton shape="line" size="sm" style="width:55%"></sui-skeleton>
            </div>
          </div>
        {/for}
      </div>
    
      {:error err}
      <sui-error-state title="Couldn't load agents" data-test="error" role="alert" aria-live="assertive">
        {err.message}
        <sui-button slot="action" tone="primary" variant="solid" on:click={() => window.location.reload()}>Retry</sui-button>
      </sui-error-state>
    
      {:ok}
      {#if items().length === 0}
        <sui-empty-state icon="sparkles" variant="default" size="sm" data-test="empty" role="status">
          <span slot="title">No agents yet</span>
          Drop a JSONC file under
          <code class="agents-empty-code">.ship/agents/</code>
          or create one from the Studio.
          <sui-button slot="action" tone="primary" variant="solid" on:click={goCreate} data-test="cta-create-first">
            <sui-icon slot="leading" name="plus"></sui-icon>
            Create your first agent
          </sui-button>
        </sui-empty-state>
      {:else if filteredItems().length === 0}
        <sui-empty-state icon="search-x" variant="default" size="sm" data-test="empty-filtered" role="status">
          <span slot="title">No matching agents</span>
          {q() ? 'Nothing matches "' + q() + '"' : 'No agents in this scope.'}
          <sui-button slot="action" variant="outline" size="sm" on:click={resetFilters}>
            Clear filters
          </sui-button>
        </sui-empty-state>
      {:else}
        <div class="agents-grid" data-view-enter data-test="grid">
          {#for a of filteredItems() key={a.id}}
            <a href={'/studio/agents/' + a.id}
                class="list-tile agents-card-tile"
                style="background:var(--card);border-color:var(--border-subtle);box-shadow:var(--shadow-card-rest);display:flex;flex-direction:column;min-height:100%;cursor:pointer;text-decoration:none;color:inherit"
                data-test="agent"
                attr:data-id={a.id}
                attr:data-active={a.active}>
              <div class={'agents-card-icon-tile hue-' + a.hue} aria-hidden="true" data-test="hue-tile">
                <span class="agents-card-letter">{a.letter}</span>
              </div>
              <div class="agents-card-body">
                <div class="agents-card-head">
                  <div class="agents-card-title">{a.name}</div>
                  <p class="agents-card-desc">{a.description || 'No description'}</p>
                </div>
                <div class="agents-card-stats">
                  <span>{a.skills_count} skill{a.skills_count === 1 ? '' : 's'}</span>
                  <span class="agents-card-sep">&middot;</span>
                  <span>{a.mcp_count} MCP</span>
                  <span class="agents-card-sep">&middot;</span>
                  <span>{a.rules_count} rule{a.rules_count === 1 ? '' : 's'}</span>
                </div>
                <div class="agents-card-badges">
                  <sui-badge tone="muted" variant="outline" size="sm" class="agents-card-badge-source">{a.source}</sui-badge>
                  {#if a.active}
                    <sui-chip tone="success" variant="soft" size="sm" data-test="active-chip">
                      <sui-status-dot slot="leading" tone="success" size="sm" pulse label="Active"></sui-status-dot>
                      active
                    </sui-chip>
                  {/if}
                  {#if agentStatus()[a.id]}
                    <sui-chip
                        tone={agentStatus()[a.id] === 'errored' ? 'destructive' : agentStatus()[a.id] === 'completed' ? 'success' : 'primary'}
                        variant="soft"
                        size="sm"
                        data-test="live-status"
                        attr:data-status={agentStatus()[a.id]}>
                      <sui-status-dot
                          slot="leading"
                          tone={agentStatus()[a.id] === 'errored' ? 'destructive' : agentStatus()[a.id] === 'completed' ? 'success' : 'primary'}
                          size="sm"
                          prop:pulse={agentStatus()[a.id] === 'running'}
                          label={agentStatus()[a.id]}></sui-status-dot>
                      {agentStatus()[a.id]}
                    </sui-chip>
                  {/if}
                  {#for t of (a.tags || []).slice(0, 2) key={t}}
                    <sui-chip tone="muted" variant="soft" size="sm">{t}</sui-chip>
                  {/for}
                  {#if (a.tags || []).length > 2}
                    <sui-chip tone="muted" variant="outline" size="sm">+{(a.tags || []).length - 2}</sui-chip>
                  {/if}
                </div>
              </div>
            </a>
          {/for}
        </div>
      {/if}
    
    {/async}

  </div>
</div>
  </main>
</div>
