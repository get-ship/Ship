<!--
  <sui-studio-components> — the Components Studio section element.

  Registered as the section keystone: studio/page.sui's content slot
  renders this element when section() === 'components'. It reads the URL
  and routes between the grouped catalog index (`/studio/components`) and
  the per-component storybook (`/studio/components/<tag>`). Both child
  surfaces are registered via side-effect imports in the controller.

  Mirrors the themes-section shape (sui-studio-themes), which is the
  established pattern studio-surface laid down for section content.
-->

<style>
  :host { display: block; min-height: 100%; }
</style>

<div class="studio-components-root" data-test="studio-components">
  {#if detailTag()}
    <sui-component-detail data-test="component-detail-host"></sui-component-detail>
  {:else}
    <sui-components-list data-test="components-list-host"></sui-components-list>
  {/if}
</div>
