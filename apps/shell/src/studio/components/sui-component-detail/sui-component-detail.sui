<!--
  <sui-component-detail> — the per-component storybook. Mirrors
  .artifacts/studio-design/component-detail.html: head, variant×tone
  matrix (live themed primitives, not screenshots), knobs playground with
  live render + copy-able snippet, props table, slots, source path.

  The matrix cells and the playground's single live node are rendered
  imperatively (createElement) by the controller's effects into the
  `data-cmp-stage` / `[data-matrix-cell]` hosts below — see
  sui-component-detail.controller.ts and render.ts.
-->

<style>
  :host { display: block; }
  .detail { max-width: 1100px; margin: 0 auto; padding: var(--space-2) 0 64px; }

  .back { display: inline-flex; align-items: center; gap: var(--space-1); font-size: 12.5px; color: var(--muted-foreground); background: 0; border: 0; cursor: pointer; font-family: inherit; margin-bottom: var(--space-5); padding: 0; }
  .back:hover { color: var(--foreground); }

  .head { display: grid; grid-template-columns: 64px 1fr auto; gap: var(--space-4); align-items: start; margin-bottom: var(--space-5); }
  .glyph { width: 64px; height: 64px; border-radius: var(--radius-lg); display: inline-flex; align-items: center; justify-content: center; background: color-mix(in oklch, var(--primary) 14%, transparent); color: var(--primary); font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: var(--font-weight-bold); }
  .name { font-family: var(--heading-font); font-size: var(--text-3xl); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); line-height: 1.05; margin: 0 0 6px; font-family: var(--font-mono); }
  .meta { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-base); color: var(--muted-foreground); flex-wrap: wrap; }
  .meta code { font-family: var(--font-mono); font-size: 11.5px; padding: 1px 6px; background: var(--muted); border-radius: var(--radius-sm); color: var(--foreground); }
  .meta-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--border); display: inline-block; }
  .rule { width: 96px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--primary), transparent); margin-top: var(--space-3); }
  .prose { font-size: 15px; line-height: 1.6; color: color-mix(in oklch, var(--foreground) 85%, transparent); margin: 0 0 var(--space-6); max-width: 64ch; }

  .sec { padding-top: var(--space-5); margin-bottom: var(--space-5); border-top: 1px solid var(--border-subtle); }
  .sec-head { display: flex; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-3); }
  .sec-h { font-size: 11px; font-weight: var(--font-weight-semibold); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-foreground); margin: 0; }
  .sec-h-count { font-family: var(--font-mono); font-weight: normal; letter-spacing: 0; font-size: 11px; text-transform: none; }

  .stage { padding: var(--space-5); background: var(--surface-1); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); display: grid; gap: var(--space-3); }
  .matrix-row { display: grid; grid-template-columns: 96px 1fr; gap: var(--space-3); align-items: start; }
  .matrix-row-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-foreground); padding-top: var(--space-2); }
  .matrix-cells { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .matrix-cell { display: inline-flex; flex-direction: column; align-items: center; gap: var(--space-1); }
  .matrix-cell[data-active-cell] .matrix-cell-host { outline: 2px solid var(--primary); outline-offset: 3px; border-radius: var(--radius-sm); }
  .matrix-cell-label { font-family: var(--font-mono); font-size: 9.5px; color: var(--muted-foreground); }

  .knobs { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-3); padding: var(--space-4); background: var(--surface-1); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: var(--space-3); }
  .knob { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .knob-label { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-foreground); }
  .knob input[type="text"] { font-family: var(--font-mono); font-size: var(--text-sm); padding: 6px var(--space-2); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--background); color: var(--foreground); }

  .live-stage { padding: var(--space-6); background: var(--background); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; min-height: 96px; }
  .play-foot { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2); }
  .code-output { flex: 1; font-family: var(--font-mono); font-size: 12.5px; background: var(--muted); padding: 10px 14px; border-radius: var(--radius-md); color: var(--foreground); white-space: pre-wrap; word-break: break-word; margin: 0; }

  .props { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .props thead th { text-align: left; font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted-foreground); padding: 6px 10px; border-bottom: 1px solid var(--border-subtle); font-weight: var(--font-weight-semibold); }
  .props tbody td { padding: var(--space-2) 10px; border-bottom: 1px solid var(--border-subtle); vertical-align: top; }
  .props tbody tr:last-child td { border-bottom: 0; }
  .props code { font-family: var(--font-mono); font-size: 11.5px; padding: 1px 5px; background: var(--surface-1); border-radius: var(--radius-sm); color: var(--foreground); }
  .props-desc { color: var(--muted-foreground); }

  .slots { display: flex; flex-direction: column; gap: var(--space-1); font-family: var(--font-mono); font-size: 12.5px; }
  .slot { display: flex; align-items: baseline; gap: var(--space-2); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); }
  .slot-name { color: var(--primary); }
  .slot-desc { color: var(--muted-foreground); font-family: var(--font-body); font-size: var(--text-sm); }
  .note { font-size: 12.5px; color: var(--muted-foreground); }
  .source { font-family: var(--font-mono); font-size: var(--text-base); color: var(--foreground); background: var(--muted); padding: 10px 14px; border-radius: var(--radius-md); }
  .state { padding: var(--space-7) 0; text-align: center; color: var(--muted-foreground); }
</style>

<div class="detail" data-test="component-detail">
  <button type="button" class="back" data-test="detail-back" on:click={() => back()}>
    <sui-icon name="chevron-left" size="xs"></sui-icon> Components
  </button>

  {#if loading()}
    <div class="state"><sui-spinner size="md"></sui-spinner></div>
  {:else if entry()}
    <header class="head">
      <span class="glyph" aria-hidden="true">&lt;/&gt;</span>
      <div>
        <h1 class="name" data-test="detail-name">{entry().tag}</h1>
        <div class="meta">
          <code>{entry().category}</code>
          <span class="meta-sep"></span>
          <span>{entry().props.length} props · {entry().slots.length} slots</span>
          <span class="meta-sep"></span>
          <span>{entry().package}</span>
        </div>
        <div class="rule"></div>
      </div>
      <div></div>
    </header>

    {#if entry().description}
      <p class="prose">{entry().description}</p>
    {/if}

    {#if matrixCells().length > 0}
      <section class="sec" data-test="matrix-section">
        <div class="sec-head">
          <h2 class="sec-h">Matrix <span class="sec-h-count">· {matrixAxesLabel()}</span></h2>
        </div>
        <div class="stage" data-test="matrix-stage" bind:this={matrixEl}>
          <div class="matrix-row">
            <span class="matrix-row-label">{matrixAxesLabel()}</span>
            <div class="matrix-cells">
              {#for cell of matrixCells() key={cell.id}}
                <div class="matrix-cell" data-test="matrix-cell" attr:data-label={cell.label}>
                  <div class="matrix-cell-host" attr:data-matrix-tag={entry().tag}
                    attr:data-matrix-cell={cell.id} attr:data-props={cell.propsJson}></div>
                  <span class="matrix-cell-label">{cell.label}</span>
                </div>
              {/for}
            </div>
          </div>
        </div>
      </section>
    {/if}

    <section class="sec" data-test="playground">
      <div class="sec-head"><h2 class="sec-h">Playground</h2></div>
      {#if knobs().length > 0}
        <div class="knobs">
          {#for knob of knobs() key={knob.name}}
            <div class="knob" data-test="knob" attr:data-knob={knob.name}>
              <span class="knob-label">{knob.name}</span>
              {#if knob.kind === 'enum'}
                <sui-segmented size="sm" value={(propValues()[knob.name] ?? '') + ''}
                  on:sui-change={(e) => setProp(knob.name, e.detail.value)}>
                  {#for opt of knob.values key={opt}}
                    <sui-segmented-option value={opt}>{opt}</sui-segmented-option>
                  {/for}
                </sui-segmented>
              {:else if knob.kind === 'bool'}
                <sui-switch size="sm"
                  checked={propValues()[knob.name] === 'true' || propValues()[knob.name] === true}
                  on:sui-change={(e) => setProp(knob.name, e.detail.checked ? 'true' : 'false')}></sui-switch>
              {:else}
                <input type="text" value={(propValues()[knob.name] ?? '') + ''}
                  placeholder={knob.placeholder}
                  on:input={(e) => setProp(knob.name, e.target.value)} />
              {/if}
            </div>
          {/for}
        </div>
      {/if}
      <div class="live-stage" data-cmp-stage data-test="live-stage" bind:this={stageEl}></div>
      <div class="play-foot">
        <pre class="code-output" data-test="code-snippet">{snippet()}</pre>
        <sui-button variant="outline" size="sm" data-test="copy-code" on:click={() => copyCode()}>
          {copyLabel()}
        </sui-button>
        <sui-button variant="ghost" size="sm" data-test="reset-knobs" on:click={() => resetKnobs()}>
          Reset
        </sui-button>
      </div>
    </section>

    <section class="sec" data-test="props-section">
      <div class="sec-head"><h2 class="sec-h">Props <span class="sec-h-count">· {entry().props.length}</span></h2></div>
      {#if entry().props.length > 0}
        <table class="props">
          <thead><tr><th>name</th><th>type</th><th>default</th><th>description</th></tr></thead>
          <tbody>
            {#for prop of entry().props key={prop.name}}
              <tr data-test="prop-row">
                <td><code>{prop.name}</code></td>
                <td><code>{prop.type}</code></td>
                <td><code>{prop.default ?? '—'}</code></td>
                <td class="props-desc">{prop.description ?? ''}</td>
              </tr>
            {/for}
          </tbody>
        </table>
      {:else}
        <p class="note">No props.</p>
      {/if}
    </section>

    <section class="sec" data-test="slots-section">
      <div class="sec-head"><h2 class="sec-h">Slots <span class="sec-h-count">· {entry().slots.length}</span></h2></div>
      {#if entry().slots.length > 0}
        <div class="slots">
          {#for slot of entry().slots key={slot.name}}
            <div class="slot">
              <span class="slot-name">{slot.name === '' ? '(default)' : 'slot="' + slot.name + '"'}</span>
              <span class="slot-desc">{slot.description ?? ''}</span>
            </div>
          {/for}
        </div>
      {:else}
        <p class="note">No slots documented in the catalog.</p>
      {/if}
    </section>

    <section class="sec" data-test="source-section">
      <div class="sec-head"><h2 class="sec-h">Source</h2></div>
      <div class="source" data-test="source-path">{entry().sourcePath ?? 'source path unavailable'}</div>
    </section>
  {:else}
    <div class="state" data-test="detail-not-found">Component <code>{currentTag()}</code> not found.</div>
  {/if}
</div>
