<!--
  <sui-components-list> — grouped catalog index for the Components Studio
  section. Mirrors .artifacts/studio-design/components-list.html: a quiet
  "manual page" — category headers over scannable rows, minimal chrome
  (hover state only, no per-row card). Rows link to the per-component
  storybook at /studio/components/<tag>.
-->

<style>
  :host { display: block; }
  .list { max-width: 1024px; margin: 0 auto; padding: 8px 0 64px; }

  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-7); }
  .title { font-family: var(--heading-font); font-size: var(--text-3xl); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); line-height: 1.05; margin: 0 0 var(--space-2); }
  .sub { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--muted-foreground); margin: 0; flex-wrap: wrap; }
  .sub strong { font-weight: var(--font-weight-semibold); color: var(--foreground); }
  .sub-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--border); display: inline-block; }
  .rule { width: 96px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--primary), transparent); margin-top: var(--space-3); }

  .filters { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-5); flex-wrap: wrap; }
  .search { display: inline-flex; align-items: center; gap: 8px; flex: 1 1 320px; min-width: 240px; padding: 7px var(--space-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-1); }
  .search:focus-within { border-color: var(--primary); background: var(--background); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 13.5px; color: var(--foreground); }
  .pills { display: inline-flex; gap: 4px; flex-wrap: wrap; }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-full); background: var(--surface-1); color: var(--muted-foreground); font: inherit; font-size: 12.5px; cursor: pointer; }
  .pill:hover { color: var(--foreground); border-color: var(--border); }
  .pill[data-active] { color: var(--primary-foreground); background: var(--primary); border-color: var(--primary); }
  .pill-count { font-variant-numeric: tabular-nums; font-size: 10.5px; padding: 1px 6px; border-radius: var(--radius-full); background: color-mix(in oklch, currentColor 18%, transparent); }

  .groups { display: flex; flex-direction: column; gap: var(--space-7); }
  .group-h { display: flex; align-items: baseline; gap: 8px; font-size: 11px; font-weight: var(--font-weight-semibold); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-foreground); padding-bottom: var(--space-2); border-bottom: 1px solid var(--border-subtle); margin-bottom: var(--space-3); }
  .group-h-count { font-family: var(--font-mono); font-weight: normal; letter-spacing: 0; text-transform: none; font-size: 11px; }
  .group-h-desc { margin-left: auto; font-size: 12px; text-transform: none; letter-spacing: 0; font-weight: normal; color: var(--muted-foreground); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 2px; }
  .cell { display: flex; align-items: baseline; gap: 8px; padding: 6px 10px; border-radius: var(--radius-sm); text-decoration: none; color: var(--foreground); cursor: pointer; transition: background 120ms; text-align: left; border: 0; background: transparent; font: inherit; width: 100%; }
  .cell:hover { background: var(--surface-1); }
  .cell-tag { font-family: var(--font-mono); font-size: 12.5px; color: var(--foreground); white-space: nowrap; }
  .cell-tag::before { content: '<'; color: var(--muted-foreground); }
  .cell-tag::after { content: '>'; color: var(--muted-foreground); }
  .cell-desc { font-size: 11.5px; color: var(--muted-foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }

  .state { padding: var(--space-7) 0; text-align: center; color: var(--muted-foreground); }
</style>

<div class="list" data-test="components-list">
  <header class="head">
    <div>
      <h1 class="title">Components</h1>
      <p class="sub">
        <strong>{totalCount()}</strong> components
        <span class="sub-sep"></span>
        Built-in primitives. Click for variants, props, and source.
      </p>
      <div class="rule"></div>
    </div>
  </header>

  <div class="filters">
    <label class="search">
      <sui-icon name="search" size="sm" tone="muted"></sui-icon>
      <input
        type="search"
        placeholder="Filter by tag or description…"
        value={query()}
        on:input={(e) => onSearch(e)}
        autocomplete="off"
        data-test="components-search"
      />
    </label>
    <div class="pills">
      {#for pill of pills() key={pill.id}}
        <button
          type="button"
          class="pill"
          data-test="package-pill"
          attr:data-active={pkg() === pill.id ? '' : null}
          on:click={() => setPkg(pill.id)}
        >{pill.label} <span class="pill-count">{pill.count}</span></button>
      {/for}
    </div>
  </div>

  {#if loading()}
    <div class="state" data-test="components-loading">
      <sui-spinner size="md"></sui-spinner>
    </div>
  {:else if groups().length === 0}
    <div class="state" data-test="components-empty">No components match.</div>
  {:else}
    <div class="groups">
      {#for group of groups() key={group.id}}
        <section data-test="component-group" attr:data-group={group.id}>
          <div class="group-h">
            {group.label} <span class="group-h-count">· {group.items.length}</span>
            <span class="group-h-desc">{group.blurb}</span>
          </div>
          <div class="grid">
            {#for item of group.items key={item.tag}}
              <button
                type="button"
                class="cell"
                data-test="component-row"
                on:click={() => open(item.tag)}
              >
                <span class="cell-tag">{item.tag}</span>
                <span class="cell-desc">{item.description}</span>
              </button>
            {/for}
          </div>
        </section>
      {/for}
    </div>
  {/if}
</div>
