<!--
  <sui-theme-detail> — token editor + live preview for one pack.
  Mirrors .artifacts/studio-design/theme-detail.html. Left: categorized
  token editor with per-row override dots. Right: a live preview frame
  built from real <sui-*> primitives; the resolved theme is applied as
  inline custom properties (see controller) so edits update it live.
-->

<style>
  :host { display: block; }
  .detail { max-width: 1280px; margin: 0 auto; padding: var(--space-2) 0 64px; }

  .back { display: inline-flex; align-items: center; gap: var(--space-1); font: inherit; font-size: 12.5px; color: var(--muted-foreground); background: none; border: 0; cursor: pointer; padding: 0; margin-bottom: var(--space-5); }
  .back:hover { color: var(--foreground); }

  .head { display: grid; grid-template-columns: 80px 1fr auto; gap: var(--space-5); align-items: start; margin-bottom: var(--space-6); }
  .tile-swatch { width: 80px; height: 80px; border-radius: var(--radius-lg); display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; overflow: hidden; box-shadow: var(--shadow-md); }
  .tile-swatch span { display: block; }
  .name { font-family: var(--heading-font); font-size: var(--text-3xl); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); line-height: 1.05; margin: 0 0 var(--space-2); }
  .meta { display: flex; align-items: center; gap: var(--space-2); font-size: 13px; color: var(--muted-foreground); flex-wrap: wrap; }
  .meta code { font-family: var(--font-mono); font-size: 12px; padding: 1px 6px; background: var(--muted); border-radius: var(--radius-sm); color: var(--foreground); }
  .meta-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--border); display: inline-block; }
  .kind-chip { font-family: var(--font-mono); font-size: 10px; padding: 1px 6px; border-radius: var(--radius-sm); letter-spacing: 0.08em; text-transform: uppercase; }
  .kind-chip[data-kind="light"] { background: var(--muted); color: var(--muted-foreground); }
  .kind-chip[data-kind="dark"] { background: color-mix(in oklch, var(--foreground) 12%, transparent); color: var(--foreground); }
  .kind-chip[data-kind="special"] { background: color-mix(in oklch, var(--primary) 16%, transparent); color: var(--primary); }
  .rule { width: 96px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--primary), transparent); margin-top: var(--space-3); }
  .actions { display: flex; gap: var(--space-2); align-items: center; }
  .status { font-size: 12px; color: var(--muted-foreground); margin-right: var(--space-1); }
  .prose { font-size: 15px; line-height: 1.6; color: color-mix(in oklch, var(--foreground) 85%, transparent); margin: 0 0 var(--space-6); max-width: 70ch; }

  .grid { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1fr 1fr; } }
  .panel { background: var(--card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .panel-h { display: flex; align-items: baseline; gap: var(--space-2); margin: 0; font-size: 11px; font-weight: var(--font-weight-semibold); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); }
  .panel-h-aux { font-family: var(--font-mono); font-weight: normal; letter-spacing: 0; text-transform: none; font-size: 11px; }
  .panel-h-action { margin-left: auto; }
  .panel-h-action button { border: 0; background: transparent; color: var(--primary); font: inherit; font-size: 11px; cursor: pointer; padding: 2px 6px; border-radius: var(--radius-sm); }
  .panel-h-action button:hover { background: color-mix(in oklch, var(--primary) 10%, transparent); }

  .tok-cats { display: flex; gap: 0; padding: 2px; background: var(--surface-1); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); flex-wrap: wrap; }
  .tok-cat { padding: var(--space-1) 10px; border: 0; background: transparent; font: inherit; font-size: 11.5px; font-family: var(--font-mono); color: var(--muted-foreground); border-radius: var(--radius-sm); cursor: pointer; }
  .tok-cat[data-active] { background: var(--background); color: var(--foreground); font-weight: var(--font-weight-semibold); box-shadow: var(--shadow-xs); }

  .tok-rows { display: flex; flex-direction: column; gap: 2px; max-height: 540px; overflow-y: auto; }
  .tok-group-h { font-size: 10px; font-weight: var(--font-weight-semibold); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); padding: var(--space-3) var(--space-2) 6px; }
  .tok { display: flex; align-items: center; gap: var(--space-2); padding: 5px var(--space-2); border-radius: var(--radius-sm); transition: background 120ms; }
  .tok:hover { background: var(--surface-1); }
  .tok-name { flex: 1; min-width: 0; font-family: var(--font-mono); font-size: 11.5px; color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tok-name .o { font-size: 9px; color: var(--primary); margin-left: var(--space-1); vertical-align: 2px; }
  .tok-swatch { width: 22px; height: 22px; flex: none; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); }
  .tok-shadow { width: 36px; height: 22px; flex: none; border-radius: var(--radius-sm); background: var(--card); }
  .tok-val { width: 140px; flex: none; font-family: var(--font-mono); font-size: 11.5px; padding: var(--space-1) var(--space-2); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--background); color: var(--foreground); }
  .tok-val:focus { outline: 0; border-color: var(--primary); }
  .tok[data-type="font"] .tok-val, .tok[data-type="easing"] .tok-val, .tok[data-type="shadow"] .tok-val { width: 200px; }

  .preview-frame { border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-5); background: var(--background); color: var(--foreground); display: flex; flex-direction: column; gap: var(--space-4); min-height: 540px; }
  .pv-h { font-family: var(--heading-font); font-size: 20px; font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); margin: 0; }
  .pv-row { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .pv-fields { display: flex; flex-direction: column; gap: var(--space-2); }
  .pv-nav { display: flex; gap: 2px; flex-wrap: wrap; }
  .pv-nav a { padding: 6px var(--space-3); border-radius: var(--radius-sm); color: var(--muted-foreground); font-size: 13px; cursor: pointer; }
  .pv-nav a[data-active] { background: color-mix(in oklch, var(--primary) 18%, transparent); color: var(--foreground); }
  .pv-stats { display: flex; gap: var(--space-3); }
  .pv-stats sui-stat { flex: 1; }

  .ie-bar { display: flex; align-items: center; gap: var(--space-2); padding: 10px var(--space-3); margin-top: var(--space-5); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-1); flex-wrap: wrap; }
  .ie-hint { flex: 1; min-width: 200px; font-size: 12.5px; color: var(--muted-foreground); }
  .ie-hint code { font-family: var(--font-mono); font-size: 11.5px; padding: 1px 5px; background: var(--background); border-radius: var(--radius-sm); }
  .file-hidden { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
</style>

<div class="detail" data-test="theme-detail">

  <button type="button" class="back" data-test="theme-back" on:click={() => back()}>
    <sui-icon name="chevron-left" size="xs"></sui-icon> Themes
  </button>

  <header class="head">
    <span class="tile-swatch" aria-hidden="true">
      <span style:background={bg()}></span>
      <span style:background={fg()}></span>
      <span style:background={pr()}></span>
      <span style:background={ac()}></span>
    </span>
    <div>
      <h1 class="name" data-test="theme-name">{name()}</h1>
      <div class="meta">
        <code>{themeId()}</code>
        <span class="meta-sep"></span>
        <span class="kind-chip" attr:data-kind={kind()}>{kind()}</span>
        <span class="meta-sep"></span>
        <span data-test="override-count">{overrideCount()} token overrides</span>
        {#if metaSuffix()}
          <span class="meta-sep"></span>
          <span>{metaSuffix()}</span>
        {/if}
      </div>
      <div class="rule"></div>
    </div>
    <div class="actions">
      {#if status()}<span class="status" aria-live="polite">{status()}</span>{/if}
      <sui-button tone="primary" variant="solid" size="sm" data-test="apply-project"
        on:click={() => applyToProject()}>
        <sui-icon slot="leading" name="check" size="xs"></sui-icon>Apply to project
      </sui-button>
    </div>
  </header>

  <p class="prose">{blurb()}</p>

  <div class="grid">

    <section class="panel" data-test="theme-editor">
      <div class="panel-h">
        Tokens
        <span class="panel-h-aux">· {overrideCount()} overridden vs Ship defaults</span>
        <span class="panel-h-action"><button type="button" data-test="reset-defaults" on:click={() => reset()}>Reset to defaults</button></span>
      </div>
      <div class="tok-cats" role="tablist">
        {#for tab of tabs() key={tab.id}}
          <button class="tok-cat" type="button" data-test="tok-tab"
            attr:data-tab={tab.id}
            attr:data-active={activeTab() === tab.id}
            on:click={() => setTab(tab.id)}>{tab.label}</button>
        {/for}
      </div>
      <div class="tok-rows" data-test="tok-rows">
        {#for group of groups() key={group.id}}
          <div class="tok-group-h">{group.label}</div>
          {#for row of group.rows key={row.name}}
            <div class="tok" attr:data-type={row.type} attr:data-token={row.name}>
              <span class="tok-name">
                {row.name}{#if row.dot}<span class="o" data-test="override-dot">●</span>{/if}
              </span>
              {#if row.isColor}<span class="tok-swatch" style:background={row.value}></span>{/if}
              {#if row.isShadow}<span class="tok-shadow" style:box-shadow={row.value}></span>{/if}
              <input class="tok-val" type="text" data-test="tok-input"
                attr:value={row.value} attr:aria-label={row.name}
                on:input={(e) => edit(row.name, e)} />
            </div>
          {/for}
        {/for}
      </div>
    </section>

    <section class="panel">
      <div class="panel-h">Live preview <span class="panel-h-aux">· updates as you type</span></div>
      <div class="preview-frame" bind:this={previewEl} data-test="theme-preview">
        <h3 class="pv-h">Heading sets the tone</h3>
        <div class="pv-row">
          <sui-button tone="primary" variant="solid" size="sm">Primary</sui-button>
          <sui-button tone="primary" variant="soft" size="sm">Soft</sui-button>
          <sui-button variant="outline" size="sm">Outline</sui-button>
          <sui-button variant="ghost" size="sm">Ghost</sui-button>
          <sui-button tone="destructive" variant="solid" size="sm">Delete</sui-button>
        </div>
        <sui-card>
          <span slot="header">Card sits on the surface</span>
          Body text reads against the foreground token; muted copy uses the muted ramp.
          <span slot="footer"><sui-button tone="primary" variant="soft" size="xs">Confirm</sui-button></span>
        </sui-card>
        <div class="pv-fields">
          <sui-input placeholder="Search agents, skills, MCPs…"></sui-input>
          <sui-select label="Provider">
            <option>anthropic</option>
            <option>openai</option>
            <option>local</option>
          </sui-select>
        </div>
        <nav class="pv-nav" aria-label="Preview navigation">
          <a data-active>Dashboard</a><a>Agents</a><a>Pipelines</a><a>Settings</a>
        </nav>
        <div class="pv-stats">
          <sui-stat><span slot="label">Agents</span>8</sui-stat>
          <sui-stat tone="primary"><span slot="label">Skills</span>14</sui-stat>
          <sui-stat><span slot="label">MCP</span>5</sui-stat>
        </div>
        <sui-alert tone="info"><span slot="title">Info</span>Preview reflects the tone ramp.</sui-alert>
        <sui-alert tone="success"><span slot="title">Saved</span>Token saved.</sui-alert>
      </div>
    </section>

  </div>

  <div class="ie-bar">
    <span class="ie-hint">
      Export the current theme as <code>tokens.css</code> or <code>.json</code>, or import a CSS variables block / JSON map.
    </span>
    <sui-button variant="outline" size="sm" data-test="export-css" on:click={() => exportCss()}>
      <sui-icon slot="leading" name="download" size="xs"></sui-icon>Export CSS
    </sui-button>
    <sui-button variant="outline" size="sm" data-test="export-json" on:click={() => exportJson()}>
      <sui-icon slot="leading" name="download" size="xs"></sui-icon>Export JSON
    </sui-button>
    <sui-button variant="outline" size="sm" data-test="import-theme" on:click={() => triggerImport()}>
      <sui-icon slot="leading" name="upload" size="xs"></sui-icon>Import
    </sui-button>
    <input class="file-hidden" type="file" accept=".css,.json,application/json,text/css"
      bind:this={fileEl} on:change={(e) => onImportFile(e)} aria-hidden="true" />
  </div>

</div>
