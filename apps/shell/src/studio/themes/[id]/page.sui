<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
    <article class="te-detail" data-test="theme-editor">

      <header class="te-head">
        <span class="te-tile" aria-hidden="true">
          {#for c of swatches() key={c}}
            <span attr:style={'background:' + c}></span>
          {/for}
        </span>
        <div class="te-head-body">
          <h1 class="te-name" data-test="theme-name">{theme() ? theme().label : themeId()}</h1>
          <div class="te-meta">
            <code>{themeId()}</code>
            <span class="te-meta-sep" aria-hidden="true"></span>
            <span class="te-kind" attr:data-kind={kindLabel()}>{kindLabel()}</span>
            <span class="te-meta-sep" aria-hidden="true"></span>
            <span>{overrideCount()} token override{overrideCount() === 1 ? '' : 's'}</span>
          </div>
          <div class="te-rule" aria-hidden="true"></div>
        </div>
        <div class="te-actions">
          {#if isActive()}
            <sui-button variant="outline" size="sm" prop:disabled={true} data-test="theme-active">
              <sui-icon slot="leading" name="check" size="xs"></sui-icon>Active
            </sui-button>
          {:else}
            <sui-button tone="primary" variant="solid" size="sm" on:click={setActive} data-test="set-active">
              <sui-icon slot="leading" name="check" size="xs"></sui-icon>Set active
            </sui-button>
          {/if}
        </div>
      </header>

      <div class="te-grid">

        <!-- Token editor -->
        <section class="te-panel">
          <div class="te-panel-h">
            <span>Tokens</span>
            <span class="te-panel-aux">· {overrideCount()} overridden</span>
            {#if overrideCount() > 0}
              <span class="te-panel-action"><button type="button" on:click={resetAll}>Reset to defaults</button></span>
            {/if}
          </div>
          <div class="te-cats" role="tablist">
            {#for c of categories() key={c.id}}
              <button type="button" class="te-cat" attr:data-active={c.active}
                on:click={() => setCat(c.id)}>{c.label}</button>
            {/for}
          </div>
          <div class="te-rows">
            {#for g of groups() key={g.id}}
              <div class="te-group-h">{g.label}</div>
              {#for t of g.tokens key={t.name}}
                <div class="te-tok" attr:data-type={t.type}>
                  <span class="te-tok-name">
                    <code>{t.name}</code>
                    {#if t.overridden}<span class="te-o" title="overridden">●</span>{/if}
                  </span>
                  {#if t.type === 'color'}
                    <label class="te-swatch" attr:style={'background:' + t.value}>
                      <input type="color" class="te-color" attr:value={t.value} attr:aria-label={t.name}
                        on:input={(e) => setToken(t.name, e.target.value)} />
                    </label>
                    <input class="te-val" attr:value={t.value} attr:aria-label={t.name}
                      on:input={(e) => setToken(t.name, e.target.value)} />
                  {:else if t.type === 'number'}
                    <span class="te-swatch te-swatch-empty" aria-hidden="true"></span>
                    <select class="te-val te-select" attr:aria-label={t.name}
                      on:change={(e) => setToken(t.name, e.target.value)}>
                      {#for w of weights() key={w}}
                        <option attr:value={w} attr:selected={t.value === w}>{w}</option>
                      {/for}
                    </select>
                  {:else}
                    <span class="te-swatch te-swatch-empty" aria-hidden="true"></span>
                    <input class="te-val" attr:value={t.value} attr:aria-label={t.name}
                      on:input={(e) => setToken(t.name, e.target.value)} />
                  {/if}
                </div>
              {/for}
            {/for}
          </div>
        </section>

        <!-- Live preview (scoped — never your active theme) -->
        <section class="te-panel">
          <div class="te-panel-h"><span>Live preview</span><span class="te-panel-aux">· updates as you type</span></div>
          <div class="te-preview" attr:data-theme={themeId()} attr:style={previewStyle()}>
            <h3 class="te-pv-h">Heading sets the tone</h3>
            <div class="te-pv-row">
              <button class="te-pv-btn te-pv-primary">Primary</button>
              <button class="te-pv-btn te-pv-outline">Outline</button>
              <button class="te-pv-btn te-pv-ghost">Ghost</button>
            </div>
            <div class="te-pv-card">
              <strong>Card sits on the surface</strong>
              <p>Body text reads against the foreground token; muted text uses muted-foreground.</p>
            </div>
            <div class="te-pv-input">Search agents, skills, MCPs…</div>
            <nav class="te-pv-nav">
              <a class="is-active">Dashboard</a><a>Agents</a><a>Pipelines</a><a>Settings</a>
            </nav>
            <div class="te-pv-stats">
              <div class="te-pv-stat"><div class="te-pv-stat-n">8</div><div class="te-pv-stat-l">agents</div></div>
              <div class="te-pv-stat"><div class="te-pv-stat-n">14</div><div class="te-pv-stat-l">skills</div></div>
              <div class="te-pv-stat"><div class="te-pv-stat-n">5</div><div class="te-pv-stat-l">MCP</div></div>
            </div>
            <div class="te-pv-toasts">
              <div class="te-pv-toast te-pv-ok">Success — token saved</div>
              <div class="te-pv-toast te-pv-err">Error — invalid value</div>
            </div>
          </div>
        </section>

      </div>

      <section class="te-sec">
        <h2 class="te-sec-h">Source</h2>
        <div class="te-source"><code>[data-theme="{themeId()}"]</code> in the global stylesheet</div>
      </section>

    </article>
  </main>
</div>
