<!--
  <sui-themes-list> — swatch-led list of the built-in token packs.
  Mirrors .artifacts/studio-design/themes-list.html. Each card shows an
  88px 2×2 swatch (background / foreground / primary / accent), a
  tone-tinted kind chip, name + blurb, and the override-count meta line.
-->

<style>
  :host { display: block; }
  .list { max-width: 1100px; margin: 0 auto; padding: var(--space-2) 0 64px; }

  .list-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-6); }
  .list-title { font-family: var(--heading-font); font-size: var(--text-3xl); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); line-height: 1.05; margin: 0 0 var(--space-2); }
  .list-sub { display: flex; align-items: center; gap: var(--space-2); font-size: 13.5px; color: var(--muted-foreground); margin: 0; flex-wrap: wrap; }
  .list-sub strong { font-weight: var(--font-weight-semibold); color: var(--foreground); }
  .list-sub-sep { width: 3px; height: 3px; border-radius: 50%; background: var(--border); display: inline-block; }
  .list-rule { width: 96px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--primary), transparent); margin-top: var(--space-3); }

  .list-filters { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-5); flex-wrap: wrap; }
  .list-search { display: inline-flex; align-items: center; gap: var(--space-2); flex: 1 1 280px; min-width: 220px; padding: 7px var(--space-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-1); }
  .list-search:focus-within { border-color: var(--primary); background: var(--background); }
  .list-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 13.5px; color: var(--foreground); }
  .list-pills { display: inline-flex; gap: var(--space-1); flex-wrap: wrap; }
  .list-pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px var(--space-3); border: 1px solid var(--border-subtle); border-radius: var(--radius-full); background: var(--surface-1); color: var(--muted-foreground); font: inherit; font-size: 12.5px; cursor: pointer; }
  .list-pill:hover { color: var(--foreground); border-color: var(--border); }
  .list-pill[data-active] { color: var(--primary-foreground); background: var(--primary); border-color: var(--primary); }
  .list-pill-count { font-variant-numeric: tabular-nums; font-size: var(--text-xs); padding: 1px 6px; border-radius: var(--radius-full); background: color-mix(in oklch, currentColor 18%, transparent); }

  .themes-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  @media (min-width: 720px) { .themes-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .themes-grid { grid-template-columns: repeat(3, 1fr); } }

  .theme { display: grid; grid-template-columns: 88px 1fr 20px; gap: var(--space-4); align-items: stretch; padding: 18px; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-1); text-align: left; color: var(--foreground); cursor: pointer; font: inherit; transition: border-color 120ms, background 120ms, box-shadow 120ms; }
  .theme:hover { border-color: var(--border); background: var(--background); box-shadow: var(--shadow-sm); }
  .theme:hover .theme-chev { opacity: 1; transform: translateX(2px); }

  .theme-swatch { width: 88px; height: 88px; border-radius: var(--radius-md); display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; overflow: hidden; box-shadow: var(--shadow-sm); }
  .theme-swatch span { display: block; }

  .theme-body { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .theme-head { display: flex; align-items: baseline; gap: var(--space-2); }
  .theme-name { font-family: var(--font-mono); font-size: 15px; font-weight: var(--font-weight-semibold); }
  .theme-kind { font-family: var(--font-mono); font-size: 10px; padding: 1px 6px; border-radius: var(--radius-sm); letter-spacing: 0.08em; text-transform: uppercase; }
  .theme-kind[data-kind="light"] { background: var(--muted); color: var(--muted-foreground); }
  .theme-kind[data-kind="dark"] { background: color-mix(in oklch, var(--foreground) 12%, transparent); color: var(--foreground); }
  .theme-kind[data-kind="special"] { background: color-mix(in oklch, var(--primary) 16%, transparent); color: var(--primary); }
  .theme-desc { font-size: 13.5px; color: var(--muted-foreground); line-height: 1.45; margin: 0; }
  .theme-meta { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); margin-top: 2px; }
  .theme-chev { align-self: center; color: var(--muted-foreground); opacity: 0; transition: opacity 120ms, transform 120ms; }
</style>

<div class="list" data-test="themes-list">

  <header class="list-head">
    <div>
      <h1 class="list-title">Themes</h1>
      <p class="list-sub">
        Token packs you can apply per project.
        <span class="list-sub-sep"></span>
        Switch the active theme via <strong>Studio · Project</strong>.
      </p>
      <div class="list-rule"></div>
    </div>
    <sui-button tone="primary" variant="solid" size="md" on:click={() => newTheme()}>
      <sui-icon slot="leading" name="plus" size="xs"></sui-icon>
      New theme
    </sui-button>
  </header>

  <div class="list-filters">
    <label class="list-search">
      <sui-icon name="search" size="sm" tone="muted"></sui-icon>
      <input type="search" placeholder="Filter themes…" aria-label="Filter themes"
        on:input={(e) => onSearch(e)} />
    </label>
    <div class="list-pills" role="tablist">
      <button class="list-pill" type="button" data-test="pill-all"
        attr:data-active={activeKind() === 'all'}
        on:click={() => setKind('all')}>All <span class="list-pill-count">{counts().all}</span></button>
      <button class="list-pill" type="button"
        attr:data-active={activeKind() === 'light'}
        on:click={() => setKind('light')}>Light <span class="list-pill-count">{counts().light}</span></button>
      <button class="list-pill" type="button"
        attr:data-active={activeKind() === 'dark'}
        on:click={() => setKind('dark')}>Dark <span class="list-pill-count">{counts().dark}</span></button>
      <button class="list-pill" type="button"
        attr:data-active={activeKind() === 'special'}
        on:click={() => setKind('special')}>Special <span class="list-pill-count">{counts().special}</span></button>
    </div>
  </div>

  <div class="themes-grid" data-test="themes-grid">
    {#for card of cards() key={card.id}}
      <button type="button" class="theme" data-test="theme-card"
        attr:data-theme-id={card.id}
        on:click={() => open(card.id)}>
        <span class="theme-swatch" aria-hidden="true">
          <span style:background={card.bg}></span>
          <span style:background={card.fg}></span>
          <span style:background={card.pr}></span>
          <span style:background={card.ac}></span>
        </span>
        <span class="theme-body">
          <span class="theme-head">
            <span class="theme-name">{card.label}</span>
            <span class="theme-kind" attr:data-kind={card.kind}>{card.kind}</span>
          </span>
          <span class="theme-desc">{card.blurb}</span>
          <span class="theme-meta">{card.meta}</span>
        </span>
        <span class="theme-chev"><sui-icon name="chevron-right" size="sm"></sui-icon></span>
      </button>
    {/for}
  </div>

</div>
