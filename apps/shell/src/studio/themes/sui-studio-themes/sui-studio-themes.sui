<!--
  <sui-studio-themes> — the Themes Studio section element.

  Registered as the section keystone: studio/page.sui's content slot
  renders this element when section() === 'themes'. It reads the URL and
  routes between the swatch-led list (`/studio/themes`) and the token
  editor + live preview detail (`/studio/themes/<id>`). Both child
  surfaces are registered via side-effect imports in the controller.
-->

<style>
  :host { display: block; min-height: 100%; }
</style>

<div class="studio-themes-root" data-test="studio-themes">
  {#if detailId()}
    <sui-theme-detail data-test="theme-detail-host"></sui-theme-detail>
  {:else}
    <sui-themes-list data-test="themes-list-host"></sui-themes-list>
  {/if}
</div>
