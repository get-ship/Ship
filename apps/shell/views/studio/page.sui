<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
    <section class="studio-landing">
      <h1 class="studio-landing-h1">Studio</h1>
      <p class="studio-landing-sub">
        Configure this workspace — agents, skills, components, themes and more.
        Pick a section from the rail. Agents is live today; the rest are
        landing as deck views.
      </p>
      <sui-empty-state variant="placeholder" size="md" data-test="studio-landing-empty">
        <sui-icon slot="icon" name="bot"></sui-icon>
        <span slot="title">Start with Agents</span>
        Define and wire the agents available to this project.
        <a slot="action" class="studio-landing-link" href="/studio/agents" data-test="studio-landing-agents">
          <sui-icon name="arrow-right" size="xs"></sui-icon>
          Open Agents
        </a>
      </sui-empty-state>
    </section>
  </main>
</div>
