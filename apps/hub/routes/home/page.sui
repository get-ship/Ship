<!--
  `routes/home/page.sui` — Ship's home view. The blank canvas: a
  brand mark, a wordmark, a sub-copy hinting at ⌘K, and four hotkey
  pills. Replaces the apps/shell-era `<sui-blank-canvas>` component
  with a co-located route + its own chrome style.
-->
<style>
  :host {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    width: 100%;
    height: 100%;
    padding: 0 var(--space-6, 24px);
    box-sizing: border-box;
    background:
      radial-gradient(circle at 1px 1px, var(--border-subtle) 1px, transparent 0)
      0 0 / 32px 32px,
      var(--background);
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }
  .mark {
    width: 64px; height: 64px;
    border-radius: var(--radius-lg, 12px);
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 30px;
    font-weight: 600;
    line-height: 1;
    margin-bottom: var(--space-4, 16px);
  }
  .title {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 var(--space-2, 8px);
    color: var(--foreground);
  }
  .rule {
    width: 96px; height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--primary), transparent);
    margin: 0 auto var(--space-6, 24px);
  }
  .sub {
    font-size: 15px;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-6, 24px);
    max-width: 56ch;
    line-height: 1.5;
  }
  .sub code {
    font-family: var(--font-mono, ui-monospace, monospace);
    padding: 1px 6px;
    background: var(--muted);
    border-radius: var(--radius-sm, 4px);
    color: var(--foreground);
  }
  .hints {
    display: flex;
    gap: var(--space-3, 12px);
    flex-wrap: wrap;
    justify-content: center;
  }
  .hint {
    appearance: none;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px var(--space-3, 12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full, 9999px);
    background: var(--surface-1);
    font: inherit;
    font-size: 12.5px;
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .hint:hover { color: var(--foreground); border-color: var(--border); }
  .hint kbd {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    padding: 1px 5px;
    border-radius: var(--radius-sm, 4px);
    background: var(--background);
    border: 1px solid var(--border-subtle);
    color: var(--muted-foreground);
  }
</style>

<span class="mark" aria-hidden="true">S</span>
<h1 class="title">Ship</h1>
<div class="rule" aria-hidden="true"></div>
<p class="sub">
  Press <code>⌘K</code> to begin, or <code>⌘.</code> to open Studio.
</p>
<div class="hints" role="group" aria-label="Hotkey hints">
  <button class="hint" type="button" on:click={onPaletteHint} title="Open command palette (⌘K)">
    <kbd>⌘K</kbd> palette
  </button>
  <button class="hint" type="button" on:click={onStudioHint} title="Open Studio (⌘.)">
    <kbd>⌘.</kbd> studio
  </button>
  <button class="hint" type="button" on:click={onHelpHint} title="Open help (⌘?)">
    <kbd>⌘?</kbd> help
  </button>
</div>
