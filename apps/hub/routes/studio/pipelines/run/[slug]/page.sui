<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
{#async runCtx}
  {:loading}
  <sui-spinner size="md" centered></sui-spinner>

  {:error err}
  <sui-error-state title="Couldn't load run" data-test="error" role="alert">
    {err.message}
    <sui-button slot="action" tone="primary" variant="solid" on:click={() => window.location.reload()}>Retry</sui-button>
  </sui-error-state>

  {:ok}
{#if run()}
<div class="ship-view ship-view-run-detail">
  <div class="ship-run-detail-wrap">
    <div class="ship-run-detail-head">
      <div>
        <div class="ship-run-detail-title-row">
          <span class="ship-run-detail-slug">{run().slug}</span>
          <sui-badge attr:tone={run().tone}>{run().statusLabel}</sui-badge>
          {#if run().outcome}<sui-chip size="sm" tone="muted">{run().outcome}</sui-chip>{/if}
        </div>
        <div class="ship-run-detail-meta">
          {#if run().startedLabel}<span>started <time datetime={run().startedAt}>{run().startedLabel}</time></span>{/if}
          {#if run().endedLabel}<span>ended <time datetime={run().endedAt}>{run().endedLabel}</time></span>{/if}
          {#if run().duration}<span>{run().duration}</span>{/if}
        </div>
      </div>
      {#if !run().terminal}
      <div class="ship-run-detail-actions">
        <sui-button variant="outline" size="sm" tone="destructive" on:click={() => cancelRun(run().slug)}>
          <sui-icon slot="leading" name="stop"></sui-icon>Cancel
        </sui-button>
      </div>
      {/if}
    </div>

    {#if steps().length > 0}
    <sui-card>
      <h3 slot="header" class="ship-run-detail-section-title">Pipeline</h3>
      <sui-pipeline-dag>
        {#for step of steps() key={step.stepId}}
          <sui-pipeline-step attr:type={step.typeAttr} attr:state={step.stateAttr}>{step.stepId}</sui-pipeline-step>
          {#if !step.isLast}<span class="arrow" aria-hidden="true">→</span>{/if}
        {/for}
      </sui-pipeline-dag>
    </sui-card>

    <sui-card>
      <h3 slot="header" class="ship-run-detail-section-title">Steps</h3>
      {#for step of steps() key={step.stepId}}
      <div class="ship-step-row">
        <span class="ship-step-name">{step.stepId}</span>
        <div class="ship-step-meta">
          <sui-chip size="sm" tone="muted">{step.stepType}</sui-chip>
          <span>{step.statusLabel}</span>
          {#if step.attempt > 1}<span>attempt {step.attempt}</span>{/if}
          {#if step.startedLabel}<span>started {step.startedLabel}</span>{/if}
          {#if step.completedLabel}<span>done {step.completedLabel}</span>{/if}
        </div>
      </div>
      {/for}
    </sui-card>
    {/if}
  </div>
</div>
{/if}
{/async}
  </main>
</div>
