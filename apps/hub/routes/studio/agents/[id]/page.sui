<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
{#async wireCtx}
  {:loading}
  <sui-spinner size="md" centered></sui-spinner>

  {:error err}
  <article class="detail">
    <sui-empty-state icon="search-x" variant="default" size="md" data-test="agent-not-found">
      <span slot="title">No such agent</span>
      <span>{'No agent with id "' + agentId() + '" was found. ' + (err.message || '')}</span>
      <sui-button slot="action" tone="primary" variant="solid" on:click={goBack}>
        <sui-icon slot="leading" name="chevron-left" size="xs"></sui-icon>
        Back to agents
      </sui-button>
    </sui-empty-state>
  </article>

  {:ok}
  {#if notFound()}
    <article class="detail">
      <sui-empty-state icon="search-x" variant="default" size="md" data-test="agent-not-found">
        <span slot="title">No such agent</span>
        <span>{'No agent with id "' + agentId() + '" exists in this workspace or your library.'}</span>
        <sui-button slot="action" tone="primary" variant="solid" on:click={goBack}>
          <sui-icon slot="leading" name="chevron-left" size="xs"></sui-icon>
          Back to agents
        </sui-button>
      </sui-empty-state>
    </article>
  {/if}
{/async}

{#if wireData() && wireData().agent}
  <article class="detail" data-test="agent-detail">

    <header class="detail-head">
      <span attr:class={'detail-tile hue-' + hue()} aria-hidden="true" data-test="detail-tile">{initials()}</span>

      <div class="detail-head-body">
        <h1 class="detail-name" data-test="agent-name">{wireData().agent.name}</h1>
        <div class="detail-meta">
          <code data-test="agent-id">{wireData().agent.id}</code>
          {#for bit of metaBits() key={bit}}
            <span class="detail-meta-sep"></span>
            <span>{bit}</span>
          {/for}
          {#if isActive()}
            <span class="detail-meta-sep"></span>
            <span class="detail-meta-active" data-test="active-chip">
              <sui-status-dot tone="success" size="sm" pulse label="Active"></sui-status-dot>
              active
            </span>
          {/if}
        </div>
        <div class="detail-rule"></div>
      </div>

      <div class="detail-actions">
        <sui-toggle-group variant="segmented" type="single" value="overview" size="sm" on:sui-change={(e) => goTab(e.detail.value)}>
          <sui-toggle value="overview">Overview</sui-toggle>
          <sui-toggle value="wire">Wire</sui-toggle>
          <sui-toggle value="settings">Settings</sui-toggle>
        </sui-toggle-group>
        {#if isActive()}
          <sui-button tone="success" variant="outline" size="sm" data-test="deactivate-btn"
            prop:disabled={activating()}
            on:click={deactivate}>
            <sui-icon slot="leading" name="check" size="xs"></sui-icon>
            {activating() ? 'Saving…' : 'Active · clear'}
          </sui-button>
        {:else}
          <sui-button tone="primary" variant="solid" size="sm" data-test="activate-btn"
            prop:disabled={activating()}
            on:click={activate}>
            <sui-icon slot="leading" name="zap" size="xs"></sui-icon>
            {activating() ? 'Activating…' : 'Activate'}
          </sui-button>
        {/if}
        <sui-button variant="ghost" size="sm" on:click={goSettings} data-test="edit-settings-btn">
          <sui-icon slot="leading" name="edit" size="xs"></sui-icon>
          Edit
        </sui-button>
      </div>
    </header>

    {#if banner()}
      <sui-alert tone={banner().ok ? 'success' : 'destructive'} data-test="banner">
        {banner().msg}
      </sui-alert>
    {/if}

    <p class="detail-prose" data-test="agent-description">{description()}</p>

    {#if (wireData().agent.tags || []).length > 0}
      <div class="detail-tags">
        {#for t of wireData().agent.tags key={t}}
          <sui-chip tone="muted" variant="soft" size="sm">{t}</sui-chip>
        {/for}
      </div>
    {/if}

    <section class="detail-section" data-test="section-skills">
      <div class="detail-section-head">
        <h2 class="detail-section-h">Skills <span class="detail-section-count">· {stats().skills}</span></h2>
        <div class="detail-section-action"><a href="#" on:click={goSettings}>Manage →</a></div>
      </div>
      {#if stats().skills === 0}
        <div class="detail-empty">No skills wired.</div>
      {:else}
        <div class="detail-rows">
          {#for s of skillsList() key={s}}
            <button class="detail-row detail-row--link" type="button" on:click={() => goSkill(s)} data-test="skill-link" attr:data-id={s}>
              <span class="detail-row-icon"><sui-icon name="zap" size="xs"></sui-icon></span>
              <div class="detail-row-body">
                <span class="detail-row-name">{s}</span>
              </div>
              <span class="detail-row-meta"></span>
              <span class="detail-row-chev"><sui-icon name="chevron-right" size="xs"></sui-icon></span>
            </button>
          {/for}
        </div>
      {/if}
    </section>

    <section class="detail-section" data-test="section-mcp">
      <div class="detail-section-head">
        <h2 class="detail-section-h">MCP servers <span class="detail-section-count">· {stats().mcp}</span></h2>
        <div class="detail-section-action"><a href="#" on:click={goSettings}>Manage →</a></div>
      </div>
      {#if stats().mcp === 0}
        <div class="detail-empty">No MCP servers connected.</div>
      {:else}
        <div class="detail-rows">
          {#for m of mcpList() key={m}}
            <div class="detail-row" data-test="mcp-row" attr:data-id={m}>
              <span class="detail-row-icon"><sui-icon name="terminal" size="xs"></sui-icon></span>
              <div class="detail-row-body">
                <span class="detail-row-name">{m}</span>
              </div>
              <span class="detail-row-meta"></span>
              <span></span>
            </div>
          {/for}
        </div>
      {/if}
    </section>

    <section class="detail-section" data-test="section-rules">
      <div class="detail-section-head">
        <h2 class="detail-section-h">Rules <span class="detail-section-count">· {rulesTotal()}</span></h2>
        <div class="detail-section-action"><a href="#" on:click={goSettings}>Edit →</a></div>
      </div>
      {#if rulesTotal() === 0}
        <div class="detail-empty">No rules attached.</div>
      {/if}
      {#if stats().rules > 0}
        <div class="detail-rows">
          {#for r of rulesList() key={r}}
            <div class="detail-row" data-test="rule-row" attr:data-id={r}>
              <span class="detail-row-icon"><sui-icon name="file-text" size="xs"></sui-icon></span>
              <div class="detail-row-body">
                <span class="detail-row-name">{r}</span>
              </div>
              <span class="detail-row-meta">.ship/rules/</span>
              <span></span>
            </div>
          {/for}
        </div>
      {/if}
      {#if hasInlineRules()}
        <div class="detail-inline-rules" data-test="inline-rules">
          <span class="detail-inline-rules-label">inline</span>
          <pre class="detail-inline-rules-body">{inlineRulesText()}</pre>
        </div>
      {/if}
    </section>

    <section class="detail-section" data-test="section-permissions">
      <div class="detail-section-head">
        <h2 class="detail-section-h">Permissions</h2>
        <div class="detail-section-action"><a href="#" on:click={goSettings}>Edit matrix →</a></div>
      </div>
      <div class="detail-perm">
        <div class="detail-perm-preset">
          <span>Inherits preset</span>
          <code data-test="perm-preset">{permPreset()}</code>
          {#if permTotalCount() > 0}
            <span>· {permTotalCount()} explicit rule{permTotalCount() === 1 ? '' : 's'}</span>
          {/if}
        </div>
        <span class="detail-perm-label is-allow">allow</span>
        <span class="detail-perm-codes" data-test="perm-allow">
          {#if permLists().allow.length === 0}
            <span class="detail-perm-empty">preset defaults</span>
          {:else}
            {#for p of permLists().allow key={p}}
              <span>{p}</span><span class="sep">·</span>
            {/for}
          {/if}
        </span>
        <span class="detail-perm-label is-ask">ask</span>
        <span class="detail-perm-codes" data-test="perm-ask">
          {#if permLists().ask.length === 0}
            <span class="detail-perm-empty">preset defaults</span>
          {:else}
            {#for p of permLists().ask key={p}}
              <span>{p}</span><span class="sep">·</span>
            {/for}
          {/if}
        </span>
        <span class="detail-perm-label is-deny">deny</span>
        <span class="detail-perm-codes" data-test="perm-deny">
          {#if permLists().deny.length === 0}
            <span class="detail-perm-empty">preset defaults</span>
          {:else}
            {#for p of permLists().deny key={p}}
              <span>{p}</span><span class="sep">·</span>
            {/for}
          {/if}
        </span>
      </div>
    </section>

    <section class="detail-section" data-test="section-providers">
      <div class="detail-section-head">
        <h2 class="detail-section-h">Providers <span class="detail-section-count">· {stats().providers}</span></h2>
        <div class="detail-section-action"><a href="#" on:click={goSettings}>Configure →</a></div>
      </div>
      {#if stats().providers === 0}
        <div class="detail-empty">No providers configured. Add one under <code>agent.providers</code> to run this agent.</div>
      {:else}
        <div class="detail-providers-list">
          {#for p of providerList() key={p.id}}
            <span class="detail-provider" data-test="provider-row" attr:data-id={p.id}>
              <span class="detail-provider-name">{p.label}</span>
              {#if p.isDefault}
                <span class="detail-provider-default" data-test="provider-default">default</span>
              {/if}
            </span>
          {/for}
        </div>
      {/if}
    </section>

    <section class="detail-section" data-test="section-meta">
      <div class="detail-section-head">
        <h2 class="detail-section-h">Source</h2>
      </div>
      <div class="detail-source" data-test="agent-path">{sourcePath()}</div>
    </section>

  </article>
{/if}
  </main>
</div>
