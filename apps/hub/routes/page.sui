<!--
  Hub home — the `/` route.

  The home dashboard composes the @ship/home pack (`ship-home-greeting` for
  the hero strip, `ship-spaces-hero` for the spaces section, and
  `ship-activity-runs` for the recent pipeline runs) and pairs them with a
  Studio entry-points grid (Components / Agents / Skills / Collections /
  Themes). Each studio entry is a real navigable route in `/studio/<id>` —
  the home is purely a directory, not a stateful surface.

  Page chrome:
    • the top nav is owned by the root layout (`<ship-app-chrome>`)
    • page-level layout (container padding, section spacing, studio card
      grid) lives in `routes/style.css` per the deck-route-css convention;
      the components themselves carry their own card / typography styles.
    • tokens only — no hardcoded colors / spacing / radii.

  Notes:
    • The home is intentionally SDK-free. Spaces lists are a documented
      BACKEND-GAP (`ship.spaces.list()` doesn't exist yet — see
      `.artifacts/hub-buildout-flags.md`); `ship-spaces-hero` degrades to
      its empty-state. Activity runs through the LiveSource mux and
      stays self-contained inside `ship-activity-runs`.
    • The Studio grid renders ALL FIVE entry points (Components, Agents,
      Skills, Collections, Themes). Each is a real route the hub already
      serves — no broken links.
-->

<main class="hub-home" data-view-enter>
  <ship-home-greeting workspace={workspace()}></ship-home-greeting>

  <ship-spaces-hero spaces={spaces()} limit="8"></ship-spaces-hero>

  <section class="hub-section" aria-labelledby="home-studio-h">
    <h2 class="hub-section-title" id="home-studio-h">Studio</h2>
    <p class="hub-section-sub">Configure this workspace — pick a section to dive in.</p>
    <div class="hub-cards">
      <a class="hub-card" href="/studio/components" data-test="home-studio-components">
        <sui-icon class="hub-card-ico" name="box" tone="primary" size="md"></sui-icon>
        <sui-stack class="hub-card-body" gap="1">
          <span class="hub-card-title">Components</span>
          <span class="hub-card-desc">Browse and inspect the SUI component library.</span>
        </sui-stack>
      </a>
      <a class="hub-card" href="/studio/agents" data-test="home-studio-agents">
        <sui-icon class="hub-card-ico" name="bot" tone="primary" size="md"></sui-icon>
        <sui-stack class="hub-card-body" gap="1">
          <span class="hub-card-title">Agents</span>
          <span class="hub-card-desc">The agents configured in this workspace.</span>
        </sui-stack>
      </a>
      <a class="hub-card" href="/studio/skills" data-test="home-studio-skills">
        <sui-icon class="hub-card-ico" name="sparkles" tone="primary" size="md"></sui-icon>
        <sui-stack class="hub-card-body" gap="1">
          <span class="hub-card-title">Skills</span>
          <span class="hub-card-desc">Skills available to your agents.</span>
        </sui-stack>
      </a>
      <a class="hub-card" href="/studio/collections" data-test="home-studio-collections">
        <sui-icon class="hub-card-ico" name="database" tone="primary" size="md"></sui-icon>
        <sui-stack class="hub-card-body" gap="1">
          <span class="hub-card-title">Collections</span>
          <span class="hub-card-desc">The typed collections that organize the workspace.</span>
        </sui-stack>
      </a>
      <a class="hub-card" href="/studio/themes" data-test="home-studio-themes">
        <sui-icon class="hub-card-ico" name="palette" tone="primary" size="md"></sui-icon>
        <sui-stack class="hub-card-body" gap="1">
          <span class="hub-card-title">Themes</span>
          <span class="hub-card-desc">Theme studio — design tokens, surfaces, motion.</span>
        </sui-stack>
      </a>
    </div>
  </section>

  <ship-activity-runs limit="6"></ship-activity-runs>
</main>
