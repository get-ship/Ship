<!--
  Hub `/account` — owner-level Ship Cloud identity for this workspace.

  Replaces the shell's placeholder `/account` (a disabled "Connect account"
  button on an empty-state). The real surface — live state + sign-in /
  sign-out / billing — is rebuilt here on the unary `ctx.clients.ops`
  account contract. State lives in `controller.ts`; this template only
  declares the four account states (loading / error / signed-in / pending /
  signed-out) it renders.

  Page chrome:
    • the top nav is owned by the root layout (`<ship-app-chrome>`)
    • page-level layout lives in the co-located `style.css`
      (deck-route-css convention) — never an inline <style>
    • tokens only — no hardcoded colors / spacing / radii
-->
<main class="acct" data-view-enter data-test="account-view">
  <header class="acct-head">
    <h1 class="acct-title">Account</h1>
    <p class="acct-sub">Owner-level Ship Cloud identity for this workspace — sign-in, profile, and billing.</p>
  </header>

  <sui-card class="acct-card" padding="lg">
    {#if account().kind === 'loading'}
      <div class="acct-loading" data-test="account-loading">
        <sui-spinner size="md"></sui-spinner>
        <span>Loading account…</span>
      </div>
    {:else if account().kind === 'error'}
      <sui-empty-state icon="alert-triangle" variant="default" size="md" tone="muted" data-test="account-offline">
        <span slot="title">Ship Cloud unreachable</span>
        Account features are unavailable while the daemon is offline.
        <sui-button slot="action" variant="outline" size="sm" on:click={refresh}>
          <sui-icon slot="leading" name="refresh-cw" size="sm"></sui-icon>
          Try again
        </sui-button>
      </sui-empty-state>
    {:else if status() === 'logged_in'}
      <div class="acct-identity" data-test="account-identity">
        {#if image()}
          <img class="acct-avatar" src={image()} alt="" />
        {:else}
          <span class="acct-avatar acct-avatar--fallback" aria-hidden="true">{initials()}</span>
        {/if}
        <div class="acct-id-text">
          <span class="acct-name">{name()}</span>
          {#if email()}
            <span class="acct-email">{email()}</span>
          {:else}
            <span class="acct-email">Signed in to Ship Cloud</span>
          {/if}
        </div>
        <sui-badge tone="success" variant="soft" size="sm">Connected</sui-badge>
      </div>

      <div class="acct-rows">
        <div class="acct-row">
          <div class="acct-row-text">
            <span class="acct-row-label">Billing</span>
            <span class="acct-row-desc">Manage your plan and payment method on Ship Cloud.</span>
          </div>
          <sui-button variant="outline" size="sm" on:click={manageBilling} data-test="account-billing">
            <sui-icon slot="leading" name="external-link" size="sm"></sui-icon>
            Manage billing
          </sui-button>
        </div>
        <div class="acct-row">
          <div class="acct-row-text">
            <span class="acct-row-label">Session</span>
            <span class="acct-row-desc">Sign out clears the API key stored by this daemon.</span>
          </div>
          <sui-button variant="outline" tone="destructive" size="sm"
            prop:disabled={busy()} on:click={signOut} data-test="account-signout">
            <sui-icon slot="leading" name="log-out" size="sm"></sui-icon>
            Sign out
          </sui-button>
        </div>
      </div>
    {:else if status() === 'pending'}
      <sui-empty-state icon="loader" variant="connecting" size="md" tone="primary" data-test="account-pending">
        <span slot="title">Completing sign-in…</span>
        Finish the OAuth flow in the browser tab that opened, then return here. If the daemon's local
        callback doesn't complete, run <code>ship login</code> in a terminal to finalize.
        <sui-button slot="action" variant="outline" size="sm" prop:disabled={busy()} on:click={refresh}>
          <sui-icon slot="leading" name="refresh-cw" size="sm"></sui-icon>
          Check again
        </sui-button>
      </sui-empty-state>
    {:else}
      <sui-empty-state icon="user" variant="default" size="lg" tone="default" data-test="account-signedout">
        <span slot="title">Not signed in</span>
        Connect this workspace to Ship Cloud to unlock publish and sync.
        <sui-button slot="action" tone="primary" variant="solid"
          prop:disabled={busy()} on:click={signIn} data-test="account-signin">
          <sui-icon slot="leading" name="log-in"></sui-icon>
          Sign in with Ship Cloud
        </sui-button>
      </sui-empty-state>
    {/if}

    {#if error()}
      <sui-alert class="acct-alert" tone="destructive" data-test="account-error">{error()}</sui-alert>
    {/if}
  </sui-card>
</main>
