<controller>
// <ship-component-catalog> — @ship/studio · the hub `/studio/components` index.
//
// Reads the build-time CEM catalog (`components.gen.ts`, emitted by
// `deck build` → `deck-bundler::cem::generate_components_gen`). That file is
// the standard custom-elements-manifest of every component pack the hub
// depends on, aggregated from the sui compiler's per-pack CEM, with each
// module annotated with its source `package`. This is build-time discovery —
// every pack the compiler emitted a CEM for appears, published or not. There
// is no runtime endpoint and no registry-publish gate.
//
// The surface groups every component BY PACK (sui-* primitives + ship packs),
// shows each component's CEM metadata (props / slots / events), and live-mounts
// a bare instance of any tag the bundle actually registered (`mount`). A tag
// that is not in the bundle still lists with its metadata — coverage over
// polish.

import { controller, derived } from '@ship/sail-runtime'
import type { Scope } from './ship-component-catalog.sail'
// `components.gen.ts` is @generated by `deck build` (gitignored) — the single
// build-time component catalog. Imported as data; no I/O at runtime.
import { COMPONENTS_CATALOG } from '../../../components.gen'

/** One declared prop, projected from a CEM `attributes[]` entry. */
export interface PropMeta {
  name: string
  type: string
  default?: string
}

/** A named CEM member (slot or event). */
export interface NamedMeta {
  name: string
  description?: string
}

/** One catalog component, projected from a CEM custom-element declaration. */
export interface ComponentEntry {
  tag: string
  pkg: string
  description: string
  props: PropMeta[]
  slots: NamedMeta[]
  events: NamedMeta[]
  /** Declared methods/properties count (CEM `members`). */
  memberCount: number
}

/** One pack section — every component a single package contributes. */
export interface PackGroup {
  id: string
  pkg: string
  count: number
  components: ComponentEntry[]
}

// ── CEM projection (the COMPONENTS_CATALOG wire shape) ──────────────────────
interface CemAttr {
  name?: string
  type?: { text?: string }
  default?: string
}
interface CemDecl {
  kind?: string
  tagName?: string
  customElement?: boolean
  description?: string
  attributes?: CemAttr[]
  slots?: NamedMeta[]
  events?: NamedMeta[]
  members?: unknown[]
}
interface CemModule {
  path?: string
  package?: string
  declarations?: CemDecl[]
}

/** Framework `@ship/sail-*` packs sort before app/domain `@ship/*` packs; ties
 *  break alphabetically. A stable, readable pack order for the browser. */
function packRank(pkg: string): number {
  return pkg.startsWith('@ship/sail-') ? 0 : 1
}

/** Project the generated CEM into pack-grouped component entries. Pure +
 *  synchronous — the catalog is bundled data, computed once at module load. */
function buildGroups(): PackGroup[] {
  const modules = (COMPONENTS_CATALOG as { modules?: CemModule[] }).modules ?? []
  const byPack = new Map<string, ComponentEntry[]>()
  for (const m of modules) {
    const pkg = m.package ?? 'workspace'
    for (const d of m.declarations ?? []) {
      if (d.kind !== 'class' || !d.customElement || !d.tagName) continue
      const entry: ComponentEntry = {
        tag: d.tagName,
        pkg,
        description: (d.description ?? '').split('\n')[0]?.trim() ?? '',
        props: (d.attributes ?? []).map((a): PropMeta => ({
          name: a.name ?? '',
          type: a.type?.text ?? 'string',
          ...(a.default === undefined ? {} : { default: a.default }),
        })),
        slots: (d.slots ?? []).map((s) => ({ name: s.name ?? '(default)', description: s.description })),
        events: (d.events ?? []).map((e) => ({ name: e.name ?? '', description: e.description })),
        memberCount: (d.members ?? []).length,
      }
      const list = byPack.get(pkg) ?? []
      list.push(entry)
      byPack.set(pkg, list)
    }
  }
  return [...byPack.entries()]
    .map(([pkg, list]): PackGroup => ({
      id: pkg.replace(/[^a-z0-9]+/gi, '-'),
      pkg,
      count: list.length,
      components: list.sort((a, b) => a.tag.localeCompare(b.tag)),
    }))
    .sort((a, b) => packRank(a.pkg) - packRank(b.pkg) || a.pkg.localeCompare(b.pkg))
}

// Computed once — the catalog is a build-time constant.
const GROUPS: PackGroup[] = buildGroups()
const TOTAL_COMPONENTS = GROUPS.reduce((n, g) => n + g.count, 0)

export default controller(() => {

    const groups = derived<PackGroup[]>(() => GROUPS)
    const totalComponents = derived<number>(() => TOTAL_COMPONENTS)
    const totalPacks = derived<number>(() => GROUPS.length)
    return { groups, totalComponents, totalPacks }
})
</controller>

<!--
  <ship-component-catalog> — @ship/studio · the hub `/studio/components` index.

  Renders EVERY component the build-time CEM catalog (`components.gen.ts`)
  enumerates, grouped BY PACK: sui-* primitives + every ship pack the hub
  depends on, published or not. Per component it shows the CEM metadata
  (props / slots / events) and live-mounts a bare instance when the tag is in
  the bundle (the controller's `mount` resolves `customElements.get`); a tag
  not in the bundle still lists with its metadata.

  Data: the controller projects `COMPONENTS_CATALOG` (emitted by `deck build`)
  into pack groups — no props, no fetch, no runtime endpoint.
-->
<!-- style block removed: use sx / external CSS -->

<section data-test="catalog-head">
  <h1>Components</h1>
  <span>{totalComponents()} components · {totalPacks()} packs</span>
</section>

<for as="group" of={groups()} key={group.id}>
  <section data-test="catalog-pack" data-pack={group.pkg}>
    <header>
      <span>{group.pkg}</span>
      <span>{group.count}</span>
    </header>
    <div>
      <for as="c" of={group.components} key={c.tag}>
        <article data-test="catalog-cell" data-tag={c.tag}>
          <a href={'/studio/components/' + c.tag}>{c.tag}</a>
          <if cond={c.description}>
            <p>{c.description}</p>
          </if>
          <div data-preview-for={c.tag}></div>
          <dl>
            <div>
              <dt>props</dt>
              <dd>
                <if cond={c.props.length}>
                  <for as="p" of={c.props} key={p.name}><span title={p.type}>{p.name}</span></for>
                <else>
                  <span>—</span>
                </else></if>
              </dd>
            </div>
            <if cond={c.slots.length}>
              <div>
                <dt>slots</dt>
                <dd>
                  <for as="s" of={c.slots} key={s.name}><span>{s.name}</span></for>
                </dd>
              </div>
            </if>
            <if cond={c.events.length}>
              <div>
                <dt>events</dt>
                <dd>
                  <for as="e" of={c.events} key={e.name}><span>{e.name}</span></for>
                </dd>
              </div>
            </if>
          </dl>
        </article>
      </for>
    </div>
  </section>
</for>
