<!--
  <sui-studio-rail> — Studio's navigation rail.

  The Studio surface is a deck view (views/studio/) whose nested routes
  (/studio/agents, /studio/agents/:id, …) each render this rail in their
  layout. The rail is a globally-registered chrome component (loaded in
  the sui-chrome aggregate) so the on-demand-compiled nested leaves can
  drop the `<sui-studio-rail>` tag without importing it — nested view
  controllers are bundled with `bun build` and can't resolve `.sui`
  imports.

  Navigation is plain deck: every entry is an `<a href="/studio/…">`,
  intercepted by the shell's anchor delegate (which walks composedPath,
  so shadow-DOM links route as SPA navigations). Active state is read
  from `location.pathname`, refreshed on popstate / sui:navigate.

  Only sections backed by a real deck view link out. The rest stay
  honest "soon" placeholders until their view lands — no fabricated
  destinations, no 404s.
-->

<style>
  :host {
    grid-area: rail;
    background: color-mix(in oklch, var(--sidebar, var(--surface-1)) 96%, transparent);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    min-height: 0;
    font-family: var(--font-body);
    color: var(--foreground);
  }

  .h {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    cursor: pointer;
  }
  .h:hover { background: var(--hover-bg); }
  .h-mark {
    width: 20px; height: 20px;
    border-radius: var(--radius-sm);
    display: inline-flex; align-items: center; justify-content: center;
    background: color-mix(in oklch, var(--primary) 16%, transparent);
    color: var(--primary);
    flex-shrink: 0;
  }
  .h-text {
    font-family: var(--heading-font);
    font-size: 13px;
    font-weight: var(--heading-weight);
    letter-spacing: var(--heading-tracking);
    color: var(--foreground);
  }
  .h-rule {
    width: 24px; height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--primary), transparent);
    margin-left: auto;
  }

  .section { padding: 12px 8px 8px; position: relative; }
  .section-h {
    display: flex; align-items: center; gap: 6px;
    padding: 0 8px 4px;
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .section-h-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: normal;
    letter-spacing: 0;
  }

  .item {
    display: flex; align-items: center; gap: 10px;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    color: var(--foreground);
    background: transparent;
    border: 0;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    width: 100%;
    font: inherit;
    transition: background 120ms, color 120ms;
  }
  .item:hover { background: var(--hover-bg); }
  .item[data-active] { background: color-mix(in oklch, var(--primary) 12%, transparent); }
  .item[data-active] .item-icon { color: var(--primary); }
  .item[data-active] .item-label { font-weight: var(--font-weight-semibold); }
  .item.is-soon { cursor: default; color: var(--muted-foreground); }
  .item.is-soon:hover { background: transparent; }

  .item-icon { color: var(--muted-foreground); display: inline-flex; }
  .item:hover .item-icon { color: var(--foreground); }
  .item.is-soon:hover .item-icon { color: var(--muted-foreground); }
  .item-label {
    font-size: 13px;
    flex: 1;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .item-count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-foreground);
    padding: 0 5px;
    border-radius: var(--radius-full);
  }
  .item[data-active] .item-count {
    background: color-mix(in oklch, var(--primary) 18%, transparent);
    color: var(--foreground);
  }
  .item-soon {
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 1px 6px;
  }

  .foot {
    margin-top: auto;
    padding: 8px;
    border-top: 1px solid var(--border-subtle);
  }
  .exit {
    display: flex; align-items: center; gap: 10px;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    background: transparent;
    border: 0;
    text-align: left;
    text-decoration: none;
    width: 100%;
    font: inherit;
    cursor: pointer;
    font-size: 12.5px;
  }
  .exit:hover { color: var(--foreground); background: var(--hover-bg); }
</style>

<a class="h" href="/studio" data-test="rail-home">
  <span class="h-mark" aria-hidden="true"><sui-icon name="grid" size="sm"></sui-icon></span>
  <span class="h-text">Studio</span>
  <span class="h-rule" aria-hidden="true"></span>
</a>

<nav class="section" aria-label="Configure">
  <div class="section-h">Configure <span class="section-h-count">{configureItems().length}</span></div>
  {#for item of configureItems() key={item.id}}
    <a class="item" data-test="rail-item"
      attr:data-section={item.id}
      attr:data-active={item.active}
      attr:href={item.href}>
      <span class="item-icon" aria-hidden="true"><sui-icon attr:name={item.icon} size="xs"></sui-icon></span>
      <span class="item-label">{item.label}</span>
      {#if item.count}<span class="item-count">{item.count}</span>{/if}
    </a>
  {/for}
</nav>

<div class="foot">
  <a class="exit" data-test="rail-close" href="/">
    <sui-icon name="chevron-left" size="xs"></sui-icon>
    <span>Close Studio</span>
  </a>
</div>
