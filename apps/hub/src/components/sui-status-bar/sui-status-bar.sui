<!--
  <sui-status-bar> — Ship's bottom bar. Shows the current build,
  the daemon connection state, and any active job count. Reads the
  actual RPC surface (ship.runtime.state() for the build + connection).
-->
<style>
  :host {
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 var(--space-3, 12px);
    border-top: 1px solid var(--border);
    background: var(--muted);
    color: var(--muted-foreground);
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 12px;
    flex-shrink: 0;
    box-sizing: border-box;
    gap: var(--space-2, 8px);
  }
  :host([hidden]) { display: none; }
  .item { display: inline-flex; align-items: center; gap: 6px; }
  .dot {
    width: 6px; height: 6px;
    border-radius: 999px;
    background: var(--muted-foreground);
  .dot[data-state="connected"] { background: var(--success); }
  .dot[data-state="disconnected"] { background: var(--destructive); }
</style>

<span class="item" title={buildTitle()}>
  <span class="dot" data-state={connState()}></span>
  <span>{connLabel()}</span>
</span>
<span class="spacer"></span>
<span class="item" title={jobTooltip()}>
  <span>{jobsLabel()}</span>
</span>
<span class="item">
  <span>{buildLabel()}</span>
</span>
