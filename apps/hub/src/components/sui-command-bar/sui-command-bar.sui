<!--
  <sui-command-bar> — Ship's command palette. Trigger pill + dialog;
  ⌘K opens, esc closes, type to filter, enter to select. Reads the
  actual RPC surface (ship.agents.summaries() for the agent
  catalog, ship.pipelines.list() for the pipeline catalog) — no
  hand-rolled `ops` wrappers, no KernelBridge.
-->
<prop name="open" type="bool" default="false" reflect />

<style>
  :host { display: inline-flex; align-items: center; min-width: 200px; }
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: 4px var(--space-3, 12px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--background);
    color: var(--muted-foreground);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    min-width: 200px;
    max-width: 320px;
    width: 100%;
    text-align: left;
  }
  .trigger:hover { border-color: color-mix(in oklch, var(--foreground) 30%, var(--border)); }
  .trigger kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }
  .label { flex: 1; }
  .dialog-body { padding: 0; }
  .wrap { display: flex; flex-direction: column; min-height: 0; }
  .input {
    display: block;
    width: 100%;
    padding: var(--space-3, 12px) var(--space-4, 16px);
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--foreground);
    font: inherit;
    font-size: 14px;
    outline: none;
    box-sizing: border-box;
  }
  .list { list-style: none; margin: 0; padding: 4px 0; max-height: 360px; overflow-y: auto; }
  .item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3, 12px);
    padding: 8px var(--space-4, 16px);
    cursor: pointer;
    color: var(--foreground);
  }
  .item[data-selected="true"] {
    background: color-mix(in oklch, var(--primary) 12%, transparent);
  }
  .item-kind {
    font-size: 11px;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .empty { padding: var(--space-4, 16px); color: var(--muted-foreground); text-align: center; }
</style>

<button
  class="trigger"
  type="button"
  aria-label="Open command bar"
  aria-haspopup="dialog"
  aria-expanded={open() ? 'true' : 'false'}
  on:click={openPalette}
>
  <sui-icon name="search" size="sm"></sui-icon>
  <span class="label">{triggerLabel()}</span>
  <kbd>⌘K</kbd>
</button>

<sui-dialog
  class="dialog-body"
  no-header
  no-footer
  no-close-button
  backdrop="blur"
  size="full"
  style="--dlg-max-w: min(640px, 94vw)"
  bind:this={dialogRef}
>
  <div class="wrap">
    <input
      class="input"
      type="text"
      placeholder="Search agents, pipelines, views..."
      aria-label="Command query"
      bind:value={query}
      on:keydown={onInputKey}
    />
    {#if filteredItems().length === 0}
      <div class="empty">No matches for "{query()}"</div>
    {:else}
      <div class="list" role="listbox" aria-label="Command results">
        {#for item of filteredItems() key={item.id}}
          <div
            class="item"
            role="option"
            data-selected={selectedIdx() === 0 ? 'true' : 'false'}
            data-kind={item.kind}
            on:click={() => selectItem(item)}
          >
            <span>{item.label}</span>
            <span class="item-kind">{item.kind}</span>
          </div>
        {/for}
      </div>
    {/if}
  </div>
</sui-dialog>
