<!--
  <sui-view-chrome> — hub-specific view chrome.

  A view's declarative contribution to the app's topbar + statusbar.
  Views never render their own breadcrumb or status bar — they emit
  a single <sui-view-chrome> and the chrome paints the bar on their
  behalf. Keeps first-party and third-party views symmetric.

  This is the hub's port of the shell's <sui-view-chrome>. The shell
  version moves its slot children into shell-owned containers
  (#view-topbar-actions, #view-status-start, #view-status-end) and
  writes attribute-driven fields into #breadcrumbs-title, #status-branch,
  #status-ab, #status-dot. Those DOM IDs are shell internals — the
  hub has no such layout, so the chrome is rendered inline as its own
  topbar/statusbar pair, with named shadow slots for the subregions
  the view wants to fill.

  Prop / event parity vs the shell version
  ─────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ─────────────────────────────────────────────────────────────────────────
  title  (string, '')          title  (string, '', reflect) breadcrumb leaf
  branch (string, '')          branch (string, '', reflect) status branch name
  ahead  (number, 0)           ahead  (number, 0,  reflect) ↑N commits
  behind (number, 0)           behind (number, 0,  reflect) ↓N commits
  tone   (union, 'default')    tone   (union, reflect)      status dot tint
  busy   (bool, false)         busy   (bool, false, reflect) pulse dot
  ─────────────────────────────────────────────────────────────────────────
  Slots (shadow DOM, named):
    topbar-start  — left of the breadcrumb leaf
    actions       — right of the breadcrumb leaf (right-aligned cluster)
    status-start  — left of the status bar
    status-end    — right of the status bar
  ─────────────────────────────────────────────────────────────────────────
  No chrome.* calls, no document.querySelector lookups: the chrome is
  a complete widget, not a forwarder. Attribute changes update the
  inline fields directly; slot content is rendered in place.
  ─────────────────────────────────────────────────────────────────────────
-->

<prop name="title" type="string" default="" reflect />
<prop name="branch" type="string" default="" reflect />
<prop name="ahead" type="number" default="0" reflect />
<prop name="behind" type="number" default="0" reflect />
<prop name="tone" values="default|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="busy" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    font-family: inherit;
    font-size: var(--text-sm, 13px);
  }
  :host([hidden]) { display: none; }

  .svc-bar {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--space-4, 16px);
    gap: var(--space-3, 12px);
  }
  .svc-topbar { border-bottom: 1px solid var(--border); }
  .svc-statusbar { color: var(--muted-foreground); font-size: var(--text-xs, 12px); }

  .svc-leaf {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: var(--font-weight-semibold, 600);
  }
  .svc-leaf:empty::before {
    content: '\00a0';
  }

  .svc-slot-start,
  .svc-slot-end {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 8px);
    min-width: 0;
  }
  .svc-slot-start { flex: 0 0 auto; }
  .svc-slot-end { flex: 0 0 auto; margin-left: auto; }

  .svc-spacer { flex: 1 1 auto; min-width: 0; }

  .svc-branch {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 12px);
    color: var(--muted-foreground);
  }
  .svc-branch:empty { display: none; }
  .svc-branch::before {
    content: '';
  }
  .svc-ab {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    color: var(--muted-foreground);
    display: inline-flex;
    gap: 6px;
  }
  .svc-ab:empty { display: none; }

  .svc-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full, 9999px);
    background: currentColor;
    color: var(--muted-foreground);
    transition: background var(--duration-fast, 100ms) var(--ease-out, ease-out);
  }
  .svc-dot[data-tone='success']      { color: var(--success, #16a34a); }
  .svc-dot[data-tone='warning']      { color: var(--warning, #d97706); }
  .svc-dot[data-tone='destructive']  { color: var(--destructive, #dc2626); }
  .svc-dot[data-tone='accent']       { color: var(--accent, #7c3aed); }
  .svc-dot[data-tone='muted']        { color: var(--muted-foreground, #6b7280); }
  .svc-dot[data-tone='default']      { color: var(--muted-foreground, #6b7280); }
  .svc-dot[data-busy] {
    animation: svc-pulse 1.4s var(--ease-in-out, ease-in-out) infinite;
  }
  @keyframes svc-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-dot[data-busy] { animation: none; }
  }
</style>

<header class="svc-bar svc-topbar" part="topbar" data-test="view-chrome-topbar">
  <span class="svc-slot-start" part="topbar-start">
    <slot name="topbar-start"></slot>
  </span>
  <span class="svc-leaf" part="title" data-test="view-chrome-title">{title()}</span>
  <span class="svc-spacer"></span>
  <span class="svc-slot-end" part="actions">
    <slot name="actions"></slot>
  </span>
</header>

<div class="svc-bar svc-statusbar" part="statusbar" data-test="view-chrome-statusbar">
  <span class="svc-slot-start" part="status-start">
    <slot name="status-start"></slot>
  </span>
  <span class="svc-spacer"></span>
  {#if branch()}
    <span class="svc-branch" part="branch" data-test="view-chrome-branch">{branch()}</span>
  {/if}
  {#if ahead() > 0 || behind() > 0}
    <span class="svc-ab" part="ahead-behind" data-test="view-chrome-ab">
      {#if ahead() > 0}<span>↑{ahead()}</span>{/if}
      {#if behind() > 0}<span>↓{behind()}</span>{/if}
    </span>
  {/if}
  {#if tone() !== 'default' || busy()}
    <span
      class="svc-dot"
      part="dot"
      data-test="view-chrome-dot"
      attr:data-tone={tone() !== 'default' ? tone() : null}
      attr:data-busy={busy() ? '' : null}
      aria-hidden="true"
    ></span>
  {/if}
  <span class="svc-slot-end" part="status-end">
    <slot name="status-end"></slot>
  </span>
</div>
