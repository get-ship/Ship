{
  "name": "@ship/hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The hub \u2014 Ship's primary SPA. The single user-facing frontend served by shipd (at /). Built by `deck build` (deck-cli) from this three-file project (package.json + routes/ + public/). Everything else (index.html, routes.gen.ts, the entry chunk) is generated by the bundler.",
  "scripts": {
    "build": ". \"$PWD/../../scripts/_sui-root.sh\" && DECK_FRAMEWORK_ASSETS_DIR=\"$DECK_FRAMEWORK_ASSETS_DIR\" cargo run --manifest-path \"$SUI_ROOT/Cargo.toml\" -q -p deck-cli -- build --project . --bundle-framework",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  },
  "deck": {
    "bundles": [
      {
        "name": "ship-studio",
        "entry": "src/studio/index.ts",
        "externals": [
          "@ship/sail-runtime",
          "@ship/sail-dom",
          "@ship/sdk-client"
        ],
        "lazy": true
      }
    ]
  },
  "dependencies": {
    "@ship/agents": "workspace:*",
    "@ship/chrome": "workspace:*",
    "@ship/shared": "workspace:*",
    "@ship/collections": "workspace:*",
    "@ship/deck-router": "*",
    "@ship/home": "workspace:*",
    "@ship/skills": "workspace:*",
    "@ship/sdk-client": "^0.1.0",
    "@ship/sail-chat-elements": "*",
    "@ship/sail-dom": "*",
    "@ship/sail-primitives": "*",
    "@ship/sail-runtime": "*"
  }
}
