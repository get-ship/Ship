{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ship-auth-local",
      "database_id": "local-auth",
      "migrations_dir": "migrations/auth"
    },
    {
      "binding": "REGISTRY_DB",
      "database_name": "ship-registry-local",
      "database_id": "local-registry",
      "migrations_dir": "migrations/registry"
    }
  ],
  "vars": {
    "GITHUB_CLIENT_ID": "",
    "GITHUB_CLIENT_SECRET": "",
    "GITHUB_WEBHOOK_SECRET": "",
    "JWT_SECRET": ""
  }
}
