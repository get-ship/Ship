{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "lib": ["ESNext"],
    "types": [
      "../workers/types/cloudflare-runtime.d.ts",
      "../workers/types/vite-env.d.ts",
      "./worker-env.d.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["src/**/*", "test/**/*"],
  "references": [
    { "path": "../workers/platform" },
    { "path": "../workers/project" },
    { "path": "../../packages/cloud-types" }
  ]
}
