{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Platform",
        "name": "PLATFORM",
        "script_name": "platform-handler"
      },
      {
        "class_name": "Project",
        "name": "PROJECT",
        "script_name": "project-handler"
      }
    ]
  },
  // Local dev bindings (Miniflare). Secrets set via `wrangler secret put` per env.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ship-auth-local",
      "database_id": "local-auth",
      "migrations_dir": "migrations/auth"
    },
    {
      "binding": "REGISTRY_DB",
      "database_name": "ship-registry-local",
      "database_id": "local-registry",
      "migrations_dir": "migrations/registry"
    }
  ],
  "vars": {
    "GITHUB_CLIENT_ID": "",
    "GITHUB_CLIENT_SECRET": "",
    "GITHUB_WEBHOOK_SECRET": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": "",
    "SLACK_CLIENT_ID": "",
    "SLACK_CLIENT_SECRET": "",
    "JWT_SECRET": "",
    // Stripe — STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must be set via
    // `wrangler secret put` per env. STRIPE_PRICE_PRO is the Price ID from
    // the Stripe dashboard for the Pro plan; per-env (test vs live mode).
    "STRIPE_SECRET_KEY": "",
    "STRIPE_WEBHOOK_SECRET": "",
    "STRIPE_PRICE_PRO": "",
    // Feature flags — default OFF. Enable per-env via wrangler env.<env>.vars
    // override (no secret needed; not sensitive).
    "SHIP_CLOUD_ENABLED": "false",
    "STRIPE_LIVE_MODE": "false",
    "EMAIL_LIVE_MODE": "false",
    "MACAROON_ENFORCEMENT": "false",
    // Build identification — `wrangler deploy` doesn't auto-stamp these;
    // set via CI in env.<env>.vars or leave for /api/version to return 'dev'.
    "GATEWAY_VERSION": "dev",
    "BUILD_SHA": "unknown"
  },
  // KV bindings. Create with:
  //   wrangler kv namespace create WAITLIST [--env staging|production]
  // WAITLIST holds long-lived email-capture entries (per-list, deduped by
  // hashed email).
  "kv_namespaces": [
    { "binding": "WAITLIST", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  // Transactional email via Cloudflare Email (beta). `remote: true` keeps
  // local `wrangler dev` from blasting real mail.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "env": {
    "staging": {
      "name": "gateway-staging",
      "routes": [
        { "pattern": "staging.getship.dev/*", "zone_name": "getship.dev" }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "ship-auth-staging",
          "database_id": "8ed88437-8d37-429a-8309-186b509bdb6c",
          "migrations_dir": "migrations/auth"
        },
        {
          "binding": "REGISTRY_DB",
          "database_name": "ship-registry-staging",
          "database_id": "5f360153-5ba4-4bc4-8661-5a34f26a93bd",
          "migrations_dir": "migrations/registry"
        }
      ],
      "ratelimits": [
        { "name": "RATE_LIMITER_PUBLISH",  "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMITER_CLAIM",    "namespace_id": "1002", "simple": { "limit": 5,  "period": 60 } },
        { "name": "RATE_LIMITER_INSTALL",  "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
        { "name": "RATE_LIMITER_SEARCH",   "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
        { "name": "RATE_LIMITER_STAR",     "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
      ]
    },
    "production": {
      "name": "gateway-production",
      "routes": [
        { "pattern": "api.getship.dev/*", "zone_name": "getship.dev" }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "ship-auth",
          "database_id": "11371c7b-f2b9-4084-a7ad-d1be24b0ddf8",
          "migrations_dir": "migrations/auth"
        },
        {
          "binding": "REGISTRY_DB",
          "database_name": "ship-registry",
          "database_id": "169f1ff8-dc1c-4d66-b3bf-773aee944965",
          "migrations_dir": "migrations/registry"
        }
      ],
      "ratelimits": [
        { "name": "RATE_LIMITER_PUBLISH",  "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMITER_CLAIM",    "namespace_id": "1002", "simple": { "limit": 5,  "period": 60 } },
        { "name": "RATE_LIMITER_INSTALL",  "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
        { "name": "RATE_LIMITER_SEARCH",   "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
        { "name": "RATE_LIMITER_STAR",     "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
