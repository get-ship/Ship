{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Platform",
        "name": "PLATFORM",
        "script_name": "platform-handler"
      },
      {
        "class_name": "Workspace",
        "name": "WORKSPACE",
        "script_name": "workspace-handler"
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
