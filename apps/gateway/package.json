    "@connectrpc/connect": "^2.0.3",
    "@ship-cloud/types": "workspace:*",
    "better-auth": "^1.5.3",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "^6.2.2",
    "stripe": "^22.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.69.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.75.0"
  }
}
