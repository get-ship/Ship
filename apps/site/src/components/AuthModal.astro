---
// Site-level auth modal wrapper. Renders a progressive-enhancement-
// friendly stack:
//   1. Server output = a plain <form> that posts to /api/auth/… (stub).
//      Works without JS.
//   2. On load, <ship-auth-dialog> hydrates and takes over — the native
//      form becomes the dialog's body (via the default slot).
//
// `data-mode` on the host is read by the client script to pick the
// initial tab. `data-auto-open` makes the dialog open on page load so
// /sign-in and /sign-up become true modal routes.
interface Props {
  mode?: 'sign-in' | 'sign-up';
  autoOpen?: boolean;
}
const { mode = 'sign-in', autoOpen = false } = Astro.props;
---

<ship-auth-dialog
  class="site-auth"
  mode={mode}
  data-mode={mode}
  data-auto-open={autoOpen ? 'true' : 'false'}
>
  <span slot="header">
    {mode === 'sign-up' ? 'Create your account' : 'Welcome back'}
  </span>

  <div slot="providers" class="site-auth-providers">
    <ship-button variant="outline" size="md" data-provider="github">
      <svg
        slot="leading"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39 10.93 10.93 0 0 1 2.87.39c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.23 2.77.12 3.06.73.81 1.17 1.84 1.17 3.1 0 4.42-2.69 5.4-5.26 5.68.42.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
      </svg>
      Continue with GitHub
    </ship-button>
  </div>

  <span slot="terms">
    GitHub sign-in lands with the public-beta release. Leave your email
    below and we&rsquo;ll let you know the moment it&rsquo;s live.
  </span>
</ship-auth-dialog>

<script>
  const dialog = document.querySelector('ship-auth-dialog.site-auth') as
    | (HTMLElement & { show?: () => void; close?: () => void; open?: boolean })
    | null;
  if (dialog) {
    const auto = dialog.getAttribute('data-auto-open') === 'true';
    if (auto) {
      customElements.whenDefined('ship-auth-dialog').then(() => {
        dialog.setAttribute('open', '');
      });
    }

    dialog.addEventListener('ship-close', () => {
      // If this is a dedicated route (/sign-in or /sign-up), send the
      // visitor back to where they came from so the URL doesn't leave
      // them stuck on an empty page.
      const dedicated =
        location.pathname === '/sign-in' || location.pathname === '/sign-up';
      if (!dedicated) return;
      const back = document.referrer && new URL(document.referrer).origin === location.origin
        ? document.referrer
        : '/';
      setTimeout(() => { location.href = back; }, 160);
    });

    dialog.addEventListener('ship-auth-submit', (e: Event) => {
      const detail = (e as CustomEvent<{ mode: string; email: string; password: string }>).detail;
      // Better Auth isn't wired from the marketing site yet; this is
      // an email capture so we can ping the user on launch. Be honest
      // in the message.
      console.info('[auth:waitlist]', detail.email);
      const form = dialog.querySelector('form');
      if (form) form.innerHTML =
        '<p class="site-auth-thanks">You\u2019re on the list &mdash; ' +
        'we\u2019ll email <strong>' + detail.email + '</strong> the ' +
        'moment sign-in is live.</p>';
    });
  }

  // Expose a minimal API for the nav "Sign in" link to open the dialog
  // without a full page navigation when already on-site.
  (window as any).ship = {
    ...((window as any).ship ?? {}),
    openAuth(nextMode: 'sign-in' | 'sign-up' = 'sign-in') {
      if (!dialog) return false;
      dialog.setAttribute('mode', nextMode);
      customElements.whenDefined('ship-auth-dialog').then(() => {
        dialog.setAttribute('open', '');
      });
      return true;
    },
  };
</script>

<style>
  .site-auth-providers {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .site-auth-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site-auth-thanks {
    color: var(--foreground);
    font-size: 14px;
    line-height: 1.55;
    padding: 14px 0 6px;
    text-align: center;
  }
  .site-auth-thanks strong {
    color: var(--primary);
    font-weight: 600;
  }
</style>
