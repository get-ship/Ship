---
import HeroAnimation from './HeroAnimation.astro';
import ProviderStrip from './ProviderStrip.astro';

const pillars = [
  { title: 'Pipelines', copy: 'Orchestrate 5 AI providers with 50 lines of JSON.', tone: 'accent', kbd: 'pipelines' },
  { title: 'Views', copy: 'Custom UI with your data in seconds — 15% of the React code.', tone: 'info', kbd: 'views' },
  { title: 'Control', copy: 'Permissions, skills, governance. Your data, your models.', tone: 'success', kbd: 'control' },
];
---

<section class="hero">
  <div class="site-container hero-inner">
    <ship-badge tone="accent" variant="soft" size="sm" class="hero-eyebrow">
      <ship-status-dot tone="success" pulse slot="leading"></ship-status-dot>
      Public beta &middot; v0.9
    </ship-badge>

    <h1 class="hero-headline">
      The missing <span class="hero-accent">AI interface.</span>
    </h1>

    <p class="hero-sub">
      Ship transforms the way you work with AI. Build apps, orchestrate models,
      and control your data &mdash; locally, with no lock&#8209;in.
    </p>

    <ship-toolbar justify="center" gap="md" class="hero-ctas">
      <ship-button
        tone="accent"
        variant="solid"
        size="lg"
        onclick="location.href='/download'"
      >Download for your platform</ship-button>
      <ship-button
        variant="ghost"
        size="lg"
        onclick="location.href='#pillars'"
      >See how it works &rarr;</ship-button>
    </ship-toolbar>

    <HeroAnimation />

    <ProviderStrip />

    <ul class="hero-pillars" id="pillars">
      {pillars.map((p) => (
        <li>
          <ship-card
            variant="outline"
            status-rail
            tone={p.tone}
            padding="lg"
            class="hero-pillar-card"
          >
            <div slot="header" class="hero-pillar-head">
              <ship-badge tone={p.tone} variant="soft" size="sm">{p.kbd}</ship-badge>
              <span class="hero-pillar-title">{p.title}</span>
            </div>
            <p class="hero-pillar-copy">{p.copy}</p>
          </ship-card>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 64px;
    padding-bottom: 96px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -10% 0 20%;
    background:
      radial-gradient(40% 50% at 20% 30%, var(--site-halo-1) 0%, transparent 65%),
      radial-gradient(40% 40% at 80% 20%, var(--site-halo-2) 0%, transparent 65%),
      radial-gradient(50% 50% at 60% 80%, var(--site-halo-3) 0%, transparent 65%);
    opacity: 0.55;
    z-index: -1;
  }
  :root[data-theme='warm'] .hero::before {
    opacity: 0.35;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }

  .hero-eyebrow {
    --ship-badge-radius: 999px;
  }

  .hero-headline {
    max-width: 14ch;
    margin-inline: auto;
  }
  .hero-accent {
    background: linear-gradient(110deg, var(--site-accent) 15%, var(--site-halo-1) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    max-width: 58ch;
    margin-inline: auto;
    color: var(--site-muted-fg);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.55;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
  }
  .hero-cta-a {
    color: inherit;
    text-decoration: none;
    display: inline-block;
  }

  .hero-pillars {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 16px;
    width: 100%;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 900px;
  }
  .hero-pillars li {
    display: block;
  }
  .hero-pillar-card {
    height: 100%;
    display: block;
    text-align: left;
  }
  .hero-pillar-head {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-pillar-title {
    font-family: var(--site-font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--site-fg);
  }
  .hero-pillar-copy {
    color: var(--site-muted-fg);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .hero-pillars {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 40px;
      padding-bottom: 56px;
    }
  }
</style>
