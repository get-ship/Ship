---
// Hero: tagline, sub-copy, CTAs, and a centerpiece.
//
// The centerpiece is a <video> if a source is provided, otherwise falls
// back to the CSS/SVG view-composition animation. The slot is a real
// content-visibility island so a future .mp4/.webm capture can drop in
// without a refactor.
import HeroAnimation from './HeroAnimation.astro';
import ProviderStrip from './ProviderStrip.astro';

interface Props {
  videoSrc?: string;
  videoPoster?: string;
}

const { videoSrc, videoPoster } = Astro.props;
---

<section class="hero">
  <div class="site-container hero-inner">
    <ship-badge tone="accent" variant="soft" size="sm" class="hero-eyebrow">
      <ship-status-dot tone="success" pulse slot="leading"></ship-status-dot>
      Public beta &middot; v0.9
    </ship-badge>

    <h1 class="hero-headline">
      The missing <span class="hero-accent">AI interface.</span>
    </h1>

    <p class="hero-sub">
      Ship transforms the way you work with AI. Build apps, orchestrate
      models, and control your data &mdash; locally, with no
      lock&#8209;in.
    </p>

    <ship-toolbar justify="center" gap="md" class="hero-ctas">
      <ship-button
        tone="accent"
        variant="solid"
        size="lg"
        onclick="location.href='/download'"
      >Download for your platform</ship-button>
      <ship-button
        variant="ghost"
        size="lg"
        onclick="document.getElementById('features')?.scrollIntoView({behavior:'smooth'})"
      >See how it works &rarr;</ship-button>
    </ship-toolbar>

    <div class="hero-stage">
      {videoSrc ? (
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={videoPoster}
        >
          <source src={videoSrc} type="video/mp4" />
        </video>
      ) : (
        <HeroAnimation />
      )}
    </div>

    <ProviderStrip />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 72px;
    padding-bottom: 80px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -10% 0 20%;
    background:
      radial-gradient(40% 50% at 20% 30%, var(--site-halo-1) 0%, transparent 65%),
      radial-gradient(40% 40% at 80% 20%, var(--site-halo-2) 0%, transparent 65%),
      radial-gradient(50% 50% at 60% 80%, var(--site-halo-3) 0%, transparent 65%);
    opacity: 0.55;
    z-index: -1;
  }
  :root[data-theme='warm'] .hero::before { opacity: 0.35; }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }

  .hero-eyebrow {
    --ship-badge-radius: 999px;
  }

  .hero-headline {
    max-width: 14ch;
    margin-inline: auto;
  }
  .hero-accent {
    background: linear-gradient(110deg, var(--site-accent) 15%, var(--site-halo-1) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    max-width: 58ch;
    margin-inline: auto;
    color: var(--muted-foreground);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.55;
  }

  .hero-ctas { margin-top: 4px; }

  .hero-stage {
    width: 100%;
    max-width: 880px;
    margin: 12px auto 0;
  }
  .hero-video {
    width: 100%;
    border-radius: 18px;
    box-shadow:
      0 1px 2px color-mix(in oklch, var(--foreground) 5%, transparent),
      0 32px 64px -24px color-mix(in oklch, var(--site-accent) 28%, transparent);
    background: var(--card);
  }

  @media (max-width: 760px) {
    .hero { padding-top: 48px; padding-bottom: 56px; }
  }
</style>
