---
// Highlight 3 — "See what ran, keep what matters."
//
// Two panels: a weekly "what your agents did" summary card (with a
// cost curve + headline numbers) and a recent activity timeline.
// Frames governance / observability as consumer value: knowing what
// you spent, what was done, and what to keep.

const recent = [
  { time: 'today 09:14',   label: 'Weekly digest sent',        detail: 'Claude · 42s · $0.04', tone: 'success' },
  { time: 'today 08:22',   label: 'Release post drafted',      detail: 'Claude + Gemini · 1m 18s',  tone: 'accent' },
  { time: 'yesterday',     label: 'Inbox triage',              detail: '27 messages · 8 action items', tone: 'info' },
  { time: 'yesterday',     label: 'PR review: fix/cli-errors', detail: 'ChatGPT · ~1k tokens', tone: 'success' },
  { time: '2 days ago',    label: 'Morning brief',             detail: 'Claude · $0.03',       tone: 'info' },
];

const spark = [2, 4, 3, 6, 5, 9, 7];
const max = Math.max(...spark);
const points = spark
  .map((v, i) => {
    const x = (i / (spark.length - 1)) * 160;
    const y = 44 - (v / max) * 36 - 2;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
---

<section class="hl hl-observe" data-visible="false">
  <div class="site-container hl-inner">
    <header class="hl-head">
      <ship-badge tone="success" variant="soft" size="sm">See what ran, keep what matters</ship-badge>
      <h2>Every run, every token, in plain sight.</h2>
      <p class="hl-sub">
        Know what your agents did, when, and what it cost &mdash; no
        surprise bills, no black-box decisions. Pin the outputs you
        want, delete the ones you don&rsquo;t. Share read-only access
        with a teammate without handing them your keys.
      </p>
    </header>

    <div class="hl-demo">
      <ship-card variant="outline" padding="lg" class="hl-summary">
        <div slot="header" class="hl-summary-head">
          <div>
            <div class="hl-summary-title">This week</div>
            <div class="hl-summary-sub">12 runs &middot; 4 agents</div>
          </div>
          <ship-badge tone="success" variant="soft" size="sm">on budget</ship-badge>
        </div>

        <div class="hl-summary-stats">
          <div class="hl-stat">
            <div class="hl-stat-num">$1.84</div>
            <div class="hl-stat-label">spent</div>
          </div>
          <div class="hl-stat">
            <div class="hl-stat-num">6h&nbsp;12m</div>
            <div class="hl-stat-label">time saved</div>
          </div>
          <div class="hl-stat">
            <div class="hl-stat-num">28</div>
            <div class="hl-stat-label">items pinned</div>
          </div>
        </div>

        <svg
          class="hl-summary-spark"
          viewBox="0 0 160 44"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <polyline
            points={points}
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <div class="hl-summary-axis">
          <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span>
          <span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
      </ship-card>

      <ship-card variant="outline" padding="lg" class="hl-recent">
        <div slot="header" class="hl-summary-head">
          <div>
            <div class="hl-summary-title">Recent runs</div>
            <div class="hl-summary-sub">newest first</div>
          </div>
          <ship-badge tone="muted" variant="outline" size="sm">live</ship-badge>
        </div>

        <ul class="hl-recent-rows">
          {recent.map((r, i) => (
            <li class="hl-recent-row" style={`--i: ${i}`}>
              <ship-status-dot tone={r.tone}></ship-status-dot>
              <div class="hl-recent-body">
                <div class="hl-recent-label">{r.label}</div>
                <div class="hl-recent-detail">{r.detail}</div>
              </div>
              <span class="hl-recent-time">{r.time}</span>
            </li>
          ))}
        </ul>

        <ship-separator class="hl-recent-sep"></ship-separator>
        <div class="hl-recent-foot">
          One click to replay, export, or share with your team.
        </div>
      </ship-card>
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.setAttribute('data-visible', 'true');
          obs.unobserve(e.target);
        }
      }
    },
    { threshold: 0.2 },
  );
  document.querySelectorAll('.hl-observe').forEach((el) => obs.observe(el));
</script>

<style>
  .hl {
    padding: clamp(72px, 10vw, 128px) 0;
    position: relative;
  }
  .hl-inner {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  .hl-head {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .hl-sub {
    color: var(--muted-foreground);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.55;
  }

  .hl-demo {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .hl-demo { grid-template-columns: 1fr; }
  }

  .hl-summary,
  .hl-recent {
    display: block;
    transition:
      opacity 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms,
      transform 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms;
  }
  .hl-recent {
    transition-delay: 180ms;
  }
  :root.js .hl-observe[data-visible='false'] .hl-summary,
  :root.js .hl-observe[data-visible='false'] .hl-recent {
    opacity: 0;
    transform: translateY(16px);
  }
  .hl-observe[data-visible='true'] .hl-summary,
  .hl-observe[data-visible='true'] .hl-recent {
    opacity: 1;
    transform: none;
  }
  .hl-summary-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .hl-summary-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .hl-summary-sub {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 2px;
  }
  .hl-summary-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 20px 0 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
  }
  .hl-stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--foreground);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hl-stat-label {
    font-size: 11px;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 6px;
  }
  .hl-summary-spark {
    width: 100%;
    height: 52px;
    color: oklch(0.58 0.15 150);
  }
  .hl-summary-axis {
    display: flex;
    justify-content: space-between;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 10.5px;
    margin-top: 4px;
  }

  .hl-recent-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .hl-recent-row {
    display: grid;
    grid-template-columns: 12px 1fr auto;
    column-gap: 12px;
    align-items: center;
    padding: 10px 2px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
    transition:
      opacity 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    transition-delay: calc(320ms + var(--i) * 90ms);
  }
  .hl-recent-row:last-child { border-bottom: 0; }
  :root.js .hl-observe[data-visible='false'] .hl-recent-row {
    opacity: 0;
    transform: translateY(4px);
  }
  .hl-observe[data-visible='true'] .hl-recent-row {
    opacity: 1;
    transform: none;
  }
  .hl-recent-label {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--foreground);
  }
  .hl-recent-detail {
    color: var(--muted-foreground);
    font-size: 12px;
    margin-top: 2px;
  }
  .hl-recent-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .hl-recent-sep { display: block; margin: 12px 0 10px; }
  .hl-recent-foot {
    color: var(--muted-foreground);
    font-size: 12px;
    text-align: center;
  }

  @media (max-width: 540px) {
    .hl-summary-stats { grid-template-columns: 1fr 1fr; }
  }
</style>
