---
// Highlight 3 — Observe.
//
// Permissions config on the left (JSONC), a live audit-log card on the
// right with allowed/denied decisions and a 7-day activity sparkline.
// Same IO stagger pattern as the other highlights.

const auditRows = [
  { time: '14:02', actor: 'agent.cmdr',  action: 'read',  target: '.ship/views/tasks.json', decision: 'allow' },
  { time: '14:02', actor: 'agent.cmdr',  action: 'write', target: 'collections/task',        decision: 'allow' },
  { time: '14:03', actor: 'skill.review',action: 'net',   target: 'api.github.com',          decision: 'deny'  },
  { time: '14:05', actor: 'agent.cmdr',  action: 'spawn', target: 'agent.tester',            decision: 'allow' },
  { time: '14:06', actor: 'skill.deploy',action: 'run',   target: 'wrangler deploy',         decision: 'deny'  },
];

const spark = [4, 9, 6, 14, 11, 22, 18];
const max = Math.max(...spark);
const points = spark
  .map((v, i) => {
    const x = (i / (spark.length - 1)) * 120;
    const y = 36 - (v / max) * 30 - 2;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
---

<section class="hl hl-observe" data-visible="false">
  <div class="site-container hl-inner">
    <header class="hl-head">
      <ship-badge tone="success" variant="soft" size="sm">03 &middot; Observe</ship-badge>
      <h2>Governance you can read in plaintext.</h2>
      <p class="hl-sub">
        Permissions, skill scopes, model budgets, and every action your
        agents take &mdash; all in one file, all auditable. Ship enforces
        the policy at runtime and streams the audit log into the same
        views your team already uses.
      </p>
    </header>

    <div class="hl-demo">
      <ship-card variant="outline" padding="none" class="hl-code">
        <div slot="header" class="hl-code-head">
          <ship-badge tone="muted" variant="outline" size="sm">permissions.jsonc</ship-badge>
          <span class="hl-code-meta">enforced by <strong>shipd</strong></span>
        </div>
<pre class="hl-code-pre"><code><span class="c">// One file. Readable. Diffable. Auditable.</span>
<span class="k">{</span>
  <span class="s">"allow"</span>: <span class="k">{</span>
    <span class="s">"read"</span>:  <span class="k">[</span> <span class="v">".ship/**"</span>, <span class="v">"collections/**"</span> <span class="k">]</span>,
    <span class="s">"write"</span>: <span class="k">[</span> <span class="v">"collections/task"</span> <span class="k">]</span>,
    <span class="s">"net"</span>:   <span class="k">[</span> <span class="v">"api.anthropic.com"</span>, <span class="v">"api.openai.com"</span> <span class="k">]</span>
  <span class="k">}</span>,
  <span class="s">"budget"</span>: <span class="k">{</span>
    <span class="s">"tokens_per_day"</span>: <span class="n">250000</span>,
    <span class="s">"runs_per_hour"</span>:  <span class="n">60</span>
  <span class="k">}</span>
<span class="k">}</span></code></pre>
      </ship-card>

      <div class="hl-audit">
        <ship-card variant="outline" padding="lg" class="hl-audit-card">
          <div slot="header" class="hl-code-head">
            <div class="hl-audit-title">
              <ship-badge tone="success" variant="soft" size="sm">audit log</ship-badge>
              <span class="hl-audit-note">last 5 decisions</span>
            </div>
            <ship-badge tone="muted" variant="outline" size="sm">live</ship-badge>
          </div>

          <div class="hl-audit-stat">
            <div>
              <div class="hl-audit-num">98<span class="hl-audit-pct">%</span></div>
              <div class="hl-audit-label">allowed this week</div>
            </div>
            <svg
              class="hl-audit-spark"
              viewBox="0 0 120 36"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <polyline
                points={points}
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <ul class="hl-audit-rows">
            {auditRows.map((r, i) => (
              <li class="hl-audit-row" data-decision={r.decision} style={`--i: ${i}`}>
                <span class="hl-audit-time">{r.time}</span>
                <span class="hl-audit-actor">{r.actor}</span>
                <span class="hl-audit-action">{r.action}</span>
                <span class="hl-audit-target">{r.target}</span>
                <ship-badge
                  tone={r.decision === 'allow' ? 'success' : 'destructive'}
                  variant="soft"
                  size="sm"
                  class="hl-audit-decision"
                >{r.decision}</ship-badge>
              </li>
            ))}
          </ul>
        </ship-card>
      </div>
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.setAttribute('data-visible', 'true');
          obs.unobserve(e.target);
        }
      }
    },
    { threshold: 0.2 },
  );
  document.querySelectorAll('.hl-observe').forEach((el) => obs.observe(el));
</script>

<style>
  .hl {
    padding: clamp(72px, 10vw, 128px) 0;
    position: relative;
  }
  .hl-inner {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  .hl-head {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .hl-sub {
    color: var(--muted-foreground);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.55;
  }

  .hl-demo {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .hl-demo { grid-template-columns: 1fr; }
  }

  .hl-code {
    display: flex;
    flex-direction: column;
    transition:
      opacity 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms,
      transform 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms;
  }
  :root.js .hl-observe[data-visible='false'] .hl-code {
    opacity: 0;
    transform: translateY(16px);
  }
  .hl-observe[data-visible='true'] .hl-code { opacity: 1; transform: none; }
  .hl-code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 16px;
  }
  .hl-code-meta {
    color: var(--muted-foreground);
    font-size: 12px;
  }
  .hl-code-meta strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .hl-code-pre {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    padding: 18px 20px;
    margin: 0;
    color: var(--foreground);
    background: color-mix(in oklch, var(--muted) 30%, transparent);
    overflow: auto;
    max-height: 360px;
    tab-size: 2;
  }
  .hl-code-pre .k { color: var(--muted-foreground); }
  .hl-code-pre .s { color: var(--site-accent); }
  .hl-code-pre .v { color: oklch(0.60 0.16 150); }
  .hl-code-pre .c { color: color-mix(in oklch, var(--muted-foreground) 80%, transparent); font-style: italic; }
  .hl-code-pre .n { color: oklch(0.72 0.15 50); }

  .hl-audit-card {
    display: block;
    transition:
      opacity 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 180ms,
      transform 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 180ms;
  }
  :root.js .hl-observe[data-visible='false'] .hl-audit-card {
    opacity: 0;
    transform: translateY(16px);
  }
  .hl-observe[data-visible='true'] .hl-audit-card {
    opacity: 1;
    transform: none;
  }
  .hl-audit-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .hl-audit-note {
    color: var(--muted-foreground);
    font-size: 12px;
  }

  .hl-audit-stat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    margin-bottom: 8px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
  }
  .hl-audit-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    letter-spacing: -0.02em;
    color: var(--foreground);
    line-height: 1;
  }
  .hl-audit-pct { font-size: 20px; margin-left: 2px; }
  .hl-audit-label {
    font-size: 11px;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 4px;
  }
  .hl-audit-spark {
    width: 140px;
    height: 40px;
    color: oklch(0.60 0.16 150);
  }

  .hl-audit-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hl-audit-row {
    display: grid;
    grid-template-columns: 48px 1fr auto auto;
    column-gap: 10px;
    align-items: center;
    padding: 8px 2px;
    font-size: 12px;
    color: var(--foreground);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
    transition:
      opacity 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    transition-delay: calc(360ms + var(--i) * 90ms);
  }
  :root.js .hl-observe[data-visible='false'] .hl-audit-row {
    opacity: 0;
    transform: translateX(8px);
  }
  .hl-observe[data-visible='true'] .hl-audit-row {
    opacity: 1;
    transform: none;
  }
  .hl-audit-row:last-child { border-bottom: 0; }
  .hl-audit-time {
    font-family: var(--font-mono);
    color: var(--muted-foreground);
    font-size: 11.5px;
  }
  .hl-audit-actor {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hl-audit-action {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
  }
  .hl-audit-target {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    grid-column: 4 / 5;
    max-width: 220px;
  }
  .hl-audit-decision {
    grid-column: 5 / 6;
  }

  @media (max-width: 540px) {
    .hl-audit-row {
      grid-template-columns: auto 1fr auto;
      row-gap: 2px;
    }
    .hl-audit-target {
      grid-column: 1 / -1;
      max-width: 100%;
    }
    .hl-audit-decision { grid-column: 3 / 4; }
  }
</style>
