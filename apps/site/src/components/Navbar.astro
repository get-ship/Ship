---
import ThemeSwitcher from './ThemeSwitcher.astro';

const SHOW_PRICING = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_PRICING === 'true';
const SHOW_ACCOUNT = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_ACCOUNT === 'true';
const SHOW_BILLING = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_BILLING === 'true';
const SHOW_AUTH    = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_AUTH === 'true';

const links = [
  { href: '/features', label: 'Features' },
  { href: '/store', label: 'Store' },
  ...(SHOW_PRICING ? [{ href: '/pricing', label: 'Pricing' }] : []),
  { href: '/download', label: 'Download' },
  { href: 'https://docs.getship.dev', label: 'Docs' },
];
---

<header class="site-nav">
  <div class="site-nav-inner">
    <a class="site-nav-brand" href="/" aria-label="SHIP home">
      <sui-brand-mark size="md" class="site-nav-mark"></sui-brand-mark>
      <span class="site-nav-wordmark">SHIP</span>
    </a>

    <nav class="site-nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="site-nav-actions" data-auth-area>
      <ThemeSwitcher />
      {SHOW_AUTH ? (
        <sui-button variant="ghost" size="sm" class="site-nav-anon">
          <a href="/sign-in" class="site-nav-link-reset">Sign in</a>
        </sui-button>
      ) : (
        <sui-button variant="ghost" size="sm" class="site-nav-anon">
          <a href="/waitlist" class="site-nav-link-reset">Join waitlist</a>
        </sui-button>
      )}
      <sui-button tone="primary" size="sm" class="site-nav-anon">
        <a href="/download" class="site-nav-link-reset">Download</a>
      </sui-button>

      <details class="site-nav-user" hidden data-show-when-auth={SHOW_AUTH ? 'true' : 'false'}>
        <summary aria-label="Account menu">
          <span class="site-nav-avatar" data-user-initials>·</span>
          <svg class="caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </summary>
        <div class="site-nav-user-panel" role="menu">
          <div class="site-nav-user-head">
            <span class="site-nav-user-name" data-user-name></span>
            <span class="site-nav-user-email" data-user-email></span>
            <span class="site-nav-user-plan" data-user-plan></span>
          </div>
          <hr />
          <a href="https://app.getship.dev" role="menuitem" class="site-nav-user-primary">
            Open SHIP
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          {SHOW_ACCOUNT && <a href="/account" role="menuitem">Account</a>}
          {SHOW_BILLING && <a href="/billing" role="menuitem">Billing</a>}
          <hr />
          <button type="button" role="menuitem" data-sign-out>Sign out</button>
        </div>
      </details>
    </div>

    <details class="site-nav-mobile" aria-label="Menu">
      <summary aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="bar top"    d="M4 7h16"></path>
          <path class="bar middle" d="M4 12h16"></path>
          <path class="bar bottom" d="M4 17h16"></path>
        </svg>
      </summary>
      <div class="site-nav-mobile-panel" role="menu">
        {links.map((l) => (
          <a href={l.href} role="menuitem">{l.label}</a>
        ))}
        <hr />
        {SHOW_AUTH ? (
          <a href="/sign-in" role="menuitem" class="site-nav-mobile-secondary">Sign in</a>
        ) : (
          <a href="/waitlist" role="menuitem" class="site-nav-mobile-secondary">Join waitlist</a>
        )}
        <a href="/download" role="menuitem" class="site-nav-mobile-primary">Download SHIP</a>
      </div>
    </details>
  </div>
</header>

<script>
  import { getSession, signOut, initials, type User, type Session } from '../lib/auth';

  // Close the mobile menu when a link is clicked or when the user clicks
  // outside. Native <details> handles the toggle; we only handle dismiss.
  const menu = document.querySelector<HTMLDetailsElement>('.site-nav-mobile');
  if (menu) {
    menu.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('a')) menu.open = false;
    });
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.open = false;
    });
  }

  const userMenu = document.querySelector<HTMLDetailsElement>('.site-nav-user');
  const anonCtas = document.querySelectorAll<HTMLElement>('.site-nav-anon');
  const PLAN_LABELS: Record<User['plan'], string> = {
    local: 'Local',
    pro: 'Pro',
  };

  // When auth UI is gated off, never reveal the user menu (cannot be
  // signed in client-side either) — paint() short-circuits to anon.
  const authEnabled = userMenu?.dataset.showWhenAuth === 'true';

  function paint(session: Session | null) {
    const user = authEnabled ? session?.user ?? null : null;
    const loggedIn = user !== null;
    for (const cta of anonCtas) cta.hidden = loggedIn;
    if (userMenu) userMenu.hidden = !loggedIn;
    if (!loggedIn || !userMenu) return;
    const set = (sel: string, text: string) => {
      const el = userMenu.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };
    set('[data-user-initials]', initials(user));
    set('[data-user-name]', user.name || user.email.split('@')[0]!);
    set('[data-user-email]', user.email);
    set('[data-user-plan]', PLAN_LABELS[user.plan]);
  }

  async function refresh() {
    paint(await getSession());
  }

  // When the auth surface is gated off in production, there's no point
  // pinging the gateway — the user menu can't render either way, and the
  // failed request just clutters the console with CORS noise.
  if (authEnabled) {
    refresh();
    document.addEventListener('ship:auth:change', () => { refresh(); });
    window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });
  } else {
    paint(null);
  }

  if (userMenu) {
    userMenu.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-sign-out]')) {
        e.preventDefault();
        await signOut();
        userMenu.open = false;
        if (location.pathname === '/account' || location.pathname === '/billing') {
          location.href = '/';
        } else {
          refresh();
        }
      }
      if (t.closest('a')) userMenu.open = false;
    });
    document.addEventListener('click', (e) => {
      if (!userMenu.contains(e.target as Node)) userMenu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') userMenu.open = false;
    });
  }
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(140%) blur(18px);
    -webkit-backdrop-filter: saturate(140%) blur(18px);
    background: color-mix(in oklab, var(--page-bg) 72%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--rail) 60%, transparent);
  }
  .site-nav-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 14px 40px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .site-nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.02em;
    font-size: 18px;
    color: var(--page-fg);
    text-decoration: none;
  }
  .site-nav-mark {
    filter: drop-shadow(0 2px 6px color-mix(in oklab, var(--primary) 35%, transparent));
  }
  .site-nav-links {
    display: flex;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
  }
  .site-nav-links a {
    color: var(--muted-ink);
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 999px;
    transition: background 150ms, color 150ms;
  }
  .site-nav-links a:hover {
    color: var(--page-fg);
    background: var(--chip-bg);
  }
  .site-nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .site-nav-link-reset {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Logged-in user menu --------------------------------------------- */
  .site-nav-user { position: relative; }
  .site-nav-user > summary {
    list-style: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 8px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--plate-line);
    background: var(--plate);
    color: var(--page-fg);
    transition: background 150ms, border-color 150ms;
  }
  .site-nav-user > summary::-webkit-details-marker { display: none; }
  .site-nav-user > summary:hover {
    background: var(--chip-bg);
    border-color: color-mix(in oklab, var(--primary) 30%, var(--plate-line));
  }
  .site-nav-user .caret {
    transition: transform 160ms var(--ease-out);
    color: var(--muted-ink);
  }
  .site-nav-user[open] .caret { transform: rotate(180deg); }
  .site-nav-avatar {
    display: inline-flex;
    align-items: center; justify-content: center;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white;
    font-family: var(--font-display);
    font-weight: 700; font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .site-nav-user-panel {
    position: absolute; top: calc(100% + 8px); right: 0;
    min-width: 240px;
    display: flex; flex-direction: column; gap: 2px;
    padding: 10px;
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 14px;
    box-shadow: 0 16px 40px color-mix(in oklab, var(--page-fg) 16%, transparent);
    z-index: 60;
  }
  .site-nav-user-head {
    display: flex; flex-direction: column; gap: 2px;
    padding: 8px 12px 10px;
  }
  .site-nav-user-name {
    font-weight: 600; color: var(--page-fg); font-size: 13px;
  }
  .site-nav-user-email {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; color: var(--muted-ink);
  }
  .site-nav-user-plan {
    margin-top: 6px; align-self: flex-start;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 3px 8px; border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
  }
  .site-nav-user-panel a,
  .site-nav-user-panel button {
    appearance: none; border: none; background: transparent;
    text-align: left; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 10px 12px; border-radius: 8px;
    color: var(--muted-ink);
    font-family: inherit; font-size: 13px; font-weight: 500;
    text-decoration: none;
    transition: background 120ms, color 120ms;
  }
  .site-nav-user-panel a:hover,
  .site-nav-user-panel button:hover {
    background: var(--chip-bg); color: var(--page-fg);
  }
  .site-nav-user-panel hr {
    border: none; border-top: 1px solid var(--plate-line); margin: 4px 4px;
  }
  .site-nav-user-primary {
    color: var(--primary) !important;
  }
  .site-nav-user-primary svg {
    transition: transform 160ms var(--ease-out);
  }
  .site-nav-user-primary:hover svg { transform: translateX(2px); }

  /* Mobile hamburger ------------------------------------------------ */
  .site-nav-mobile { display: none; margin-left: auto; position: relative; }
  .site-nav-mobile > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    border-radius: 10px;
    color: var(--page-fg);
    transition: background 150ms;
  }
  .site-nav-mobile > summary::-webkit-details-marker { display: none; }
  .site-nav-mobile > summary:hover { background: var(--chip-bg); }
  .site-nav-mobile > summary svg .bar {
    transition: transform 200ms var(--ease-out), opacity 150ms;
    transform-origin: center;
  }
  .site-nav-mobile[open] > summary .bar.top    { transform: translateY(5px) rotate(45deg); }
  .site-nav-mobile[open] > summary .bar.middle { opacity: 0; }
  .site-nav-mobile[open] > summary .bar.bottom { transform: translateY(-5px) rotate(-45deg); }

  .site-nav-mobile-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px;
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 14px;
    box-shadow: 0 16px 40px color-mix(in oklab, var(--page-fg) 16%, transparent);
    z-index: 60;
  }
  .site-nav-mobile-panel a {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    color: var(--muted-ink);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 120ms, color 120ms;
  }
  .site-nav-mobile-panel a:hover { background: var(--chip-bg); color: var(--page-fg); }
  .site-nav-mobile-panel hr {
    border: none;
    border-top: 1px solid var(--plate-line);
    margin: 6px 4px;
  }
  .site-nav-mobile-primary {
    background: var(--primary) !important;
    color: var(--primary-foreground, white) !important;
    text-align: center;
  }
  .site-nav-mobile-primary:hover {
    background: color-mix(in oklab, var(--primary) 85%, black) !important;
  }
  .site-nav-mobile-secondary {
    text-align: center;
  }

  @media (max-width: 860px) {
    .site-nav-links,
    .site-nav-actions { display: none; }
    .site-nav-mobile { display: inline-flex; }
    .site-nav-inner { gap: 16px; padding: 12px 20px; }
  }
</style>
