---
const links = [
  { href: '/#pillars', label: 'Product' },
  { href: 'https://docs.getship.dev', label: 'Docs' },
  { href: '/store', label: 'Store' },
];
---

<header class="site-nav">
  <div class="site-container site-nav-inner">
    <a class="site-nav-brand" href="/" aria-label="Ship home">
      <img src="/ship-logo.svg" alt="" width="32" height="32" class="site-nav-logo" />
      <span class="site-nav-wordmark">Ship</span>
    </a>

    <nav class="site-nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="site-nav-actions">
      <a class="site-nav-github" href="https://github.com/anthropics/claude-code" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.4 7.86 10.93.58.11.79-.25.79-.56v-1.95c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.44-2.29 1.17-3.1-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.18-1.49 3.14-1.18 3.14-1.18.62 1.59.23 2.77.11 3.06.73.81 1.17 1.84 1.17 3.1 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.07.78 2.15v3.19c0 .31.21.68.8.56A10.53 10.53 0 0 0 23.5 12C23.5 5.74 18.27.5 12 .5z" />
        </svg>
      </a>
      <ship-button
        tone="accent"
        variant="solid"
        size="md"
        onclick="location.href='/download'"
      >Download</ship-button>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    background: color-mix(in oklch, var(--site-bg) 72%, transparent);
    border-bottom: 1px solid color-mix(in oklch, var(--site-border) 40%, transparent);
  }
  .site-nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 32px;
    padding-block: 14px;
  }
  .site-nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--site-font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .site-nav-logo {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }
  .site-nav-wordmark {
    color: var(--site-fg);
  }
  .site-nav-links {
    display: flex;
    gap: 28px;
    justify-content: center;
    font-size: 14px;
    font-weight: 500;
    color: var(--site-muted-fg);
  }
  .site-nav-links a {
    transition: color 160ms ease;
  }
  .site-nav-links a:hover {
    color: var(--site-fg);
  }
  .site-nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .site-nav-github {
    color: var(--site-muted-fg);
    display: inline-flex;
    padding: 6px;
    border-radius: 8px;
    transition: color 160ms ease, background 160ms ease;
  }
  .site-nav-github:hover {
    color: var(--site-fg);
    background: color-mix(in oklch, var(--site-border) 30%, transparent);
  }
  @media (max-width: 720px) {
    .site-nav-links {
      display: none;
    }
    .site-nav-inner {
      grid-template-columns: auto 1fr;
    }
  }
</style>
