---
// Highlight 1 — "One chat, every model."
//
// Left: a stack of provider chats stacked like browser tabs, the
// active one tinted with its model's accent color. Right: an agent
// run card showing SHIP orchestrating across providers for a
// single task — "draft a release post" pulling from Claude for
// prose, ChatGPT for code, Gemini for screenshots, with per-step
// cost and duration.
//
// Both panels reveal via IntersectionObserver once.

const chats = [
  { id: 'claude',  name: 'Claude',   desc: 'Long context, thoughtful answers',  accent: 'oklch(0.72 0.14 40)' },
  { id: 'chatgpt', name: 'ChatGPT',  desc: 'Fast, broad, great for code',       accent: 'oklch(0.66 0.13 155)' },
  { id: 'gemini',  name: 'Gemini',   desc: 'Multimodal, research-friendly',     accent: 'oklch(0.66 0.14 240)' },
  { id: 'cursor',  name: 'Cursor',   desc: 'Your IDE agent, in-app',            accent: 'oklch(0.65 0.16 300)' },
];

const agentSteps = [
  { label: 'Summarize the week',    provider: 'Claude',  state: 'completed', ms: '1.4s',  cost: '$0.02' },
  { label: 'Pick 3 highlights',     provider: 'ChatGPT', state: 'completed', ms: '0.9s',  cost: '$0.01' },
  { label: 'Draft the release post',provider: 'Claude',  state: 'running',   ms: '—',     cost: '—' },
  { label: 'Grab screenshots',      provider: 'Gemini',  state: 'pending',   ms: '—',     cost: '—' },
];
---

<section class="hl hl-ai" data-visible="false">
  <div class="site-container hl-inner">
    <header class="hl-head">
      <ship-badge tone="accent" variant="soft" size="sm">One chat, every model</ship-badge>
      <h2>Pick the right brain, not the right app.</h2>
      <p class="hl-sub">
        Claude, ChatGPT, Gemini, Cursor, OpenCode &mdash; all in one
        place, all talking to each other. Switch mid-conversation. Ask
        two models the same question. Let SHIP route each step to
        whichever model is best for the job.
      </p>
    </header>

    <div class="hl-demo">
      <div class="hl-chats">
        {chats.map((c, i) => (
          <div
            class="hl-chat"
            data-active={i === 0 ? 'true' : 'false'}
            style={`--accent: ${c.accent}; --i: ${i}`}
          >
            <div class="hl-chat-dot" aria-hidden="true"></div>
            <div class="hl-chat-body">
              <div class="hl-chat-name">{c.name}</div>
              <div class="hl-chat-desc">{c.desc}</div>
            </div>
            <span class="hl-chat-key" aria-hidden="true">&#8984;{i + 1}</span>
          </div>
        ))}
      </div>

      <ship-card variant="outline" padding="lg" class="hl-agent">
        <div slot="header" class="hl-agent-head">
          <div>
            <div class="hl-agent-title">Release post for v1.2</div>
            <div class="hl-agent-sub">4 steps &middot; 2 models &middot; running now</div>
          </div>
          <ship-badge tone="info" variant="soft" size="sm">agent</ship-badge>
        </div>

        <ul class="hl-agent-steps">
          {agentSteps.map((s, i) => (
            <li class="hl-agent-step" data-state={s.state} style={`--i: ${i}`}>
              <ship-status-dot
                tone={s.state === 'completed' ? 'success' : s.state === 'running' ? 'info' : 'muted'}
                pulse={s.state === 'running'}
              ></ship-status-dot>
              <span class="hl-agent-label">{s.label}</span>
              <span class="hl-agent-provider">{s.provider}</span>
              <span class="hl-agent-ms">{s.ms}</span>
              <span class="hl-agent-cost">{s.cost}</span>
            </li>
          ))}
        </ul>
      </ship-card>
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.setAttribute('data-visible', 'true');
          obs.unobserve(e.target);
        }
      }
    },
    { threshold: 0.25 },
  );
  document.querySelectorAll('.hl-ai').forEach((el) => obs.observe(el));
</script>

<style>
  .hl {
    padding: clamp(72px, 10vw, 128px) 0;
    position: relative;
  }
  .hl-inner {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  .hl-head {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .hl-sub {
    color: var(--muted-foreground);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.55;
  }

  .hl-demo {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(20px, 3vw, 36px);
    align-items: stretch;
  }
  @media (max-width: 860px) {
    .hl-demo { grid-template-columns: 1fr; }
  }

  /* Provider chat stack */
  .hl-chats {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hl-chat {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    background: var(--card);
    transition:
      opacity 420ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 420ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    transition-delay: calc(160ms + var(--i) * 110ms);
  }
  .hl-chat[data-active='true'] {
    border-color: color-mix(in oklch, var(--accent) 60%, transparent);
    box-shadow:
      0 1px 2px color-mix(in oklch, var(--foreground) 5%, transparent),
      0 16px 36px -24px color-mix(in oklch, var(--accent) 60%, transparent);
  }
  :root.js .hl-ai[data-visible='false'] .hl-chat {
    opacity: 0;
    transform: translateX(-10px);
  }
  .hl-ai[data-visible='true'] .hl-chat {
    opacity: 1;
    transform: none;
  }
  .hl-chat-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hl-chat-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .hl-chat-desc {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 2px;
  }
  .hl-chat-key {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-foreground);
    padding: 2px 6px;
    border-radius: 5px;
    background: color-mix(in oklch, var(--border) 30%, transparent);
    white-space: nowrap;
  }

  /* Agent run card */
  .hl-agent {
    display: block;
    transition:
      opacity 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms,
      transform 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms;
  }
  :root.js .hl-ai[data-visible='false'] .hl-agent {
    opacity: 0;
    transform: translateY(16px);
  }
  .hl-ai[data-visible='true'] .hl-agent { opacity: 1; transform: none; }
  .hl-agent-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .hl-agent-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .hl-agent-sub {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 2px;
  }
  .hl-agent-steps {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .hl-agent-step {
    display: grid;
    grid-template-columns: 14px 1fr auto auto auto;
    column-gap: 12px;
    align-items: center;
    padding: 10px 2px;
    font-size: 13px;
    color: var(--foreground);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
    transition:
      opacity 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    transition-delay: calc(320ms + var(--i) * 90ms);
  }
  .hl-agent-step:last-child { border-bottom: 0; }
  :root.js .hl-ai[data-visible='false'] .hl-agent-step {
    opacity: 0;
    transform: translateY(6px);
  }
  .hl-ai[data-visible='true'] .hl-agent-step { opacity: 1; transform: none; }
  .hl-agent-step[data-state='pending'] { opacity: 0.55; }
  .hl-agent-label {
    font-weight: 500;
  }
  .hl-agent-provider {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .hl-agent-ms,
  .hl-agent-cost {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-foreground);
    min-width: 44px;
    text-align: right;
  }
  @media (max-width: 620px) {
    .hl-agent-step {
      grid-template-columns: 14px 1fr auto;
      row-gap: 2px;
    }
    .hl-agent-provider { grid-column: 2 / 4; font-size: 11px; }
    .hl-agent-ms, .hl-agent-cost { display: none; }
  }
</style>
