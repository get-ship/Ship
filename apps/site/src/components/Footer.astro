---
import ThemeSwitcher from './ThemeSwitcher.astro';

const SHOW_PRICING = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_PRICING === 'true';
const SHOW_AUTH    = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_AUTH === 'true';

const productLinks = [
  { href: '/features', label: 'Features' },
  ...(SHOW_PRICING ? [{ href: '/pricing', label: 'Pricing' }] : []),
  { href: '/store', label: 'Store' },
  { href: '/download', label: 'Download' },
];

const columns = [
  { title: 'Product', links: productLinks },
  {
    title: 'Developers',
    links: [
      { href: 'https://docs.getship.dev', label: 'Docs' },
      { href: '/features', label: 'Features' },
    ],
  },
  ...(SHOW_AUTH
    ? [{
        title: 'Account',
        links: [
          { href: '/sign-in', label: 'Sign in' },
          { href: '/sign-up', label: 'Sign up' },
        ],
      }]
    : [{
        title: 'Stay in the loop',
        links: [
          { href: '/waitlist', label: 'Join the waitlist' },
        ],
      }]),
];
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="footer-brand-link" href="/" aria-label="SHIP home">
          <sui-brand-mark size="md" class="footer-brand-mark"></sui-brand-mark>
          <span class="footer-brand-name">SHIP</span>
        </a>
        <p class="footer-tagline">
          The missing AI interface.
        </p>
      </div>
      <nav class="footer-cols" aria-label="Footer">
        {columns.map((c) => (
          <div class="footer-col">
            <div class="footer-col-title">{c.title}</div>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <sui-separator class="footer-sep"></sui-separator>

    <div class="footer-bottom">
      <a class="footer-built" href="/features">
        <span>Built on SHIP</span>
        <span class="footer-built-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <ThemeSwitcher />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 64px 0 32px;
    margin-top: 80px;
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    background:
      radial-gradient(60% 60% at 50% 0%, color-mix(in oklch, var(--accent) 6%, transparent), transparent 70%);
    content-visibility: auto;
    contain-intrinsic-size: 1px 480px;
  }
  .footer-top {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr 2fr;
  }
  @media (max-width: 720px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--page-fg);
  }
  .footer-brand-mark {
    filter: drop-shadow(0 2px 6px color-mix(in oklab, var(--primary) 35%, transparent));
  }
  .footer-brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .footer-tagline {
    color: var(--muted-foreground);
    max-width: 28ch;
    margin-top: 6px;
  }
  .footer-cols {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 720px) {
    .footer-cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) {
    .footer-cols { grid-template-columns: 1fr; }
  }
  .footer-col-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--foreground);
    margin-bottom: 10px;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-col a {
    color: var(--muted-foreground);
    font-size: 14px;
  }
  .footer-col a:hover {
    color: var(--foreground);
  }
  .footer-sep {
    margin: 32px 0 20px;
    display: block;
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted-foreground);
    font-size: 13px;
    flex-wrap: wrap;
  }
  .footer-built {
    display: inline-flex;
    gap: 6px;
    color: var(--muted-foreground);
    border-bottom: 1px dashed color-mix(in oklch, var(--border) 80%, transparent);
    padding-bottom: 2px;
  }
  .footer-built:hover {
    color: var(--foreground);
    border-color: var(--accent);
  }
  .footer-built-arrow {
    transition: transform 160ms ease;
  }
  .footer-built:hover .footer-built-arrow {
    transform: translateX(3px);
  }
</style>
