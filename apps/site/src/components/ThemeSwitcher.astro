---
// Marketing-site theme picker — uses the SUI `<sui-theme-picker>`
// primitive directly. The element is registered globally by
// `/sui-components.js` (loaded from BaseLayout), reads/writes the same
// `ship-site-theme` localStorage key the inline FOUC script restores,
// and dispatches `ship:theme:change` on selection so the landing-page
// plate pill stays in sync.
//
// `persist="true"` is the default — kept here so intent is explicit.
// The picker also fires a tier-2 PUT to `/api/settings`; against a
// static marketing site that's a silent no-op (no daemon listening).
---

<sui-theme-picker class="site-theme-picker" persist></sui-theme-picker>

<style>
  .site-theme-picker {
    display: inline-flex;
    align-items: center;
  }
</style>
