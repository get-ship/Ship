---
// Theme picker. Drives the shared @ship/ui theme helpers — no theme
// list lives in the site. Theme ids, labels, groups, and the dark-class
// decision all flow from packages/ui/src/themes.ts.
import { THEMES } from '@ship/ui/themes';

const groups = Array.from(new Set(THEMES.map((t) => t.group)));
---

<label class="theme-switcher">
  <span class="theme-switcher-label">Theme</span>
  <ship-select size="sm" data-theme-select data-placeholder="SHIP Light">
    {groups.map((g) => (
      <optgroup label={g}>
        {THEMES.filter((t) => t.group === g).map((t) => (
          <option value={t.id}>{t.label}</option>
        ))}
      </optgroup>
    ))}
  </ship-select>
</label>

<script>
  import { applyTheme, persistTheme, readStoredTheme, isValidTheme } from '@ship/ui/themes';

  const selects = document.querySelectorAll<HTMLElement>('[data-theme-select]');
  for (const select of selects) {
    const sync = () => {
      const current = readStoredTheme();
      (select as any).value = current;
      const native = select.querySelector('select') as HTMLSelectElement | null;
      if (native) native.value = current;
    };
    customElements.whenDefined('ship-select').then(sync);
    sync();

    const onChange = (value: unknown) => {
      if (!isValidTheme(value)) return;
      const next = applyTheme(value);
      persistTheme(next);
    };

    select.addEventListener('ship-change', (e: Event) => {
      const detail = (e as CustomEvent<{ value: string }>).detail;
      onChange(detail?.value);
    });
    select.addEventListener('change', (e: Event) => {
      const target = e.target as HTMLSelectElement;
      if (target?.value) onChange(target.value);
    });
  }
</script>

<style>
  .theme-switcher {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted-foreground);
    font-size: 13px;
  }
  .theme-switcher-label {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
</style>
