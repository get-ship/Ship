---
const providers = [
  { id: 'claude', label: 'Claude', logo: '/provider-logos/claude.svg' },
  { id: 'codex', label: 'Codex', logo: '/provider-logos/OpenAI-black-monoblossom.svg', invertOnDark: true },
  { id: 'gemini', label: 'Gemini', logo: '/provider-logos/googlegemini.svg' },
  { id: 'cursor', label: 'Cursor', logo: '/ide-logos/CUBE_2D_LIGHT.svg', altDark: '/ide-logos/CUBE_2D_DARK.svg' },
  { id: 'opencode', label: 'OpenCode', logo: '/provider-logos/opencode-logo-light.svg', altDark: '/provider-logos/opencode-logo-dark.svg' },
];
---

<div class="provider-strip" aria-label="Supported providers">
  <span class="provider-strip-label">Works with</span>
  <ul>
    {providers.map((p) => (
      <li>
        <img
          src={p.logo}
          alt={p.label}
          class:list={[p.invertOnDark && 'invert-on-dark', 'provider-logo']}
          loading="lazy"
          decoding="async"
          width="20"
          height="20"
        />
        <span>{p.label}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .provider-strip {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--site-muted-fg);
    font-size: 13px;
    font-weight: 500;
  }
  .provider-strip-label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
    color: var(--site-muted-fg);
  }
  .provider-strip ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  .provider-strip li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .provider-logo {
    width: 18px;
    height: 18px;
    object-fit: contain;
    opacity: 0.85;
  }
  :root[data-theme='high-contrast'] .invert-on-dark,
  :root[data-theme='high-contrast'] .provider-logo {
    filter: invert(1) hue-rotate(180deg) brightness(1.2);
  }
</style>
