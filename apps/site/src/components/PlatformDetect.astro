---
// Compact download row: platform icon + name + button. Detected OS gets
// a muted "recommended" badge; nothing else. No file extensions, no
// "signed/notarized" chrome — SHIP's installers are normal desktop
// installers, no need to oversell.
//
// macOS 10.15+ covers every Intel Mac from 2012 onward plus all Apple
// silicon. Windows 10+ covers every supported Windows build. Linux
// is a distro-agnostic binary (AppImage + deb + rpm on the actual
// download).
const platforms = [
  { id: 'macos',   label: 'macOS',   min: '10.15 or later', href: '/download/coming-soon' },
  { id: 'windows', label: 'Windows', min: '10 or later',    href: '/download/coming-soon' },
  { id: 'linux',   label: 'Linux',   min: 'x86_64 · arm64', href: '/download/coming-soon' },
];
---

<div class="platform-detect" data-detected="">
  <div class="platform-row">
    {platforms.map((p) => (
      <div class="platform" data-platform={p.id}>
        <div class="platform-icon" data-icon={p.id} aria-hidden="true"></div>
        <div class="platform-body">
          <div class="platform-name">
            {p.label}
            <ship-badge tone="accent" variant="soft" size="sm" class="platform-recommend">
              For your Mac
            </ship-badge>
            <ship-badge tone="accent" variant="soft" size="sm" class="platform-recommend-win">
              For your PC
            </ship-badge>
            <ship-badge tone="accent" variant="soft" size="sm" class="platform-recommend-linux">
              For this machine
            </ship-badge>
          </div>
          <div class="platform-min">{p.min}</div>
        </div>
        <ship-button
          tone="accent"
          variant="solid"
          size="md"
          onclick={`location.href='${p.href}'`}
        >Download</ship-button>
      </div>
    ))}
  </div>
</div>

<script>
  const detect = () => {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const uaData = (nav.userAgentData?.platform || '').toLowerCase();
    const ua = navigator.userAgent.toLowerCase();
    const p = (navigator.platform || '').toLowerCase();
    const blob = uaData + ' ' + ua + ' ' + p;
    if (/mac|iphone|ipad/.test(blob)) return 'macos';
    if (/win/.test(blob)) return 'windows';
    if (/linux|x11|ubuntu|fedora|debian/.test(blob)) return 'linux';
    return 'unknown';
  };

  const host = document.querySelector('.platform-detect');
  if (host) {
    const os = detect();
    host.setAttribute('data-detected', os);
    const card = host.querySelector('[data-platform="' + os + '"]');
    if (card) card.setAttribute('data-recommended', '');
  }
</script>

<style>
  .platform-detect {
    width: 100%;
  }
  .platform-row {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
    max-width: 680px;
    margin-inline: auto;
  }
  .platform {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    background: var(--card);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .platform[data-recommended] {
    border-color: color-mix(in oklch, var(--site-accent) 55%, transparent);
    box-shadow: 0 1px 3px color-mix(in oklch, var(--site-accent) 20%, transparent);
  }
  .platform-icon {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    color: var(--foreground);
  }
  .platform-icon::before {
    content: '';
    width: 24px;
    height: 24px;
    background: currentColor;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
  }
  .platform-icon[data-icon='macos']::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z'/></svg>");
  }
  .platform-icon[data-icon='windows']::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M3 5.5 10.5 4.3v7.2H3V5.5Zm0 7.5h7.5v7.2L3 18.5V13Zm8.5-8.9 9.5-1.5v9H11.5V4.1Zm0 9.1h9.5v9l-9.5-1.5v-7.5Z'/></svg>");
  }
  .platform-icon[data-icon='linux']::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M12 2c-3 0-4.5 2.5-4.5 5.5 0 1.8.6 3 .6 4.5 0 1.2-1.1 2.2-2.1 3.4-1 1.2-2 2.6-2 4.1 0 2 1.5 3 3.5 3 1.5 0 2.5-1 3.5-1s1.5.4 3 .4 3-.8 3.8-1.8 1.2-2.2 1.2-3.2c0-2-1.5-3.2-2.5-4.5s-1.5-2.5-1.5-4c0-3-1.5-6.4-3-6.4Zm-1.5 6.5c.4 0 .7.5.7 1s-.3 1-.7 1-.8-.5-.8-1 .4-1 .8-1Zm3 0c.4 0 .7.5.7 1s-.3 1-.7 1-.8-.5-.8-1 .4-1 .8-1Z'/></svg>");
  }
  .platform-body {
    min-width: 0;
  }
  .platform-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--foreground);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .platform-min {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 2px;
  }
  .platform-recommend,
  .platform-recommend-win,
  .platform-recommend-linux {
    display: none;
  }
  .platform-detect[data-detected='macos']   .platform[data-platform='macos']   .platform-recommend        { display: inline-flex; }
  .platform-detect[data-detected='windows'] .platform[data-platform='windows'] .platform-recommend-win    { display: inline-flex; }
  .platform-detect[data-detected='linux']   .platform[data-platform='linux']   .platform-recommend-linux  { display: inline-flex; }

  @media (max-width: 520px) {
    .platform { grid-template-columns: 28px 1fr; row-gap: 8px; }
    .platform > ship-button { grid-column: 1 / -1; }
  }
</style>
