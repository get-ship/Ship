---
// Uses ship-card composition: header slot holds the platform name +
// arch, the default slot holds the filename chip, footer slot holds
// the primary download action. Detected platform gets a ship-badge in
// the header slot flagging it as recommended.
//
// The client script only toggles a `data-recommended` attribute; the
// badge visibility is driven by CSS slot sync in the shadow DOM.
const platforms = [
  { id: 'macos', label: 'macOS 14+', arch: 'Apple silicon · Intel', filename: 'Ship.dmg', href: '/download/coming-soon' },
  { id: 'windows', label: 'Windows 10/11', arch: '64-bit', filename: 'ShipSetup.exe', href: '/download/coming-soon' },
  { id: 'linux', label: 'Linux', arch: 'x86_64 · arm64', filename: 'ship.AppImage', href: '/download/coming-soon' },
];
---

<div class="platform-detect" data-detected="">
  <div class="platform-grid">
    {platforms.map((p) => (
      <ship-card
        variant="outline"
        accent-bar
        padding="lg"
        class="platform-card"
        data-platform={p.id}
      >
        <div slot="header" class="platform-head">
          <div class="platform-head-meta">
            <div class="platform-label">{p.label}</div>
            <div class="platform-arch">{p.arch}</div>
          </div>
          <ship-badge tone="accent" variant="soft" size="sm" class="platform-recommend">
            Recommended
          </ship-badge>
        </div>

        <div class="platform-body">
          <ship-badge tone="muted" variant="outline" size="sm" class="platform-file">
            {p.filename}
          </ship-badge>
        </div>

        <ship-toolbar slot="footer" justify="between">
          <span class="platform-meta">Signed &middot; notarized</span>
          <ship-button
            tone="accent"
            variant="solid"
            size="md"
            onclick={`location.href='${p.href}'`}
          >Download</ship-button>
        </ship-toolbar>
      </ship-card>
    ))}
  </div>
</div>

<script>
  const detect = (): 'macos' | 'windows' | 'linux' | 'unknown' => {
    const nav = navigator as Navigator & {
      userAgentData?: { platform?: string };
    };
    const uaData = nav.userAgentData?.platform?.toLowerCase() ?? '';
    const ua = navigator.userAgent.toLowerCase();
    const platform = (navigator.platform ?? '').toLowerCase();
    const blob = `${uaData} ${ua} ${platform}`;
    if (/mac|iphone|ipad/.test(blob)) return 'macos';
    if (/win/.test(blob)) return 'windows';
    if (/linux|x11|ubuntu|fedora|debian/.test(blob)) return 'linux';
    return 'unknown';
  };

  const host = document.querySelector('.platform-detect');
  if (host) {
    const os = detect();
    host.setAttribute('data-detected', os);
    const card = host.querySelector(`[data-platform="${os}"]`);
    if (card) card.setAttribute('data-recommended', '');
  }
</script>

<style>
  .platform-detect {
    width: 100%;
  }
  .platform-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 840px) {
    .platform-grid {
      grid-template-columns: 1fr;
    }
  }
  .platform-card {
    display: block;
    transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }
  .platform-card[data-recommended] {
    transform: translateY(-2px);
  }
  .platform-card[data-recommended]::part(content) {
    position: relative;
  }
  .platform-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .platform-head-meta { min-width: 0; }
  .platform-label {
    font-family: var(--site-font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--site-fg);
  }
  .platform-arch {
    color: var(--site-muted-fg);
    font-size: 13px;
    margin-top: 2px;
  }
  .platform-recommend {
    display: none;
  }
  .platform-card[data-recommended] .platform-recommend {
    display: inline-flex;
  }
  .platform-body {
    padding-top: 4px;
  }
  .platform-file {
    font-family: var(--site-font-mono);
    font-size: 12px;
  }
  .platform-meta {
    color: var(--site-muted-fg);
    font-size: 12px;
  }
</style>
