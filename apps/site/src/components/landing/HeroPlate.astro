---
/**
 * Hero showcase plate — every visible widget is a REAL SUI component
 * rendering seeded data. No bespoke chart mockups, no fake DAG. The
 * plate-of-glass aesthetic (rounded card, plate-bg, traffic-light chrome)
 * wraps actual <sui-stat>, <sui-table>, <sui-sparkline>, etc.
 *
 * Seeded data is inline; we don't need the reactive SDK for a static
 * composition. When visitors install Ship, every component below is one
 * they can drop into a view file.
 */
---

<div class="stage-right">
  <div class="plate spotlight" id="landing-plate">
    <div class="plate-chrome">
      <div class="dots" aria-hidden="true">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      </div>
      <div class="title">ship · today</div>
      <div class="theme-pill"><i></i><span data-theme-pill-label>ship-light</span></div>
    </div>

    <div class="plate-body">
      <sui-toolbar class="plate-bar" gap="sm" justify="between">
        <div class="plate-bar-title">
          <h3>Today</h3>
          <span class="plate-bar-src">view · daily.view</span>
        </div>
        <sui-badge tone="success" variant="soft" size="sm">
          <sui-status-dot slot="leading" tone="success" pulse size="sm"></sui-status-dot>
          Live
        </sui-badge>
      </sui-toolbar>

      <div class="plate-stats">
        <sui-stat size="md">
          <span slot="label">Runs / wk</span>
          128
          <sui-badge slot="trend" tone="success" variant="soft" size="sm">+12</sui-badge>
        </sui-stat>
        <sui-stat size="md">
          <span slot="label">On budget</span>
          94%
          <sui-badge slot="trend" tone="success" variant="soft" size="sm">+3</sui-badge>
        </sui-stat>
        <sui-stat size="md">
          <span slot="label">Agents</span>
          8
          <span slot="hint">3 idle</span>
        </sui-stat>
      </div>

      <div class="plate-chart">
        <div class="plate-chart-head">
          <span class="plate-chart-title">Runs this week</span>
          <span class="plate-chart-meta">mon → sun</span>
        </div>
        <sui-sparkline
          data="32,48,42,68,55,82,72"
          tone="primary"
          width="540"
          height="56"
          fill
          label="Runs per day, Monday through Sunday"
        ></sui-sparkline>
      </div>

      <sui-table class="plate-table" density="compact" hoverable label="Recent runs">
        <table>
          <thead>
            <tr>
              <th>Agent</th>
              <th>Workspace</th>
              <th>Status</th>
              <th class="num">Duration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="cell-agent">Commander</span></td>
              <td>weekly-digest</td>
              <td><sui-badge tone="success" variant="soft" size="sm">done</sui-badge></td>
              <td class="num">1m 42s</td>
            </tr>
            <tr>
              <td><span class="cell-agent">Rust Lane</span></td>
              <td>compiler</td>
              <td><sui-badge tone="primary" variant="soft" size="sm">running</sui-badge></td>
              <td class="num">00:23</td>
            </tr>
            <tr>
              <td><span class="cell-agent">Gatekeeper</span></td>
              <td>pr-review</td>
              <td><sui-badge tone="success" variant="soft" size="sm">done</sui-badge></td>
              <td class="num">48s</td>
            </tr>
          </tbody>
        </table>
      </sui-table>
    </div>
  </div>
</div>

<style>
  .stage-right {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    padding: 16px 0;
  }
  .plate {
    position: relative; width: min(100%, 640px);
    background: var(--plate); border: 1px solid var(--plate-border);
    border-radius: 18px; box-shadow: var(--shadow-plate);
    overflow: hidden;
  }
  .plate::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(ellipse at top right, color-mix(in oklab, var(--primary) 10%, transparent), transparent 55%),
      radial-gradient(ellipse at bottom left, color-mix(in oklab, var(--accent) 8%, transparent), transparent 55%);
    z-index: 0;
  }

  .plate-chrome {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--plate-line);
    position: relative; z-index: 1;
  }
  .dots { display: flex; gap: 6px; }
  .plate-chrome .dot { width: 10px; height: 10px; border-radius: 50%; }
  .plate-chrome .dot.r { background: var(--status-red, oklch(0.62 0.21 25)); }
  .plate-chrome .dot.y { background: var(--status-yellow, oklch(0.78 0.16 80)); }
  .plate-chrome .dot.g { background: var(--status-green, oklch(0.6 0.18 150)); }
  .plate-chrome .title {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px; color: var(--plate-sub);
    letter-spacing: 0.04em;
  }
  .theme-pill {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; padding: 4px 8px;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--plate-muted);
    border: 1px solid var(--plate-line);
  }
  .theme-pill i {
    width: 8px; height: 8px; border-radius: 2px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: inline-block; font-style: normal;
  }

  .plate-body {
    position: relative; z-index: 1;
    padding: 18px;
    display: flex; flex-direction: column; gap: 16px;
  }

  /* Toolbar header */
  .plate-bar {
    --toolbar-py: 0;
    align-items: center;
  }
  .plate-bar-title {
    display: flex; align-items: baseline; gap: 12px;
  }
  .plate-bar-title h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--plate-ink);
  }
  .plate-bar-src {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--plate-sub);
  }

  /* Stat row */
  .plate-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  /* Chart */
  .plate-chart {
    padding: 14px 16px;
    border: 1px solid var(--plate-line);
    border-radius: 12px;
    background: color-mix(in oklab, var(--plate) 94%, var(--page-bg));
  }
  .plate-chart-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 6px;
  }
  .plate-chart-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12.5px;
    color: var(--plate-ink);
  }
  .plate-chart-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--plate-sub);
  }
  .plate-chart sui-sparkline {
    width: 100%;
    display: block;
  }

  /* Table */
  .plate-table {
    --row-py: 8px;
    --row-px: 12px;
    --th-py: 8px;
    --th-fs: 9.5px;
    font-size: 12.5px;
  }
  .plate-table table { width: 100%; border-collapse: collapse; }
  .plate-table thead th {
    text-align: left;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--plate-sub);
    padding: 8px 12px;
    border-bottom: 1px solid var(--plate-line);
  }
  .plate-table thead th.num { text-align: right; }
  .plate-table tbody td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--plate-line);
    color: var(--plate-muted);
  }
  .plate-table tbody tr:last-child td { border-bottom: none; }
  .plate-table tbody td.num {
    text-align: right;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--plate-sub);
  }
  .cell-agent {
    color: var(--plate-ink); font-weight: 500;
  }

  @media (max-width: 1060px) {
    .stage-right { padding: 24px 0 32px; }
    .plate-stats { grid-template-columns: 1fr 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .plate-stats { grid-template-columns: 1fr; }
  }
</style>
