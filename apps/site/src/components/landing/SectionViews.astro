---
const checkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>`;
const points = [
  { title: 'A component library, built-in', body: 'Stats, sparklines, tables, chat streams, artifact viewers, inbox lists, form builders. Compose or extend — they\'re standards-based custom elements.' },
  { title: 'Reactive SDK', body: 'Subscribe to any agent, any session, any collection row, any artifact. No polling. No manual state sync.' },
  { title: 'Theme-aware', body: 'Every component respects the active theme. Pick from Ship\'s palettes or bring your own.' },
  { title: 'Hot reload', body: 'Save the file. The view updates. No build step.' },
];
---

<section class="section stage" id="cluster-views" data-reveal>
  <div class="bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-blob b1" style="top: -10%; left: 40%; width: 500px; height: 500px; opacity: 0.35;"></div>
  </div>
  <div class="container">
    <div class="section-head">
      <div class="section-kicker">03 · Views</div>
      <h1 class="section-title">Apps that <em>look like apps.</em></h1>
      <p class="section-sub"><b>Web components</b> for tables, charts, chat, artifacts, forms — paired with a <b>reactive SDK</b> wired to every runtime signal. Build a dashboard, a chat surface, an inbox, a control panel.</p>
    </div>

    <div class="views-stack">
      <div class="view-preview spotlight">
        <div class="vp-head">
          <span class="vp-chrome-dot r"></span>
          <span class="vp-chrome-dot y"></span>
          <span class="vp-chrome-dot g"></span>
          <div class="url">inbox · daily</div>
          <sui-badge tone="success" variant="soft" size="sm">
            <sui-status-dot slot="leading" tone="success" pulse size="sm"></sui-status-dot>
            live
          </sui-badge>
        </div>
        <div class="body">
          <sui-toolbar class="vp-bar" gap="sm" justify="between">
            <div class="vp-title-wrap">
              <div class="vp-title">Inbox triage</div>
              <span class="vp-sub">view · inbox.daily</span>
            </div>
            <sui-badge tone="primary" variant="soft" size="sm">14 items</sui-badge>
          </sui-toolbar>

          <div class="vp-progress">
            <div class="vp-progress-label">
              <span><b>Reviewed</b></span>
              <span class="vp-progress-count">11 / 14</span>
            </div>
            <sui-progress value="79" tone="primary" label="Items reviewed"></sui-progress>
          </div>

          <div class="vp-chart-wrap">
            <div class="vp-chart-head">
              <span class="vp-chart-title">Daily volume</span>
              <span class="vp-chart-meta">last 7 days</span>
            </div>
            <sui-bar-chart
              data="32,48,42,68,55,82,72"
              tone="primary"
              height="80"
              label="Items per day, last seven days"
            ></sui-bar-chart>
          </div>

          <sui-table class="vp-table" density="compact" hoverable label="Recent items">
            <table>
              <tbody>
                <tr>
                  <td><sui-badge tone="success" variant="soft" size="sm">done</sui-badge></td>
                  <td><b>Investor digest</b></td>
                  <td class="num">5 inputs</td>
                </tr>
                <tr>
                  <td><sui-badge tone="primary" variant="soft" size="sm">running</sui-badge></td>
                  <td><b>PR triage</b></td>
                  <td class="num">#812</td>
                </tr>
                <tr>
                  <td><sui-badge variant="outline" size="sm">queued</sui-badge></td>
                  <td><b>Bug reports</b></td>
                  <td class="num">4 items</td>
                </tr>
              </tbody>
            </table>
          </sui-table>
        </div>
      </div>

      <div>
        <div class="feature-points">
          {points.map((p) => (
            <div class="fp-row">
              <div class="tick" set:html={checkIcon}></div>
              <div>
                <h4>{p.title}</h4>
                <p>{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .views-stack {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px; align-items: start;
    position: relative; z-index: 1;
  }
  @media (max-width: 1060px) { .views-stack { grid-template-columns: 1fr; } }

  .view-preview {
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 16px;
    box-shadow: var(--shadow-plate);
    overflow: hidden;
  }
  .vp-head {
    padding: 10px 14px;
    border-bottom: 1px solid var(--plate-line);
    display: flex; align-items: center; gap: 8px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; color: var(--plate-sub);
  }
  .vp-chrome-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .vp-chrome-dot.r { background: var(--status-red); }
  .vp-chrome-dot.y { background: var(--status-yellow); }
  .vp-chrome-dot.g { background: var(--status-green); }
  .url {
    background: var(--chip-bg); border-radius: 6px;
    padding: 3px 8px; color: var(--plate-ink);
    flex: 1; font-size: 10.5px;
  }
  .body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }

  .vp-bar { --toolbar-py: 0; align-items: center; }
  .vp-title-wrap { display: flex; align-items: baseline; gap: 12px; }
  .vp-title {
    font-family: var(--font-display);
    font-size: 22px; font-weight: 600;
    letter-spacing: -0.02em; color: var(--plate-ink);
  }
  .vp-sub {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; color: var(--plate-sub);
  }

  .vp-progress {
    padding: 12px 14px;
    border: 1px solid var(--plate-line); border-radius: 10px;
    background: color-mix(in oklab, var(--plate) 94%, var(--page-bg));
    display: flex; flex-direction: column; gap: 8px;
  }
  .vp-progress-label {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 12px; color: var(--plate-muted);
  }
  .vp-progress-label b { color: var(--plate-ink); font-weight: 600; }
  .vp-progress-count {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; color: var(--plate-sub);
  }

  .vp-chart-wrap {
    padding: 14px;
    border: 1px solid var(--plate-line); border-radius: 10px;
    background: color-mix(in oklab, var(--plate) 94%, var(--page-bg));
  }
  .vp-chart-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 6px;
  }
  .vp-chart-title {
    font-family: var(--font-body); font-weight: 600;
    font-size: 12.5px; color: var(--plate-ink);
  }
  .vp-chart-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; color: var(--plate-sub);
  }
  .vp-chart-wrap sui-bar-chart { width: 100%; display: block; }

  .vp-table { --row-py: 8px; --row-px: 12px; }
  .vp-table table { width: 100%; border-collapse: collapse; }
  .vp-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--plate-line);
    font-size: 12.5px;
    color: var(--plate-muted);
  }
  .vp-table tr:last-child td { border-bottom: none; }
  .vp-table td b { color: var(--plate-ink); font-weight: 500; }
  .vp-table td.num {
    text-align: right;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--plate-sub);
  }
</style>
