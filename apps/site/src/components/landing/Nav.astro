---
import ThemeSwitcher from '../ThemeSwitcher.astro';
---

<nav class="topnav">
  <div class="inner">
    <a href="/" class="brand" aria-label="Ship home">
      <ship-mark size="md" class="mark"></ship-mark>
      SHIP
    </a>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="/store">Store</a>
      <a href="/download">Download</a>
      <a href="https://docs.getship.dev">Docs</a>
    </div>
    <div class="nav-right">
      <ThemeSwitcher />
      <ship-button variant="ghost" size="sm">
        <a href="/sign-in" class="nav-link-reset">Sign in</a>
      </ship-button>
      <ship-button tone="primary" size="sm">
        <a href="/download" class="nav-link-reset">Download</a>
      </ship-button>
    </div>
  </div>
</nav>

<style>
  .topnav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: color-mix(in oklab, var(--page-bg) 75%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--rail) 60%, transparent);
  }
  .inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 14px 40px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-display);
    font-weight: 700; letter-spacing: 0.02em;
    font-size: 18px; color: var(--page-fg);
    text-decoration: none;
  }
  .mark {
    filter: drop-shadow(0 2px 6px color-mix(in oklab, var(--primary) 35%, transparent));
  }
  .nav-links { display: flex; gap: 4px; font-size: 13px; font-weight: 500; }
  .nav-links a {
    color: var(--muted-ink); text-decoration: none;
    padding: 8px 14px; border-radius: 999px;
    transition: background 150ms, color 150ms;
  }
  .nav-links a:hover { color: var(--page-fg); background: var(--chip-bg); }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }

  .nav-link-reset {
    color: inherit; text-decoration: none;
    display: inline-flex; align-items: center; gap: 8px;
  }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .inner { gap: 16px; padding: 12px 20px; }
  }
</style>
