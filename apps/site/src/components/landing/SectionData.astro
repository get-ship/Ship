---
const checkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>`;
const points = [
  { title: 'Schemas that earn their keep', body: 'Define types, refs, enums, indexes. Ship manages migrations as you evolve. Your views and skills query collections by name, never by raw table.' },
  { title: 'Artifacts are first-class', body: 'Every file an agent produces is tracked, addressable, and referenceable. Link them from collections, render them in views, hand them to the next session.' },
  { title: 'Reactive, not polled', body: 'Write to a collection, views update. Produce an artifact, downstream skills wake up. No refresh buttons, no stale dashboards.' },
];
const fields = [
  { name: 'id', type: 'uuid', flag: 'pk' },
  { name: 'agent', type: 'ref → agents', flag: 'idx' },
  { name: 'status', type: 'enum', flag: 'idx' },
  { name: 'started_at', type: 'datetime', flag: 'idx' },
  { name: 'artifact', type: 'ref → artifacts?', flag: null },
  { name: 'duration_ms', type: 'integer', flag: null },
];
const artifacts = [
  { kind: 'md', name: 'digest.md', size: '4.2 kb', tone: 'primary' as const },
  { kind: 'pdf', name: 'board-prep.pdf', size: '112 kb', tone: 'destructive' as const },
  { kind: 'png', name: 'runs-week-42.png', size: '64 kb', tone: 'accent' as const },
  { kind: 'csv', name: 'triage.csv', size: '18 kb', tone: 'success' as const },
];
---

<section class="section stage" id="cluster-data" data-reveal>
  <div class="bg" aria-hidden="true"><div class="bg-grid"></div></div>
  <div class="container">
    <div class="section-head">
      <div class="section-kicker">02 · Artifacts &amp; Collections</div>
      <h1 class="section-title">Your data, <em>indexed everywhere.</em></h1>
      <p class="section-sub"><b>Collections</b> are your structured data. Define the shape; Ship maintains schema and indexes. <b>Artifacts</b> are whatever your agents produce — reports, exports, generated code, images. Both addressable. Both flow through every view and skill in your app.</p>
    </div>

    <div class="two-col flip">
      <div class="data-twin spotlight">
        <div class="data-card">
          <div class="data-head">
            <div class="data-mono"><b>runs</b> · collection</div>
            <sui-badge tone="primary" variant="soft" size="sm">6 fields · 3 indexes</sui-badge>
          </div>
          <sui-table class="data-sui-table" density="compact" hoverable label="Runs collection schema">
            <table>
              <tbody>
                {fields.map((f) => (
                  <tr>
                    <td class="fl-name"><b>{f.name}</b></td>
                    <td class="fl-type">{f.type}</td>
                    <td class="fl-flag-cell">
                      {f.flag === 'pk' && <sui-badge tone="primary" variant="soft" size="sm">pk</sui-badge>}
                      {f.flag === 'idx' && <sui-badge variant="outline" size="sm">idx</sui-badge>}
                      {f.flag === null && <span class="fl-dash">—</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </sui-table>
        </div>
        <div class="data-card">
          <div class="data-head">
            <div class="data-mono"><b>artifacts</b> · this week</div>
            <sui-badge variant="soft" size="sm">from weekly-digest</sui-badge>
          </div>
          <div class="artifact-list">
            {artifacts.map((a) => (
              <div class="art">
                <sui-badge tone={a.tone} variant="soft" size="sm">{a.kind}</sui-badge>
                <span class="art-name">{a.name}</span>
                <span class="art-size">{a.size}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div>
        <div class="feature-points">
          {points.map((p) => (
            <div class="fp-row">
              <div class="tick" set:html={checkIcon}></div>
              <div>
                <h4>{p.title}</h4>
                <p>{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .data-twin { display: grid; gap: 16px; }
  .data-card {
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 16px;
    box-shadow: var(--shadow-plate);
    overflow: hidden;
  }
  .data-head {
    padding: 13px 16px;
    border-bottom: 1px solid var(--plate-line);
    display: flex; justify-content: space-between; align-items: baseline;
  }
  .data-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11.5px; color: var(--plate-sub); }
  .data-mono b { color: var(--plate-ink); font-weight: 600; }
  .data-meta { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 10.5px; color: var(--plate-sub); }

  .data-sui-table { --row-py: 9px; --row-px: 16px; }
  .data-sui-table table { width: 100%; border-collapse: collapse; }
  .data-sui-table td {
    padding: 10px 16px;
    border-top: 1px solid var(--plate-line);
    font-size: 12.5px;
    color: var(--plate-muted);
  }
  .data-sui-table tr:first-child td { border-top: none; }
  .fl-name {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px; color: var(--plate-muted);
  }
  .fl-name b { color: var(--plate-ink); font-weight: 500; }
  .fl-type {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; color: var(--accent);
  }
  .fl-flag-cell { text-align: right; }
  .fl-dash {
    color: var(--plate-sub);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
  }

  .artifact-list { padding: 4px 0; }
  .art {
    display: grid; grid-template-columns: max-content 1fr auto;
    gap: 12px; padding: 10px 16px;
    border-top: 1px solid var(--plate-line);
    align-items: center; font-size: 12.5px;
  }
  .art:first-child { border-top: none; }
  .art-name { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; color: var(--plate-ink); }
  .art-size { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 10.5px; color: var(--plate-sub); }
</style>
