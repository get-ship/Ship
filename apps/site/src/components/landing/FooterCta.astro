---
---

<footer class="footer stage">
  <div class="bg" aria-hidden="true">
    <div class="bg-grid" style="mask-image: radial-gradient(ellipse 50% 80% at 50% 100%, #000, transparent);"></div>
  </div>
  <div class="container">
    <div class="foot-cta">
      <h2>Build your <em>own AI app.</em></h2>
      <p>Pull SHIP. Point an agent at your data. Drop a view over it.</p>
      <div class="ctas foot-ctas">
        <sui-button size="lg">
          <a href="/download" class="cta-inner">
            Download SHIP
            <svg class="caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </sui-button>
        <sui-button size="lg" variant="outline">
          <a href="https://docs.getship.dev" class="cta-inner">Read the docs</a>
        </sui-button>
      </div>
    </div>
    <div class="foot-bottom">
      <a href="/" class="brand" aria-label="Ship home">
        <sui-brand-mark size="sm" class="mark"></sui-brand-mark>
        SHIP
      </a>
      <div class="foot-links">
        <a href="#features">Features</a>
        <a href="/store">Store</a>
        <a href="/download">Download</a>
        <a href="https://docs.getship.dev">Docs</a>
      </div>
      <div class="foot-copy">© 2026 Ship</div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 80px 0 48px;
    border-top: 1px solid var(--rail);
    margin-top: 80px;
  }
  .foot-cta { text-align: center; padding: 40px 0 64px; position: relative; z-index: 1; }
  .foot-cta h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 0.95; letter-spacing: -0.035em;
    margin: 0 0 16px; color: var(--page-fg);
  }
  .foot-cta h2 em {
    font-style: italic; font-weight: 500;
    color: var(--primary);
  }
  .foot-cta p { font-size: 17px; color: var(--muted-ink); margin: 0; }
  .foot-ctas { justify-content: center; }

  .foot-cta .cta-inner {
    color: inherit;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 10px;
    line-height: 1;
  }
  .foot-cta .caret {
    flex: none;
    display: block;
    transition: transform 180ms var(--ease-out);
  }
  .foot-cta sui-button:hover .caret { transform: translateX(3px); }

  .foot-bottom {
    padding-top: 24px;
    border-top: 1px solid var(--rail);
    display: flex; justify-content: space-between;
    align-items: center; gap: 24px; flex-wrap: wrap;
    position: relative; z-index: 1;
  }
  .brand {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-display);
    font-weight: 700; letter-spacing: 0.02em;
    font-size: 15px; color: var(--page-fg);
    text-decoration: none;
  }
  .mark {
    filter: drop-shadow(0 2px 6px color-mix(in oklab, var(--primary) 35%, transparent));
  }
  .foot-links { display: flex; gap: 24px; font-size: 13px; }
  .foot-links a {
    color: var(--muted-ink); text-decoration: none;
    transition: color 140ms;
  }
  .foot-links a:hover { color: var(--page-fg); }
  .foot-copy {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; color: var(--subtle-ink);
  }
</style>
