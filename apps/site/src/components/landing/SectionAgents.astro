---
const checkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>`;
const points = [
  { title: 'One definition, every provider', body: 'Skills, tools, MCP, permissions, model preference — declared once. Ship compiles to whichever provider runs it.' },
  { title: 'Standard skill files', body: 'Drop a skill folder; agents pick it up. Bring the skills you already use.' },
  { title: 'Scoped by default', body: 'Filesystem, shell, and network permissions are explicit per agent. Nothing they shouldn\'t touch.' },
];
---

<section class="section stage" id="cluster-agents" data-reveal>
  <div class="bg" aria-hidden="true"><div class="bg-grid"></div></div>
  <div class="container">
    <div class="section-head">
      <div class="section-kicker">01 · Agents &amp; Skills</div>
      <h1 class="section-title">One config. <em>Every model.</em></h1>
      <p class="section-sub">Declare an agent once with the <b>skills, MCP servers, permissions, and model</b> you want. Ship compiles to whichever provider runs it: Claude, Codex, Gemini, Cursor.</p>
    </div>

    <div class="two-col flip">
      <div class="agent-card spotlight">
        <div class="ac-head">
          <div class="ac-mono"><b>rust-lane</b> · agent</div>
          <div></div>
          <sui-badge tone="success" variant="soft" size="sm">
            <sui-status-dot slot="leading" tone="success" pulse size="sm"></sui-status-dot>
            ready
          </sui-badge>
        </div>
        <div class="ac-grid">
          <div class="ac-side">
            <div class="group">Agents</div>
            <div class="item"><svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"></circle></svg>Commander</div>
            <div class="item"><svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="12" height="12" rx="3"></rect></svg>Gatekeeper</div>
            <div class="item sel"><svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8h12M8 2v12"></path></svg>Rust Lane</div>
            <div class="item"><svg class="ic" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3"></circle></svg>Inbox Triage</div>
            <div class="group mt">Skills</div>
            <div class="item">cargo</div>
            <div class="item">git</div>
            <div class="item">clippy</div>
          </div>
          <div class="ac-body">
            <h3>Rust Lane</h3>
            <div class="ac-desc">A focused implementation lane for cross-crate work on the compiler + runtime.</div>
            <div class="ac-rows">
              <div class="ac-row">
                <div class="k">Compiles to</div>
                <div class="v">
                  <sui-badge tone="primary" variant="soft" size="sm">claude</sui-badge>
                  <sui-badge variant="outline" size="sm">codex</sui-badge>
                  <sui-badge variant="outline" size="sm">gemini</sui-badge>
                  <sui-badge variant="outline" size="sm">cursor</sui-badge>
                </div>
              </div>
              <div class="ac-row">
                <div class="k">Skills</div>
                <div class="v">
                  <sui-badge variant="soft" size="sm">cargo</sui-badge>
                  <sui-badge variant="soft" size="sm">git</sui-badge>
                  <sui-badge variant="soft" size="sm">rustfmt</sui-badge>
                  <sui-badge variant="soft" size="sm">clippy</sui-badge>
                </div>
              </div>
              <div class="ac-row">
                <div class="k">MCP</div>
                <div class="v">
                  <sui-badge tone="accent" variant="soft" size="sm">fs-scoped</sui-badge>
                  <sui-badge tone="accent" variant="soft" size="sm">shell-allowlist</sui-badge>
                </div>
              </div>
              <div class="ac-row">
                <div class="k">Perms</div>
                <div class="v">
                  <sui-badge variant="soft" size="sm">write · packages/compiler</sui-badge>
                  <sui-badge variant="soft" size="sm">ask · network</sui-badge>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="feature-points">
          {points.map((p) => (
            <div class="fp-row">
              <div class="tick" set:html={checkIcon}></div>
              <div>
                <h4 set:html={p.title}></h4>
                <p>{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .agent-card {
    position: relative;
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 18px;
    box-shadow: var(--shadow-plate);
    overflow: hidden;
  }
  .ac-head {
    display: grid; grid-template-columns: auto 1fr auto;
    gap: 12px; align-items: center;
    padding: 16px 18px;
    border-bottom: 1px solid var(--plate-line);
  }
  .ac-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11.5px; color: var(--plate-sub); }
  .ac-mono b { color: var(--plate-ink); font-weight: 600; }
  .ac-ready { color: var(--primary); }
  .ac-grid {
    display: grid; grid-template-columns: 220px 1fr; gap: 0;
    min-height: 380px;
  }
  @media (max-width: 640px) { .ac-grid { grid-template-columns: 1fr; } }
  .ac-side {
    border-right: 1px solid var(--plate-line);
    padding: 14px 10px;
    display: grid; gap: 2px; align-content: start;
  }
  .ac-side .group {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px; letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--plate-sub);
    padding: 10px 10px 4px;
  }
  .ac-side .group.mt { margin-top: 8px; }
  .ac-side .item {
    padding: 7px 10px; border-radius: 8px;
    font-size: 12.5px; font-weight: 500;
    color: var(--plate-muted);
    display: flex; align-items: center; gap: 8px;
    cursor: pointer;
  }
  .ac-side .item:hover { background: var(--chip-bg); color: var(--plate-ink); }
  .ac-side .item .ic { width: 14px; height: 14px; flex: none; }
  .ac-side .item.sel {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
  }
  .ac-body {
    padding: 22px 24px;
    display: grid; gap: 18px; align-content: start;
  }
  .ac-body h3 {
    margin: 0;
    font-family: var(--font-display); font-weight: 600;
    font-size: 22px; color: var(--plate-ink);
    letter-spacing: -0.02em;
  }
  .ac-desc { font-size: 13px; color: var(--plate-muted); line-height: 1.5; margin: -8px 0 0; }
  .ac-rows { display: grid; }
  .ac-row {
    display: grid; grid-template-columns: 110px 1fr;
    gap: 12px; align-items: center;
    padding: 10px 0;
    border-top: 1px dashed var(--plate-line);
  }
  .ac-row:first-child { border-top: none; padding-top: 0; }
  .ac-row .k {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--plate-sub);
  }
  .ac-row .v { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 500;
    border-radius: 999px;
    background: var(--chip-bg); color: var(--chip-ink);
    border: 1px solid var(--plate-line);
  }
  .tag.p {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
    border-color: color-mix(in oklab, var(--primary) 30%, transparent);
  }
  .tag.a {
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
  .compile-to { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .compile-to .arrow {
    color: var(--plate-sub);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
</style>
