---
const checkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>`;
const points = [
  { title: 'DAGs, not linear chains', body: 'Fan-out, branching, retries, human gates, nested sub-pipelines. Every edge is resumable. If something half-failed at 2am, pick up where it stopped.' },
  { title: 'Triggers from anywhere', body: 'Cron, webhook, file watcher, inbound message, another pipeline finishing. Declare the event; Ship handles the wiring.' },
  { title: 'Event-driven end to end', body: 'Everything Ship does — agent turns, artifact writes, collection changes — is an event on the bus. Your pipelines can listen to any of it.' },
];
---

<section class="section stage" id="cluster-logic">
  <div class="bg" aria-hidden="true"><div class="bg-grid"></div></div>
  <div class="container">
    <div class="section-head">
      <div class="section-kicker">02 · Pipelines &amp; Triggers</div>
      <h1 class="section-title">Your logic. <em>Any shape.</em><br>Reacting to anything.</h1>
      <p class="section-sub">Pipelines are DAGs — <b>parallel, conditional, retried, gated</b>, sub-pipelines all the way down. Triggers are how they start: a cron tick, a webhook, a file change, a message landing, an upstream run completing. Define once, Ship wires the event bus.</p>
    </div>

    <div class="two-col">
      <div class="pipe-card">
        <div class="pipe-head">
          <div class="pipe-mono"><b>weekly-digest</b> · pipeline</div>
          <div class="pipe-live">LIVE</div>
        </div>
        <div class="pipe-body">
          <div class="pipe-canvas">
            <svg class="pipe-svg" viewBox="0 0 520 280" preserveAspectRatio="none">
              <defs>
                <linearGradient id="landing-pe" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="var(--primary)" stop-opacity="0.9"></stop>
                  <stop offset="1" stop-color="var(--accent)" stop-opacity="0.9"></stop>
                </linearGradient>
              </defs>
              <path d="M 98 60 C 160 60 160 90 220 90" stroke="url(#landing-pe)" stroke-width="1.5" fill="none"></path>
              <path d="M 98 150 C 160 150 160 90 220 90" stroke="url(#landing-pe)" stroke-width="1.5" fill="none"></path>
              <path d="M 98 240 C 160 240 160 190 220 190" stroke="url(#landing-pe)" stroke-width="1.5" fill="none"></path>
              <path d="M 320 90 C 380 90 380 60 440 60" stroke="url(#landing-pe)" stroke-width="1.5" fill="none" stroke-dasharray="4 3"></path>
              <path d="M 320 190 C 380 190 380 220 440 220" stroke="var(--plate-line)" stroke-width="1.5" fill="none" stroke-dasharray="4 3"></path>
            </svg>
            <div class="pn done col-trig"  style="--y:21.43%;"><div class="state"></div><div class="nm">cron · 07:00</div><div class="sub">trigger</div></div>
            <div class="pn done col-trig"  style="--y:53.57%;"><div class="state"></div><div class="nm">webhook · pr-merged</div><div class="sub">trigger</div></div>
            <div class="pn done col-trig"  style="--y:85.71%;"><div class="state"></div><div class="nm">file · inbox/*.md</div><div class="sub">trigger</div></div>
            <div class="pn done col-mid"   style="--y:32.14%;"><div class="state"></div><div class="nm">gather</div><div class="sub">4 sources</div></div>
            <div class="pn running col-mid" style="--y:67.86%;"><div class="state"></div><div class="nm">summarize</div><div class="sub">on Rust Lane</div></div>
            <div class="pn queued col-out" style="--y:21.43%;"><div class="state"></div><div class="nm">publish</div><div class="sub">slack</div></div>
            <div class="pn queued col-out" style="--y:78.57%;"><div class="state"></div><div class="nm">review</div><div class="sub">human gate</div></div>
          </div>
        </div>
      </div>

      <div>
        <div class="feature-points">
          {points.map((p) => (
            <div class="fp-row">
              <div class="tick" set:html={checkIcon}></div>
              <div>
                <h4>{p.title}</h4>
                <p>{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pipe-card {
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 18px;
    box-shadow: var(--shadow-plate);
    overflow: hidden;
  }
  .pipe-head {
    padding: 14px 18px;
    border-bottom: 1px solid var(--plate-line);
    display: flex; justify-content: space-between; align-items: center;
  }
  .pipe-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11.5px; color: var(--plate-sub); }
  .pipe-mono b { color: var(--plate-ink); font-weight: 600; }
  .pipe-live {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; font-weight: 500;
    padding: 4px 10px; border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 15%, transparent);
    color: var(--primary);
    border: 1px solid color-mix(in oklab, var(--primary) 30%, transparent);
  }
  .pipe-live::before {
    content: ""; width: 6px; height: 6px;
    border-radius: 50%; background: var(--primary);
  }
  .pipe-body {
    padding: 16px 18px 24px;
  }
  .pipe-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 520 / 280;
    min-height: 260px;
  }
  .pipe-svg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
  }
  .pn {
    position: absolute;
    top: var(--y);
    transform: translateY(-50%);
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
    border: 1px solid var(--plate-line);
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 11px; color: var(--plate-muted);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  /* Columns anchor to the same x-coordinates the SVG edges start/end at
   * (viewBox 520 wide: triggers 0→98, middle 220→320, outputs 440→520). */
  /* Node widths are wider than the SVG column cells so trigger labels
   * like "webhook · pr-merged" fit without truncation; the short segment
   * of each edge path that starts inside a node sits harmlessly under
   * the node background. */
  .col-trig { left: 0;      width: 28%; }
  .col-mid  { left: 42.3%;  width: 22%; }
  .col-out  { left: 84.6%;  width: 15.38%; }
  .pn .nm {
    color: var(--plate-ink); font-weight: 600;
    font-family: var(--font-body); font-size: 12.5px;
    letter-spacing: -0.005em;
    padding-right: 14px;
  }
  .pn .sub {
    font-size: 10px; color: var(--plate-sub);
    letter-spacing: 0.06em; text-transform: uppercase;
    margin-top: 3px;
  }
  .pn .state {
    position: absolute; top: 9px; right: 10px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--plate-sub);
  }
  .pn.done .state { background: var(--success); }
  .pn.running { border-color: color-mix(in oklab, var(--primary) 45%, transparent); }
  .pn.running .state {
    background: var(--primary);
    animation: landing-node-pulse 1.6s ease-in-out infinite;
  }
  .pn.queued { opacity: 0.72; }
</style>
