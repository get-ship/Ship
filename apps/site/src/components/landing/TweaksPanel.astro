---
---

<div class="tweaks" id="landing-tweaks" data-tweaks-panel hidden>
  <header>
    <span>Tweaks</span>
    <button type="button" data-tweaks-close aria-label="Close tweaks">×</button>
  </header>
  <section>
    <h4>Headline copy</h4>
    <div class="tweak-radio" data-tweak-group="headline">
      <button type="button" data-headline="vibe">Vibe <em>anything.</em></button>
      <button type="button" data-headline="build">Build AI apps that <em>feel</em>.</button>
      <button type="button" data-headline="thirty">Personal AI, <em>your way.</em></button>
      <button type="button" data-headline="reactive">The <em>reactive</em> AI runtime.</button>
    </div>
  </section>
  <section>
    <h4>Centerpiece</h4>
    <div class="tweak-radio" data-tweak-group="centerpiece">
      <button type="button" data-centerpiece="auto">Auto-morph (every 8s)</button>
      <button type="button" data-centerpiece="session">Session only</button>
      <button type="button" data-centerpiece="view">View only</button>
    </div>
  </section>
</div>

<style>
  .tweaks {
    position: fixed; bottom: 20px; right: 20px;
    width: 280px;
    background: var(--plate); color: var(--plate-ink);
    border: 1px solid var(--plate-border);
    border-radius: 14px;
    box-shadow: var(--shadow-plate);
    font-family: var(--font-body); font-size: 12px;
    z-index: 100; overflow: hidden;
    display: none;
  }
  .tweaks[data-open="true"] { display: block; }
  .tweaks header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 14px;
    border-bottom: 1px solid var(--plate-line);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--plate-sub);
  }
  .tweaks header button {
    appearance: none; border: none;
    background: transparent; color: var(--plate-sub);
    cursor: pointer; font-size: 16px;
  }
  .tweaks section {
    padding: 14px;
    border-bottom: 1px solid var(--plate-line);
  }
  .tweaks section:last-child { border-bottom: none; }
  .tweaks h4 {
    margin: 0 0 8px;
    font-size: 11px; font-weight: 600;
    color: var(--plate-ink);
  }
  .tweak-radio { display: grid; gap: 4px; }
  .tweak-radio button {
    appearance: none;
    border: 1px solid var(--plate-border);
    background: var(--plate); color: var(--plate-ink);
    padding: 8px 10px; border-radius: 8px;
    text-align: left;
    font-family: inherit; font-size: 12px;
    cursor: pointer;
  }
  .tweak-radio button:hover { background: var(--chip-bg); }
  .tweak-radio button[aria-pressed="true"] {
    background: var(--plate-ink); color: var(--plate);
    border-color: var(--plate-ink);
  }
</style>
