---
const clusters = [
  { num: '01', href: '#cluster-agents', title: 'Agents', joiner: '+', right: 'Skills', desc: 'One config per agent. Standard skill files. Works across Claude, Codex, Gemini, Cursor.' },
  { num: '02', href: '#cluster-data',   title: 'Artifacts', joiner: '+', right: 'Collections', desc: 'Your data in shapes you define. Every file your agents produce, indexed and addressable.' },
  { num: '03', href: '#cluster-views',  title: 'Views', joiner: '', right: '', desc: 'Web components for tables, charts, chat, artifacts, forms. A reactive SDK wired to every runtime signal. Save the file; the app updates.' },
];
---

<section class="axes-strip" id="features" data-reveal>
  <div class="container">
    <div class="cluster-grid">
      {clusters.map((c) => (
        <a class="cluster spotlight" href={c.href} data-reveal-child>
          <span class="cluster-num">{c.num}</span>
          <span class="cluster-title">
            {c.title}
            {c.joiner && <i> {c.joiner} </i>}
            {c.right}
          </span>
          <span class="cluster-desc">{c.desc}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .axes-strip {
    padding: 28px 0 64px;
    border-top: 1px solid var(--rail);
    background: color-mix(in oklab, var(--plate) 35%, transparent);
  }
  .cluster-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr;
    gap: 16px;
  }
  @media (max-width: 900px) { .cluster-grid { grid-template-columns: 1fr; } }
  .cluster {
    display: flex; flex-direction: column; gap: 10px;
    padding: 24px 22px; border-radius: 16px;
    background: var(--plate);
    border: 1px solid var(--plate-border);
    text-decoration: none; min-height: 160px;
    position: relative;
    transition:
      transform 280ms var(--ease-out),
      border-color 280ms ease,
      box-shadow 280ms ease;
  }
  .cluster:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--primary) 45%, var(--plate-border));
    box-shadow: 0 14px 32px color-mix(in oklab, var(--page-fg) 12%, transparent);
  }
  .cluster-num {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; color: var(--subtle-ink);
    letter-spacing: 0.16em;
  }
  .cluster-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: 22px; color: var(--page-fg);
    letter-spacing: -0.02em; line-height: 1.05;
  }
  .cluster-title i {
    font-style: normal; color: var(--primary);
    font-weight: 400; margin: 0 2px;
  }
  .cluster-desc {
    font-size: 13px; line-height: 1.5;
    color: var(--muted-ink); margin-top: auto;
  }
</style>
