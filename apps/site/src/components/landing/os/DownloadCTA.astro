---
/*
 * DownloadCTA — closing strip every feature window drops at its bottom.
 *
 * Two parts:
 *   1. A short message that ties the section to the action.
 *   2. A button that opens the Download window (no nav). Falls back to
 *      anchoring `/download` if the JS handler hasn't wired up yet.
 *   3. A secondary "Join waitlist" link for the "not ready" case.
 *
 * Detected-OS label gets filled in by the small inline script — same
 * UA-sniff the Download window already uses, kept consistent.
 */
interface Props {
  /** One-line lead-in shown above the button. */
  message?: string;
  /** Override the primary CTA verb. */
  primary?: string;
}
const {
  message = "Stop reading. Start shipping.",
  primary = "Get Ship",
} = Astro.props;
---
<aside class="dl-cta" data-dl-cta>
  <p class="dl-cta-msg">{message}</p>
  <div class="dl-cta-actions">
    <a
      class="dl-cta-primary"
      href="/download"
      data-open-window="download"
    >
      {primary} · <span data-dl-cta-os>your machine</span>
    </a>
    <a class="dl-cta-secondary" href="/waitlist">Join the waitlist</a>
  </div>
</aside>

<style>
  .dl-cta {
    display: flex; flex-direction: column; align-items: center; gap: 14px;
    margin: 16px auto 0; padding: 22px 26px 24px;
    width: 100%; max-width: 720px;
    border-radius: 18px;
    background:
      radial-gradient(120% 100% at 50% 0%, color-mix(in oklch, var(--w-accent) 18%, transparent), transparent 70%),
      color-mix(in oklch, var(--card) 92%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 30%, transparent);
    box-shadow: 0 18px 44px -28px color-mix(in oklch, var(--w-accent) 70%, transparent);
    text-align: center;
  }
  .dl-cta-msg {
    margin: 0;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(16px, 1.8vw, 20px); letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .dl-cta-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .dl-cta-primary {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 18px;
    border-radius: 10px;
    background: var(--w-accent);
    color: var(--background);
    border: 1px solid var(--w-accent);
    text-decoration: none;
    font-family: var(--font-body); font-weight: 700; font-size: 13.5px;
    letter-spacing: 0.01em;
    transition: transform 140ms ease, filter 140ms ease, box-shadow 140ms ease;
    box-shadow: 0 8px 22px -10px color-mix(in oklch, var(--w-accent) 70%, transparent);
  }
  .dl-cta-primary:hover { transform: translateY(-1px); filter: brightness(1.06); box-shadow: 0 14px 30px -10px color-mix(in oklch, var(--w-accent) 80%, transparent); }
  .dl-cta-primary [data-dl-cta-os] {
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    opacity: 0.78;
  }
  .dl-cta-secondary {
    color: color-mix(in oklch, var(--foreground) 64%, var(--background));
    text-decoration: none;
    font-size: 12.5px; font-weight: 600;
    padding: 8px 10px;
    border-radius: 8px;
    transition: color 140ms ease, background 140ms ease;
  }
  .dl-cta-secondary:hover { color: var(--foreground); background: color-mix(in oklch, var(--foreground) 6%, transparent); }
</style>

<script>
  /* Fill the OS label and ensure `data-open-window` always exists. */
  for (const cta of document.querySelectorAll<HTMLElement>('[data-dl-cta]')) {
    const label = cta.querySelector<HTMLElement>('[data-dl-cta-os]');
    if (!label) continue;
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const blob = `${(nav.userAgentData?.platform || '').toLowerCase()} ${navigator.userAgent.toLowerCase()} ${(navigator.platform || '').toLowerCase()}`;
    const os = /wsl/.test(blob)
      ? 'WSL'
      : /mac|iphone|ipad/.test(blob)
        ? 'macOS'
        : /win/.test(blob)
          ? 'Windows'
          : /linux|x11|ubuntu|fedora|debian/.test(blob)
            ? 'Linux'
            : null;
    if (os) label.textContent = os;
  }
</script>
