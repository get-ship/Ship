<script>
  import { whenWindowBody } from '../../../scripts/window-lazy';
  whenWindowBody('agents', () => {
  /*
   * Light interactivity:
   * - Facet chip jump-links scroll into view (CSS scroll-margin handles offset).
   * - Universal harness rail: clicking a card switches the file tree + command.
   * - Configurable form: chip toggles + segmented selection (visual only).
   */
  const root = document.querySelector<HTMLElement>('[data-app-window="agents"] .stage');
  if (root) {
    // Universal harness picker.
    const uCards = Array.from(root.querySelectorAll<HTMLElement>('.u-card[data-harness]'));
    const uTrees = Array.from(root.querySelectorAll<HTMLElement>('.u-tree[data-tree]'));
    const uCmdName = root.querySelector<HTMLElement>('[data-h-name]');
    const pickHarness = (id: string) => {
      for (const c of uCards) (c.dataset.harness === id ? c.setAttribute('data-active', 'true') : c.removeAttribute('data-active'));
      for (const t of uTrees) t.hidden = t.dataset.tree !== id;
      if (uCmdName) uCmdName.textContent = id;
    };
    for (const c of uCards) c.addEventListener('click', () => pickHarness(c.dataset.harness!));

    // Configurable form toggles.
    for (const chip of Array.from(root.querySelectorAll<HTMLElement>('.chip[data-toggle]'))) {
      chip.addEventListener('click', () => {
        const on = chip.getAttribute('data-on') === 'true';
        chip.setAttribute('data-on', on ? 'false' : 'true');
        chip.setAttribute('variant', on ? 'outline' : 'soft');
      });
    }
    for (const row of Array.from(root.querySelectorAll<HTMLElement>('[data-segrow]'))) {
      const segs = Array.from(row.querySelectorAll<HTMLElement>('.seg[data-val]'));
      for (const s of segs) {
        s.addEventListener('click', () => {
          for (const other of segs) {
            if (other === s) {
              other.setAttribute('variant', 'solid');
              other.setAttribute('tone', 'primary');
              other.setAttribute('data-on', 'true');
            } else {
              other.setAttribute('variant', 'ghost');
              other.removeAttribute('tone');
              other.removeAttribute('data-on');
            }
          }
        });
      }
    }
  }
  });
</script>
