---
// FILE_CAP_OVERRIDE: scroll-story across 5 facets — every facet is a
// full-width 2-col section that uses the actual window. Splitting would
// fragment the visual flow this surface is supposed to deliver.
/*
 * AgentsWindow — scroll-story across the 5 facets of a Ship agent.
 *
 * Each section uses the full window width with a 2-col stage, matching
 * the density of Data / Observability / Views / Spaces. Same content
 * as the previous tabbed version — restructured so the surface fills
 * the space instead of floating in it.
 */
import Window from './Window.astro';
import DownloadCTA from './DownloadCTA.astro';
const { open = false } = Astro.props;

// What `ship use <harness>` writes — file lists per provider.
const harnesses = [
  { id: 'claude',   name: 'Claude Code', logo: '/harness-logos/claude.svg', adaptive: false },
  { id: 'codex',    name: 'Codex',       logo: '/harness-logos/OpenAI-black-monoblossom.svg', adaptive: true },
  { id: 'cursor',   name: 'Cursor',      logo: '/harness-logos/cursor.svg', adaptive: true },
  { id: 'opencode', name: 'OpenCode',    logo: '/harness-logos/opencode-logo-dark.svg', adaptive: true },
  { id: 'pi',       name: 'pi',          logo: '/harness-logos/pi-logo-on-light.svg', adaptive: true },
];

const compiled: Record<string, Array<{ path: string; note: string }>> = {
  claude: [
    { path: 'CLAUDE.md',                       note: 'project rules' },
    { path: '.mcp.json',                       note: 'MCP servers' },
    { path: '.claude/agents/inbox-triage.md',  note: 'agent profile' },
    { path: '.claude/skills/',                 note: '5 skills compiled' },
    { path: '.claude/settings.json',           note: 'provider settings' },
  ],
  codex: [
    { path: 'AGENTS.md',                       note: 'project rules' },
    { path: '.codex/config.toml',              note: 'provider settings' },
    { path: '.codex/agents/inbox-triage.toml', note: 'agent profile' },
    { path: '.codex/skills/',                  note: '5 skills compiled' },
  ],
  cursor: [
    { path: '.cursor/rules/',                  note: 'project rules' },
    { path: '.cursor/mcp.json',                note: 'MCP servers' },
    { path: '.cursor/agents/inbox-triage.md',  note: 'agent profile' },
  ],
  opencode: [
    { path: '.opencode/agent.toml',            note: 'agent profile' },
    { path: '.opencode/rules.md',              note: 'project rules' },
    { path: '.opencode/mcp.json',              note: 'MCP servers' },
  ],
  pi: [
    { path: '.pi/config.yaml',                 note: 'agent + provider' },
    { path: '.pi/rules/',                      note: 'project rules' },
    { path: '.pi/skills/',                     note: '5 skills compiled' },
  ],
};

const skillsOpts = ['format-email', 'summarize-thread', 'draft-reply', 'translate', 'schedule'];
const mcpOpts    = ['gmail', 'linear', 'slack', 'github', 'notion'];

// Pinned annotations for the Visual section's right rail.
const annotations = [
  { id: 1, host: 'sui-stat (ARR)',     note: 'make this the hero',        when: '2m' },
  { id: 2, host: 'sui-sparkline',      note: 'use brand blue, not orange', when: '2m' },
  { id: 3, host: 'markdown · summary', note: 'tighten this copy',         when: '1m' },
  { id: 4, host: 'sui-stat (P0s)',     note: 'cut — not needed yet',      when: 'now' },
];

const facets = [
  { id: 'visual',       title: 'Visual',       eyebrow: 'Visual',       headline: 'Chat, reimagined.',                kicker: 'An agent renders a real surface. Point at it, annotate it, replay it.' },
  { id: 'universal',    title: 'Universal',    eyebrow: 'Universal',    headline: 'One config. Every model.',         kicker: "Same agent compiles to Claude Code, Codex, Cursor, OpenCode, pi — each provider's native format. No lock-in, no fork." },
  { id: 'configurable', title: 'Configurable', eyebrow: 'Configurable', headline: 'Everything is a field.',           kicker: 'Skills, permissions, rules, MCP servers, model, space — every facet of your agent is a knob you turn in the GUI.' },
  { id: 'programmable', title: 'Programmable', eyebrow: 'Programmable', headline: 'Skills, pipelines, triggers.',     kicker: 'Skills give tools. Pipelines chain agents. Triggers fire them on real events.' },
  { id: 'observable',   title: 'Observable',   eyebrow: 'Observable',   headline: 'Watch every move.',                kicker: 'Every action lands on a live, event-sourced bus. Scrub back, replay, audit. Observability is a property of the runtime.' },
];
---
<Window app="agents" title="Agents" meta="first-class actors" mark="A" accent="agents" open={open} defer>
  <div class="win-scroll agents">
    <div class="stage">

      {/* ── Hero ─────────────────────────────────────────────────────── */}
      <header class="hero">
        <div class="eyebrow">Agents</div>
        <h2 class="hl">Chatbots answer. <span class="hl-accent">Ship agents ship.</span></h2>
        <p class="prompt">A Ship agent is a first-class actor — it runs on your machine, under permissions you set, in the harness you already use, and it builds real software you can watch and undo. Not a tab you rent. Something you own.</p>
        <nav class="facet-chips" aria-label="Facets">
          {facets.map((f) => (
            <a href={`#agent-${f.id}`} class="fc"><span class="fc-num">0{facets.indexOf(f) + 1}</span>{f.title}</a>
          ))}
        </nav>
      </header>

      {/* ── 01 · Visual ──────────────────────────────────────────────── */}
      <section class="fc-sec" id="agent-visual" data-facet="visual">
        <header class="sec-head">
          <span class="sec-num">01</span>
          <span class="sec-tag">Visual</span>
          <h3 class="sec-hl">Chat, reimagined.</h3>
          <p class="sec-sub">Instead of a wall of text, an agent renders a real surface — stats, charts, copy — that you can point at and annotate. Markup beats paragraphs. The surface and your notes both stay on the bus, replayable like anything else.</p>
        </header>

        <div class="sec-body visual-body">
          <div class="v-canvas" data-canvas>
            <div class="v-surface">
              <div class="v-bar">
                <span class="v-bar-title">Q3 recap · draft</span>
                <sui-badge variant="soft" size="sm">share</sui-badge>
              </div>
              <div class="v-row">
                <sui-stat size="lg" tone="success" class="v-hot" data-inspect="sui-stat">
                  <span slot="label">ARR</span>
                  $1.24M
                  <span slot="trend">+18%</span>
                </sui-stat>
                <div class="v-spark v-hot" data-inspect="sui-sparkline">
                  <sui-sparkline data="32,48,42,52,58,74,82" tone="primary" width="240" height="68" fill label="q3"></sui-sparkline>
                </div>
              </div>
              <p class="v-copy v-hot" data-inspect="markdown"><b>What shipped</b><br/>Auth rewrite landed; mobile picker stable on iOS 18; 2 P0s closed.</p>
              <div class="v-row">
                <sui-stat size="md" tone="primary" class="v-hot" data-inspect="sui-stat">
                  <span slot="label">NPS</span>
                  72
                  <span slot="trend">+9</span>
                </sui-stat>
                <sui-stat size="md" tone="warning" class="v-hot" data-inspect="sui-stat">
                  <span slot="label">P0s open</span>
                  0
                  <span slot="trend">-2</span>
                </sui-stat>
              </div>
            </div>
            <p class="v-hint">hover any element · click to pin</p>
          </div>

          <aside class="v-side">
            <header class="v-side-head">Pinned notes <span>4</span></header>
            <ul class="v-anns">
              {annotations.map((a) => (
                <li class="v-ann">
                  <span class="v-ann-i">{a.id}</span>
                  <span class="v-ann-body">
                    <span class="v-ann-host">{a.host}</span>
                    <span class="v-ann-note">{a.note}</span>
                  </span>
                  <span class="v-ann-when">{a.when}</span>
                </li>
              ))}
            </ul>
            <footer class="v-side-foot">All notes replay with the run. Reviewers see exactly what you pointed at.</footer>
          </aside>
        </div>
      </section>

      {/* ── 02 · Universal ───────────────────────────────────────────── */}
      <section class="fc-sec" id="agent-universal" data-facet="universal">
        <header class="sec-head">
          <span class="sec-num">02</span>
          <span class="sec-tag">Universal</span>
          <h3 class="sec-hl">One config. Every model.</h3>
          <p class="sec-sub">A single agent profile compiles to each provider's native format. Switch model or tool any time. No fork, no rewrite.</p>
        </header>

        <div class="sec-body universal-body">
          <div class="u-rail">
            {harnesses.map((h, i) => (
              <button class="u-card" type="button" data-harness={h.id} data-active={i === 1 ? 'true' : undefined}>
                <img src={h.logo} class:list={['u-card-logo', { adaptive: h.adaptive }]} alt="" />
                <span class="u-card-name">{h.name}</span>
                <span class="u-card-meta">{compiled[h.id].length} files</span>
                <sui-status-dot tone="success" size="sm" class="u-card-dot"></sui-status-dot>
              </button>
            ))}
          </div>

          <div class="u-stage">
            <header class="u-stage-head">
              <code class="u-cmd">ship use <span data-h-name>codex</span></code>
              <span class="u-stage-meta">writes</span>
            </header>
            <!-- SCREENSHOT TODO: real Ship shell showing compiled files for different harnesses — deferred until SUI ready -->
            <div class="u-tree-wrap">
              {harnesses.map((h, i) => (
                <ul class="u-tree" data-tree={h.id} hidden={i !== 1}>
                  {compiled[h.id].map((row) => (
                    <li class="u-trow">
                      <span class="u-tpath">{row.path}</span>
                      <span class="u-tnote">{row.note}</span>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
            <footer class="u-stage-foot">All five providers compile from the same agent profile. Swap freely.</footer>
          </div>
        </div>
      </section>

      {/* ── 03 · Configurable ────────────────────────────────────────── */}
      <section class="fc-sec" id="agent-configurable" data-facet="configurable">
        <header class="sec-head">
          <span class="sec-num">03</span>
          <span class="sec-tag">Configurable</span>
          <h3 class="sec-hl">Everything is a field.</h3>
          <p class="sec-sub">Skills, permissions, rules, MCP servers, model, space — each is a knob in the GUI. Versioned, replayable, shareable as one declaration.</p>
        </header>

        <div class="sec-body cfg-body">
          <div class="cfg-form">
            <div class="cfg-row">
              <label class="cfg-k">Model</label>
              <div class="seg-row" data-segrow>
                <sui-button class="seg" variant="solid" size="sm" tone="primary" data-val="claude-opus" data-on="true">Claude</sui-button>
                <sui-button class="seg" variant="ghost" size="sm" data-val="gpt-4">GPT-4</sui-button>
                <sui-button class="seg" variant="ghost" size="sm" data-val="gemini">Gemini</sui-button>
                <sui-button class="seg" variant="ghost" size="sm" data-val="local">Local</sui-button>
              </div>
            </div>
            <div class="cfg-row">
              <label class="cfg-k">Skills</label>
              <div class="chip-row">
                {skillsOpts.map((s, i) => (
                  <sui-badge class="chip" variant={i < 3 ? 'soft' : 'outline'} size="sm" data-toggle={s} data-on={i < 3 ? 'true' : 'false'}>{s}</sui-badge>
                ))}
              </div>
            </div>
            <div class="cfg-row">
              <label class="cfg-k">Permissions</label>
              <div class="seg-row" data-segrow>
                <sui-button class="seg" variant="ghost" size="sm" data-val="read-only">Read-only</sui-button>
                <sui-button class="seg" variant="solid" size="sm" tone="primary" data-val="standard" data-on="true">Standard</sui-button>
                <sui-button class="seg" variant="ghost" size="sm" data-val="full">Full access</sui-button>
              </div>
            </div>
            <div class="cfg-row">
              <label class="cfg-k">MCP servers</label>
              <div class="chip-row">
                {mcpOpts.map((s, i) => (
                  <sui-badge class="chip" variant={i < 2 ? 'soft' : 'outline'} size="sm" data-toggle={s} data-on={i < 2 ? 'true' : 'false'}>{s}</sui-badge>
                ))}
              </div>
            </div>
            <div class="cfg-row">
              <label class="cfg-k">Space</label>
              <div class="seg-row" data-segrow>
                <sui-button class="seg" variant="solid" size="sm" tone="primary" data-val="personal" data-on="true">Personal</sui-button>
                <sui-button class="seg" variant="ghost" size="sm" data-val="acme">Acme Team</sui-button>
                <sui-button class="seg" variant="ghost" size="sm" data-val="launch">Launch</sui-button>
              </div>
            </div>
          </div>

          <aside class="cfg-preview">
            <header class="cfg-preview-h"><span class="dot dot-live" aria-hidden="true"></span>inbox-triage.yaml</header>
            <pre class="cfg-yaml"
><span class="y-k">name</span>: inbox-triage
<span class="y-k">model</span>: <span class="y-v">claude-opus</span>
<span class="y-k">space</span>: <span class="y-v">personal</span>
<span class="y-k">permissions</span>: <span class="y-v">standard</span>
<span class="y-k">skills</span>:
  - format-email
  - summarize-thread
  - draft-reply
<span class="y-k">mcp</span>:
  - gmail
  - linear
<span class="y-k">rules</span>:
  - always respect tone
</pre>
            <footer class="cfg-preview-foot">Generated live. The GUI <em>is</em> the editor — version this file, share it, fork your teammate's.</footer>
          </aside>
        </div>
      </section>

      {/* ── 04 · Programmable ────────────────────────────────────────── */}
      <section class="fc-sec" id="agent-programmable" data-facet="programmable">
        <header class="sec-head">
          <span class="sec-num">04</span>
          <span class="sec-tag">Programmable</span>
          <h3 class="sec-hl">Skills, pipelines, triggers.</h3>
          <p class="sec-sub">Three composable primitives. Each step can be a different agent, model, or skill. Restartable from any failed step.</p>
        </header>

        <div class="sec-body prog-body">
          <ol class="p-spine">
            <li class="p-node p-skill" data-step="1" data-active>
              <header class="p-node-h"><span class="p-kind">SKILL</span><span class="p-name">format-email</span></header>
              <p class="p-desc">A reusable ability. Cleans a draft's tone, restructures paragraphs, normalises the signoff.</p>
              <dl class="p-fields">
                <div><dt>input</dt><dd><code>{`{ draft, tone: 'formal' | 'casual' }`}</code></dd></div>
                <div><dt>output</dt><dd><code>{`{ formatted }`}</code></dd></div>
                <div><dt>used by</dt><dd>4 pipelines · 12 agents</dd></div>
              </dl>
            </li>
            <li class="p-arrow" aria-hidden="true">→</li>
            <li class="p-node p-pipeline" data-step="2">
              <header class="p-node-h"><span class="p-kind">PIPELINE</span><span class="p-name">inbox-triage</span></header>
              <p class="p-desc">Chains agents into a workflow. Each step can be a different agent, model, or skill.</p>
              <ol class="p-steps">
                <li><span class="p-i">1</span><code>read</code><span class="p-meta">skill</span></li>
                <li><span class="p-i">2</span><code>summarize-thread</code><span class="p-meta">skill</span></li>
                <li><span class="p-i">3</span><code>format-email</code><span class="p-meta">skill ×3</span></li>
                <li><span class="p-i">4</span><code>draft-reply</code><span class="p-meta">agent</span></li>
                <li><span class="p-i">5</span><code>review.gate</code><span class="p-meta">human</span></li>
              </ol>
            </li>
            <li class="p-arrow" aria-hidden="true">→</li>
            <li class="p-node p-trigger" data-step="3">
              <header class="p-node-h"><span class="p-kind">TRIGGER</span><span class="p-name">gmail.new-message</span></header>
              <p class="p-desc">Fires the pipeline on real events. Backoff with exponential retry; replay from the event log.</p>
              <dl class="p-fields">
                <div><dt>source</dt><dd><code>gmail (MCP)</code></dd></div>
                <div><dt>filter</dt><dd><code>from:!noreply &amp; priority:!low</code></dd></div>
                <div><dt>others</dt><dd>cron · file · webhook · MCP signal</dd></div>
              </dl>
            </li>
          </ol>
        </div>
      </section>

      {/* ── 05 · Observable ──────────────────────────────────────────── */}
      <section class="fc-sec" id="agent-observable" data-facet="observable">
        <header class="sec-head">
          <span class="sec-num">05</span>
          <span class="sec-tag">Observable</span>
          <h3 class="sec-hl">Watch every move.</h3>
          <p class="sec-sub">Every prompt, tool call, decision, output lands on a live, event-sourced bus. The GUI shows it in real time. Scrub backwards, replay any moment, audit any run.</p>
        </header>

        <div class="sec-body obs-body">
          <sui-card variant="soft" padding="md" class="o-kpi">
            <div class="o-kpi-row">
              <sui-stat size="md" tone="primary">
                <span slot="label">agents active</span>
                5
                <span slot="trend">live</span>
              </sui-stat>
              <sui-stat size="md" tone="success">
                <span slot="label">events / min</span>
                234
                <span slot="trend">+18%</span>
              </sui-stat>
            </div>
            <div class="o-spark">
              <div class="o-spark-label">throughput · last 60s</div>
              <sui-sparkline data="22,28,34,42,48,52,58,62,68,74,82,88" tone="primary" width="360" height="46" fill label="events"></sui-sparkline>
            </div>
          </sui-card>

          <sui-card variant="soft" padding="md" class="o-bars">
            <div class="o-bars-label">events per agent · last hour</div>
            <div class="o-bars-list">
              <div class="o-bar-row"><span class="o-bar-name">inbox-triage</span><div class="o-bar-track"><span class="o-bar-fill" style="width:78%"></span></div><span class="o-bar-n">78</span></div>
              <div class="o-bar-row"><span class="o-bar-name">code-review</span><div class="o-bar-track"><span class="o-bar-fill" style="width:54%"></span></div><span class="o-bar-n">54</span></div>
              <div class="o-bar-row"><span class="o-bar-name">daily-recap</span><div class="o-bar-track"><span class="o-bar-fill" style="width:32%"></span></div><span class="o-bar-n">32</span></div>
              <div class="o-bar-row"><span class="o-bar-name">on-call-watch</span><div class="o-bar-track"><span class="o-bar-fill" style="width:18%"></span></div><span class="o-bar-n">18</span></div>
            </div>
          </sui-card>

          <div class="o-events">
            <header class="o-events-h">Live feed</header>
            <sui-list-tile density="compact" class="o-ev">
              <sui-status-dot slot="leading" tone="success" size="sm"></sui-status-dot>
              Inbox · drafted 5 replies
              <span slot="trailing" class="o-ago">2s</span>
            </sui-list-tile>
            <sui-list-tile density="compact" class="o-ev">
              <sui-status-dot slot="leading" tone="success" size="sm"></sui-status-dot>
              Repo · ran the test suite
              <span slot="trailing" class="o-ago">40s</span>
            </sui-list-tile>
            <sui-list-tile density="compact" class="o-ev">
              <sui-status-dot slot="leading" tone="warning" pulse size="sm"></sui-status-dot>
              Launch · waiting on your review
              <span slot="trailing" class="o-ago">now</span>
            </sui-list-tile>
            <sui-list-tile density="compact" class="o-ev">
              <sui-status-dot slot="leading" tone="success" size="sm"></sui-status-dot>
              Recap · published Friday digest
              <span slot="trailing" class="o-ago">3m</span>
            </sui-list-tile>
          </div>
        </div>
      </section>

      {/* ── Closing ─────────────────────────────────────────────────── */}
      <footer class="closer">
        <p>One agent. Five facets. <b>Same source of truth.</b></p>
      </footer>

      <DownloadCTA message="Stop reading specs. Start tuning agents." />


    </div>
  </div>
</Window>

<style>
  .agents { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow-y: auto; }
  .stage {
    width: 100%; max-width: 1180px; margin: 0 auto;
    padding: 28px 28px 64px;
    display: flex; flex-direction: column; gap: 64px;
  }

  /* ── Hero ── */
  .hero { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .eyebrow { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--w-accent); }
  .hl { font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 4.2vw, 54px); letter-spacing: -0.03em; line-height: 1.02; margin: 0; color: var(--foreground); }
  .hl-accent {
    background: linear-gradient(100deg, var(--w-accent), color-mix(in oklch, var(--w-accent) 50%, var(--accent)));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .prompt { font-size: 14px; line-height: 1.55; color: color-mix(in oklch, var(--foreground) 66%, var(--background)); margin: 0; max-width: 56ch; }
  .facet-chips { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .fc {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 12px; border-radius: 999px;
    background: color-mix(in oklch, var(--w-accent) 7%, var(--card));
    border: 1px solid color-mix(in oklch, var(--w-accent) 22%, transparent);
    font-family: var(--font-body); font-weight: 600; font-size: 12px;
    color: var(--foreground); text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
  }
  .fc:hover { transform: translateY(-1px); background: color-mix(in oklch, var(--w-accent) 16%, var(--card)); border-color: var(--w-accent); }
  .fc-num { font-family: var(--font-mono); font-size: 9.5px; color: color-mix(in oklch, var(--w-accent) 80%, var(--foreground)); letter-spacing: 0.1em; }

  /* ── Section scaffolding ── */
  .fc-sec {
    display: flex; flex-direction: column; gap: 22px;
    scroll-margin-top: 24px;
  }
  .sec-head {
    display: grid;
    grid-template-columns: auto auto 1fr;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      'num tag .'
      'hl  hl  hl'
      'sub sub sub';
    align-items: center;
    gap: 8px 12px;
  }
  .sec-num {
    grid-area: num;
    font-family: var(--font-mono); font-size: 11px; font-weight: 800;
    letter-spacing: 0.16em; color: var(--w-accent);
    padding: 4px 10px; border-radius: 999px;
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 30%, transparent);
  }
  .sec-tag {
    grid-area: tag;
    font-family: var(--font-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 60%, var(--background));
  }
  .sec-hl {
    grid-area: hl;
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(26px, 3vw, 36px); letter-spacing: -0.025em;
