  .p-name { font-family: var(--font-display); font-size: 16px; font-weight: 800; letter-spacing: -0.01em; color: var(--foreground); }
  .p-desc { margin: 0; font-size: 12.5px; line-height: 1.5; color: color-mix(in oklch, var(--foreground) 70%, var(--background)); }
