---
/*
 * FaqWindow — short answers to the questions everyone asks before they
 * install. Real questions, real answers. Click a question to expand.
 */
import Window from './Window.astro';
const { open = false } = Astro.props;

const faqs = [
  { q: 'Is Ship free?',
    a: 'Yes — locally, always. Bring your own model (Anthropic, OpenAI, Google, or local). You pay $20/month only when you want Ship Cloud (sync, replay across machines).' },
  { q: 'What about my data?',
    a: 'Stays on your machine. Ship is a local-first runtime — the daemon, your data, and your agents run on your laptop. Cloud sync is opt-in.' },
  { q: 'Does it work with Claude Code? Cursor? Codex? OpenCode?',
    a: 'All of them. Write one agent profile; `ship use` compiles it to each provider’s native format. No parallel configs.' },
  { q: 'What runs my UI?',
    a: 'SUI — Ship’s component framework. Views are `.sui` files compiled ahead of time to ESM. Tiny bundles, fine-grained reactivity, hot reload while you edit.' },
  { q: 'Can agents see my whole machine?',
    a: 'No. Agents are scoped by default — files, network, shell, spend all require explicit grants. Privileged actions wait for your approval.' },
  { q: 'Can my team share an agent?',
    a: 'Yes. A space is the unit of collaboration — share its views, agents, and data, or keep one private. Each agent is scoped to a space.' },
  { q: 'What platforms?',
    a: 'macOS, Windows, and Linux — Apple Silicon and Intel on the Mac side, x86_64 + arm64 on Linux. One install path per OS; the runtime is the same.' },
];
---
<Window app="faq" title="FAQ" meta="straight answers" mark="?" accent="overview" open={open}>
  <div class="win-scroll faq">
    <div class="stage">
      <div class="eyebrow">FAQ · straight answers</div>
      <h2 class="hl">Before you install.</h2>
      <p class="prompt">The questions everyone asks. Tap one to expand.</p>

      <div class="list">
        {faqs.map((f, i) => (
          <details class="row" open={i === 0}>
            <summary class="q">{f.q}<span class="caret">+</span></summary>
            <p class="a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</Window>

<style>
  .faq { display: flex; }
  .stage { margin: auto; width: 100%; max-width: 620px; padding: 26px 28px; }
  .eyebrow { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--w-accent); }
  .hl { font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 34px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.04; margin: 6px 0 4px; color: var(--foreground); }
  .prompt { font-size: 13.5px; line-height: 1.5; color: color-mix(in oklch, var(--foreground) 66%, var(--background)); margin: 0 0 14px; }
  .list { display: flex; flex-direction: column; gap: 2px; }
  .row { border-bottom: 1px solid color-mix(in oklch, var(--foreground) 10%, transparent); }
  .row:last-child { border-bottom: 0; }
  .q { cursor: pointer; list-style: none; padding: 11px 4px; font-weight: 700; font-size: 14px; color: var(--foreground); display: flex; align-items: center; justify-content: space-between; }
  .q::-webkit-details-marker { display: none; }
  .caret { font-family: var(--font-mono); font-size: 14px; color: var(--w-accent); transition: transform 200ms ease; }
  .row[open] .caret { transform: rotate(45deg); }
  .a { margin: 0 0 12px; padding: 0 4px; font-size: 13px; line-height: 1.55; color: color-mix(in oklch, var(--foreground) 70%, var(--background)); }
</style>
