---
/*
 * DownloadWindow — the real download surface. Detects the visitor's OS and
 * recommends it. Installers are in public beta and not yet shipped, so
 * every platform routes to the waitlist (/download/coming-soon) — same
 * honest behaviour as the original PlatformDetect. No invented version or
 * size; flip the hrefs to real artifacts at launch.
 */
import Window from './Window.astro';
const { open = false } = Astro.props;
const icons: Record<string, string> = {
  macos: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.15-2.9.88-3.6.88s-1.9-.86-3.1-.84C6.5 7.1 5 8.1 4.2 9.6c-1.7 2.9-.4 7.2 1.2 9.5.8 1.1 1.7 2.4 3 2.35 1.2-.05 1.66-.78 3.1-.78s1.85.78 3.1.75c1.3-.02 2.1-1.15 2.9-2.26.9-1.3 1.27-2.56 1.3-2.62-.03-.01-2.5-.96-2.5-3.79zM14 5.4c.66-.8 1.1-1.92.98-3.03-.95.04-2.1.63-2.78 1.43-.6.7-1.13 1.84-.99 2.92 1.06.08 2.13-.54 2.79-1.32z"/></svg>`,
  windows: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.7 10.3 4.7v6.6H3zM11.2 4.6 21 3.2v8H11.2zM3 12.7h7.3v6.6L3 18.3zM11.2 12.7H21v8l-9.8-1.4z"/></svg>`,
  linux: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c2.1 0 3.2 2 3.2 4.6 0 1.7 1 2.9 1.9 4.1.9 1.3 2.1 2.8 2.1 4.9 0 1.6-.9 2.5-1.9 2.5-.8 0-1.1-.4-1.7-.4-.3 0-.5.2-1 .5-.8.5-1.6.8-2.6.8s-1.8-.3-2.6-.8c-.5-.3-.7-.5-1-.5-.6 0-.9.4-1.7.4-1 0-1.9-.9-1.9-2.5 0-2.1 1.2-3.6 2.1-4.9.9-1.2 1.9-2.4 1.9-4.1C8.8 4 9.9 2 12 2z"/></svg>`,
};
const platforms = [
  { id: 'macos', label: 'macOS', min: '10.15 or later', rec: 'For your Mac' },
  { id: 'windows', label: 'Windows', min: '10 or later', rec: 'For your PC' },
  { id: 'linux', label: 'Linux', min: 'x86_64 · arm64', rec: 'For this machine' },
];
---
<Window app="download" title="Download Ship" meta="public beta" mark="↓" accent="skills" open={open}>
  <div class="win-scroll dl">
    <header class="win-hero">
      <div class="parallax" data-parallax="0.4"></div>
      <div class="win-eyebrow">Download · public beta</div>
      <h2 class="win-headline">Get Ship.</h2>
      <p class="win-lede">Runs on your machine, bring your own model, free for personal use. Installers ship with the public beta — pick your platform and we'll email you the moment yours is ready.</p>
    </header>

    <section class="win-section" data-reveal>
      <div class="platforms" data-platform-detect>
        {platforms.map((p) => (
          <div class="plat" data-platform={p.id}>
            <span class="pi" set:html={icons[p.id]} />
            <div class="pmeta">
              <div class="pn">{p.label}<span class="rec">{p.rec}</span></div>
              <div class="pmin">{p.min}</div>
            </div>
            <a class="plat-cta" href="/download/coming-soon">Join waitlist</a>
          </div>
        ))}
      </div>
    </section>

    <section class="win-section facts" data-reveal>
      <div class="fact"><b>Local-first</b><span>your data stays on your machine</span></div>
      <div class="fact"><b>Bring your own model</b><span>Claude · Codex · Gemini · Cursor</span></div>
      <div class="fact"><b>Free</b><span>for personal use</span></div>
    </section>
  </div>
</Window>

<style>
  .platforms { display: flex; flex-direction: column; gap: 8px; }
  .plat {
    display: grid; grid-template-columns: 24px 1fr auto; align-items: center; gap: 14px;
    padding: 12px 14px; border-radius: 10px; background: var(--card);
    border: 1px solid color-mix(in oklch, var(--border) 75%, transparent);
    transition: border-color 150ms;
  }
  .plat[data-recommended] { border-color: color-mix(in oklch, var(--w-accent) 55%, var(--border)); box-shadow: 0 0 0 3px color-mix(in oklch, var(--w-accent) 8%, transparent); }
  .pi { display: grid; place-items: center; color: color-mix(in oklch, var(--foreground) 72%, var(--background)); }
  .pi :global(svg) { width: 20px; height: 20px; display: block; }
  .pmeta { min-width: 0; }
  .pn { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13.5px; }
  .pmin { font-family: var(--font-mono); font-size: 10.5px; color: color-mix(in oklch, var(--foreground) 55%, var(--background)); margin-top: 2px; }
  /* Recommendation chip — plain span styled in-house. sui-badge was
     rendering a phantom empty pill next to its label here (slot
     leakage in the shadow tree); a flat span keeps it predictable. */
  .rec { display: none; }
  .plat[data-recommended] .rec {
    display: inline-flex; align-items: center;
    padding: 2px 8px; border-radius: 999px;
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--w-accent);
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 28%, transparent);
  }
  /* Plain anchor styled as outline-button. sui-button's slot-detection
     heuristic flipped to icon-only mode for the detected platform when
     its only child was an <a>text</a> — collapsing the button to 56px.
     Direct CSS sidesteps the heuristic. */
  .plat-cta {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 6px 14px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid color-mix(in oklch, var(--w-accent) 36%, var(--border));
    color: var(--foreground); text-decoration: none;
    font-family: var(--font-body); font-size: 12.5px; font-weight: 600;
    line-height: 1.2; white-space: nowrap;
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
  }
  .plat-cta:hover { background: color-mix(in oklch, var(--w-accent) 14%, transparent); border-color: var(--w-accent); transform: translateY(-1px); }
  .plat[data-recommended] .plat-cta {
    background: var(--w-accent);
    border-color: var(--w-accent);
    color: var(--background);
  }
  .plat[data-recommended] .plat-cta:hover { filter: brightness(1.06); }
  /* Mobile: the icon/meta/CTA row gets cramped on narrow widths — stack
     the CTA below the meta block so each column has room to breathe. */
  @media (max-width: 480px) {
    .plat {
      grid-template-columns: 24px 1fr;
      grid-template-areas: 'ico meta' '. cta';
      row-gap: 8px;
    }
    .plat .pi { grid-area: ico; }
    .plat .pmeta { grid-area: meta; }
    .plat .plat-cta { grid-area: cta; justify-self: stretch; }
    .plat .pn { flex-wrap: wrap; }
  }
  .facts { display: grid; gap: 9px; }
  .fact { display: flex; flex-direction: column; gap: 1px; }
  .fact b { font-size: 12.5px; font-weight: 600; }
  .fact span { font-family: var(--font-mono); font-size: 10.5px; color: color-mix(in oklch, var(--foreground) 58%, var(--background)); }

</style>

<script>
  const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
  const blob = `${(nav.userAgentData?.platform || '').toLowerCase()} ${navigator.userAgent.toLowerCase()} ${(navigator.platform || '').toLowerCase()}`;
  const detectedOs = /mac|iphone|ipad/.test(blob)
    ? 'macos'
    : /win/.test(blob)
      ? 'windows'
      : /linux|x11|ubuntu|fedora|debian/.test(blob)
        ? 'linux'
        : '';

  // ── Recommend the detected platform card. ─────────────────────────
  const host = document.querySelector('[data-platform-detect]');
  if (host && detectedOs) {
    const card = host.querySelector(`[data-platform="${detectedOs}"]`);
    if (card) { card.setAttribute('data-recommended', ''); host.prepend(card); }
  }

</script>
