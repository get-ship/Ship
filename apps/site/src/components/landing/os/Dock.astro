---
/*
 * Dock.astro — launcher. Feature surfaces live inside a "Features" folder
 * (click to expand labeled launchers — no tooltip-only); utility surfaces
 * (Welcome, Pricing, Store, Download) sit on the dock directly. Tiles
 * derive their gradient from real --app-accent-* tokens.
 */
import SettingsPopover from './SettingsPopover.astro';
interface Tile { app: string; label: string; accent: string; icon: string; }

// Real macOS-style app icons live under /app-icons/. Each is a
// fully-baked 120×120 SVG with its own gradient + rounded corners, so the
// dock-tile no longer paints a backing gradient — the icon IS the tile.
const img = (file: string) => `<img class="dock-art" src="/app-icons/${file}" alt="" />`;
const I = {
  welcome:       `<img class="dock-icon dock-glyph" src="/ship-logo.svg" alt="" />`,
  agents:        img('agents.svg'),
  observability: img('observability.svg'),
  views:         img('custom-views.svg'),
  collections:   img('data.svg'),
  spaces:        img('spaces.svg'),
  security:      img('security.svg'),
  orchestration: img('orchestration.svg'),
  pricing:       img('pricing.svg'),
  docs:          img('docs.svg'),
  faq:           img('faq.svg'),
  arcade:        img('arcade.svg'),
  download:      img('download.svg'),
};

const features: Tile[] = [
  { app: 'agents', label: 'Agents', accent: 'agents', icon: I.agents },
  { app: 'orchestration', label: 'Orchestration', accent: 'pipelines', icon: I.orchestration },
  { app: 'data', label: 'Data', accent: 'collections', icon: I.collections },
  { app: 'observability', label: 'Observability', accent: 'mesh', icon: I.observability },
  { app: 'custom-views', label: 'Custom Views', accent: 'dashboard', icon: I.views },
  { app: 'security', label: 'Security', accent: 'git', icon: I.security },
  { app: 'spaces', label: 'Spaces', accent: 'theme', icon: I.spaces },
];
---
<div class="os-dock-trigger" aria-hidden="true"></div>
<nav class="os-dock" aria-label="Dock">
  <button class="dock-item" type="button" data-app-target="welcome" aria-label="Open Welcome" style="--tile: var(--app-accent-overview);">
    <span class="dock-tile" set:html={I.welcome} /><span class="running"></span><span class="tip">Welcome</span>
  </button>

  <div class="folder-wrap">
    <button class="dock-item" type="button" data-folder-toggle aria-label="Features" aria-expanded="false">
      <span class="dock-tile folder">
        {features.slice(0, 4).map((f) => (
          <span class="mini" style={`--tile: var(--app-accent-${f.accent});`} set:html={f.icon} />
        ))}
      </span>
      <span class="tip">Features</span>
    </button>
    <div class="dock-folder" data-folder hidden>
      <div class="ff-title">Features</div>
      <div class="ff-grid">
        {features.map((f) => (
          <button class="ff-item" type="button" data-app-target={f.app} style={`--tile: var(--app-accent-${f.accent});`}>
            <span class="ff-tile" set:html={f.icon} />
            <span class="ff-label">{f.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <button class="dock-item" type="button" data-app-target="pricing" aria-label="Open Pricing">
    <span class="dock-tile" set:html={I.pricing} /><span class="running"></span><span class="tip">Pricing</span>
  </button>
  <button class="dock-item" type="button" data-app-target="docs" aria-label="Open Docs">
    <span class="dock-tile" set:html={I.docs} /><span class="running"></span><span class="tip">Docs</span>
  </button>
  <button class="dock-item" type="button" data-app-target="faq" aria-label="Open FAQ">
    <span class="dock-tile" set:html={I.faq} /><span class="running"></span><span class="tip">FAQ</span>
  </button>
  <button class="dock-item dock-arcade" type="button" data-app-target="arcade" aria-label="Open Arcade">
    <span class="dock-tile" set:html={I.arcade} /><span class="running"></span><span class="tip">Arcade</span>
  </button>
  <span class="dock-div"></span>
  <button class="dock-item" type="button" data-app-target="download" aria-label="Open Download">
    <span class="dock-tile" set:html={I.download} /><span class="running"></span><span class="tip">Download</span>
  </button>
  <span class="dock-div"></span>
  <div class="dock-item dock-settings"><SettingsPopover /></div>
</nav>

<style>
  /* The dock's footprint is small but the hover-trigger is bigger so
     reaching for it isn't pixel-precise. Both flip orientation when
     :root[data-dock-pos] is `left` or `right`. */
  .os-dock-trigger {
    position: fixed;
    z-index: 79;
    pointer-events: auto;
  }
  /* Bottom (default) — trigger is a tall strip along the bottom. */
  :root[data-dock-pos='bottom'] .os-dock-trigger,
  :root:not([data-dock-pos]) .os-dock-trigger {
    left: 0; right: 0; bottom: 0;
    height: 56px;
  }
  :root[data-dock-pos='left'] .os-dock-trigger {
    top: var(--os-menubar-h, 32px); bottom: 0; left: 0;
    width: 56px;
  }
  :root[data-dock-pos='right'] .os-dock-trigger {
    top: var(--os-menubar-h, 32px); bottom: 0; right: 0;
    width: 56px;
  }

  .os-dock {
    position: fixed;
    z-index: 80;
    display: flex; gap: 12px; padding: 9px 16px;
    background: color-mix(in oklch, var(--background) 58%, transparent);
    border: 0.5px solid color-mix(in oklch, var(--foreground) 16%, transparent);
    border-radius: 18px;
    backdrop-filter: blur(26px) saturate(1.6); -webkit-backdrop-filter: blur(26px) saturate(1.6);
    box-shadow: inset 0 0.5px 0 color-mix(in oklch, var(--foreground) 10%, transparent), 0 24px 50px -14px rgba(0,0,0,0.32);
    transition: transform 220ms var(--ease-spring, cubic-bezier(.32,.72,0,1));
    align-items: flex-end;
  }
  /* Bottom (default) */
  :root[data-dock-pos='bottom'] .os-dock,
  :root:not([data-dock-pos]) .os-dock {
    left: 50%; bottom: 14px;
    transform: translate(-50%, calc(100% + 28px));
    flex-direction: row;
  }
  :root[data-dock-pos='bottom'] .os-dock:hover,
  :root[data-dock-pos='bottom'] :global(body):has(.os-dock-trigger:hover) .os-dock,
  :root[data-dock-pos='bottom'] :global(body):not([data-fullscreen]) .os-dock,
  :root:not([data-dock-pos]) .os-dock:hover,
  :root:not([data-dock-pos]) :global(body):has(.os-dock-trigger:hover) .os-dock,
  :root:not([data-dock-pos]) :global(body):not([data-fullscreen]) .os-dock {
    transform: translate(-50%, 0);
  }
  /* Left */
  :root[data-dock-pos='left'] .os-dock {
    top: 50%; left: 14px;
    transform: translate(calc(-100% - 28px), -50%);
    flex-direction: column; align-items: center;
  }
  :root[data-dock-pos='left'] .os-dock:hover,
  :root[data-dock-pos='left'] :global(body):has(.os-dock-trigger:hover) .os-dock,
  :root[data-dock-pos='left'] :global(body):not([data-fullscreen]) .os-dock {
    transform: translate(0, -50%);
  }
  /* Right */
  :root[data-dock-pos='right'] .os-dock {
    top: 50%; right: 14px;
    transform: translate(calc(100% + 28px), -50%);
    flex-direction: column; align-items: center;
  }
  :root[data-dock-pos='right'] .os-dock:hover,
  :root[data-dock-pos='right'] :global(body):has(.os-dock-trigger:hover) .os-dock,
  :root[data-dock-pos='right'] :global(body):not([data-fullscreen]) .os-dock {
    transform: translate(0, -50%);
  }
  /* Vertical dock: hide the divider rule (it was visual for horizontal). */
  :root[data-dock-pos='left'] .os-dock .dock-div,
  :root[data-dock-pos='right'] .os-dock .dock-div {
    width: 36px; height: 1px; margin: 6px 0;
  }

  /* The settings tile reuses .dock-item dimensions but renders the
     SettingsPopover instead of a launcher. Size the cog icon to match
     the dock tiles' presence. */
  .dock-settings {
    display: grid; place-items: center;
    background: transparent; border: 0; padding: 0;
  }
  .dock-settings :global(.settings-wrap) { width: 54px; height: 54px; }
  .dock-settings :global(.settings-btn) {
    width: 54px; height: 54px;
    border-radius: 13px;
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
    border: 0.5px solid color-mix(in oklch, var(--foreground) 16%, transparent);
    color: color-mix(in oklch, var(--foreground) 72%, var(--background));
    display: grid; place-items: center;
    box-shadow: 0 4px 12px -1px rgba(0,0,0,0.18);
  }
  .dock-settings :global(.settings-btn:hover) {
    background: color-mix(in oklch, var(--foreground) 14%, transparent);
  }
  .dock-settings :global(.settings-cog svg) { width: 22px; height: 22px; }

  /* Side-aware popover positioning. The default (.settings-panel inside
     SettingsPopover) opens DOWN; on a bottom dock it would clip off
     viewport, on a side dock we want it to open AWAY from the dock. */
  :root[data-dock-pos='bottom'] .dock-settings :global(.settings-panel),
  :root:not([data-dock-pos]) .dock-settings :global(.settings-panel) {
    top: auto; bottom: calc(100% + 12px); right: 0; left: auto;
  }
  :root[data-dock-pos='left'] .dock-settings :global(.settings-panel) {
    top: auto; bottom: 0; left: calc(100% + 12px); right: auto;
  }
  :root[data-dock-pos='right'] .dock-settings :global(.settings-panel) {
    top: auto; bottom: 0; right: calc(100% + 12px); left: auto;
  }

  /* Features folder popover — must be "aware of its container."
     Bottom dock: opens upward from the dock (existing behaviour).
     Side dock: floats as a fixed-position panel anchored to the side
     of the viewport, NOT to the .folder-wrap inside the dock — that
     anchor would clip off the top edge for a tall folder, since the
     folder-wrap can be anywhere in the dock's vertical extent.
     Also bump z-index so the folder paints above all windows
     (windows cap at 99; menubar is 100; folder at 101 is below the
     menubar but above the focused window). */
  :root[data-dock-pos='left'] .dock-folder,
  :root[data-dock-pos='right'] .dock-folder {
    position: fixed;
    top: calc(var(--os-menubar-h, 32px) + 12px);
    bottom: auto;
    max-height: calc(100vh - var(--os-menubar-h, 32px) - 24px);
    overflow-y: auto;
    z-index: 101;
  }
  /* Anchor relative to the dock's outer edge — measure via the dock's
     width (54px tile + 16px padding on each side = ~86px) plus a
     12px gutter. Read the dock's actual width via getBoundingClientRect
     in JS if we ever want to be pixel-perfect; the constant covers
     today's geometry. */
  :root[data-dock-pos='left'] .dock-folder {
    left: 110px; right: auto;
    transform: translateX(-8px);
  }
  :root[data-dock-pos='left'] .dock-folder.open {
    transform: translateX(0);
  }
  :root[data-dock-pos='right'] .dock-folder {
    right: 110px; left: auto;
    transform: translateX(8px);
  }
  :root[data-dock-pos='right'] .dock-folder.open {
    transform: translateX(0);
  }
  .dock-item {
    appearance: none; border: 0; background: transparent; width: 54px; height: 54px; padding: 0;
    border-radius: 13px; position: relative; display: grid; place-items: center; cursor: pointer; text-decoration: none;
    transition: transform 220ms var(--ease-spring, cubic-bezier(.32,.72,0,1));
  }
  .dock-item:hover { transform: translateY(-10px) scale(1.22); }
  .dock-tile {
    /* Frame only — the new app-icons (.dock-art) own their gradient + glyph.
       The fallback gradient still applies for legacy glyph tiles. */
    --t: color-mix(in oklch, var(--tile) 70%, var(--accent));
    position: absolute; inset: 0; border-radius: 13px; display: grid; place-items: center; color: white; z-index: -1;
    box-shadow: 0 4px 12px -1px rgba(0,0,0,0.26);
  }
  /* Tile with a baked image: no gradient backing, image fills the frame. */
  .dock-item :global(.dock-art) {
    width: 100%; height: 100%; border-radius: 13px; display: block;
    position: absolute; inset: 0; z-index: 0;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.18));
  }
  /* Legacy glyph tiles (Welcome's ship-logo) keep the painted gradient. */
  .dock-item :global(.dock-glyph) { width: 30px; height: 30px; position: relative; z-index: 1; filter: drop-shadow(0 1px 1px rgba(0,0,0,0.2)); }
  .dock-tile:has(.dock-glyph) {
    background: linear-gradient(155deg, color-mix(in oklch, var(--t) 58%, white) 0%, var(--t) 55%, color-mix(in oklch, var(--t) 70%, black) 100%);
  }
  .dock-tile:has(.dock-glyph)::after { content: ""; position: absolute; inset: 1px; border-radius: 12px; background: linear-gradient(170deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 45%); pointer-events: none; }

  /* Folder tile — frosted macOS-style stack showing the app glyphs through it. */
  .dock-tile.folder {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3px; padding: 8px;
    background: color-mix(in oklch, var(--foreground) 14%, transparent);
    backdrop-filter: blur(8px) saturate(1.5); -webkit-backdrop-filter: blur(8px) saturate(1.5);
    border: 0.5px solid color-mix(in oklch, var(--foreground) 22%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in oklch, var(--foreground) 18%, transparent), 0 4px 12px -1px rgba(0,0,0,0.28);
  }
  .dock-tile.folder .mini {
    position: relative;     /* contain absolute children — without this the baked art escapes to .dock-tile */
    border-radius: 6px; overflow: hidden; display: grid; place-items: center; color: white;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
  }
  /* New baked icons fill the mini tile (override the full-tile absolute positioning). */
  .dock-tile.folder .mini :global(.dock-art) {
    position: static !important; inset: auto !important;
    width: 100%; height: 100%; display: block; border-radius: 6px;
    filter: none;
  }
  /* Fallback for legacy glyph tiles inside the folder. */
  .dock-tile.folder .mini:has(.dock-glyph) {
    background: linear-gradient(155deg, color-mix(in oklch, var(--tile) 52%, white), var(--tile) 60%, color-mix(in oklch, var(--tile) 70%, black));
  }
  .dock-tile.folder .mini :global(.dock-glyph) { width: 11px; height: 11px; }

  .running { position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); width: 4px; height: 4px; border-radius: 50%; background: var(--foreground); opacity: 0; transition: opacity 200ms; }
  .dock-item.is-open .running { opacity: 1; }
  .tip { position: absolute; bottom: 64px; left: 50%; transform: translateX(-50%); white-space: nowrap; padding: 4px 9px; border-radius: 6px; background: var(--foreground); color: var(--background); font-family: var(--font-body); font-size: 11.5px; font-weight: 600; opacity: 0; pointer-events: none; transition: opacity 100ms 80ms; }
  .tip::after { content: ""; position: absolute; bottom: -3px; left: 50%; transform: translateX(-50%); border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 4px solid var(--foreground); }
  .dock-item:hover .tip { opacity: 1; }
  .dock-div { width: 1px; height: 36px; background: color-mix(in oklch, var(--foreground) 22%, transparent); align-self: center; margin: 0 6px; }

  /* Folder popover */
  .folder-wrap { position: relative; display: grid; place-items: center; }
  .dock-folder {
    position: absolute; bottom: 70px; left: 50%; transform: translateX(-50%) translateY(8px);
    /* Squarer footprint: 3 cols × 3 rows of mini tiles, roughly 1:1
       overall. With 7 features the last row has 1 tile centered;
       still reads square at a glance. */
    width: 360px; padding: 16px; border-radius: 18px;
    background: color-mix(in oklch, var(--background) 84%, transparent);
    border: 0.5px solid color-mix(in oklch, var(--foreground) 16%, transparent);
    backdrop-filter: blur(26px) saturate(1.6); -webkit-backdrop-filter: blur(26px) saturate(1.6);
    box-shadow: 0 24px 60px -16px rgba(0,0,0,0.5);
    opacity: 0; pointer-events: none; transition: opacity 180ms var(--ease-out, ease), transform 180ms var(--ease-out, ease);
  }
  .dock-folder:not([hidden]) { display: block; }
  .dock-folder.open { opacity: 1; transform: translateX(-50%) translateY(0); pointer-events: auto; }
  .ff-title { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: color-mix(in oklch, var(--foreground) 55%, var(--background)); text-align: center; margin-bottom: 12px; }
  .ff-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .ff-item { appearance: none; border: 0; background: transparent; display: flex; flex-direction: column; align-items: center; gap: 7px; cursor: pointer; padding: 4px; border-radius: 10px; transition: transform 140ms; }
  .ff-item:hover { transform: translateY(-2px); }
  .ff-tile { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; color: white; position: relative; overflow: hidden;
    box-shadow: 0 4px 12px -1px rgba(0,0,0,0.26); }
  /* Baked icons fill the launcher tile. */
  .ff-tile :global(.dock-art) { width: 100%; height: 100%; display: block; border-radius: 12px; }
  /* Legacy glyph fallback. */
  .ff-tile:has(.dock-glyph) { --t: color-mix(in oklch, var(--tile) 70%, var(--accent));
    background: linear-gradient(155deg, color-mix(in oklch, var(--t) 58%, white) 0%, var(--t) 55%, color-mix(in oklch, var(--t) 70%, black) 100%); }
  .ff-tile :global(.dock-glyph) { width: 26px; height: 26px; filter: drop-shadow(0 1px 1px rgba(0,0,0,0.2)); }
  .ff-label { font-family: var(--font-body); font-size: 11.5px; font-weight: 600; color: var(--foreground); }

  /* Mobile: dock is replaced by the switcher gallery (opened via the
     grid button in the menubar). The dock itself is hidden. */
  @media (max-width: 760px) {
    .os-dock { display: none; }
    /* Arcade is desktop-only — the game stage is fixed pixel size
       and doesn't translate to mobile yet. Hide the tile here too
       (covered by the dock-hidden rule above but explicit for
       documentation) and in the gallery (see Desktop.astro). */
    .dock-arcade { display: none; }
  }
</style>
