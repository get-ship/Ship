---
// MinigameWindow — OS-window wrapper for the Galaga arcade module.
//
// The desktop-OS landing surface lives on a sibling branch; this file is
// future-shaped to drop in once that branch merges. The actual game is a
// reusable self-contained Astro component at ../../../games/galaga/.
import Galaga from '../../../games/galaga/index.astro';
---

<div class="w-minigame minigame-window" data-window="minigame">
  <div class="minigame-window-body">
    <Galaga />
  </div>
</div>

<style>
  .minigame-window {
    display: flex;
    flex-direction: column;
    background: var(--card);
    color: var(--foreground);
    border-radius: 8px;
    overflow: hidden;
  }
  .minigame-window-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
</style>
