---
/*
 * SettingsPopover — the cog icon + a small popover with site
 * preferences. Used in the persistent menubar AND in fullscreen
 * windows' titlebars so the user can reach it from anywhere.
 *
 * Settings live on `<html>` as `data-*` attributes and are persisted
 * to localStorage under `ship-site-settings`. CSS reads the data-*
 * attributes to apply behaviour (dock orientation, etc.) — no JS
 * style mutation per setting.
 *
 * Add a new row to the popover + a localStorage key + a CSS rule on
 * `[data-X]` to add a setting. No central enum to keep in sync.
 */
const cog = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8L4.2 7a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h.1A1.7 1.7 0 0 0 10 3.1V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v.1A1.7 1.7 0 0 0 20.9 10H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>`;
---
<div class="settings-wrap">
  <button class="settings-btn" type="button" data-settings-toggle title="Settings" aria-label="Settings" aria-haspopup="dialog" aria-expanded="false">
    <span class="settings-cog" set:html={cog} />
  </button>
  <div class="settings-panel" data-settings-panel hidden role="dialog" aria-label="Site settings">
    <div class="row">
      <div class="row-label">Dock position</div>
      <div class="seg" role="radiogroup" aria-label="Dock position">
        <button type="button" class="seg-opt" data-dock-pos="bottom" aria-checked="true" role="radio">Bottom</button>
        <button type="button" class="seg-opt" data-dock-pos="left"   aria-checked="false" role="radio">Left</button>
        <button type="button" class="seg-opt" data-dock-pos="right"  aria-checked="false" role="radio">Right</button>
      </div>
    </div>
  </div>
</div>

<style>
  .settings-wrap { position: relative; display: inline-flex; align-items: center; }
  .settings-btn {
    appearance: none; background: transparent; border: 0;
    padding: 2px; border-radius: 5px; cursor: pointer;
    display: inline-flex; align-items: center;
    color: color-mix(in oklch, var(--foreground) 70%, var(--background));
  }
  .settings-btn:hover { background: color-mix(in oklch, var(--foreground) 12%, transparent); }
  .settings-cog :global(svg) { width: 16px; height: 16px; display: block; }

  .settings-panel {
    position: absolute; top: calc(100% + 6px); right: 0;
    z-index: 200;
    min-width: 240px;
    padding: 12px;
    background: var(--popover, var(--card));
    color: var(--popover-foreground, var(--card-foreground));
    border: 1px solid color-mix(in oklch, var(--foreground) 14%, transparent);
    border-radius: 10px;
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.4);
    display: flex; flex-direction: column; gap: 12px;
  }
  .settings-panel[hidden] { display: none; }
  .row { display: flex; flex-direction: column; gap: 6px; }
  .row-label {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 56%, var(--background));
  }
  .seg {
    display: inline-flex; gap: 2px; padding: 2px;
    border-radius: 8px;
    background: color-mix(in oklch, var(--foreground) 6%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 10%, transparent);
  }
  .seg-opt {
    appearance: none; border: 0;
    flex: 1;
    padding: 6px 10px;
    border-radius: 6px;
    background: transparent;
    color: color-mix(in oklch, var(--foreground) 70%, var(--background));
    font: inherit;
    font-family: var(--font-mono);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }
  .seg-opt[aria-checked='true'] {
    background: var(--foreground);
    color: var(--background);
  }
  .seg-opt:not([aria-checked='true']):hover {
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
    color: var(--foreground);
  }
</style>
