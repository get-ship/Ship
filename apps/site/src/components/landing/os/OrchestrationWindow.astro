---
/*
 * OrchestrationWindow — what Ship's pipelines actually are.
 *
 * Three real things, no theater:
 *   1) A pipeline composes multiple agents, human review steps, and
 *      custom outputs into one workflow.
 *   2) You can run a pipeline on a schedule.
 *   3) Everything in Ship is an event. Any event can trigger a
 *      pipeline (or a script).
 *
 * No setTimeout animation pretending to execute. The visual shows the
 * STRUCTURE — what a pipeline looks like and the surface area of what
 * can fire it — because that's the actual feature.
 */
import Window from './Window.astro';
const { open = false } = Astro.props;

type StepKind = 'agent' | 'review' | 'output';
interface Step {
  kind: StepKind;
  name: string;
  detail: string;
}

// One example pipeline, picked because it touches all three step
// kinds and is something a person would plausibly wire up. The shape
// (agent → agent → review → output) is the point, not the specifics.
const pipeline = {
  id: 'friday-wrap-up',
  title: 'friday-wrap-up',
  oneliner: 'A weekly recap, drafted in your voice, sent only after you sign off.',
  steps: [
    { kind: 'agent' as const, name: 'collect-week',
      detail: 'gathers this week’s GitHub + calendar via your installed tools' },
    { kind: 'agent' as const, name: 'draft-recap',
      detail: 'writes the email in your voice — your prior emails are the few-shot' },
    { kind: 'review' as const, name: 'you',
      detail: 'see the draft inline, edit or approve' },
    { kind: 'output' as const, name: 'email → team@',
      detail: 'custom outputs: email, file write, http POST, MCP tool call, view binding' },
  ] satisfies Step[],
};

// "Run on" surface — these are the kinds of triggers Ship actually
// supports. Every entry maps to a real Ship event source. Names match
// the runtime so the demo doesn't invent its own vocabulary.
const triggers = [
  { kind: 'schedule', label: 'every Fri 4:00pm',       sub: 'cron · timezone-aware' },
  { kind: 'event',    label: 'gmail.message-arrived',  sub: 'MCP event source' },
  { kind: 'event',    label: 'github.pr.merged',       sub: 'webhook' },
  { kind: 'event',    label: 'file.appeared',          sub: 'local watcher' },
  { kind: 'event',    label: 'agent.completed',        sub: 'any agent, anywhere' },
  { kind: 'event',    label: 'you.emit("ship-it")',    sub: 'your own custom event' },
];

const STEP_GLYPH: Record<StepKind, string> = {
  agent:  '<circle cx="8" cy="8" r="3.6"/>',
  review: '<path d="M4 13c0-2.2 1.8-4 4-4s4 1.8 4 4M8 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>',
  output: '<path d="M3 8h8m0 0l-2.5-2.5M11 8l-2.5 2.5M13 3v10"/>',
};
const STEP_LABEL: Record<StepKind, string> = {
  agent: 'agent', review: 'human review', output: 'output',
};
---
<Window app="orchestration" title="Orchestration" meta="pipelines" mark="O" accent="pipelines" open={open}>
  <div class="win-scroll orch">
    <div class="stage">
      <header class="head">
        <div class="eyebrow">Orchestration · pipelines</div>
        <h2 class="hl">Compose workflows. <span class="hl-accent">Trigger on anything.</span></h2>
        <p class="prompt">A <b>pipeline</b> composes multiple agents, human review steps, and custom outputs into one workflow. Run it on a schedule, or trigger it from any event in Ship.</p>
      </header>

      <div class="board">
        {/* ── Left: the pipeline structure ────────────────────────────── */}
        <section class="pipe">
          <header class="pipe-head">
            <div class="pipe-name">
              <span class="pipe-kind">PIPELINE</span>
              <span class="pipe-id">{pipeline.title}</span>
            </div>
            <p class="pipe-one">{pipeline.oneliner}</p>
          </header>

          <ol class="steps">
            {pipeline.steps.map((s, i) => (
              <li class="step" data-kind={s.kind}>
                <span class="step-glyph" set:html={STEP_GLYPH[s.kind]} />
                <span class="step-body">
                  <span class="step-row">
                    <span class="step-name">{s.name}</span>
                    <span class="step-kind">{STEP_LABEL[s.kind]}</span>
                  </span>
                  <span class="step-detail">{s.detail}</span>
                </span>
                {i < pipeline.steps.length - 1 && <span class="step-rail" aria-hidden="true"></span>}
              </li>
            ))}
          </ol>

          <footer class="pipe-foot">
            <span class="pipe-foot-k">composes</span>
            <span class="pipe-foot-v">
              <sui-badge variant="soft" size="sm" class="pf-agent">2 agents</sui-badge>
              <sui-badge variant="soft" size="sm" class="pf-review">1 review</sui-badge>
              <sui-badge variant="soft" size="sm" class="pf-output">1 output</sui-badge>
            </span>
          </footer>
        </section>

        {/* ── Right: how it gets triggered ────────────────────────────── */}
        <section class="trig">
          <header class="trig-head">
            <span class="trig-kind">RUN ON</span>
            <p class="trig-blurb">
              <b>Everything in Ship is an event.</b> Any of these can fire the pipeline — schedules, the bus, your other tools, even your own emits.
            </p>
          </header>

          <ul class="trig-list">
            {triggers.map((t) => (
              <li class={`trig-row trig-${t.kind}`}>
                <span class="trig-mark" aria-hidden="true">
                  {t.kind === 'schedule'
                    ? <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l2.5 1.5"/></svg>
                    : <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 1L3 9h5l-1 6 6-8H8l1-6z"/></svg>}
                </span>
                <code class="trig-label">{t.label}</code>
                <span class="trig-sub">{t.sub}</span>
              </li>
            ))}
          </ul>

          <p class="trig-foot">
            A pipeline can have <b>many triggers</b>. A trigger can fire <b>many pipelines</b>. Same bus.
          </p>
        </section>
      </div>

      <p class="foot">
        Pipelines are <b>code</b> — version them, share them across spaces, fork your teammate's. Nothing here you have to wait for SaaS to ship.
      </p>
    </div>
  </div>
</Window>

<style>
  .orch { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .stage {
    flex: 1; min-height: 0;
    width: 100%;
    padding: 16px 26px 14px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .head { text-align: center; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--w-accent);
  }
  .hl {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.03em;
    line-height: 1.04; margin: 4px 0 0; color: var(--foreground);
  }
  .hl-accent {
    background: linear-gradient(100deg, var(--w-accent), color-mix(in oklch, var(--w-accent) 50%, var(--accent)));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .prompt {
    margin: 6px auto 0; max-width: 60ch;
    font-size: 13px; line-height: 1.5;
    color: color-mix(in oklch, var(--foreground) 68%, var(--background));
  }
  .prompt b { color: var(--foreground); font-weight: 600; }

  /* ── Board: pipeline | triggers ───────────────────────────────────── */
  .board {
    flex: 1; min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 14px;
  }
  .pipe, .trig {
    min-width: 0; min-height: 0;
    display: flex; flex-direction: column; gap: 12px;
    background: color-mix(in oklch, var(--card) 92%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 14px;
    padding: 18px 20px;
    box-shadow: 0 10px 30px -22px color-mix(in oklch, var(--w-accent) 60%, transparent);
  }
  .pipe { border-color: color-mix(in oklch, var(--w-accent) 26%, transparent); }

  /* ── Pipeline (left) ── */
  .pipe-head { display: flex; flex-direction: column; gap: 4px; }
  .pipe-name { display: inline-flex; align-items: baseline; gap: 10px; }
  .pipe-kind {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.16em; color: var(--w-accent);
    padding: 2px 7px; border-radius: 999px;
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 28%, transparent);
  }
  .pipe-id {
    font-family: var(--font-mono); font-size: 16px; font-weight: 700;
    color: var(--foreground); letter-spacing: -0.005em;
  }
  .pipe-one {
    margin: 0; font-size: 13px; line-height: 1.45;
    color: color-mix(in oklch, var(--foreground) 70%, var(--background));
  }
  .steps {
    list-style: none; padding: 4px 0 4px; margin: 0;
    display: flex; flex-direction: column; gap: 2px;
    flex: 1;
  }
  .step {
    position: relative;
    display: grid; grid-template-columns: 28px 1fr;
    align-items: start; gap: 12px;
    padding: 10px 0;
  }
  .step-rail { left: 14px; }
  .step-glyph {
    width: 26px; height: 26px; border-radius: 50%;
    display: grid; place-items: center;
    background: color-mix(in oklch, var(--foreground) 6%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 14%, transparent);
    color: color-mix(in oklch, var(--foreground) 65%, var(--background));
    position: relative; z-index: 1;
  }
  .step-glyph :global(svg),
  .step-glyph :global(circle),
  .step-glyph :global(rect),
  .step-glyph :global(path) { fill: none; stroke: currentColor; stroke-width: 1.3; }
  .step[data-kind='agent']  .step-glyph { color: var(--w-accent); background: color-mix(in oklch, var(--w-accent) 14%, transparent); border-color: color-mix(in oklch, var(--w-accent) 36%, transparent); }
  .step[data-kind='review'] .step-glyph { color: oklch(0.62 0.18 70); background: color-mix(in oklch, oklch(0.78 0.16 70) 14%, transparent); border-color: color-mix(in oklch, oklch(0.78 0.16 70) 36%, transparent); }
  .step[data-kind='output'] .step-glyph { color: oklch(0.62 0.18 280); background: color-mix(in oklch, oklch(0.62 0.22 280) 12%, transparent); border-color: color-mix(in oklch, oklch(0.62 0.22 280) 34%, transparent); }
  .step[data-kind='agent']  .step-glyph :global(circle) { fill: currentColor; fill-opacity: 0.18; }
  .step-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .step-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .step-name {
    font-family: var(--font-mono); font-size: 12.5px; font-weight: 700;
    color: var(--foreground);
  }
  .step-kind {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 56%, var(--background));
  }
  .step-detail {
    font-size: 12px; line-height: 1.45;
    color: color-mix(in oklch, var(--foreground) 62%, var(--background));
  }
  .step-rail {
    position: absolute; left: 13px; top: 36px;
    width: 2px; height: calc(100% - 26px);
    background: linear-gradient(180deg,
      color-mix(in oklch, var(--w-accent) 30%, transparent),
      color-mix(in oklch, var(--w-accent) 10%, transparent));
    border-radius: 1px;
  }
  .pipe-foot {
    margin-top: auto;
    display: flex; align-items: center; gap: 10px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
  }
  .pipe-foot-k {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 56%, var(--background));
  }
  .pipe-foot-v { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .pf-agent  { color: var(--w-accent); }
  .pf-review { color: oklch(0.62 0.18 70);  }
  .pf-output { color: oklch(0.62 0.18 280); }

  /* ── Triggers (right) ── */
  .trig-head { display: flex; flex-direction: column; gap: 6px; }
  .trig-kind {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.16em; color: var(--w-accent);
    padding: 2px 7px; border-radius: 999px;
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 28%, transparent);
    align-self: flex-start;
  }
  .trig-blurb {
    margin: 0; font-size: 12.5px; line-height: 1.45;
    color: color-mix(in oklch, var(--foreground) 70%, var(--background));
  }
  .trig-blurb b { color: var(--foreground); font-weight: 600; }
  .trig-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .trig-row {
    display: grid; grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: 8px;
    background: color-mix(in oklch, var(--background) 60%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
  }
  .trig-row:hover {
    transform: translateX(2px);
    border-color: color-mix(in oklch, var(--w-accent) 32%, transparent);
    background: color-mix(in oklch, var(--w-accent) 5%, var(--background));
  }
  .trig-mark {
    width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center;
    background: color-mix(in oklch, var(--foreground) 6%, transparent);
    color: color-mix(in oklch, var(--foreground) 70%, var(--background));
  }
  .trig-mark :global(svg) { width: 14px; height: 14px; display: block; }
  .trig-schedule .trig-mark {
    background: color-mix(in oklch, var(--w-accent) 18%, transparent);
    color: var(--w-accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--w-accent) 10%, transparent);
  }
  .trig-event .trig-mark {
    background: color-mix(in oklch, oklch(0.62 0.22 280) 18%, transparent);
    color: oklch(0.62 0.18 280);
    box-shadow: 0 0 0 3px color-mix(in oklch, oklch(0.62 0.22 280) 10%, transparent);
  }
  .trig-label {
    font-family: var(--font-mono); font-size: 12px; font-weight: 600;
    color: var(--foreground);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .trig-sub {
    font-family: var(--font-mono); font-size: 10.5px;
    color: color-mix(in oklch, var(--foreground) 52%, var(--background));
    white-space: nowrap;
  }
  .trig-foot {
    margin: auto 0 0;
    padding-top: 10px;
    border-top: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
    font-size: 12px; line-height: 1.5;
    color: color-mix(in oklch, var(--foreground) 64%, var(--background));
  }
  .trig-foot b { color: var(--foreground); font-weight: 600; }

  /* ── Footer ── */
  .foot {
    margin: 4px 4px 0; padding-top: 4px;
    font-size: 12.5px; line-height: 1.5; text-align: center;
    color: color-mix(in oklch, var(--foreground) 64%, var(--background));
  }
  .foot b { color: var(--foreground); font-weight: 600; }

  /* ── Mobile ── */
  @media (max-width: 760px) {
    .stage { padding: 12px 14px; }
    .board { grid-template-columns: 1fr; }
    .trig-row { grid-template-columns: 22px minmax(0, 1fr); }
    .trig-sub { grid-column: 2; }
  }
</style>
