---
// FILE_CAP_OVERRIDE: scroll-story across pipelines + triggers — matches
// the Agents pattern. Splitting fragments the surface flow.
/*
 * OrchestrationWindow — what Ship's pipelines actually are.
 *
 *   Hero        : compose workflows + trigger on anything (chip nav).
 *   01 Pipelines: 2-col — concrete example LEFT + step-kind catalog
 *                 RIGHT (agent / human review / custom output).
 *   02 Triggers : 2-col — trigger list LEFT + many-to-many call-out
 *                 RIGHT showing every Ship surface as an event source.
 *   Closer     : pipelines are code — version, fork, share.
 */
import Window from './Window.astro';
import DownloadCTA from './DownloadCTA.astro';
const { open = false } = Astro.props;

type StepKind = 'agent' | 'review' | 'output';
interface Step { kind: StepKind; name: string; detail: string }

const pipeline = {
  title: 'friday-wrap-up',
  oneliner: 'A weekly recap, drafted in your voice, sent only after you sign off.',
  steps: [
    { kind: 'agent'  as const, name: 'collect-week', detail: "gathers this week's GitHub + calendar via your installed tools" },
    { kind: 'agent'  as const, name: 'draft-recap',  detail: 'writes the email in your voice — your prior emails are the few-shot' },
    { kind: 'review' as const, name: 'you',          detail: 'see the draft inline, edit or approve' },
    { kind: 'output' as const, name: 'email → team@', detail: 'custom outputs: email, file write, http POST, MCP tool call, view binding' },
  ] satisfies Step[],
};

const stepCatalog: Array<{ kind: StepKind; title: string; desc: string; eg: string[] }> = [
  { kind: 'agent',  title: 'Agent step',  desc: 'Any Ship agent. Same config you tuned in the Agents surface.',                eg: ['inbox-triage', 'draft-reply', 'code-review'] },
  { kind: 'review', title: 'Human review',desc: 'Pauses the pipeline until someone — you or a teammate — approves or edits.', eg: ['inline gate', 'slack approve', 'PR check'] },
  { kind: 'output', title: 'Custom output',desc: 'Where the result lands. The pipeline owns the delivery, not the agent.',    eg: ['email', 'file write', 'http POST', 'MCP tool', 'view binding'] },
];

const triggers = [
  { kind: 'schedule', label: 'every Fri 4:00pm',      sub: 'cron · timezone-aware' },
  { kind: 'event',    label: 'gmail.message-arrived', sub: 'MCP event source' },
  { kind: 'event',    label: 'github.pr.merged',      sub: 'webhook' },
  { kind: 'event',    label: 'file.appeared',         sub: 'local watcher' },
  { kind: 'event',    label: 'agent.completed',       sub: 'any agent, anywhere' },
  { kind: 'event',    label: 'you.emit("ship-it")',   sub: 'your own custom event' },
];

const eventSources = [
  { label: 'cron',         hint: 'time' },
  { label: 'webhooks',     hint: 'inbound HTTP' },
  { label: 'MCP servers',  hint: 'gmail, github, linear, …' },
  { label: 'file watcher', hint: 'local paths' },
  { label: 'agent.events', hint: 'completion · gate · output' },
  { label: 'pipeline.events', hint: 'step · finish' },
  { label: 'view emits',   hint: 'a button in any view' },
  { label: 'you.emit',     hint: 'your own custom topics' },
];

const STEP_GLYPH: Record<StepKind, string> = {
  agent:  '<circle cx="8" cy="8" r="3.6"/>',
  review: '<path d="M4 13c0-2.2 1.8-4 4-4s4 1.8 4 4M8 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>',
  output: '<path d="M3 8h8m0 0l-2.5-2.5M11 8l-2.5 2.5M13 3v10"/>',
};
const STEP_LABEL: Record<StepKind, string> = { agent: 'agent', review: 'human review', output: 'output' };

const sections = [
  { id: 'pipelines', title: 'Pipelines' },
  { id: 'triggers',  title: 'Triggers'  },
];
---
<Window app="orchestration" title="Orchestration" meta="pipelines + triggers" mark="O" accent="pipelines" open={open} defer>
  <div class="win-scroll orch">
    <div class="stage">

      {/* ── Hero ─────────────────────────────────────────────────────── */}
      <header class="hero">
        <div class="eyebrow">Orchestration · pipelines + triggers</div>
        <h2 class="hl">Compose workflows. <span class="hl-accent">Trigger on anything.</span></h2>
        <p class="prompt">A <b>pipeline</b> chains agents, human review, and custom outputs into one workflow. Run it on a schedule, or fire it from any event in Ship.</p>
        <nav class="facet-chips" aria-label="Sections">
          {sections.map((s, i) => (
            <a href={`#orch-${s.id}`} class="fc"><span class="fc-num">0{i + 1}</span>{s.title}</a>
          ))}
        </nav>
      </header>

      {/* ── 01 · Pipelines ───────────────────────────────────────────── */}
      <section class="fc-sec" id="orch-pipelines">
        <header class="sec-head">
          <span class="sec-num">01</span>
          <span class="sec-tag">Pipelines</span>
          <h3 class="sec-hl">Anatomy of a workflow.</h3>
          <p class="sec-sub">Each step is one of three things — an agent, a human review, or a custom output. Composed once, replayable forever, restartable from any failed step.</p>
        </header>

        <!-- SCREENSHOT TODO: real Ship shell showing friday-wrap-up pipeline with live status -->

        <div class="sec-body pipe-body">
          {/* Left: concrete example pipeline */}
          <section class="pipe">
            <header class="pipe-head">
              <span class="pipe-kind">PIPELINE</span>
              <span class="pipe-id">{pipeline.title}</span>
              <p class="pipe-one">{pipeline.oneliner}</p>
            </header>

            <ol class="steps">
              {pipeline.steps.map((s, i) => (
                <li class="step" data-kind={s.kind}>
                  <span class="step-glyph" set:html={STEP_GLYPH[s.kind]} />
                  <span class="step-body">
                    <span class="step-row">
                      <span class="step-name">{s.name}</span>
                      <span class="step-kind">{STEP_LABEL[s.kind]}</span>
                    </span>
                    <span class="step-detail">{s.detail}</span>
                  </span>
                  {i < pipeline.steps.length - 1 && <span class="step-rail" aria-hidden="true"></span>}
                </li>
              ))}
            </ol>

            <footer class="pipe-foot">
              <span class="pipe-foot-k">composes</span>
              <span class="pipe-foot-v">
                <span class="m-badge pf-agent" data-variant="soft">2 agents</span>
                <span class="m-badge pf-review" data-variant="soft">1 review</span>
                <span class="m-badge pf-output" data-variant="soft">1 output</span>
              </span>
            </footer>
          </section>

          {/* Right: step-kind catalog */}
          <aside class="kinds">
            <header class="kinds-h">Three step kinds</header>
            <ul class="kind-list">
              {stepCatalog.map((k) => (
                <li class={`kind kind-${k.kind}`}>
                  <header class="kind-head">
                    <span class="kind-glyph" set:html={STEP_GLYPH[k.kind]} />
                    <span class="kind-name">{k.title}</span>
                  </header>
                  <p class="kind-desc">{k.desc}</p>
                  <div class="kind-egs">
                    {k.eg.map((e) => <code class="kind-eg">{e}</code>)}
                  </div>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </section>

      {/* ── 02 · Triggers ────────────────────────────────────────────── */}
      <section class="fc-sec" id="orch-triggers">
        <header class="sec-head">
          <span class="sec-num">02</span>
          <span class="sec-tag">Triggers</span>
          <h3 class="sec-hl">Anything in Ship is an event.</h3>
          <p class="sec-sub">Schedules, the bus, MCP servers, your own emits. A pipeline can have many triggers; one trigger can fire many pipelines. Same bus.</p>
        </header>

        <div class="sec-body trig-body">
          {/* Left: trigger list */}
          <section class="trig">
            <header class="trig-h">
              <span class="trig-pill">friday-wrap-up · runs on</span>
            </header>
            <ul class="trig-list">
              {triggers.map((t) => (
                <li class={`trig-row trig-${t.kind}`}>
                  <span class="trig-mark" aria-hidden="true">
                    {t.kind === 'schedule'
                      ? <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l2.5 1.5"/></svg>
                      : <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 1L3 9h5l-1 6 6-8H8l1-6z"/></svg>}
                  </span>
                  <code class="trig-label">{t.label}</code>
                  <span class="trig-sub">{t.sub}</span>
                </li>
              ))}
            </ul>
            <footer class="trig-foot">
              Add a trigger, remove a trigger — the pipeline doesn't change.
            </footer>
          </section>

          {/* Right: event surface (what's emitting) */}
          <aside class="surface">
            <header class="surface-h">Event surface</header>
            <p class="surface-sub">Everything Ship runs emits to the same bus. Any of these can drive a pipeline.</p>
            <ul class="surface-list">
              {eventSources.map((s) => (
                <li class="surface-row">
                  <span class="surface-dot" aria-hidden="true"></span>
                  <span class="surface-name">{s.label}</span>
                  <span class="surface-hint">{s.hint}</span>
                </li>
              ))}
            </ul>
            <footer class="surface-foot">
              <b>One bus, many sources.</b> The trigger is just a filter over it.
            </footer>
          </aside>
        </div>
      </section>

      {/* ── Closer ──────────────────────────────────────────────────── */}
      <footer class="closer">
        <p>Pipelines are <b>code</b> — version them, share them across spaces, fork your teammate's. Nothing here you have to wait for SaaS to ship.</p>
      </footer>

      <DownloadCTA message="Stop drafting recap emails. Wire the pipeline." />

    </div>
  </div>
</Window>

<style>
  .orch { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow-y: auto; }
  .stage {
    width: 100%; max-width: 1180px; margin: 0 auto;
    padding: 28px 28px 64px;
    display: flex; flex-direction: column; gap: 64px;
  }

  /* ── Hero ── */
  .hero { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .eyebrow { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--w-accent); }
  .hl { font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 4.2vw, 54px); letter-spacing: -0.03em; line-height: 1.02; margin: 0; color: var(--foreground); }
  .hl-accent {
    background: linear-gradient(100deg, var(--w-accent), color-mix(in oklch, var(--w-accent) 50%, var(--accent)));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .prompt { font-size: 14px; line-height: 1.55; color: color-mix(in oklch, var(--foreground) 66%, var(--background)); margin: 0; max-width: 60ch; }
  .prompt b { color: var(--foreground); font-weight: 600; }
  .facet-chips { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .fc {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 12px; border-radius: 999px;
    background: color-mix(in oklch, var(--w-accent) 7%, var(--card));
    border: 1px solid color-mix(in oklch, var(--w-accent) 22%, transparent);
    font-family: var(--font-body); font-weight: 600; font-size: 12px;
    color: var(--foreground); text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
  }
  .fc:hover { transform: translateY(-1px); background: color-mix(in oklch, var(--w-accent) 16%, var(--card)); border-color: var(--w-accent); }
  .fc-num { font-family: var(--font-mono); font-size: 9.5px; color: color-mix(in oklch, var(--w-accent) 80%, var(--foreground)); letter-spacing: 0.1em; }

  /* ── Section scaffolding ── */
  .fc-sec { display: flex; flex-direction: column; gap: 22px; scroll-margin-top: 24px; }
  .sec-head {
    display: grid;
    grid-template-columns: auto auto 1fr;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      'num tag .'
      'hl  hl  hl'
      'sub sub sub';
    align-items: center;
    gap: 8px 12px;
  }
  .sec-num {
    grid-area: num;
    font-family: var(--font-mono); font-size: 11px; font-weight: 800;
    letter-spacing: 0.16em; color: var(--w-accent);
    padding: 4px 10px; border-radius: 999px;
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 30%, transparent);
  }
  .sec-tag {
    grid-area: tag;
    font-family: var(--font-mono); font-size: 10px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 60%, var(--background));
  }
  .sec-hl {
    grid-area: hl;
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(26px, 3vw, 36px); letter-spacing: -0.025em;
    line-height: 1.06; margin: 4px 0 0; color: var(--foreground);
  }
  .sec-sub {
    grid-area: sub; max-width: 78ch;
    font-size: 13.5px; line-height: 1.55;
    color: color-mix(in oklch, var(--foreground) 68%, var(--background));
    margin: 4px 0 0;
  }
  .sec-body { display: grid; gap: 18px; min-height: 360px; }

  /* ── Pipelines section ── */
  .pipe-body { grid-template-columns: 1.4fr 1fr; align-items: stretch; }
  .pipe, .kinds {
    display: flex; flex-direction: column; gap: 12px;
    padding: 20px 22px;
    border-radius: 16px;
    background: color-mix(in oklch, var(--card) 92%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 26%, transparent);
    box-shadow: 0 14px 36px -22px color-mix(in oklch, var(--w-accent) 60%, transparent);
  }
  .pipe-head { display: flex; flex-direction: column; gap: 4px; }
  .pipe-kind {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 800;
    letter-spacing: 0.18em; color: var(--w-accent);
    padding: 3px 8px; border-radius: 999px; align-self: flex-start;
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 28%, transparent);
  }
  .pipe-id { font-family: var(--font-mono); font-size: 17px; font-weight: 700; color: var(--foreground); letter-spacing: -0.005em; }
  .pipe-one { margin: 0; font-size: 13px; line-height: 1.5; color: color-mix(in oklch, var(--foreground) 70%, var(--background)); }

  .steps { list-style: none; padding: 4px 0 8px; margin: 0; display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .step {
    position: relative;
    display: grid; grid-template-columns: 28px 1fr;
    align-items: start; gap: 12px;
    padding: 10px 0;
  }
  .step-glyph {
    width: 26px; height: 26px; border-radius: 50%;
    display: grid; place-items: center;
    background: color-mix(in oklch, var(--foreground) 6%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 14%, transparent);
    color: color-mix(in oklch, var(--foreground) 65%, var(--background));
    position: relative; z-index: 1;
  }
  .step-glyph :global(svg),
  .step-glyph :global(circle),
  .step-glyph :global(path) { fill: none; stroke: currentColor; stroke-width: 1.3; }
  .step[data-kind='agent']  .step-glyph,
  .kind-agent .kind-glyph   { color: var(--w-accent); background: color-mix(in oklch, var(--w-accent) 14%, transparent); border-color: color-mix(in oklch, var(--w-accent) 36%, transparent); }
  .step[data-kind='review'] .step-glyph,
  .kind-review .kind-glyph  { color: oklch(0.62 0.18 70); background: color-mix(in oklch, oklch(0.78 0.16 70) 14%, transparent); border-color: color-mix(in oklch, oklch(0.78 0.16 70) 36%, transparent); }
  .step[data-kind='output'] .step-glyph,
  .kind-output .kind-glyph  { color: oklch(0.62 0.18 280); background: color-mix(in oklch, oklch(0.62 0.22 280) 12%, transparent); border-color: color-mix(in oklch, oklch(0.62 0.22 280) 34%, transparent); }
  .step[data-kind='agent']  .step-glyph :global(circle) { fill: currentColor; fill-opacity: 0.18; }
  .step-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .step-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .step-name { font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; color: var(--foreground); }
  .step-kind {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 56%, var(--background));
  }
  .step-detail { font-size: 12px; line-height: 1.45; color: color-mix(in oklch, var(--foreground) 62%, var(--background)); }
  .step-rail {
    position: absolute; left: 14px; top: 36px;
    width: 2px; height: calc(100% - 26px);
    background: linear-gradient(180deg,
      color-mix(in oklch, var(--w-accent) 30%, transparent),
      color-mix(in oklch, var(--w-accent) 10%, transparent));
    border-radius: 1px;
  }
  .pipe-foot {
    margin-top: auto;
    display: flex; align-items: center; gap: 10px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
  }
  .pipe-foot-k {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 56%, var(--background));
  }
  .pipe-foot-v { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .pf-agent  { color: var(--w-accent); }
  .pf-review { color: oklch(0.62 0.18 70);  }
  .pf-output { color: oklch(0.62 0.18 280); }

  /* Step-kind catalog (right) */
  .kinds-h {
    font-family: var(--font-display); font-weight: 700; font-size: 13px; color: var(--foreground);
    padding-bottom: 8px; border-bottom: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
  }
  .kind-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .kind {
    display: flex; flex-direction: column; gap: 6px;
    padding: 12px 14px; border-radius: 12px;
    background: color-mix(in oklch, var(--background) 56%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
  }
  .kind-head { display: flex; align-items: center; gap: 10px; }
  .kind-glyph { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; flex: none; }
  .kind-glyph :global(svg),
  .kind-glyph :global(circle),
  .kind-glyph :global(path) { fill: none; stroke: currentColor; stroke-width: 1.3; width: 14px; height: 14px; }
  .kind-agent .kind-glyph :global(circle) { fill: currentColor; fill-opacity: 0.18; }
  .kind-name { font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--foreground); }
  .kind-desc { margin: 0; font-size: 12px; line-height: 1.5; color: color-mix(in oklch, var(--foreground) 66%, var(--background)); }
  .kind-egs { display: flex; flex-wrap: wrap; gap: 4px; }
  .kind-eg {
    font-family: var(--font-mono); font-size: 10.5px;
    padding: 2px 7px; border-radius: 5px;
    background: color-mix(in oklch, var(--foreground) 6%, transparent);
    color: color-mix(in oklch, var(--foreground) 72%, var(--background));
  }

  /* ── Triggers section ── */
  .trig-body { grid-template-columns: 1fr 1fr; align-items: stretch; }
  .trig, .surface {
    display: flex; flex-direction: column; gap: 10px;
    padding: 20px 22px;
    border-radius: 16px;
    background: color-mix(in oklch, var(--card) 92%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    box-shadow: 0 10px 30px -22px color-mix(in oklch, var(--w-accent) 50%, transparent);
  }
  .trig-h { padding-bottom: 6px; }
  .trig-pill {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.16em; color: var(--w-accent);
    padding: 4px 10px; border-radius: 999px;
    background: color-mix(in oklch, var(--w-accent) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--w-accent) 28%, transparent);
  }
  .trig-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 5px; flex: 1; }
  .trig-row {
    display: grid; grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: 8px;
    background: color-mix(in oklch, var(--background) 60%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
  }
  .trig-row:hover {
    transform: translateX(2px);
    border-color: color-mix(in oklch, var(--w-accent) 32%, transparent);
    background: color-mix(in oklch, var(--w-accent) 5%, var(--background));
  }
  .trig-mark { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in oklch, var(--foreground) 6%, transparent); color: color-mix(in oklch, var(--foreground) 70%, var(--background)); }
  .trig-mark :global(svg) { width: 14px; height: 14px; display: block; }
  .trig-schedule .trig-mark {
    background: color-mix(in oklch, var(--w-accent) 18%, transparent);
    color: var(--w-accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--w-accent) 10%, transparent);
  }
  .trig-event .trig-mark {
    background: color-mix(in oklch, oklch(0.62 0.22 280) 18%, transparent);
    color: oklch(0.62 0.18 280);
    box-shadow: 0 0 0 3px color-mix(in oklch, oklch(0.62 0.22 280) 10%, transparent);
  }
  .trig-label {
    font-family: var(--font-mono); font-size: 12px; font-weight: 600;
    color: var(--foreground);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .trig-sub {
    font-family: var(--font-mono); font-size: 10.5px;
    color: color-mix(in oklch, var(--foreground) 52%, var(--background));
    white-space: nowrap;
  }
  .trig-foot {
    margin-top: auto; padding-top: 8px;
    font-size: 11.5px; font-style: italic;
    color: color-mix(in oklch, var(--foreground) 58%, var(--background));
    border-top: 1px solid color-mix(in oklch, var(--foreground) 8%, transparent);
  }

  /* Event surface (right) */
  .surface-h {
    font-family: var(--font-display); font-weight: 700; font-size: 13px; color: var(--foreground);
