---
// Pillar 4 — "Connects to your stack."
//
// Shows SHIP as a hub: a grid of integrations on the left (Gmail,
// Calendar, GitHub, Slack, Notion, Linear, Drive, iMessage) and a
// notifications stream on the right showing real-looking events
// routed out (mobile push, email, webhook). Tells the "plugged into
// everything, talks back to you" story without new jargon.

const integrations = [
  { id: 'gmail',    label: 'Gmail',      kind: 'email' },
  { id: 'calendar', label: 'Calendar',   kind: 'time' },
  { id: 'github',   label: 'GitHub',     kind: 'code' },
  { id: 'linear',   label: 'Linear',     kind: 'code' },
  { id: 'slack',    label: 'Slack',      kind: 'chat' },
  { id: 'notion',   label: 'Notion',     kind: 'docs' },
  { id: 'drive',    label: 'Drive',      kind: 'docs' },
  { id: 'imessage', label: 'iMessage',   kind: 'chat' },
];

const notifications = [
  {
    icon: 'push',
    title: 'Reviewer flagged 2 issues in your draft',
    body: 'Release post for v1.2 · tap to open',
    time: '2m',
    tone: 'accent',
  },
  {
    icon: 'mail',
    title: 'Weekly digest ready',
    body: 'Sent to priya@, sam@ &middot; 5 highlights',
    time: '9m',
    tone: 'info',
  },
  {
    icon: 'slack',
    title: 'Slack: #launch notified of new PR',
    body: 'fix(cli): surface permission errors',
    time: '24m',
    tone: 'success',
  },
  {
    icon: 'hook',
    title: 'Webhook delivered to your tracker',
    body: 'POST /events/agent.completed · 200 OK',
    time: '1h',
    tone: 'muted',
  },
];
---

<section class="hl hl-connects" data-visible="false">
  <div class="site-container hl-inner">
    <header class="hl-head">
      <ship-badge tone="warning" variant="soft" size="sm">Connects to your stack</ship-badge>
      <h2>Plugged into everything you use.</h2>
      <p class="hl-sub">
        SHIP reads from the apps you already live in, routes actions
        back into them, and pings you when something needs you. Email,
        calendar, code, chat &mdash; SHIP stays in the loop so you
        don&rsquo;t have to check in.
      </p>
    </header>

    <div class="hl-demo">
      <ship-card variant="outline" padding="lg" class="hl-ints">
        <div slot="header" class="hl-ints-head">
          <div>
            <div class="hl-ints-title">Connected</div>
            <div class="hl-ints-sub">8 apps &middot; one-click toggle</div>
          </div>
          <ship-badge tone="success" variant="soft" size="sm">live</ship-badge>
        </div>

        <div class="hl-ints-grid">
          {integrations.map((it, i) => (
            <div class="hl-int" data-kind={it.kind} style={`--i: ${i}`}>
              <div class="hl-int-icon" data-kind={it.kind} aria-hidden="true"></div>
              <span class="hl-int-label">{it.label}</span>
              <ship-status-dot tone="success"></ship-status-dot>
            </div>
          ))}
        </div>

        <ship-separator class="hl-ints-sep"></ship-separator>
        <div class="hl-ints-foot">
          Add new sources, scope them to agents, and revoke anytime.
        </div>
      </ship-card>

      <ship-card variant="outline" padding="lg" class="hl-notifs">
        <div slot="header" class="hl-ints-head">
          <div>
            <div class="hl-ints-title">Keeps you in the loop</div>
            <div class="hl-ints-sub">Push, email, webhook &middot; your rules</div>
          </div>
          <ship-badge tone="accent" variant="soft" size="sm">streaming</ship-badge>
        </div>

        <ul class="hl-notif-list">
          {notifications.map((n, i) => (
            <li class="hl-notif" style={`--i: ${i}`}>
              <div class="hl-notif-icon" data-icon={n.icon} data-tone={n.tone} aria-hidden="true"></div>
              <div class="hl-notif-body">
                <div class="hl-notif-title">{n.title}</div>
                <div class="hl-notif-meta" set:html={n.body}></div>
              </div>
              <span class="hl-notif-time">{n.time}</span>
            </li>
          ))}
        </ul>
      </ship-card>
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.setAttribute('data-visible', 'true');
        obs.unobserve(e.target);
      }
    }
  }, { threshold: 0.2 });
  document.querySelectorAll('.hl-connects').forEach((el) => obs.observe(el));
</script>

<style>
  .hl {
    padding: clamp(72px, 10vw, 128px) 0;
    position: relative;
  }
  .hl-inner {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  .hl-head {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .hl-sub {
    color: var(--muted-foreground);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.55;
  }

  .hl-demo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .hl-demo { grid-template-columns: 1fr; }
  }

  .hl-ints,
  .hl-notifs {
    display: block;
    transition:
      opacity 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms,
      transform 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms;
  }
  .hl-notifs { transition-delay: 180ms; }
  :root.js .hl-connects[data-visible='false'] .hl-ints,
  :root.js .hl-connects[data-visible='false'] .hl-notifs {
    opacity: 0;
    transform: translateY(16px);
  }
  .hl-connects[data-visible='true'] .hl-ints,
  .hl-connects[data-visible='true'] .hl-notifs {
    opacity: 1;
    transform: none;
  }

  .hl-ints-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .hl-ints-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .hl-ints-sub {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 2px;
  }

  .hl-ints-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 16px;
  }
  @media (max-width: 540px) {
    .hl-ints-grid { grid-template-columns: 1fr; }
  }
  .hl-int {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    border-radius: 10px;
    background: var(--card);
    transition:
      opacity 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    transition-delay: calc(280ms + var(--i) * 45ms);
  }
  :root.js .hl-connects[data-visible='false'] .hl-int {
    opacity: 0;
    transform: scale(0.96);
  }
  .hl-connects[data-visible='true'] .hl-int {
    opacity: 1;
    transform: none;
  }
  .hl-int-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--foreground);
  }
  .hl-int-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    background: color-mix(in oklch, var(--muted) 60%, transparent);
    color: var(--muted-foreground);
  }
  .hl-int-icon::before {
    content: '';
    width: 14px;
    height: 14px;
    background: currentColor;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
  }
  .hl-int[data-kind='email'] .hl-int-icon { color: oklch(0.60 0.14 25); }
  .hl-int[data-kind='time']  .hl-int-icon { color: oklch(0.56 0.16 265); }
  .hl-int[data-kind='code']  .hl-int-icon { color: oklch(0.60 0.12 150); }
  .hl-int[data-kind='chat']  .hl-int-icon { color: oklch(0.60 0.14 60); }
  .hl-int[data-kind='docs']  .hl-int-icon { color: oklch(0.60 0.16 220); }

  .hl-int-icon[data-kind='email']::before,
  .hl-int[data-kind='email'] .hl-int-icon::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M3 5h18v14H3V5zm2 2v.5l7 4.5 7-4.5V7l-7 4.5L5 7z'/></svg>");
  }
  .hl-int[data-kind='time'] .hl-int-icon::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M4 5h16v15H4V5zm0-3h16v2H4V2zm3 8h3v3H7v-3z'/></svg>");
  }
  .hl-int[data-kind='code'] .hl-int-icon::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M8 6l-6 6 6 6 1.4-1.4L4.8 12l4.6-4.6L8 6zm8 0l-1.4 1.4L19.2 12l-4.6 4.6L16 18l6-6-6-6z'/></svg>");
  }
  .hl-int[data-kind='chat'] .hl-int-icon::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M4 4h16v12H7l-3 4V4z'/></svg>");
  }
  .hl-int[data-kind='docs'] .hl-int-icon::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M6 2h8l4 4v16H6V2zm7 1v5h5l-5-5z'/></svg>");
  }

  .hl-ints-sep { display: block; margin: 16px 0 10px; }
  .hl-ints-foot,
  .hl-notifs .hl-ints-foot {
    color: var(--muted-foreground);
    font-size: 12px;
    text-align: center;
  }

  .hl-notif-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .hl-notif {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    column-gap: 12px;
    align-items: center;
    padding: 12px 2px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
    transition:
      opacity 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 360ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    transition-delay: calc(320ms + var(--i) * 100ms);
  }
  .hl-notif:last-child { border-bottom: 0; }
  :root.js .hl-connects[data-visible='false'] .hl-notif {
    opacity: 0;
    transform: translateY(6px);
  }
  .hl-connects[data-visible='true'] .hl-notif {
    opacity: 1;
    transform: none;
  }
  .hl-notif-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: var(--muted-foreground);
    background: color-mix(in oklch, var(--muted) 60%, transparent);
  }
  .hl-notif[data-tone='accent']  .hl-notif-icon,
  .hl-notif-icon[data-tone='accent'] { color: var(--site-accent); background: color-mix(in oklch, var(--site-accent) 14%, var(--card)); }
  .hl-notif-icon[data-tone='info']    { color: oklch(0.56 0.14 240); background: color-mix(in oklch, oklch(0.56 0.14 240) 14%, var(--card)); }
  .hl-notif-icon[data-tone='success'] { color: oklch(0.54 0.14 150); background: color-mix(in oklch, oklch(0.54 0.14 150) 14%, var(--card)); }
  .hl-notif-icon::before {
    content: '';
    width: 16px;
    height: 16px;
    background: currentColor;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
  }
  .hl-notif-icon[data-icon='push']::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M12 2a7 7 0 0 0-7 7v4L3 17h18l-2-4V9a7 7 0 0 0-7-7zm-2 19a2 2 0 0 0 4 0h-4z'/></svg>");
  }
  .hl-notif-icon[data-icon='mail']::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M3 5h18v14H3V5zm2 2v.5l7 4.5 7-4.5V7l-7 4.5L5 7z'/></svg>");
  }
  .hl-notif-icon[data-icon='slack']::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M5 15a2 2 0 1 1-2-2h2v2zm0-3h2a2 2 0 1 1-2 2v-2zm3 0a2 2 0 1 1 4 0v5a2 2 0 1 1-4 0v-5zm7-4a2 2 0 1 1 2 2h-2V8zm0 3h-2a2 2 0 1 1 2-2v2zm-3 0a2 2 0 1 1-4 0V6a2 2 0 1 1 4 0v5z'/></svg>");
  }
  .hl-notif-icon[data-icon='hook']::before {
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><path d='M14 3a5 5 0 0 0-5 5v3a2 2 0 0 1-2 2H4v2h3a4 4 0 0 0 4-4V8a3 3 0 1 1 6 0v1h2V8a5 5 0 0 0-5-5zm-1 12a4 4 0 1 1 8 0 4 4 0 0 1-8 0z'/></svg>");
  }

  .hl-notif-title {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--foreground);
  }
  .hl-notif-meta {
    color: var(--muted-foreground);
    font-size: 12px;
    margin-top: 2px;
  }
  .hl-notif-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
</style>
