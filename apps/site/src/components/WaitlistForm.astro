---
interface Props {
  list?: 'general' | 'pro' | 'changelog' | 'blog';
  source?: string;
  placeholder?: string;
  cta?: string;
  thanks?: string;
  size?: 'sm' | 'md' | 'lg';
  /** Show the 3-question survey under the email row. Defaults true. */
  survey?: boolean;
}
const {
  list = 'general',
  source,
  placeholder = 'you@example.com',
  cta = 'Notify me',
  thanks = "You're on the list. We'll email you the moment it's ready.",
  size = 'md',
  survey = true,
} = Astro.props;

/* Survey options — keep parallel with the gateway's allow-lists in
 * apps/gateway/src/routes/waitlist.ts. Mismatched values are silently
 * dropped server-side. */
const harnesses = [
  { id: 'claude-code', label: 'Claude Code' },
  { id: 'codex',       label: 'Codex' },
  { id: 'cursor',      label: 'Cursor' },
  { id: 'opencode',    label: 'OpenCode' },
  { id: 'pi',          label: 'pi' },
  { id: 'none',        label: 'None yet' },
];
const channels = [
  { id: 'x',            label: 'X' },
  { id: 'hn',           label: 'HN' },
  { id: 'podcast',      label: 'Podcast' },
  { id: 'friend',       label: 'Friend' },
  { id: 'docs-or-repo', label: 'Docs / repo' },
  { id: 'search',       label: 'Search' },
  { id: 'other',        label: 'Other' },
];
/* Q3 — how AI work is isolated today. Tells us how much of Ship's
 * sandboxing story is novel for the visitor vs. table-stakes. */
const security = [
  { id: 'none',       label: 'Nothing' },
  { id: 'containers', label: 'Containers' },
  { id: 'vms',        label: 'VM / remote box' },
  { id: 'sandbox',    label: 'OS sandbox' },
  { id: 'not-sure',   label: 'Not yet' },
];
---

<form class={`wl wl-${size}`} data-waitlist data-list={list} data-source={source ?? ''} novalidate>
  <input
    type="email"
    name="email"
    autocomplete="email"
    required
    placeholder={placeholder}
    aria-label="Email"
  />
  <sui-button tone="primary" size={size} type="submit">
    <span data-wl-label>{cta}</span>
  </sui-button>

  {survey && (
    <div class="wl-survey" data-wl-survey>
      <p class="wl-survey-head">Three quick taps — then you're in.</p>
      <div class="wl-survey-body">
        <fieldset class="wl-q" data-wl-q="harnesses">
          <legend>Which harness do you use today?</legend>
          <div class="wl-chips" data-wl-multi data-wl-field="harnesses">
            {harnesses.map((h) => (
              <button class="wl-chip" type="button" data-val={h.id}>{h.label}</button>
            ))}
          </div>
        </fieldset>

        <fieldset class="wl-q" data-wl-q="channel">
          <legend>What pulled you here?</legend>
          <div class="wl-chips" data-wl-single data-wl-field="channel">
            {channels.map((c) => (
              <button class="wl-chip" type="button" data-val={c.id}>{c.label}</button>
            ))}
          </div>
        </fieldset>

        <fieldset class="wl-q" data-wl-q="security">
          <legend>How do you isolate AI tooling today?</legend>
          <div class="wl-chips" data-wl-single data-wl-field="security">
            {security.map((s) => (
              <button class="wl-chip" type="button" data-val={s.id}>{s.label}</button>
            ))}
          </div>
        </fieldset>
      </div>
    </div>
  )}

  <div class="wl-msg wl-success" data-wl-success hidden role="status">{thanks}</div>
  <div class="wl-msg wl-error" data-wl-error hidden role="alert"></div>
</form>

<script>
  import { authClient } from '../lib/auth';

  const GATEWAY_URL =
    (import.meta.env.PUBLIC_GATEWAY_URL as string | undefined) ??
    (import.meta.env.DEV ? 'http://localhost:8787' : 'https://api.getship.dev');

  function detectOs(): string | null {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const blob = `${(nav.userAgentData?.platform || '').toLowerCase()} ${navigator.userAgent.toLowerCase()} ${(navigator.platform || '').toLowerCase()}`;
    if (/wsl/.test(blob)) return 'wsl';
    if (/mac|iphone|ipad/.test(blob)) return 'macos';
    if (/win/.test(blob)) return 'windows';
    if (/linux|x11|ubuntu|fedora|debian/.test(blob)) return 'linux';
    return 'other';
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-waitlist]')) {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const label = form.querySelector<HTMLElement>('[data-wl-label]');
    const baseLabel = label?.textContent ?? 'Notify me';
    const ok = form.querySelector<HTMLElement>('[data-wl-success]');
    const err = form.querySelector<HTMLElement>('[data-wl-error]');

    const survey = form.querySelector<HTMLElement>('[data-wl-survey]');

    // ── Chip groups (single / multi) ─────────────────────────────────
    const fields: Record<string, string | string[]> = {};
    for (const group of Array.from(form.querySelectorAll<HTMLElement>('[data-wl-field]'))) {
      const name = group.dataset.wlField!;
      const multi = group.hasAttribute('data-wl-multi');
      if (multi) fields[name] = [];
      for (const chip of Array.from(group.querySelectorAll<HTMLButtonElement>('.wl-chip'))) {
        chip.addEventListener('click', () => {
          if (multi) {
            const set = new Set(fields[name] as string[]);
            const val = chip.dataset.val!;
            if (set.has(val)) { set.delete(val); chip.classList.remove('on'); }
            else { set.add(val); chip.classList.add('on'); }
            fields[name] = Array.from(set);
          } else {
            for (const sib of Array.from(group.querySelectorAll<HTMLButtonElement>('.wl-chip'))) sib.classList.remove('on');
            chip.classList.add('on');
            fields[name] = chip.dataset.val!;
          }
          group.closest('[data-wl-q]')?.classList.remove('missing');
        });
      }
    }

    const setBusy = (busy: boolean) => {
      input.disabled = busy;
      if (label) label.textContent = busy ? 'Sending…' : baseLabel;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (err) { err.hidden = true; err.textContent = ''; }
      if (ok)  { ok.hidden = true; }
      const email = input.value.trim();
      if (!email) return;

      // Survey is required — we only want submissions with the questions
      // captured. Flag any unanswered question and block submit.
      if (survey) {
        const missing: string[] = [];
        if (!((fields.harnesses as string[]) || []).length) missing.push('harnesses');
        if (!fields.channel) missing.push('channel');
        if (!fields.security) missing.push('security');
        for (const q of Array.from(survey.querySelectorAll<HTMLElement>('[data-wl-q]'))) {
          q.classList.toggle('missing', missing.includes(q.dataset.wlQ!));
        }
        if (missing.length) {
          if (err) { err.hidden = false; err.textContent = 'Answer all three questions to join the list.'; }
          survey.querySelector<HTMLElement>('.wl-q.missing')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          return;
        }
      }
      setBusy(true);
      try {
        const res = await fetch(`${GATEWAY_URL}/v1/waitlist`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            list: form.dataset.list,
            source: form.dataset.source || undefined,
            os: detectOs(),
            harnesses: (fields.harnesses as string[]) || [],
            channel:  (fields.channel  as string) || undefined,
            security: (fields.security as string) || undefined,
          }),
        });
        if (!res.ok) {
          const detail = await res.json().catch(() => ({}));
          if (err) {
            err.hidden = false;
            err.textContent = detail?.error === 'invalid_email'
              ? "That doesn't look like a valid email."
              : 'Something went wrong. Try again in a moment.';
          }
          setBusy(false);
          return;
        }
        form.reset();
        setBusy(false);
        if (ok) ok.hidden = false;
      } catch {
        if (err) {
          err.hidden = false;
          err.textContent = 'Network error. Try again.';
        }
        setBusy(false);
      }
    });
  }

  void authClient;
</script>

<style>
  .wl {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    width: 100%;
  }
  .wl-sm  { max-width: 360px; }
  .wl-md  { max-width: 480px; }
  .wl-lg  { max-width: 560px; }

  .wl input[type="email"] {
    appearance: none;
    border: 1px solid var(--plate-line);
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
    color: var(--page-fg);
    padding: 10px 14px;
    border-radius: 10px;
    font: inherit;
    font-size: 14px;
    min-width: 0;
    transition: border-color 150ms, box-shadow 150ms;
  }
  .wl input[type="email"]:focus {
    outline: none;
    border-color: color-mix(in oklab, var(--primary) 60%, var(--plate-line));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent);
  }
  .wl input[type="email"]:disabled { opacity: 0.6; }

  /* ── Survey (required) ── */
  .wl-survey { grid-column: 1 / -1; }
  .wl-survey-head {
    margin: 6px 2px 2px;
    font-size: 12.5px;
    color: color-mix(in oklab, var(--page-fg) 65%, var(--page-bg));
  }
  .wl-q.missing legend { color: var(--destructive); }
  .wl-q.missing .wl-chips { outline: 1px dashed color-mix(in oklab, var(--destructive) 55%, transparent); outline-offset: 4px; border-radius: 8px; }
  .wl-survey-body {
    display: flex; flex-direction: column; gap: 8px;
    padding: 10px 12px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--plate) 80%, var(--page-bg));
    border: 1px solid var(--plate-line);
    margin-top: 4px;
  }
  .wl-q { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 5px; }
  .wl-q legend {
    padding: 0; margin: 0;
    font-size: 11px; font-weight: 600;
    color: color-mix(in oklab, var(--page-fg) 78%, var(--page-bg));
    letter-spacing: 0.01em;
  }
  .wl-chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .wl-chips-stack { flex-direction: column; align-items: stretch; }
  .wl-chip {
    appearance: none; cursor: pointer;
    background: color-mix(in oklab, var(--page-bg) 60%, var(--plate));
    border: 1px solid var(--plate-line);
    border-radius: 999px;
    padding: 4px 10px;
    font: inherit; font-size: 11.5px; font-weight: 500;
    color: color-mix(in oklab, var(--page-fg) 78%, var(--page-bg));
    transition: background 130ms ease, border-color 130ms ease, color 130ms ease;
  }
  .wl-chip:hover { border-color: color-mix(in oklab, var(--primary) 36%, var(--plate-line)); }
  .wl-chip.on {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    border-color: var(--primary);
    color: var(--page-fg);
  }
  .wl-chip-row {
    border-radius: 9px;
    text-align: left;
    padding: 8px 11px;
  }

  /* ── Messages ── */
  .wl-msg {
    grid-column: 1 / -1;
    font-size: 13px; line-height: 1.5;
    padding: 10px 12px;
    border-radius: 10px;
    margin-top: 2px;
  }
  .wl-success {
    color: var(--success);
    background: color-mix(in oklab, var(--success) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--success) 30%, transparent);
  }
  .wl-error {
    color: var(--destructive);
    background: color-mix(in oklab, var(--destructive) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--destructive) 30%, transparent);
  }
  @media (max-width: 480px) {
    .wl { grid-template-columns: 1fr; }
  }
</style>
