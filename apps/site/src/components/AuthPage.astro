---
interface Props {
  mode: 'sign-in' | 'sign-up';
}
const { mode } = Astro.props;

const isSignUp = mode === 'sign-up';
const planParam = Astro.url.searchParams.get('plan');
const VALID_PLANS = new Set(['pro']);
const startingPlan = planParam && VALID_PLANS.has(planParam) ? planParam : null;
const PLAN_LABEL: Record<string, string> = { pro: 'Pro' };

const otherHref = (() => {
  const base = isSignUp ? '/sign-in' : '/sign-up';
  return startingPlan ? `${base}?plan=${startingPlan}` : base;
})();
const otherLabel = isSignUp ? 'Sign in' : 'Create one';
const otherPrompt = isSignUp ? 'Already have an account?' : 'New to SHIP?';
const submitLabel = isSignUp ? 'Create account' : 'Sign in';
const title = isSignUp ? 'Create your account' : 'Welcome back';
const lede = isSignUp
  ? 'Create an account to sync your install across machines. Local stays free without one.'
  : 'Sign in to sync your install across machines.';

const points = isSignUp
  ? [
      { k: 'Local stays free', v: 'SHIP runs on your machine without an account.' },
      { k: 'Sync your install', v: 'Themes, skills, and workspaces follow you to every machine you sign in on.' },
      { k: 'Month-to-month', v: 'Cancel anytime. Local keeps working.' },
    ]
  : [
      { k: 'Pick up where you left off', v: 'Sessions and artifacts follow you across machines.' },
      { k: 'One account, every install', v: 'Same identity wherever you run SHIP.' },
      { k: 'Local stays free', v: "Sign-in is optional. The Local tier never asks for an account." },
    ];
---

<section class="auth-stage">
  <div class="auth-bg" aria-hidden="true">
    <div class="auth-bg-grid"></div>
    <div class="auth-bg-blob a"></div>
    <div class="auth-bg-blob b"></div>
  </div>
  <div class="auth-grid">
    <aside class="auth-pitch">
      <a href="/" class="auth-brand" aria-label="SHIP home">
        <sui-brand-mark size="md" class="auth-brand-mark"></sui-brand-mark>
        <span>SHIP</span>
      </a>
      <h1>{title}.</h1>
      <p class="auth-lede">{lede}</p>
      <ul class="auth-points">
        {points.map((p) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"></path></svg>
            <div>
              <div class="auth-point-k">{p.k}</div>
              <div class="auth-point-v">{p.v}</div>
            </div>
          </li>
        ))}
      </ul>
    </aside>

    <div class="auth-card">
      {startingPlan && (
        <div class="auth-plan-pill">
          <span class="auth-plan-dot"></span>
          Starting with <strong>{PLAN_LABEL[startingPlan]}</strong>
        </div>
      )}
      <form class="auth-form" data-auth-form data-mode={mode} data-plan={startingPlan ?? ''} novalidate>
        <div class="auth-harnesses">
          <button type="button" class="auth-harness" data-harness="google" aria-label="Continue with Google">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
            Continue with Google
          </button>
          <button type="button" class="auth-harness" data-harness="github" aria-label="Continue with GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39 10.93 10.93 0 0 1 2.87.39c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.23 2.77.12 3.06.73.81 1.17 1.84 1.17 3.1 0 4.42-2.69 5.4-5.26 5.68.42.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
            Continue with GitHub
          </button>
          <button type="button" class="auth-harness" data-harness="slack" aria-label="Continue with Slack">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#E01E5A" d="M5.1 15.1a2.1 2.1 0 1 1-2.1-2.1h2.1zm1.05 0a2.1 2.1 0 1 1 4.2 0v5.3a2.1 2.1 0 1 1-4.2 0z"/><path fill="#36C5F0" d="M8.9 5.1a2.1 2.1 0 1 1 2.1-2.1v2.1zm0 1.05a2.1 2.1 0 1 1 0 4.2H3.6a2.1 2.1 0 1 1 0-4.2z"/><path fill="#2EB67D" d="M18.9 8.9a2.1 2.1 0 1 1 2.1 2.1h-2.1zm-1.05 0a2.1 2.1 0 1 1-4.2 0V3.6a2.1 2.1 0 1 1 4.2 0z"/><path fill="#ECB22E" d="M15.1 18.9a2.1 2.1 0 1 1-2.1 2.1v-2.1zm0-1.05a2.1 2.1 0 1 1 0-4.2h5.3a2.1 2.1 0 1 1 0 4.2z"/></svg>
            Continue with Slack
          </button>
        </div>

        <div class="auth-divider"><span>or with email</span></div>

        {isSignUp && (
          <label class="auth-field">
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required placeholder="Ada Lovelace" />
          </label>
        )}
        <label class="auth-field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
        </label>
        <label class="auth-field">
          <span>Password</span>
          <input type="password" name="password" autocomplete={isSignUp ? 'new-password' : 'current-password'} required minlength="8" placeholder="••••••••" />
        </label>

        <div class="auth-meta">
          {isSignUp
            ? <span>By creating an account you agree to our <a href="#">terms</a> and <a href="#">privacy policy</a>.</span>
            : <a href="/forgot-password" class="auth-forgot">Forgot password?</a>}
        </div>

        <div class="auth-error" data-auth-error role="alert" hidden></div>

        <sui-button tone="primary" size="lg" type="submit" class="auth-submit">
          <span data-auth-submit-label>{submitLabel}</span>
        </sui-button>

        <div class="auth-switch">
          {otherPrompt} <a href={otherHref}>{otherLabel}</a>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { signInWithProvider, signInWithEmail, signUpWithEmail } from '../lib/auth';

  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
  const errorEl = document.querySelector<HTMLElement>('[data-auth-error]');
  const submitLabel = document.querySelector<HTMLElement>('[data-auth-submit-label]');
  const baseLabel = submitLabel?.textContent ?? 'Continue';

  function showError(msg: string | null) {
    if (!errorEl) return;
    if (!msg) { errorEl.hidden = true; errorEl.textContent = ''; return; }
    errorEl.hidden = false;
    errorEl.textContent = msg;
  }
  function setBusy(busy: boolean) {
    if (!form) return;
    for (const el of form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input')) {
      el.disabled = busy;
    }
    if (submitLabel) submitLabel.textContent = busy ? 'One moment…' : baseLabel;
  }

  // Compute the post-signin destination. If the user arrived from /pricing
  // with ?plan=team, send them to /billing?upgrade=team after auth so the
  // upgrade CTA is one click away.
  function destinationFor(plan: string | undefined): string {
    const params = new URLSearchParams(location.search);
    const explicit = params.get('next');
    if (explicit) return explicit;
    if (plan === 'pro') return `/billing?upgrade=${plan}`;
    return '/account';
  }

  const plan = form?.dataset.plan || undefined;

  // Social harness buttons.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.auth-harness')) {
    btn.addEventListener('click', async () => {
      const harness = btn.dataset.harness as 'google' | 'github' | 'slack' | undefined;
      if (!harness) return;
      const dest = destinationFor(plan);
      showError(null);
      setBusy(true);
      try {
        await signInWithProvider(harness, dest);
      } catch (e) {
        setBusy(false);
        showError((e as Error).message ?? 'Could not start sign-in.');
      }
    });
  }

  // Email / password form.
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');
      const name = String(data.get('name') ?? '').trim();
      if (!email || !password) return;

      const dest = destinationFor(plan);
      const mode = form.dataset.mode as 'sign-in' | 'sign-up';

      showError(null);
      setBusy(true);
      const res = mode === 'sign-up'
        ? await signUpWithEmail(name, email, password, dest)
        : await signInWithEmail(email, password, dest);
      if (!res.ok) {
        setBusy(false);
        showError(res.error);
        return;
      }
      // Better Auth returns; callbackURL handles the redirect. If we get
      // here without a navigation, push manually.
      location.href = dest;
    });
  }
</script>

<style>
  .auth-stage {
    position: relative;
    padding: clamp(32px, 4vw, 56px) 0;
    overflow: hidden;
  }
  .auth-bg { position: absolute; inset: 0; pointer-events: none; }
  .auth-bg-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right,  color-mix(in oklab, var(--page-fg) 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--page-fg) 6%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 40%, #000, transparent 75%);
  }
  .auth-bg-blob {
    position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.45;
  }
  .auth-bg-blob.a {
    width: 540px; height: 540px;
    background: radial-gradient(circle, color-mix(in oklab, var(--primary) 40%, transparent), transparent 60%);
    top: -180px; left: -120px;
  }
  .auth-bg-blob.b {
    width: 480px; height: 480px;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent) 35%, transparent), transparent 60%);
    bottom: -180px; right: -80px;
  }

  .auth-grid {
    position: relative; z-index: 1;
    max-width: 1120px;
    margin: 0 auto; padding: 0 40px;
    display: grid; grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 6vw, 64px);
    align-items: start;
  }
  @media (max-width: 880px) {
    .auth-grid { grid-template-columns: 1fr; gap: 40px; padding: 0 24px; }
  }

  .auth-pitch { display: flex; flex-direction: column; gap: 20px; }
  .auth-brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: 700; font-size: 18px;
    color: var(--page-fg); text-decoration: none;
    align-self: flex-start;
  }
  .auth-brand-mark {
    filter: drop-shadow(0 2px 6px color-mix(in oklab, var(--primary) 35%, transparent));
  }
  .auth-pitch h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(40px, 5.5vw, 64px); line-height: 1.02;
    letter-spacing: -0.03em; color: var(--page-fg); margin: 8px 0 0;
  }
  .auth-lede {
    font-size: 16px; line-height: 1.55; color: var(--muted-ink); max-width: 48ch;
  }
  .auth-points {
    list-style: none; padding: 0; margin: 12px 0 0;
    display: flex; flex-direction: column; gap: 16px;
  }
  .auth-points li {
    display: grid; grid-template-columns: 16px 1fr; gap: 12px;
    align-items: start;
  }
  .auth-points svg {
    color: var(--primary); margin-top: 2px;
  }
  .auth-point-k {
    font-weight: 600; font-size: 14px; color: var(--page-fg);
  }
  .auth-point-v {
    font-size: 13.5px; line-height: 1.5; color: var(--muted-ink); margin-top: 2px;
  }

  .auth-card {
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 18px;
    padding: clamp(28px, 4vw, 40px);
    box-shadow: var(--shadow-plate);
  }
  .auth-plan-pill {
    display: inline-flex; align-items: center; gap: 8px;
    align-self: flex-start;
    padding: 6px 12px 6px 10px;
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
    border: 1px solid color-mix(in oklab, var(--primary) 25%, transparent);
    border-radius: 999px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    margin-bottom: 14px;
  }
  .auth-plan-pill strong { font-weight: 700; }
  .auth-plan-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--primary);
  }
  .auth-form { display: flex; flex-direction: column; gap: 14px; }

  .auth-harnesses {
    display: flex; flex-direction: column; gap: 8px; width: 100%;
  }
  .auth-harness {
    appearance: none; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    gap: 10px;
    padding: 11px 16px; border-radius: 10px;
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
    border: 1px solid var(--plate-line);
    color: var(--page-fg);
    font-family: inherit; font-size: 14px; font-weight: 600;
    transition: background 120ms, border-color 120ms, transform 120ms;
  }
  .auth-harness:hover {
    background: var(--chip-bg);
    border-color: color-mix(in oklab, var(--primary) 40%, var(--plate-line));
  }
  .auth-harness:active { transform: translateY(1px); }
  .auth-harness[disabled] { opacity: 0.55; cursor: wait; }
  .auth-harness svg { flex: none; }
  .auth-divider {
    position: relative; text-align: center;
    margin: 8px 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .auth-divider::before,
  .auth-divider::after {
    content: ""; position: absolute; top: 50%;
    width: calc(50% - 64px); height: 1px;
    background: var(--plate-line);
  }
  .auth-divider::before { left: 0; }
  .auth-divider::after  { right: 0; }
  .auth-divider span { background: var(--plate); padding: 0 8px; }

  .auth-field {
    display: flex; flex-direction: column; gap: 6px;
  }
  .auth-field > span {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .auth-field > input {
    appearance: none;
    border: 1px solid var(--plate-line);
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
    color: var(--page-fg);
    padding: 12px 14px;
    border-radius: 10px;
    font-family: inherit; font-size: 14px;
    transition: border-color 150ms, box-shadow 150ms;
  }
  .auth-field > input:focus {
    outline: none;
    border-color: color-mix(in oklab, var(--primary) 60%, var(--plate-line));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent);
  }

  .auth-meta {
    font-size: 12.5px; color: var(--muted-ink); line-height: 1.5;
  }
  .auth-meta a { color: var(--primary); text-decoration: none; }
  .auth-meta a:hover { text-decoration: underline; }
  .auth-forgot { display: inline-block; }
  .auth-submit { width: 100%; margin-top: 4px; }

  .auth-error {
    font-size: 13px; line-height: 1.5;
    color: var(--destructive);
    padding: 10px 12px; border-radius: 10px;
    background: color-mix(in oklab, var(--destructive) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--destructive) 30%, transparent);
  }

  .auth-switch {
    text-align: center; font-size: 13px; color: var(--muted-ink);
    margin-top: 4px;
  }
  .auth-switch a {
    color: var(--primary); font-weight: 600; text-decoration: none;
  }
  .auth-switch a:hover { text-decoration: underline; }
</style>
