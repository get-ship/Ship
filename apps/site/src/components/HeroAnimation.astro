---
// Hero centerpiece: a view composing itself. A card's regions (header,
// stat, rows, chips) fade and slide in sequentially, settling into a
// static dashboard shape. One-shot intro — no infinite repaint loops,
// no blur filters, no offset-path motion. Short, fast, on-brand.
//
// Every animated element uses transform + opacity only so the browser
// can composite on the GPU without layouting. The whole choreography
// respects prefers-reduced-motion via the global media query.

const rows = [
  { icon: '', label: 'Daily digest', meta: '07:00 · 5 inputs', tone: 'default' },
  { icon: '', label: 'PR review', meta: 'Claude · 1m 42s', tone: 'accent' },
  { icon: '', label: 'Inbox triage', meta: 'Gemini · 4 items', tone: 'info' },
];

const chips = ['Sessions', 'Pipelines', 'Views'];
---

<figure class="view-anim" aria-hidden="true" role="presentation">
  <div class="view-card">
    <div class="view-grid">
      <div class="view-reg view-reg-header" data-step="0">
        <div class="view-dot-row">
          <span class="view-dot view-dot-r"></span>
          <span class="view-dot view-dot-y"></span>
          <span class="view-dot view-dot-g"></span>
        </div>
        <div class="view-title">Today</div>
        <div class="view-chip-row">
          {chips.map((c, i) => (
            <span class={`view-chip${i === 0 ? ' view-chip-on' : ''}`}>{c}</span>
          ))}
        </div>
      </div>

      <div class="view-reg view-reg-stat" data-step="1">
        <div class="view-stat-label">Runs this week</div>
        <div class="view-stat-value">
          <span class="view-stat-num">128</span>
          <span class="view-stat-delta">+12</span>
        </div>
        <svg class="view-spark" viewBox="0 0 120 36" preserveAspectRatio="none">
          <path
            d="M0 28 L16 22 L30 26 L46 14 L62 18 L78 8 L94 12 L110 4 L120 2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>

      <div class="view-reg view-reg-list" data-step="2">
        {rows.map((r, i) => (
          <div class="view-row" style={`--i: ${i}`}>
            <span class={`view-row-bullet view-row-bullet-${r.tone}`}></span>
            <span class="view-row-label">{r.label}</span>
            <span class="view-row-meta">{r.meta}</span>
          </div>
        ))}
      </div>

      <div class="view-reg view-reg-compose" data-step="3">
        <div class="view-compose-token view-compose-token-key">view</div>
        <div class="view-compose-token view-compose-token-tag">daily</div>
        <div class="view-compose-token view-compose-token-num">17 lines</div>
      </div>
    </div>
  </div>
</figure>

<style>
  .view-anim {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 8px auto 0;
    padding: 0;
    aspect-ratio: 640 / 360;
    color: var(--site-fg);
  }

  .view-card {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in oklch, var(--site-border) 65%, transparent);
    border-radius: 18px;
    background: var(--site-card);
    box-shadow:
      0 1px 2px color-mix(in oklch, var(--site-fg) 4%, transparent),
      0 24px 48px -18px color-mix(in oklch, var(--site-accent) 22%, transparent);
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px);
    animation: card-in 480ms cubic-bezier(0.16, 1, 0.3, 1) 80ms forwards;
    contain: paint;
  }

  .view-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in oklch, var(--site-accent) 6%, transparent) 0, transparent 70%);
    pointer-events: none;
  }

  .view-grid {
    position: absolute;
    inset: 0;
    padding: 18px 20px;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    grid-template-rows: auto auto 1fr;
    gap: 12px 16px;
    grid-template-areas:
      'header header'
      'stat   compose'
      'list   compose';
  }

  .view-reg-header { grid-area: header; }
  .view-reg-stat   { grid-area: stat; }
  .view-reg-list   { grid-area: list; }
  .view-reg-compose { grid-area: compose; }

  .view-reg {
    opacity: 0;
    transform: translateY(6px);
    animation: reg-in 380ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .view-reg[data-step='0'] { animation-delay: 260ms; }
  .view-reg[data-step='1'] { animation-delay: 420ms; }
  .view-reg[data-step='2'] { animation-delay: 560ms; }
  .view-reg[data-step='3'] { animation-delay: 700ms; }

  /* Header */
  .view-reg-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid color-mix(in oklch, var(--site-border) 55%, transparent);
  }
  .view-dot-row {
    display: inline-flex;
    gap: 5px;
  }
  .view-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in oklch, var(--site-border) 80%, transparent);
  }
  .view-dot-r { background: oklch(0.7 0.15 25); }
  .view-dot-y { background: oklch(0.78 0.14 80); }
  .view-dot-g { background: oklch(0.72 0.14 150); }
  .view-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: -0.01em;
    color: var(--site-fg);
    margin-right: auto;
  }
  .view-chip-row {
    display: inline-flex;
    gap: 4px;
  }
  .view-chip {
    font-size: 10.5px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 999px;
    color: var(--site-muted-fg);
    background: color-mix(in oklch, var(--site-border) 30%, transparent);
  }
  .view-chip-on {
    color: var(--site-accent-fg);
    background: var(--site-accent);
  }

  /* Stat */
  .view-reg-stat {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 2px;
  }
  .view-stat-label {
    font-size: 11px;
    color: var(--site-muted-fg);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .view-stat-value {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .view-stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.03em;
    color: var(--site-fg);
    font-variant-numeric: tabular-nums;
  }
  .view-stat-delta {
    font-size: 12px;
    font-weight: 600;
    color: oklch(0.55 0.15 150);
    padding: 2px 6px;
    border-radius: 6px;
    background: color-mix(in oklch, oklch(0.55 0.15 150) 14%, transparent);
  }
  .view-spark {
    width: 100%;
    height: 28px;
    color: var(--site-accent);
    margin-top: 2px;
  }

  /* List */
  .view-reg-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 2px 0;
  }
  .view-row {
    display: grid;
    grid-template-columns: 8px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 8px;
    background: color-mix(in oklch, var(--site-border) 14%, transparent);
    opacity: 0;
    transform: translateX(-6px);
    animation: row-in 360ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(680ms + var(--i) * 90ms);
  }
  .view-row-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--site-muted-fg);
  }
  .view-row-bullet-accent { background: var(--site-accent); }
  .view-row-bullet-info { background: oklch(0.65 0.15 240); }
  .view-row-label {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--site-fg);
  }
  .view-row-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--site-muted-fg);
  }

  /* Compose column */
  .view-reg-compose {
    position: relative;
    border-left: 1px dashed color-mix(in oklch, var(--site-border) 60%, transparent);
    padding-left: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .view-reg-compose::before {
    content: 'source';
    position: absolute;
    top: -4px;
    left: 14px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--site-muted-fg);
    background: var(--site-card);
    padding: 0 4px;
  }
  .view-compose-token {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 4px 9px;
    border-radius: 6px;
    background: color-mix(in oklch, var(--site-border) 25%, transparent);
    color: var(--site-fg);
    opacity: 0;
    transform: translateY(4px);
    animation: token-in 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .view-compose-token-key {
    animation-delay: 760ms;
    color: var(--site-accent);
    background: color-mix(in oklch, var(--site-accent) 12%, transparent);
  }
  .view-compose-token-tag { animation-delay: 860ms; }
  .view-compose-token-num { animation-delay: 960ms; }

  /* Static ambient background — no blur filter, no keyframes. */
  .view-anim::before {
    content: '';
    position: absolute;
    inset: -6%;
    background:
      radial-gradient(38% 50% at 22% 28%, var(--site-halo-1), transparent 70%),
      radial-gradient(32% 40% at 82% 24%, var(--site-halo-2), transparent 70%),
      radial-gradient(40% 45% at 62% 88%, var(--site-halo-3), transparent 70%);
    opacity: 0.55;
    z-index: -1;
    pointer-events: none;
  }
  :root[data-theme='warm'] .view-anim::before { opacity: 0.35; }

  @keyframes card-in {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes reg-in {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes row-in {
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes token-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .view-card,
    .view-reg,
    .view-row,
    .view-compose-token {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .view-anim { aspect-ratio: 480 / 380; }
    .view-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      grid-template-areas:
        'header'
        'stat'
        'list'
        'compose';
    }
    .view-reg-compose {
      border-left: none;
      border-top: 1px dashed color-mix(in oklch, var(--site-border) 60%, transparent);
      padding-left: 0;
      padding-top: 12px;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .view-reg-compose::before { display: none; }
  }
</style>
