---
// Highlight 2 — "Build the tool you need."
//
// Live demo: a "morning brief" view composed from multiple sources.
// User toggles source filters (Email / Calendar / Commits / Tasks) and
// the brief updates reactively — items appear and disappear, and the
// count chip updates. Entirely CSS + a tiny script, no AI, no server.
// Makes the "custom tool in minutes" claim tangible.

const sources = [
  { id: 'email',    label: 'Email',    tone: 'info' },
  { id: 'calendar', label: 'Calendar', tone: 'accent' },
  { id: 'commits',  label: 'Commits',  tone: 'success' },
  { id: 'tasks',    label: 'Tasks',    tone: 'warning' },
];

const items = [
  { id: 'e1', source: 'email',    title: 'Re: Design review on Thursday', meta: 'Priya · 9m ago', tone: 'info' },
  { id: 'c1', source: 'commits',  title: 'feat(runtime): cancel long-running agents', meta: '4 commits · main', tone: 'success' },
  { id: 'k1', source: 'calendar', title: '10:30  1:1 with Priya',     meta: '30 min · Zoom', tone: 'accent' },
  { id: 't1', source: 'tasks',    title: 'Ship the release post',     meta: 'due today',     tone: 'warning' },
  { id: 'e2', source: 'email',    title: 'Invoice from Fly.io',       meta: 'Billing · 2h ago', tone: 'info' },
  { id: 'c2', source: 'commits',  title: 'fix(cli): surface permission errors', meta: '1 commit · cli-lane', tone: 'success' },
  { id: 'k2', source: 'calendar', title: '15:00  Investor update',    meta: '45 min · in-person', tone: 'accent' },
  { id: 't2', source: 'tasks',    title: 'Review pricing doc',        meta: 'due Friday',    tone: 'warning' },
];
---

<section class="hl hl-extend" data-visible="false">
  <div class="site-container hl-inner">
    <header class="hl-head">
      <ship-badge tone="info" variant="soft" size="sm">Build the tool you need</ship-badge>
      <h2>Your morning brief. Your way.</h2>
      <p class="hl-sub">
        SHIP pulls from the apps you already use and lets you compose a
        view for any question &mdash; a brief for your morning, a tracker
        for a launch, a lens on your inbox. Pick the sources, watch it
        update. Try it.
      </p>
    </header>

    <div class="hl-demo">
      <ship-card variant="outline" padding="lg" class="hl-brief">
        <div slot="header" class="hl-brief-head">
          <div>
            <div class="hl-brief-title">Monday morning</div>
            <div class="hl-brief-sub">
              <span data-slot="count">8</span> items &middot;
              <span data-slot="sources">4 sources</span>
            </div>
          </div>
          <ship-badge tone="accent" variant="soft" size="sm">live</ship-badge>
        </div>

        <ship-toolbar gap="sm" class="hl-brief-filters" role="group" aria-label="Source filters">
          {sources.map((s) => (
            <button
              type="button"
              class="hl-chip"
              data-source={s.id}
              data-tone={s.tone}
              aria-pressed="true"
            >
              <span class="hl-chip-dot"></span>
              {s.label}
            </button>
          ))}
        </ship-toolbar>

        <ul class="hl-brief-items">
          {items.map((it, i) => (
            <li
              class="hl-brief-item"
              data-source={it.source}
              data-tone={it.tone}
              style={`--i: ${i}`}
            >
              <span class="hl-brief-bullet"></span>
              <div class="hl-brief-body">
                <div class="hl-brief-text">{it.title}</div>
                <div class="hl-brief-meta">{it.meta}</div>
              </div>
              <ship-badge tone={it.tone} variant="soft" size="sm">
                {sources.find((s) => s.id === it.source)?.label}
              </ship-badge>
            </li>
          ))}
        </ul>

        <ship-separator></ship-separator>
        <div class="hl-brief-foot">
          No code. No build step. Every edit is live on your machine.
        </div>
      </ship-card>

      <aside class="hl-brief-hint">
        <h3>Built from SHIP primitives.</h3>
        <p>
          The brief above is a <code>ship-card</code> composed with
          <code>ship-badge</code>, <code>ship-toolbar</code>, and a handful
          of chips &mdash; the same building blocks SHIP uses everywhere.
          Chains, filters, and sort orders are declarative. Drop it into
          any project and connect new sources as you add them.
        </p>
        <ship-toolbar gap="sm">
          <ship-badge tone="muted" variant="outline" size="sm">ship-card</ship-badge>
          <ship-badge tone="muted" variant="outline" size="sm">ship-badge</ship-badge>
          <ship-badge tone="muted" variant="outline" size="sm">ship-toolbar</ship-badge>
          <ship-badge tone="muted" variant="outline" size="sm">ship-separator</ship-badge>
        </ship-toolbar>
      </aside>
    </div>
  </div>
</section>

<script>
  const scope = document.querySelector('.hl-extend');
  if (scope) {
    const active = new Set(['email', 'calendar', 'commits', 'tasks']);
    const chips = scope.querySelectorAll('.hl-chip');
    const items = scope.querySelectorAll('.hl-brief-item');
    const countEl = scope.querySelector('[data-slot="count"]');
    const sourceEl = scope.querySelector('[data-slot="sources"]');

    const syncCount = () => {
      let n = 0;
      items.forEach((it) => {
        const src = it.getAttribute('data-source') || '';
        const show = active.has(src);
        it.toggleAttribute('data-hidden', !show);
        if (show) n += 1;
      });
      if (countEl) countEl.textContent = String(n);
      if (sourceEl) sourceEl.textContent = active.size + ' source' + (active.size === 1 ? '' : 's');
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const src = chip.getAttribute('data-source');
        if (!src) return;
        if (active.has(src)) active.delete(src);
        else active.add(src);
        chip.setAttribute('aria-pressed', active.has(src) ? 'true' : 'false');
        syncCount();
      });
    });

    syncCount();
  }

  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.setAttribute('data-visible', 'true');
        obs.unobserve(e.target);
      }
    }
  }, { threshold: 0.2 });
  document.querySelectorAll('.hl-extend').forEach((el) => obs.observe(el));
</script>

<style>
  .hl {
    padding: clamp(72px, 10vw, 128px) 0;
    position: relative;
  }
  .hl-inner {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  .hl-head {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .hl-sub {
    color: var(--muted-foreground);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.55;
  }

  .hl-demo {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    transition:
      opacity 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms,
      transform 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms;
  }
  :root.js .hl-extend[data-visible='false'] .hl-demo {
    opacity: 0;
    transform: translateY(16px);
  }
  .hl-extend[data-visible='true'] .hl-demo { opacity: 1; transform: none; }
  @media (max-width: 860px) {
    .hl-demo { grid-template-columns: 1fr; }
  }

  .hl-brief { display: block; }
  .hl-brief-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .hl-brief-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .hl-brief-sub {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }

  .hl-brief-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin: 14px 0;
  }
  .hl-chip {
    --chip-tone: var(--muted-foreground);
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    background: var(--card);
    color: var(--muted-foreground);
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
  }
  .hl-chip[data-tone='info']    { --chip-tone: oklch(0.62 0.14 240); }
  .hl-chip[data-tone='accent']  { --chip-tone: var(--site-accent); }
  .hl-chip[data-tone='success'] { --chip-tone: oklch(0.58 0.15 150); }
  .hl-chip[data-tone='warning'] { --chip-tone: oklch(0.64 0.16 60); }
  .hl-chip[aria-pressed='true'] {
    color: var(--foreground);
    border-color: color-mix(in oklch, var(--chip-tone) 55%, transparent);
    background: color-mix(in oklch, var(--chip-tone) 14%, var(--card));
  }
  .hl-chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--chip-tone);
  }
  .hl-chip[aria-pressed='false'] .hl-chip-dot { opacity: 0.4; }

  .hl-brief-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .hl-brief-item {
    display: grid;
    grid-template-columns: 8px 1fr auto;
    column-gap: 12px;
    align-items: center;
    padding: 10px 2px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
    transition: opacity 220ms ease, transform 220ms ease, max-height 220ms ease, padding 220ms ease;
    max-height: 100px;
    overflow: hidden;
  }
  .hl-brief-item:last-child { border-bottom: 0; }
  .hl-brief-item[data-hidden] {
    opacity: 0;
    transform: translateY(-4px);
    max-height: 0;
    padding: 0 2px;
    border-bottom-color: transparent;
    pointer-events: none;
  }
  .hl-brief-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted-foreground);
  }
  .hl-brief-item[data-tone='info']    .hl-brief-bullet { background: oklch(0.62 0.14 240); }
  .hl-brief-item[data-tone='accent']  .hl-brief-bullet { background: var(--site-accent); }
  .hl-brief-item[data-tone='success'] .hl-brief-bullet { background: oklch(0.58 0.15 150); }
  .hl-brief-item[data-tone='warning'] .hl-brief-bullet { background: oklch(0.64 0.16 60); }
  .hl-brief-text {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--foreground);
  }
  .hl-brief-meta {
    color: var(--muted-foreground);
    font-size: 12px;
    margin-top: 2px;
  }

  .hl-brief-foot {
    margin-top: 12px;
    color: var(--muted-foreground);
    font-size: 12px;
    text-align: center;
  }

  .hl-brief-hint {
    padding: 8px 4px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hl-brief-hint h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.015em;
    color: var(--foreground);
  }
  .hl-brief-hint p {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 14px;
  }
  .hl-brief-hint code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 1px 6px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--border) 30%, transparent);
    color: var(--foreground);
  }
</style>
