---
// Pillar 2 — "Extensions by default."
//
// Tabbed demo showing three reactive views a user can build or install:
// a Morning view, a Tasks kanban, and an Inbox lens. Switching tabs
// swaps the view live. No AI, no server — proves custom interfaces +
// registered data types work out of the box.

// Morning brief items
const morning = [
  { id: 'm1', label: 'Design review on Thursday',          meta: 'Priya · 9m ago',          tone: 'info' },
  { id: 'm2', label: 'feat: cancel long-running agents',    meta: '4 commits · main',        tone: 'success' },
  { id: 'm3', label: '10:30 1:1 with Priya',                meta: '30 min · Zoom',           tone: 'accent' },
  { id: 'm4', label: 'Ship the release post',               meta: 'due today',               tone: 'warning' },
  { id: 'm5', label: '15:00 Investor update',               meta: '45 min · in-person',      tone: 'accent' },
];

// Tasks kanban columns
const kanban = [
  {
    id: 'todo',
    name: 'Up next',
    items: [
      { label: 'Write launch blog post',   tone: 'info' },
      { label: 'Call back Priya',          tone: 'warning' },
    ],
  },
  {
    id: 'doing',
    name: 'In flight',
    items: [
      { label: 'Ship v1.2 release notes',  tone: 'accent' },
      { label: 'Review pricing model',     tone: 'info' },
    ],
  },
  {
    id: 'done',
    name: 'Done',
    items: [
      { label: 'Draft investor deck',      tone: 'success' },
      { label: 'Inbox zero',               tone: 'success' },
    ],
  },
];

// Inbox lens items
const inbox = [
  { label: 'Re: Term sheet redlines',       from: 'counsel@',    priority: 'urgent',   tone: 'destructive' },
  { label: 'Fly.io invoice is ready',       from: 'billing',     priority: 'pay soon', tone: 'warning' },
  { label: 'Weekly digest from Priya',      from: 'priya',       priority: 'read',     tone: 'info' },
  { label: 'New reply: design feedback',    from: 'sam',         priority: 'read',     tone: 'info' },
  { label: 'Stripe: successful payment',    from: 'stripe',      priority: 'file',     tone: 'success' },
];
---

<section class="hl hl-extend" data-visible="false">
  <div class="site-container hl-inner">
    <header class="hl-head">
      <h2 class="hl-title">Extensions by default.</h2>
      <p class="hl-sub">
        Easily create reactive applications with your own registered
        data types. SHIP&rsquo;s included skills make one&#8209;shot
        custom apps a reality.
      </p>
    </header>

    <div class="hl-demo">
      <ship-card variant="outline" padding="none" class="hl-tabbed">
        <div slot="header" class="hl-tabbed-head">
          <div class="hl-tabbed-tabs" role="tablist">
            <button
              type="button"
              class="hl-tab"
              data-tab="morning"
              aria-selected="true"
              role="tab"
            >Morning</button>
            <button
              type="button"
              class="hl-tab"
              data-tab="tasks"
              aria-selected="false"
              role="tab"
            >Tasks</button>
            <button
              type="button"
              class="hl-tab"
              data-tab="inbox"
              aria-selected="false"
              role="tab"
            >Inbox</button>
          </div>
          <ship-badge tone="accent" variant="soft" size="sm">live</ship-badge>
        </div>

        <div class="hl-tabbed-body">
          <div class="hl-view" data-view="morning" data-active="true" role="tabpanel">
            <div class="hl-view-head">
              <div class="hl-view-title">Monday morning</div>
              <div class="hl-view-sub">5 items &middot; 4 sources</div>
            </div>
            <ul class="hl-list">
              {morning.map((it, i) => (
                <li class="hl-list-row" style={`--i: ${i}`}>
                  <span class="hl-bullet" data-tone={it.tone}></span>
                  <div class="hl-list-body">
                    <div class="hl-list-label">{it.label}</div>
                    <div class="hl-list-meta">{it.meta}</div>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="hl-view" data-view="tasks" data-active="false" role="tabpanel">
            <div class="hl-view-head">
              <div class="hl-view-title">Launch tracker</div>
              <div class="hl-view-sub">6 tasks &middot; 3 columns</div>
            </div>
            <div class="hl-kanban">
              {kanban.map((col) => (
                <div class="hl-col">
                  <div class="hl-col-head">
                    <span class="hl-col-name">{col.name}</span>
                    <span class="hl-col-count">{col.items.length}</span>
                  </div>
                  <ul class="hl-col-items">
                    {col.items.map((it, i) => (
                      <li class="hl-col-item" data-tone={it.tone} style={`--i: ${i}`}>
                        {it.label}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <div class="hl-view" data-view="inbox" data-active="false" role="tabpanel">
            <div class="hl-view-head">
              <div class="hl-view-title">Inbox lens</div>
              <div class="hl-view-sub">5 messages &middot; sorted by priority</div>
            </div>
            <ul class="hl-list">
              {inbox.map((it, i) => (
                <li class="hl-list-row" style={`--i: ${i}`}>
                  <span class="hl-bullet" data-tone={it.tone}></span>
                  <div class="hl-list-body">
                    <div class="hl-list-label">{it.label}</div>
                    <div class="hl-list-meta">from {it.from}</div>
                  </div>
                  <ship-badge tone={it.tone} variant="soft" size="sm">
                    {it.priority}
                  </ship-badge>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <ship-separator></ship-separator>
        <div class="hl-tabbed-foot">
          Every view is live on your machine. No build step, no deploy.
        </div>
      </ship-card>

    </div>
  </div>
</section>

<script>
  const scope = document.querySelector('.hl-extend');
  if (scope) {
    const tabs = scope.querySelectorAll<HTMLButtonElement>('.hl-tab');
    const views = scope.querySelectorAll<HTMLElement>('.hl-view');
    const activate = (id: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      views.forEach((v) => {
        v.dataset.active = v.dataset.view === id ? 'true' : 'false';
      });
    };
    tabs.forEach((t) => {
      t.addEventListener('click', () => {
        if (t.dataset.tab) activate(t.dataset.tab);
      });
    });

    // Keyboard: Left/Right arrow on tabs
    const list = scope.querySelector('.hl-tabbed-tabs');
    list?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      const active = document.activeElement as HTMLElement | null;
      if (!active || !active.classList.contains('hl-tab')) return;
      const all = Array.from(tabs);
      const idx = all.indexOf(active as HTMLButtonElement);
      if (idx < 0) return;
      const next = ev.key === 'ArrowRight'
        ? (idx + 1) % all.length
        : (idx - 1 + all.length) % all.length;
      all[next].focus();
      if (all[next].dataset.tab) activate(all[next].dataset.tab as string);
      ev.preventDefault();
    });
  }

  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.setAttribute('data-visible', 'true');
        obs.unobserve(e.target);
      }
    }
  }, { threshold: 0.2 });
  document.querySelectorAll('.hl-extend').forEach((el) => obs.observe(el));
</script>

<style>
  .hl {
    padding: clamp(72px, 10vw, 128px) 0;
    position: relative;
  }
  .hl-inner {
    display: grid;
    gap: clamp(28px, 4vw, 52px);
  }
  .hl-head {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .hl-title {
    font-size: clamp(32px, 4.4vw, 48px);
    letter-spacing: -0.025em;
    color: var(--foreground);
  }
  .hl-sub {
    color: var(--muted-foreground);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.55;
    max-width: 48ch;
  }

  .hl-demo {
    max-width: 720px;
    margin-inline: auto;
    width: 100%;
    transition:
      opacity 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms,
      transform 500ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)) 80ms;
  }
  :root.js .hl-extend[data-visible='false'] .hl-demo {
    opacity: 0;
    transform: translateY(16px);
  }
  .hl-extend[data-visible='true'] .hl-demo { opacity: 1; transform: none; }

  .hl-tabbed {
    display: flex;
    flex-direction: column;
  }
  .hl-tabbed-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px 10px 16px;
  }
  .hl-tabbed-tabs {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: color-mix(in oklch, var(--border) 30%, transparent);
  }
  .hl-tab {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 6px 12px;
    border-radius: 7px;
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }
  .hl-tab:hover { color: var(--foreground); }
  .hl-tab[aria-selected='true'] {
    background: var(--card);
    color: var(--foreground);
    box-shadow: 0 1px 2px color-mix(in oklch, var(--foreground) 6%, transparent);
  }

  .hl-tabbed-body {
    padding: 12px 16px 16px;
    min-height: 320px;
  }
  .hl-view {
    display: none;
  }
  .hl-view[data-active='true'] {
    display: block;
    animation: view-in 220ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  @keyframes view-in {
    0% { opacity: 0; transform: translateY(4px); }
    100% { opacity: 1; transform: none; }
  }

  .hl-view-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  .hl-view-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .hl-view-sub {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 2px;
  }

  .hl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .hl-list-row {
    display: grid;
    grid-template-columns: 8px 1fr auto;
    column-gap: 12px;
    align-items: center;
    padding: 9px 2px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
  }
  .hl-list-row:last-child { border-bottom: 0; }
  .hl-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted-foreground);
  }
  .hl-bullet[data-tone='info']        { background: oklch(0.62 0.14 240); }
  .hl-bullet[data-tone='accent']      { background: var(--accent); }
  .hl-bullet[data-tone='success']     { background: oklch(0.58 0.15 150); }
  .hl-bullet[data-tone='warning']     { background: oklch(0.64 0.16 60); }
  .hl-bullet[data-tone='destructive'] { background: oklch(0.60 0.22 25); }
  .hl-list-label {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--foreground);
  }
  .hl-list-meta {
    color: var(--muted-foreground);
    font-size: 12px;
    margin-top: 2px;
  }

  .hl-kanban {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  @media (max-width: 520px) {
    .hl-kanban { grid-template-columns: 1fr; }
  }
  .hl-col {
    padding: 10px 10px 12px;
    border-radius: 10px;
    background: color-mix(in oklch, var(--border) 18%, transparent);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hl-col-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    font-weight: 600;
  }
  .hl-col-count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--border) 40%, transparent);
  }
  .hl-col-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hl-col-item {
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--card);
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    font-size: 12.5px;
    color: var(--foreground);
    border-left-width: 2px;
  }
  .hl-col-item[data-tone='info']    { border-left-color: oklch(0.62 0.14 240); }
  .hl-col-item[data-tone='accent']  { border-left-color: var(--accent); }
  .hl-col-item[data-tone='success'] { border-left-color: oklch(0.58 0.15 150); }
  .hl-col-item[data-tone='warning'] { border-left-color: oklch(0.64 0.16 60); }

  .hl-tabbed-foot {
    padding: 10px 16px 14px;
    color: var(--muted-foreground);
    font-size: 12px;
    text-align: center;
  }

  .hl-extend-copy {
    padding: 8px 4px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hl-extend-copy h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.015em;
    color: var(--foreground);
  }
  .hl-extend-copy p {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 14px;
  }
  .hl-extend-kicker {
    color: var(--foreground) !important;
    font-weight: 500;
  }
</style>
