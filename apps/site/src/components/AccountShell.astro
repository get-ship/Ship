---
/**
 * Shared chrome for the logged-in account surfaces (/account, /billing).
 *
 * Renders a two-column layout: vertical section nav on the left, slot
 * content on the right. A small client script redirects anonymous
 * visitors to /sign-in?next=… so accidental URL hits don't dead-end.
 */

interface Props {
  active: 'account' | 'billing';
  title: string;
}
const { active, title } = Astro.props;

const sections = [
  { id: 'account', label: 'Account',  href: '/account', icon: 'user' },
  { id: 'billing', label: 'Billing',  href: '/billing', icon: 'card' },
] as const;
---

<section class="account-shell">
  <div class="account-shell-inner">
    <header class="account-shell-head">
      <div class="account-shell-eyebrow">Logged in</div>
      <h1 class="account-shell-title">{title}</h1>
    </header>

    <div class="account-shell-grid">
      <nav class="account-shell-nav" aria-label="Account sections">
        {sections.map((s) => (
          <a href={s.href} class={`account-shell-nav-item${active === s.id ? ' is-active' : ''}`} aria-current={active === s.id ? 'page' : undefined}>
            {s.icon === 'user' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
            )}
            {s.icon === 'card' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 10h19"/></svg>
            )}
            {s.label}
          </a>
        ))}
        <hr />
        <a href="https://app.getship.dev" class="account-shell-nav-item account-shell-nav-open">
          Open SHIP
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </nav>

      <div class="account-shell-content">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .account-shell {
    padding: clamp(40px, 5vw, 64px) 0 clamp(80px, 10vw, 120px);
    background:
      radial-gradient(60% 40% at 50% 0%, color-mix(in oklab, var(--accent) 6%, transparent), transparent 70%);
  }
  .account-shell-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 40px;
  }
  @media (max-width: 720px) { .account-shell-inner { padding: 0 20px; } }

  .account-shell-head {
    margin-bottom: 32px;
  }
  .account-shell-eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--subtle-ink); margin-bottom: 8px;
  }
  .account-shell-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(28px, 4vw, 40px); letter-spacing: -0.025em;
    color: var(--page-fg); margin: 0;
  }

  .account-shell-grid {
    display: grid; grid-template-columns: 220px 1fr; gap: 40px;
    align-items: start;
  }
  @media (max-width: 880px) {
    .account-shell-grid { grid-template-columns: 1fr; gap: 24px; }
  }

  .account-shell-nav {
    position: sticky; top: 88px;
    display: flex; flex-direction: column; gap: 2px;
    padding: 10px;
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 14px;
    box-shadow: var(--shadow-plate);
  }
  @media (max-width: 880px) {
    .account-shell-nav { position: static; flex-direction: row; flex-wrap: wrap; }
    .account-shell-nav hr { display: none; }
    .account-shell-nav-open { margin-left: auto; }
  }
  .account-shell-nav-item {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 12px; border-radius: 8px;
    color: var(--muted-ink);
    font-size: 13.5px; font-weight: 500;
    text-decoration: none;
    transition: background 120ms, color 120ms;
  }
  .account-shell-nav-item:hover { background: var(--chip-bg); color: var(--page-fg); }
  .account-shell-nav-item.is-active {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
  }
  .account-shell-nav-item.is-active svg { color: var(--primary); }
  .account-shell-nav hr {
    border: none; border-top: 1px solid var(--plate-line); margin: 4px 4px;
  }
  .account-shell-nav-open { color: var(--primary); }
  .account-shell-nav-open svg { margin-left: auto; transition: transform 160ms; }
  .account-shell-nav-open:hover svg { transform: translateX(2px); }

  .account-shell-content {
    display: flex; flex-direction: column; gap: 24px;
  }
</style>
