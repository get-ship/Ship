---
import PlatformDetect from './PlatformDetect.astro';
---

<section class="download">
  <div class="site-container download-inner">
    <div class="download-header">
      <h2>Get SHIP.</h2>
      <p class="site-muted">
        Runs on your machine. Bring your own keys. No account needed to
        start &mdash; sign in later when you want to sync across devices.
      </p>
    </div>
    <PlatformDetect />
  </div>
</section>

<style>
  .download {
    position: relative;
    padding: clamp(64px, 10vw, 120px) 0;
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    content-visibility: auto;
    contain-intrinsic-size: 1px 900px;
  }
  .download-header {
    text-align: center;
    max-width: 52ch;
    margin: 0 auto 36px;
  }
  .download-header h2 {
    margin-bottom: 10px;
  }
  .download-inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
</style>
