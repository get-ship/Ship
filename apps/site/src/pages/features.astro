---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Built-in SHIP views that ship today — sourced from .ship/views/ in
// this repo. Don't invent. Each one is a real working surface.
const builtinViews = [
  { id: 'dashboard', label: 'Dashboard', blurb: 'Your workspace at a glance — runs, alerts, pinned views.' },
  { id: 'chat',      label: 'Chat',      blurb: 'Long-running conversations with any provider, any agent.' },
  { id: 'agents',    label: 'Agents',    blurb: 'Roster of configured agents, their skills and permissions.' },
  { id: 'pipelines', label: 'Pipelines', blurb: 'Author, run, and audit multi-step workflows.' },
  { id: 'canvas',    label: 'Canvas',    blurb: 'A freeform board for specs, drafts, and whiteboard thinking.' },
  { id: 'data',      label: 'Data',      blurb: 'Every collection, live CRUD, auto-generated forms + tables.' },
  { id: 'git',       label: 'Git',       blurb: 'Diffs, PR review, annotated code in-app.' },
  { id: 'events',    label: 'Events',    blurb: 'The firehose — every kernel event, filterable and replayable.' },
  { id: 'skills',    label: 'Skills',    blurb: 'Browse, install, and scope reusable capabilities.' },
  { id: 'specs',     label: 'Specs',     blurb: 'Planning documents tied to pipelines and runs.' },
  { id: 'settings',  label: 'Settings',  blurb: 'Providers, keys, themes, governance, integrations.' },
];

// Real skills from .ship/skills/ in this repo — descriptions copied
// from their frontmatter, trimmed for the card.
const skills = [
  { id: 'cmdr',             name: 'Commander',       tags: ['orchestration'],   body: 'Captures intent, dispatches specialist agents, gates before merge. The human\u2019s proxy in the cluster.' },
  { id: 'code-review',      name: 'Code review',     tags: ['review', 'security'], body: 'PR + branch reviews with line references, structured verdicts, and coverage checks.' },
  { id: 'design-workflow',  name: 'Design workflow', tags: ['ui', 'browser'],   body: 'Brainstorm HTML mockups, preview in browser, extract a spec, dispatch an implementation agent.' },
  { id: 'diff-review',      name: 'Diff review',     tags: ['git', 'review'],   body: 'Interactive annotatable diff view for any git range.' },
  { id: 'drizzle-studio',   name: 'Drizzle Studio',  tags: ['db', 'dev-tools'], body: 'Browse, query, and edit your SQLite/Postgres database in-app.' },
  { id: 'mcp-inspector',    name: 'MCP inspector',   tags: ['mcp', 'debug'],    body: 'Connect to any MCP server, inspect tools/resources/prompts, watch notifications live.' },
  { id: 'plan',             name: 'Plan',            tags: ['planning'],        body: 'Step-by-step implementation plans for any task. Returns a sequenced DAG.' },
  { id: 'spawn-agent',      name: 'Spawn agent',     tags: ['orchestration'],   body: 'Dispatch a specialist in its own worktree with scoped permissions.' },
  { id: 'web-qa',           name: 'Web QA',          tags: ['qa', 'playwright'],body: 'Playwright-driven navigation, interaction, screenshots, bug reports.' },
  { id: 'tdd',              name: 'TDD',             tags: ['tests'],           body: 'Red-green-refactor loop with a paired agent that writes the failing test first.' },
  { id: 'write-adr',        name: 'Write ADR',       tags: ['docs'],            body: 'Draft an architecture decision record from a short brief.' },
  { id: 'storybook',        name: 'Storybook',       tags: ['dev-tools'],       body: 'Launch Storybook and render it in the workspace session.' },
];

// A realistic example pipeline the user could actually run in SHIP.
const pipelineSteps = [
  { name: 'collect-diff',  type: 'run',   state: 'completed', label: 'git diff main...' },
  { name: 'review',        type: 'agent', state: 'completed', label: 'code-review · Claude' },
  { name: 'tests-pass',    type: 'gate',  state: 'running',   label: 'acceptance check' },
  { name: 'draft-pr-body', type: 'agent', state: 'pending',   label: 'write-adr · ChatGPT' },
  { name: 'merge',         type: 'merge', state: 'pending',   label: 'fast-forward' },
];

// Mock recent activity for the observability row.
const recent = [
  { at: '09:14', actor: 'cmdr',           verb: 'dispatched', target: 'agent.code-review' },
  { at: '09:14', actor: 'code-review',    verb: 'completed',  target: '3 findings' },
  { at: '09:12', actor: 'design-workflow',verb: 'captured',   target: 'spec.login-ui' },
  { at: '09:05', actor: 'web-qa',         verb: 'finished',   target: '.artifacts/qa/run-42' },
];

const weekly = [3, 7, 5, 11, 8, 14, 10];

const viewIconMap: Record<string, string> = {
  dashboard: 'layout-dashboard',
  chat: 'message-square',
  agents: 'users',
  pipelines: 'git-branch',
  canvas: 'shapes',
  data: 'database',
  git: 'git-pull-request',
  events: 'activity',
  skills: 'sparkles',
  specs: 'file-text',
  settings: 'settings',
};
const viewIcon = (id: string) => viewIconMap[id] ?? 'square';
---

<BaseLayout title="SHIP features — the platform for AI-native apps">
  <Navbar />
  <main class="fx-page">

    <!-- ============================================================
         Hero (retained from the previous /framework page — the line
         the user called the best descriptor yet).
    ============================================================= -->
    <header class="fx-hero site-container">
      <ship-badge tone="primary" variant="soft" size="sm">Build on SHIP</ship-badge>
      <h1>The platform for AI&#8209;native apps.</h1>
      <p class="fx-lede">
        SHIP isn&rsquo;t a library. It&rsquo;s a runtime, an SDK, a
        component system, and a governance layer &mdash; all designed so
        your team can ship AI features your users actually want to use.
        Start free on your laptop, talk to us when you&rsquo;re ready
        for a team or production.
      </p>
      <ship-toolbar gap="md" justify="start" class="fx-ctas">
        <ship-button
          tone="primary"
          variant="solid"
          size="lg"
          onclick="location.href='/download'"
        >Download SHIP</ship-button>
        <ship-button
          variant="ghost"
          size="lg"
          onclick="location.href='https://docs.getship.dev'"
        >Read the docs &rarr;</ship-button>
      </ship-toolbar>
    </header>

    <!-- ============================================================
         Built-in views — the 11 surfaces that ship today.
    ============================================================= -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="info" variant="soft" size="sm">In the box</ship-badge>
        <h2>Eleven first-party views, every one extensible.</h2>
        <p class="fx-sec-sub">
          Chat, agents, pipelines, data, git, events, specs, skills,
          a freeform canvas, a dashboard, and settings &mdash; all
          built with the same components and tokens you ship with.
        </p>
      </header>

      <div class="fx-views">
        {builtinViews.map((v) => (
          <ship-card variant="outline" padding="md" class="fx-view">
            <div class="fx-view-row">
              <ship-icon name={viewIcon(v.id)} size="md" aria-hidden="true"></ship-icon>
              <div class="fx-view-body">
                <div class="fx-view-name">{v.label}</div>
                <div class="fx-view-blurb">{v.blurb}</div>
              </div>
            </div>
          </ship-card>
        ))}
      </div>
    </section>

    <!-- ============================================================
         Editor surfaces — real ship-code / ship-markdown / table.
    ============================================================= -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="info" variant="soft" size="sm">Editors</ship-badge>
        <h2>Write anything inside SHIP.</h2>
        <p class="fx-sec-sub">
          Code, markdown, structured data, even a real terminal. Every
          surface is a ship&#8209;* web component &mdash; the same ones
          your extensions get.
        </p>
      </header>

      <ship-card variant="outline" padding="none" class="fx-editor">
        <ship-tabs active="code" class="fx-editor-tabs">
          <ship-tab name="code" label="Code"></ship-tab>
          <ship-tab name="markdown" label="Markdown"></ship-tab>
          <ship-tab name="data" label="Data"></ship-tab>
          <ship-tab name="terminal" label="Terminal"></ship-tab>
          <ship-tab-panel name="code" active>
            <div class="fx-editor-body">
              <ship-code block lang="json">{`{
  "id": "weekly-review",
  "schedule": "0 9 * * MON",
  "steps": [
    { "name": "collect", "type": "run",   "with": "git log --since=1w" },
    { "name": "summarize", "type": "agent", "skill": "plan", "model": "claude" },
    { "name": "approve",  "type": "gate",  "owner": "human" },
    { "name": "notify",   "type": "agent", "skill": "write-adr" }
  ]
}`}</ship-code>
            </div>
          </ship-tab-panel>
          <ship-tab-panel name="markdown">
            <div class="fx-editor-body">
              <ship-markdown value={`# Release v1.2

- **New**: worktree-per-agent dispatch
- **Fixed**: long-running agent cancel
- **Breaking**: \`ship spawn\` now requires a skill

See the [migration guide](https://docs.getship.dev/migrations/1.2).`}></ship-markdown>
            </div>
          </ship-tab-panel>
          <ship-tab-panel name="data">
            <div class="fx-editor-body">
              <table class="fx-table">
                <thead>
                  <tr><th>Title</th><th>Status</th><th>Owner</th><th>Run</th></tr>
                </thead>
                <tbody>
                  <tr><td>Cancel long-running agents</td><td><ship-badge tone="success" variant="soft" size="sm">merged</ship-badge></td><td>priya</td><td>12</td></tr>
                  <tr><td>Surface permission errors</td><td><ship-badge tone="info" variant="soft" size="sm">review</ship-badge></td><td>sam</td><td>04</td></tr>
                  <tr><td>Worktree cleanup on stop</td><td><ship-badge tone="warning" variant="soft" size="sm">draft</ship-badge></td><td>you</td><td>—</td></tr>
                </tbody>
              </table>
            </div>
          </ship-tab-panel>
          <ship-tab-panel name="terminal">
            <div class="fx-editor-body fx-term">
<pre><span class="fx-prompt">$</span> ship run weekly-review
<span class="fx-dim">[collect]</span>    git log --since=1w &rarr; 37 commits
<span class="fx-dim">[summarize]</span> claude &middot; 2.1s &middot; $0.02
<span class="fx-ok">[approve]</span>   waiting for human <span class="fx-accent">&darr;</span>
</pre>
            </div>
          </ship-tab-panel>
        </ship-tabs>
      </ship-card>
    </section>

    <!-- ============================================================
         Pipelines — ship-pipeline-dag with real steps.
    ============================================================= -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="accent" variant="soft" size="sm">Pipelines</ship-badge>
        <h2>One JSON file. Any workflow.</h2>
        <p class="fx-sec-sub">
          Steps can be a <code>run</code> (any shell), an <code>agent</code>
          (skill + model), a <code>gate</code> (human or automated), a
          <code>merge</code>, or a nested pipeline. SHIP schedules, retries,
          caps cost, and keeps the audit.
        </p>
      </header>

      <ship-card variant="outline" padding="lg" class="fx-pipeline">
        <ship-pipeline-dag>
          {pipelineSteps.map((s, i) => (
            <>
              {i > 0 && <span class="arrow" aria-hidden="true">&rarr;</span>}
              <ship-pipeline-step
                name={s.name}
                step-type={s.type}
                state={s.state}
                agent={s.label}
              ></ship-pipeline-step>
            </>
          ))}
        </ship-pipeline-dag>
      </ship-card>
    </section>

    <!-- ============================================================
         Skills — real skills from .ship/skills/
    ============================================================= -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="success" variant="soft" size="sm">Skills</ship-badge>
        <h2>Composable capabilities.</h2>
        <p class="fx-sec-sub">
          Skills are scoped, versioned, and shareable. They bring their
          own UI (via views), their own prompts, their own permissions.
          Every agent inherits only what you grant it. These twelve
          ship with SHIP &mdash; and you can author your own.
        </p>
      </header>

      <div class="fx-skills">
        {skills.map((s) => (
          <ship-card variant="outline" padding="md" class="fx-skill">
            <div class="fx-skill-head">
              <span class="fx-skill-name">{s.name}</span>
              <div class="fx-skill-tags">
                {s.tags.map((t) => (
                  <ship-chip tone="muted" size="sm" variant="outline">{t}</ship-chip>
                ))}
              </div>
            </div>
            <p class="fx-skill-body">{s.body}</p>
          </ship-card>
        ))}
      </div>
    </section>

    <!-- ============================================================
         Observability — charts + event timeline.
    ============================================================= -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="warning" variant="soft" size="sm">Observability</ship-badge>
        <h2>Every run, visible.</h2>
        <p class="fx-sec-sub">
          Charts, timelines, diffs, event logs &mdash; all first-class
          components. Drop them into any view, any extension, any
          dashboard.
        </p>
      </header>

      <div class="fx-obs">
        <ship-card variant="outline" padding="lg" class="fx-obs-stat">
          <div class="fx-obs-stat-head">
            <div class="fx-obs-label">Runs this week</div>
            <div class="fx-obs-num">58</div>
          </div>
          <ship-sparkline
            data={weekly.join(',')}
            tone="accent"
            width="220"
            height="36"
          ></ship-sparkline>
        </ship-card>

        <ship-card variant="outline" padding="lg" class="fx-obs-ring">
          <div class="fx-obs-label">Budget used</div>
          <ship-gauge
            value="42"
            min="0"
            max="100"
            tone="success"
            size="120"
            label="42%"
          ></ship-gauge>
        </ship-card>

        <ship-card variant="outline" padding="lg" class="fx-obs-events">
          <div class="fx-obs-label">Recent events</div>
          <ul class="fx-events">
            {recent.map((e) => (
              <li class="fx-event">
                <span class="fx-event-at">{e.at}</span>
                <span class="fx-event-actor">{e.actor}</span>
                <span class="fx-event-verb">{e.verb}</span>
                <span class="fx-event-target">{e.target}</span>
              </li>
            ))}
          </ul>
        </ship-card>
      </div>
    </section>

    <!-- ============================================================
         Theme & style — reuse of the theme picker.
    ============================================================= -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="muted" variant="soft" size="sm">Theme</ship-badge>
        <h2>Restyle everything. Keep the semantics.</h2>
        <p class="fx-sec-sub">
          Sixteen canonical tokens. Eight built-in themes. Drop your own
          palette into a stylesheet, and every SHIP surface &mdash; the
          app, your extensions, third-party views &mdash; picks it up.
        </p>
      </header>

      <ship-card variant="outline" padding="lg" class="fx-theme">
        <div class="fx-theme-copy">
          <p>
            Open the picker in the nav. Or override <code>--primary</code>,
            <code>--accent</code>, and <code>--radius</code> in your own
            CSS and ship it as a theme for your whole team.
          </p>
        </div>
        <ship-code block lang="css">{`:root[data-theme='our-brand'] {
  --primary: oklch(0.66 0.18 190);
  --accent:  oklch(0.72 0.14 60);
  --radius:  14px;
}`}</ship-code>
      </ship-card>
    </section>

    <!-- ============================================================
         CTA card (retained from the previous framework page).
    ============================================================= -->
    <section class="fx-cta site-container">
      <ship-card variant="outline" padding="lg" class="fx-cta-card">
        <div class="fx-cta-copy">
          <h2>Ready to build on SHIP?</h2>
          <p>
            We&rsquo;re onboarding a small group of design-forward teams
            into the platform ahead of general availability. Bring your
            use case, we&rsquo;ll bring the SDK, runtime, and production
            reps.
          </p>
        </div>
        <ship-toolbar slot="footer" gap="md" justify="end">
          <ship-button
            variant="ghost"
            size="md"
            onclick="location.href='https://docs.getship.dev'"
          >Docs</ship-button>
          <ship-button
            tone="primary"
            variant="solid"
            size="md"
            onclick="location.href='mailto:sales@getship.dev'"
          >Email sales</ship-button>
        </ship-toolbar>
      </ship-card>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Ensure the extra components this page uses (pipeline dag/step,
  // code, markdown, tabs, charts, chip, icon) are registered. Core
  // components come from register-elements.ts in BaseLayout; these
  // are page-scoped and heavier, so they live here.
  import '@ship/ui/web-components/ship-tabs';
  import '@ship/ui/web-components/observability/ship-code';
  import '@ship/ui/web-components/observability/ship-markdown';
  import '@ship/ui/web-components/domain/ship-pipeline-dag';
  import '@ship/ui/web-components/domain/ship-pipeline-step';
  import '@ship/ui/web-components/charts/ship-sparkline';
  import '@ship/ui/web-components/charts/ship-gauge';
  import '@ship/ui/web-components/utility/ship-chip';
  import '@ship/ui/web-components/utility/ship-icon';
</script>

<style>
  .fx-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  /* Hero ------------------------------------------------------------ */
  .fx-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 52rem;
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .fx-hero h1 { font-size: clamp(40px, 6vw, 64px); }
  .fx-lede {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .fx-ctas { margin-top: 6px; }

  /* Section scaffolding -------------------------------------------- */
  .fx {
    padding: clamp(48px, 8vw, 96px) 0;
  }
  .fx-sec-head {
    max-width: 60ch;
    margin: 0 auto clamp(24px, 4vw, 40px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .fx-sec-head h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.022em;
  }
  .fx-sec-sub {
    color: var(--muted-foreground);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.55;
    max-width: 52ch;
  }
  .fx-sec-sub code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--border) 30%, transparent);
  }

  /* Views grid ----------------------------------------------------- */
  .fx-views {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 10px;
    max-width: 1040px;
    margin-inline: auto;
  }
  .fx-view { display: block; }
  .fx-view-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: flex-start;
  }
  .fx-view-body { min-width: 0; }
  .fx-view-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .fx-view-blurb {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 3px;
    line-height: 1.5;
  }

  /* Editors tab card ----------------------------------------------- */
  .fx-editor {
    display: block;
    max-width: 960px;
    margin-inline: auto;
  }
  .fx-editor-tabs {
    --ship-tabs-padding-x: 18px;
    padding: 0 18px;
  }
  .fx-editor-body {
    padding: 16px 20px 20px;
  }
  .fx-editor-body ship-code[block] {
    --ship-code-font-size: 12.5px;
  }
  .fx-editor-body ship-markdown {
    display: block;
    line-height: 1.6;
    font-size: 14px;
  }

  .fx-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .fx-table th,
  .fx-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .fx-table th {
    font-weight: 600;
    color: var(--muted-foreground);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .fx-table tr:last-child td { border-bottom: 0; }

  .fx-term pre {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    margin: 0;
    color: var(--foreground);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    overflow: auto;
  }
  .fx-term .fx-prompt  { color: var(--primary); font-weight: 600; margin-right: 4px; }
  .fx-term .fx-dim     { color: var(--muted-foreground); }
  .fx-term .fx-ok      { color: oklch(0.60 0.16 150); }
  .fx-term .fx-accent  { color: var(--primary); }

  /* Pipelines ------------------------------------------------------ */
  .fx-pipeline {
    max-width: 960px;
    margin-inline: auto;
    display: block;
    overflow-x: auto;
  }
  .fx-pipeline .arrow {
    color: var(--muted-foreground);
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    padding: 0 6px;
  }

  /* Skills grid ---------------------------------------------------- */
  .fx-skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
    max-width: 1100px;
    margin-inline: auto;
  }
  .fx-skill { display: block; }
  .fx-skill-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .fx-skill-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--foreground);
  }
  .fx-skill-tags {
    display: inline-flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .fx-skill-body {
    color: var(--muted-foreground);
    font-size: 12.5px;
    line-height: 1.5;
  }

  /* Observability -------------------------------------------------- */
  .fx-obs {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: 12px;
    max-width: 1040px;
    margin-inline: auto;
  }
  @media (max-width: 860px) {
    .fx-obs { grid-template-columns: 1fr; }
  }
  .fx-obs-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .fx-obs-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .fx-obs-stat-head { margin-bottom: 8px; }
  .fx-obs-ring { text-align: center; }

  .fx-events {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .fx-event {
    display: grid;
