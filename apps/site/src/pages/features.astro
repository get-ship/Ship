---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// First-party SHIP surfaces. Real product, not internals.
const builtinViews = [
  { label: 'Dashboard', blurb: 'Your workspace at a glance.' },
  { label: 'Chat',      blurb: 'Long-running conversations with any provider.' },
  { label: 'Agents',    blurb: 'Configure and manage the agents that work for you.' },
  { label: 'Pipelines', blurb: 'Author, run, and audit multi-step workflows.' },
  { label: 'Canvas',    blurb: 'A freeform board for specs, drafts, and whiteboarding.' },
  { label: 'Data',      blurb: 'Every collection with live CRUD, forms, and tables.' },
  { label: 'Git',       blurb: 'Diffs and PR review in-app.' },
  { label: 'Events',    blurb: 'The firehose of everything your agents just did.' },
  { label: 'Specs',     blurb: 'Planning docs tied to the work they describe.' },
  { label: 'Settings',  blurb: 'Providers, keys, themes, and governance.' },
];

// Capability categories, marketing-framed. SHIP ships a catalog of
// pre-built skills in each area; users install, compose, author their
// own. No naming the internal dev-tooling.
const capabilities = [
  { name: 'Review & QA',       body: 'Code review, diff annotation, acceptance gates, browser testing — automated or human-in-the-loop.' },
  { name: 'Design & UI',       body: 'Brainstorm mockups, preview in a real browser, extract specs, dispatch an implementer.' },
  { name: 'Data & analytics',  body: 'Explore collections, run ad-hoc queries, summarize results into a view your team can reuse.' },
  { name: 'Content & writing', body: 'Drafts, ADRs, release notes, weekly digests — with citations back to the source you asked about.' },
  { name: 'Integrations',      body: 'MCP-native. Any tool that speaks MCP plugs in — servers, IDEs, agents from other vendors.' },
  { name: 'Your own',          body: 'Skills are small files with a prompt, some tools, a permission scope, and optional UI. Author one in an afternoon.' },
];

// A realistic, run-anywhere pipeline the user could see in SHIP today.
const pipelineSteps = [
  { name: 'collect',     type: 'run',   state: 'completed' as const, agent: 'git diff main...' },
  { name: 'review',      type: 'agent', state: 'completed' as const, agent: 'Claude' },
  { name: 'tests-pass',  type: 'gate',  state: 'running'   as const, agent: 'acceptance' },
  { name: 'write',       type: 'agent', state: 'pending'   as const, agent: 'ChatGPT' },
  { name: 'merge',       type: 'merge', state: 'pending'   as const, agent: 'fast-forward' },
];

const weekly = [3, 7, 5, 11, 8, 14, 10];

const recent = [
  { at: '09:14', actor: 'reviewer',    verb: 'finished',  target: '3 findings on branch' },
  { at: '09:12', actor: 'designer',    verb: 'captured',  target: 'spec.login-ui' },
  { at: '09:05', actor: 'qa',          verb: 'passed',    target: '42 steps, 0 regressions' },
  { at: '08:48', actor: 'weekly-brief',verb: 'delivered', target: '12 items, 4 sources' },
];
---

<BaseLayout title="SHIP features — the platform for AI-native apps">
  <Navbar />
  <main class="fx-page">

    <!-- Hero ------------------------------------------------------- -->
    <header class="fx-hero site-container">
      <ship-badge tone="primary" variant="soft" size="sm">Build on SHIP</ship-badge>
      <h1>The platform for AI&#8209;native apps.</h1>
      <p class="fx-lede">
        SHIP isn&rsquo;t a library. It&rsquo;s a runtime, an SDK, a
        component system, and a governance layer &mdash; all designed
        so your team can ship AI features your users actually want to
        use. Start free on your laptop, talk to us when you&rsquo;re
        ready for a team or production.
      </p>
      <ship-toolbar gap="md" justify="start" class="fx-ctas">
        <ship-button
          tone="primary"
          variant="solid"
          size="lg"
          onclick="location.href='/download'"
        >Download SHIP</ship-button>
        <ship-button
          variant="ghost"
          size="lg"
          onclick="location.href='https://docs.getship.dev'"
        >Read the docs &rarr;</ship-button>
      </ship-toolbar>
    </header>

    <!-- Built-in views --------------------------------------------- -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="info" variant="soft" size="sm">In the box</ship-badge>
        <h2>Ten surfaces, day one.</h2>
        <p class="fx-sec-sub">
          Chat, agents, pipelines, data, git, events, specs, a freeform
          canvas, a dashboard, and settings. Every surface is a view,
          every view is extensible, every extension uses the same
          components.
        </p>
      </header>

      <div class="fx-views">
        {builtinViews.map((v) => (
          <ship-card variant="outline" padding="md" class="fx-view">
            <div class="fx-view-name">{v.label}</div>
            <div class="fx-view-blurb">{v.blurb}</div>
          </ship-card>
        ))}
      </div>
    </section>

    <!-- Editors & surfaces ----------------------------------------- -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="info" variant="soft" size="sm">Editors</ship-badge>
        <h2>Write anything inside SHIP.</h2>
        <p class="fx-sec-sub">
          Real editors, not read-only previews. Code, markdown,
          structured data, a terminal &mdash; every surface is a
          ship&#8209;* web component your extensions inherit.
        </p>
      </header>

      <ship-card variant="outline" padding="none" class="fx-editor">
        <div class="fx-editor-tabs" role="tablist">
          <button type="button" class="fx-tab" data-tab="code" aria-selected="true" role="tab">Code</button>
          <button type="button" class="fx-tab" data-tab="markdown" aria-selected="false" role="tab">Markdown</button>
          <button type="button" class="fx-tab" data-tab="data" aria-selected="false" role="tab">Data</button>
          <button type="button" class="fx-tab" data-tab="terminal" aria-selected="false" role="tab">Terminal</button>
        </div>

        <div class="fx-editor-body" data-panel="code" data-active="true" role="tabpanel">
<pre class="fx-pre"><code><span class="k">&#123;</span>
  <span class="s">"id"</span>: <span class="v">"weekly-review"</span>,
  <span class="s">"schedule"</span>: <span class="v">"0 9 * * MON"</span>,
  <span class="s">"steps"</span>: <span class="k">[</span>
    <span class="k">&#123;</span> <span class="s">"name"</span>: <span class="v">"collect"</span>,   <span class="s">"type"</span>: <span class="v">"run"</span>,   <span class="s">"with"</span>:  <span class="v">"git log --since=1w"</span> <span class="k">&#125;</span>,
    <span class="k">&#123;</span> <span class="s">"name"</span>: <span class="v">"summarize"</span>, <span class="s">"type"</span>: <span class="v">"agent"</span>, <span class="s">"model"</span>: <span class="v">"claude"</span> <span class="k">&#125;</span>,
    <span class="k">&#123;</span> <span class="s">"name"</span>: <span class="v">"approve"</span>,   <span class="s">"type"</span>: <span class="v">"gate"</span>,  <span class="s">"owner"</span>: <span class="v">"human"</span>  <span class="k">&#125;</span>,
    <span class="k">&#123;</span> <span class="s">"name"</span>: <span class="v">"notify"</span>,    <span class="s">"type"</span>: <span class="v">"agent"</span>, <span class="s">"model"</span>: <span class="v">"chatgpt"</span> <span class="k">&#125;</span>
  <span class="k">]</span>
<span class="k">&#125;</span></code></pre>
        </div>

        <div class="fx-editor-body" data-panel="markdown" data-active="false" role="tabpanel">
          <article class="fx-md">
            <h3>Release v1.2</h3>
            <ul>
              <li><strong>New</strong> — worktree-per-agent dispatch.</li>
              <li><strong>Fixed</strong> — long-running agents cancel cleanly.</li>
              <li><strong>Breaking</strong> — <code>ship spawn</code> now requires a skill.</li>
            </ul>
            <p>See the <a href="#">migration guide</a>.</p>
          </article>
        </div>

        <div class="fx-editor-body" data-panel="data" data-active="false" role="tabpanel">
          <table class="fx-table">
            <thead>
              <tr><th>Title</th><th>Status</th><th>Owner</th><th>Run</th></tr>
            </thead>
            <tbody>
              <tr><td>Cancel long-running agents</td><td><ship-badge tone="success" variant="soft" size="sm">merged</ship-badge></td><td>priya</td><td>12</td></tr>
              <tr><td>Surface permission errors</td><td><ship-badge tone="info" variant="soft" size="sm">review</ship-badge></td><td>sam</td><td>04</td></tr>
              <tr><td>Worktree cleanup on stop</td><td><ship-badge tone="warning" variant="soft" size="sm">draft</ship-badge></td><td>you</td><td>&mdash;</td></tr>
            </tbody>
          </table>
        </div>

        <div class="fx-editor-body fx-term" data-panel="terminal" data-active="false" role="tabpanel">
<pre><span class="fx-prompt">$</span> ship run weekly-review
<span class="fx-dim">[collect]</span>    git log --since=1w &rarr; 37 commits
<span class="fx-dim">[summarize]</span> claude &middot; 2.1s &middot; $0.02
<span class="fx-ok">[approve]</span>   waiting for human <span class="fx-accent">&darr;</span>
</pre>
        </div>
      </ship-card>
    </section>

    <!-- Pipelines -------------------------------------------------- -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="accent" variant="soft" size="sm">Pipelines</ship-badge>
        <h2>One JSON file. Any workflow.</h2>
        <p class="fx-sec-sub">
          Steps can be a shell command, an agent call, a human or
          automated gate, a merge, or a nested pipeline. SHIP
          schedules, retries, caps cost, and keeps the audit trail.
        </p>
      </header>

      <ship-card variant="outline" padding="lg" class="fx-pipeline">
        <ship-pipeline-dag>
          {pipelineSteps.map((s, i) => (
            <>
              {i > 0 && <span class="arrow" aria-hidden="true">&rarr;</span>}
              <ship-pipeline-step
                name={s.name}
                step-type={s.type}
                state={s.state}
                agent={s.agent}
              ></ship-pipeline-step>
            </>
          ))}
        </ship-pipeline-dag>
      </ship-card>
    </section>

    <!-- Capabilities (was skills, de-interned) --------------------- -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="success" variant="soft" size="sm">Capabilities</ship-badge>
        <h2>Install a skill. Or ship your own.</h2>
        <p class="fx-sec-sub">
          Skills are the composable pieces agents use to actually do
          work &mdash; each one scoped, versioned, shareable. SHIP
          ships a catalog, and authoring your own is a small file with
          a prompt, some tools, and a permission scope.
        </p>
      </header>

      <div class="fx-caps">
        {capabilities.map((c) => (
          <ship-card variant="outline" padding="md" class="fx-cap">
            <div class="fx-cap-name">{c.name}</div>
            <p class="fx-cap-body">{c.body}</p>
          </ship-card>
        ))}
      </div>
    </section>

    <!-- Observability ---------------------------------------------- -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="warning" variant="soft" size="sm">Observability</ship-badge>
        <h2>Every run, visible.</h2>
        <p class="fx-sec-sub">
          Charts, timelines, diffs, event logs &mdash; all first-class
          components. Drop them into any view, any extension, any
          dashboard.
        </p>
      </header>

      <div class="fx-obs">
        <ship-card variant="outline" padding="lg" class="fx-obs-stat">
          <div class="fx-obs-label">Runs this week</div>
          <div class="fx-obs-num">58</div>
          <ship-sparkline
            data={weekly.join(',')}
            tone="accent"
            width="220"
            height="36"
          ></ship-sparkline>
        </ship-card>

        <ship-card variant="outline" padding="lg" class="fx-obs-ring">
          <div class="fx-obs-label">Budget used</div>
          <ship-gauge
            value="42"
            min="0"
            max="100"
            tone="success"
            size="120"
            label="42%"
          ></ship-gauge>
        </ship-card>

        <ship-card variant="outline" padding="lg" class="fx-obs-events">
          <div class="fx-obs-label">Recent activity</div>
          <ul class="fx-events">
            {recent.map((e) => (
              <li class="fx-event">
                <span class="fx-event-at">{e.at}</span>
                <span class="fx-event-actor">{e.actor}</span>
                <span class="fx-event-verb">{e.verb}</span>
                <span class="fx-event-target">{e.target}</span>
              </li>
            ))}
          </ul>
        </ship-card>
      </div>
    </section>

    <!-- Theme ------------------------------------------------------ -->
    <section class="fx site-container">
      <header class="fx-sec-head">
        <ship-badge tone="muted" variant="soft" size="sm">Theme</ship-badge>
        <h2>Restyle everything. Keep the semantics.</h2>
        <p class="fx-sec-sub">
          Sixteen canonical tokens. Eight built-in themes. Drop your
          own palette into a stylesheet, and every SHIP surface
          &mdash; the app, your extensions, third-party views &mdash;
          picks it up.
        </p>
      </header>

      <ship-card variant="outline" padding="lg" class="fx-theme">
        <div class="fx-theme-copy">
          <p>
            Open the picker in the nav. Or override
            <code>--primary</code>, <code>--accent</code>, and
            <code>--radius</code> in your own CSS and ship it as a
            theme for your whole team.
          </p>
        </div>
<pre class="fx-pre"><code><span class="s">:root[data-theme='our-brand']</span> <span class="k">&#123;</span>
  <span class="a">--primary</span>: <span class="v">oklch(0.66 0.18 190)</span>;
  <span class="a">--accent</span>:  <span class="v">oklch(0.72 0.14 60)</span>;
  <span class="a">--radius</span>:  <span class="v">14px</span>;
<span class="k">&#125;</span></code></pre>
      </ship-card>
    </section>

    <!-- CTA -------------------------------------------------------- -->
    <section class="fx-cta site-container">
      <ship-card variant="outline" padding="lg" class="fx-cta-card">
        <div class="fx-cta-copy">
          <h2>Ready to build on SHIP?</h2>
          <p>
            We&rsquo;re onboarding a small group of design-forward
            teams into the platform ahead of general availability.
            Bring your use case, we&rsquo;ll bring the SDK, the
            runtime, and the production reps.
          </p>
        </div>
        <ship-toolbar slot="footer" gap="md" justify="end">
          <ship-button
            variant="ghost"
            size="md"
            onclick="location.href='https://docs.getship.dev'"
          >Docs</ship-button>
          <ship-button
            tone="primary"
            variant="solid"
            size="md"
            onclick="location.href='mailto:sales@getship.dev'"
          >Email sales</ship-button>
        </ship-toolbar>
      </ship-card>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Register the page-scoped components — the pipeline DAG for the
  // pipelines section and the chart primitives for observability.
  // Everything else is static HTML so we're not loading tiptap /
  // markdown-it / highlighter stacks to render a handful of lines.
  import '@ship/ui/web-components/domain/ship-pipeline-dag';
  import '@ship/ui/web-components/domain/ship-pipeline-step';
  import '@ship/ui/web-components/charts/ship-sparkline';
  import '@ship/ui/web-components/charts/ship-gauge';

  // Tiny static tab switcher for the editors section. No ship-tabs
  // upgrade — not worth the bundle for four panels.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.fx-tab');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const activate = (id: string) => {
    tabs.forEach((t) => {
      t.setAttribute('aria-selected', t.dataset.tab === id ? 'true' : 'false');
    });
    panels.forEach((p) => {
      p.dataset.active = p.dataset.panel === id ? 'true' : 'false';
    });
  };
  tabs.forEach((t) => {
    t.addEventListener('click', () => {
      if (t.dataset.tab) activate(t.dataset.tab);
    });
  });
</script>

<style>
  .fx-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  /* Hero ---------------------------------------------------------- */
  .fx-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 52rem;
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .fx-hero h1 { font-size: clamp(40px, 6vw, 64px); }
  .fx-lede {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .fx-ctas { margin-top: 6px; }

  /* Section scaffolding ------------------------------------------ */
  .fx { padding: clamp(48px, 8vw, 96px) 0; }
  .fx-sec-head {
    max-width: 60ch;
    margin: 0 auto clamp(24px, 4vw, 40px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .fx-sec-head h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.022em;
  }
  .fx-sec-sub {
    color: var(--muted-foreground);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.55;
    max-width: 52ch;
  }
  .fx-sec-sub code,
  .fx-theme-copy code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--border) 30%, transparent);
    color: var(--foreground);
  }

  /* Views grid --------------------------------------------------- */
  .fx-views {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
    max-width: 1040px;
    margin-inline: auto;
  }
  .fx-view { display: block; }
  .fx-view-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .fx-view-blurb {
    color: var(--muted-foreground);
    font-size: 12.5px;
    margin-top: 4px;
    line-height: 1.5;
  }

  /* Editor tab card ---------------------------------------------- */
  .fx-editor {
    display: block;
    max-width: 960px;
    margin-inline: auto;
    overflow: hidden;
  }
  .fx-editor-tabs {
    display: flex;
    gap: 4px;
    padding: 10px 14px 0;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .fx-tab {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 8px 14px 10px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted-foreground);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
    margin-bottom: -1px;
  }
  .fx-tab:hover { color: var(--foreground); }
  .fx-tab[aria-selected='true'] {
    color: var(--foreground);
    border-bottom-color: var(--primary);
  }

  .fx-editor-body {
    display: none;
    padding: 18px 20px;
  }
  .fx-editor-body[data-active='true'] {
    display: block;
    animation: fx-fade 200ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  @keyframes fx-fade {
    0% { opacity: 0; transform: translateY(4px); }
    100% { opacity: 1; transform: none; }
  }

  .fx-pre {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    margin: 0;
    padding: 16px 18px;
    color: var(--foreground);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    border-radius: var(--radius-md);
    overflow: auto;
    tab-size: 2;
  }
  .fx-pre .k { color: var(--muted-foreground); }
  .fx-pre .s { color: var(--primary); }
  .fx-pre .v { color: oklch(0.60 0.16 150); }
  .fx-pre .a { color: oklch(0.60 0.14 240); }

  .fx-md h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.015em;
    margin-bottom: 10px;
  }
  .fx-md ul {
    list-style: disc;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--foreground);
  }
  .fx-md p {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted-foreground);
  }
  .fx-md a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .fx-md code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--border) 30%, transparent);
  }

  .fx-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .fx-table th,
  .fx-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .fx-table th {
    font-weight: 600;
    color: var(--muted-foreground);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .fx-table tr:last-child td { border-bottom: 0; }

  .fx-term pre {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    margin: 0;
    color: var(--foreground);
    background: color-mix(in oklch, var(--muted) 50%, transparent);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    overflow: auto;
  }
  .fx-term .fx-prompt  { color: var(--primary); font-weight: 600; margin-right: 4px; }
  .fx-term .fx-dim     { color: var(--muted-foreground); }
  .fx-term .fx-ok      { color: oklch(0.60 0.16 150); }
  .fx-term .fx-accent  { color: var(--primary); }

  /* Pipelines ---------------------------------------------------- */
  .fx-pipeline {
    max-width: 960px;
    margin-inline: auto;
    display: block;
    overflow-x: auto;
  }
  .fx-pipeline .arrow {
    color: var(--muted-foreground);
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    padding: 0 6px;
  }

  /* Capabilities ------------------------------------------------- */
  .fx-caps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
    max-width: 1040px;
    margin-inline: auto;
  }
  .fx-cap { display: block; }
  .fx-cap-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--foreground);
    margin-bottom: 6px;
  }
  .fx-cap-body {
    color: var(--muted-foreground);
    font-size: 13px;
    line-height: 1.55;
  }

  /* Observability ------------------------------------------------ */
  .fx-obs {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: 12px;
    max-width: 1040px;
    margin-inline: auto;
