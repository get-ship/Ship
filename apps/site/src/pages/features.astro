---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Features — written as a list, not eight hero sections. Each card
// is scannable in ~15 seconds. Icons are tone-tinted SVG badges so
// we don't load an icon library for a marketing page.
const features = [
  {
    tone: 'primary',
    kind: 'Smart skills',
    title: 'Skills with variables.',
    body: 'Parameterized capabilities — pass in your goal, your data, your tools. Scoped permissions, versioned, shareable. Ship the catalog or author your own.',
  },
  {
    tone: 'accent',
    kind: 'SHIP SDK',
    title: 'Custom views, no framework.',
    body: 'Build reactive apps inside your workspace with the same ship-* components the first-party app uses. No build step, no deploy.',
  },
  {
    tone: 'info',
    kind: 'Built-in views',
    title: 'Ten surfaces, day one.',
    body: 'Dashboard, chat, agents, pipelines, data, git, events, specs, canvas, settings — every one extensible with your own skills and collections.',
  },
  {
    tone: 'primary',
    kind: 'Pipelines',
    title: 'Any workflow, one file.',
    body: 'Steps can be a shell run, an agent call, a human or automated gate, a merge, or a nested pipeline. Scheduled, retried, capped, and audited.',
  },
  {
    tone: 'success',
    kind: 'Collections',
    title: 'Your data, any shape.',
    body: 'Define a schema, get forms, tables, filters, and SQL-pushdown queries for free. Read from any view, write from any agent.',
  },
  {
    tone: 'warning',
    kind: 'Integrations',
    title: 'MCP-native.',
    body: 'Any tool that speaks Model Context Protocol plugs in — IDEs, servers, agents from other vendors. Scoped to the skills that use them.',
  },
  {
    tone: 'accent',
    kind: 'Notifications',
    title: 'Keeps you in the loop.',
    body: 'Push, email, Slack, webhooks — your rules. Agents ping you when a long-running job finishes, not before.',
  },
  {
    tone: 'info',
    kind: 'Themes',
    title: 'Sixteen tokens, your brand.',
    body: 'Override a handful of CSS variables and every SHIP surface — the app, your extensions, third-party views — picks up your palette.',
  },
  {
    tone: 'success',
    kind: 'Local-first',
    title: 'On your machine, your keys.',
    body: 'Runs entirely on your laptop. No account required to start. Sync across devices and workspaces when you choose to.',
  },
  {
    tone: 'muted',
    kind: 'Observability',
    title: 'Every run, visible.',
    body: 'Charts, timelines, diffs, audit logs, per-agent cost — all first-class components you can drop into any view.',
  },
];
---

<BaseLayout title="SHIP features — the platform for AI-native apps">
  <Navbar />
  <main class="fx-page">

    <!-- Hero (retained — best descriptor) -------------------------- -->
    <header class="fx-hero site-container">
      <ship-badge tone="primary" variant="soft" size="sm">Build on SHIP</ship-badge>
      <h1>The platform for AI&#8209;native apps.</h1>
      <p class="fx-lede">
        SHIP isn&rsquo;t a library. It&rsquo;s a runtime, an SDK, a
        component system, and a governance layer &mdash; all designed
        so your team can ship AI features your users actually want to
        use. Start free on your laptop, talk to us when you&rsquo;re
        ready for a team or production.
      </p>
      <ship-toolbar gap="md" justify="start" class="fx-ctas">
        <ship-button
          tone="primary"
          variant="solid"
          size="lg"
          onclick="location.href='/download'"
        >Download SHIP</ship-button>
        <ship-button
          variant="ghost"
          size="lg"
          onclick="location.href='https://docs.getship.dev'"
        >Read the docs &rarr;</ship-button>
      </ship-toolbar>
    </header>

    <!-- Feature grid — the whole page -->
    <section class="fx-grid site-container" aria-label="Features">
      {features.map((f) => (
        <ship-card variant="outline" padding="lg" class="fx-card" data-tone={f.tone}>
          <div class="fx-card-head">
            <ship-badge tone={f.tone} variant="soft" size="sm">{f.kind}</ship-badge>
          </div>
          <h3 class="fx-card-title">{f.title}</h3>
          <p class="fx-card-body">{f.body}</p>
        </ship-card>
      ))}
    </section>

    <!-- CTA card (retained) ---------------------------------------- -->
    <section class="fx-cta site-container">
      <ship-card variant="outline" padding="lg" class="fx-cta-card">
        <div class="fx-cta-copy">
          <h2>Ready to build on SHIP?</h2>
          <p>
            We&rsquo;re onboarding a small group of design-forward
            teams ahead of general availability. Bring your use case,
            we&rsquo;ll bring the SDK, runtime, and production reps.
          </p>
        </div>
        <ship-toolbar slot="footer" gap="md" justify="end">
          <ship-button
            variant="ghost"
            size="md"
            onclick="location.href='https://docs.getship.dev'"
          >Docs</ship-button>
          <ship-button
            tone="primary"
            variant="solid"
            size="md"
            onclick="location.href='mailto:sales@getship.dev'"
          >Email sales</ship-button>
        </ship-toolbar>
      </ship-card>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .fx-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  /* Hero --------------------------------------------------------- */
  .fx-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 52rem;
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  .fx-hero h1 { font-size: clamp(40px, 6vw, 64px); }
  .fx-lede {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .fx-ctas { margin-top: 6px; }

  /* Feature grid ------------------------------------------------- */
  .fx-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .fx-card {
    display: block;
    position: relative;
    overflow: hidden;
    transition: transform var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .fx-card::before {
    /* Tone-tinted accent bar along the top edge. */
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--fx-tone, var(--primary));
    opacity: 0.7;
  }
  .fx-card[data-tone='primary']     { --fx-tone: var(--primary); }
  .fx-card[data-tone='accent']      { --fx-tone: var(--accent); }
  .fx-card[data-tone='info']        { --fx-tone: oklch(0.60 0.16 240); }
  .fx-card[data-tone='success']     { --fx-tone: oklch(0.58 0.15 150); }
  .fx-card[data-tone='warning']     { --fx-tone: oklch(0.64 0.16 60); }
  .fx-card[data-tone='muted']       { --fx-tone: color-mix(in oklch, var(--muted-foreground) 70%, transparent); }

  .fx-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--fx-tone, var(--primary)) 45%, transparent);
  }
  .fx-card-head {
    display: inline-flex;
    margin-bottom: 12px;
  }
  .fx-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.015em;
    color: var(--foreground);
    margin-bottom: 6px;
  }
  .fx-card-body {
    color: var(--muted-foreground);
    font-size: 13.5px;
    line-height: 1.55;
  }

  /* CTA --------------------------------------------------------- */
  .fx-cta { padding-top: clamp(24px, 4vw, 48px); }
  .fx-cta-card {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
  }
  .fx-cta-card h2 {
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .fx-cta-card p {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 15px;
    max-width: 54ch;
  }
</style>
