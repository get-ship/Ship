---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<script>
  import '../scripts/motion';
</script>

<BaseLayout title="SHIP features">
  <Navbar />
  <main class="fx">

    <!-- Hero ─────────────────────────────────────────────────────── -->
    <header class="fx-hero">
      <div class="container">
        <span class="fx-eyebrow">What's in the box</span>
        <h1>Everything you need to build your own AI app.</h1>
        <p class="fx-lede">
          SHIP is a runtime, an SDK, a component library, and a permission
          model. The full stack to compose your own AI app and use it
          every day. Free on your machine; paid sync if you want it
          across machines.
        </p>
        <div class="fx-ctas">
          <sui-button tone="primary" variant="solid" size="lg">
            <a href="/download" class="fx-link">Download SHIP</a>
          </sui-button>
          <sui-button variant="ghost" size="lg">
            <a href="https://docs.getship.dev" class="fx-link">Read the docs →</a>
          </sui-button>
        </div>
      </div>
    </header>

    <!-- 01 · Agents ─────────────────────────────────────────────── -->
    <section class="fx-section stage" id="agents" data-reveal>
      <div class="container fx-grid">
        <div class="fx-copy">
          <div class="fx-kicker" data-reveal-child>01 · Agents</div>
          <h2 data-reveal-child>One config. Every provider.</h2>
          <p data-reveal-child>
            An agent is one file: model preference, skills, MCP servers,
            permissions. Ship compiles that file to provider-specific
            manifests so swapping models doesn't mean rewriting agents.
          </p>
          <ul class="fx-points" data-reveal-child>
            <li><b>Provider-agnostic.</b> Same agent runs on Claude, Codex, Gemini, or Cursor.</li>
            <li><b>Scoped permissions.</b> Filesystem, shell, and network access is explicit per agent.</li>
            <li><b>Local dispatch.</b> Dispatched and observed entirely on your machine.</li>
          </ul>
        </div>
        <aside class="fx-card spotlight" data-reveal-child>
          <div class="fx-card-head">
            <span class="fx-card-mono"><b>rust-lane</b> · agent</span>
            <span class="fx-card-tag">ready</span>
          </div>
          <dl class="fx-spec">
            <dt>model</dt><dd>claude · opus</dd>
            <dt>compiles to</dt><dd>claude · codex · gemini · cursor</dd>
            <dt>skills</dt><dd>cargo · git · rustfmt · clippy</dd>
            <dt>mcp</dt><dd>fs-scoped · shell-allowlist</dd>
            <dt>perms</dt>
            <dd>
              write · packages/compiler<br/>
              ask · network
            </dd>
          </dl>
        </aside>
      </div>
    </section>

    <!-- 02 · Skills ─────────────────────────────────────────────── -->
    <section class="fx-section stage fx-flip" id="skills" data-reveal>
      <div class="container fx-grid">
        <div class="fx-copy">
          <div class="fx-kicker" data-reveal-child>02 · Skills</div>
          <h2 data-reveal-child>Standard files. Drop in. Done.</h2>
          <p data-reveal-child>
            Skills are small folders — a prompt, the tools they can touch,
            a permission scope, optional UI. Bring the skills you already
            use; author your own in an afternoon.
          </p>
          <ul class="fx-points" data-reveal-child>
            <li><b>Standard format.</b> Same shape your CLI already speaks.</li>
            <li><b>Drop-in install.</b> Move the folder into <code>.ship/skills/</code>; agents pick it up on next dispatch.</li>
            <li><b>Composable.</b> Any agent can use any skill; permissions intersect.</li>
          </ul>
        </div>
        <aside class="fx-card spotlight" data-reveal-child>
          <div class="fx-card-head">
            <span class="fx-card-mono"><b>.ship/skills/</b></span>
            <span class="fx-card-tag">3 installed</span>
          </div>
          <ul class="fx-tree">
            <li class="fx-tree-d">code-review/
              <ul>
                <li>prompt.md</li>
                <li>tools.json</li>
                <li>perms.json</li>
              </ul>
            </li>
            <li class="fx-tree-d">inbox-triage/
              <ul><li>prompt.md</li><li>tools.json</li></ul>
            </li>
            <li class="fx-tree-d">digest-writer/
              <ul><li>prompt.md</li><li>view.j2</li></ul>
            </li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- 03 · Collections & Artifacts ────────────────────────────── -->
    <section class="fx-section stage" id="data" data-reveal>
      <div class="container fx-grid">
        <div class="fx-copy">
          <div class="fx-kicker" data-reveal-child>03 · Collections &amp; Artifacts</div>
          <h2 data-reveal-child>Your data, indexed everywhere.</h2>
          <p data-reveal-child>
            Collections are your structured data — define the shape, Ship
            maintains schema and indexes. Artifacts are whatever your
            agents produce. Both addressable, both flow through every
            view and skill.
          </p>
          <ul class="fx-points" data-reveal-child>
            <li><b>Schema-managed.</b> Define types, refs, enums, indexes; Ship handles migrations.</li>
            <li><b>Reactive.</b> Write to a collection, views update. Produce an artifact, downstream skills wake up.</li>
            <li><b>Local-first.</b> SQLite on disk. Yours.</li>
          </ul>
        </div>
        <aside class="fx-card spotlight" data-reveal-child>
          <div class="fx-card-head">
            <span class="fx-card-mono"><b>runs</b> · collection</span>
            <span class="fx-card-tag">8 fields · 3 indexes</span>
          </div>
          <table class="fx-schema">
            <tbody>
              <tr><td class="k">id</td>        <td class="t">uuid</td>             <td class="f f-pk">pk</td></tr>
              <tr><td class="k">agent</td>     <td class="t">ref → agents</td>     <td class="f">idx</td></tr>
              <tr><td class="k">status</td>    <td class="t">enum</td>             <td class="f">idx</td></tr>
              <tr><td class="k">started_at</td><td class="t">datetime</td>         <td class="f">idx</td></tr>
              <tr><td class="k">artifact</td>  <td class="t">ref → artifacts?</td> <td class="f">·</td></tr>
              <tr><td class="k">duration_ms</td><td class="t">integer</td>          <td class="f">·</td></tr>
            </tbody>
          </table>
        </aside>
      </div>
    </section>

    <!-- 04 · Views ──────────────────────────────────────────────── -->
    <section class="fx-section stage fx-flip" id="views" data-reveal>
      <div class="container fx-grid">
        <div class="fx-copy">
          <div class="fx-kicker" data-reveal-child>04 · Views</div>
          <h2 data-reveal-child>Apps that look like apps.</h2>
          <p data-reveal-child>
            Custom web components for everything you'll render, paired
            with a reactive SDK wired to every runtime signal. Save the
            file; the app updates.
          </p>
          <ul class="fx-points" data-reveal-child>
            <li><b>Component library.</b> Stats, sparklines, tables, chat streams, artifact viewers, inbox lists, form builders.</li>
            <li><b>Reactive SDK.</b> Subscribe to any agent, session, collection row, or artifact.</li>
            <li><b>Theme-aware.</b> Every component respects the active theme.</li>
            <li><b>Hot reload.</b> Save the file. The view updates. No build step.</li>
          </ul>
        </div>
        <aside class="fx-card spotlight" data-reveal-child>
          <div class="fx-card-head">
            <span class="fx-card-mono"><b>today.view</b> · 17 lines</span>
            <span class="fx-card-tag">live</span>
          </div>
          <div class="fx-view">
            <div class="fx-view-kpis">
              <div class="fx-view-kpi"><div class="lbl">runs / wk</div><div class="val"><span data-counter data-counter-to="128">0</span></div></div>
              <div class="fx-view-kpi"><div class="lbl">on budget</div><div class="val"><span data-counter data-counter-to="94" data-counter-suffix="%">0</span></div></div>
              <div class="fx-view-kpi"><div class="lbl">agents</div><div class="val"><span data-counter data-counter-to="8">0</span></div></div>
            </div>
            <div class="fx-view-bars" aria-hidden="true">
              <span style="--h:35%"></span><span style="--h:55%"></span>
              <span style="--h:48%"></span><span style="--h:72%"></span>
              <span style="--h:65%"></span><span style="--h:88%"></span>
              <span style="--h:78%"></span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- 05 · Integrations ──────────────────────────────────────── -->
    <section class="fx-section stage" id="integrations" data-reveal>
      <div class="container fx-grid">
        <div class="fx-copy">
          <div class="fx-kicker" data-reveal-child>05 · Integrations</div>
          <h2 data-reveal-child>MCP-native. Your keys.</h2>
          <p data-reveal-child>
            Every tool that speaks Model Context Protocol plugs straight
            in. Runs on your machine. No account required.
          </p>
          <ul class="fx-points" data-reveal-child>
            <li><b>MCP-native.</b> Drop in any MCP server; agents discover its tools automatically.</li>
            <li><b>Your model, your keys.</b> Talk to providers directly. No SHIP-managed inference.</li>
            <li><b>Local-first.</b> No account required to run anything.</li>
          </ul>
        </div>
        <aside class="fx-card spotlight" data-reveal-child>
          <div class="fx-card-head">
            <span class="fx-card-mono"><b>mcp servers</b></span>
            <span class="fx-card-tag">4 connected</span>
          </div>
          <ul class="fx-list">
            <li><span class="dot ok"></span><b>github</b><span class="v">v3.1.2</span></li>
            <li><span class="dot ok"></span><b>linear</b><span class="v">v2.0.0</span></li>
            <li><span class="dot ok"></span><b>postgres</b><span class="v">v1.4.0</span></li>
            <li><span class="dot ok"></span><b>fs-scoped</b><span class="v">built-in</span></li>
            <li><span class="dot off"></span><b>slack</b><span class="v">not connected</span></li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- CTA ─────────────────────────────────────────────────────── -->
    <section class="fx-cta">
      <div class="container">
        <h2>Run it locally.</h2>
        <p>Pull SHIP, open the docs alongside, wire your first skill.</p>
        <div class="fx-ctas">
          <sui-button tone="primary" variant="solid" size="lg">
            <a href="/download" class="fx-link">Download SHIP</a>
          </sui-button>
          <sui-button variant="ghost" size="lg">
            <a href="https://docs.getship.dev" class="fx-link">Read the docs</a>
          </sui-button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .fx { padding-bottom: clamp(64px, 8vw, 96px); }
  .container { max-width: 1180px; margin-inline: auto; padding-inline: 40px; }
  @media (max-width: 720px) { .container { padding-inline: 20px; } }
  .fx-link { color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }

  /* Hero ────────────────────────────────────────────────────────── */
  .fx-hero {
    padding: clamp(56px, 7vw, 96px) 0 clamp(40px, 5vw, 64px);
  }
  .fx-eyebrow {
    display: inline-block;
    padding: 6px 12px; border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--primary);
    border: 1px solid color-mix(in oklab, var(--primary) 25%, transparent);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .fx-hero h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02; letter-spacing: -0.035em;
    color: var(--page-fg); margin: 28px 0 0; max-width: 18ch;
  }
  .fx-lede {
    margin: 24px 0 0;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.55; color: var(--muted-ink);
    max-width: 56ch;
  }
  .fx-ctas {
    display: flex; flex-wrap: wrap; gap: 12px;
    margin-top: 32px;
  }

  /* Section pattern ───────────────────────────────────────────── */
  .fx-section {
    position: relative;
    padding: clamp(56px, 8vw, 112px) 0;
    border-top: 1px solid var(--rail);
  }
  .fx-section:nth-child(even) {
    background: color-mix(in oklab, var(--plate) 35%, transparent);
  }
  .fx-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .fx-flip .fx-grid { direction: rtl; }
  .fx-flip .fx-grid > * { direction: ltr; }
  @media (max-width: 880px) {
    .fx-grid { grid-template-columns: 1fr; gap: 36px; }
    .fx-flip .fx-grid { direction: ltr; }
  }

  .fx-copy { min-width: 0; }
  .fx-kicker {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--subtle-ink);
    margin-bottom: 14px;
  }
  .fx-copy h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.02; letter-spacing: -0.03em;
    color: var(--page-fg); margin: 0;
    max-width: 14ch;
  }
  .fx-copy > p {
    margin: 22px 0 0;
    font-size: 16px; line-height: 1.6;
    color: var(--muted-ink); max-width: 54ch;
  }
  .fx-points {
    list-style: none; padding: 0; margin: 28px 0 0;
    display: flex; flex-direction: column; gap: 14px;
  }
  .fx-points li {
    font-size: 14.5px; line-height: 1.55; color: var(--muted-ink);
    padding-left: 18px; position: relative;
  }
  .fx-points li::before {
    content: ""; position: absolute; left: 0; top: 9px;
    width: 6px; height: 6px; border-radius: 50%;
    background: color-mix(in oklab, var(--primary) 80%, var(--page-fg));
  }
  .fx-points li b { color: var(--page-fg); font-weight: 600; }
  .fx-points li code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.92em; color: var(--primary);
    background: color-mix(in oklab, var(--primary) 10%, transparent);
    padding: 1px 5px; border-radius: 4px;
  }

  /* Spec card ─────────────────────────────────────────────────── */
  .fx-card {
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 16px;
    box-shadow: var(--shadow-plate);
    overflow: hidden;
    transition: transform 280ms var(--ease-out, ease-out), border-color 280ms ease, box-shadow 280ms ease;
  }
  .fx-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--primary) 35%, var(--plate-border));
    box-shadow: 0 12px 32px color-mix(in oklab, var(--page-fg) 12%, transparent);
  }
  .fx-card-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 14px 18px;
    border-bottom: 1px solid var(--plate-line);
  }
  .fx-card-mono {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px; color: var(--plate-sub);
  }
  .fx-card-mono b { color: var(--plate-ink); font-weight: 600; }
  .fx-card-tag {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 3px 8px; border-radius: 999px;
    background: color-mix(in oklab, var(--success) 14%, transparent);
    color: var(--success);
  }

  /* Spec list (agents) ───────────────────────────────────────── */
  .fx-spec {
    margin: 0; padding: 18px 20px;
    display: grid; grid-template-columns: max-content 1fr;
    column-gap: 24px; row-gap: 14px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
  }
  .fx-spec dt {
    color: var(--subtle-ink);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 10px; font-weight: 600;
    padding-top: 2px;
  }
  .fx-spec dd {
    margin: 0; color: var(--page-fg);
    line-height: 1.6;
  }

  /* File tree (skills) ───────────────────────────────────────── */
  .fx-tree {
    margin: 0; padding: 18px 20px 18px 24px;
    list-style: none;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12.5px;
    color: var(--plate-muted);
  }
  .fx-tree ul {
    list-style: none; padding: 0; margin: 4px 0 0 16px;
    border-left: 1px dashed var(--plate-line);
  }
  .fx-tree ul li {
    padding: 3px 0 3px 14px;
    position: relative;
  }
  .fx-tree ul li::before {
    content: ""; position: absolute; left: 0; top: 12px;
    width: 10px; height: 1px; background: var(--plate-line);
  }
  .fx-tree-d { font-weight: 600; color: var(--page-fg); margin-top: 8px; }
  .fx-tree-d:first-child { margin-top: 0; }

  /* Schema table (collections) ──────────────────────────────── */
  .fx-schema {
    width: 100%;
    border-collapse: collapse;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
  }
  .fx-schema td {
    padding: 10px 16px;
    border-top: 1px solid var(--plate-line);
  }
  .fx-schema tr:first-child td { border-top: none; }
  .fx-schema .k { color: var(--page-fg); font-weight: 500; }
  .fx-schema .t { color: var(--accent); }
  .fx-schema .f {
    text-align: right;
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .fx-schema .f-pk {
    color: var(--primary); font-weight: 600;
  }

  /* View mini (views) ───────────────────────────────────────── */
  .fx-view {
    padding: 20px;
    display: flex; flex-direction: column; gap: 18px;
  }
  .fx-view-kpis {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
  }
  .fx-view-kpi {
    padding: 12px;
    border: 1px solid var(--plate-line); border-radius: 10px;
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
  }
  .fx-view-kpi .lbl {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .fx-view-kpi .val {
    font-family: var(--font-display); font-weight: 600;
    font-size: 22px; color: var(--page-fg); margin-top: 4px;
  }
  .fx-view-bars {
    display: flex; gap: 6px; align-items: flex-end;
    height: 60px; padding: 0 4px;
  }
  .fx-view-bars span {
    flex: 1;
    height: 0;
    background: linear-gradient(to top, var(--primary), color-mix(in oklab, var(--accent) 60%, var(--primary)));
    border-radius: 3px;
    opacity: 0.85;
    transition: height 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--idx, 0) * 60ms);
  }
  .fx-view-bars.is-revealed span { height: var(--h); }
  .fx-view-bars span:nth-child(1) { --idx: 0; }
  .fx-view-bars span:nth-child(2) { --idx: 1; }
  .fx-view-bars span:nth-child(3) { --idx: 2; }
  .fx-view-bars span:nth-child(4) { --idx: 3; }
  .fx-view-bars span:nth-child(5) { --idx: 4; }
  .fx-view-bars span:nth-child(6) { --idx: 5; }
  .fx-view-bars span:nth-child(7) { --idx: 6; }

  /* Status list (integrations) ──────────────────────────────── */
  .fx-list {
    margin: 0; padding: 8px 20px 8px;
    list-style: none;
  }
  .fx-list li {
    display: grid; grid-template-columns: 12px 1fr auto;
    gap: 12px; align-items: center;
    padding: 11px 0;
    border-top: 1px solid var(--plate-line);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12.5px;
  }
  .fx-list li:first-child { border-top: none; }
  .fx-list b { color: var(--page-fg); font-weight: 500; }
  .fx-list .v { color: var(--subtle-ink); font-size: 11px; }
  .fx-list .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--plate-sub);
  }
  .fx-list .dot.ok { background: var(--success); }
  .fx-list .dot.off { background: var(--plate-sub); opacity: 0.55; }

  /* CTA ────────────────────────────────────────────────────────── */
  .fx-cta {
    padding: clamp(64px, 9vw, 128px) 0 0;
    text-align: center;
  }
  .fx-cta h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(32px, 4.5vw, 48px); letter-spacing: -0.03em;
    color: var(--page-fg); margin: 0;
  }
  .fx-cta p {
    margin: 16px 0 0; font-size: 16px; color: var(--muted-ink);
  }
  .fx-cta .fx-ctas { justify-content: center; }
</style>
