---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Five features, each substantial. Each card has a tone, a kicker,
// a paragraph of real content, and a technical tag line underneath.
const features = [
  {
    tone: 'primary',
    kind: 'Skills',
    title: 'Parameterized capabilities for every agent.',
    body: 'Skills are small files — a prompt, the tools they can touch, a permission scope, optional UI. Hand one to any agent and watch it work. Compose them into pipelines. Author your own in an afternoon and share them across workspaces.',
    tag: '.ship/skills/*',
  },
  {
    tone: 'accent',
    kind: 'Views',
    title: 'Reactive apps inside your workspace.',
    body: 'Build a dashboard, a tracker, a lens over your data with the same ship-* components the first-party app uses. Jinja templates, Datastar for reactivity, no build step, no deploy. Drop a new view file into a folder and refresh — your app is live.',
    tag: '.ship/views/*',
  },
  {
    tone: 'info',
    kind: 'Pipelines',
    title: 'Any workflow, one file, audited.',
    body: 'Steps can be a shell command, an agent call, a human gate, a merge, or a nested pipeline. SHIP schedules, retries, caps cost per run, and keeps the full audit trail. Drop into a branch, run locally, promote to scheduled.',
    tag: 'ship run <name>',
  },
  {
    tone: 'success',
    kind: 'Collections',
    title: 'Your data, any shape, instantly usable.',
    body: 'Define a schema and SHIP hands you forms, tables, filters, and SQL-pushdown queries. Any agent can read, any view can render, any skill can write. Your collections are first-class citizens of every surface in the app.',
    tag: 'collections/*',
  },
  {
    tone: 'warning',
    kind: 'Integrations',
    title: 'MCP-native. Local-first. Your keys.',
    body: 'Every tool that speaks Model Context Protocol plugs straight in. Notifications route agent output back to where you already work — push, email, chat, webhooks, your rules. Runs entirely on your machine, no account required.',
    tag: 'local-first · BYO keys',
  },
];
---

<BaseLayout title="SHIP features — the platform for AI-native apps">
  <Navbar />
  <main class="fx-page">

    <!-- Hero (retained — best descriptor) -------------------------- -->
    <header class="fx-hero site-container">
      <ship-badge tone="primary" variant="soft" size="sm">Build on SHIP</ship-badge>
      <h1>The platform for AI&#8209;native apps.</h1>
      <p class="fx-lede">
        SHIP isn&rsquo;t a library. It&rsquo;s a runtime, an SDK, a
        component system, and a governance layer &mdash; all designed
        so your team can ship AI features your users actually want to
        use. Start free on your laptop, talk to us when you&rsquo;re
        ready for a team or production.
      </p>
      <ship-toolbar gap="md" justify="start" class="fx-ctas">
        <ship-button
          tone="primary"
          variant="solid"
          size="lg"
          onclick="location.href='/download'"
        >Download SHIP</ship-button>
        <ship-button
          variant="ghost"
          size="lg"
          onclick="location.href='https://docs.getship.dev'"
        >Read the docs &rarr;</ship-button>
      </ship-toolbar>
    </header>

    <!-- Feature stack — five cards with real content -->
    <section class="fx-stack site-container" aria-label="Features">
      {features.map((f, i) => (
        <ship-card variant="outline" padding="lg" class="fx-card" data-tone={f.tone}>
          <div class="fx-card-rail" aria-hidden="true">
            <span class="fx-card-num">{String(i + 1).padStart(2, '0')}</span>
            <ship-badge tone={f.tone} variant="soft" size="sm">{f.kind}</ship-badge>
          </div>
          <div class="fx-card-body-wrap">
            <h3 class="fx-card-title">{f.title}</h3>
            <p class="fx-card-body">{f.body}</p>
            <code class="fx-card-tag">{f.tag}</code>
          </div>
        </ship-card>
      ))}
    </section>

    <!-- CTA card -------------------------------------------------- -->
    <section class="fx-cta site-container">
      <ship-card variant="outline" padding="lg" class="fx-cta-card">
        <div class="fx-cta-copy">
          <h2>Install it. See for yourself.</h2>
          <p>
            Everything above runs on your laptop the moment the
            installer lands. Leave your email for the release, or jump
            straight into the docs and start wiring up your own
            skills, views, and pipelines.
          </p>
        </div>
        <ship-toolbar slot="footer" gap="md" justify="end">
          <ship-button
            variant="ghost"
            size="md"
            onclick="location.href='https://docs.getship.dev'"
          >Read the docs</ship-button>
          <ship-button
            tone="primary"
            variant="solid"
            size="md"
            onclick="location.href='/download'"
          >Download SHIP</ship-button>
        </ship-toolbar>
      </ship-card>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .fx-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  /* Hero --------------------------------------------------------- */
  .fx-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 52rem;
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  .fx-hero h1 { font-size: clamp(40px, 6vw, 64px); }
  .fx-lede {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .fx-ctas { margin-top: 6px; }

  /* Feature stack ------------------------------------------------ */
  .fx-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: clamp(40px, 6vw, 80px);
    max-width: 960px;
    margin-inline: auto;
  }
  .fx-card {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    position: relative;
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  @media (max-width: 640px) {
    .fx-card { grid-template-columns: 1fr; gap: 12px; }
  }
  .fx-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--fx-tone, var(--primary));
  }
  .fx-card[data-tone='primary']  { --fx-tone: var(--primary); }
  .fx-card[data-tone='accent']   { --fx-tone: var(--accent); }
  .fx-card[data-tone='info']     { --fx-tone: oklch(0.60 0.16 240); }
  .fx-card[data-tone='success']  { --fx-tone: oklch(0.58 0.15 150); }
  .fx-card[data-tone='warning']  { --fx-tone: oklch(0.64 0.16 60); }
  .fx-card:hover {
    border-color: color-mix(in oklch, var(--fx-tone, var(--primary)) 45%, transparent);
  }

  .fx-card-rail {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .fx-card-num {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 11px;
    color: var(--muted-foreground);
    letter-spacing: 0.1em;
  }
  .fx-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2.3vw, 26px);
    letter-spacing: -0.018em;
    color: var(--foreground);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .fx-card-body {
    color: var(--muted-foreground);
    font-size: 14.5px;
    line-height: 1.6;
    margin-bottom: 14px;
    max-width: 62ch;
  }
  .fx-card-tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: color-mix(in oklch, var(--fx-tone, var(--primary)) 75%, var(--foreground));
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--fx-tone, var(--primary)) 10%, transparent);
    display: inline-block;
  }

  /* CTA --------------------------------------------------------- */
  .fx-cta { padding-top: clamp(24px, 4vw, 48px); }
  .fx-cta-card {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
  }
  .fx-cta-card h2 {
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .fx-cta-card p {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 15px;
    max-width: 54ch;
  }
</style>
