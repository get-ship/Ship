---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const SHOW_PRICING = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_PRICING === 'true';
if (!SHOW_PRICING) return Astro.redirect('/');

const tiers = [
  {
    id: 'local',
    name: 'Local',
    price: 'Free',
    cadence: 'forever',
    blurb: 'Runs on your machine. Bring your own keys. No account required.',
    features: [
      'Unlimited agents, skills, views, collections',
      'Every model harness that speaks MCP',
      'Local-first storage — your data, your machine',
      'Community support',
    ],
    cta: { label: 'Download SHIP', kind: 'link' as const, href: '/download' },
  },
  {
    id: 'pro',
    name: 'Pro',
    price: '$20',
    cadence: 'per month',
    highlight: true,
    blurb: 'Sync your account across every machine you install SHIP on.',
    features: [
      'Everything in Local',
      'Cross-device sync for workspaces and themes',
      'Skill library follows you to every install',
      'Cancel anytime — your local Ship keeps working',
    ],
    cta: { label: 'Start with Pro', kind: 'upgrade' as const, plan: 'pro' as const },
  },
];
---

<BaseLayout title="SHIP pricing — free locally, paid where it earns it">
  <Navbar />
  <main class="pricing-page">
    <header class="pricing-hero site-container">
      <sui-badge tone="muted" variant="soft" size="sm">Pricing</sui-badge>
      <h1>Free locally. $20 a month when you want sync.</h1>
      <p class="pricing-lede">
        SHIP runs free on your machine, forever. Sync lets your themes,
        skills, and workspaces follow you to every machine you sign in on.
      </p>
    </header>

    <section class="pricing-grid site-container" aria-label="Plans">
      {tiers.map((t) => (
        <article class={`tier ${t.highlight ? 'tier-highlight' : ''}`}>
          {t.highlight && <div class="tier-ribbon">Sync your install</div>}
          <header class="tier-head">
            <h2 class="tier-name">{t.name}</h2>
            <div class="tier-price">
              <span class="tier-price-amount">{t.price}</span>
              <span class="tier-price-cadence">{t.cadence}</span>
            </div>
            <p class="tier-blurb">{t.blurb}</p>
          </header>
          <ul class="tier-features">
            {t.features.map((f) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <footer class="tier-cta">
            {t.cta.kind === 'link' ? (
              <sui-button tone="primary" variant={t.highlight ? 'solid' : 'outline'} size="md">
                <a href={t.cta.href} class="tier-cta-link">{t.cta.label}</a>
              </sui-button>
            ) : (
              <sui-button tone="primary" variant="solid" size="md" type="button" data-upgrade-plan={t.cta.plan}>
                <span data-upgrade-label>{t.cta.label}</span>
              </sui-button>
            )}
          </footer>
        </article>
      ))}
    </section>

    <section class="pricing-faq site-container">
      <h2>Common questions</h2>
      <dl>
        <dt>Is Local really free forever?</dt>
        <dd>Yes. SHIP runs on your machine using your own model API keys. We charge for sync — not for the runtime.</dd>
        <dt>What does Pro give me?</dt>
        <dd>Your Ship install follows you. Sign in on a second machine and your themes, skills, and workspaces are there.</dd>
        <dt>Can I cancel anytime?</dt>
        <dd>Yes. Cancellations take effect at the end of your billing period. After that your local Ship keeps working — you just lose sync.</dd>
        <dt>How is tax handled?</dt>
        <dd>VAT, GST, and sales tax are calculated at checkout based on your billing address. EU businesses with a VAT ID get reverse-charge handling automatically.</dd>
      </dl>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { getSession, startUpgrade } from '../lib/auth';

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-upgrade-plan]')) {
    btn.addEventListener('click', async () => {
      const plan = btn.dataset.upgradePlan as 'pro' | undefined;
      if (!plan) return;
      const label = btn.querySelector<HTMLElement>('[data-upgrade-label]');
      const baseLabel = label?.textContent ?? 'Continue';
      btn.setAttribute('disabled', '');
      if (label) label.textContent = 'One moment…';

      const session = await getSession();
      if (!session) {
        // Anon visitor — bounce through sign-up; the AuthPage already
        // honors ?plan and routes to /billing?upgrade=pro after auth.
        location.href = `/sign-up?plan=${plan}`;
        return;
      }
      try {
        // authClient.subscription.upgrade redirects the browser to Stripe
        // Checkout when it returns a session URL. If disableRedirect is set
        // we'd need to handle the URL ourselves; default is to follow.
        await startUpgrade(plan);
      } catch (err) {
        console.error('upgrade failed', err);
        btn.removeAttribute('disabled');
        if (label) label.textContent = baseLabel;
        alert('Could not start checkout. Please try again or contact support.');
      }
    });
  }
</script>

<style>
  .pricing-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  .pricing-hero {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 18px; max-width: 60rem;
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  .pricing-hero h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02; letter-spacing: -0.025em;
    color: var(--page-fg); margin: 0;
  }
  .pricing-lede {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.55; color: var(--muted-ink);
    max-width: 56ch;
  }

  .pricing-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 24px; align-items: stretch;
    max-width: 820px; margin-inline: auto;
  }
  @media (max-width: 720px) { .pricing-grid { grid-template-columns: 1fr; } }

  .tier {
    position: relative;
    display: flex; flex-direction: column;
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 18px;
    padding: 28px 24px;
    box-shadow: var(--shadow-plate);
  }
  .tier-highlight {
    border-color: color-mix(in oklab, var(--primary) 50%, var(--plate-border));
    box-shadow:
      var(--shadow-plate),
      0 0 0 1px color-mix(in oklab, var(--primary) 25%, transparent);
  }
  .tier-ribbon {
    position: absolute; top: -10px; left: 24px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px;
    background: var(--primary); color: var(--page-bg);
  }
  .tier-head { display: flex; flex-direction: column; gap: 10px; }
  .tier-name {
    font-family: var(--font-display); font-weight: 600;
    font-size: 22px; letter-spacing: -0.02em;
    color: var(--page-fg); margin: 0;
  }
  .tier-price {
    display: flex; align-items: baseline; gap: 8px;
  }
  .tier-price-amount {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(32px, 4vw, 40px);
    letter-spacing: -0.02em; color: var(--page-fg);
  }
  .tier-price-cadence {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px; color: var(--subtle-ink);
    letter-spacing: 0.04em;
  }
  .tier-blurb {
    font-size: 14px; line-height: 1.5;
    color: var(--muted-ink); margin: 0;
  }
  .tier-features {
    list-style: none; padding: 0; margin: 20px 0 24px;
    display: flex; flex-direction: column; gap: 10px;
    flex: 1;
  }
  .tier-features li {
    display: grid; grid-template-columns: 14px 1fr; gap: 10px;
    font-size: 13.5px; line-height: 1.5;
    color: var(--muted-ink); align-items: start;
  }
  .tier-features svg {
    color: color-mix(in oklab, var(--primary) 90%, var(--page-fg));
    margin-top: 4px;
  }
  .tier-cta { margin-top: auto; }
  .tier-cta-link {
    color: inherit; text-decoration: none;
    display: inline-flex; align-items: center;
  }

  .pricing-faq {
    margin-top: clamp(48px, 8vw, 96px);
    max-width: 760px;
  }
  .pricing-faq h2 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(22px, 2.5vw, 28px);
    letter-spacing: -0.02em; color: var(--page-fg);
    margin: 0 0 24px;
  }
  .pricing-faq dl {
    display: flex; flex-direction: column; gap: 20px;
    margin: 0;
  }
  .pricing-faq dt {
    font-weight: 600; color: var(--page-fg);
    font-size: 15px; margin-bottom: 6px;
  }
  .pricing-faq dd {
    margin: 0; color: var(--muted-ink);
    font-size: 14px; line-height: 1.6;
  }
</style>
