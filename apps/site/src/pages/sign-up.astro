---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AuthPage from '../components/AuthPage.astro';

const SHOW_AUTH = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_AUTH === 'true';
if (!SHOW_AUTH) return Astro.redirect('/waitlist?reason=signup');
---

<BaseLayout title="Create your account — SHIP">
  <Navbar />
  <main id="main">
    <AuthPage mode="sign-up" />
  </main>
  <Footer />
</BaseLayout>
