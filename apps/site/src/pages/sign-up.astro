---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal.astro';
---

<BaseLayout title="Create your account — Ship" ownAuthModal>
  <Navbar />
  <main class="auth-page">
    <div class="site-container auth-intro">
      <h1>Start shipping with AI.</h1>
      <p class="site-muted">
        Install Ship, pick your models, and deploy your first view in an
        afternoon. Free for solo projects; paid plans unlock team sync
        and governance.
      </p>
    </div>
  </main>
  <Footer />
  <AuthModal mode="sign-up" autoOpen />
</BaseLayout>

<style>
  .auth-page {
    padding: clamp(72px, 10vw, 128px) 0;
    min-height: 60vh;
  }
  .auth-intro {
    text-align: center;
    max-width: 52ch;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
</style>
