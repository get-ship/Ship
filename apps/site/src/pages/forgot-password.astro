---
import RoomLayout from '../layouts/RoomLayout.astro';
---
<RoomLayout title="Reset your password — SHIP">
  <div class="room-card">
    <a href="/" class="room-brand" aria-label="SHIP home"><img src="/ship-logo.svg" alt="" /></a>
    <h1 class="room-title">Reset your password.</h1>
    <p class="room-lede">Enter the email tied to your account and we'll send a link to set a new password.</p>
    <form class="room-form" data-forgot-form novalidate>
      <label class="room-field">
        <span>Email</span>
        <input class="room-input" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
      </label>
      <div class="room-msg err" data-error role="alert" hidden></div>
      <button tone="primary" size="lg" type="submit"><span data-submit-label>Send reset link</span></button>
      <div class="room-msg ok" data-success role="status" hidden>
        If an account exists for that address, a reset link is on its way. Check your inbox.
      </div>
    </form>
    <div class="room-switch">Remembered it? <a href="/login">Sign in</a></div>
  </div>
</RoomLayout>

<script>
  import { requestPasswordReset } from '../lib/auth';
  const form = document.querySelector<HTMLFormElement>('[data-forgot-form]');
  const errEl = document.querySelector<HTMLElement>('[data-error]');
  const okEl = document.querySelector<HTMLElement>('[data-success]');
  const label = document.querySelector<HTMLElement>('[data-submit-label]');
  const baseLabel = label?.textContent ?? 'Send reset link';
  function setBusy(busy: boolean) {
    if (!form) return;
    for (const el of form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input')) el.disabled = busy;
    if (label) label.textContent = busy ? 'Sending…' : baseLabel;
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = String(new FormData(form).get('email') ?? '').trim();
    if (!email) return;
    if (errEl) { errEl.hidden = true; errEl.textContent = ''; }
    if (okEl) okEl.hidden = true;
    setBusy(true);
    const res = await requestPasswordReset(email);
    setBusy(false);
    if (!res.ok) { if (errEl) { errEl.hidden = false; errEl.textContent = res.error; } return; }
    if (okEl) okEl.hidden = false;
    form.reset();
  });
</script>
