---
import RoomLayout from '../layouts/RoomLayout.astro';
---
<RoomLayout title="Lost in space — SHIP">
  <div class="room-card">
    <div class="room-eyebrow">404 · Not found</div>
    <h1 class="room-title">Lost in <span class="accent">space.</span></h1>
    <p class="room-lede">That page drifted off into the void. It moved, it never existed, or the URL slipped a thruster. Here's the way back.</p>
    <div class="room-actions">
      <sui-button tone="primary" size="lg"><a href="/">Back to the desktop</a></sui-button>
      <sui-button variant="ghost" size="lg"><a href="https://docs.getship.dev">Read the docs</a></sui-button>
    </div>
  </div>
</RoomLayout>
