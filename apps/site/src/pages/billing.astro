---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AccountShell from '../components/AccountShell.astro';
import AccountSection from '../components/AccountSection.astro';

const SHOW_BILLING = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_BILLING === 'true';
if (!SHOW_BILLING) return Astro.redirect('/');
---

<BaseLayout title="Billing — SHIP">
  <Navbar />
  <main id="main">
    <AccountShell active="billing" title="Billing">

      <div class="success-banner" data-success-banner hidden>
        <span class="success-banner-dot"></span>
        <div>
          <strong>Welcome to Pro.</strong>
          <span>Your subscription is active and you can start syncing across devices.</span>
        </div>
      </div>

      <div class="cancelled-banner" data-cancelled-banner hidden>
        <span class="cancelled-banner-dot"></span>
        <div>
          <strong>Checkout cancelled.</strong>
          <span>No worries — you can pick this back up any time.</span>
        </div>
      </div>

      <AccountSection title="Current plan">
        <div class="plan-card">
          <div class="plan-card-head">
            <span class="plan-card-eyebrow">You're on</span>
            <h3 class="plan-card-name" data-plan-name>Local</h3>
            <div class="plan-card-price">
              <span class="plan-card-amount" data-plan-amount>Free</span>
              <span class="plan-card-cadence" data-plan-cadence>forever</span>
            </div>
            <p class="plan-card-blurb" data-plan-blurb></p>
            <div class="plan-status-row" data-plan-status-row hidden>
              <span class="plan-status-pill" data-plan-status></span>
              <span class="plan-status-meta" data-plan-status-meta></span>
            </div>
          </div>
          <div class="plan-card-actions" data-plan-actions></div>
        </div>
      </AccountSection>

      <AccountSection title="Payment & invoices" description="Cards, receipts, and invoice history are managed in Stripe's secure portal.">
        <div class="portal-row" data-portal-row hidden>
          <div>
            <div class="row-k">Manage in Stripe Customer Portal</div>
            <div class="row-v">Update your card, download invoices, see upcoming charges, or cancel your subscription.</div>
          </div>
          <sui-button variant="outline" size="md" type="button" data-portal-button>
            <span data-portal-label>Open billing portal</span>
            <svg slot="trailing" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </sui-button>
        </div>
        <div class="portal-empty" data-portal-empty>
          You'll see your payment method and invoices here once you upgrade to a paid plan.
        </div>
      </AccountSection>

      <AccountSection title="Usage" description="What this account is consuming this billing period.">
        <div class="stat-grid">
          <div class="stat">
            <div class="stat-label">Plan</div>
            <div class="stat-value" data-stat-plan>—</div>
            <div class="stat-sub" data-stat-plan-sub>—</div>
          </div>
          <div class="stat">
            <div class="stat-label">Synced devices</div>
            <div class="stat-value" data-stat-seats>—</div>
            <div class="stat-sub">signed in to this account</div>
          </div>
          <div class="stat">
            <div class="stat-label">Billing period</div>
            <div class="stat-value" data-stat-period>—</div>
            <div class="stat-sub" data-stat-period-sub>—</div>
          </div>
        </div>
      </AccountSection>

    </AccountShell>
  </main>
  <Footer />
</BaseLayout>

<script>
  import {
    getSession,
    listSubscriptions,
    startUpgrade,
    openBillingPortal,
    cancelSubscription,
    restoreSubscription,
    type Subscription,
  } from '../lib/auth';

  const session = await getSession();
  if (!session) {
    const next = encodeURIComponent(location.pathname);
    location.replace(`/sign-in?next=${next}`);
  } else {
    const params = new URLSearchParams(location.search);
    const upgradeFlag = params.get('upgrade');
    if (upgradeFlag === 'success') {
      show('[data-success-banner]');
    } else if (upgradeFlag === 'cancelled') {
      show('[data-cancelled-banner]');
    }

    let subs = await listSubscriptions();
    let active = pickActive(subs);
    render(active);

    // Stripe Checkout redirects to ?upgrade=success the moment payment
    // succeeds, but the customer.subscription.created webhook is async —
    // we may land here before the plugin has written our `subscription`
    // row. Refresh once after a short beat so the user sees their actual
    // plan instead of a flicker of "Local".
    if (upgradeFlag === 'success' && (!active || active.status !== 'active')) {
      await new Promise((r) => setTimeout(r, 1500));
      subs = await listSubscriptions();
      active = pickActive(subs);
      render(active);
    }

    // Honor ?upgrade=pro from the /pricing → /sign-up → /billing flow:
    // if the user is signed in but doesn't have a Pro subscription yet,
    // kick the Checkout flow automatically.
    if (upgradeFlag === 'pro' && (!active || active.plan !== 'pro')) {
      try {
        await startUpgrade('pro');
      } catch (err) {
        console.error('auto-upgrade failed', err);
      }
    }
  }

  // ── helpers ────────────────────────────────────────────────────────────

  function show(sel: string) {
    const el = document.querySelector<HTMLElement>(sel);
    if (el) el.hidden = false;
  }
  function set(sel: string, text: string) {
    const el = document.querySelector(sel);
    if (el) el.textContent = text;
  }
  // A subscription is "displayed" if the user can act on it from /billing —
  // either it's actively granting privileges (active/trialing/past_due) or
  // it's in a state the user needs to see and act on (paused, recently
  // canceled-at-period-end). We deliberately don't show pure historical
  // terminal rows (deleted, expired) — they'd just confuse a Local user
  // who used to be Pro.
  function pickActive(subs: Subscription[]): Subscription | null {
    if (!subs.length) return null;
    return (
      subs.find((s) => s.status === 'active' || s.status === 'trialing' || s.status === 'past_due') ??
      subs.find((s) => s.status === 'paused') ??
      null
    );
  }
  function fmtDate(d: string | Date | undefined): string {
    if (!d) return '—';
    const date = typeof d === 'string' ? new Date(d) : d;
    return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }
  function statusPill(sub: Subscription | null): { label: string; tone: 'success' | 'warning' | 'destructive' | 'muted'; meta: string } {
    if (!sub) return { label: 'Free', tone: 'muted', meta: 'Local plan' };
    const periodEnd = fmtDate(sub.periodEnd);
    if (sub.cancelAtPeriodEnd) return { label: 'Cancelling', tone: 'warning', meta: `Access ends ${periodEnd}` };
    if (sub.status === 'active') return { label: 'Active', tone: 'success', meta: `Renews ${periodEnd}` };
    if (sub.status === 'trialing') return { label: 'Trialing', tone: 'success', meta: `Trial ends ${fmtDate(sub.trialEnd)}` };
    if (sub.status === 'past_due') return { label: 'Past due', tone: 'destructive', meta: 'Update your payment method to keep Pro access' };
    if (sub.status === 'paused') return { label: 'Paused', tone: 'warning', meta: 'Subscription is paused' };
    if (sub.status === 'canceled') return { label: 'Canceled', tone: 'muted', meta: 'No active subscription' };
    return { label: sub.status, tone: 'muted', meta: '' };
  }

  function render(sub: Subscription | null) {
    const onPro = sub && (sub.status === 'active' || sub.status === 'trialing' || sub.status === 'past_due' || sub.status === 'paused');

    // Plan card copy
    if (onPro) {
      set('[data-plan-name]', 'Pro');
      set('[data-plan-amount]', '$20');
      set('[data-plan-cadence]', `per ${sub!.billingInterval ?? 'month'}`);
      set('[data-plan-blurb]', 'Sync your install across every machine. Cancel anytime.');
    } else {
      set('[data-plan-name]', 'Local');
      set('[data-plan-amount]', 'Free');
      set('[data-plan-cadence]', 'forever');
      set('[data-plan-blurb]', 'Runs on your machine. Bring your own keys. Upgrade when you want your install to follow you.');
    }

    // Status pill row (only meaningful on Pro)
    if (onPro) {
      const { label, tone, meta } = statusPill(sub);
      const row = document.querySelector<HTMLElement>('[data-plan-status-row]');
      const pill = document.querySelector<HTMLElement>('[data-plan-status]');
      if (row && pill) {
        row.hidden = false;
        pill.textContent = label;
        pill.dataset.tone = tone;
        set('[data-plan-status-meta]', meta);
      }
    }

    // Actions
    const actions = document.querySelector<HTMLElement>('[data-plan-actions]');
    if (actions) {
      actions.innerHTML = '';
      if (!onPro) {
        const upgrade = document.createElement('sui-button');
        upgrade.setAttribute('tone', 'primary'); upgrade.setAttribute('size', 'md'); upgrade.setAttribute('type', 'button');
        upgrade.textContent = 'Upgrade to Pro';
        upgrade.addEventListener('click', () => safeCall(() => startUpgrade('pro'), upgrade));
        actions.appendChild(upgrade);
      } else if (sub!.cancelAtPeriodEnd) {
        const restore = document.createElement('sui-button');
        restore.setAttribute('tone', 'primary'); restore.setAttribute('size', 'md'); restore.setAttribute('type', 'button');
        restore.textContent = 'Resume subscription';
        restore.addEventListener('click', () => safeCall(async () => {
          await restoreSubscription(sub!.id);
          location.reload();
        }, restore));
        actions.appendChild(restore);
      } else {
        const cancel = document.createElement('sui-button');
        cancel.setAttribute('variant', 'outline'); cancel.setAttribute('size', 'md'); cancel.setAttribute('type', 'button');
        cancel.textContent = 'Cancel at period end';
        cancel.addEventListener('click', async () => {
          if (!confirm('Cancel your Pro subscription? Access continues until the end of the current period.')) return;
          await safeCall(async () => {
            await cancelSubscription(sub!.id);
            // Stripe Customer Portal handles confirm-cancel UX and returns to /billing.
          }, cancel);
        });
        actions.appendChild(cancel);
      }
    }

    // Payment / invoices section visibility
    const portalRow = document.querySelector<HTMLElement>('[data-portal-row]');
    const portalEmpty = document.querySelector<HTMLElement>('[data-portal-empty]');
    if (portalRow && portalEmpty) {
      if (onPro) {
        portalRow.hidden = false;
        portalEmpty.hidden = true;
        portalRow.querySelector<HTMLElement>('[data-portal-button]')?.addEventListener('click', () => {
          const btn = portalRow.querySelector<HTMLElement>('[data-portal-button]');
          safeCall(() => openBillingPortal(), btn);
        });
      } else {
        portalRow.hidden = true;
        portalEmpty.hidden = false;
      }
    }

    // Usage stats — honest based on plan
    set('[data-stat-plan]', onPro ? 'Pro' : 'Local');
    set('[data-stat-plan-sub]', onPro ? 'paid' : 'free, on this machine');
    set('[data-stat-seats]', onPro ? String(sub!.seats ?? 1) : '—');
    if (onPro) {
      set('[data-stat-period]', fmtDate(sub!.periodEnd));
      set('[data-stat-period-sub]', sub!.cancelAtPeriodEnd ? 'ends' : 'next renewal');
    } else {
      set('[data-stat-period]', '—');
      set('[data-stat-period-sub]', 'no billing period');
    }
  }

  async function safeCall<T>(fn: () => Promise<T>, busyEl?: HTMLElement | null): Promise<T | undefined> {
    if (busyEl) busyEl.setAttribute('disabled', '');
    try {
      return await fn();
    } catch (err) {
      console.error('billing action failed', err);
      alert('Something went wrong. Please try again or open the billing portal.');
    } finally {
      if (busyEl) busyEl.removeAttribute('disabled');
    }
  }
</script>

<style>
  .success-banner, .cancelled-banner {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px;
    border-radius: 14px;
    box-shadow: var(--shadow-plate);
  }
  .success-banner {
    border: 1px solid color-mix(in oklab, var(--success) 35%, var(--plate-border));
    background: color-mix(in oklab, var(--success) 8%, var(--plate));
  }
  .cancelled-banner {
    border: 1px solid var(--plate-border);
    background: var(--plate);
  }
  .success-banner-dot, .cancelled-banner-dot {
    width: 10px; height: 10px; border-radius: 50%; flex: none;
  }
  .success-banner-dot {
    background: var(--success);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--success) 18%, transparent);
  }
  .cancelled-banner-dot { background: var(--muted-ink); }
  .success-banner strong, .cancelled-banner strong {
    display: block; color: var(--page-fg); font-weight: 600; font-size: 14px;
  }
  .success-banner span, .cancelled-banner span {
    color: var(--muted-ink); font-size: 13px;
  }

  .plan-card {
    display: grid; grid-template-columns: 1fr auto; gap: 24px;
    align-items: center;
  }
  @media (max-width: 640px) {
    .plan-card { grid-template-columns: 1fr; }
    .plan-card-actions { width: 100%; }
  }
  .plan-card-head { display: flex; flex-direction: column; gap: 6px; }
  .plan-card-eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .plan-card-name {
    font-family: var(--font-display); font-weight: 600;
    font-size: 24px; letter-spacing: -0.02em;
    color: var(--page-fg); margin: 0;
  }
  .plan-card-price {
    display: flex; align-items: baseline; gap: 8px; margin-top: 4px;
  }
  .plan-card-amount {
    font-family: var(--font-display); font-weight: 700;
    font-size: 32px; letter-spacing: -0.02em; color: var(--page-fg);
  }
  .plan-card-cadence {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px; color: var(--subtle-ink);
  }
  .plan-card-blurb {
    margin: 8px 0 0; font-size: 13.5px; color: var(--muted-ink); max-width: 50ch;
  }
  .plan-status-row {
    display: flex; align-items: center; gap: 12px;
    margin-top: 10px;
  }
  .plan-status-pill {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px;
  }
  .plan-status-pill[data-tone="success"] {
    background: color-mix(in oklab, var(--success) 14%, transparent); color: var(--success);
  }
  .plan-status-pill[data-tone="warning"] {
    background: color-mix(in oklab, var(--warning) 14%, transparent); color: var(--warning);
  }
  .plan-status-pill[data-tone="destructive"] {
    background: color-mix(in oklab, var(--destructive) 14%, transparent); color: var(--destructive);
  }
  .plan-status-pill[data-tone="muted"] {
    background: var(--chip-bg); color: var(--muted-ink);
  }
  .plan-status-meta { font-size: 12.5px; color: var(--muted-ink); }
  .plan-card-actions {
    display: flex; flex-direction: column; gap: 8px; align-items: flex-end;
  }
  @media (max-width: 640px) {
    .plan-card-actions { align-items: stretch; }
  }

  .portal-row {
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
  }
  @media (max-width: 520px) {
    .portal-row { flex-direction: column; align-items: flex-start; }
  }
  .portal-empty {
    padding: 16px; border-radius: 12px;
    background: var(--chip-bg); color: var(--muted-ink);
    font-size: 13px; text-align: center;
  }
  .row-k { font-weight: 600; color: var(--page-fg); font-size: 14px; }
  .row-v { font-size: 13px; color: var(--muted-ink); margin-top: 4px; line-height: 1.5; max-width: 52ch; }

  .stat-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
  }
  @media (max-width: 720px) { .stat-grid { grid-template-columns: 1fr; } }
  .stat {
    padding: 16px;
    border: 1px solid var(--plate-line); border-radius: 12px;
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
  }
  .stat-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .stat-value {
    font-family: var(--font-display); font-weight: 600;
    font-size: 28px; letter-spacing: -0.02em; color: var(--page-fg);
    margin-top: 6px;
  }
  .stat-sub {
    font-size: 11.5px; color: var(--subtle-ink); margin-top: 4px;
  }
</style>
