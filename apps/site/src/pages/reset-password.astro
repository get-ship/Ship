---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const SHOW_AUTH = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_AUTH === 'true';
if (!SHOW_AUTH) return Astro.redirect('/waitlist?reason=reset');
---

<BaseLayout title="Set a new password — SHIP">
  <Navbar />
  <main id="main">
    <section class="pw-stage">
      <div class="pw-bg" aria-hidden="true">
        <div class="pw-bg-grid"></div>
      </div>
      <div class="pw-card">
        <a href="/" class="pw-brand" aria-label="SHIP home">
          <sui-brand-mark size="md"></sui-brand-mark>
          <span>SHIP</span>
        </a>
        <h1>Set a new password.</h1>
        <p class="pw-lede">
          Pick something at least 8 characters. You'll be signed in
          automatically once it's saved.
        </p>

        <div class="pw-token-missing" data-no-token role="alert" hidden>
          This reset link is missing its token, or it has already been used.
          <a href="/forgot-password">Request a new one</a>.
        </div>

        <form class="pw-form" data-reset-form novalidate>
          <label class="pw-field">
            <span>New password</span>
            <input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" />
          </label>
          <label class="pw-field">
            <span>Confirm</span>
            <input type="password" name="confirm" autocomplete="new-password" required minlength="8" placeholder="Same again" />
          </label>
          <div class="pw-error" data-error role="alert" hidden></div>
          <sui-button tone="primary" size="lg" type="submit" class="pw-submit">
            <span data-submit-label>Save password</span>
          </sui-button>
        </form>

        <div class="pw-switch">
          Changed your mind? <a href="/sign-in">Sign in</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { resetPassword } from '../lib/auth';

  const form = document.querySelector<HTMLFormElement>('[data-reset-form]');
  const errEl = document.querySelector<HTMLElement>('[data-error]');
  const noTokenEl = document.querySelector<HTMLElement>('[data-no-token]');
  const label = document.querySelector<HTMLElement>('[data-submit-label]');
  const baseLabel = label?.textContent ?? 'Save password';

  const params = new URLSearchParams(location.search);
  const token = params.get('token');

  if (!token) {
    if (noTokenEl) noTokenEl.hidden = false;
    if (form) form.hidden = true;
  }

  function setBusy(busy: boolean) {
    if (!form) return;
    for (const el of form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input')) {
      el.disabled = busy;
    }
    if (label) label.textContent = busy ? 'Saving…' : baseLabel;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!token) return;
    const data = new FormData(form);
    const pw = String(data.get('password') ?? '');
    const confirm = String(data.get('confirm') ?? '');
    if (errEl) { errEl.hidden = true; errEl.textContent = ''; }
    if (pw.length < 8) {
      if (errEl) { errEl.hidden = false; errEl.textContent = 'Password must be at least 8 characters.'; }
      return;
    }
    if (pw !== confirm) {
      if (errEl) { errEl.hidden = false; errEl.textContent = 'Passwords don\'t match.'; }
      return;
    }
    setBusy(true);
    const res = await resetPassword(pw, token);
    setBusy(false);
    if (!res.ok) {
      if (errEl) { errEl.hidden = false; errEl.textContent = res.error; }
      return;
    }
    location.href = '/account';
  });
</script>

<style>
  .pw-stage {
    position: relative;
    min-height: calc(100vh - 80px);
    padding: clamp(48px, 6vw, 96px) 24px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .pw-bg { position: absolute; inset: 0; pointer-events: none; }
  .pw-bg-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right,  color-mix(in oklab, var(--page-fg) 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--page-fg) 6%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 50% 70% at 50% 40%, #000, transparent 75%);
  }
  .pw-card {
    position: relative; z-index: 1;
    width: 100%; max-width: 440px;
    background: var(--plate);
    border: 1px solid var(--plate-border);
    border-radius: 18px;
    padding: clamp(28px, 4vw, 40px);
    box-shadow: var(--shadow-plate);
    display: flex; flex-direction: column; gap: 16px;
  }
  .pw-brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-display); font-weight: 700;
    color: var(--page-fg); text-decoration: none;
    align-self: flex-start; font-size: 16px;
  }
  .pw-card h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(28px, 3.5vw, 36px);
    line-height: 1.05; letter-spacing: -0.025em;
    color: var(--page-fg); margin: 8px 0 0;
  }
  .pw-lede {
    font-size: 14px; line-height: 1.55; color: var(--muted-ink); margin: 0;
  }
  .pw-form { display: flex; flex-direction: column; gap: 14px; }
  .pw-field { display: flex; flex-direction: column; gap: 6px; }
  .pw-field > span {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .pw-field > input {
    appearance: none;
    border: 1px solid var(--plate-line);
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
    color: var(--page-fg);
    padding: 12px 14px; border-radius: 10px;
    font-family: inherit; font-size: 14px;
    transition: border-color 150ms, box-shadow 150ms;
  }
  .pw-field > input:focus {
    outline: none;
    border-color: color-mix(in oklab, var(--primary) 60%, var(--plate-line));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent);
  }
  .pw-error {
    font-size: 13px; line-height: 1.5; color: var(--destructive);
    padding: 10px 12px; border-radius: 10px;
    background: color-mix(in oklab, var(--destructive) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--destructive) 30%, transparent);
  }
  .pw-token-missing {
    font-size: 13px; line-height: 1.5; color: var(--destructive);
    padding: 12px 14px; border-radius: 10px;
    background: color-mix(in oklab, var(--destructive) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--destructive) 30%, transparent);
  }
  .pw-token-missing a { color: var(--destructive); font-weight: 600; }
  .pw-submit { width: 100%; }
  .pw-switch {
    text-align: center; font-size: 13px; color: var(--muted-ink);
    margin-top: 4px;
  }
  .pw-switch a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .pw-switch a:hover { text-decoration: underline; }
</style>
