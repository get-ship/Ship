---
import RoomLayout from '../layouts/RoomLayout.astro';
---
<RoomLayout title="Set a new password — SHIP">
  <div class="room-card">
    <a href="/" class="room-brand" aria-label="SHIP home"><img src="/ship-logo.svg" alt="" /></a>
    <h1 class="room-title">Set a new password.</h1>
    <p class="room-lede">Pick something at least 8 characters. You'll be signed in automatically once it's saved.</p>
    <div class="room-msg err" data-no-token role="alert" hidden>
      This reset link is missing its token, or it's already been used. <a href="/forgot-password">Request a new one</a>.
    </div>
    <form class="room-form" data-reset-form novalidate>
      <label class="room-field"><span>New password</span>
        <input class="room-input" type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" /></label>
      <label class="room-field"><span>Confirm</span>
        <input class="room-input" type="password" name="confirm" autocomplete="new-password" required minlength="8" placeholder="Same again" /></label>
      <div class="room-msg err" data-error role="alert" hidden></div>
      <button tone="primary" size="lg" type="submit"><span data-submit-label>Save password</span></button>
    </form>
    <div class="room-switch">Changed your mind? <a href="/login">Sign in</a></div>
  </div>
</RoomLayout>

<script>
  import { resetPassword } from '../lib/auth';
  const form = document.querySelector<HTMLFormElement>('[data-reset-form]');
  const errEl = document.querySelector<HTMLElement>('[data-error]');
  const noTokenEl = document.querySelector<HTMLElement>('[data-no-token]');
  const label = document.querySelector<HTMLElement>('[data-submit-label]');
  const baseLabel = label?.textContent ?? 'Save password';
  const token = new URLSearchParams(location.search).get('token');
  if (!token) { if (noTokenEl) noTokenEl.hidden = false; if (form) form.hidden = true; }
  function setBusy(busy: boolean) {
    if (!form) return;
    for (const el of form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input')) el.disabled = busy;
    if (label) label.textContent = busy ? 'Saving…' : baseLabel;
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!token) return;
    const data = new FormData(form);
    const pw = String(data.get('password') ?? '');
    const confirm = String(data.get('confirm') ?? '');
    if (errEl) { errEl.hidden = true; errEl.textContent = ''; }
    if (pw.length < 8) { if (errEl) { errEl.hidden = false; errEl.textContent = 'Password must be at least 8 characters.'; } return; }
    if (pw !== confirm) { if (errEl) { errEl.hidden = false; errEl.textContent = "Passwords don't match."; } return; }
    setBusy(true);
    const res = await resetPassword(pw, token);
    setBusy(false);
    if (!res.ok) { if (errEl) { errEl.hidden = false; errEl.textContent = res.error; } return; }
    location.href = '/';
  });
</script>
