---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Magnetar from '../../games/magnetar/index.astro';
---

<BaseLayout title="SHIP Magnetar" description="A gravity-slingshot puzzle built on the SHIP arcade primitives.">
  <main class="magnetar-page">
    <Magnetar />
    <p class="magnetar-credit">
      Built on the <code>@ship/arcade</code> primitives.
    </p>
  </main>
</BaseLayout>

<style is:global>
  .magnetar-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 32px 16px;
    background: radial-gradient(
      ellipse at top,
      color-mix(in oklch, var(--warning) 10%, var(--background)),
      var(--background) 60%
    );
    color: var(--foreground);
    font-family: var(--font-body, system-ui);
  }
  .magnetar-credit {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .magnetar-credit code {
    background: color-mix(in oklch, var(--card) 80%, transparent);
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 10.5px;
  }
</style>
