---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HighlightAINative from '../components/HighlightAINative.astro';
import HighlightExtend from '../components/HighlightExtend.astro';
import HighlightObserve from '../components/HighlightObserve.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Ship — The missing AI interface">
  <Navbar />
  <main id="main">
    <Hero />
    <div id="features" class="features-anchor" aria-hidden="true"></div>
    <HighlightAINative />
    <section class="features-divider" aria-hidden="true"></section>
    <HighlightExtend />
    <section class="features-divider" aria-hidden="true"></section>
    <HighlightObserve />
    <DownloadSection />
  </main>
  <Footer />
</BaseLayout>

<style>
  .features-anchor {
    height: 0;
    scroll-margin-top: 80px;
  }
  .features-divider {
    max-width: 720px;
    margin: 0 auto;
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
</style>
