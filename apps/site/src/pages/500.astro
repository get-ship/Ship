---
import RoomLayout from '../layouts/RoomLayout.astro';
---
<RoomLayout title="Something broke — SHIP">
  <div class="room-card">
    <div class="room-eyebrow">500 · Server error</div>
    <h1 class="room-title">That's <span class="accent">on us.</span></h1>
    <p class="room-lede">Something on our end misfired and we've been pinged about it. Give it a moment, or head back to safer ground.</p>
    <div class="room-actions">
      <sui-button tone="primary" size="lg"><a href="/">Back to the desktop</a></sui-button>
      <sui-button variant="ghost" size="lg"><a href="https://docs.getship.dev">Read the docs</a></sui-button>
    </div>
    <div class="room-switch">Still broken? <a href="mailto:support@getship.dev">support@getship.dev</a></div>
  </div>
</RoomLayout>
