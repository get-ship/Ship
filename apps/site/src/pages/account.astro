---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AccountShell from '../components/AccountShell.astro';
import AccountSection from '../components/AccountSection.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

const SHOW_ACCOUNT = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_ACCOUNT === 'true';
if (!SHOW_ACCOUNT) return Astro.redirect('/');
---

<BaseLayout title="Account — SHIP">
  <Navbar />
  <main id="main">
    <AccountShell active="account" title="Account">

      <AccountSection title="Profile" description="The name and email visible across your synced workspaces.">
        <div class="profile-layout">
          <div class="profile-avatar" data-profile-avatar>
            <span class="profile-avatar-initials" data-profile-initials>·</span>
          </div>
          <form class="form-grid" data-profile-form novalidate>
            <label class="form-field">
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" placeholder="Your name" />
            </label>
            <label class="form-field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" data-bind-email readonly />
              <small>Email changes require re-verification. Contact support to update.</small>
            </label>
            <div class="form-actions">
              <sui-button tone="primary" size="md" type="submit">Save changes</sui-button>
              <span class="form-status" data-form-status></span>
            </div>
          </form>
        </div>
      </AccountSection>

      <AccountSection title="Connected accounts" description="Sign in faster by linking the providers you use. Same email links automatically.">
        <div class="account-providers" data-providers>
          <div class="provider-row" data-provider="google">
            <div class="provider-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
            </div>
            <div class="provider-body">
              <div class="provider-name">Google</div>
              <div class="provider-meta" data-provider-meta>Not connected</div>
            </div>
            <button class="provider-action" type="button" data-provider-action>Connect</button>
          </div>
          <div class="provider-row" data-provider="github">
            <div class="provider-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39 10.93 10.93 0 0 1 2.87.39c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.23 2.77.12 3.06.73.81 1.17 1.84 1.17 3.1 0 4.42-2.69 5.4-5.26 5.68.42.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
            </div>
            <div class="provider-body">
              <div class="provider-name">GitHub</div>
              <div class="provider-meta" data-provider-meta>Not connected</div>
            </div>
            <button class="provider-action" type="button" data-provider-action>Connect</button>
          </div>
          <div class="provider-row" data-provider="slack">
            <div class="provider-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="#E01E5A" d="M5.1 15.1a2.1 2.1 0 1 1-2.1-2.1h2.1zm1.05 0a2.1 2.1 0 1 1 4.2 0v5.3a2.1 2.1 0 1 1-4.2 0z"/><path fill="#36C5F0" d="M8.9 5.1a2.1 2.1 0 1 1 2.1-2.1v2.1zm0 1.05a2.1 2.1 0 1 1 0 4.2H3.6a2.1 2.1 0 1 1 0-4.2z"/><path fill="#2EB67D" d="M18.9 8.9a2.1 2.1 0 1 1 2.1 2.1h-2.1zm-1.05 0a2.1 2.1 0 1 1-4.2 0V3.6a2.1 2.1 0 1 1 4.2 0z"/><path fill="#ECB22E" d="M15.1 18.9a2.1 2.1 0 1 1-2.1 2.1v-2.1zm0-1.05a2.1 2.1 0 1 1 0-4.2h5.3a2.1 2.1 0 1 1 0 4.2z"/></svg>
            </div>
            <div class="provider-body">
              <div class="provider-name">Slack</div>
              <div class="provider-meta" data-provider-meta>Not connected</div>
            </div>
            <button class="provider-action" type="button" data-provider-action>Connect</button>
          </div>
        </div>
      </AccountSection>

      <AccountSection title="Appearance" description="Pick the SHIP theme this browser uses for the marketing site.">
        <div class="theme-row">
          <div>
            <div class="row-k">Theme</div>
            <div class="row-v">Synced to this device only.</div>
          </div>
          <ThemeSwitcher />
        </div>
      </AccountSection>

      <AccountSection title="Active sessions" description="Browser sessions currently signed in to this account.">
        <div class="session-list" data-session-list>
          <div class="session-empty">Loading…</div>
        </div>
        <div class="session-foot">
          <sui-button variant="outline" size="sm" type="button" data-sign-out-all>Sign out everywhere else</sui-button>
        </div>
      </AccountSection>

      <AccountSection title="Danger zone" description="Irreversible operations on your account." tone="danger">
        <div class="danger-row">
          <div>
            <div class="row-k">Delete account</div>
            <div class="row-v">Removes synced workspaces, devices, and billing history. Local SHIP installs are unaffected.</div>
          </div>
          <sui-button variant="outline" tone="destructive" size="md" type="button" data-delete-account>Delete account</sui-button>
        </div>
      </AccountSection>

    </AccountShell>
  </main>
  <Footer />
</BaseLayout>

<script>
  import {
    getSession,
    signOut,
    authClient,
    listSessions,
    revokeOtherSessions,
    revokeSession,
    listAccounts,
    unlinkAccount,
    initials,
    signInWithProvider,
  } from '../lib/auth';

  type SessionRow = {
    id: string;
    token: string;
    createdAt: string | Date;
    expiresAt: string | Date;
    ipAddress?: string | null;
    userAgent?: string | null;
  };

  const session = await getSession();
  if (!session) {
    const next = encodeURIComponent(location.pathname);
    location.replace(`/sign-in?next=${next}`);
  } else {
    const { user } = session;

    // Profile avatar — use user.image from the social provider if present;
    // otherwise paint initials in a circle (matches the navbar avatar).
    const avatarEl = document.querySelector<HTMLElement>('[data-profile-avatar]');
    const initialsEl = document.querySelector<HTMLElement>('[data-profile-initials]');
    if (avatarEl && initialsEl) {
      if (user.image) {
        avatarEl.innerHTML = `<img src="${user.image}" alt="" referrerpolicy="no-referrer" />`;
      } else {
        initialsEl.textContent = initials(user);
      }
    }

    // Connected accounts — light up rows for providers the user has linked.
    type LinkedAccount = { providerId: string; createdAt?: string };
    const accounts = (await listAccounts()) as LinkedAccount[];
    const linkedBy: Record<string, LinkedAccount | undefined> = {};
    for (const a of accounts) linkedBy[a.providerId] = a;
    for (const row of document.querySelectorAll<HTMLElement>('.provider-row')) {
      const id = row.dataset.provider as 'google' | 'github' | 'slack' | undefined;
      if (!id) continue;
      const meta = row.querySelector<HTMLElement>('[data-provider-meta]');
      const btn  = row.querySelector<HTMLButtonElement>('[data-provider-action]');
      const linked = linkedBy[id];
      if (linked && meta && btn) {
        row.classList.add('is-linked');
        const when = linked.createdAt ? new Date(linked.createdAt) : null;
        meta.textContent = when ? `Connected ${relTime(when)}` : 'Connected';
        btn.textContent = 'Disconnect';
        btn.addEventListener('click', async () => {
          if (!confirm(`Disconnect ${id} from this account?`)) return;
          btn.disabled = true;
          try {
            await unlinkAccount(id);
            location.reload();
          } catch { btn.disabled = false; }
        });
      } else if (btn) {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            await signInWithProvider(id, '/account');
          } catch { btn.disabled = false; }
        });
      }
    }

    const form = document.querySelector<HTMLFormElement>('[data-profile-form]');
    if (form) {
      (form.elements.namedItem('name') as HTMLInputElement | null)!.value = user.name ?? '';
      (form.elements.namedItem('email') as HTMLInputElement | null)!.value = user.email;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const status = form.querySelector<HTMLElement>('[data-form-status]');
        try {
          await authClient.updateUser({ name });
          if (status) {
            status.textContent = 'Saved.';
            setTimeout(() => { if (status.textContent === 'Saved.') status.textContent = ''; }, 2400);
          }
        } catch (err) {
          if (status) {
            status.textContent = 'Could not save.';
            status.style.color = 'var(--destructive)';
          }
          console.error('updateUser failed', err);
        }
      });
    }

    // Sessions list.
    const sessionList = document.querySelector<HTMLElement>('[data-session-list]');
    const renderSessions = (rows: SessionRow[]) => {
      if (!sessionList) return;
      if (!rows.length) {
        sessionList.innerHTML = '<div class="session-empty">Only this browser is signed in.</div>';
        return;
      }
      sessionList.innerHTML = rows.map((row) => {
        const ua = row.userAgent ?? 'Unknown browser';
        const where = parseUa(ua);
        const isCurrent = row.token === session.session.token;
        const meta = [
          row.ipAddress ?? 'IP unknown',
          'signed in ' + relTime(new Date(row.createdAt)),
        ].join(' · ');
        return `
          <div class="session">
            <div class="session-body">
              <div class="session-name">${where}${isCurrent ? ' <span class="device-tag">current</span>' : ''}</div>
              <div class="session-meta">${meta}</div>
            </div>
            ${isCurrent ? '' : `<button class="device-action" type="button" data-revoke="${row.token}">Sign out</button>`}
          </div>`;
      }).join('');
      for (const btn of sessionList.querySelectorAll<HTMLButtonElement>('[data-revoke]')) {
        btn.addEventListener('click', async () => {
          const token = btn.dataset.revoke!;
          btn.disabled = true;
          try {
            await revokeSession(token);
            const rows2 = await listSessions();
            renderSessions(rows2 as SessionRow[]);
          } catch {
            btn.disabled = false;
          }
        });
      }
    };
    renderSessions((await listSessions()) as SessionRow[]);

    document.querySelector<HTMLButtonElement>('[data-sign-out-all]')?.addEventListener('click', async () => {
      await revokeOtherSessions();
      const rows = await listSessions();
      renderSessions(rows as SessionRow[]);
    });

    document.querySelector<HTMLButtonElement>('[data-delete-account]')?.addEventListener('click', async () => {
      const ok = confirm('Delete your account? Synced workspaces will be removed. This cannot be undone.');
      if (!ok) return;
      try {
        await authClient.deleteUser({});
      } catch {
        // Even if the gateway doesn't implement deleteUser, sign out so the
        // user doesn't end up stuck on a page they can't escape.
      }
      await signOut();
      location.href = '/';
    });
  }

  function parseUa(ua: string): string {
    if (/Chrome\//.test(ua) && !/Edg|OPR/.test(ua)) return label('Chrome', ua);
    if (/Firefox\//.test(ua)) return label('Firefox', ua);
    if (/Safari\//.test(ua) && !/Chrome/.test(ua)) return label('Safari', ua);
    if (/Edg\//.test(ua)) return label('Edge', ua);
    return ua.slice(0, 64);
  }
  function label(browser: string, ua: string): string {
    const os = /Mac OS X/.test(ua) ? 'macOS'
      : /Windows/.test(ua) ? 'Windows'
      : /Linux/.test(ua) ? 'Linux'
      : /Android/.test(ua) ? 'Android'
      : /iPhone|iPad/.test(ua) ? 'iOS'
      : 'unknown';
    return `${browser} on ${os}`;
  }
  function relTime(d: Date): string {
    const s = Math.floor((Date.now() - d.getTime()) / 1000);
    if (s < 60) return 'just now';
    if (s < 3600) return `${Math.floor(s / 60)}m ago`;
    if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
    return `${Math.floor(s / 86400)}d ago`;
  }
</script>

<style>
  /* Profile (avatar + form) ---------------------------------------- */
  .profile-layout {
    display: grid; grid-template-columns: 96px 1fr; gap: 24px;
    align-items: start;
  }
  @media (max-width: 520px) {
    .profile-layout { grid-template-columns: 1fr; }
  }
  .profile-avatar {
    width: 96px; height: 96px;
    border-radius: 50%;
    overflow: hidden;
    display: inline-flex;
    align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white;
    box-shadow: 0 6px 18px color-mix(in oklab, var(--primary) 35%, transparent);
  }
  .profile-avatar img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .profile-avatar-initials {
    font-family: var(--font-display);
    font-weight: 700; font-size: 32px;
    letter-spacing: 0.02em;
  }

  /* Connected accounts ---------------------------------------------- */
  .account-providers { display: flex; flex-direction: column; gap: 10px; }
  .provider-row {
    display: grid; grid-template-columns: 36px 1fr auto;
    gap: 14px; align-items: center;
    padding: 12px 14px;
    border: 1px solid var(--plate-line);
    border-radius: 12px;
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
  }
  .provider-row.is-linked {
    border-color: color-mix(in oklab, var(--success) 35%, var(--plate-line));
  }
  .provider-icon { display: inline-flex; align-items: center; justify-content: center; }
  .provider-name { font-weight: 600; font-size: 14px; color: var(--page-fg); }
  .provider-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; color: var(--subtle-ink); margin-top: 4px;
  }
  .provider-row.is-linked .provider-meta { color: var(--success); }
  .provider-action {
    appearance: none; cursor: pointer;
    background: transparent;
    border: 1px solid var(--plate-line);
    color: var(--muted-ink);
    padding: 6px 12px; border-radius: 8px;
    font-family: inherit; font-size: 12.5px; font-weight: 500;
    transition: color 120ms, border-color 120ms;
  }
  .provider-action:hover {
    color: var(--page-fg);
    border-color: color-mix(in oklab, var(--primary) 40%, var(--plate-line));
  }
  .provider-row.is-linked .provider-action:hover {
    color: var(--destructive);
    border-color: color-mix(in oklab, var(--destructive) 40%, var(--plate-line));
  }
  .provider-action:disabled { opacity: 0.55; cursor: wait; }

  .form-grid {
    display: flex; flex-direction: column; gap: 14px;
    max-width: 480px;
  }
  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-field > span {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--subtle-ink);
  }
  .form-field > input {
    appearance: none;
    border: 1px solid var(--plate-line);
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
    color: var(--page-fg);
    padding: 10px 12px; border-radius: 10px;
    font-family: inherit; font-size: 14px;
    transition: border-color 150ms, box-shadow 150ms;
  }
  .form-field > input:focus {
    outline: none;
    border-color: color-mix(in oklab, var(--primary) 60%, var(--plate-line));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent);
  }
  .form-field > input[readonly] {
    color: var(--muted-ink); cursor: not-allowed;
  }
  .form-field > small {
    font-size: 11.5px; color: var(--subtle-ink);
  }
  .form-actions {
    display: flex; align-items: center; gap: 12px;
  }
  .form-status {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px; color: var(--success);
  }

  .row-k {
    font-weight: 600; color: var(--page-fg); font-size: 14px;
  }
  .row-v {
    font-size: 13px; color: var(--muted-ink); margin-top: 4px; line-height: 1.5;
  }

  .theme-row, .danger-row {
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
  }
  @media (max-width: 520px) {
    .theme-row, .danger-row { flex-direction: column; align-items: flex-start; }
  }

  .device-list, .session-list {
    display: flex; flex-direction: column; gap: 10px;
  }
  .device, .session {
    display: grid; grid-template-columns: 36px 1fr auto;
    gap: 14px; align-items: center;
    padding: 12px 14px;
    border: 1px solid var(--plate-line); border-radius: 12px;
    background: color-mix(in oklab, var(--plate) 92%, var(--page-bg));
  }
  .session { grid-template-columns: 1fr auto; }
  .device-icon {
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--muted-ink);
  }
  .device-name, .session-name {
    font-weight: 600; font-size: 14px; color: var(--page-fg);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .device-meta, .session-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; color: var(--subtle-ink); margin-top: 4px;
  }
  .device-tag {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 2px 8px; border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
  }
  .device-action {
    appearance: none; cursor: pointer;
    background: transparent;
    border: 1px solid var(--plate-line);
    color: var(--muted-ink);
    padding: 6px 12px; border-radius: 8px;
    font-family: inherit; font-size: 12.5px; font-weight: 500;
    transition: color 120ms, border-color 120ms;
  }
  .device-action:hover {
    color: var(--destructive);
    border-color: color-mix(in oklab, var(--destructive) 40%, var(--plate-line));
  }
  .device-alert { margin-top: 14px; }

  .session-foot { margin-top: 14px; }
</style>
