---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Ship installers — coming soon">
  <Navbar />
  <main class="soon-page">
    <div class="site-container soon-inner">
      <ship-badge tone="accent" variant="soft">Installers shipping soon</ship-badge>
      <h1>Almost there.</h1>
      <p class="site-muted">
        Platform installers are being signed and packaged. Drop your email
        and we&rsquo;ll ping you the moment downloads go live.
      </p>
      <form
        class="soon-form"
        onsubmit="event.preventDefault();window.location.hash='#thanks';"
      >
        <input type="email" required placeholder="you@company.com" aria-label="Email" />
        <ship-button tone="accent" variant="solid" size="md" type="submit">
          Notify me
        </ship-button>
      </form>
      <p id="thanks" class="soon-thanks site-muted">Thanks &mdash; we&rsquo;ll be in touch.</p>
      <a class="soon-back" href="/">&larr; Back to the homepage</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .soon-page {
    padding: 96px 0;
    min-height: 70vh;
  }
  .soon-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .soon-inner h1 {
    font-size: clamp(36px, 5vw, 56px);
  }
  .soon-form {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    width: min(100%, 420px);
  }
  .soon-form input {
    flex: 1;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--site-border);
    border-radius: 10px;
    background: var(--site-card);
    color: var(--site-fg);
    font: inherit;
  }
  .soon-form input:focus {
    outline: 2px solid var(--site-accent);
    outline-offset: 2px;
  }
  .soon-submit {
    all: unset;
    cursor: pointer;
  }
  .soon-thanks {
    display: none;
  }
  .soon-thanks:target {
    display: block;
  }
  .soon-back {
    color: var(--site-muted-fg);
    margin-top: 20px;
  }
  .soon-back:hover {
    color: var(--site-fg);
  }
</style>
