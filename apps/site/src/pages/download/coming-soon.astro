---
import RoomLayout from '../../layouts/RoomLayout.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
---
<RoomLayout title="SHIP installers — coming soon">
  <div class="room-card">
    <div class="room-eyebrow">Installers landing soon</div>
    <h1 class="room-title">Almost <span class="accent">there.</span></h1>
    <p class="room-lede">This installer is being packaged for release. Leave your email and we'll let you know the moment it's live.</p>
    <WaitlistForm
      list="general"
      source="download/coming-soon"
      placeholder="you@company.com"
      cta="Notify me"
      thanks="You're on the list. We'll email you as soon as installers land."
      size="lg"
    />
    <div class="room-switch"><a href="/download">← Other platforms</a> · <a href="/">Desktop</a></div>
  </div>
</RoomLayout>
