---
/*
 * /docs/<slug> — article surface inside the OS shell.
 *
 * Each article is a content collection entry. We render the OS desktop
 * with the Docs window open AND pre-loaded with the requested article;
 * the window's renderer hydrates from a data-attribute payload so a
 * cold visitor sees the full article SSR'd, then client JS takes over
 * for in-window navigation.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/landing-os.css';
import Desktop from '../../components/landing/os/Desktop.astro';

export async function getStaticPaths() {
  const all = await getCollection('docs');
  // Draft pages render in dev but aren't built for production.
  return all
    .filter((entry) => import.meta.env.DEV || entry.data.status !== 'draft')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = `${entry.data.title} · Ship Docs`;
const desc = entry.data.description;
---
<BaseLayout title={title} description={desc} bodyClass="os-root">
  <Desktop initial="docs" docSlug={entry.id} />
  {/* SSR fallback so no-JS / first-paint visitors see the body even
      before the OS shell wires up. Hidden when JS hydrates. */}
  <div class="docs-ssr" hidden>
    <article>
      <Content />
    </article>
    <script type="application/json" data-doc-headings set:html={JSON.stringify(headings)} />
  </div>
</BaseLayout>
