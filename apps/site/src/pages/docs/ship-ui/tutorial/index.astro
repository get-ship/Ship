---
/*
  Tutorial index (getship.dev/tutorial) — groups every step under its
  chapter. Prose source of truth is the Sail doc-skill at
  docs/ship-sui/references/docs/ship-ui/tutorial/<NN-slug>/index.md; this route reads
  each step's frontmatter to build the chapter grid.
*/
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { existsSync, readFileSync, readdirSync } from 'node:fs'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'

// ESM resolve of @ship/sail-tutorial — no createRequire (Astro/Vite ESM).
const tutorialDir = join(
  dirname(fileURLToPath(import.meta.resolve('@ship/sail-tutorial/package.json'))),
  'src',
  'prose',
)
interface Step {
  slug: string
  title: string
  description: string | null
  order: number
  chapter: string
}

function parseFm(text: string): Record<string, string | null> {
  const m = text.match(/^---\n([\s\S]*?)\n---/)
  if (!m) return {}
  const out: Record<string, string | null> = {}
  for (const line of m[1].split('\n')) {
    const kv = line.match(/^(\w+):\s*(.+)$/)
    if (!kv) continue
    let v = kv[2].trim()
    if (v === 'null') { out[kv[1]] = null; continue }
    v = v.replace(/^["']|["']$/g, '')
    out[kv[1]] = v
  }
  return out
}

// Sail tip ships flat prose: `src/prose/<slug>.md` (not nested dirs).
const steps: Step[] = (existsSync(tutorialDir) ? readdirSync(tutorialDir) : [])
  .filter((name) => name.endsWith('.md'))
  .map((name) => {
    const stem = name.replace(/\.md$/, '')
    const fm = parseFm(readFileSync(join(tutorialDir, name), 'utf8'))
    return {
      slug: fm.slug ?? stem,
      title: fm.title ?? stem,
      description: fm.description ?? null,
      order: Number(fm.order ?? 999),
      chapter: fm.chapter ?? 'other',
    }
  })
  .sort((a, b) => a.order - b.order)

const chapterOrder: string[] = []
const byChapter = new Map<string, Step[]>()
for (const s of steps) {
  if (!byChapter.has(s.chapter)) {
    byChapter.set(s.chapter, [])
    chapterOrder.push(s.chapter)
  }
  byChapter.get(s.chapter)!.push(s)
}

const chapterTitles: Record<string, string> = {
  surface: 'The surface',
  state: 'State and data',
  system: 'The system',
  agents: 'The agent loop',
  other: 'Other',
}
const chapterDescriptions: Record<string, string> = {
  surface: 'Markup, layout keywords, and sx — the page as tags.',
  state: 'Controllers, signals, query, and forms.',
  system: 'Motion, themes, and the compiler.',
  agents: 'How an agent authors and reviews a Sail view.',
  other: 'Other',
}

const firstSlug = steps[0]?.slug
const totalSteps = steps.length
const totalChapters = chapterOrder.length
---

<BaseLayout
  title="Sail tutorial — learn to build Ship views"
  description="Learn Sail step by step. Edit code, watch it render. A live, hands-on tutorial for Ship's view framework."
  bodyClass="tut-index-page"
>
  <main class="ti-root">
    <a href="/docs/" class="ti-back" aria-label="Back to docs">
      <span class="ti-back-arrow" aria-hidden="true">←</span> Docs
    </a>
    <header class="ti-hero">
      <p class="ti-eyebrow">Sail · the tutorial</p>
      <h1>Learn Sail by building.</h1>
      <p class="ti-lead">
        {totalSteps} steps across {totalChapters} chapters. Read the prose on the
        left, edit the code on the right — the preview re-renders as you type.
        Show the solution when you're stuck. No install required; it all runs
        in your browser.
      </p>
      {firstSlug && (
        <a href={`/docs/ship-ui/tutorial/${firstSlug}/`} class="ti-cta">Start with step 01 →</a>
      )}
    </header>

    {chapterOrder.map((chap) => (
      <section class="ti-chapter">
        <header class="ti-chap-head">
          <span class="ti-chap-title">{chapterTitles[chap] ?? chap}</span>
          {chapterDescriptions[chap] && (
            <span class="ti-chap-desc">{chapterDescriptions[chap]}</span>
          )}
        </header>
        <div class="ti-grid">
          {byChapter.get(chap)!.map((s) => (
            <a href={`/docs/ship-ui/tutorial/${s.slug}/`} class="ti-card">
              <span class="ti-card-num">{String(s.order).padStart(2, '0')}</span>
              <span class="ti-card-meta">
                <strong>{s.title}</strong>
                {s.description && <span class="ti-card-desc">{s.description}</span>}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  :global(body.tut-index-page) {
    background: var(--background);
    color: var(--foreground);
  }
  .ti-root {
    max-width: 64rem;
    margin: 0 auto;
    padding: 28px 24px 80px;
  }

  /* Big, obvious escape back to the docs surface — keeps the tutorial
     from reading as a dead-end island. */
  .ti-back {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-sans); font-size: 14px; font-weight: 600;
    color: var(--foreground); text-decoration: none;
    padding: 8px 16px; border-radius: 9px;
    background: color-mix(in oklch, var(--foreground) 6%, transparent);
    border: 1px solid var(--border);
    margin-bottom: 28px;
    transition: background 120ms ease, border-color 120ms ease, transform 120ms ease;
  }
  .ti-back:hover {
    background: color-mix(in oklch, var(--primary) 12%, transparent);
    border-color: var(--primary);
    transform: translateX(-1px);
  }
  .ti-back-arrow { font-size: 17px; line-height: 1; }

  .ti-hero { margin-bottom: 40px; }
  .ti-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
    margin: 0 0 10px;
  }
  .ti-hero h1 {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.05;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }
  .ti-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    max-width: 44rem;
    margin: 0 0 22px;
  }
  .ti-cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--background);
    background: var(--primary);
    padding: 11px 18px;
    border-radius: 8px;
    transition: opacity 120ms ease, transform 120ms ease;
  }
  .ti-cta:hover { opacity: 0.92; transform: translateY(-1px); }

  .ti-chapter { margin: 36px 0; }
  .ti-chap-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  .ti-chap-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .ti-chap-desc { font-size: 0.85rem; color: var(--muted-foreground); }

  .ti-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 8px;
  }
  .ti-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 15px;
    text-decoration: none;
    color: inherit;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 120ms ease, transform 120ms ease, background 120ms ease;
  }
  .ti-card:hover {
    border-color: var(--primary);
    transform: translateY(-1px);
    background: color-mix(in oklch, var(--primary) 4%, var(--card));
  }
  .ti-card-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted-foreground);
    width: 2ch;
    text-align: right;
    flex-shrink: 0;
  }
  .ti-card-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ti-card-meta strong { font-weight: 600; font-size: 0.92rem; }
  .ti-card-desc {
    font-size: 0.8rem;
    color: var(--muted-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
