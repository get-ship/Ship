---
/*
 * /docs — landing for the curated guides. Renders inside the OS shell
 * (same Window chrome as the rest of the desktop). Real article surface
 * lives at /docs/<slug> via [...slug].astro.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/landing-os.css';
import Desktop from '../../components/landing/os/Desktop.astro';

const title = 'SHIP — Docs';
const desc = 'Curated guides — install, your first agent, the Ship mental model. Full reference lives separately.';
---
<BaseLayout title={title} description={desc} bodyClass="os-root">
  <Desktop initial="docs" />
</BaseLayout>
