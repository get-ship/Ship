---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
  {
    tone: 'accent',
    label: 'Runtime',
    title: 'Ship your agents in production.',
    body:
      'The same runtime that powers the SHIP app runs your agents, views, and pipelines in production — on your infrastructure or ours. Bring your own models, bring your own data, get the scheduling, permissions, and observability for free.',
  },
  {
    tone: 'info',
    label: 'SDK',
    title: 'Build features, not plumbing.',
    body:
      'A typed TS + Rust SDK for spawning agents, subscribing to events, composing views, and wiring collections. Skip the prompt-routing, retry, and memory boilerplate. Ship your app in afternoons, not weeks.',
  },
  {
    tone: 'success',
    label: 'Components',
    title: 'A design system your users already know.',
    body:
      'Every UI surface in SHIP is built from the same web-component library we publish to you. Drop <code>&lt;ship-*&gt;</code> elements into any framework, theme them with your brand, and ship apps that feel native to SHIP from day one.',
  },
  {
    tone: 'warning',
    label: 'Governance',
    title: 'Permissions, audit, and budgets — built in.',
    body:
      'Scope every action, every network call, every skill. Give teammates read-only access without handing them your keys. Set per-model budgets. Stream the audit log into the same SHIP views your team already uses.',
  },
];

const plans = [
  {
    name: 'Free',
    price: 'Free',
    tag: 'For makers',
    body: 'Everything runs on your machine. Your keys, your data. All SDK capabilities.',
    cta: 'Download SHIP',
    href: '/download',
    tone: 'muted',
  },
  {
    name: 'Pro',
    price: 'Coming soon',
    tag: 'For teams',
    body: 'Shared workspaces, team audit log, role-based access, hosted sync.',
    cta: 'Get notified',
    href: '/sign-up',
    tone: 'accent',
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Talk to us',
    tag: 'For platforms',
    body: 'SSO, data residency, private model routing, custom SLAs, white-label SDK.',
    cta: 'Email sales',
    href: 'mailto:sales@getship.dev',
    tone: 'info',
  },
];
---

<BaseLayout title="Build on SHIP — platform for AI-native apps">
  <Navbar />
  <main class="fw-page">
    <header class="fw-hero site-container">
      <ship-badge tone="accent" variant="soft" size="sm">Build on SHIP</ship-badge>
      <h1>The platform for AI&#8209;native apps.</h1>
      <p class="site-muted fw-lede">
        SHIP isn&rsquo;t a library. It&rsquo;s a runtime, an SDK, a
        component system, and a governance layer &mdash; all designed so
        your team can ship AI features that users actually want to use.
        Start free on your laptop, graduate to Pro when you&rsquo;re
        ready for a team, enterprise when you&rsquo;re ready for scale.
      </p>
      <ship-toolbar gap="md" justify="start" class="fw-ctas">
        <ship-button
          tone="accent"
          variant="solid"
          size="lg"
          onclick="location.href='mailto:sales@getship.dev'"
        >Talk to sales</ship-button>
        <ship-button
          variant="ghost"
          size="lg"
          onclick="location.href='https://docs.getship.dev'"
        >Read the docs &rarr;</ship-button>
      </ship-toolbar>
    </header>

    <section class="fw-caps site-container">
      <div class="fw-caps-grid">
        {capabilities.map((c) => (
          <ship-card
            variant="outline"
            status-rail
            tone={c.tone}
            padding="lg"
            class="fw-cap"
          >
            <div slot="header" class="fw-cap-head">
              <ship-badge tone={c.tone} variant="soft" size="sm">{c.label}</ship-badge>
            </div>
            <h3 class="fw-cap-title">{c.title}</h3>
            <p class="fw-cap-body" set:html={c.body}></p>
          </ship-card>
        ))}
      </div>
    </section>

    <section class="fw-plans site-container">
      <header class="fw-plans-head">
        <h2>Priced for where you are.</h2>
        <p class="site-muted">
          Start free. Pay when your team does. Final pricing locked
          ahead of 1.0 &mdash; sign up for updates.
        </p>
      </header>

      <div class="fw-plan-grid">
        {plans.map((p) => (
          <ship-card
            variant="outline"
            padding="lg"
            class:list={['fw-plan', p.featured && 'fw-plan-featured']}
            accent-bar={p.featured}
          >
            <div slot="header" class="fw-plan-head">
              <ship-badge tone={p.tone} variant="soft" size="sm">{p.tag}</ship-badge>
              <span class="fw-plan-name">{p.name}</span>
            </div>
            <div class="fw-plan-price">{p.price}</div>
            <p class="fw-plan-body">{p.body}</p>
            <ship-button
              slot="footer"
              tone={p.featured ? 'accent' : 'default'}
              variant={p.featured ? 'solid' : 'outline'}
              size="md"
              onclick={`location.href='${p.href}'`}
            >{p.cta}</ship-button>
          </ship-card>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .fw-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .fw-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 52rem;
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .fw-hero h1 {
    font-size: clamp(40px, 6vw, 64px);
  }
  .fw-lede {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.55;
  }
  .fw-ctas { margin-top: 6px; }

  .fw-caps {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .fw-caps-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 720px) {
    .fw-caps-grid { grid-template-columns: 1fr; }
  }
  .fw-cap { display: block; }
  .fw-cap-head { display: inline-flex; }
  .fw-cap-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(18px, 2vw, 22px);
    letter-spacing: -0.015em;
    margin: 10px 0 8px;
    color: var(--foreground);
  }
  .fw-cap-body {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 14.5px;
  }
  .fw-cap-body code {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 1px 6px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--border) 30%, transparent);
    color: var(--foreground);
  }

  .fw-plans {
    padding-top: clamp(32px, 5vw, 72px);
  }
  .fw-plans-head {
    max-width: 60ch;
    margin: 0 auto 28px;
    text-align: center;
  }
  .fw-plans-head h2 { margin-bottom: 8px; }
  .fw-plan-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 820px) {
    .fw-plan-grid { grid-template-columns: 1fr; }
  }
  .fw-plan { display: block; }
  .fw-plan-featured {
    border-color: color-mix(in oklch, var(--site-accent) 55%, transparent);
    box-shadow:
      0 1px 2px color-mix(in oklch, var(--foreground) 4%, transparent),
      0 24px 48px -20px color-mix(in oklch, var(--site-accent) 25%, transparent);
  }
  .fw-plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .fw-plan-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .fw-plan-price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -0.025em;
    color: var(--foreground);
    margin: 10px 0 6px;
  }
  .fw-plan-body {
    color: var(--muted-foreground);
    font-size: 13.5px;
    line-height: 1.5;
  }
</style>
