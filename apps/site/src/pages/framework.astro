---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Built with Ship — framework">
  <Navbar />
  <main class="soon-page">
    <div class="site-container soon-inner">
      <ship-badge tone="muted" variant="soft">Coming soon</ship-badge>
      <h1>The Ship framework.</h1>
      <p class="site-muted">
        The same runtime that powers Ship&rsquo;s Studio is available for you
        to build your own local&#8209;first AI apps. Deep docs, SDK, and the
        web component catalog are being published in phases.
      </p>
      <div class="soon-links">
        <a href="https://docs.getship.dev">Read the docs &rarr;</a>
        <a href="https://github.com/">View the source &rarr;</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .soon-page {
    padding: 96px 0;
    min-height: 70vh;
  }
  .soon-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }
  .soon-inner h1 {
    font-size: clamp(36px, 5vw, 56px);
  }
  .soon-links {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }
  .soon-links a {
    color: var(--site-accent);
    border-bottom: 1px dashed color-mix(in oklch, var(--site-accent) 50%, transparent);
  }
</style>
