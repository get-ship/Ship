---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Build on SHIP — platform for AI-native apps">
  <Navbar />
  <main class="fw-page">
    <header class="fw-hero site-container">
      <ship-badge tone="accent" variant="soft" size="sm">Build on SHIP</ship-badge>
      <h1>The platform for AI&#8209;native apps.</h1>
      <p class="fw-lede">
        SHIP isn&rsquo;t a library. It&rsquo;s a runtime, an SDK, a
        component system, and a governance layer &mdash; all designed
        so your team can ship AI features your users actually want to
        use. Start free on your laptop, talk to us when you&rsquo;re
        ready for a team or production.
      </p>
      <ship-toolbar gap="md" justify="start" class="fw-ctas">
        <ship-button
          tone="accent"
          variant="solid"
          size="lg"
          onclick="location.href='mailto:sales@getship.dev'"
        >Talk to sales</ship-button>
        <ship-button
          variant="ghost"
          size="lg"
          onclick="location.href='https://docs.getship.dev'"
        >Read the docs &rarr;</ship-button>
      </ship-toolbar>
    </header>

    <section class="fw-cta site-container">
      <ship-card variant="outline" padding="lg" class="fw-cta-card">
        <div class="fw-cta-copy">
          <h2>Ready to build on SHIP?</h2>
          <p>
            We&rsquo;re onboarding a small group of design-forward
            teams into the platform ahead of general availability.
            Bring your use case, we&rsquo;ll bring the SDK, the
            runtime, and the production reps.
          </p>
        </div>
        <ship-toolbar slot="footer" gap="md" justify="end">
          <ship-button
            variant="ghost"
            size="md"
            onclick="location.href='https://docs.getship.dev'"
          >Docs</ship-button>
          <ship-button
            tone="accent"
            variant="solid"
            size="md"
            onclick="location.href='mailto:sales@getship.dev'"
          >Email sales</ship-button>
        </ship-toolbar>
      </ship-card>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .fw-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .fw-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 52rem;
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .fw-hero h1 {
    font-size: clamp(40px, 6vw, 64px);
  }
  .fw-lede {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .fw-ctas { margin-top: 6px; }

  .fw-cta {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .fw-cta-card {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
  }
  .fw-cta-copy h2 {
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .fw-cta-copy p {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 15px;
    max-width: 54ch;
  }
</style>
