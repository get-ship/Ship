---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Download SHIP">
  <Navbar />
  <main id="main" class="download-page">
    <DownloadSection />
  </main>
  <Footer />
</BaseLayout>

<style>
  .download-page {
    padding-top: 72px;
  }
  .download-intro {
    text-align: center;
    max-width: 48ch;
    margin: 0 auto 24px;
  }
  .download-intro h1 {
    font-size: clamp(36px, 5vw, 56px);
  }
</style>
