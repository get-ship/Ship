---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Registry-style tiles. Mock data for launch — shape mirrors
// apps/web/src/features/registry/types.ts (name, scope, description,
// version, installs, owner). When the real registry backend comes
// online, this page swaps its data source and the tiles stay put.
const featured = {
  scope: 'pipeline',
  name: 'weekly-review',
  title: 'Weekly review',
  owner: 'ship',
  verified: true,
  version: '1.3.0',
  installs: 4210,
  description:
    'Monday-morning digest — summarizes the last seven days of commits, PRs, and inbox traffic into a single view. One agent per source, one gate for your approval.',
};

const pipelines = [
  { name: 'weekly-review',   scope: 'pipeline', owner: 'ship',     verified: true,  version: '1.3.0', installs: 4210, description: 'Monday-morning digest across commits, PRs, and email. Human-gated.' },
  { name: 'pr-triage',       scope: 'pipeline', owner: 'ship',     verified: true,  version: '0.9.1', installs: 3108, description: 'Route incoming PRs by owner, add labels, request reviewers, summarize risk.' },
  { name: 'bug-report-flow', scope: 'pipeline', owner: 'priya',    verified: false, version: '0.4.2', installs: 812,  description: 'Turn a vague bug report into a reproducible test, a suspect commit, and a proposed fix.' },
  { name: 'release-notes',   scope: 'pipeline', owner: 'ship',     verified: true,  version: '2.0.0', installs: 2490, description: 'Draft release notes from a git tag range. Pulls highlights from commits, linked issues, and the changelog.' },
];

const skills = [
  { name: 'spec-writer',     scope: 'skill', owner: 'ship',   verified: true,  version: '0.6.0', installs: 5820, description: 'Captures a half-baked idea and returns an implementable spec with acceptance criteria.' },
  { name: 'invoice-parser',  scope: 'skill', owner: 'stripe', verified: true,  version: '1.0.0', installs: 2117, description: 'Extract line items, totals, and VAT from an attachment. Maps to your accounting collection.' },
  { name: 'slack-digest',    scope: 'skill', owner: 'slack',  verified: true,  version: '0.8.1', installs: 1760, description: 'Summarize a noisy Slack channel on a schedule. Respects thread context and quiet hours.' },
  { name: 'meeting-notes',   scope: 'skill', owner: 'priya',  verified: false, version: '0.2.0', installs: 643,  description: 'Turn a transcript into decisions, action items, and a follow-up email draft.' },
];

const views = [
  { name: 'launch-tracker',  scope: 'view', owner: 'ship',   verified: true,  version: '1.1.0', installs: 1930, description: 'Board view over any collection with status columns, per-owner lanes, and velocity charts.' },
  { name: 'reading-queue',   scope: 'view', owner: 'sam',    verified: false, version: '0.3.2', installs: 420,  description: 'Instapaper-style queue — click through, rate, and file articles into your own taxonomy.' },
  { name: 'cost-dashboard',  scope: 'view', owner: 'ship',   verified: true,  version: '0.7.0', installs: 2380, description: 'Per-agent, per-model cost over time with budget alerts and drill-downs.' },
  { name: 'repo-pulse',      scope: 'view', owner: 'ship',   verified: true,  version: '0.5.0', installs: 1104, description: 'Live grid of your repos — PRs open, velocity, CI status, and lint debt.' },
];

const themes = [
  {
    name: 'ship-dark',      scope: 'theme', owner: 'ship', verified: true, version: '1.0.0', installs: 14210,
    description: 'The canonical SHIP dark palette — warm amber primary, muted purple accent.',
    swatches: ['oklch(0.18 0.01 250)', 'oklch(0.18 0.01 50)', 'oklch(0.77 0.16 70)', 'oklch(0.3 0.05 300)'],
  },
  {
    name: 'nord',           scope: 'theme', owner: 'community', verified: false, version: '1.2.0', installs: 6722,
    description: 'Arctic Ice Studio\u2019s palette ported to SHIP tokens.',
    swatches: ['oklch(0.29 0.02 255)', 'oklch(0.34 0.02 255)', 'oklch(0.77 0.06 220)', 'oklch(0.95 0.01 250)'],
  },
  {
    name: 'gruvbox-dark',   scope: 'theme', owner: 'community', verified: false, version: '2.0.1', installs: 5100,
    description: 'Pavel Pertsev\u2019s cult terminal palette, warmed up for the app.',
    swatches: ['oklch(0.28 0.014 80)', 'oklch(0.33 0.016 80)', 'oklch(0.82 0.16 80)', 'oklch(0.72 0.03 85)'],
  },
  {
    name: 'paper',          scope: 'theme', owner: 'ship', verified: true, version: '0.4.0', installs: 2870,
    description: 'Low-contrast cream palette for long reading sessions.',
    swatches: ['oklch(0.97 0.014 80)', 'oklch(0.99 0.010 80)', 'oklch(0.55 0.14 35)', 'oklch(0.46 0.04 55)'],
  },
];

// Scope tone mapping — keyed for CSS data-scope hooks.
const scopeTones: Record<string, string> = {
  pipeline: 'primary',
  skill: 'info',
  view: 'accent',
  theme: 'success',
};

const fmtInstalls = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);

const initials = (name: string) =>
  name.split(/[^a-z0-9]/i).filter(Boolean).slice(0, 2).map((p) => p[0].toUpperCase()).join('');
---

<BaseLayout title="SHIP Store — pipelines, skills, views, themes">
  <Navbar />
  <main class="store-page">

    <!-- Hero ------------------------------------------------------- -->
    <header class="store-hero site-container">
      <ship-badge tone="primary" variant="soft" size="sm">Store</ship-badge>
      <h1>Install, remix, ship.</h1>
      <p class="store-lede">
        Pipelines, skills, views, and themes from the SHIP team and the
        community. Install with one click, compose with your own,
        publish when you&rsquo;re ready.
      </p>
      <ship-toolbar gap="md" justify="start" class="store-ctas">
        <ship-button
          tone="primary"
          variant="solid"
          size="md"
          onclick="location.href='/sign-up'"
        >Get notified at launch</ship-button>
        <ship-button
          variant="ghost"
          size="md"
          onclick="location.href='https://docs.getship.dev'"
        >Publishing guide &rarr;</ship-button>
      </ship-toolbar>
    </header>

    <!-- Featured --------------------------------------------------- -->
    <section class="store-section site-container">
      <header class="store-sec-head">
        <ship-badge tone="accent" variant="soft" size="sm">Featured this week</ship-badge>
      </header>

      <ship-card variant="outline" padding="lg" class="store-featured" data-scope={featured.scope}>
        <div class="store-featured-left">
          <div class="store-featured-head">
            <ship-badge tone={scopeTones[featured.scope]} variant="soft" size="sm">{featured.scope}</ship-badge>
            {featured.verified && <span class="store-verified" aria-label="Verified owner">&check;</span>}
            <span class="store-featured-owner">by {featured.owner}</span>
          </div>
          <h2 class="store-featured-title">{featured.title}</h2>
          <p class="store-featured-body">{featured.description}</p>
        </div>
        <div class="store-featured-right">
          <div class="store-featured-stats">
            <div class="store-stat">
              <div class="store-stat-num">{fmtInstalls(featured.installs)}</div>
              <div class="store-stat-label">installs</div>
            </div>
            <div class="store-stat">
              <div class="store-stat-num">v{featured.version}</div>
              <div class="store-stat-label">latest</div>
            </div>
          </div>
          <ship-button
            tone="primary"
            variant="solid"
            size="md"
            onclick="location.href='/sign-up'"
          >Install</ship-button>
        </div>
      </ship-card>
    </section>

    <!-- Pipelines -------------------------------------------------- -->
    <section class="store-section site-container">
      <header class="store-sec-head">
        <ship-badge tone="primary" variant="soft" size="sm">Pipelines</ship-badge>
        <h2>Ready-to-run workflows.</h2>
      </header>
      <div class="store-grid">
        {pipelines.map((p) => (
          <a href="/sign-up" class="store-tile" data-scope={p.scope}>
            <div class="store-tile-head">
              <div class="store-tile-owner" aria-hidden="true">{initials(p.owner)}</div>
              <span class="store-tile-name">{p.name}</span>
              {p.verified && <span class="store-tile-verified" aria-label="Verified" title="Verified owner">&check;</span>}
              <span class="store-tile-scope">{p.scope}</span>
            </div>
            <p class="store-tile-body">{p.description}</p>
            <div class="store-tile-foot">
              <span class="store-tile-version">v{p.version}</span>
              <span class="store-tile-installs">&darr; {fmtInstalls(p.installs)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Skills ----------------------------------------------------- -->
    <section class="store-section site-container">
      <header class="store-sec-head">
        <ship-badge tone="info" variant="soft" size="sm">Skills</ship-badge>
        <h2>Drop-in capabilities.</h2>
      </header>
      <div class="store-grid">
        {skills.map((s) => (
          <a href="/sign-up" class="store-tile" data-scope={s.scope}>
            <div class="store-tile-head">
              <div class="store-tile-owner" aria-hidden="true">{initials(s.owner)}</div>
              <span class="store-tile-name">{s.name}</span>
              {s.verified && <span class="store-tile-verified" title="Verified owner" aria-label="Verified">&check;</span>}
              <span class="store-tile-scope">{s.scope}</span>
            </div>
            <p class="store-tile-body">{s.description}</p>
            <div class="store-tile-foot">
              <span class="store-tile-version">v{s.version}</span>
              <span class="store-tile-installs">&darr; {fmtInstalls(s.installs)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Views ------------------------------------------------------ -->
    <section class="store-section site-container">
      <header class="store-sec-head">
        <ship-badge tone="accent" variant="soft" size="sm">Views</ship-badge>
        <h2>Interfaces, one click.</h2>
      </header>
      <div class="store-grid">
        {views.map((v) => (
          <a href="/sign-up" class="store-tile" data-scope={v.scope}>
            <div class="store-tile-head">
              <div class="store-tile-owner" aria-hidden="true">{initials(v.owner)}</div>
              <span class="store-tile-name">{v.name}</span>
              {v.verified && <span class="store-tile-verified" title="Verified owner" aria-label="Verified">&check;</span>}
              <span class="store-tile-scope">{v.scope}</span>
            </div>
            <p class="store-tile-body">{v.description}</p>
            <div class="store-tile-foot">
              <span class="store-tile-version">v{v.version}</span>
              <span class="store-tile-installs">&darr; {fmtInstalls(v.installs)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Themes ----------------------------------------------------- -->
    <section class="store-section site-container">
      <header class="store-sec-head">
        <ship-badge tone="success" variant="soft" size="sm">Themes</ship-badge>
        <h2>Palette, packaged.</h2>
      </header>
      <div class="store-grid store-grid-themes">
        {themes.map((t) => (
          <a href="/sign-up" class="store-tile store-theme-tile" data-scope={t.scope}>
            <div class="store-theme-swatches" aria-hidden="true">
              <span style={`background:${t.swatches[0]}`}></span>
              <span style={`background:${t.swatches[1]}`}></span>
              <span style={`background:${t.swatches[2]}`}></span>
              <span style={`background:${t.swatches[3]}`}></span>
            </div>
            <div class="store-tile-head">
              <span class="store-tile-name">{t.name}</span>
              {t.verified && <span class="store-tile-verified" title="Verified owner" aria-label="Verified">&check;</span>}
              <span class="store-tile-scope">{t.scope}</span>
            </div>
            <p class="store-tile-body">{t.description}</p>
            <div class="store-tile-foot">
              <span class="store-tile-version">v{t.version}</span>
              <span class="store-tile-installs">&darr; {fmtInstalls(t.installs)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Publish CTA ------------------------------------------------ -->
    <section class="store-cta site-container">
      <ship-card variant="outline" padding="lg" class="store-cta-card">
        <div class="store-cta-copy">
          <h2>Ship your own.</h2>
          <p>
            Pipelines, skills, views, themes &mdash; all are small,
            versioned files. Publish from the CLI when the registry is
            live. Until then, join the early-access list to shape the
            submission flow.
          </p>
        </div>
        <ship-toolbar slot="footer" gap="md" justify="end">
          <ship-button
            variant="ghost"
            size="md"
            onclick="location.href='https://docs.getship.dev'"
          >Publishing docs</ship-button>
          <ship-button
            tone="primary"
            variant="solid"
            size="md"
            onclick="location.href='/sign-up'"
          >Join early access</ship-button>
        </ship-toolbar>
      </ship-card>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .store-page {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }

  /* Hero --------------------------------------------------------- */
  .store-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 52rem;
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  .store-hero h1 { font-size: clamp(36px, 5vw, 56px); }
  .store-lede {
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .store-ctas { margin-top: 4px; }

  /* Section scaffolding ------------------------------------------ */
  .store-section {
    padding: clamp(28px, 4vw, 52px) 0;
  }
  .store-sec-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .store-sec-head h2 {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  /* Featured card ------------------------------------------------ */
  .store-featured {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .store-featured { grid-template-columns: 1fr; }
  }
  .store-featured-head {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .store-featured-owner {
    color: var(--muted-foreground);
    font-size: 12.5px;
  }
  .store-featured-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -0.022em;
    color: var(--foreground);
    margin-bottom: 8px;
  }
  .store-featured-body {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 14.5px;
    max-width: 56ch;
  }
  .store-featured-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  .store-featured-stats {
    display: flex;
    gap: 28px;
  }
  .store-stat-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
  }
  .store-stat-label {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    margin-top: 2px;
  }

  /* Tile grids --------------------------------------------------- */
  .store-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
  }
  .store-tile {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklch, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    background: var(--card);
    text-decoration: none;
    color: inherit;
    min-height: 132px;
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .store-tile:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--primary) 50%, transparent);
    box-shadow: 0 1px 2px color-mix(in oklch, var(--foreground) 6%, transparent);
  }
  .store-tile[data-scope='pipeline']:hover { border-color: color-mix(in oklch, var(--primary) 55%, transparent); }
  .store-tile[data-scope='skill']:hover    { border-color: color-mix(in oklch, oklch(0.60 0.16 240) 55%, transparent); }
  .store-tile[data-scope='view']:hover     { border-color: color-mix(in oklch, var(--accent) 55%, transparent); }
  .store-tile[data-scope='theme']:hover    { border-color: color-mix(in oklch, oklch(0.58 0.15 150) 55%, transparent); }

  .store-tile-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .store-tile-owner {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: color-mix(in oklch, var(--primary) 18%, var(--card));
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .store-tile-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--foreground);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .store-tile-verified,
  .store-verified {
    color: oklch(0.60 0.16 240);
    font-size: 11px;
    font-weight: 700;
  }
  .store-tile-scope {
    margin-left: auto;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border-radius: 999px;
    color: var(--muted-foreground);
    background: color-mix(in oklch, var(--border) 30%, transparent);
  }
  .store-tile[data-scope='pipeline'] .store-tile-scope { color: var(--primary);                     background: color-mix(in oklch, var(--primary) 12%, transparent); }
  .store-tile[data-scope='skill']    .store-tile-scope { color: oklch(0.60 0.16 240);               background: color-mix(in oklch, oklch(0.60 0.16 240) 12%, transparent); }
  .store-tile[data-scope='view']     .store-tile-scope { color: var(--accent);                      background: color-mix(in oklch, var(--accent) 14%, transparent); }
  .store-tile[data-scope='theme']    .store-tile-scope { color: oklch(0.58 0.15 150);               background: color-mix(in oklch, oklch(0.58 0.15 150) 14%, transparent); }

  .store-tile-body {
    color: var(--muted-foreground);
    font-size: 12.5px;
    line-height: 1.5;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .store-tile-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in oklch, var(--border) 35%, transparent);
    font-size: 11px;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  /* Theme tiles -------------------------------------------------- */
  .store-grid-themes {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .store-theme-tile {
    padding: 0;
    overflow: hidden;
  }
  .store-theme-tile .store-tile-head,
  .store-theme-tile .store-tile-body {
    padding-inline: 14px;
  }
  .store-theme-tile .store-tile-head { padding-top: 12px; }
  .store-theme-tile .store-tile-foot {
    padding: 8px 14px 10px;
  }
  .store-theme-swatches {
    display: flex;
    height: 48px;
  }
  .store-theme-swatches > span { flex: 1; display: block; }

  /* CTA ---------------------------------------------------------- */
  .store-cta { padding-top: clamp(40px, 6vw, 72px); }
  .store-cta-card {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
  }
  .store-cta-card h2 {
    font-size: clamp(22px, 2.8vw, 30px);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .store-cta-card p {
    color: var(--muted-foreground);
    line-height: 1.55;
    font-size: 14.5px;
    max-width: 54ch;
  }
</style>
