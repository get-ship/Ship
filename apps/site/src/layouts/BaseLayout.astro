---
import '../styles/global.css';
import { THEMES, DEFAULT_THEME, THEME_STORAGE_KEY } from '../lib/themes';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** Per-page social card override; defaults to /og-image.png. */
  ogImage?: string;
}

const {
  title,
  description = 'SHIP is the missing AI interface. One app for every model, built to run on your machine.',
  bodyClass = '',
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://getship.dev').toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://getship.dev').toString();

// Serialize the local theme catalog into the FOUC-prevention inline
// script. Single source of truth — if THEMES changes, this updates.
const themePreloadPayload = JSON.stringify({
  key: THEME_STORAGE_KEY,
  default: DEFAULT_THEME,
  ids: THEMES.map((t) => t.id),
  darks: THEMES.filter((t) => t.dark).map((t) => t.id),
});
---

<!doctype html>
<html lang="en" data-theme="ship-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="SHIP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/ship-logo.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ themes: themePreloadPayload }}>
      (() => {
        const cfg = JSON.parse(themes);
        const ok = new Set(cfg.ids);
        const darks = new Set(cfg.darks);
        let theme = cfg.default;
        try {
          const v = localStorage.getItem(cfg.key);
          if (ok.has(v)) theme = v;
        } catch (_) {}
        const root = document.documentElement;
        root.dataset.theme = theme;
        root.classList.toggle('dark', darks.has(theme));
        // Marks the document as JS-enabled so scroll-triggered sections
        // can hide themselves pre-animation. Without this, noscript
        // users see a blank section.
        root.classList.add('js');
      })();
    </script>

    <!--
      SUI bundles import the runtime by bare specifier. The importmap
      must precede the module script that loads `/sui-components.js`.
    -->
    <script is:inline type="importmap" set:html={JSON.stringify({
      imports: {
        '@ship/sui-runtime': '/sui-runtime.js',
        '@ship/sui-runtime/route': '/sui-runtime.js',
        '@ship/sui-runtime/template-hooks': '/sui-runtime.js',
        '@ship/sui-dom': '/sui-dom.js',
        '@ship/sdk-client': '/sui-sdk-client.js',
      },
    })}></script>
    <script is:inline type="module" src="/sui-components.js"></script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
