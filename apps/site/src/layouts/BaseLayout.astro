---
import '../styles/global.css';
import AuthModal from '../components/AuthModal.astro';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** If true, skip mounting the shared auth modal — used by /sign-in
   *  and /sign-up which mount their own with `autoOpen`. */
  ownAuthModal?: boolean;
}

const {
  title,
  description = 'SHIP is the missing AI interface. One app for every model, built to run on your machine.',
  bodyClass = '',
  ownAuthModal = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="ship-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://getship.dev" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/ship-logo.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const ok = new Set([
          'ship-light', 'ship-dark', 'high-contrast', 'warm',
          'gruvbox-dark', 'gruvbox-light', 'nord', 'solarized-dark',
        ]);
        try {
          const v = localStorage.getItem('ship-site-theme');
          document.documentElement.dataset.theme = ok.has(v) ? v : 'ship-light';
        } catch (_) {
          document.documentElement.dataset.theme = 'ship-light';
        }
        // Marks the document as JS-enabled so scroll-triggered sections
        // can hide themselves pre-animation. Without this, noscript
        // users see a blank section.
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    {!ownAuthModal && <AuthModal />}
    <script>
      import '../scripts/register-elements';
    </script>
  </body>
</html>
