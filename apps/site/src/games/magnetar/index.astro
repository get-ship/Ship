---
// Magnetar — gravity-slingshot puzzle.
//
// Launch a ship and land it back home on Earth. You set the launch angle (drag
// direction) and the thrust (drag distance); planets curve the flight, walls
// bite. Ten levels that build from a clean liftoff to a many-body finale. The
// director loads one at a time.
---

<div class="magnetar-mount" data-magnetar>
  <sui-stage width="480" height="540" tick-rate="60" fps="60" background="card">
    <sui-stage-input map="ArrowLeft,A" action="aim-left"></sui-stage-input>
    <sui-stage-input map="ArrowRight,D" action="aim-right"></sui-stage-input>
    <sui-stage-input map="ArrowUp,W" action="thrust-up" repeat="true"></sui-stage-input>
    <sui-stage-input map="ArrowDown,S" action="thrust-down" repeat="true"></sui-stage-input>
    <sui-stage-input map="Space,Enter" action="fire" repeat="false"></sui-stage-input>

    <sui-hud align="corner-tl">
      <div class="mag-stack">
        <div class="mag-chip mag-chip-level">
          <span class="mag-chip-label">Level</span>
          <span class="mag-chip-value" data-bind="level">Liftoff</span>
        </div>
        <div class="mag-chip">
          <span class="mag-chip-label">Score</span>
          <span class="mag-chip-value" data-bind="score">0</span>
        </div>
        <div class="mag-chip mag-chip-stars">
          <span class="mag-chip-label">Stars</span>
          <span class="mag-chip-value" data-bind="stars">0/33</span>
        </div>
        <div class="mag-chip mag-chip-crew">
          <span class="mag-chip-label">Crew</span>
          <span class="mag-chip-value" data-bind="crew"></span>
        </div>
      </div>
    </sui-hud>

    <sui-hud align="corner-tr">
      <div class="mag-stack mag-right">
        <div class="mag-chip mag-chip-shots">
          <span class="mag-chip-label">Shots</span>
          <span class="mag-chip-value" data-bind="shots">3</span>
        </div>
        <div class="mag-chip mag-chip-thrust">
          <span class="mag-chip-label">Thrust</span>
          <span class="mag-chip-value"><span data-bind="thrust">50</span>%</span>
        </div>
      </div>
    </sui-hud>

    <sui-hud align="bottom">
      <div class="mag-hint" data-bind="hint">Drag to aim, pull farther for more thrust. Release to launch the ship home to Earth.</div>
    </sui-hud>

    <sui-hud align="center" pointer-events="auto">
      <div class="mag-overlay" data-overlay></div>
    </sui-hud>
  </sui-stage>
</div>

<style is:global>
  .magnetar-mount {
    display: inline-block;
    position: relative;
    line-height: 0;
  }
  .magnetar-mount sui-stage {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 480 / 540;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--border) 60%, transparent),
      0 24px 60px -16px color-mix(in oklch, var(--warning) 28%, transparent),
      0 8px 32px -12px color-mix(in oklch, var(--foreground) 18%, transparent);
    cursor: crosshair;
    touch-action: none;
  }

  .mag-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-body, system-ui);
    pointer-events: none;
    line-height: 1.2;
  }
  .mag-right { align-items: flex-end; }

  .mag-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 110px;
    padding: 6px 10px 7px;
    background: color-mix(in oklch, var(--card, #000) 38%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 26%, transparent);
    border-radius: 8px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--foreground, #fff);
  }
  .mag-right .mag-chip { align-items: flex-end; }
  .mag-chip-shots  { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--warning) 34%, transparent); }
  .mag-chip-thrust { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--info) 34%, transparent); }
  .mag-chip-crew   { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--success) 38%, transparent); }
  /* Hide the crew chip on levels with no rescues (empty bound value). */
  .mag-chip-crew:has(.mag-chip-value:empty) { display: none; }
  /* Keep long level names from blowing out the chip width. */
  .mag-chip-level { max-width: 150px; }
  .mag-chip-level .mag-chip-value { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

  .mag-chip-label {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .mag-chip-value {
    font-size: 16px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .mag-chip-shots  .mag-chip-value { color: var(--warning); }
  .mag-chip-thrust .mag-chip-value { color: var(--info); }
  .mag-chip-crew   .mag-chip-value { color: var(--success); }

  .mag-hint {
    display: inline-block;
    padding: 6px 14px;
    background: color-mix(in oklch, var(--card, #000) 55%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 22%, transparent);
    border-radius: 999px;
    font-family: var(--font-body, system-ui);
    font-size: 12px;
    color: var(--foreground, #fff);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    max-width: 360px;
    line-height: 1.4;
    text-align: center;
  }

  .mag-overlay {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 26px 36px 22px;
    min-width: 260px;
    text-align: center;
    color: var(--foreground, #fff);
    background: color-mix(in oklch, var(--card, #0a0d12) 80%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 30%, transparent);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 16px 48px -16px color-mix(in oklch, var(--foreground, #000) 40%, transparent);
    font-family: var(--font-body, system-ui);
  }
  .mag-overlay[data-state] { display: flex; }
  .mag-overlay-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .mag-overlay-title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    font-family: var(--font-display, var(--font-body, system-ui));
  }
  .mag-overlay-meta {
    font-size: 13px;
    opacity: 0.78;
    line-height: 1.45;
    max-width: 32ch;
  }
  .mag-overlay-keys {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 11px;
    opacity: 0.85;
  }
  .mag-key {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 5px;
    background: color-mix(in oklch, var(--foreground, #fff) 12%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground, #fff) 22%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .mag-cta {
    appearance: none;
    border: none;
    margin-top: 4px;
    padding: 10px 22px;
    border-radius: 8px;
    background: var(--warning);
    color: var(--background);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 80ms ease-out, filter 80ms ease-out;
  }
  .mag-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .mag-cta:active { transform: translateY(0); filter: brightness(0.96); }
  .mag-cta:focus-visible {
    outline: 2px solid var(--ring, var(--warning));
    outline-offset: 3px;
  }
  .mag-cta-row {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }
  .mag-cta-row .mag-cta { margin-top: 0; }
  .mag-cta-ghost {
    background: transparent;
    color: var(--foreground, #fff);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--foreground, #fff) 35%, transparent);
  }
  .mag-cta-ghost:hover {
    background: color-mix(in oklch, var(--foreground, #fff) 10%, transparent);
    filter: none;
  }

  /* ── Level select ── */
  .mag-overlay-wide { min-width: 340px; max-width: 420px; padding: 22px 26px 20px; }
  .mag-levels {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
    width: 100%; margin-top: 6px;
  }
  .mag-level {
    appearance: none; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    padding: 9px 4px 7px; border-radius: 9px;
    background: color-mix(in oklch, var(--foreground, #fff) 7%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground, #fff) 16%, transparent);
    color: var(--foreground, #fff); font: inherit;
    transition: transform 90ms ease-out, border-color 90ms ease-out, background 90ms ease-out;
  }
  .mag-level:hover:not(.locked) {
    transform: translateY(-2px);
    border-color: var(--warning);
    background: color-mix(in oklch, var(--warning) 14%, transparent);
  }
  .mag-level:focus-visible { outline: 2px solid var(--ring, var(--warning)); outline-offset: 2px; }
  .mag-level.locked { opacity: 0.4; cursor: not-allowed; }
  .mag-level-num { font-size: 15px; font-weight: 800; line-height: 1; font-family: var(--font-display, var(--font-body, system-ui)); }
  .mag-level-name {
    font-size: 7.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    opacity: 0.6; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .mag-stars { display: flex; gap: 1px; }
  .mag-star { font-size: 9px; line-height: 1; color: color-mix(in oklch, var(--foreground, #fff) 22%, transparent); }
  .mag-star.on { color: var(--warning); }
  .mag-stars-big { gap: 8px; margin: 2px 0 2px; }
  .mag-stars-big .mag-star { font-size: 30px; }
</style>

<script>
  // '@ship/arcade/bundle' (pixi + custom elements, ~800KB) is NOT imported here.
  // ArcadeWindow lazy-imports it on first open; sui-stage upgrades then and our
  // `sui-stage:ready` listener below fires. Keeps the homepage off the hook.
  import type { Stage } from '@ship/arcade-engine'
  import { effect } from '@ship/sui-runtime'
  import { createMagnetarDirector } from './director.ts'
  import { LEVELS } from './levels.ts'
  import { MAX_SPEED, MIN_SPEED } from './physics.ts'

  const root = document.querySelector<HTMLElement>('[data-magnetar]')
  const stageEl = root?.querySelector('sui-stage') as (HTMLElement & {
    stage?: Stage
    start?(): void
    pause?(): void
    resume?(): void
    setAim?(rad: number, speed?: number): void
    fire?(): void
    restart?(): void
    next?(): void
  }) | null
  const overlay = root?.querySelector<HTMLElement>('[data-overlay]')

  const LOGICAL_W = 480
  const LOGICAL_H = 540

  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const node = document.createElement(tag)
    if (cls) node.className = cls
    if (text !== undefined) node.textContent = text
    return node
  }
  function starsRow(n: number, big = false): HTMLElement {
    const row = el('div', big ? 'mag-stars mag-stars-big' : 'mag-stars')
    for (let i = 0; i < 3; i++) row.append(el('span', i < n ? 'mag-star on' : 'mag-star', '★'))
    return row
  }

  function showLevelSelect() {
    if (!overlay || !game) return
    overlay.replaceChildren()
    overlay.dataset.state = 'idle'
    overlay.classList.add('mag-overlay-wide')
    const got = game.levelStars()
    const unlocked = game.unlockedCount()
    const total = got.reduce((a, b) => a + b, 0)
    overlay.append(
      el('div', 'mag-overlay-eyebrow', 'SHIP Arcade · Magnetar'),
      el('div', 'mag-overlay-title', 'Choose a level'),
      el('div', 'mag-overlay-meta', `Earth is the target — land near its centre. Bullseye = ★★★.  ★ ${total}/${game.levelCount * 3}`),
    )
    const grid = el('div', 'mag-levels')
    for (let i = 0; i < game.levelCount; i++) {
      const locked = i >= unlocked
      const tile = el('button', 'mag-level' + (locked ? ' locked' : '')) as HTMLButtonElement
      tile.type = 'button'
      tile.disabled = locked
      if (!locked) tile.dataset.action = `level-${i}`
      tile.append(el('span', 'mag-level-num', locked ? '🔒' : String(i + 1)))
      tile.append(starsRow(got[i] ?? 0))
      tile.append(el('span', 'mag-level-name', LEVELS[i]?.name ?? ''))
      grid.append(tile)
    }
    overlay.append(grid)
  }

  function showCleared(stars: number, accuracy: number, points: number, level: string, isLast: boolean) {
    if (!overlay) return
    overlay.replaceChildren()
    overlay.classList.remove('mag-overlay-wide')
    overlay.dataset.state = 'cleared'
    const pct = Math.round(accuracy * 100)
    overlay.append(
      el('div', 'mag-overlay-eyebrow', stars === 3 ? 'Bullseye landing' : stars === 2 ? 'Solid landing' : 'Touchdown'),
      el('div', 'mag-overlay-title', isLast ? 'All ships home' : 'Home'),
      starsRow(stars, true),
      el('div', 'mag-overlay-meta', `${level} · ${pct}% on centre · +${points}`),
    )
    const row = el('div', 'mag-cta-row')
    const replay = el('button', 'mag-cta mag-cta-ghost', 'Replay') as HTMLButtonElement
    replay.type = 'button'; replay.dataset.action = 'replay'
    const levels = el('button', 'mag-cta mag-cta-ghost', 'Levels') as HTMLButtonElement
    levels.type = 'button'; levels.dataset.action = 'levels'
    row.append(replay, levels)
    if (!isLast) {
      const next = el('button', 'mag-cta', 'Next') as HTMLButtonElement
      next.type = 'button'; next.dataset.action = 'next'
      row.append(next)
    }
    overlay.append(row)
    overlay.querySelector<HTMLButtonElement>(isLast ? '[data-action="levels"]' : '[data-action="next"]')?.focus({ preventScroll: true })
  }

  function showFailed(level: string) {
    if (!overlay) return
    overlay.replaceChildren()
    overlay.classList.remove('mag-overlay-wide')
    overlay.dataset.state = 'failed'
    overlay.append(
      el('div', 'mag-overlay-eyebrow', 'Out of fuel'),
      el('div', 'mag-overlay-title', 'Adrift'),
      el('div', 'mag-overlay-meta', level),
    )
    const row = el('div', 'mag-cta-row')
    const levels = el('button', 'mag-cta mag-cta-ghost', 'Levels') as HTMLButtonElement
    levels.type = 'button'; levels.dataset.action = 'levels'
    const retry = el('button', 'mag-cta', 'Retry') as HTMLButtonElement
    retry.type = 'button'; retry.dataset.action = 'retry'
    row.append(levels, retry)
    overlay.append(row)
    retry.focus({ preventScroll: true })
  }

  function clearOverlay() {
    if (!overlay) return
    delete overlay.dataset.state
    overlay.classList.remove('mag-overlay-wide')
    overlay.replaceChildren()
  }

  let game: ReturnType<typeof createMagnetarDirector> | null = null
  let stopStateEffect: (() => void) | null = null

  function ensureGame() {
    if (game || !stageEl?.stage) return
    game = createMagnetarDirector({ stage: stageEl.stage, stageHost: stageEl })
    stopStateEffect?.()
    stopStateEffect = effect(() => {
      const g = game
      if (!g) return
      const s = g.state()
      if (s === 'idle') showLevelSelect()
      else if (s === 'cleared') showCleared(g.lastStars(), g.lastAccuracy(), g.lastPoints(), g.levelName(), g.levelIndex() >= g.levelCount - 1)
      else if (s === 'failed') showFailed(g.levelName())
      else clearOverlay() // aiming / flying / landing — board is clear
    })
  }

  function onReady() {
    ensureGame()
    if (game) showLevelSelect()
    // Run the loop on idle so starfield + Earth pulse animate.
    stageEl?.start?.()
  }
  stageEl?.addEventListener('sui-stage:ready', onReady)
  // Catch-up: when multiple games share a page (the arcade window mounts
  // all three), `sui-stage:ready` can have already fired before THIS
  // script's listener attached. Synthesise the call.
  if (stageEl?.stage) onReady()

  root?.addEventListener('click', (ev) => {
    const target = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-action]')
    if (!target) return
    const action = target.dataset.action ?? ''
    if (action.startsWith('level-')) game?.loadLevel(Number(action.slice(6)))
    else if (action === 'next') stageEl?.next?.()
    else if (action === 'levels') game?.start() // back to level-select
    else if (action === 'retry' || action === 'replay') stageEl?.restart?.()
  })

  document.addEventListener('keydown', (ev) => {
    const state = overlay?.dataset.state
    if (state === 'cleared' && (ev.key === 'Enter' || ev.key === ' ')) {
      ev.preventDefault()
      if (overlay?.querySelector('[data-action="next"]')) stageEl?.next?.()
      else game?.start()
      return
    }
    if (state === 'failed' && (ev.key === 'Enter' || ev.key === ' ')) { ev.preventDefault(); stageEl?.restart?.(); return }
    if ((ev.key === 'r' || ev.key === 'R') && !state) stageEl?.restart?.()
  })

  // Pointer-drag aim: pointerdown anywhere → start aiming relative to the
  // launch pad position, pointermove → update aim, pointerup → fire.
  let aiming = false
  function logicalCoords(ev: PointerEvent): { x: number; y: number } | null {
    if (!stageEl) return null
    const rect = stageEl.getBoundingClientRect()
    if (rect.width === 0) return null
    const x = ((ev.clientX - rect.left) / rect.width) * LOGICAL_W
    const y = ((ev.clientY - rect.top) / rect.height) * LOGICAL_H
    return { x, y }
  }
  stageEl?.addEventListener('pointerdown', (ev) => {
    if (overlay?.dataset.state) return
    aiming = true
    const p = logicalCoords(ev as PointerEvent)
    if (!p || !stageEl) return
    updateAimFromPoint(p.x, p.y)
  })
  stageEl?.addEventListener('pointermove', (ev) => {
    if (!aiming) return
    const p = logicalCoords(ev as PointerEvent)
    if (!p) return
    updateAimFromPoint(p.x, p.y)
  })
  stageEl?.addEventListener('pointerup', () => {
    if (!aiming) return
    aiming = false
    stageEl?.fire?.()
  })
  stageEl?.addEventListener('pointercancel', () => { aiming = false })

  // Drag from the pad: direction sets the angle, distance sets the thrust.
  // ~24px of drag = minimum power, ~180px = full power, clamped between.
  const DRAG_MIN = 24
  const DRAG_MAX = 180
  function updateAimFromPoint(px: number, py: number) {
    if (!game || !stageEl) return
    const idx = game.levelIndex()
    const pad = LEVELS[idx]?.launch ?? { x: 240, y: 470 }
    const dx = px - pad.x
    const dy = py - pad.y
    const angle = Math.atan2(dy, dx)
    const dist = Math.hypot(dx, dy)
    const t = Math.max(0, Math.min(1, (dist - DRAG_MIN) / (DRAG_MAX - DRAG_MIN)))
    const speed = MIN_SPEED + t * (MAX_SPEED - MIN_SPEED)
    stageEl.setAim?.(angle, speed)
  }
</script>
