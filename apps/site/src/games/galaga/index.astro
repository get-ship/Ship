---
// Galaga-style minigame — self-contained module.
//
// Markup declares the static scene (input bindings, HUD, particle emitters).
// The director script runs on `sui-stage:ready`, spawning the player and
// waves through the engine API. Drop this <div> anywhere a stage should
// appear; the script wires itself up.
---

<div class="galaga-mount" data-galaga>
  <sui-stage width="480" height="540" tick-rate="60" fps="60" background="card">
    <sui-input map="ArrowLeft,A" action="move-left"></sui-input>
    <sui-input map="ArrowRight,D" action="move-right"></sui-input>
    <sui-input map="Space,Enter" action="fire" repeat="false"></sui-input>

    <sui-emitter
      kind="radial"
      color="warning"
      lifetime="560"
      spread="360"
      speed="200"
      speed-jitter="0.5"
      size="4..0"
      burst="18"
      max="220"
      on="enemy-die"></sui-emitter>
    <sui-emitter
      kind="cone"
      color="primary"
      lifetime="240"
      direction="-90"
      spread="36"
      speed="240"
      size="2..0"
      burst="5"
      max="80"
      on="player-fire"></sui-emitter>
    <sui-emitter
      kind="explosion"
      color="destructive"
      lifetime="620"
      spread="360"
      speed="180"
      speed-jitter="0.8"
      size="5..0"
      burst="28"
      max="180"
      on="player-hit"></sui-emitter>

    <sui-hud align="corner-tl">
      <div class="galaga-stack galaga-left">
        <div class="galaga-chip">
          <span class="galaga-chip-label">Score</span>
          <span class="galaga-chip-value" data-bind="score">0</span>
        </div>
        <div class="galaga-chip">
          <span class="galaga-chip-label">Wave</span>
          <span class="galaga-chip-value" data-bind="wave">Wave 1</span>
        </div>
      </div>
    </sui-hud>

    <sui-hud align="corner-tr">
      <div class="galaga-stack galaga-right">
        <div class="galaga-chip">
          <span class="galaga-chip-label">Hi</span>
          <span class="galaga-chip-value" data-bind="high">0</span>
        </div>
        <div class="galaga-chip galaga-chip-shield">
          <span class="galaga-chip-label">Shields</span>
          <span class="galaga-shield-bar"><span class="galaga-shield-fill" data-bind="shields" data-bind-attr="data-pct">100</span></span>
        </div>
      </div>
    </sui-hud>

    <sui-hud align="center" pointer-events="auto">
      <div class="galaga-overlay" data-overlay></div>
    </sui-hud>
  </sui-stage>
</div>

<style is:global>
  .galaga-mount {
    display: inline-block;
    position: relative;
    line-height: 0;
  }
  .galaga-mount sui-stage {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 480 / 540;
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--border) 60%, transparent),
      0 24px 60px -16px color-mix(in oklch, var(--primary) 25%, transparent),
      0 8px 32px -12px color-mix(in oklch, var(--foreground) 24%, transparent);
    border-radius: 14px;
  }

  /* HUD chips */
  .galaga-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-body, system-ui);
    pointer-events: none;
    line-height: 1.2;
  }
  .galaga-right { align-items: flex-end; }

  .galaga-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 92px;
    padding: 6px 10px 7px;
    background: color-mix(in oklch, var(--card, #0a0d12) 35%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 24%, transparent);
    border-radius: 8px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--foreground, #fff);
  }
  .galaga-right .galaga-chip { align-items: flex-end; }

  .galaga-chip-label {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  .galaga-chip-value {
    font-size: 18px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .galaga-chip-shield { min-width: 132px; }
  .galaga-shield-bar {
    display: block;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--foreground, #fff) 18%, transparent);
    overflow: hidden;
    margin-top: 4px;
    position: relative;
  }
  .galaga-shield-fill {
    display: block;
    height: 100%;
    width: var(--shield-pct, 100%);
    background: linear-gradient(
      90deg,
      color-mix(in oklch, var(--destructive) 60%, var(--primary)),
      var(--primary)
    );
    border-radius: inherit;
    transition: width 200ms ease-out;
    font-size: 0;
    color: transparent;
  }

  /* Game overlay */
  .galaga-overlay {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 36px 24px;
    min-width: 240px;
    text-align: center;
    color: var(--foreground, #fff);
    background: color-mix(in oklch, var(--card, #0a0d12) 78%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 30%, transparent);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 16px 48px -16px color-mix(in oklch, var(--foreground, #000) 40%, transparent);
    font-family: var(--font-body, system-ui);
  }
  .galaga-overlay[data-state] { display: flex; }
  .galaga-overlay-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .galaga-overlay-title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    font-family: var(--font-display, var(--font-body, system-ui));
  }
  .galaga-overlay-meta {
    font-size: 13px;
    opacity: 0.78;
    line-height: 1.45;
    max-width: 32ch;
  }
  .galaga-overlay-keys {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 11px;
    opacity: 0.85;
  }
  .galaga-key {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 5px;
    background: color-mix(in oklch, var(--foreground, #fff) 12%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground, #fff) 22%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .galaga-cta {
    appearance: none;
    border: none;
    margin-top: 4px;
    padding: 10px 22px;
    border-radius: 8px;
    background: var(--primary);
    color: var(--primary-foreground);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 80ms ease-out, filter 80ms ease-out;
  }
  .galaga-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .galaga-cta:active { transform: translateY(0); filter: brightness(0.96); }
  .galaga-cta:focus-visible {
    outline: 2px solid var(--ring, var(--primary));
    outline-offset: 3px;
  }
</style>

<script>
  // '@ship/arcade/bundle' (pixi, ~800KB) is lazy-imported by ArcadeWindow on
  // first open — not statically here, so the homepage never downloads it.
  import type { Stage } from '@ship/arcade-engine'
  import { effect } from '@ship/sui-runtime'
  import { createGalagaDirector } from './director.ts'

  const root = document.querySelector<HTMLElement>('[data-galaga]')
  const stageEl = root?.querySelector('sui-stage') as (HTMLElement & {
    stage?: Stage
    start?(): void
    pause?(): void
    resume?(): void
  }) | null
  const overlay = root?.querySelector<HTMLElement>('[data-overlay]')

  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const node = document.createElement(tag)
    if (cls) node.className = cls
    if (text !== undefined) node.textContent = text
    return node
  }
  function key(label: string): HTMLElement {
    return el('span', 'galaga-key', label)
  }

  function clearOverlay() {
    if (!overlay) return
    delete overlay.dataset.state
    overlay.replaceChildren()
  }
  function showStart() {
    if (!overlay) return
    overlay.replaceChildren()
    overlay.dataset.state = 'idle'
    const eyebrow = el('div', 'galaga-overlay-eyebrow', 'SHIP Arcade')
    const title = el('div', 'galaga-overlay-title', 'Galaga')
    const meta = el('div', 'galaga-overlay-meta', 'Defend the formation. Clear three waves to win.')
    const keys = el('div', 'galaga-overlay-keys')
    keys.append(key('←'), key('→'), key('A'), key('D'), key('Space'))
    const cta = el('button', 'galaga-cta', 'Start') as HTMLButtonElement
    cta.type = 'button'
    cta.dataset.action = 'start'
    overlay.append(eyebrow, title, meta, keys, cta)
    cta.focus({ preventScroll: true })
  }
  function showEnd(won: boolean, score: number, high: number) {
    if (!overlay) return
    // Always rebuild from scratch — the reactive effect can fire more than
    // once when high-score or score updates after the state transition,
    // and appending without clearing would stack duplicate CTAs.
    overlay.replaceChildren()
    overlay.dataset.state = won ? 'won' : 'over'
    const eyebrow = el('div', 'galaga-overlay-eyebrow', won ? 'Victory' : 'Wreckage')
    const title = el('div', 'galaga-overlay-title', won ? 'Formation Cleared' : 'Game Over')
    const meta = el('div', 'galaga-overlay-meta', `Score ${score.toLocaleString()} · High ${high.toLocaleString()}`)
    const cta = el('button', 'galaga-cta', won ? 'Play Again' : 'Retry') as HTMLButtonElement
    cta.type = 'button'
    cta.dataset.action = 'restart'
    overlay.append(eyebrow, title, meta, cta)
    cta.focus({ preventScroll: true })
  }

  let game: ReturnType<typeof createGalagaDirector> | null = null
  let stopGameStateEffect: (() => void) | null = null
  let stopShieldEffect: (() => void) | null = null

  function bindShieldBar(g: NonNullable<typeof game>) {
    stopShieldEffect?.()
    const fill = root?.querySelector<HTMLElement>('.galaga-shield-fill')
    if (!fill) return
    stopShieldEffect = effect(() => {
      const v = Math.max(0, Math.min(100, g.shieldsSignal()))
      fill.style.setProperty('--shield-pct', `${v}%`)
    })
  }

  function startGame() {
    if (!stageEl?.stage) return
    if (game) game.destroy()
    stopGameStateEffect?.()
    const next = createGalagaDirector({ stage: stageEl.stage, stageHost: stageEl })
    game = next
    stopGameStateEffect = effect(() => {
      const phase = next.stateSignal()
      if (phase === 'over' || phase === 'won') {
        showEnd(phase === 'won', next.scoreSignal(), next.highSignal())
      }
    })
    bindShieldBar(next)
    clearOverlay()
    next.start()
  }

  function onReady() { showStart() }
  stageEl?.addEventListener('sui-stage:ready', onReady)
  // Multiple games can share the page (arcade window mounts all three);
  // the ready event may have already fired before this script attached.
  if (stageEl?.stage) onReady()

  root?.addEventListener('click', (ev) => {
    const target = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-action]')
    if (!target) return
    if (target.dataset.action === 'start' || target.dataset.action === 'restart') startGame()
  })

  document.addEventListener('keydown', (ev) => {
    if (!overlay?.dataset.state) return
    if (ev.key === 'Enter' || ev.key === ' ') {
      ev.preventDefault()
      startGame()
    }
  })
</script>
