---
// Particle Garden — territorial-growth minigame.
//
// You vs an AI. Drop seeds on the grid; tendrils spread via cellular-automata
// growth. Most territory at the end wins. 75-second rounds, 1.6s seed
// cooldown, real-time growth at ~8 cps.
---

<div class="garden-mount" data-garden>
  <sui-stage width="480" height="540" tick-rate="60" fps="60" background="card">
    <sui-stage-input map="ArrowLeft,A" action="cursor-left"></sui-stage-input>
    <sui-stage-input map="ArrowRight,D" action="cursor-right"></sui-stage-input>
    <sui-stage-input map="ArrowUp,W" action="cursor-up"></sui-stage-input>
    <sui-stage-input map="ArrowDown,S" action="cursor-down"></sui-stage-input>
    <sui-stage-input map="Space,Enter" action="plant" repeat="false"></sui-stage-input>

    <sui-hud align="corner-tl">
      <div class="garden-stack garden-left">
        <div class="garden-chip garden-chip-self">
          <span class="garden-chip-label">You</span>
          <span class="garden-chip-value" data-bind="self">0</span>
        </div>
      </div>
    </sui-hud>

    <sui-hud align="corner-tr">
      <div class="garden-stack garden-right">
        <div class="garden-chip garden-chip-opp">
          <span class="garden-chip-label">Rival</span>
          <span class="garden-chip-value" data-bind="opp">0</span>
        </div>
      </div>
    </sui-hud>

    <sui-hud align="top">
      <div class="garden-timer">
        <span class="garden-timer-value" data-bind="time">75</span>
        <span class="garden-timer-unit">s</span>
      </div>
    </sui-hud>

    <sui-hud align="bottom">
      <div class="garden-cooldown" aria-hidden="true">
        <span class="garden-cooldown-fill" data-cooldown></span>
      </div>
    </sui-hud>

    <sui-hud align="center" pointer-events="auto">
      <div class="garden-overlay" data-overlay></div>
    </sui-hud>
  </sui-stage>
</div>

<style is:global>
  .garden-mount {
    display: inline-block;
    position: relative;
    line-height: 0;
  }
  .garden-mount sui-stage {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 480 / 540;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--border) 60%, transparent),
      0 24px 60px -16px color-mix(in oklch, var(--primary) 22%, transparent),
      0 8px 32px -12px color-mix(in oklch, var(--foreground) 18%, transparent);
    cursor: crosshair;
  }

  .garden-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-body, system-ui);
    pointer-events: none;
    line-height: 1.2;
  }
  .garden-right { align-items: flex-end; }
  .garden-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 96px;
    padding: 6px 10px 7px;
    background: color-mix(in oklch, var(--card, #000) 40%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 24%, transparent);
    border-radius: 8px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--foreground, #fff);
  }
  .garden-right .garden-chip { align-items: flex-end; }
  .garden-chip-self { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--primary) 38%, transparent); }
  .garden-chip-opp  { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--destructive) 38%, transparent); }
  .garden-chip-label {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .garden-chip-value {
    font-size: 22px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .garden-chip-self .garden-chip-value { color: var(--primary); }
  .garden-chip-opp  .garden-chip-value { color: var(--destructive); }

  .garden-timer {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    padding: 6px 14px;
    background: color-mix(in oklch, var(--card, #000) 60%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 28%, transparent);
    border-radius: 999px;
    color: var(--foreground, #fff);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-family: var(--font-body, system-ui);
  }
  .garden-timer-value {
    font-size: 18px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .garden-timer-unit {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .garden-cooldown {
    width: 200px;
    height: 4px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--foreground, #fff) 16%, transparent);
    overflow: hidden;
    pointer-events: none;
  }
  .garden-cooldown-fill {
    display: block;
    height: 100%;
    width: var(--cooldown-pct, 0%);
    background: linear-gradient(90deg, var(--primary), color-mix(in oklch, var(--primary) 50%, var(--warning)));
    border-radius: inherit;
    transition: width 80ms linear;
  }

  .garden-overlay {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 36px 24px;
    min-width: 250px;
    text-align: center;
    color: var(--foreground, #fff);
    background: color-mix(in oklch, var(--card, #0a0d12) 80%, transparent);
    border: 1px solid color-mix(in oklch, var(--border, #fff) 30%, transparent);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 16px 48px -16px color-mix(in oklch, var(--foreground, #000) 40%, transparent);
    font-family: var(--font-body, system-ui);
  }
  .garden-overlay[data-state] { display: flex; }
  .garden-overlay-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .garden-overlay-title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    font-family: var(--font-display, var(--font-body, system-ui));
  }
  .garden-overlay-meta {
    font-size: 13px;
    opacity: 0.78;
    line-height: 1.45;
    max-width: 36ch;
  }
  .garden-overlay-keys {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 11px;
    opacity: 0.85;
  }
  .garden-key {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 5px;
    background: color-mix(in oklch, var(--foreground, #fff) 12%, transparent);
    border: 1px solid color-mix(in oklch, var(--foreground, #fff) 22%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .garden-cta {
    appearance: none;
    border: none;
    margin-top: 4px;
    padding: 10px 22px;
    border-radius: 8px;
    background: var(--primary);
    color: var(--primary-foreground);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 80ms ease-out, filter 80ms ease-out;
  }
  .garden-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .garden-cta:active { transform: translateY(0); filter: brightness(0.96); }
  .garden-cta:focus-visible {
    outline: 2px solid var(--ring, var(--primary));
    outline-offset: 3px;
  }

  .garden-bars {
    display: flex;
    gap: 4px;
    width: 100%;
    height: 8px;
    margin-top: 4px;
  }
  .garden-bar {
    height: 100%;
    background: var(--bar-color);
    border-radius: 4px;
    min-width: 2px;
    transition: flex 220ms ease-out;
  }
</style>

<script>
  // '@ship/arcade/bundle' (pixi, ~800KB) is lazy-imported by ArcadeWindow on
  // first open — not statically here, so the homepage never downloads it.
  import type { Stage } from '@ship/arcade-engine'
  import { effect } from '@ship/sui-runtime'
  import { createGardenDirector } from './director.ts'

  const root = document.querySelector<HTMLElement>('[data-garden]')
  const stageEl = root?.querySelector('sui-stage') as (HTMLElement & {
    stage?: Stage
    start?(): void
    pause?(): void
    resume?(): void
    plantAt?(x: number, y: number): void
    moveCursorTo?(x: number, y: number): void
  }) | null
  const overlay = root?.querySelector<HTMLElement>('[data-overlay]')
  const cooldownEl = root?.querySelector<HTMLElement>('[data-cooldown]')

  const LOGICAL_W = 480
  const LOGICAL_H = 540
  const SEED_COOLDOWN = 1.55

  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const node = document.createElement(tag)
    if (cls) node.className = cls
    if (text !== undefined) node.textContent = text
    return node
  }
  function key(label: string): HTMLElement { return el('span', 'garden-key', label) }

  function showStart() {
    if (!overlay) return
    overlay.replaceChildren()
    overlay.dataset.state = 'idle'
    const eyebrow = el('div', 'garden-overlay-eyebrow', 'SHIP Arcade')
    const title = el('div', 'garden-overlay-title', 'Particle Garden')
    const meta = el('div', 'garden-overlay-meta', 'Drop seeds. Tendrils spread. Hold more ground than your rival before the clock runs out.')
    const keys = el('div', 'garden-overlay-keys')
    keys.append(key('Click'), key('Space'), key('↑ ↓ ← →'))
    const cta = el('button', 'garden-cta', 'Plant') as HTMLButtonElement
    cta.type = 'button'
    cta.dataset.action = 'start'
    overlay.append(eyebrow, title, meta, keys, cta)
    cta.focus({ preventScroll: true })
  }
  function showEnd(state: 'won' | 'lost' | 'draw', selfPct: number, oppPct: number) {
    if (!overlay) return
    overlay.replaceChildren()
    overlay.dataset.state = state
    const eyebrow = el('div', 'garden-overlay-eyebrow', state === 'won' ? 'Bloom' : state === 'lost' ? 'Wilted' : 'Stalemate')
    const title = el('div', 'garden-overlay-title', state === 'won' ? 'You held the field' : state === 'lost' ? 'Outgrown' : 'A draw')
    const meta = el('div', 'garden-overlay-meta', `You ${selfPct}% · Rival ${oppPct}%`)
    const bars = el('div', 'garden-bars')
    const selfBar = el('div', 'garden-bar') as HTMLElement
    selfBar.style.setProperty('--bar-color', 'var(--primary)')
    selfBar.style.flex = String(Math.max(1, selfPct))
    const oppBar = el('div', 'garden-bar') as HTMLElement
    oppBar.style.setProperty('--bar-color', 'var(--destructive)')
    oppBar.style.flex = String(Math.max(1, oppPct))
    bars.append(selfBar, oppBar)
    const cta = el('button', 'garden-cta', 'Plant Again') as HTMLButtonElement
    cta.type = 'button'
    cta.dataset.action = 'restart'
    overlay.append(eyebrow, title, meta, bars, cta)
    cta.focus({ preventScroll: true })
  }
  function clearOverlay() {
    if (!overlay) return
    delete overlay.dataset.state
    overlay.replaceChildren()
  }

  let game: ReturnType<typeof createGardenDirector> | null = null
  let stopEndEffect: (() => void) | null = null
  let stopCooldownEffect: (() => void) | null = null

  function bindCooldown(g: NonNullable<typeof game>) {
    stopCooldownEffect?.()
    if (!cooldownEl) return
    stopCooldownEffect = effect(() => {
      const remaining = g.cooldown()
      const pct = Math.max(0, Math.min(1, 1 - remaining / SEED_COOLDOWN))
      cooldownEl.style.setProperty('--cooldown-pct', `${(pct * 100).toFixed(1)}%`)
    })
  }

  function totalCells(): number {
    return 22 * 24 // COLS * ROWS from grid.ts — kept in sync manually for now
  }

  function ensureGame() {
    if (game || !stageEl?.stage) return
    game = createGardenDirector({ stage: stageEl.stage, stageHost: stageEl })
    stopEndEffect?.()
    stopEndEffect = effect(() => {
      const g = game
      if (!g) return
      const s = g.state()
      if (s === 'won' || s === 'lost' || s === 'draw') {
        const total = totalCells()
        const selfPct = Math.round((g.scoreSelf() / total) * 100)
        const oppPct = Math.round((g.scoreOpp() / total) * 100)
        showEnd(s, selfPct, oppPct)
      }
    })
    bindCooldown(game)
  }

  function startGame() {
    ensureGame()
    if (!game) return
    clearOverlay()
    game.start()
  }

  function onReady() {
    // Create the director on ready so the empty grid is visible on the idle
    // overlay. The director spawns + paints the grid in its constructor;
    // start() resets state and runs the loop on user input.
    ensureGame()
    showStart()
  }
  stageEl?.addEventListener('sui-stage:ready', onReady)
  // Stage may have fired ready BEFORE this script ran (Astro bundles
  // multiple game scripts independently; all 3 stages can mount before
  // the second/third script attaches its listener). Catch up.
  if (stageEl?.stage) onReady()

  root?.addEventListener('click', (ev) => {
    const target = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-action]')
    if (!target) return
    if (target.dataset.action === 'start' || target.dataset.action === 'restart') startGame()
  })

  document.addEventListener('keydown', (ev) => {
    if (!overlay?.dataset.state) return
    if (ev.key === 'Enter' || ev.key === ' ') {
      ev.preventDefault()
      startGame()
    }
  })

  // Pointer → logical-coord translation. The stage CSS-scales the canvas;
  // we map client coords back to the 480×540 game space.
  function logicalCoords(ev: PointerEvent): { x: number; y: number } | null {
    if (!stageEl) return null
    const rect = stageEl.getBoundingClientRect()
    if (rect.width === 0) return null
    const x = ((ev.clientX - rect.left) / rect.width) * LOGICAL_W
    const y = ((ev.clientY - rect.top) / rect.height) * LOGICAL_H
    return { x, y }
  }
  stageEl?.addEventListener('pointermove', (ev) => {
    const p = logicalCoords(ev as PointerEvent)
    if (p) stageEl?.moveCursorTo?.(p.x, p.y)
  })
  stageEl?.addEventListener('pointerdown', (ev) => {
    if ((ev as PointerEvent).button !== 0) return
    if (overlay?.dataset.state) return
    const p = logicalCoords(ev as PointerEvent)
    if (p) stageEl?.plantAt?.(p.x, p.y)
  })
</script>
