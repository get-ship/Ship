// apps/spaces/deck.jsonc — the space scaffold defines the space scaffold.
//
// Per-app serve config (the `AppServeConfig` shape deck consumes). Loaded by
// shipd via the app-registration port; deck-config owns the schema + parser.
//
// Schema:
//   name        string             logical app name / URL namespace
//   route       string             URL route pattern; `{id}` is a path capture
//   source      string             repo-relative bundler output (served assets)
//   viewOutput? string             repo-relative compiled-view bundle dir
//   render      "csr" | "ssr"      first-frame paint; surfaced as
//                                  <meta name="ship-render"> (default "csr")
//   injectGlobals? { string: string }  window.<k>=<v>; $<param> from route caps
//
// `$id` resolves to the captured `{id}` segment → window.DECK_APP_ID on load.
{
  "name": "spaces",
  "route": "/space/{id}",
  "source": "apps/spaces/.deck",
  "render": "csr",
  "injectGlobals": { "DECK_APP_ID": "$id" }
}
