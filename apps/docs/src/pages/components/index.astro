---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  componentsByCategory,
  CATEGORY_LABELS,
  CATEGORY_ORDER,
  COMPONENTS,
} from '../../lib/components';
import { getShots } from '../../lib/samples';

const buckets = componentsByCategory();
const populated = CATEGORY_ORDER.filter((c) => buckets[c].length > 0);

---

<StarlightPage
  frontmatter={{
    title: 'Components',
    description: `${COMPONENTS.length} web components for AI-native apps.`,
    template: 'splash',
    tableOfContents: false,
  }}
>
  <div class="not-content idx-root cmp-root canvas-root">
    {/* Floating ← Docs badge — same affordance as the tutorial.
        Lives on every canvas surface (.canvas-root) via the
        global style in ship-theme.css. */}
    <a href="/" class="canvas-back" aria-label="Back to docs home">
      <span aria-hidden="true">←</span> Docs
    </a>
  <section class="idx-hero">
    <div class="idx-hero-copy">
      <h2 class="idx-hero-title">Live, in the page you're reading.</h2>
      <p class="idx-hero-blurb">
        Every <code>&lt;sui-*&gt;</code> tag in these docs is a real
        custom element registered globally by <code>/sui-components.js</code>.
        Try the controls — they react with the same runtime the
        Ship daemon ships.
      </p>
    </div>
    <div class="idx-hero-demo">
      <sui-tabs active="primitives" variant="segmented" size="sm">
        <sui-tab name="primitives" label="Primitives"></sui-tab>
        <sui-tab name="form" label="Form"></sui-tab>
        <sui-tab name="status" label="Status"></sui-tab>

        <sui-tab-panel name="primitives">
          <div class="idx-hero-row">
            <sui-button tone="primary" variant="solid" size="sm">Primary</sui-button>
            <sui-button variant="outline" size="sm">Outline</sui-button>
            <sui-button variant="ghost" size="sm">Ghost</sui-button>
            <sui-badge tone="accent" variant="soft" size="sm">accent</sui-badge>
            <sui-badge tone="success" variant="soft" size="sm">ok</sui-badge>
            <sui-chip tone="info">mcp</sui-chip>
          </div>
        </sui-tab-panel>

        <sui-tab-panel name="form">
          <div class="idx-hero-form">
            <sui-input placeholder="agent name" style="flex:1;min-width:160px;"></sui-input>
            <sui-select size="sm">
              <option>plan</option>
              <option selected>review</option>
              <option>qa</option>
            </sui-select>
            <sui-switch checked></sui-switch>
            <sui-button tone="primary" variant="solid" size="sm">Save</sui-button>
          </div>
        </sui-tab-panel>

        <sui-tab-panel name="status">
          <div class="idx-hero-row">
            <sui-status-dot tone="success" pulse label="live"></sui-status-dot>
            <sui-spinner tone="accent"></sui-spinner>
            <sui-progress value="62" max="100" tone="primary" label="62%" style="width:160px;"></sui-progress>
            <sui-kbd keys="⌘ K"></sui-kbd>
          </div>
        </sui-tab-panel>
      </sui-tabs>
    </div>
  </section>

  <section class="idx-head">
    <p class="idx-sub">
      {COMPONENTS.length} web components, grouped. Click any card for
      the full API, source, and variants.
    </p>
    <div class="idx-controls">
      <input
        type="search"
        class="idx-search"
        placeholder="Search components…"
        data-idx-search
        autocomplete="off"
      />
      <div class="idx-pills" role="tablist">
        <button type="button" class="idx-pill is-active" data-cat="all">All</button>
        {populated.map((cat) => (
          <button type="button" class="idx-pill" data-cat={cat}>{CATEGORY_LABELS[cat]}</button>
        ))}
      </div>
    </div>
  </section>

  {populated.map((cat) => (
    <section class="idx-group" id={cat} data-idx-group={cat}>
      <header class="idx-group-head">
        <h2>{CATEGORY_LABELS[cat]}</h2>
        <span class="idx-count">{buckets[cat].length}</span>
      </header>
      <div class="idx-grid">
        {buckets[cat].map((c) => {
          const firstShot = getShots(c.tag)[0];
          let previewHtml: string;
          let isOverlay = false;
          if (firstShot.overlay) {
            isOverlay = true;
            previewHtml = `<code class="idx-overlay-hint">${c.tag}</code>`;
          } else if (firstShot.raw) {
            previewHtml = firstShot.raw;
          } else {
            const attrs = firstShot.attrs
              ? Object.entries(firstShot.attrs)
                  .map(([k, v]) => (v === '' ? ` ${k}` : ` ${k}="${v}"`))
                  .join('')
              : '';
            const body = firstShot.innerHTML ?? '';
            previewHtml = `<${c.tag}${attrs}>${body}</${c.tag}>`;
          }
          return (
            <a
              class:list={['idx-card', isOverlay && 'idx-card-overlay']}
              href={`/components/${c.tag}/`}
              data-idx-card
              data-idx-tag={c.tag}
              data-idx-summary={c.summary.toLowerCase()}
            >
              <div class="idx-card-preview" set:html={previewHtml}></div>
              <div class="idx-card-meta">
                <code class="idx-card-tag">{c.tag}</code>
              </div>
              {c.summary && <p class="idx-card-sum">{c.summary}</p>}
            </a>
          );
        })}
      </div>
    </section>
  ))}
  </div>
</StarlightPage>

<script>
  // Some components don't render visibly without children or props (closed-by-
  // default overlays, group wrappers, etc.). After custom-element upgrade,
  // detect previews that collapsed to 0×0 and replace with a tag-name hint
  // matching the explicit overlay style.
  const swapEmpty = () => {
    document.querySelectorAll<HTMLElement>('.idx-card-preview').forEach((preview) => {
      const child = preview.firstElementChild as HTMLElement | null;
      if (!child) return;
      if (child.classList.contains('idx-overlay-hint')) return;
      const w = child.offsetWidth;
      const h = child.offsetHeight;
      if (w < 4 || h < 4) {
        const tag = child.tagName.toLowerCase();
        preview.innerHTML = `<code class="idx-overlay-hint">${tag}</code>`;
        preview.parentElement?.classList.add('idx-card-overlay');
      }
    });
  };
  // Wait for the elements bundle to upgrade everything, then check.
  requestAnimationFrame(() => requestAnimationFrame(swapEmpty));

  const input = document.querySelector<HTMLInputElement>('[data-idx-search]');
  const pills = document.querySelectorAll<HTMLButtonElement>('.idx-pill');
  const cards = document.querySelectorAll<HTMLElement>('[data-idx-card]');
  const groups = document.querySelectorAll<HTMLElement>('[data-idx-group]');

  let query = '';
  let cat = 'all';

  const apply = () => {
    const q = query.trim().toLowerCase();
    for (const card of cards) {
      const tag = card.dataset.idxTag ?? '';
      const sum = card.dataset.idxSummary ?? '';
      const group = card.closest<HTMLElement>('[data-idx-group]');
      const inCat = cat === 'all' || group?.dataset.idxGroup === cat;
      const inQ = !q || tag.includes(q) || sum.includes(q);
      card.style.display = inCat && inQ ? '' : 'none';
    }
    for (const g of groups) {
      const visible = Array.from(g.querySelectorAll<HTMLElement>('[data-idx-card]')).some((c) => c.style.display !== 'none');
      g.style.display = visible ? '' : 'none';
    }
  };

  input?.addEventListener('input', () => { query = input.value; apply(); });
  for (const pill of pills) {
    pill.addEventListener('click', () => {
      cat = pill.dataset.cat ?? 'all';
      for (const p of pills) p.classList.toggle('is-active', p === pill);
      apply();
    });
  }
</script>

<style>
  /* Canvas wrapper — full viewport minus the top nav. Owns its
     own padding + scrolling internally; the body never scrolls. */
  .cmp-root {
    height: calc(100dvh - var(--sl-nav-height));
    overflow-y: auto;
    overflow-x: hidden;
    padding: 32px 24px 24px;
    box-sizing: border-box;
    position: relative;
  }
  .cmp-root::-webkit-scrollbar { width: 8px; }
  .cmp-root::-webkit-scrollbar-thumb {
    background: var(--sl-color-hairline-shade);
    border-radius: 999px;
  }

  .idx-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    padding: 4px 0 24px;
    border-bottom: 1px solid color-mix(in oklch, var(--sl-color-gray-5) 60%, transparent);
    margin-bottom: 18px;
  }
  @media (min-width: 60rem) {
    .idx-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); align-items: start; }
  }
  .idx-hero-title {
    font-size: clamp(20px, 2vw, 26px);
    letter-spacing: -0.015em;
    margin: 0 0 6px;
    border: none;
    padding: 0;
    color: var(--sl-color-white);
  }
  .idx-hero-blurb {
    color: var(--sl-color-gray-2);
    font-size: 14px;
    line-height: 1.55;
    margin: 0;
    max-width: 56ch;
  }
  .idx-hero-blurb code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--sl-color-gray-5) 35%, transparent);
    color: var(--sl-color-white);
  }
  .idx-hero-demo {
    padding: 14px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--sl-color-black);
  }
  .idx-hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    padding: 12px 4px 4px;
  }
  .idx-hero-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px 4px 4px;
  }

  .idx-head {
    padding: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .idx-sub { color: var(--sl-color-gray-2); max-width: 56ch; }

  .idx-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 6px;
  }
  .idx-search {
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    font-size: 14px;
  }
  .idx-search:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--sl-color-accent) 22%, transparent);
  }
  .idx-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .idx-pill {
    appearance: none;
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    border-radius: 999px;
    cursor: pointer;
  }
  .idx-pill:hover { color: var(--sl-color-white); }
  .idx-pill.is-active {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border-color: var(--sl-color-accent);
  }

  .idx-group {
    padding: 22px 0 8px;
    scroll-margin-top: 70px;
  }
  .idx-group-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
  }
  .idx-group-head h2 {
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    border: none;
    margin: 0;
    padding: 0;
  }
  .idx-count {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11px;
    color: var(--sl-color-gray-2);
  }
  .idx-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 380px));
    gap: 14px;
    justify-content: start;
  }
  .idx-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--sl-color-black);
    text-decoration: none;
    color: inherit;
    min-height: 180px;
    transition: border-color 120ms ease-out, transform 120ms ease-out;
  }
  .idx-card:hover {
    border-color: color-mix(in oklch, var(--sl-color-accent) 45%, transparent);
    transform: translateY(-1px);
  }
  .idx-card-preview {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 12px 8px;
    min-height: 88px;
  }
  .idx-card-meta { display: flex; align-items: center; gap: 8px; }
  .idx-card-tag {
    font-family: var(--sl-font-mono, monospace);
    font-size: 12px;
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .idx-card-sum {
    font-size: 12px;
    color: var(--sl-color-gray-2);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
  .idx-card-overlay .idx-card-preview { padding: 14px 8px; }
  .idx-overlay-hint {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px dashed var(--sl-color-gray-4);
    color: var(--sl-color-gray-2);
  }
</style>
