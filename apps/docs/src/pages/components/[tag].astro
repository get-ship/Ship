---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  COMPONENTS,
  COMPONENTS_BY_TAG,
  CATEGORY_LABELS,
} from '../../lib/components';
import { getShots, type ComponentShot } from '../../lib/samples';

export function getStaticPaths() {
  return COMPONENTS.map((c) => ({ params: { tag: c.tag } }));
}

const { tag } = Astro.params;
const doc = COMPONENTS_BY_TAG[tag!];
if (!doc) throw new Error(`Missing component doc for ${tag}`);

const shots = getShots(doc.tag);

function escapeAttr(v: string): string {
  return v.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
}

function attrsToString(attrs?: Record<string, string>): string {
  if (!attrs) return '';
  return Object.entries(attrs)
    .map(([k, v]) => (v === '' ? ` ${k}` : ` ${k}="${escapeAttr(v)}"`))
    .join('');
}

function shotMarkup(tag: string, shot: ComponentShot): string {
  if (shot.raw) return shot.raw;
  const open = `<${tag}${attrsToString(shot.attrs)}>`;
  const close = `</${tag}>`;
  const body = shot.innerHTML ?? '';
  return body.includes('\n')
    ? `${open}\n${body.trim()
        .split('\n')
        .map((l) => '  ' + l)
        .join('\n')}\n${close}`
    : `${open}${body}${close}`;
}

const codeShots = shots.filter((s) => !s.overlay);
const overlayShots = shots.filter((s) => s.overlay);
const allCode = codeShots.map((s) => shotMarkup(doc.tag, s)).join('\n\n');

---

<StarlightPage
  frontmatter={{
    title: doc.tag,
    description: doc.summary || `${doc.tag} web component API reference.`,
  }}

>
  <article class="cmp-page not-content">
    <header class="cmp-head">
      <div class="cmp-breadcrumb">
        <a href="/components/">Components</a>
        <span>/</span>
        <span>{CATEGORY_LABELS[doc.category]}</span>
      </div>
      {doc.summary && <p class="cmp-summary">{doc.summary}</p>}
      <div class="cmp-meta">
        <code class="cmp-meta-badge">{doc.className}</code>
        <code class="cmp-meta-badge">{CATEGORY_LABELS[doc.category]}</code>
        <code class="cmp-meta-path">{doc.path}</code>
      </div>
    </header>

    <section class="cmp-section">
      <h2 class="cmp-h2">Preview</h2>
      <div class="cmp-preview">
        <div
          class:list={['cmp-preview-surface', codeShots.length === 1 && !codeShots[0].label?.startsWith('Inside ') && 'cmp-preview-surface-solo']}
        >
          {codeShots.length > 0 && (
            <div class:list={['cmp-shots', codeShots.length === 1 && 'cmp-shots-solo']}>
              {codeShots.map((s) => (
                <div class="cmp-shot">
                  <div class="cmp-shot-body" set:html={shotMarkup(doc.tag, s)}></div>
                  {(codeShots.length > 1 || s.label?.startsWith('Inside ')) && (
                    <div class="cmp-shot-label">{s.label}</div>
                  )}
                </div>
              ))}
            </div>
          )}
          {overlayShots.length > 0 && (
            <div class="cmp-overlay-notes">
              {overlayShots.map((s) => (
                <div class="cmp-overlay-note">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none">
                    <path d="M4 8h16M4 14h16M4 20h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <rect x="6" y="4" width="12" height="10" rx="2" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                  <div>
                    <div class="cmp-overlay-label">{s.label}</div>
                    <div class="cmp-overlay-caption">{s.caption ?? 'Overlay component — renders in the top layer when opened.'}</div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {codeShots.length > 0 && (
          <details class="cmp-code">
            <summary>
              <span>View source</span>
              <button
                type="button"
                class="cmp-copy"
                data-copy={allCode}
                aria-label="Copy source"
              >Copy</button>
            </summary>
            <pre class="cmp-code-pre"><code>{allCode}</code></pre>
          </details>
        )}
      </div>
    </section>

    {doc.attributes.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">Attributes</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.attributes.map((a) => (
                <tr>
                  <td><code>{a.name}</code></td>
                  <td><code class="cmp-muted">{a.type ?? '—'}</code></td>
                  <td><code class="cmp-muted">{a.default ?? '—'}</code></td>
                  <td>{a.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.slots.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">Slots</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.slots.map((s) => (
                <tr>
                  <td><code>{s.name || '(default)'}</code></td>
                  <td>{s.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.events.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">Events</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Detail</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.events.map((e) => (
                <tr>
                  <td><code>{e.name}</code></td>
                  <td><code class="cmp-muted">{e.type ?? 'CustomEvent'}</code></td>
                  <td>{e.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.parts.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">CSS parts</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.parts.map((p) => (
                <tr>
                  <td><code>::part({p.name})</code></td>
                  <td>{p.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {doc.cssProperties.length > 0 && (
      <section class="cmp-section">
        <h2 class="cmp-h2">CSS custom properties</h2>
        <div class="cmp-table">
          <table>
            <thead>
              <tr><th>Name</th><th>Default</th><th>Description</th></tr>
            </thead>
            <tbody>
              {doc.cssProperties.map((c) => (
                <tr>
                  <td><code>{c.name}</code></td>
                  <td><code class="cmp-muted">{c.default ?? '—'}</code></td>
                  <td>{c.description ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </article>
</StarlightPage>

<script>
  for (const btn of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    btn.addEventListener('click', async (ev) => {
      ev.preventDefault();
      const text = btn.getAttribute('data-copy') ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch {}
    });
  }
</script>

<style>
  .cmp-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-bottom: 64px;
  }

  .cmp-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cmp-breadcrumb {
    display: inline-flex;
    gap: 8px;
    font-size: 12px;
    color: var(--sl-color-gray-2);
  }
  .cmp-breadcrumb a { text-decoration: none; color: var(--sl-color-gray-2); }
  .cmp-breadcrumb a:hover { color: var(--sl-color-white); }

  .cmp-summary {
    color: var(--sl-color-gray-2);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.55;
    max-width: 64ch;
    margin: 0;
  }
  .cmp-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cmp-meta-badge {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11.5px;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }
  .cmp-meta-path {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11.5px;
    color: var(--sl-color-gray-3);
  }

  .cmp-section { display: flex; flex-direction: column; gap: 12px; }
  .cmp-h2 {
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    border: none;
    margin: 0;
    padding: 0;
  }

  .cmp-preview {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    overflow: hidden;
    background: var(--sl-color-black);
  }
  .cmp-preview-surface {
    padding: clamp(28px, 4vw, 56px);
    min-height: 160px;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(
      45deg,
      color-mix(in oklch, var(--sl-color-gray-6) 80%, transparent) 0 1px,
      transparent 1px 10px
    );
  }
  .cmp-preview-surface-solo {
    min-height: 200px;
    padding: clamp(40px, 5vw, 72px) clamp(28px, 4vw, 56px);
  }
  .cmp-shots {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 22px;
    align-items: flex-end;
    justify-content: center;
    max-width: 100%;
  }
  .cmp-shots-solo { gap: 0; }
  .cmp-shot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 80px;
  }
  .cmp-shot-body {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
  }
  .cmp-shot-label {
    font-family: var(--sl-font-mono, monospace);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }

  .cmp-overlay-notes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 520px;
    margin: 0 auto;
  }
  .cmp-overlay-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    padding: 12px 14px;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 6px;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
  }
  .cmp-overlay-note > svg { color: var(--sl-color-accent); margin-top: 1px; }
  .cmp-overlay-label {
    font-weight: 700;
    font-size: 13.5px;
    color: var(--sl-color-white);
  }
  .cmp-overlay-caption {
    font-size: 12.5px;
    line-height: 1.5;
    margin-top: 3px;
  }

  .cmp-code {
    border-top: 1px solid var(--sl-color-gray-5);
    background: color-mix(in oklch, var(--sl-color-gray-6) 50%, transparent);
  }
  .cmp-code summary {
    cursor: pointer;
    list-style: none;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .cmp-code summary::-webkit-details-marker { display: none; }
  .cmp-code[open] summary { color: var(--sl-color-white); }
  .cmp-copy {
    appearance: none;
    padding: 4px 10px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .cmp-copy:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }
  .cmp-code-pre {
    margin: 0;
    padding: 14px 16px 18px;
    font-family: var(--sl-font-mono, monospace);
    font-size: 12.5px;
    line-height: 1.55;
    overflow: auto;
    color: var(--sl-color-white);
    background: transparent;
    border-top: 1px solid var(--sl-color-gray-5);
    tab-size: 2;
  }

  .cmp-table {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    overflow: hidden;
  }
  .cmp-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .cmp-table th,
  .cmp-table td {
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .cmp-table tr:last-child td { border-bottom: 0; }
  .cmp-table th {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    background: color-mix(in oklch, var(--sl-color-gray-6) 50%, transparent);
  }
  .cmp-table td code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--sl-color-gray-5) 40%, transparent);
  }
  .cmp-table td code.cmp-muted { color: var(--sl-color-gray-2); }
</style>
