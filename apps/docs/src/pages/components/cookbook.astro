---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const recipes = [
  {
    id: 'sign-in-card',
    title: 'Sign-in card',
    blurb: 'sui-card as a shell, sui-input for email/password, sui-button for submit + harness.',
    html: `<sui-card variant="outline" padding="lg" style="max-width:380px;">
  <div slot="header" style="font-weight:700;font-size:18px;">Welcome back</div>
  <div style="display:flex;flex-direction:column;gap:10px;margin:10px 0 14px;">
    <sui-input placeholder="you@company.com" type="email"></sui-input>
    <sui-input placeholder="Password" type="password"></sui-input>
  </div>
  <sui-toolbar slot="footer" justify="between">
    <sui-button variant="outline" size="sm">GitHub</sui-button>
    <sui-button tone="primary" variant="solid" size="sm">Sign in</sui-button>
  </sui-toolbar>
</sui-card>`,
  },
  {
    id: 'dashboard-tile',
    title: 'Dashboard tile',
    blurb: 'Stat + sparkline + status badge. Two minutes to ship.',
    html: `<sui-card variant="outline" padding="lg" style="max-width:320px;">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
    <div>
      <div style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted-foreground);">Runs this week</div>
      <div style="font-weight:800;font-size:32px;margin-top:4px;">58</div>
    </div>
    <sui-badge tone="success" variant="soft" size="sm">on budget</sui-badge>
  </div>
  <sui-sparkline data="3,7,5,11,8,14,10" tone="accent" width="280" height="36"></sui-sparkline>
</sui-card>`,
  },
  {
    id: 'filtered-row',
    title: 'Filter bar',
    blurb: 'Search + select + toggle group in a sui-toolbar.',
    html: `<sui-toolbar gap="sm" style="padding:8px 10px;border:1px solid color-mix(in oklch,var(--border) 55%,transparent);border-radius:var(--radius-lg);background:var(--card);">
  <sui-input placeholder="Filter…" style="flex:1;min-width:160px;"></sui-input>
  <sui-select size="sm">
    <option>All</option>
    <option>Active</option>
    <option>Archived</option>
  </sui-select>
  <sui-toggle-group>
    <button data-value="list" aria-pressed="true">List</button>
    <button data-value="grid">Grid</button>
  </sui-toggle-group>
</sui-toolbar>`,
  },
  {
    id: 'pipeline-status',
    title: 'Pipeline status',
    blurb: 'sui-pipeline-dag + sui-pipeline-step with live states.',
    html: `<sui-pipeline-dag>
  <sui-pipeline-step name="collect" step-type="run" state="completed" agent="git log"></sui-pipeline-step>
  <span class="arrow">&rarr;</span>
  <sui-pipeline-step name="review" step-type="agent" state="completed" agent="ship-agent"></sui-pipeline-step>
  <span class="arrow">&rarr;</span>
  <sui-pipeline-step name="gate" step-type="gate" state="running" agent="acceptance"></sui-pipeline-step>
  <span class="arrow">&rarr;</span>
  <sui-pipeline-step name="merge" step-type="merge" state="pending" agent="fast-forward"></sui-pipeline-step>
</sui-pipeline-dag>`,
  },
  {
    id: 'chat-row',
    title: 'Chat row',
    blurb: 'sui-avatar + agent badge + body. Drop into any conversation view.',
    html: `<div style="display:grid;grid-template-columns:auto 1fr;gap:12px;max-width:560px;padding:10px 12px;border:1px solid color-mix(in oklch,var(--border) 45%,transparent);border-radius:var(--radius-lg);background:var(--card);">
  <sui-avatar name="ship-agent" tone="accent"></sui-avatar>
  <div>
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
      <strong style="font-size:13px;">ship-agent</strong>
      <sui-badge tone="accent" variant="soft" size="sm">agent</sui-badge>
      <span style="font-family:var(--font-mono);font-size:11px;color:var(--muted-foreground);">09:14</span>
    </div>
    <div style="font-size:14px;line-height:1.55;color:var(--foreground);">
      Merged your three drafts. Release notes ready for review &mdash; flagged two items as breaking.
    </div>
  </div>
</div>`,
  },
];

---

<StarlightPage
  frontmatter={{ title: 'Cookbook', description: 'Component compositions ready to paste and ship.' }}
>
  <div class="not-content">
  <p class="cb-sub">
    Compositions, not docs. Paste the source, tweak the copy, ship
    the thing. Every recipe is live below.
  </p>

  <div class="cb-list">
    {recipes.map((r) => (
      <article class="cb-recipe" id={r.id}>
        <header class="cb-recipe-head">
          <h2>{r.title}</h2>
          <p>{r.blurb}</p>
        </header>

        <div class="cb-preview-surface" set:html={r.html}></div>

        <details class="cb-code">
          <summary>
            <span>Source</span>
            <button type="button" class="cb-copy" data-copy={r.html}>Copy</button>
          </summary>
          <pre><code>{r.html}</code></pre>
        </details>
      </article>
    ))}
  </div>
  </div>
</StarlightPage>

<script>
  for (const btn of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    btn.addEventListener('click', async (ev) => {
      ev.preventDefault();
      try {
        await navigator.clipboard.writeText(btn.getAttribute('data-copy') ?? '');
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch {}
    });
  }
</script>

<style>
  .cb-sub {
    color: var(--sl-color-gray-2);
    max-width: 60ch;
    margin-bottom: 8px;
  }

  .cb-list { display: flex; flex-direction: column; gap: 28px; padding-bottom: 48px; }
  .cb-recipe {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-black);
    overflow: hidden;
    scroll-margin-top: 80px;
  }
  .cb-recipe-head {
    padding: 14px 18px 10px;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .cb-recipe-head h2 {
    font-size: 18px;
    letter-spacing: -0.012em;
    border: none;
    margin: 0;
    padding: 0;
  }
  .cb-recipe-head p {
    color: var(--sl-color-gray-2);
    font-size: 13px;
    margin-top: 4px;
    margin-bottom: 0;
  }

  .cb-preview-surface {
    padding: clamp(24px, 4vw, 48px);
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        45deg,
        color-mix(in oklch, var(--sl-color-gray-6) 80%, transparent) 0 1px,
        transparent 1px 10px
      );
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .cb-preview-surface .arrow { color: var(--sl-color-gray-2); padding: 0 4px; }

  .cb-code summary {
    list-style: none;
    cursor: pointer;
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .cb-code summary::-webkit-details-marker { display: none; }
  .cb-code[open] summary { color: var(--sl-color-white); }
  .cb-copy {
    padding: 4px 10px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .cb-copy:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }
  .cb-code pre {
    margin: 0;
    padding: 14px 16px 18px;
    background: color-mix(in oklch, var(--sl-color-gray-6) 50%, transparent);
    font-family: var(--sl-font-mono, monospace);
    font-size: 12.5px;
    line-height: 1.55;
    overflow: auto;
    color: var(--sl-color-white);
    border-top: 1px solid var(--sl-color-gray-5);
  }
</style>
