---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { THEMES } from '../../lib/themes';
---

<StarlightPage
  frontmatter={{ title: 'Themes', description: 'Design-token themes for SHIP components.' }}
>
  <p class="th-sub">
    Click a card to apply a theme site-wide. Every SHIP surface
    picks up the change — nav, components, previews. Copy the
    <code>:root[data-theme]</code> block to use it in your own app.
  </p>

  <div class="th-picker-strip">
    <span class="th-picker-label">Theme</span>
    <sui-theme-picker label-style="text"></sui-theme-picker>
    <span class="th-picker-hint">
      The picker is itself a <code>&lt;sui-theme-picker&gt;</code> primitive —
      same element you'd drop into any page.
    </span>
  </div>

  <section class="th-group">
    <div class="th-grid">
      {THEMES.map((t) => (
        <article
          class="th-card"
          data-theme-card={t.id}
          style={`
            --t-bg: ${t.swatches[0]};
            --t-card: ${t.swatches[1]};
            --t-primary: ${t.swatches[2]};
            --t-accent: ${t.swatches[3]};
          `}
        >
          <button
            type="button"
            class="th-apply"
            data-apply-theme={t.id}
            aria-label={`Apply ${t.label}`}
          >
            <div class="th-swatches" aria-hidden="true">
              <span style={`background:${t.swatches[0]}`}></span>
              <span style={`background:${t.swatches[1]}`}></span>
              <span style={`background:${t.swatches[2]}`}></span>
              <span style={`background:${t.swatches[3]}`}></span>
            </div>
            <div class="th-card-body">
              <div class="th-card-head">
                <span class="th-card-name">{t.label}</span>
                <code class="th-card-id">{t.id}</code>
              </div>
              <div class="th-card-meta">
                {t.dark ? 'Dark' : 'Light'}
              </div>
            </div>
          </button>
        </article>
      ))}
    </div>
  </section>
</StarlightPage>

<script>
  import {
    applyTheme,
    persistTheme,
    isValidTheme,
  } from '../../lib/themes';

  for (const btn of document.querySelectorAll<HTMLElement>('[data-apply-theme]')) {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-apply-theme');
      if (!isValidTheme(id)) return;
      const next = applyTheme(id);
      persistTheme(next);
      for (const c of document.querySelectorAll('[data-theme-card]')) {
        c.setAttribute('aria-selected', c.getAttribute('data-theme-card') === next ? 'true' : 'false');
      }
    });
  }
</script>

<style>
  .th-sub {
    color: var(--sl-color-gray-2);
    max-width: 62ch;
    line-height: 1.55;
    margin-bottom: 24px;
  }
  .th-picker-strip {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 12px 16px;
    margin: 4px 0 24px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: color-mix(in oklch, var(--sl-color-gray-6) 30%, transparent);
  }
  .th-picker-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .th-picker-hint {
    color: var(--sl-color-gray-2);
    font-size: 12.5px;
    line-height: 1.45;
    flex: 1;
    min-width: 200px;
  }
  .th-picker-hint code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11.5px;
    padding: 1px 5px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--sl-color-gray-5) 35%, transparent);
    color: var(--sl-color-white);
  }

  .th-sub code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--sl-color-gray-5) 40%, transparent);
    color: var(--sl-color-white);
  }

  .th-group { padding: 18px 0 12px; }
  .th-group-head {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    margin-bottom: 12px;
  }
  .th-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .th-card { display: block; }
  .th-apply {
    appearance: none;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    background: var(--t-bg);
    cursor: pointer;
    overflow: hidden;
    text-align: left;
    font: inherit;
    transition: border-color 120ms ease-out, transform 120ms ease-out;
  }
  .th-apply:hover {
    border-color: color-mix(in oklch, var(--t-primary) 55%, transparent);
    transform: translateY(-1px);
  }
  .th-card[aria-selected='true'] .th-apply {
    border-color: var(--t-primary);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--t-primary) 22%, transparent);
  }
  .th-swatches { display: flex; height: 40px; }
  .th-swatches > span { flex: 1; display: block; }
  .th-card-body {
    padding: 10px 14px 14px;
    background: var(--t-card);
  }
  .th-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .th-card-name {
    font-weight: 700;
    font-size: 14px;
    color: color-mix(in oklch, var(--t-primary) 20%, var(--t-accent));
  }
  .th-card-id {
    font-family: var(--sl-font-mono, monospace);
    font-size: 10.5px;
    opacity: 0.75;
    color: color-mix(in oklch, var(--t-primary) 15%, var(--t-accent));
  }
  .th-card-meta {
    font-size: 11px;
    margin-top: 4px;
    opacity: 0.65;
    color: color-mix(in oklch, var(--t-primary) 30%, var(--t-accent));
  }
</style>
