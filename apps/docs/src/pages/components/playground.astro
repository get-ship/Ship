---
/*
  Spike: SUI playground page.

  Demonstrates the per-topic canvas layout — drops Starlight's left
  sidebar and right TOC for a side-by-side editor/preview split that
  uses the full viewport width. Frontmatter flips the custom PageFrame
  to canvas mode; `tableOfContents: false` suppresses the right rail.

  For this spike the "editor" is a read-only code viewer (CodeMirror
  comes next). The preview is a sandboxed iframe loading a pre-built
  example bundle from /playground/example.html — same shape as
  packages/sui/runtime/example/sui-app/. A v2 with in-browser compile-on-edit needs the
  sui-compiler built to WASM (`just wasm` recipe targets a different
  compiler today; sui-compiler doesn't have a WASM build yet).
*/
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { Code } from 'astro:components'
import { readFileSync } from 'node:fs'
import { resolve, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = dirname(fileURLToPath(import.meta.url))
const repoRoot = resolve(__dirname, '../../../../..')
const exampleSrc = readFileSync(
  resolve(repoRoot, 'packages/sui/runtime/example/sui-app/src/sui-app.sui'),
  'utf8',
)
const exampleController = readFileSync(
  resolve(repoRoot, 'packages/sui/runtime/example/sui-app/src/sui-app.controller.ts'),
  'utf8',
)
---

<StarlightPage
  frontmatter={{
    title: 'SUI playground',
    description: 'Live editor and preview for SUI components.',
    template: 'splash',
    tableOfContents: false,
  }}
>
  <div class="pg-root">
    <header class="pg-head">
      <div>
        <p class="pg-blurb">Side-by-side editor and live preview. The right pane is a sandboxed iframe loading the same standalone example shipped under <code>packages/sui/runtime/example/sui-app/</code>.</p>
      </div>
      <div class="pg-meta">
        <span class="pg-badge">read-only · v0</span>
      </div>
    </header>

    <div class="pg-split">
      <section class="pg-editor" aria-label="Source code">
        <div class="pg-tabs">
          <button class="pg-tab" data-tab="template" aria-selected="true">sui-app.sui</button>
          <button class="pg-tab" data-tab="controller">sui-app.controller.ts</button>
        </div>
        <div class="pg-code" data-tab-content="template">
          <Code code={exampleSrc} lang="svelte" theme="night-owl" />
        </div>
        <div class="pg-code" data-tab-content="controller" hidden>
          <Code code={exampleController} lang="ts" theme="night-owl" />
        </div>
      </section>

      <section class="pg-preview" aria-label="Live preview">
        <div class="pg-preview-bar">
          <span class="pg-preview-title">preview</span>
          <button class="pg-preview-reload" id="pg-reload">↻ reload</button>
        </div>
        <iframe id="pg-iframe" data-base-src="/playground/example.html" src="/playground/example.html" title="SUI example preview" loading="lazy"></iframe>
      </section>
    </div>

    <footer class="pg-foot">
      <p>v1 punch list: CodeMirror with .sui syntax highlighting · in-browser compile (sui-compiler → WASM) · share-by-URL · per-component starter snippets pulled from the CEM.</p>
    </footer>
  </div>
</StarlightPage>

<script>
  // Tab switcher between template / controller views. Vanilla; no
  // framework dep — keeps the spike honest about what would be a
  // bigger investment (Monaco/CodeMirror).
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement | null
    if (!t || !t.matches('.pg-tab')) return
    const which = t.dataset.tab
    if (!which) return
    document.querySelectorAll('.pg-tab').forEach((b) => {
      const sel = (b as HTMLElement).dataset.tab === which
      ;(b as HTMLElement).setAttribute('aria-selected', String(sel))
    })
    document.querySelectorAll('[data-tab-content]').forEach((c) => {
      const sel = (c as HTMLElement).dataset.tabContent === which
      ;(c as HTMLElement).hidden = !sel
    })
  })
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement | null
    if (!t || t.id !== 'pg-reload') return
    syncPreviewTheme()
  })

  // Theme sync — Starlight sets <html data-theme="dark|light|auto">,
  // toggled via the theme switcher in the header. Reflect the resolved
  // theme into the iframe's ?theme= query so the example renders in
  // the same scheme as the docs page.
  function resolvedTheme(): 'dark' | 'light' {
    // Project uses its own data-theme values (ship-light / ship-dark
    // / paper / halo / console / contrast) plus toggles `html.dark`
    // on every "inherently-dark" choice. Check that class first so
    // the iframe follows the same logic as the rest of the docs.
    if (document.documentElement.classList.contains('dark')) return 'dark'
    const t = document.documentElement.dataset.theme
    if (t === 'dark' || t === 'light') return t
    if (t && t.includes('dark')) return 'dark'
    if (t && t.includes('light')) return 'light'
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
  }
  function syncPreviewTheme(): void {
    const f = document.getElementById('pg-iframe') as HTMLIFrameElement | null
    if (!f) return
    const base = f.dataset.baseSrc || f.src
    const next = `${base}?theme=${resolvedTheme()}`
    if (f.src.endsWith(next)) {
      // Force a reload by twiddling the query (cache-buster).
      f.src = `${base}?theme=${resolvedTheme()}&_=${Date.now()}`
    } else {
      f.src = next
    }
  }
  syncPreviewTheme()
  // Watch BOTH the project's data-theme attribute AND the .dark class
  // toggle (the pre-paint script flips .dark on every inherently-dark
  // theme variant). Either changing means we need to re-resolve.
  new MutationObserver(syncPreviewTheme).observe(
    document.documentElement,
    { attributes: true, attributeFilter: ['data-theme', 'class'] },
  )
</script>

<style is:global>
  /* Reach past Starlight's splash-template container cap (45rem) and
     let the playground use the full viewport width. Scoped to the
     playground route via :has() so other splash pages are unaffected. */
  body:has(.pg-root) .main-pane .sl-container,
  body:has(.pg-root) main > .sl-container {
    max-width: none;
  }
  body:has(.pg-root) .hero {
    display: none;
  }

  /* Canvas layout — fills the viewport below the header. */
  .pg-root {
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--sl-nav-height));
    padding: 1.5rem;
    gap: 1rem;
    box-sizing: border-box;
    color: var(--sl-color-text);
  }
  .pg-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .pg-title {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .pg-blurb {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    max-width: 56ch;
  }
  .pg-blurb code {
    font-family: var(--sl-font-system-mono);
    background: var(--sl-color-bg-inline-code);
    padding: 1px 4px;
    border-radius: 3px;
  }
  .pg-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--sl-color-bg-accent);
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-system-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pg-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    flex: 1;
    min-height: 0;
  }
  @media (max-width: 900px) {
    .pg-split { grid-template-columns: 1fr; }
  }

  .pg-editor, .pg-preview {
    display: flex;
    flex-direction: column;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.5rem;
    overflow: hidden;
    min-height: 0;
  }

  .pg-tabs {
    display: flex;
    gap: 1px;
    background: var(--sl-color-hairline-shade);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
  }
  .pg-tab {
    flex: 1;
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-text);
    border: none;
    padding: 8px 12px;
    font: inherit;
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .pg-tab[aria-selected="true"] {
    background: var(--sl-color-bg);
    color: var(--sl-color-text-accent);
    border-bottom: 2px solid var(--sl-color-text-accent);
  }

  .pg-code {
    margin: 0;
    padding: 12px;
    overflow: auto;
    flex: 1;
    background: var(--sl-color-bg);
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .pg-code code {
    background: none;
    padding: 0;
  }

  .pg-preview-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: var(--sl-color-bg-sidebar);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
  }
  .pg-preview-title { color: var(--sl-color-gray-3); }
  .pg-preview-reload {
    background: none;
    border: 1px solid var(--sl-color-hairline-shade);
    color: var(--sl-color-text);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
  }
  .pg-preview-reload:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  #pg-iframe {
    flex: 1;
    border: none;
    background: var(--sl-color-bg);
  }

  .pg-foot {
    color: var(--sl-color-gray-4);
    font-size: 0.75rem;
    font-family: var(--sl-font-system-mono);
  }
  .pg-foot p { margin: 0; }
</style>
