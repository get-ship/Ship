---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{ title: 'Installing', description: 'Embed the SUI primitives in any page served alongside the Ship daemon.' }}
>
  <div class="not-content">
  <p class="in-sub">
    SUI components ship with the Ship daemon. Every <code>&lt;sui-*&gt;</code>
    primitive is bundled into <code>sui-components.js</code> and served at
    <code>/api/assets/</code>, paired with design tokens at
    <code>/api/assets/view-tokens.css</code>. Add the import map, link the
    tokens, load the bundle once — every tag works anywhere on the page.
  </p>

  <section class="in-section">
    <h2 class="in-h2">1 · Link the tokens</h2>
    <div class="in-code">
      <pre><code>{`<link rel="stylesheet" href="/api/assets/view-tokens.css">`}</code></pre>
      <button type="button" class="in-copy" data-copy={`<link rel="stylesheet" href="/api/assets/view-tokens.css">`}>Copy</button>
    </div>
    <p class="in-note">
      Concatenates the canonical OKLCH tokens with the per-theme overrides
      so every <code>&lt;sui-*&gt;</code> component renders against the
      same surface palette as the rest of Ship.
    </p>
  </section>

  <section class="in-section">
    <h2 class="in-h2">2 · Resolve the runtime imports</h2>
    <div class="in-code">
<pre><code>{`<script type="importmap">
{
  "imports": {
    "@ship/sui-runtime": "/api/assets/sui-runtime.js",
    "@ship/sui-dom":     "/api/assets/sui-dom.js",
    "@ship/sdk-client":  "/api/assets/sui-sdk-client.js"
  }
}
</script>`}</code></pre>
      <button type="button" class="in-copy" data-copy={`<script type="importmap">\n{\n  "imports": {\n    "@ship/sui-runtime": "/api/assets/sui-runtime.js",\n    "@ship/sui-dom":     "/api/assets/sui-dom.js",\n    "@ship/sdk-client":  "/api/assets/sui-sdk-client.js"\n  }\n}\n</script>`}>Copy</button>
    </div>
    <p class="in-note">
      The component bundle imports the runtime by bare specifier. An
      import map must precede any module script that loads
      <code>sui-components.js</code>.
    </p>
  </section>

  <section class="in-section">
    <h2 class="in-h2">3 · Load the components bundle</h2>
    <div class="in-code">
<pre><code>{`<script type="module" src="/api/assets/sui-components.js"></script>`}</code></pre>
      <button type="button" class="in-copy" data-copy={`<script type="module" src="/api/assets/sui-components.js"></script>`}>Copy</button>
    </div>
    <p class="in-note">
      Side-effect import — registers every <code>&lt;sui-*&gt;</code> custom
      element. After this script evaluates, any tag in the page upgrades
      to its component.
    </p>
  </section>

  <section class="in-section">
    <h2 class="in-h2">4 · Use</h2>
    <div class="in-code">
<pre><code>{`<sui-card variant="outline" padding="lg">
  <strong slot="header">Hello</strong>
  Any framework, any template engine, any file format that renders HTML.
</sui-card>`}</code></pre>
      <button type="button" class="in-copy" data-copy={`<sui-card variant="outline" padding="lg">\n  <strong slot="header">Hello</strong>\n  Any framework, any template engine, any file format that renders HTML.\n</sui-card>`}>Copy</button>
    </div>
    <div class="in-preview">
      <sui-card variant="outline" padding="lg">
        <strong slot="header" style="font-weight:700;font-size:16px;">Hello</strong>
        Any framework, any template engine, any file format that renders HTML.
      </sui-card>
    </div>
  </section>

  <section class="in-section">
    <h2 class="in-h2">Applying a theme</h2>
    <p class="in-note">
      Themes are opt-in via <code>data-theme</code> on <code>&lt;html&gt;</code>.
      Pair with the <code>.dark</code> class for inherently-dark themes
      so shadow/elevation tokens flip too. The
      <code>&lt;sui-theme-picker&gt;</code> primitive handles the whole
      flow — apply, persist, broadcast — in one tag.
    </p>
    <div class="in-code">
<pre><code>{`<sui-theme-picker></sui-theme-picker>`}</code></pre>
      <button type="button" class="in-copy" data-copy={`<sui-theme-picker></sui-theme-picker>`}>Copy</button>
    </div>
    <div class="in-preview">
      <sui-theme-picker></sui-theme-picker>
    </div>
  </section>
  </div>
</StarlightPage>

<script>
  for (const btn of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    btn.addEventListener('click', async (ev) => {
      ev.preventDefault();
      try {
        await navigator.clipboard.writeText(btn.getAttribute('data-copy') ?? '');
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = prev; }, 1200);
      } catch {}
    });
  }
</script>

<style>
  .in-sub {
    color: var(--sl-color-gray-2);
    max-width: 60ch;
    margin-bottom: 8px;
  }
  .in-sub code,
  .in-note code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--sl-color-gray-5) 40%, transparent);
    color: var(--sl-color-white);
  }

  .in-section { padding: 18px 0; display: flex; flex-direction: column; gap: 12px; }
  .in-h2 {
    font-size: 18px;
    letter-spacing: -0.01em;
    border: none;
    margin: 0;
    padding: 0;
  }
  .in-note { color: var(--sl-color-gray-2); font-size: 13.5px; max-width: 62ch; margin: 0; }

  .in-code {
    position: relative;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: color-mix(in oklch, var(--sl-color-gray-6) 50%, transparent);
    overflow: hidden;
  }
  .in-code pre {
    margin: 0;
    padding: 14px 16px 16px;
    font-family: var(--sl-font-mono, monospace);
    font-size: 13px;
    line-height: 1.6;
    overflow: auto;
    color: var(--sl-color-white);
    tab-size: 2;
  }
  .in-copy {
    position: absolute;
    top: 10px; right: 10px;
    padding: 3px 9px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .in-copy:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }

  .in-preview {
    display: grid;
    place-items: center;
    padding: 24px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-black);
  }
</style>
