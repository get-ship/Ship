---
/*
  Per-step tutorial page. Pulls prose from
  docs/ship-sui/references/tutorial/<NN-slug>/index.md (skill is the
  single source of truth for prose) and starter/solved code from
  apps/docs/tutorial-examples/<slug>/. Renders the canvas layout —
  prose on the left, editor + preview on the right.

  The route is a dynamic static-paths route: getStaticPaths walks
  the tutorial dir at build time and registers one path per step.
*/
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import TutorialApp from '../../components/TutorialApp.astro'
import { readFileSync, readdirSync, existsSync } from 'node:fs'
import { resolve, dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = dirname(fileURLToPath(import.meta.url))
const repoRoot = resolve(__dirname, '../../../../../')
const tutorialDir = join(repoRoot, 'docs/ship-sui/references/tutorial')
const codeDir = join(repoRoot, 'apps/docs/tutorial-examples')

interface FM {
  title: string
  description: string | null
  order: number
  slug: string
  prev: string | null
  next: string | null
  chapter: string | null
}

function parseFm(text: string): FM {
  const m = text.match(/^---\n([\s\S]*?)\n---/)
  const fm: Record<string, string | null> = {}
  if (m) {
    for (const line of m[1].split('\n')) {
      const kv = line.match(/^(\w+):\s*(.+)$/)
      if (!kv) continue
      let v = kv[2].trim()
      if (v === 'null') { fm[kv[1]] = null; continue }
      v = v.replace(/^["']|["']$/g, '')
      fm[kv[1]] = v
    }
  }
  return {
    title: fm.title ?? '',
    description: fm.description ?? null,
    order: Number(fm.order ?? 999),
    slug: fm.slug ?? '',
    prev: fm.prev ?? null,
    next: fm.next ?? null,
    chapter: fm.chapter ?? null,
  }
}

function chapterLabel(fm: FM): string {
  const map: Record<string, string> = {
    reactivity: 'Reactivity',
    templating: 'Templating',
    components: 'Components',
    agents: 'Agents',
    composition: 'Composition',
    lifecycle: 'Lifecycle',
    views: 'Views',
  }
  return (fm.chapter && map[fm.chapter]) || 'Tutorial'
}

function stripFm(text: string): string {
  return text.replace(/^---\n[\s\S]*?\n---\n*/, '')
}

export async function getStaticPaths() {
  // Inline path resolution — `tutorialDir` from the module scope
  // isn't reachable when Astro hoists this function to its
  // pre-render chunk. Same for `parseFm` — duplicate here to keep
  // the function self-contained.
  const here = dirname(fileURLToPath(import.meta.url))
  const root = resolve(here, '../../../../../')
  const dir = join(root, 'docs/ship-sui/references/tutorial')
  const fmOf = (text: string): { slug: string } => {
    const m = text.match(/^---\n([\s\S]*?)\n---/)
    if (!m) return { slug: '' }
    const out: { slug: string } = { slug: '' }
    for (const line of m[1].split('\n')) {
      const kv = line.match(/^slug:\s*(.+)$/)
      if (kv) out.slug = kv[1].trim().replace(/^["']|["']$/g, '')
    }
    return out
  }
  const dirs = readdirSync(dir, { withFileTypes: true })
    .filter((e) => e.isDirectory())
  return dirs.map((d) => {
    const indexPath = join(dir, d.name, 'index.md')
    const fm = fmOf(readFileSync(indexPath, 'utf8'))
    return { params: { slug: fm.slug || d.name }, props: { dirname: d.name } }
  })
}

const { slug } = Astro.params
const { dirname: stepDir } = Astro.props as { dirname: string }
const indexPath = join(tutorialDir, stepDir, 'index.md')
const text = readFileSync(indexPath, 'utf8')
const fm = parseFm(text)
const body = stripFm(text)

const codeStepDir = join(codeDir, stepDir)
function loadCode(variant: 'starter' | 'solved') {
  const tplPath = join(codeStepDir, variant, 'template.sui')
  const ctrlPath = join(codeStepDir, variant, 'controller.ts')
  if (!existsSync(tplPath) || !existsSync(ctrlPath)) return null
  return {
    template: readFileSync(tplPath, 'utf8'),
    controller: readFileSync(ctrlPath, 'utf8'),
  }
}
const starter = loadCode('starter')
const solved = loadCode('solved')
if (!starter || !solved) {
  throw new Error(`tutorial step "${stepDir}": missing starter/ or solved/ code under ${codeStepDir}`)
}

// Render markdown body server-side via Astro's built-in markdown
// renderer (the docs collection uses markdoc but plain pages here
// use a tiny render — for the tutorial scope this is just headings,
// paragraphs, code-fences, lists. Keep it simple: pass-through to a
// `<Fragment set:html>` after a minimal transform, OR just dump it
// inside a div with .markdown-body styling.
//
// Astro doesn't expose its markdown compiler trivially from .astro
// files. For v1 of this scaffold we'll render raw markdown via a
// regex pass that handles fences + paragraphs. Good enough for the
// three steps we have — and a TODO is to plug Astro's MD compiler
// in once the surrounding shape is locked in.
function renderMarkdown(md: string): string {
  let out = md
  // Code fences ```lang\n...\n``` → <sui-code block> for syntax
  // highlighting via the Ship code primitive (same lowlight palette
  // as the sui-code-editor, so prose and live editor agree).
  out = out.replace(/```([\w-]*)\n([\s\S]*?)\n```/g, (_m, lang, code) => {
    const escaped = code.replace(/[<>&]/g, (c: string) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]!)
    return `<sui-code block lang="${lang || ''}">${escaped}</sui-code>`
  })
  // Headings
  out = out.replace(/^(#{1,4})\s+(.+)$/gm, (_m, hashes, title) => {
    const level = hashes.length
    return `<h${level}>${title}</h${level}>`
  })
  // Inline code — escape the inner contents so things like
  // `<textarea>` and `<select>` don't get parsed as live HTML by
  // the browser. (Block code fences above already escape inside the
  // <sui-code> body; this is the analogous fix for inline code.)
  out = out.replace(/`([^`]+)`/g, (_m, inner: string) => {
    const escaped = inner.replace(/[<>&]/g, (c: string) =>
      ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]!,
    )
    return `<code>${escaped}</code>`
  })
  // Bold + italic
  out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  out = out.replace(/(?<![\*\w])\*([^*]+)\*(?!\w)/g, '<em>$1</em>')
  // Numbered lists (very minimal)
  out = out.replace(/(^\d+\.\s+.+(\n\s+.+)*\n?)+/gm, (m) => {
    const items = m.split(/\n(?=\d+\.\s)/).map(l => l.replace(/^\d+\.\s+/, '').trim()).filter(Boolean)
    return '<ol>' + items.map(i => `<li>${i}</li>`).join('') + '</ol>'
  })
  // Paragraphs (split on blank lines, skip lines that are already blocks)
  const blocks: string[] = []
  for (const para of out.split(/\n{2,}/)) {
    const trimmed = para.trim()
    if (!trimmed) continue
    if (/^<(pre|h\d|ol|ul|blockquote|sui-code|sui-alert)/.test(trimmed)) blocks.push(trimmed)
    else blocks.push(`<p>${trimmed.replace(/\n/g, ' ')}</p>`)
  }
  return blocks.join('\n')
}

const proseHtml = renderMarkdown(body)
---

<StarlightPage
  frontmatter={{
    title: fm.title,
    description: fm.description ?? '',
    template: 'splash',
    tableOfContents: false,
  }}
>
  <div class="tut-root canvas-root">
    {/* The shared .canvas-back is positioned absolute via the global
        rule in ship-theme.css — keeps every working surface (tutorial,
        component viewer, future playgrounds) using the same back
        affordance instead of each rolling its own. */}
    <a href="/" class="canvas-back" aria-label="Back to docs home">
      <span aria-hidden="true">←</span> Docs
    </a>

    <div class="tut-split">
      <article class="tut-prose">
        <header class="tut-prose-head">
          <sui-chip tone="primary" variant="soft" size="sm" pill>
            {String(fm.order).padStart(2, '0')} · {chapterLabel(fm)}
          </sui-chip>
          <h1>{fm.title}</h1>
          {fm.description && <p class="tut-prose-desc">{fm.description}</p>}
        </header>
        <div class="tut-prose-body" set:html={proseHtml} />
        <footer class="tut-prose-nav">
          {fm.prev ? (
            <a href={`/tutorial/${fm.prev}/`} class="tut-nav-link" aria-label="Previous step">
              <sui-button variant="ghost" size="sm">← prev</sui-button>
            </a>
          ) : <span />}
          <a href="/tutorial/" class="tut-nav-link" aria-label="Tutorial overview">
            <sui-button variant="ghost" size="sm">all steps</sui-button>
          </a>
          {fm.next ? (
            <a href={`/tutorial/${fm.next}/`} class="tut-nav-link" aria-label="Next step">
              <sui-button variant="soft" tone="primary" size="sm">next →</sui-button>
            </a>
          ) : <span />}
        </footer>
      </article>
      {/* `not-content` is Starlight's documented opt-out — disables
          the `:not(inline) + :not(inline) { margin-top }` rule that
          otherwise pushes our second flex pane down by 16px and
          breaks tight stacking. See apps/docs/src/styles/ship-theme.css
          comment around the homepage card grids. */}
      <div class="tut-app not-content">
        <TutorialApp
          slug={slug ?? stepDir}
          starterTemplate={starter.template}
          starterController={starter.controller}
          solvedTemplate={solved.template}
          solvedController={solved.controller}
        />
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  /* All the body:has(.tut-root) chrome resets are now sourced from
     `.canvas-root` in apps/docs/src/styles/ship-theme.css — the
     tutorial just opts in by adding canvas-root to the wrapper.
     What lives here: tutorial-specific layout (split, prose pane,
     editor + preview panes). */

  .tut-root {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - var(--sl-nav-height));
    padding: 4px 8px 8px;
    gap: 0;
    box-sizing: border-box;
    position: relative;
  }

  /* Local tut-back stub kept for backward-compatibility with any
     external link still pointing at the old class. Visual styling
     comes from .canvas-back. */
  .tut-back {
    position: absolute;
    top: 6px;
    left: 12px;
    z-index: 10;
    font-family: var(--sl-font-system-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--sl-color-bg-sidebar) 80%, transparent);
    border: 1px solid var(--sl-color-hairline-shade);
    transition: color 120ms ease, border-color 120ms ease;
  }
  .tut-back:hover {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }

  .tut-split {
    display: grid;
    grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
    gap: 0.75rem;
    flex: 1 1 auto;
    min-height: 0;
  }
  @media (min-width: 1600px) {
    .tut-split { grid-template-columns: minmax(0, 32rem) minmax(0, 1fr); }
  }
  @media (max-width: 900px) {
    .tut-split { grid-template-columns: 1fr; height: auto; }
  }

  /* Prose pane is the flex column: fixed head, scrollable body,
     fixed nav at the bottom. The body is the only thing that
     overflows; the nav stays in view regardless of scroll. */
  .tut-prose {
    overflow: hidden;
    color: var(--sl-color-text);
    line-height: 1.55;
    min-width: 0;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .tut-prose-head {
    flex-shrink: 0;
    padding: 2px 14px 8px;
    border-bottom: 1px solid var(--sl-color-hairline-shade);
  }
  .tut-prose-head h1 {
    margin: 6px 0 4px;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: 1.2;
  }
  .tut-prose-desc {
    margin: 0 !important;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
    line-height: 1.4;
  }
  .tut-prose-body {
    flex: 1 1 auto;
    min-height: 0;
    padding: 6px 14px 0 14px;
    overflow-y: auto;
    overflow-x: hidden;
  }
  .tut-prose-body::-webkit-scrollbar { width: 6px; }
  .tut-prose-body::-webkit-scrollbar-thumb {
    background: var(--sl-color-hairline-shade);
    border-radius: 999px;
  }
  .tut-prose-nav {
    flex-shrink: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-top: 1px solid var(--sl-color-hairline-shade);
    background: var(--sl-color-bg);
  }
  .tut-prose-nav > * { display: flex; }
  .tut-prose-nav > *:first-child { justify-content: flex-start; }
  .tut-prose-nav > *:nth-child(2) { justify-content: center; }
  .tut-prose-nav > *:last-child { justify-content: flex-end; }
  .tut-nav-link { text-decoration: none; }
  .tut-prose sui-code {
    max-width: 100%;
    overflow-x: auto;
    word-break: break-word;
  }
  .tut-prose sui-code[block] {
    display: block;
    margin: 0.5rem 0;
  }
  /* Subtle scroll affordance instead of a default ugly scrollbar. */
  .tut-prose::-webkit-scrollbar { width: 6px; }
  .tut-prose::-webkit-scrollbar-thumb {
    background: var(--sl-color-hairline-shade);
    border-radius: 999px;
  }

  .tut-prose h1, .tut-prose h2 {
    margin: 1.25rem 0 0.5rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .tut-prose h1 { font-size: 1.05rem; }
  .tut-prose h2 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-2);
  }
  .tut-prose p, .tut-prose li { margin: 0.5rem 0; font-size: 0.925rem; }
  .tut-prose ol, .tut-prose ul { padding-left: 1.5rem; }
  .tut-prose li { padding-left: 0.25rem; }
  .tut-prose code {
    font-family: var(--sl-font-system-mono);
    font-size: 0.85em;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-text-accent);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .tut-prose p, .tut-prose li { font-size: 0.875rem; line-height: 1.55; margin: 0.4rem 0; }
  .tut-prose code { font-size: 0.82em; }
  .tut-prose h1, .tut-prose h2 { margin: 0.9rem 0 0.35rem; }

  .tut-app {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
  }
</style>
