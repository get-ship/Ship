---
/*
  TutorialApp — editor + preview pane wired entirely from Ship's own
  SUI components: <sui-tabs> / <sui-tab> / <sui-tab-panel> for pane
  switching, <sui-button> for actions, <sui-status-dot> for the live
  status, <sui-code-editor> for editing, <sui-diff> for the "what
  changed vs. solution" view, <sui-alert> for compile errors. The
  base component set is registered globally by the layout's
  <script type="module" src="/sui-components.js">; the editor + diff
  chunks lazy-load on first reference.

  Author flow on every edit:
    sui-change (debounced 150ms inside sui-code-editor)
      → compile via wasm
      → controller TS→JS regex strip
      → postMessage to iframe host → blob URL injection → re-mount.
*/
interface Props {
  slug: string
  starterTemplate: string
  starterController: string
  solvedTemplate: string
  solvedController: string
}
const { slug, starterTemplate, starterController, solvedTemplate, solvedController } = Astro.props
---

<div
  class="tut-app-root"
  data-slug={slug}
  data-starter-template={starterTemplate}
  data-starter-controller={starterController}
  data-solved-template={solvedTemplate}
  data-solved-controller={solvedController}
>
  <div class="tut-pane tut-pane--editor">
    <div class="tut-pane-bar">
      <sui-tabs active="template" variant="pill" size="sm" class="tut-tabs">
        <sui-tab name="template">
          <span class="tut-tab-icon" aria-hidden="true">⟨/⟩</span> template.sui
        </sui-tab>
        <sui-tab name="controller">
          <span class="tut-tab-icon" aria-hidden="true">{}</span> controller.ts
        </sui-tab>
        <sui-tab name="diff">
          <span class="tut-tab-icon" aria-hidden="true">±</span> diff
        </sui-tab>
      </sui-tabs>
      <div class="tut-actions">
        <sui-button data-action="reset" variant="ghost" size="sm" title="Reset to starter code">
          ↺ Reset
        </sui-button>
        <sui-button data-action="solution" variant="soft" tone="primary" size="sm" title="Replace with the answer">
          Show solution
        </sui-button>
      </div>
    </div>
    <div class="tut-editor-host">
      <sui-tab-panel name="template" active>
        <sui-code-editor
          class="tut-editor"
          data-pane="template"
          language="html"
          size="md"
          value={starterTemplate}
        ></sui-code-editor>
      </sui-tab-panel>
      <sui-tab-panel name="controller">
        <sui-code-editor
          class="tut-editor"
          data-pane="controller"
          language="typescript"
          size="md"
          value={starterController}
        ></sui-code-editor>
      </sui-tab-panel>
      <sui-tab-panel name="diff">
        <div class="tut-diff-wrap">
          <div class="tut-diff-row">
            <div class="tut-diff-label">template.sui</div>
            <sui-diff class="tut-diff" data-pane="template" from={starterTemplate} to={solvedTemplate}></sui-diff>
          </div>
          <div class="tut-diff-row">
            <div class="tut-diff-label">controller.ts</div>
            <sui-diff class="tut-diff" data-pane="controller" from={starterController} to={solvedController}></sui-diff>
          </div>
        </div>
      </sui-tab-panel>
    </div>
  </div>

  <div class="tut-pane tut-pane--preview">
    <div class="tut-pane-bar">
      <sui-status-dot class="tut-status-dot" tone="muted" size="sm" label="ready"></sui-status-dot>
      <sui-button data-action="run" variant="ghost" size="sm" title="Re-run with current code">
        ↻ Run
      </sui-button>
    </div>
    <sui-alert class="tut-error" tone="destructive" hidden>
      <span slot="title">Compile error</span>
      <pre class="tut-error-msg"></pre>
    </sui-alert>
    <div class="tut-preview-host">
      <iframe
        class="tut-preview"
        data-base-src="/tutorial/host.html"
        title="Tutorial preview"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    </div>
  </div>
</div>

<script>
  import initWasm, { compile as wasmCompile } from '@ship/sui-compiler-wasm'
  import wasmUrl from '@ship/sui-compiler-wasm/sui_compiler_bg.wasm?url'

  // Browser-side analyser (parser + static completions) running off
  // the main thread. The wasm-compiler covers compile-time errors;
  // this worker covers structural parse errors + context-aware
  // completions (the same trigger-keyed completions list, but
  // queried dynamically based on cursor context).
  import LspWorker from '@ship/sui-lsp-browser/worker?worker'
  import { createSuiLspClient, type SuiLspClient } from '@ship/sui-lsp-browser'

  let wasmReady: Promise<unknown> | null = null
  function ensureWasm() {
    if (!wasmReady) wasmReady = initWasm(wasmUrl)
    return wasmReady
  }

  let lspClient: SuiLspClient | null = null
  function ensureLsp(): SuiLspClient {
    if (!lspClient) lspClient = createSuiLspClient(new LspWorker())
    return lspClient
  }

  // sui-components.js + sui-components/sui-code-editor.js are loaded
  // globally by the docs layout's <head>. We just wait for the
  // custom-element definition to land before booting.
  function ensureEditorCE(): Promise<unknown> {
    if (typeof customElements === 'undefined') return Promise.resolve()
    return customElements.whenDefined('sui-code-editor')
  }

  // Wait for the base set (sui-button, sui-tabs, sui-status-dot,
  // sui-diff, sui-alert, sui-card) to be defined too — they ship in
  // sui-components.js which is loaded asynchronously by the layout.
  function ensureBaseCE(): Promise<unknown> {
    if (typeof customElements === 'undefined') return Promise.resolve()
    return Promise.all([
      'sui-button', 'sui-tabs', 'sui-tab', 'sui-tab-panel',
      'sui-status-dot', 'sui-diff', 'sui-alert', 'sui-card',
    ].map((tag) => customElements.whenDefined(tag)))
  }

  interface SuiDiagnostic {
    line: number
    column?: number
    severity: 'error' | 'warning' | 'info'
    message: string
    source?: string
  }
  interface SuiCompletionSource {
    trigger: string
    items: Array<{ label: string; detail?: string; info?: string; insert?: string }>
  }
  interface EditorEl extends HTMLElement {
    value: string
    setDiagnostics?: (d: SuiDiagnostic[]) => void
    setCompletions?: (s: SuiCompletionSource[]) => void
  }
  interface DiffEl extends HTMLElement { from: string; to: string }
  interface StatusDotEl extends HTMLElement { tone: string; pulse: boolean; label: string }

  function bootApp(root: HTMLElement): void {
    const slug = root.dataset.slug ?? ''
    const starterTemplate = root.dataset.starterTemplate ?? ''
    const starterController = root.dataset.starterController ?? ''
    const solvedTemplate = root.dataset.solvedTemplate ?? ''
    const solvedController = root.dataset.solvedController ?? ''

    let currentTemplate = starterTemplate
    let currentController = starterController
    const tagBase = `tut-${slug.replace(/[^a-z0-9-]/gi, '')}-`
    let tagSeq = 0

    const tplEl = root.querySelector<EditorEl>('sui-code-editor[data-pane="template"]')!
    const ctrlEl = root.querySelector<EditorEl>('sui-code-editor[data-pane="controller"]')!
    const tplDiff = root.querySelector<DiffEl>('sui-diff[data-pane="template"]')!
    const ctrlDiff = root.querySelector<DiffEl>('sui-diff[data-pane="controller"]')!

    tplEl.addEventListener('sui-change', (e) => {
      const v = (e as CustomEvent<{ value: string }>).detail.value
      currentTemplate = v
      tplDiff.from = v
      runNow()
    })
    ctrlEl.addEventListener('sui-change', (e) => {
      const v = (e as CustomEvent<{ value: string }>).detail.value
      currentController = v
      ctrlDiff.from = v
      runNow()
    })
    tplEl.addEventListener('input', () => setStatus('typing', 'editing…'))
    ctrlEl.addEventListener('input', () => setStatus('typing', 'editing…'))

    // sui-tabs only auto-toggles `:scope > sui-tab-panel` direct
    // children; our panels live in a sibling .tut-editor-host so
    // we wire the switching ourselves on `sui-tab-change`.
    const panels = Array.from(root.querySelectorAll<HTMLElement>('sui-tab-panel'))
    function showPanel(name: string): void {
      for (const panel of panels) {
        const match = panel.getAttribute('name') === name
        if (match) {
          panel.setAttribute('active', '')
          panel.removeAttribute('hidden')
        } else {
          panel.removeAttribute('active')
          panel.setAttribute('hidden', '')
        }
      }
    }
    root.querySelector('sui-tabs')!.addEventListener('sui-tab-change', (e) => {
      const name = (e as CustomEvent<{ name: string }>).detail?.name
      if (name) showPanel(name)
    })

    root.querySelector('[data-action="reset"]')!.addEventListener('click', () => {
      currentTemplate = starterTemplate
      currentController = starterController
      tplEl.value = starterTemplate
      ctrlEl.value = starterController
      tplDiff.from = starterTemplate
      ctrlDiff.from = starterController
      runNow()
    })
    root.querySelector('[data-action="solution"]')!.addEventListener('click', () => {
      currentTemplate = solvedTemplate
      currentController = solvedController
      tplEl.value = solvedTemplate
      ctrlEl.value = solvedController
      tplDiff.from = solvedTemplate
      ctrlDiff.from = solvedController
      runNow()
    })
    root.querySelector('[data-action="run"]')!.addEventListener('click', () => runNow())

    const statusDot = root.querySelector<HTMLElement>('.tut-status-dot')!
    const errorAlert = root.querySelector<HTMLElement>('.tut-error')!
    const errorMsg = root.querySelector<HTMLElement>('.tut-error-msg')!
    // Write attributes (not JS properties) so external observers
    // (visual tests, MutationObserver consumers) see the update —
    // the `label` prop on sui-status-dot doesn't reflect, and
    // attribute writes also propagate through the reflect-prop
    // setters that do.
    function setStatus(state: string, text: string): void {
      const toneMap: Record<string, string> = {
        idle: 'muted', typing: 'info', running: 'warning',
        ok: 'success', error: 'destructive',
      }
      statusDot.setAttribute('tone', toneMap[state] ?? 'muted')
      if (state === 'typing' || state === 'running') {
        statusDot.setAttribute('pulse', '')
      } else {
        statusDot.removeAttribute('pulse')
      }
      statusDot.setAttribute('label', text)
      root.dataset.tutState = state
      if (state === 'error') {
        errorMsg.textContent = text
        errorAlert.hidden = false
      } else {
        errorAlert.hidden = true
      }
    }

    let iframeReady = false
    const iframe = root.querySelector<HTMLIFrameElement>('.tut-preview')!
    function resolvedTheme(): 'dark' | 'light' {
      if (document.documentElement.classList.contains('dark')) return 'dark'
      const t = document.documentElement.dataset.theme
      if (t === 'dark' || t === 'light') return t
      if (t && t.includes('dark')) return 'dark'
      if (t && t.includes('light')) return 'light'
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    function syncIframeTheme(): void {
      const base = iframe.dataset.baseSrc!
      iframe.src = `${base}?theme=${resolvedTheme()}&_=${Date.now()}`
      iframeReady = false
    }
    new MutationObserver(syncIframeTheme).observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme', 'class'],
    })
    syncIframeTheme()

    window.addEventListener('message', (e: MessageEvent) => {
      if (e.source === iframe.contentWindow && e.data?.kind === 'tutorial:ready') {
        iframeReady = true
        runNow()
      }
    })

    function tsToEsm(src: string): string {
      let s = src
      s = s.replace(/^\s*import\s+type\s+\{[^}]*\}\s+from\s+["'][^"']+["']\s*;?\s*$/gm, '')
      s = s.replace(/import\s+\{([^}]+)\}\s+from/g, (_m, inner: string) => {
        const cleaned = inner.split(',').map((p) => p.trim()).filter((p) => p && !p.startsWith('type ')).join(', ')
        return `import { ${cleaned} } from`
      })
      s = s.replace(/^\s*interface\s+\w+(\s+extends\s+[^\{]+)?\s*\{[^}]*\}\s*/gm, '')
      s = s.replace(/^\s*type\s+\w+\s*=\s*[^;]+;\s*/gm, '')
      s = s.replace(/\(([^()]*)\)\s*(:\s*[^=>{;,)]+)?\s*=>/g, (_m, params: string) => {
        const cleaned = params.split(',').map((p) => p.split(':')[0].trim()).filter(Boolean).join(', ')
        return `(${cleaned}) =>`
      })
      s = s.replace(/(\w+)<[^<>()]*>\(/g, '$1(')
      s = s.replace(/\s+as\s+[\w<>\[\]\|\s.,]+(?=[;,)\]\}])/g, '')
      s = s.replace(/(\bconst\s+\w+|\blet\s+\w+|\bvar\s+\w+)\s*:\s*[^=;,]+/g, '$1')
      return s
    }

    // Apply diagnostics to the template editor so compile errors
    // render as inline squiggles (in addition to the alert panel).
    // Wasm errors carry 1-based line/col — the same convention the
    // editor's setDiagnostics() expects.
    function clearDiagnostics(): void {
      tplEl.setDiagnostics?.([])
      ctrlEl.setDiagnostics?.([])
    }
    function emitDiagnostic(target: EditorEl, line: number, col: number, message: string): void {
      target.setDiagnostics?.([
        { line, column: col, severity: 'error', message, source: 'sui-compiler' },
      ])
    }

    async function runNow(): Promise<void> {
      if (!iframeReady) return
      setStatus('running', 'compiling…')
      const tag = `${tagBase}${++tagSeq}`
      try {
        const result = wasmCompile(
          currentTemplate,
          JSON.stringify({ componentName: tag, shadow: false, setupUrl: `./${tag}.controller.ts` }),
        ) as {
          kind: 'ok'; js: string
        } | {
          kind: 'err'; message: string; line?: number; col?: number
        }
        if (result.kind === 'err') {
          emitDiagnostic(tplEl, result.line ?? 1, result.col ?? 1, result.message)
          setStatus('error', result.message)
          return
        }
        clearDiagnostics()
        const controllerJs = tsToEsm(currentController)
        iframe.contentWindow!.postMessage(
          { kind: 'tutorial:run', template: result.js, controller: controllerJs, tag },
          '*',
        )
        setStatus('ok', 'running')
      } catch (e: unknown) {
        setStatus('error', e instanceof Error ? e.message : String(e))
      }
    }

    // Pull completion sources from the browser-side LSP worker.
    // Single source of truth — the same SUI_TEMPLATE_COMPLETIONS
    // shape, just owned by @ship/sui-lsp-browser so the shell editor
    // and any other consumer get the same set without duplicating
    // the modifier allowlist.
    ensureLsp().allSources()
      .then((sources) => tplEl.setCompletions?.(sources))
      .catch((e) => console.warn('[tutorial] lsp.allSources failed:', e))
  }

  Promise.all([ensureWasm(), ensureEditorCE(), ensureBaseCE()])
    .then(() => {
      document.querySelectorAll<HTMLElement>('.tut-app-root').forEach((root) => {
        if (root.dataset.booted === '1') return
        root.dataset.booted = '1'
        try {
          bootApp(root)
        } catch (e) {
          console.error('[tutorial] bootApp failed:', e)
        }
      })
    })
    .catch((e) => {
      console.error('[tutorial] init failed:', e)
    })
</script>

<style is:global>
  .tut-app-root {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 0;
    flex: 1;
  }
  /* Starlight's article/prose CSS slaps a top margin on every
     sibling div after the first. Our two panes are siblings;
     kill it so the flex gap is the only spacing between them. */
  .tut-app-root > * { margin: 0 !important; }

  .tut-pane {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
    background: var(--card, var(--sl-color-bg-sidebar));
    border: 1px solid var(--border, var(--sl-color-hairline-shade));
    border-radius: 8px;
    overflow: hidden;
  }
  .tut-pane--editor { flex: 1 1 0; min-height: 0; }
  .tut-pane--preview { flex: 0 0 38%; min-height: 0; }
  @media (min-width: 1600px) {
    .tut-pane--preview { flex: 0 0 34%; }
  }

  .tut-pane-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 4px 8px;
    border-bottom: 1px solid var(--border, var(--sl-color-hairline-shade));
    flex-shrink: 0;
    height: 36px;
    box-sizing: border-box;
  }
  /* Starlight's content reset gives every direct child of <article>
     a margin-top — when sui-tabs renders inside it, the first sui-tab
     inherits that, pushing the tablist down. Force-reset all chrome
     descendants. */
  .tut-pane-bar > *,
  .tut-pane-bar *:first-child {
    margin: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  .tut-pane-bar sui-tabs,
  .tut-pane-bar sui-tab,
  .tut-pane-bar sui-button {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .tut-tabs {
    /* sui-tabs ships with its own pill chrome; tighten the strip. */
    --tone: var(--primary);
    align-self: stretch;
    display: flex;
    align-items: center;
  }
  .tut-tabs::part(strip) {
    padding: 2px;
    background: transparent;
    border-bottom: 0 !important;
    align-items: center;
  }
  .tut-tab-icon {
    font-family: var(--font-mono, var(--sl-font-system-mono));
    color: var(--muted-foreground);
    font-size: 0.7rem;
    margin-right: 4px;
  }

  .tut-actions {
    display: flex;
    gap: 4px;
    align-items: center;
    align-self: center;
  }
  /* Pin the action buttons to the same height as a sui-tab so the
     pane bar reads as a single horizontal rail. */
  .tut-actions sui-button {
    --button-height: 26px;
    display: inline-flex;
    align-items: center;
    height: 26px;
  }
  .tut-actions sui-button::part(button) {
    height: 26px;
    min-height: 0;
    padding-block: 0;
  }

  .tut-editor-host {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .tut-editor-host > sui-tab-panel {
    flex: 1;
    min-height: 0;
    height: 100%;
  }
  .tut-editor-host > sui-tab-panel[active] {
    display: flex;
    flex-direction: column;
  }
  .tut-editor {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: block;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
  }

  .tut-diff-wrap {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    overflow-y: auto;
  }
  .tut-diff-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tut-diff-label {
    font-family: var(--font-mono, var(--sl-font-system-mono));
    font-size: 0.7rem;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .tut-diff {
    max-height: 240px;
    overflow-y: auto;
  }

  .tut-preview-host {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
  }
  .tut-preview {
    flex: 1;
    width: 100%;
    border: none;
    background: var(--background, var(--sl-color-bg));
  }

  .tut-error {
    margin: 8px 10px 0;
    flex-shrink: 0;
  }
  .tut-error-msg {
    margin: 0;
    font-family: var(--font-mono, var(--sl-font-system-mono));
    font-size: 0.75rem;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 120px;
    overflow-y: auto;
  }
</style>
