---
/*
  TutorialApp — editor + preview pane using SUI's own <sui-code-editor>
  component (no extra CodeMirror dep in the docs bundle, no separate
  syntax highlighting story, no second theme palette to keep in sync).
  The component is registered globally by /sui-components.js, which
  Astro already loads in the docs layout's <head>.

  Author flow on every edit:
    edit fires `sui-change` (debounced 150ms inside sui-code-editor)
      → tutorial-app's listener reads e.detail.value
      → sui-compiler (wasm) compiles the .sui → JS module
      → controller (.ts) regex-stripped to plain JS in-browser
      → both modules posted to the iframe host via postMessage;
        the host injects them as blob URLs, rewrites the template
        module's setup-import to the controller blob, and re-mounts
        the custom element under a fresh tag per run.

  Lives wholly inside `apps/docs/`; the per-step prose stays in
  `docs/ship-sui/references/tutorial/<NN-slug>/index.md` and is
  rendered separately by the route page.
*/
interface Props {
  slug: string
  starterTemplate: string
  starterController: string
  solvedTemplate: string
  solvedController: string
}
const { slug, starterTemplate, starterController, solvedTemplate, solvedController } = Astro.props
---

<div
  class="tut-app-root"
  data-slug={slug}
  data-starter-template={starterTemplate}
  data-starter-controller={starterController}
  data-solved-template={solvedTemplate}
  data-solved-controller={solvedController}
>
  <div class="tut-pane tut-pane--editor">
    <div class="tut-pane-bar">
      <div class="tut-tabs">
        <button class="tut-tab" data-tab="template" aria-selected="true">
          <span class="tut-tab-icon">⟨/⟩</span> template.sui
        </button>
        <button class="tut-tab" data-tab="controller">
          <span class="tut-tab-icon">{}</span> controller.ts
        </button>
      </div>
      <div class="tut-actions">
        <button class="tut-action" data-action="reset" title="Reset to starter code">
          <span aria-hidden="true">↺</span> Reset
        </button>
        <button class="tut-action tut-action--accent" data-action="solution" title="Replace with the answer">
          Show solution
        </button>
      </div>
    </div>
    <div class="tut-editor-host">
      <sui-code-editor
        class="tut-editor"
        data-pane="template"
        language="html"
        size="sm"
        value={starterTemplate}
      ></sui-code-editor>
      <sui-code-editor
        class="tut-editor"
        data-pane="controller"
        language="typescript"
        size="sm"
        value={starterController}
        hidden
      ></sui-code-editor>
    </div>
  </div>

  <div class="tut-pane tut-pane--preview">
    <div class="tut-pane-bar">
      <div class="tut-status">
        <span class="tut-status-dot" data-state="idle"></span>
        <span class="tut-status-text">ready</span>
      </div>
      <button class="tut-action" data-action="run" title="Re-run with current code">
        <span aria-hidden="true">↻</span> Run
      </button>
    </div>
    <div class="tut-preview-host">
      <iframe
        class="tut-preview"
        data-base-src="/tutorial/host.html"
        title="Tutorial preview"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    </div>
  </div>
</div>

<script>
  // WASM compiler load — Vite bundles these as static imports.
  import initWasm, { compile as wasmCompile } from '@ship/sui-compiler-wasm'
  import wasmUrl from '@ship/sui-compiler-wasm/sui_compiler_bg.wasm?url'

  let wasmReady: Promise<unknown> | null = null
  function ensureWasm() {
    if (!wasmReady) wasmReady = initWasm(wasmUrl)
    return wasmReady
  }

  // The Ship code editor lives at /sui-components/sui-code-editor.js
  // — pre-bundled by `bun --filter @ship/ui-components build`, copied
  // into apps/docs/public/sui-components/, self-registers on import.
  let editorLoad: Promise<unknown> | null = null
  function ensureEditorCE(): Promise<unknown> {
    if (typeof customElements === 'undefined') return Promise.resolve()
    if (!editorLoad) {
      // String concat keeps the URL opaque to Rollup so it doesn't try
      // to resolve `/sui-components/...` at build time.
      const url = '/sui-components/' + 'sui-code-editor.js'
      editorLoad = import(/* @vite-ignore */ url)
        .then(() => customElements.whenDefined('sui-code-editor'))
    }
    return editorLoad
  }

  interface EditorEl extends HTMLElement {
    value: string
  }

  function bootApp(root: HTMLElement): void {
    const slug = root.dataset.slug ?? ''
    const starterTemplate = root.dataset.starterTemplate ?? ''
    const starterController = root.dataset.starterController ?? ''
    const solvedTemplate = root.dataset.solvedTemplate ?? ''
    const solvedController = root.dataset.solvedController ?? ''

    let currentTemplate = starterTemplate
    let currentController = starterController
    const tagBase = `tut-${slug.replace(/[^a-z0-9-]/gi, '')}-`
    let tagSeq = 0

    const tplEl = root.querySelector<EditorEl>('sui-code-editor[data-pane="template"]')!
    const ctrlEl = root.querySelector<EditorEl>('sui-code-editor[data-pane="controller"]')!

    // sui-change comes pre-debounced (150ms) — listen and recompile.
    tplEl.addEventListener('sui-change', (e) => {
      const v = (e as CustomEvent<{ value: string }>).detail.value
      currentTemplate = v
      scheduleRun()
    })
    ctrlEl.addEventListener('sui-change', (e) => {
      const v = (e as CustomEvent<{ value: string }>).detail.value
      currentController = v
      scheduleRun()
    })
    // Also schedule on the lower-level `input` event so the UI's
    // "editing…" status appears immediately on keystroke instead of
    // waiting for the 150ms debounce window inside sui-code-editor.
    tplEl.addEventListener('input', () => setStatus('typing', 'editing…'))
    ctrlEl.addEventListener('input', () => setStatus('typing', 'editing…'))

    // Tab switching — hide the inactive editor, keep both mounted so
    // the value state survives toggling.
    root.querySelectorAll<HTMLButtonElement>('.tut-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const which = btn.dataset.tab
        if (!which) return
        root.querySelectorAll<HTMLButtonElement>('.tut-tab').forEach((b) => {
          b.setAttribute('aria-selected', String(b.dataset.tab === which))
        })
        root.querySelectorAll<HTMLElement>('sui-code-editor').forEach((p) => {
          p.hidden = p.dataset.pane !== which
        })
      })
    })

    // Action buttons.
    root.querySelector('[data-action="reset"]')!.addEventListener('click', () => {
      currentTemplate = starterTemplate
      currentController = starterController
      tplEl.value = starterTemplate
      ctrlEl.value = starterController
      runNow()
    })
    root.querySelector('[data-action="solution"]')!.addEventListener('click', () => {
      currentTemplate = solvedTemplate
      currentController = solvedController
      tplEl.value = solvedTemplate
      ctrlEl.value = solvedController
      runNow()
    })
    root.querySelector('[data-action="run"]')!.addEventListener('click', () => runNow())

    // Status.
    const statusDot = root.querySelector<HTMLElement>('.tut-status-dot')!
    const statusText = root.querySelector<HTMLElement>('.tut-status-text')!
    function setStatus(state: string, text: string): void {
      statusDot.dataset.state = state
      statusText.textContent = text
    }

    // Iframe + theme sync.
    let iframeReady = false
    const iframe = root.querySelector<HTMLIFrameElement>('.tut-preview')!
    function resolvedTheme(): 'dark' | 'light' {
      if (document.documentElement.classList.contains('dark')) return 'dark'
      const t = document.documentElement.dataset.theme
      if (t === 'dark' || t === 'light') return t
      if (t && t.includes('dark')) return 'dark'
      if (t && t.includes('light')) return 'light'
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    function syncIframeTheme(): void {
      const base = iframe.dataset.baseSrc!
      iframe.src = `${base}?theme=${resolvedTheme()}&_=${Date.now()}`
      iframeReady = false
    }
    new MutationObserver(syncIframeTheme).observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme', 'class'],
    })
    syncIframeTheme()

    window.addEventListener('message', (e: MessageEvent) => {
      if (e.source === iframe.contentWindow && e.data?.kind === 'tutorial:ready') {
        iframeReady = true
        runNow()
      }
    })

    function tsToEsm(src: string): string {
      let s = src
      s = s.replace(/^\s*import\s+type\s+\{[^}]*\}\s+from\s+["'][^"']+["']\s*;?\s*$/gm, '')
      s = s.replace(/import\s+\{([^}]+)\}\s+from/g, (_m, inner: string) => {
        const cleaned = inner.split(',').map((p) => p.trim()).filter((p) => p && !p.startsWith('type ')).join(', ')
        return `import { ${cleaned} } from`
      })
      s = s.replace(/^\s*interface\s+\w+(\s+extends\s+[^\{]+)?\s*\{[^}]*\}\s*/gm, '')
      s = s.replace(/^\s*type\s+\w+\s*=\s*[^;]+;\s*/gm, '')
      s = s.replace(/\(([^()]*)\)\s*(:\s*[^=>{;,)]+)?\s*=>/g, (_m, params: string) => {
        const cleaned = params.split(',').map((p) => p.split(':')[0].trim()).filter(Boolean).join(', ')
        return `(${cleaned}) =>`
      })
      s = s.replace(/(\w+)<[^<>()]*>\(/g, '$1(')
      s = s.replace(/\s+as\s+[\w<>\[\]\|\s.,]+(?=[;,)\]\}])/g, '')
      s = s.replace(/(\bconst\s+\w+|\blet\s+\w+|\bvar\s+\w+)\s*:\s*[^=;,]+/g, '$1')
      return s
    }

    async function runNow(): Promise<void> {
      if (!iframeReady) return
      setStatus('running', 'compiling…')
      const tag = `${tagBase}${++tagSeq}`
      try {
        const result = wasmCompile(
          currentTemplate,
          JSON.stringify({ componentName: tag, shadow: false, setupUrl: `./${tag}.controller.ts` }),
        ) as { kind: 'ok'; js: string } | { kind: 'err'; message: string }
        if (result.kind === 'err') {
          setStatus('error', result.message)
          return
        }
        const controllerJs = tsToEsm(currentController)
        iframe.contentWindow!.postMessage(
          { kind: 'tutorial:run', template: result.js, controller: controllerJs, tag },
          '*',
        )
        setStatus('ok', 'running')
      } catch (e: unknown) {
        setStatus('error', e instanceof Error ? e.message : String(e))
      }
    }

    function scheduleRun(): void {
      runNow()
    }
  }

  // Boot once the WASM compiler AND the <sui-code-editor> definition
  // are both available. Apps are idempotent — `data-booted` guards
  // re-runs if the page re-hydrates.
  Promise.all([ensureWasm(), ensureEditorCE()])
    .then(() => {
      document.querySelectorAll<HTMLElement>('.tut-app-root').forEach((root) => {
        if (root.dataset.booted === '1') return
        root.dataset.booted = '1'
        try {
          bootApp(root)
        } catch (e) {
          console.error('[tutorial] bootApp failed:', e)
        }
      })
    })
    .catch((e) => {
      console.error('[tutorial] init failed:', e)
    })
</script>

<style is:global>
  .tut-app-root {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
    flex: 1;
  }

  .tut-pane {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 10px;
    overflow: hidden;
  }
  .tut-pane--editor { flex-basis: 60%; }
  .tut-pane--preview { flex-basis: 40%; }

  .tut-pane-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 6px 10px;
    background: var(--sl-color-bg-sidebar);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    flex-shrink: 0;
    min-height: 38px;
  }

  .tut-tabs { display: flex; gap: 2px; }
  .tut-tab {
    background: transparent;
    color: var(--sl-color-gray-2);
    border: 1px solid transparent;
    padding: 4px 10px;
    font: inherit;
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 120ms ease, background-color 120ms ease;
  }
  .tut-tab:hover {
    color: var(--sl-color-text);
    background: color-mix(in oklch, var(--sl-color-text) 4%, transparent);
  }
  .tut-tab[aria-selected="true"] {
    color: var(--sl-color-text-accent);
    background: color-mix(in oklch, var(--sl-color-text-accent) 10%, transparent);
    border-color: color-mix(in oklch, var(--sl-color-text-accent) 30%, transparent);
  }
  .tut-tab-icon {
    font-family: var(--sl-font-system-mono);
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
  }
  .tut-tab[aria-selected="true"] .tut-tab-icon {
    color: var(--sl-color-text-accent);
  }

  .tut-actions { display: flex; gap: 6px; }
  .tut-action {
    background: transparent;
    border: 1px solid var(--sl-color-hairline-shade);
    color: var(--sl-color-gray-2);
    padding: 4px 10px;
    border-radius: 6px;
    font: inherit;
    font-family: var(--sl-font-system-mono);
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 120ms ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .tut-action:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
    background: color-mix(in oklch, var(--sl-color-text-accent) 8%, transparent);
  }
  .tut-action--accent {
    border-color: color-mix(in oklch, var(--sl-color-text-accent) 50%, transparent);
    color: var(--sl-color-text-accent);
  }
  .tut-action--accent:hover {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
    border-color: var(--sl-color-text-accent);
  }

  .tut-editor-host {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    position: relative;
  }
  .tut-editor {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: block;
    /* sui-code-editor sets border + radius on :host; we already have
       a chrome around it from .tut-pane, so flatten its own. */
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
  }
  .tut-editor[hidden] { display: none; }

  .tut-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sl-font-system-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    min-width: 0;
    flex: 1;
  }
  .tut-status-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--sl-color-gray-4);
    flex-shrink: 0;
    transition: background 200ms ease, box-shadow 200ms ease;
  }
  .tut-status-dot[data-state="ok"] {
    background: var(--sl-color-green-high);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--sl-color-green-high) 18%, transparent);
  }
  .tut-status-dot[data-state="running"] { background: var(--sl-color-orange-high); }
  .tut-status-dot[data-state="typing"] {
    background: var(--sl-color-blue-high);
    animation: tut-pulse 1.2s ease-in-out infinite;
  }
  .tut-status-dot[data-state="error"] {
    background: var(--sl-color-red-high);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--sl-color-red-high) 22%, transparent);
  }
  @keyframes tut-pulse {
    0%, 100% { opacity: 1 }
    50% { opacity: 0.4 }
  }
  .tut-status-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .tut-preview-host {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
  }
  .tut-preview {
    flex: 1;
    width: 100%;
    border: none;
    background: var(--sl-color-bg);
  }
</style>
