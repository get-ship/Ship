---
/*
  TutorialApp — the editor + preview pane.

  Astro-rendered shell + a client-side `<script>` that wires
  CodeMirror, the WASM sui-compiler, and the preview iframe.

  Source flow on every edit:
    template (.sui) + controller (.ts) in editor
      → sui-compiler (wasm) compiles the .sui → JS module
      → controller stays as TypeScript source; we strip TS-only
        syntax in the browser via a small regex pass (no full TS
        compile — tutorial scope is signal/derived/effect with
        explicit annotations the regex handles).
      → both modules posted to the iframe host via postMessage;
        the iframe injects them as blob URLs and re-mounts the
        custom element with a fresh tag name (so the registration
        is unique per run — CE definitions are permanent).

  Edit is debounced ~250ms so each keystroke doesn't trigger a
  recompile.
*/
interface Props {
  slug: string
  starterTemplate: string
  starterController: string
  solvedTemplate: string
  solvedController: string
}
const { slug, starterTemplate, starterController, solvedTemplate, solvedController } = Astro.props
---

<div
  class="tut-app-root"
  data-slug={slug}
  data-starter-template={starterTemplate}
  data-starter-controller={starterController}
  data-solved-template={solvedTemplate}
  data-solved-controller={solvedController}
>
  <div class="tut-pane tut-pane--editor">
    <div class="tut-pane-bar">
      <div class="tut-tabs">
        <button class="tut-tab" data-tab="template" aria-selected="true">
          <span class="tut-tab-icon">⟨/⟩</span> template.sui
        </button>
        <button class="tut-tab" data-tab="controller">
          <span class="tut-tab-icon">{}</span> controller.ts
        </button>
      </div>
      <div class="tut-actions">
        <button class="tut-action" data-action="reset" title="Reset to starter code">
          <span aria-hidden="true">↺</span> Reset
        </button>
        <button class="tut-action tut-action--accent" data-action="solution" title="Replace with the answer">
          Show solution
        </button>
      </div>
    </div>
    <div class="tut-editor-host">
      <div class="tut-editor" data-pane="template"></div>
      <div class="tut-editor" data-pane="controller" hidden></div>
    </div>
  </div>

  <div class="tut-pane tut-pane--preview">
    <div class="tut-pane-bar">
      <div class="tut-status" id={`tut-status-${slug}`}>
        <span class="tut-status-dot" data-state="idle"></span>
        <span class="tut-status-text">ready</span>
      </div>
      <button class="tut-action" data-action="run" title="Re-run with current code">
        <span aria-hidden="true">↻</span> Run
      </button>
    </div>
    <div class="tut-preview-host">
      <iframe
        class="tut-preview"
        data-base-src="/tutorial/host.html"
        title="Tutorial preview"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    </div>
  </div>
</div>

<script>
  // Top-level static imports so Vite bundles them; the runtime
  // code reads its per-instance config off `[data-slug]` data
  // attributes on the component root, NOT off `define:vars` (which
  // would force `await import(...)` and break Vite's bundling of
  // bare specifiers like `codemirror`).
  import { EditorView, basicSetup } from 'codemirror'
  import { html } from '@codemirror/lang-html'
  import { javascript } from '@codemirror/lang-javascript'
  import { oneDark } from '@codemirror/theme-one-dark'
  import initWasm, { compile as wasmCompile } from '@ship/sui-compiler-wasm'
  import wasmUrl from '@ship/sui-compiler-wasm/sui_compiler_bg.wasm?url'

  // Initialize the wasm module once for the whole page; subsequent
  // TutorialApp instances share it. wasm-pack's web target accepts
  // a URL (or fetch-able value) and resolves when ready.
  let wasmReadyPromise: Promise<unknown> | null = null
  function ensureWasm() {
    if (!wasmReadyPromise) wasmReadyPromise = initWasm(wasmUrl)
    return wasmReadyPromise
  }

  function bootApp(root: HTMLElement) {
    const slug = root.dataset.slug ?? ''
    const starterTemplate = root.dataset.starterTemplate ?? ''
    const starterController = root.dataset.starterController ?? ''
    const solvedTemplate = root.dataset.solvedTemplate ?? ''
    const solvedController = root.dataset.solvedController ?? ''

    // State.
    let currentTemplate = starterTemplate
    let currentController = starterController
    const tagBase = `tut-${slug.replace(/[^a-z0-9-]/gi, '')}-`
    let tagSeq = 0

    // Build editors. CodeMirror 6 — basicSetup gives line numbers,
    // history, selection, etc. Theme matches the docs dark theme;
    // light theme inherits CodeMirror's default light styling via
    // omitting oneDark when docs are light.
    const tplPane = root.querySelector('[data-pane="template"]')
    const ctrlPane = root.querySelector('[data-pane="controller"]')

    const tplView = new EditorView({
      doc: currentTemplate,
      extensions: [
        basicSetup,
        html({ matchClosingTags: true }),
        oneDark,
        EditorView.updateListener.of((u) => {
          if (!u.docChanged) return
          currentTemplate = u.state.doc.toString()
          scheduleRun()
        }),
      ],
      parent: tplPane,
    })

    const ctrlView = new EditorView({
      doc: currentController,
      extensions: [
        basicSetup,
        javascript({ typescript: true }),
        oneDark,
        EditorView.updateListener.of((u) => {
          if (!u.docChanged) return
          currentController = u.state.doc.toString()
          scheduleRun()
        }),
      ],
      parent: ctrlPane,
    })

    // Tab switching.
    root.querySelectorAll('.tut-tab').forEach((b) => {
      b.addEventListener('click', () => {
        const which = b.dataset.tab
        root.querySelectorAll('.tut-tab').forEach((bb) => {
          bb.setAttribute('aria-selected', String(bb.dataset.tab === which))
        })
        root.querySelectorAll('.tut-editor').forEach((p) => {
          p.hidden = p.dataset.pane !== which
        })
      })
    })

    // Action buttons.
    root.querySelector('[data-action="reset"]').addEventListener('click', () => {
      currentTemplate = starterTemplate
      currentController = starterController
      tplView.dispatch({ changes: { from: 0, to: tplView.state.doc.length, insert: starterTemplate } })
      ctrlView.dispatch({ changes: { from: 0, to: ctrlView.state.doc.length, insert: starterController } })
    })
    root.querySelector('[data-action="solution"]').addEventListener('click', () => {
      currentTemplate = solvedTemplate
      currentController = solvedController
      tplView.dispatch({ changes: { from: 0, to: tplView.state.doc.length, insert: solvedTemplate } })
      ctrlView.dispatch({ changes: { from: 0, to: ctrlView.state.doc.length, insert: solvedController } })
    })
    root.querySelector('[data-action="run"]').addEventListener('click', () => runNow())

    // Status.
    const statusDot = root.querySelector('.tut-status-dot')
    const statusText = root.querySelector('.tut-status-text')
    function setStatus(state, text) {
      statusDot.dataset.state = state
      statusText.textContent = text
    }

    // Compile + post to iframe.
    let iframeReady = false
    const iframe = root.querySelector('.tut-preview')
    function resolvedTheme() {
      if (document.documentElement.classList.contains('dark')) return 'dark'
      const t = document.documentElement.dataset.theme
      if (t === 'dark' || t === 'light') return t
      if (t && t.includes('dark')) return 'dark'
      if (t && t.includes('light')) return 'light'
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    function syncIframeTheme() {
      const base = iframe.dataset.baseSrc
      iframe.src = `${base}?theme=${resolvedTheme()}&_=${Date.now()}`
      iframeReady = false
    }
    new MutationObserver(syncIframeTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'class'],
    })
    syncIframeTheme()

    window.addEventListener('message', (e) => {
      if (e.source === iframe.contentWindow && e.data?.kind === 'tutorial:ready') {
        iframeReady = true
        runNow()
      }
    })

    let debounceTimer = 0
    function scheduleRun() {
      clearTimeout(debounceTimer)
      setStatus('typing', 'editing…')
      debounceTimer = window.setTimeout(runNow, 250)
    }

    /**
     * Translate the TS controller source into plain ES that runs in
     * the browser. The tutorial scope is small — strip `import type`
     * statements, `interface` declarations, type annotations on
     * params + variables. Not a real TS compile (no SWC); good
     * enough for the tutorial code shapes we author. If a learner
     * pastes pathological TS the iframe surfaces a JS error, which
     * is correct feedback for a tutorial.
     */
    function tsToEsm(src) {
      let s = src
      // import type { … } from '…' → drop
      s = s.replace(/^\s*import\s+type\s+\{[^}]*\}\s+from\s+["'][^"']+["']\s*;?\s*$/gm, '')
      // import { type T, x, type U } from '…' → import { x } from '…'
      s = s.replace(/import\s+\{([^}]+)\}\s+from/g, (_m, inner) => {
        const cleaned = inner.split(',')
          .map(p => p.trim())
          .filter(p => p && !p.startsWith('type '))
          .join(', ')
        return `import { ${cleaned} } from`
      })
      // `interface Foo { … }` → drop block (multi-line, simple-brace)
      s = s.replace(/^\s*interface\s+\w+(\s+extends\s+[^\{]+)?\s*\{[^}]*\}\s*/gm, '')
      // `type Foo = …;` → drop (single-line)
      s = s.replace(/^\s*type\s+\w+\s*=\s*[^;]+;\s*/gm, '')
      // function params: `(name: Type, name2: Type2)` → `(name, name2)`
      // and arrow `(name: Type): Ret =>` → `(name) =>`.
      //
      // `[^()]*` (not `[^)]*`) is load-bearing: it prevents the match
      // from crossing nested parens. Without that, the regex would
      // greedily eat `controller(...{...scope: ()...` and corrupt the
      // result. Limits us to flat arrow signatures — fine for the
      // tutorial scope, where the only nested-paren case is generic
      // annotations like `Map<K, V>` which the tutorial code avoids.
      s = s.replace(/\(([^()]*)\)\s*(:\s*[^=>{;,)]+)?\s*=>/g, (_m, params) => {
        const cleaned = params.split(',').map(p => p.split(':')[0].trim()).filter(Boolean).join(', ')
        return `(${cleaned}) =>`
      })
      // Generic angle-brackets on calls: `signal<Foo>(...)` → `signal(...)`
      s = s.replace(/(\w+)<[^<>()]*>\(/g, '$1(')
      // `as Foo` casts → drop
      s = s.replace(/\s+as\s+[\w<>\[\]\|\s.,]+(?=[;,)\]\}])/g, '')
      // `: Type` annotations on `const x: Type = …` → drop
      s = s.replace(/(\bconst\s+\w+|\blet\s+\w+|\bvar\s+\w+)\s*:\s*[^=;,]+/g, '$1')
      return s
    }

    async function runNow() {
      if (!iframeReady) return
      clearTimeout(debounceTimer)
      setStatus('running', 'compiling…')
      const tag = `${tagBase}${++tagSeq}`
      try {
        // setupUrl tells the compiler to emit `import setup from "<url>"`
        // at the top of the template module — that's what wires the
        // controller scope into $scope. The host page rewrites the
        // value to a blob URL of the (TS-stripped) controller before
        // importing the template. The literal we pass here just has to
        // be unique + rewritable; the rewrite key is the `.controller.ts`
        // suffix the compiler appends.
        const result = wasmCompile(
          currentTemplate,
          JSON.stringify({
            componentName: tag,
            shadow: false,
            setupUrl: `./${tag}.controller.ts`,
          }),
        ) as { kind: 'ok'; js: string } | { kind: 'err'; message: string }
        if (result.kind === 'err') {
          setStatus('error', result.message)
          return
        }
        // Compiled template imports the controller from './<tag>.controller.ts'
        // by default — the host page rewrites that import to a blob URL of
        // the JS-transpiled controller. We pass both modules over.
        const controllerJs = tsToEsm(currentController)
        iframe.contentWindow.postMessage(
          {
            kind: 'tutorial:run',
            template: result.js,
            controller: controllerJs,
            tag,
          },
          '*',
        )
        setStatus('ok', 'running')
      } catch (e: unknown) {
        const msg = e instanceof Error ? e.message : String(e)
        setStatus('error', msg)
      }
    }
  }

  // Wire every TutorialApp on the page once the WASM compiler is
  // ready. Idempotent — re-running bootApp on the same root is a
  // no-op because the editors already exist.
  ensureWasm().then(() => {
    document.querySelectorAll<HTMLElement>('.tut-app-root').forEach((root) => {
      if (root.dataset.booted === '1') return
      root.dataset.booted = '1'
      try {
        bootApp(root)
      } catch (e) {
        console.error('[tutorial] bootApp failed:', e)
      }
    })
  }).catch((e) => {
    console.error('[tutorial] wasm init failed:', e)
  })
</script>

<style is:global>
  .tut-app-root {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
    flex: 1;
  }

  .tut-pane {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 240px;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 0 color-mix(in oklch, var(--sl-color-white) 5%, transparent) inset;
  }
  .tut-pane--editor { flex-basis: 55%; }
  .tut-pane--preview { flex-basis: 45%; }

  .tut-pane-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 6px 8px 6px 10px;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--sl-color-bg-sidebar) 88%, var(--sl-color-bg) 12%),
      var(--sl-color-bg-sidebar)
    );
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    flex-shrink: 0;
    min-height: 36px;
  }

  .tut-tabs {
    display: flex;
    gap: 2px;
  }
  .tut-tab {
    background: transparent;
    color: var(--sl-color-gray-2);
    border: 1px solid transparent;
    padding: 4px 10px;
    font: inherit;
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 120ms ease, background-color 120ms ease;
  }
  .tut-tab:hover {
    color: var(--sl-color-text);
    background: color-mix(in oklch, var(--sl-color-text) 4%, transparent);
  }
  .tut-tab[aria-selected="true"] {
    color: var(--sl-color-text-accent);
    background: color-mix(in oklch, var(--sl-color-text-accent) 10%, transparent);
    border-color: color-mix(in oklch, var(--sl-color-text-accent) 30%, transparent);
  }
  .tut-tab-icon {
    font-family: var(--sl-font-system-mono);
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
  }
  .tut-tab[aria-selected="true"] .tut-tab-icon {
    color: var(--sl-color-text-accent);
  }

  .tut-actions {
    display: flex;
    gap: 6px;
  }
  .tut-action {
    background: transparent;
    border: 1px solid var(--sl-color-hairline-shade);
    color: var(--sl-color-gray-2);
    padding: 4px 10px;
    border-radius: 6px;
    font: inherit;
    font-family: var(--sl-font-system-mono);
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 120ms ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .tut-action:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
    background: color-mix(in oklch, var(--sl-color-text-accent) 8%, transparent);
  }
  .tut-action--accent {
    border-color: color-mix(in oklch, var(--sl-color-text-accent) 50%, transparent);
    color: var(--sl-color-text-accent);
  }
  .tut-action--accent:hover {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
    border-color: var(--sl-color-text-accent);
  }

  .tut-editor-host {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
  }
  .tut-editor {
    flex: 1;
    min-width: 0;
    height: 100%;
  }
  .tut-editor .cm-editor {
    height: 100%;
    background: transparent !important;
  }
  .tut-editor .cm-scroller {
    font-family: var(--sl-font-system-mono);
    font-size: 0.8125rem;
  }
  .tut-editor .cm-gutters {
    background: transparent !important;
    border-right: 1px solid var(--sl-color-hairline-shade) !important;
  }

  .tut-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sl-font-system-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    min-width: 0;
    flex: 1;
  }
  .tut-status-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--sl-color-gray-4);
    flex-shrink: 0;
    transition: background 200ms ease, box-shadow 200ms ease;
  }
  .tut-status-dot[data-state="ok"] {
    background: var(--sl-color-green-high);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--sl-color-green-high) 18%, transparent);
  }
  .tut-status-dot[data-state="running"] { background: var(--sl-color-orange-high); }
  .tut-status-dot[data-state="typing"] {
    background: var(--sl-color-blue-high);
    animation: tut-pulse 1.2s ease-in-out infinite;
  }
  .tut-status-dot[data-state="error"] {
    background: var(--sl-color-red-high);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--sl-color-red-high) 22%, transparent);
  }
  @keyframes tut-pulse {
    0%, 100% { opacity: 1 }
    50% { opacity: 0.4 }
  }
  .tut-status-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .tut-preview-host {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    background:
      linear-gradient(45deg, transparent 49.5%, var(--sl-color-hairline-shade) 49.5% 50.5%, transparent 50.5%) 0 0/12px 12px,
      linear-gradient(-45deg, transparent 49.5%, var(--sl-color-hairline-shade) 49.5% 50.5%, transparent 50.5%) 0 0/12px 12px;
    /* Subtle hairline texture so the iframe's bg has a visible edge */
  }
  .tut-preview {
    flex: 1;
    width: 100%;
    border: none;
    background: var(--sl-color-bg);
  }
</style>
