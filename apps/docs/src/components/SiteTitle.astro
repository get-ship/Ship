---
// Custom SiteTitle. The Lit-era `<ship-mark>` was the brand-logo SVG
// component; SUI reused the `<sui-mark>` name for a text-highlight
// primitive (HTML <mark> with tone tint). Render the logo SVG directly
// — there's no SUI brand-logo primitive to swap in.
import logo from "../assets/logo.svg";
---

<a href="/" class="site-title">
  <img src={logo.src} alt="" class="site-mark" aria-hidden="true" />
  <span class="site-title-text">SHIP</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    font-weight: 700;
    line-height: 1;
  }
  .site-mark {
    width: 28px;
    height: 28px;
    flex: none;
    display: block;
  }
  .site-title-text {
    font-family: var(--font-display, inherit);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--foreground, var(--sl-color-text-accent));
  }
</style>
