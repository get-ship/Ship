---
// Docs header theme picker — uses the SUI `<sui-theme-picker>` primitive
// directly. The element is registered globally by `/sui-components.js`
// (loaded from astro.config.mjs head), reads/writes the same
// `ship-site-theme` localStorage key the inline pre-paint script restores,
// and dispatches `sui-theme-change` on selection.
//
// `persist="true"` is the default — kept here so the intent is explicit.
// The picker writes localStorage; tier-2 write-through to /api/settings
// is a no-op against a static site.
---

<sui-theme-picker class="docs-theme-picker" persist></sui-theme-picker>

<style>
  .docs-theme-picker {
    display: inline-flex;
    align-items: center;
  }
</style>
