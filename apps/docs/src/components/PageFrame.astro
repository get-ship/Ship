---
/*
  Custom PageFrame — wraps Starlight's default to support a "sui-canvas"
  layout where the page wants the full viewport (interactive playground,
  component reference with live previews). Other topics keep the
  standard chrome (header + left sidebar + content + right TOC).

  A page opts into the canvas layout by adding `template: 'sui-canvas'`
  to its frontmatter. The PageFrame:
    - drops the persistent left sidebar (mobile drawer still works)
    - drops the right TOC (PageSidebar override does that)
    - widens main-frame inline-start to 0
    - keeps the global header (theme switcher, site title, search)

  Implementation pulls directly from the upstream component
  (node_modules/@astrojs/starlight/components/PageFrame.astro) so the
  default branch stays drop-in compatible. Only behavior diverges when
  Astro.locals.starlightRoute.entry.data.template === 'sui-canvas'.
*/
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle'

const { hasSidebar, entry } = Astro.locals.starlightRoute
const template = (entry?.data as { template?: string } | undefined)?.template
const isCanvas = template === 'sui-canvas'
const showSidebar = hasSidebar && !isCanvas
---

<div class="page sl-flex" data-template={template ?? 'default'}>
  <header class="header"><slot name="header" /></header>
  {
    showSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame" data-canvas={isCanvas ? '' : null}><slot /></div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
    }

    :global([aria-expanded='true']) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    /* sui-canvas: drop the left-sidebar inset so the content area
       runs edge-to-edge. main-frame width was capped at viewport
       minus sidebar width; setting padding to 0 returns the lost
       ~256px to playground content. */
    .main-frame[data-canvas] {
      padding-inline-start: 0;
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }
</style>
