<prop name="shadow" type="bool" default="false" />

<div class="card">
  <p>count: <strong>{count()}</strong> · ×2: <strong>{doubled()}</strong></p>
  <p>greeting: <em>{greeting()}</em></p>
  <div class="row">
    <button on:click={() => bump(1)}>+1</button>
    <input prop:value={name()} on:sui-input={(e) => setName(e.detail.value)} placeholder="name" />
  </div>
</div>
