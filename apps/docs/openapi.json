          }
        }
      }
    },
    "/api/runtime/events": {
      "get": {
        "tags": [
          "runtime"
        ],
        "summary": "GET /api/runtime/events — SSE stream of all kernel events.",
        "operationId": "event_stream",
        "responses": {
          "200": {
            "description": "SSE stream of kernel events"
          }
        }
      }
    },
    "/api/runtime/jobs": {
      "get": {
        "tags": [
          "runtime"
        ],
        "summary": "GET /api/runtime/jobs",
        "description": "Returns each `JobRecord` with two operator-visibility annotations:\n\n- `process_state`: `\"alive\"` when the latest process projection for the\n  slug is still Running, `\"missing\"` when the most recent supervisor\n  sweep flagged drift (no_process) without a coherence_restored after\n  it, `\"terminal\"` for jobs in a terminal status, `\"none\"` otherwise.\n- `notes`: optional truncated error / blocker for the row's NOTES column.",
        "operationId": "list_jobs",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeshResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "runtime"
        ],
        "summary": "POST /api/runtime/jobs — emit job.created event through the kernel.",
        "description": "The kernel persists the event and routes it to subscribers.\nThe job_dispatch service handles all heavy lifting (worktree creation,\ndependency resolution, agent spawning).",
        "operationId": "create_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeshResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/runtime/jobs/end": {
      "post": {
        "tags": [
          "runtime"
        ],
        "summary": "POST /api/runtime/jobs/end — signal that a provider turn ended for a job.",
        "description": "Called by the session Stop hook when an agent finishes a response turn.\nFor multi-step pipeline jobs, this sends a TurnEnded signal to the step\nmonitor (which accumulates evidence before deciding to advance).\nFor single-step jobs, emits job.completed directly.",
        "operationId": "end_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobEndRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeshResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/runtime/rebuild-projections": {
      "post": {
        "tags": [
          "runtime"
        ],
        "summary": "POST /api/runtime/rebuild-projections — rebuild all projections from events.",
        "operationId": "rebuild_projections",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeshResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/runtime/sessions": {
      "get": {
        "tags": [
