                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActorSpawnReq": {
        "type": "object",
        "required": [
          "actor_id",
          "config"
        ],
        "properties": {
          "actor_id": {
            "type": "string"
          },
          "capabilities": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Optional mesh capabilities for auto-registration."
          },
          "config": {
            "type": "object"
          }
        }
      },
      "CapabilitiesResponse": {
        "type": "object",
        "required": [
          "authenticated",
          "mode",
          "tier",
          "features"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          }
        }
      },
      "CheckoutHookReq": {
        "type": "object",
        "required": [
          "branch",
          "path"
        ],
        "properties": {
          "branch": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "CreateJobRequest": {
        "type": "object",
        "required": [
          "slug",
          "agent",
          "branch",
          "spec_path"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "depends_on": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "headless": {
            "type": "boolean",
            "description": "When true, force the headless (ProcessExecutor) path. When false or\nabsent, the default TmuxWindowExecutor (tmux-window) path is used."
          },
          "pipeline": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": "string"
          },
          "source_spec_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Operator-facing path to the spec file (absolute when resolvable).\nPlumbed into the JobRecord so `ship jobs` can distinguish which\nspec each job was dispatched from. Distinct from `spec_path`\n(daemon-side worktree destination). Optional: `--spec-text`\ndispatches and legacy callers send `None`."
          },
          "spec_content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Inline spec content. Travels in the JobCreated event; the worktree\nadapter writes it to `spec_path` at dispatch time."
          },
          "spec_path": {
            "type": "string"
          },
          "vars": {
            "type": [
              "object",
              "null"
            ],
            "description": "Pipeline variables for `{{ var }}` interpolation in step fields.\nMerged over pipeline-file defaults; CLI `--var` flags land here.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "EventRouteReq": {
        "type": "object",
        "required": [
          "envelope"
        ],
        "properties": {
          "envelope": {
            "type": "object"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "JobEndRequest": {
        "type": "object",
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string"
          }
        }
      },
      "MeshBroadcastReq": {
        "type": "object",
        "required": [
          "from",
          "body"
        ],
        "properties": {
          "body": {},
          "capability_filter": {
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "type": "string"
          }
        }
      },
      "MeshRegisterReq": {
        "type": "object",
        "required": [
          "agent_id",
          "capabilities"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MeshResponse": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {},
          "ok": {
            "type": "boolean"
          }
        }
      },
      "MeshSendReq": {
        "type": "object",
        "required": [
          "from",
          "to",
          "body"
        ],
        "properties": {
          "body": {},
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "MeshStatusReq": {
        "type": "object",
        "required": [
          "agent_id",
          "status"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ProviderStatus": {
        "type": "object",
        "required": [
          "id",
          "available",
          "binary"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "binary": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SettingsUpdateReq": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {}
        }
      }
    },
    "securitySchemes": {
      "bearer_token": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Daemon bearer token — found in ~/.ship/daemon.token after `ship daemon start`."
      }
    }
  }
}
