        }
      }
    },
    "/api/runtime/workspaces": {
      "get": {
        "tags": [
          "runtime"
        ],
        "summary": "GET /api/runtime/workspaces",
        "description": "Returns only active workspaces. Archived/dead workspaces are excluded\nfrom the API surface — the reconciler handles cleanup internally.",
        "operationId": "list_workspaces",
        "responses": {
          "200": {
            "description": "",
