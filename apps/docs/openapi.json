        ],
        "operationId": "get_setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "Setting key (e.g. defaults.provider)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
