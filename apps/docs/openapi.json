    "/api/mesh/events/{agent_id}": {
      "get": {
        "tags": [
          "mesh"
        ],
        "summary": "SSE endpoint — drains an agent's mailbox as server-sent events.\nThe agent must register first (which spawns the actor + stashes the mailbox).\nOnly one SSE connection per agent is supported (mailbox is taken, not cloned).",
        "operationId": "mesh_events",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "description": "Agent ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of mesh events"
          }
        }
      }
    },
    "/api/mesh/register": {
      "post": {
        "tags": [
