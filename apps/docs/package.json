{
  "name": "@ship/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "bun scripts/collect-skill-docs.ts",
    "collect:watch": "AUDIENCE=internal bun scripts/collect-skill-docs.ts --watch",
    "dev": "env AUDIENCE=internal sh -c 'bun scripts/collect-skill-docs.ts --watch & astro dev --host; kill 0'",
    "docs:check-drift": "bun scripts/check-skill-docs-drift.ts",
    "prebuild": "bun run collect",
    "build": "astro build",
    "preview": "astro preview",
    "visual": "playwright test --config tests/visual/playwright.config.ts",
    "visual:update": "playwright test --config tests/visual/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/syne": "^5.2.7",
    "@ship/tokens": "workspace:*",
    "astro": "^6.1.1",
    "sharp": "^0.33.0",
    "starlight-sidebar-topics": "^0.7.1"
  },
  "devDependencies": {
    "@astrojs/markdoc": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0"
  }
}
