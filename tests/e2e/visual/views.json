    {"tag": "sui-error-boundary", "slot": "<div style=\"display:flex;gap:24px;flex-direction:column;max-width:480px\"><sui-error-boundary id=\"eb-healthy\"><div style=\"padding:8px 12px;border:1px solid var(--border);border-radius:6px\">Healthy content inside the boundary.</div></sui-error-boundary><sui-error-boundary id=\"eb-caught\" fallback-text=\"Something went wrong\"><span>protected</span></sui-error-boundary><script>customElements.whenDefined('sui-error-boundary').then(() => requestAnimationFrame(() => { const sym = Symbol.for('sui:error-boundary'); const target = document.getElementById('eb-caught'); const handle = target && target[sym]; if (handle) handle.catch(new Error('Demo failure'), 'render'); window.__harnessReady = true; }));</script></div>"},
    {"tag": "sui-dialog", "slot": "<sui-dialog open><span slot=\"header\">Dialog title</span>This dialog shows in the open state — content fades in via <code>transition:fade</code> while the dialog uses native <code>showModal()</code> for top-layer rendering.<span slot=\"footer\"><sui-button variant=\"outline\">Cancel</sui-button> <sui-button variant=\"solid\" tone=\"primary\">Confirm</sui-button></span></sui-dialog><script>customElements.whenDefined('sui-dialog').then(() => requestAnimationFrame(() => requestAnimationFrame(() => { window.__harnessReady = true; })));</script>"},
    {"tag": "sui-popover", "slot": "<sui-popover open placement=\"bottom\"><sui-button slot=\"trigger\" variant=\"outline\">Trigger</sui-button><div style=\"padding:8px 4px;min-width:200px\">Popover panel — <code>transition:scale</code> drives the open animation. Native <code>popover=\"auto\"</code> provides top-layer + light dismiss.</div></sui-popover><script>customElements.whenDefined('sui-popover').then(() => requestAnimationFrame(() => requestAnimationFrame(() => { window.__harnessReady = true; })));</script>"},
