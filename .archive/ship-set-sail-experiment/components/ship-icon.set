<script>
// <ship-icon> — canonical inline SVG icon. Resolves `name` against the
// curated Lucide registry generated from `lucide-static` (ISC). Names
// not present in the curated allowlist fall through to the default
// slot — provide raw SVG there for one-off glyphs.
//
// Attributes:
//   name  — Lucide icon id, kebab-case (e.g. "chevron-right"). A small
//           alias map handles legacy names (`stop` → `stop-circle`,
//           `refresh` → `refresh-cw`, `git` → `git-branch`,
//           `warning` → `triangle-alert`).
//   size  — sm | md | lg (default md). 12 / 16 / 20px.
//   tone  — default | info | success | warning | destructive | accent
//           | muted | primary
//   label — when provided, the host gets role=img + aria-label;
//           otherwise aria-hidden is set.
//
// Slots:
//   (default) — raw SVG passthrough. Used as a fallback when `name`
//               is not in the registry.

prop name: string = ''
prop size: 'sm' | 'md' | 'lg' = 'md'
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' | 'primary' = 'default'
prop label: string = ''

// The registry is inlined here because the compiler doesn't yet emit
// module-level user `const` declarations (see .artifacts/set/gaps.md).
// Wrapped in a function so the literal lives in function scope; V8
// caches the object behind the closure.
function lookupIcon(n) {
  const ALIASES = {
    git: 'git-branch',
    refresh: 'refresh-cw',
    stop: 'stop-circle',
    warning: 'triangle-alert',
  }
  const ICONS = {
    "activity": "<path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\" />",
    "app-window": "<rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\" /> <path d=\"M10 4v4\" /> <path d=\"M2 8h20\" /> <path d=\"M6 4v4\" />",
    "network": "<rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\" /> <rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\" /> <rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\" /> <path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\" /> <path d=\"M12 12V8\" />",
    "alert-circle": "<circle cx=\"12\" cy=\"12\" r=\"10\" /> <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" /> <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />",
    "arrow-down": "<path d=\"M12 5v14\" /> <path d=\"m19 12-7 7-7-7\" />",
    "arrow-left": "<path d=\"m12 19-7-7 7-7\" /> <path d=\"M19 12H5\" />",
    "arrow-right": "<path d=\"M5 12h14\" /> <path d=\"m12 5 7 7-7 7\" />",
    "arrow-up": "<path d=\"m5 12 7-7 7 7\" /> <path d=\"M12 19V5\" />",
    "arrow-up-right": "<path d=\"M7 7h10v10\" /> <path d=\"M7 17 17 7\" />",
    "command": "<path d=\"M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3\" />",
    "bell": "<path d=\"M10.268 21a2 2 0 0 0 3.464 0\" /> <path d=\"M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326\" />",
    "book": "<path d=\"M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20\" />",
    "bot": "<path d=\"M12 8V4H8\" /> <rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\" /> <path d=\"M2 14h2\" /> <path d=\"M20 14h2\" /> <path d=\"M15 13v2\" /> <path d=\"M9 13v2\" />",
    "check": "<path d=\"M20 6 9 17l-5-5\" />",
    "check-circle": "<path d=\"M21.801 10A10 10 0 1 1 17 3.335\" /> <path d=\"m9 11 3 3L22 4\" />",
    "chevron-down": "<path d=\"m6 9 6 6 6-6\" />",
    "chevron-left": "<path d=\"m15 18-6-6 6-6\" />",
    "chevron-right": "<path d=\"m9 18 6-6-6-6\" />",
