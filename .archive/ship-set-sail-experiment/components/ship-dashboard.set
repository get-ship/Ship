<script>
// Workspace Dashboard. Server-truth via the sail data resolver:
// `ship.dashboard.state()` → `{ stats, recent_runs, events, agents,
// collections, total_events }`. The signal updates whenever the daemon
// emits a relevant event (runs, agent config, collection schemas, the
// event stream itself), so the page reflects the registry without a
// refresh.
//
// Behavior parity vs `.ship/views/dashboard/index.html.j2`:
//   - Header with ship-app-icon wordmark + live-pulse badge
//   - 4 stat tiles with per-tile accent stripes (jobs / agents / events / collections)
//   - Recent jobs list (active or, if none, history truncated to 5)
//   - Agents grid (first 6, brand-aware avatar via shared resolver inlined here)
//   - Latest events feed (3-col grid: ts / type / actor)
//   - Quick-links tile row (6 hardcoded routes — same catalog as the partial)
//   - Empty states for jobs / agents / events
//
// Out of scope (not provided by the data resolver, not present in the
// Jinja either): the `settings.workspace_name` line is rendered as
// the hardcoded "workspace dashboard" subtitle, matching the Jinja
// `{% else %}workspace dashboard{% endif %}` branch.

data dash = ship.dashboard.state()

derived stats = (dash() && dash().stats) ? dash().stats : { active: 0, history: 0 }
derived activeJobs = stats().active || 0
derived totalJobs = (stats().active || 0) + (stats().history || 0)
derived recentJobs = (dash() && dash().recent_runs) ? dash().recent_runs : []
derived events = (dash() && dash().events) ? dash().events : []
derived agentsList = (dash() && dash().agents) ? dash().agents : []
derived collections = (dash() && dash().collections) ? dash().collections : []
derived eventTotal = (dash() && dash().total_events) || 0
derived agentsCount = agentsList().length
derived collectionsCount = collections().length
derived hasJobs = recentJobs().length > 0
derived hasAgents = agentsCount() > 0
derived hasEvents = events().length > 0
derived agentsTop = agentsList().slice(0, 6)

// Derived helpers per row — keep templates declarative.
function runSlug(r)    { return r.slug != null ? r.slug : r.id }
function runAgent(r)   { return r.agent != null ? r.agent : '' }
function runTone(r)    { return r.tone != null ? r.tone : 'muted' }
function runTime(r)    { return r.started_at != null ? r.started_at : (r.created_at != null ? r.created_at : '') }
function firstUpper(s) { return s && s.length > 0 ? s.charAt(0).toUpperCase() : '' }

function agentName(a)  { return a.name != null ? a.name : a.id }
function agentLetter(a) {
  if (a.letter) return a.letter
  if (a.name && a.name.length > 0) return a.name.charAt(0)
  return 'A'
}
function agentDesc(a)      { return a.description != null ? a.description : '' }
function agentProviders(a) { return a.providers || [] }
function agentTags(a)      { return a.tags || [] }

// Brand-aware avatar resolution — mirrors `_shared/agent_avatar.html.j2`:
//   "simpleicons:<slug>" → ship-avatar with icon-slug
//   short string (≤3)    → literal initials avatar
//   longer string        → ship-icon registry name in a tile
//   empty/undefined      → first-letter initials avatar
function avatarKind(a) {
  const ico = (a.icon || '').toString()
  if (ico.startsWith('simpleicons:')) return 'simpleicons'
  if (ico && ico.length <= 3) return 'short'
  if (ico) return 'registry'
  return 'fallback'
}
function avatarSlug(a)    { return (a.icon || '').toString().slice(12) }
function avatarShort(a)   { return (a.icon || '').toString() }
function avatarRegistry(a){ return (a.icon || '').toString() }

// Quick-link catalog — duplicated from the shell rail (same as the
// Jinja partial). Single declaration, iterated below.
derived quickLinks = [
  { label: 'Workflows', href: '/api/v1/view/pipelines', icon: 'workflow', tint: 'workflows' },
  { label: 'Agents',    href: '/api/v1/v/agents',       icon: 'users',    tint: 'agents'    },
  { label: 'Skills',    href: '/api/v1/view/skills',    icon: 'book',     tint: 'skills'    },
  { label: 'Data',      href: '/api/v1/v/collections',  icon: 'database', tint: 'data'      },
  { label: 'Events',    href: '/api/v1/view/events',    icon: 'activity', tint: 'events'    },
  { label: 'Settings',  href: '/api/v1/view/settings',  icon: 'settings', tint: 'settings'  },
]

// Pluralization helpers — used in the stat hint copy.
derived activeLabel = `${activeJobs()} active`
derived agentsLabel = `${agentsCount()}`
derived collectionsLabel = `${collectionsCount()}`
</script>

<template>
<div class="dash-wrap">

  <header class="dash-header">
    <div class="dash-wordmark">
      <ship-app-icon class="dash-logo" name="dashboard" variant="solid" size="lg" radius="md" aria-hidden="true"></ship-app-icon>
      <div>
        <h1 class="dash-title">SHIP</h1>
        <p class="dash-workspace">workspace dashboard</p>
      </div>
    </div>
    <div class="dash-status-row">
      <div class="dash-live-badge" role="status" aria-label="Live updates active">
        <span class="dash-live-dot"></span>live
      </div>
    </div>
  </header>

  <div class="dash-stats" role="list" aria-label="Workspace statistics">
    <div class="dash-stat-wrap dash-stat-wrap--jobs" role="listitem">
      <ship-stat>
        <span slot="label">Total jobs</span>
        {totalJobs()}
        <span slot="hint">{activeLabel()}</span>
      </ship-stat>
    </div>
    <div class="dash-stat-wrap dash-stat-wrap--agents" role="listitem">
      <ship-stat>
        <span slot="label">Agents</span>
        {agentsLabel()}
        <span slot="hint">configured</span>
      </ship-stat>
    </div>
    <div class="dash-stat-wrap dash-stat-wrap--events" role="listitem">
      <ship-stat>
        <span slot="label">Events</span>
        {eventTotal()}
        <span slot="hint">in stream</span>
      </ship-stat>
    </div>
    <div class="dash-stat-wrap dash-stat-wrap--collections" role="listitem">
      <ship-stat>
        <span slot="label">Collections</span>
        {collectionsLabel()}
        <span slot="hint">schemas defined</span>
      </ship-stat>
    </div>
  </div>

  <div class="dash-body">

    <ship-card padding="none" class="dash-section" aria-label="Recent jobs">
      <div slot="header" class="dash-section-head">
        <h2 class="dash-section-title">
          <ship-icon class="dash-section-icon" name="workflow" aria-hidden="true"></ship-icon>
          Recent jobs
        </h2>
        <a class="dash-section-link" href="/api/v1/view/pipelines">
          View all <ship-icon name="chevron-right" size="sm" aria-hidden="true"></ship-icon>
        </a>
      </div>
      <div class="dash-jobs-list">
        {#if hasJobs}
          {#for run of recentJobs()}
            <ship-list-tile density="compact" class="dash-job-tile">
              <ship-status-dot slot="leading" tone={runTone(run)}></ship-status-dot>
              <span class="dash-job-name">{runSlug(run)}</span>
              <span slot="trailing" class="dash-job-trailing">
                {#if runAgent(run)}
                  <ship-avatar size="sm" identity-hue={runAgent(run)} name={runAgent(run)} initials={firstUpper(runAgent(run))}></ship-avatar>
                  <span class="dash-job-agent">{runAgent(run)}</span>
                {:else}
                  <span class="dash-job-agent">—</span>
                {/if}
                {#if runTime(run)}
                  <ship-timestamp value={runTime(run)} class="dash-job-time"></ship-timestamp>
                {:else}
                  <span class="dash-job-time">—</span>
                {/if}
              </span>
            </ship-list-tile>
          {/for}
        {:else}
          <ship-empty-state variant="placeholder" size="sm" icon="play">
            <span slot="title">No jobs yet</span>
            Start a workflow to see runs here.
          </ship-empty-state>
        {/if}
      </div>
    </ship-card>

    <ship-card padding="none" class="dash-section" aria-label="Agents">
      <div slot="header" class="dash-section-head">
        <h2 class="dash-section-title">
          <ship-icon class="dash-section-icon" name="users" aria-hidden="true"></ship-icon>
          Agents
          <ship-badge tone="muted" variant="soft" size="sm">{agentsCount()}</ship-badge>
        </h2>
        <a class="dash-section-link" href="/api/v1/v/agents">
          Manage <ship-icon name="chevron-right" size="sm" aria-hidden="true"></ship-icon>
        </a>
      </div>
      <div class="dash-section-body">
        {#if hasAgents}
          <div class="dash-agents-grid">
            {#for agent of agentsTop()}
              <a class="dash-agent-link" href={`/agents/${agent.id}`}>
              <ship-list-tile variant="card" density="compact" interactive class="dash-agent-tile">
                {#if avatarKind(agent) === 'simpleicons'}
                  <ship-avatar slot="leading" size="md" shape="square" identity-hue={agent.id} icon-slug={avatarSlug(agent)} name={agentName(agent)}></ship-avatar>
                {:else if avatarKind(agent) === 'short'}
                  <ship-avatar slot="leading" size="md" shape="square" identity-hue={agent.id} initials={avatarShort(agent)} name={agentName(agent)}></ship-avatar>
                {:else if avatarKind(agent) === 'registry'}
                  <span slot="leading" class="agents-card-icon-tile" aria-label={agentName(agent)}>
                    <ship-icon name={avatarRegistry(agent)} size="md"></ship-icon>
                  </span>
                {:else}
                  <ship-avatar slot="leading" size="md" shape="square" identity-hue={agent.id} initials={agentLetter(agent)} name={agentName(agent)}></ship-avatar>
                {/if}
                <div class="dash-agent-body">
                  <div class="dash-agent-head">
                    <span class="dash-agent-name">{agentName(agent)}</span>
                    {#if agentDesc(agent)}
                      <p class="dash-agent-desc">{agentDesc(agent)}</p>
                    {/if}
                  </div>
                  <div class="dash-agent-foot">
                    {#if agentProviders(agent).length > 0}
                      <span class="dash-agent-providers" aria-label="Compiles to">
                        {#for p of agentProviders(agent)}
                          <ship-provider-blob provider={p} size="sm" variant="glyph" title={p}></ship-provider-blob>
                        {/for}
                      </span>
                    {/if}
                    {#for t of agentTags(agent).slice(0, 2)}
                      <ship-chip tone="muted" variant="soft" size="sm">{t}</ship-chip>
                    {/for}
                    {#if agentTags(agent).length > 2}
                      <ship-chip tone="muted" variant="outline" size="sm">+{agentTags(agent).length - 2}</ship-chip>
                    {/if}
                  </div>
                </div>
              </ship-list-tile>
              </a>
            {/for}
          </div>
        {:else}
          <ship-empty-state variant="placeholder" size="sm" icon="user-plus">
            <span slot="title">No agents configured</span>
            Add an agent to dispatch work.
          </ship-empty-state>
        {/if}
      </div>
    </ship-card>

    <ship-card padding="none" class="dash-section dash-body--wide" aria-label="Latest events">
      <div slot="header" class="dash-section-head">
        <h2 class="dash-section-title">
          <ship-icon class="dash-section-icon" name="activity" aria-hidden="true"></ship-icon>
          Latest events
        </h2>
        <a class="dash-section-link" href="/api/v1/view/events">
          Full stream <ship-icon name="chevron-right" size="sm" aria-hidden="true"></ship-icon>
        </a>
      </div>
      <div class="dash-section-body">
        {#if hasEvents}
          {#for r of events()}
            <div class="dash-event-row">
              <span class="dash-event-ts">{r.timestamp}</span>
              <span class="dash-event-type">{r.event_type}</span>
              <span class="dash-event-actor">
                {#if r.actor}
                  <ship-avatar size="sm" identity-hue={r.actor} name={r.actor} initials={firstUpper(r.actor)}></ship-avatar>
                  <span>{r.actor}</span>
                {:else}
                  <span>—</span>
                {/if}
              </span>
            </div>
          {/for}
        {:else}
          <ship-empty-state variant="placeholder" size="sm" icon="activity">
            <span slot="title">Waiting for events</span>
            The stream will fill as the daemon emits events.
          </ship-empty-state>
        {/if}
      </div>
    </ship-card>

    <ship-card padding="none" class="dash-section dash-body--wide" aria-label="Quick links">
      <div slot="header" class="dash-section-head">
        <h2 class="dash-section-title">
          <ship-icon class="dash-section-icon" name="external-link" aria-hidden="true"></ship-icon>
          Quick links
        </h2>
      </div>
      <div class="dash-links">
        {#for link of quickLinks()}
          <a class="dash-link-btn" href={link.href}>
            <div class={`dash-link-icon dash-link-icon--${link.tint}`} aria-hidden="true">
              <ship-icon name={link.icon} size="md"></ship-icon>
            </div>{link.label}
          </a>
        {/for}
      </div>
    </ship-card>

  </div>
</div>
</template>

<style src="./ship-dashboard.css"></style>
