<script>
// <ship-metachip>
//
// Compact label + value pair for metadata rows. Renders two inline
// segments separated by a hairline divider. Designed to sit in a row
// of sibling metachips: wrap them in `display:flex; gap:0` and each
// chip contributes its own right border.
//
// Attributes:
//   label  — key text
//   value  — value text
// Slots:
//   label  — overrides `label` attr (lets you embed code/icon)
//   default — value content; overrides `value` attr

prop label: string = ''
prop value: string = ''
</script>

<template>
<span class="k" part="label"><slot name="label">{label()}</slot></span>
<span class="v" part="value"><slot>{value()}</slot></span>
</template>

<style>
:host {
  display: inline-flex;
  align-items: baseline;
  gap: 8px;
  padding: 4px 14px;
  border-right: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
  font-size: var(--text-xs);
  line-height: var(--leading-tight);
}
:host(:last-of-type) { border-right: 0; padding-right: 0; }
:host(:first-of-type) { padding-left: 0; }
.k {
  font-size: 10px;
  font-weight: var(--font-weight-semibold);
  color: var(--muted-foreground);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.v {
  font-family: var(--font-mono);
  color: var(--foreground);
  font-size: var(--text-xs);
}
</style>
