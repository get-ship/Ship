<script>
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'success'
prop pulse: boolean = false
prop size: 'sm' | 'md' = 'md'
prop label: string = ''

derived hasLabel = label().length > 0
</script>

<template>
{#if hasLabel}
  <span class="dot" part="dot" role="img" aria-label={label}></span>
{:else}
  <span class="dot" part="dot" aria-hidden="true"></span>
{/if}
</template>

<style>
:host { display: inline-flex; vertical-align: middle; --tone-fg: var(--success); }
:host([tone='default']) { --tone-fg: var(--foreground); }
:host([tone='info']) { --tone-fg: var(--info); }
:host(:not([tone])), :host([tone='success']) { --tone-fg: var(--success); }
:host([tone='warning']) { --tone-fg: var(--warning); }
:host([tone='destructive']) { --tone-fg: var(--destructive); }
:host([tone='accent']) { --tone-fg: var(--accent); }
:host([tone='muted']) { --tone-fg: var(--muted-foreground); }

.dot {
  display: inline-block;
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--tone-fg);
  box-shadow: 0 0 0 4px color-mix(in oklch, var(--tone-fg) 20%, transparent);
}
:host([size='sm']) .dot {
  width: 6px; height: 6px;
  box-shadow: 0 0 0 3px color-mix(in oklch, var(--tone-fg) 20%, transparent);
}
:host([pulse]) .dot { animation: pulse 2.5s infinite; }
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.75; transform: scale(0.9); }
}
@media (prefers-reduced-motion: reduce) {
  .dot { animation: none; }
}
</style>
