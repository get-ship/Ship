<script>
prop src: string = ''
prop name: string = ''
prop initials: string = ''
prop size: 'sm' | 'md' | 'lg' | 'xl' = 'md'
prop shape: 'round' | 'square' = 'round'
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' | 'primary' = 'muted'
prop iconSlug: string = ''
prop identityHue: string = ''

state errored = false

function resolvedSrc() {
  if (src()) return src()
  const slug = (iconSlug() || '').trim()
  if (slug) return `https://cdn.simpleicons.org/${slug}`
  return ''
}

function initialsFromName(n) {
  const parts = n.trim().split(/\s+/).filter(Boolean)
  if (parts.length === 0) return ''
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase()
  return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase()
}

function resolvedInitials() {
  const explicit = (initials() || '').trim()
  if (explicit) return explicit.toUpperCase()
  return initialsFromName(name())
}

function hashToHueAngle(input) {
  let h = 2166136261
  for (let i = 0; i < input.length; i++) {
    h ^= input.charCodeAt(i)
    h = Math.imul(h, 16777619)
  }
  return Math.abs(h) % 360
}

derived showImage = !!resolvedSrc() && !errored()
derived initialsValue = resolvedInitials()
derived ariaLabel = name() || initialsValue() || 'avatar'

function onError() {
  errored.set(true)
}

derived dataInitials = !showImage()

function syncIdentityHue() {
  const canSeedHue = !showImage()
    && (!tone() || tone() === 'default' || tone() === 'muted')
  if (canSeedHue && identityHue()) {
    const h = hashToHueAngle(identityHue())
    el.style.background = `conic-gradient(from 220deg, oklch(0.72 0.16 ${h}), oklch(0.60 0.20 ${(h + 40) % 360}))`
    el.style.color = 'var(--primary-foreground, #fff)'
  } else {
    el.style.background = ''
    el.style.color = ''
  }
}

mount {
  syncIdentityHue()
}

effect {
  syncIdentityHue()
  // Reset error state on src/iconSlug change so the image gets a fresh
  // chance to load.
}
effect {
  errored.set(false)
  src(); iconSlug()  // explicit reads to track these deps
}
</script>

<template>
<:host data-initials={dataInitials} />
<span class="wrap" role="img" aria-label={ariaLabel} part="wrap">
  {#if showImage}
    <img src={resolvedSrc()} alt={name} onerror={onError} />
  {:else}
    <span class="initials" part="initials">{initialsValue()}</span>
  {/if}
</span>
</template>

<style>
:host {
  display: inline-flex;
  width: 32px; height: 32px;
  border-radius: var(--radius-full);
  background: var(--tone-bg);
  color: var(--tone-fg);
  font-family: var(--font-body);
  font-weight: var(--font-weight-semibold);
  font-size: var(--text-sm);
  overflow: hidden;
  user-select: none;
  --tone-bg: var(--muted);
  --tone-fg: var(--muted-foreground);
}
:host([size='sm']) { width: 28px; height: 28px; font-size: var(--text-xs); }
:host([size='lg']) { width: 40px; height: 40px; font-size: var(--text-md); }
:host([size='xl']) { width: 56px; height: 56px; font-size: var(--text-lg); }

:host([shape='square']) { border-radius: var(--radius-sm); }

:host([tone='info']) { --tone-bg: color-mix(in oklch, var(--info) 10%, var(--muted)); --tone-fg: var(--info); }
:host([tone='success']) { --tone-bg: color-mix(in oklch, var(--success) 10%, var(--muted)); --tone-fg: var(--success); }
:host([tone='warning']) { --tone-bg: color-mix(in oklch, var(--warning) 10%, var(--muted)); --tone-fg: var(--warning); }
:host([tone='destructive']) { --tone-bg: color-mix(in oklch, var(--destructive) 10%, var(--muted)); --tone-fg: var(--destructive); }
:host([tone='accent']) { --tone-bg: var(--accent); --tone-fg: var(--accent-foreground); }
:host([tone='primary']) { --tone-bg: var(--primary); --tone-fg: var(--primary-foreground); }

:host([data-initials]) {
  background: linear-gradient(135deg,
    color-mix(in oklch, var(--primary) 70%, transparent),
    color-mix(in oklch, var(--accent) 70%, transparent));
  color: var(--foreground);
}
:host([data-initials][tone='primary']) {
  background: var(--primary);
  color: var(--primary-foreground);
}
:host([data-initials][tone='accent']) {
  background: var(--accent);
  color: var(--accent-foreground);
}
:host([data-initials][tone='info']),
:host([data-initials][tone='success']),
:host([data-initials][tone='warning']),
:host([data-initials][tone='destructive']) {
  background: var(--tone-bg);
  color: var(--tone-fg);
}

.wrap {
  width: 100%; height: 100%;
  display: inline-flex; align-items: center; justify-content: center;
}
.initials {
  text-transform: uppercase;
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.02em;
  line-height: 1;
}
img {
  width: 100%; height: 100%;
  object-fit: contain;
  padding: 4%;
  box-sizing: border-box;
}
</style>
