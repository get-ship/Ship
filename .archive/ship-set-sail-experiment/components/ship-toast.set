<script>
// <ship-toast> — transient notification card. Parity port of
// packages/ship-set/src/web-components/core/ship-toast.ts.
//
// Tone channel + auto-icon (info/success/warning/destructive/accent),
// size channel, entrance animation, hover-to-pause auto-dismiss,
// optional progress bar, async exit animation via .close(). Slot
// auto-collapse (data-no-title, data-no-actions, data-no-icon) is
// evaluated at mount via slotFilled. The shipped Lit component has a
// dynamic slotchange listener that re-evaluates on reparenting; that's
// the one drift documented below — Sail's slot model is static-at-mount.

prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop duration: number = 5000
prop dismissible: boolean = true
prop showProgress: boolean = false

state hasSlottedIcon = false
state mountReady = false
state removed = false

derived assertive = tone() === 'destructive' || tone() === 'warning'
derived liveRole = assertive() ? 'alert' : 'status'
derived ariaLive = assertive() ? 'assertive' : 'polite'
derived hasAutoIcon = tone() !== 'default' && tone() !== 'muted'
derived showProgressBar = showProgress() && duration() > 0

function iconPaths(t) {
  // Lucide-style 24×24 strokes at 2px. Inlined so toasts render
  // correctly in environments without an icon font.
  if (t === 'info') return '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01"/><path d="M11 12h1v4h1"/>'
  if (t === 'success') return '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>'
  if (t === 'warning') return '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/>'
  if (t === 'destructive') return '<circle cx="12" cy="12" r="9"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/>'
  if (t === 'accent') return '<path d="M12 2 3 14h7l-1 8 10-12h-7l1-8Z"/>'
  return ''
}

derived iconSvg = iconPaths(tone())

function clearTimer() {
  if (el.__shipToastTimer) {
    clearTimeout(el.__shipToastTimer)
    el.__shipToastTimer = null
  }
}

// Single setTimeout site for the dismiss countdown — keeps lifecycle
// pairing 1:1 between setTimeout/clearTimeout calls. Both
// scheduleDismiss() and onResume() route through here.
function armTimer(ms) {
  clearTimer()
  el.__shipToastTimer = setTimeout(() => doDismiss('timeout'), ms)
}

function scheduleDismiss() {
  if (duration() > 0) {
    el.__shipToastRemaining = duration()
    el.__shipToastStartedAt = Date.now()
    armTimer(duration())
    el.style.setProperty('--toast-duration', `${duration()}ms`)
  } else {
    clearTimer()
  }
}

function doDismiss(reason) {
  if (removed()) return
  removed.set(true)
  clearTimer()
  el.dispatchEvent(new CustomEvent('ship-dismiss', {
    detail: { reason: reason || 'manual' },
    bubbles: true,
    composed: true,
  }))
  el.remove()
}

function doClose(reason) {
  if (removed()) return Promise.resolve()
  const r = reason || 'manual'
  const prefersReduce = typeof window !== 'undefined' &&
    window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (prefersReduce) {
    doDismiss(r)
    return Promise.resolve()
  }
  clearTimer()
  el.toggleAttribute('data-closing', true)
  return new Promise((resolve) => {
    let done = false
    let safety = null
    const finish = () => {
      if (done) return
      done = true
      if (safety) {
        clearTimeout(safety)
        safety = null
      }
      el.removeEventListener('animationend', onEnd)
      doDismiss(r)
      resolve()
    }
    const onEnd = () => finish()
    el.addEventListener('animationend', onEnd)
    // Safety net — animationend may not fire (display:none, jsdom).
    // Matches --duration-medium (~240ms) plus a frame.
    safety = setTimeout(finish, 260)
  })
}

function onPause() {
  if (!el.__shipToastTimer) return
  const elapsed = Date.now() - (el.__shipToastStartedAt || 0)
  el.__shipToastRemaining = Math.max(0, (el.__shipToastRemaining || 0) - elapsed)
  clearTimer()
  el.toggleAttribute('data-paused', true)
}

function onResume() {
  if (removed() || duration() <= 0) return
  if ((el.__shipToastRemaining || 0) <= 0) return
  el.toggleAttribute('data-paused', false)
  el.__shipToastStartedAt = Date.now()
  armTimer(el.__shipToastRemaining)
}

function onKeydown(e) {
  if (e.key === 'Escape' && dismissible()) {
    e.stopPropagation()
    doDismiss('manual')
  }
}

function onCloseClick() { doDismiss('manual') }

mount {
  if (!el.hasAttribute('tabindex')) el.tabIndex = 0
  hasSlottedIcon.set(slotFilled(el, 'icon'))
  if (!slotFilled(el, 'title')) el.toggleAttribute('data-no-title', true)
  if (!slotFilled(el, 'actions')) el.toggleAttribute('data-no-actions', true)
  // Imperative API parity with the Lit class.
  el.dismiss = doDismiss
  el.close = doClose
  scheduleDismiss()
  el.addEventListener('mouseenter', onPause)
  el.addEventListener('mouseleave', onResume)
  el.addEventListener('focusin', onPause)
  el.addEventListener('focusout', onResume)
  el.addEventListener('keydown', onKeydown)
  cleanups.push(() => clearTimer())
  cleanups.push(() => el.removeEventListener('mouseenter', onPause))
  cleanups.push(() => el.removeEventListener('mouseleave', onResume))
  cleanups.push(() => el.removeEventListener('focusin', onPause))
  cleanups.push(() => el.removeEventListener('focusout', onResume))
  cleanups.push(() => el.removeEventListener('keydown', onKeydown))
  mountReady.set(true)
}

effect {
  if (!mountReady()) return
  el.toggleAttribute('data-no-icon', !hasAutoIcon() && !hasSlottedIcon())
}
</script>

<template>
<div class="toast" role={liveRole} aria-live={ariaLive} aria-atomic="true" part="toast">
  <span class="icon">
    <slot name="icon"></slot>
    {#if iconSvg}
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >{@html iconSvg()}</svg>
    {/if}
  </span>
  <div class="content">
    <div class="title"><slot name="title"></slot></div>
    <div class="body"><slot></slot></div>
    <div class="actions"><slot name="actions"></slot></div>
  </div>
  {#if dismissible}
    <button
      class="close"
      part="close"
      type="button"
      aria-label="Dismiss notification"
      on:click={onCloseClick}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  {/if}
  {#if showProgressBar}
    <span class="progress" aria-hidden="true"></span>
  {/if}
</div>
</template>

<style src="./ship-toast.css"></style>
