<script>
// <ship-tooltip> — CSS-only tooltip positioned via absolute offsets.
// Wraps its trigger as light-DOM children; the `content` slot
// provides the bubble body. Shows on hover and on keyboard focus —
// the visibility transition lives entirely in CSS via :host(:hover)
// and :host(:focus-within), so this component carries no event
// state, no positioning JS, and no portal escape from the host.
//
// Attributes:
//   placement — top | bottom | left | right (default top).
//   delay     — number, ms show delay (default 100). Currently a
//               passthrough — see comments below.
//
// Slots:
//   (default) — trigger content.
//   content   — tooltip body.

prop placement: 'top' | 'bottom' | 'left' | 'right' = 'top'
prop delay: number = 100

state bubbleId = ''

function onKeydown(e) {
  if (e.key === 'Escape' && typeof el.blur === 'function') el.blur()
}

function wireTrigger() {
  // ARIA: link the first slotted trigger to the bubble via
  // aria-describedby so screen readers announce the tooltip body
  // when focus lands on the trigger. Multiple triggers in the slot
  // get the same id appended; existing aria-describedby tokens are
  // preserved.
  const id = bubbleId()
  if (!id) return
  const triggers = el.querySelectorAll(':scope > :not(.bubble):not([slot="content"])')
  // The first non-bubble, non-content child is the canonical trigger.
  let first = null
  for (const t of triggers) { first = t; break }
  if (!first) return
  const existing = first.getAttribute('aria-describedby') || ''
  const has = existing.split(/\s+/).filter(Boolean).includes(id)
  if (!has) {
    first.setAttribute('aria-describedby', existing ? `${existing} ${id}` : id)
  }
}

mount {
  bubbleId.set(`ship-tooltip-${Math.random().toString(36).slice(2, 9)}`)
  wireTrigger()
  el.addEventListener('keydown', onKeydown)
  cleanups.push(() => el.removeEventListener('keydown', onKeydown))
}
</script>

<template>
<slot></slot>
<span id={bubbleId} class="bubble" role="tooltip"><slot name="content"></slot></span>
</template>

<style>
:host { position: relative; display: inline-flex; }
.bubble {
  position: absolute;
  z-index: var(--z-popover);
  padding: 4px 8px;
  background: var(--foreground);
  color: var(--background);
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-sm);
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transition: opacity var(--duration-fast) var(--ease-out) var(--tooltip-hide-delay);
  box-shadow: var(--shadow-sm);
}
:host(:hover) .bubble,
:host(:focus-within) .bubble {
  opacity: 1;
  transition-delay: var(--tooltip-show-delay);
}
:host([placement='top']) .bubble,
:host(:not([placement])) .bubble {
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
}
:host([placement='bottom']) .bubble {
  top: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
}
:host([placement='left']) .bubble {
  right: calc(100% + 6px);
  top: 50%;
  transform: translateY(-50%);
}
:host([placement='right']) .bubble {
  left: calc(100% + 6px);
  top: 50%;
  transform: translateY(-50%);
}
</style>
