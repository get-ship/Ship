<script>
prop value: string = ''
prop disabled: boolean = false
prop checked: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'

derived radioTabindex = checked() ? '0' : '-1'

function onClick(e) {
  if (disabled()) return
  el.dispatchEvent(new CustomEvent('ship-radio-select', {
    detail: { value: value() },
    bubbles: true,
    composed: true,
  }))
}

function onKeydown(e) {
  if (disabled()) return
  const nav = ['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft']
  if (!nav.includes(e.key)) return
  e.preventDefault()
  const forward = e.key === 'ArrowDown' || e.key === 'ArrowRight'
  el.dispatchEvent(new CustomEvent('ship-radio-nav', {
    detail: { direction: forward ? 'next' : 'prev' },
    bubbles: true,
    composed: true,
  }))
}
</script>

<template>
<label part="label">
  <span class="circle" part="circle">
    <input
      part="input"
      type="radio"
      role="radio"
      disabled={disabled}
      aria-checked={checked() ? 'true' : 'false'}
      aria-label={value}
      tabindex={radioTabindex}
      onclick={onClick}
      onkeydown={onKeydown}
    />
    <span class="dot" part="dot" aria-hidden="true"></span>
  </span>
  <slot></slot>
</label>
</template>

<style>
:host {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  vertical-align: middle;
  font-family: var(--font-body);
  font-size: var(--text-base);
  color: var(--foreground);
  -webkit-tap-highlight-color: transparent;
  --tone: var(--primary);
}
:host([hidden]) { display: none; }

:host(:not([tone])), :host([tone='default']) { --tone: var(--primary); }
:host([tone='info'])        { --tone: var(--info); }
:host([tone='success'])     { --tone: var(--success); }
:host([tone='warning'])     { --tone: var(--warning); }
:host([tone='destructive']) { --tone: var(--destructive); }
:host([tone='accent'])      { --tone: var(--accent); }
:host([tone='muted'])       { --tone: var(--muted-foreground); }

:host(:not([size])), :host([size='md']) {
  --rd-size: 16px;
  --rd-dot: 8px;
}
:host([size='sm']) {
  --rd-size: 14px;
  --rd-dot: 6px;
}
:host([size='lg']) {
  --rd-size: 20px;
  --rd-dot: 10px;
}

label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}
:host([disabled]) label { cursor: not-allowed; }

.circle {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--rd-size);
  height: var(--rd-size);
  background: var(--background);
  border: 1px solid color-mix(in oklch, var(--border) 160%, transparent);
  border-radius: 50%;
  box-sizing: border-box;
  transition:
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

:host(:not([disabled]):not([checked])) label:hover .circle {
  border-color: color-mix(in oklch, var(--border) 220%, transparent);
}

:host([checked]) .circle {
  border-color: var(--tone);
}

.dot {
  width: var(--rd-dot);
  height: var(--rd-dot);
  border-radius: 50%;
  background: var(--tone);
  opacity: 0;
  transform: scale(0);
  transition:
    opacity var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}
:host([checked]) .dot {
  opacity: 1;
  transform: scale(1);
}

input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
  cursor: inherit;
  appearance: none;
  -webkit-appearance: none;
}

:host(:not([disabled])) label:has(input:focus-visible) .circle {
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--tone) var(--ring-opacity), transparent);
}

@media (forced-colors: active) {
  .circle { border-color: CanvasText; }
  :host([checked]) .dot { background: Highlight; }
  :host(:not([disabled])) label:has(input:focus-visible) .circle {
    outline: 2px solid CanvasText;
    outline-offset: 2px;
  }
}

:host([disabled]) {
  color: var(--muted-foreground);
}
:host([disabled]) .circle {
  background: var(--muted);
  border-color: color-mix(in oklch, var(--border) 70%, transparent);
  filter: saturate(0.6);
}
:host([disabled][checked]) .circle {
  border-color: color-mix(in oklch, var(--tone) 50%, var(--border));
}
:host([disabled][checked]) .dot {
  background: color-mix(in oklch, var(--tone) 55%, var(--muted));
}

@media (prefers-reduced-motion: reduce) {
  .circle, .dot { transition: none; }
}

::slotted(*) {
  font: inherit;
  color: inherit;
  line-height: var(--leading-tight);
}
</style>
