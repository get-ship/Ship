{
  // deck.jsonc — Ship workspace consumer bundle manifest.
  //
  // This is the single source of truth for Deck's consumer bundles.
  // Framework singletons (sui-runtime, sui-dom, sui-sdk-client, sui-components)
  // are NOT declared here — they are hardcoded inside deck-bundler and always
  // built. Only CONSUMER bundles go here.
  //
  // Read at build-time (cargo xtask build-assets) and daemon-startup
  // (shipd calls DeckConfig::load). Never read per-request.
  "targets": [
    {
      // Marketing site component pack — subset of sui-* tags used on the
      // landing page. Entry traces the import graph; add/remove tags there.
      "name": "sui-marketing",
      "kind": "component-pack",
      "entry": "apps/site/src/marketing/marketing-bundle.ts",
      "externals": ["@ship/sui-runtime", "@ship/sui-dom"]
    },
    {
      // Arcade lazy pack — heavy chunk (~800 KB) for the marketing site's
      // <sui-stage> games. Pixi + arcade-engine are bundled; only the runtime
      // singletons stay external.
      "name": "sui-arcade",
      "kind": "lazy-pack",
      "entry": "packages/components/ship/arcade/src/index.ts",
      "externals": ["@ship/sui-runtime", "@ship/sui-dom"]
    },
    {
      // PDF lazy pack — wraps pdfjs-dist + worker. Renders offline/same-origin.
      "name": "sui-pdf",
      "kind": "lazy-pack",
      "entry": "packages/components/ship/pdf/src/index.ts",
      "externals": ["@ship/sui-runtime", "@ship/sui-dom"]
    },
    {
      // Code-editor lazy pack — CodeMirror 6 (<ship-code-editor> + the
      // @ship/code tags). Side-loaded by the SUI tutorial on first use;
      // not in the lean marketing bundle.
      "name": "ship-code-editor",
      "kind": "lazy-pack",
      "entry": "packages/components/ship/code/src/index.ts",
      "externals": ["@ship/sui-runtime", "@ship/sui-dom"]
    }
  ],
  "scaffolds": [
    {
      "name": "shell",
      "route": "/",
      "source": "hub-scaffold",
      "assetPrefix": "/shell/_assets/"
    },
    {
      "name": "space",
      "route": "/space/{id}",
      "source": "space-scaffold",
      "assetPrefix": "/space/_assets/",
      "injectGlobals": { "DECK_APP_ID": "$id" }
    }
  ],
  "sourceRoots": ["."],
  "watch": ["packages", "apps/shell/src"],
  "hostAssetsRoot": ".deck",
  "firstPartyApp": { "root": "apps/shell/routes", "label": "app:shell" },
  // Root-relative public assets (favicons, logos) served by deck at /{file}
  // from <project_root>/apps/shell/public/<file>.
  "publicDir": "apps/shell/public",
  // Repo-root-relative search order for resolving `@ship/<name>` component
  // imports to their package source (`<root>/<name>`). First existing wins.
  // Ship's component reorg (#219) nests first-party packs under
  // packages/components/{sui,ship}; deck bakes no layout — this list is the
  // single source of that search order.
  "componentSourceRoots": [
    "packages",
    "packages/sui",
    "packages/deck",
    "packages/components",
    "packages/components/sui",
    "packages/components/ship"
  ]
}
