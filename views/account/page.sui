<div class="ship-view" data-test="account-view">
  <header class="view-head">
    <sui-cluster gap="2" align="center">
      <sui-icon name="user" aria-hidden="true"></sui-icon>
      <h1>Account</h1>
      <sui-badge tone="muted" variant="outline" size="sm">scaffold</sui-badge>
    </sui-cluster>
  </header>

  <sui-empty-state icon="user" variant="default">
    <span slot="title">Identity & subscription</span>
    Owner-level — your identity, plan, and billing, reachable from any space.
    Not built yet — this is the placeholder so the surface exists and is reachable.
  </sui-empty-state>
</div>
