<div class="ship-view ship-view-skills">
  <h1 class="sr-only">Skill</h1>
  <div class="skills-ide">

    <aside class="skills-explorer" aria-label="Skills file explorer">
      <div class="se-head">
        <div class="se-search">
          <sui-icon name="search" size="sm" tone="muted"></sui-icon>
          <input type="text" placeholder="Search skills…" spellcheck="false"
            aria-label="Search skills"
            bind:value={q}
            on:input={(e) => q.set(e.target.value)} />
        </div>
        {#if rail().kind === 'ok' && rail().value}
          <div class="se-filters" role="group" aria-label="Filter by kind">
            {#for kc of (rail().value.kind_counts || []) key={kc.id}}
              <button class="se-pill" class:is-active={kind() === kc.id}
                on:click={() => kind.set(kc.id)}>
                {kc.label} <span style="opacity:0.6;font-variant-numeric:tabular-nums">{kc.count}</span>
              </button>
            {/for}
          </div>
        {/if}
      </div>

      <div class="se-body" role="tree" aria-label="Skills tree">
        {#while-loading of rail}
          <div class="se-skel" role="status" aria-live="polite" aria-busy="true" aria-label="Loading skills">
            {#for n of [0, 1, 2, 3, 4, 5] key={n}}
              <div class="se-skel-row">
                <sui-skeleton shape="line" size="md"></sui-skeleton>
              </div>
            {/for}
          </div>
        {/while-loading}
        {#while-error err of rail}
          <sui-error-state variant="inline" size="sm" title="Couldn't load skills" role="alert" aria-live="assertive">
            {err.message}
          </sui-error-state>
        {/while-error}
        {#if rail().kind === 'ok' && rail().value}
          {#if (rail().value.groups || []).length === 0}
            <div class="se-empty">{q() ? 'No skills match "' + q() + '".' : 'No skills discovered.'}</div>
          {:else}
            {#for g of (rail().value.groups || []) key={g.source}}
              <div class="se-section">
                <div class="se-section-head">
                  <span class="se-section-label">
                    <sui-icon name="folder" size="xs" tone="muted"></sui-icon>
                    {g.source === 'PROJECT SKILLS' ? 'Project Skills' : g.source === 'USER SKILLS' ? 'Library' : g.source}
                    <span class="count">({g.skills.length})</span>
                  </span>
                </div>
                {#for s of g.skills key={s.id}}
                  <div role="treeitem"
                    attr:aria-selected={s.id === skillId() ? 'true' : 'false'}>
                    <a class="se-skill" class:is-active={s.id === skillId()}
                      attr:href={'/skills/' + s.id}
                      attr:title={s.description}>
                      <span class="se-chevron" aria-hidden="true">
                        {#if s.id === skillId()}
                          <sui-icon name="chevron-down" size="xs"></sui-icon>
                        {:else}
                          <sui-icon name="chevron-right" size="xs"></sui-icon>
                        {/if}
                      </span>
                      <sui-icon name="zap" size="xs" tone="primary"></sui-icon>
                      <span class="se-name">{s.name}</span>
                      <span class="se-dots">
                        {#if s.has_vars}<span class="se-dot vars" title="Variables"></span>{/if}
                        {#if s.has_refs}<span class="se-dot refs" title="Reference docs"></span>{/if}
                        {#if s.has_evals}<span class="se-dot evals" title="Evals"></span>{/if}
                      </span>
                    </a>
                    {#if s.id === skillId() && s.files && s.files.length > 0}
                      {#for f of s.files key={f}}
                        <a class="se-file" class:is-active={selectedFile() === f}
                          role="treeitem"
                          attr:aria-current={selectedFile() === f ? 'true' : null}
                          attr:href={fileHref(s.id, f)}
                          attr:title={f}>
                          <sui-icon size="xs"
                            attr:name={fileMetas()[f] ? fileMetas()[f].icon : 'file'}
                            attr:tone={fileMetas()[f] ? fileMetas()[f].tone : 'muted'}></sui-icon>
                          <span class="se-fname">{f}</span>
                          <span class="se-fkind" aria-hidden="true">{fileMetas()[f] ? fileMetas()[f].kind : ''}</span>
                        </a>
                      {/for}
                    {/if}
                  </div>
                {/for}
              </div>
            {/for}
          {/if}
        {/if}
      </div>
    </aside>

    <div class="skills-editor">
      {#if skill().kind === 'ok' && skill().value}
        <div class="se-toolbar">
          <div class="se-breadcrumb">
            <a href="/skills">skills</a>
            <span class="sep">/</span>
            <span>{skill().value.name}</span>
            {#if selectedFile()}
              <span class="sep">/</span>
              <span class="active">{selectedFile().split('/').pop()}</span>
            {/if}
          </div>
          <div class="se-toolbar-actions">
            {#if activeIsEditable()}
              <button class="sd-action sd-save-btn" data-testid="skill-save"
                prop:disabled={!dirty() || saving()}
                on:click={save}>
                <sui-icon name="save" size="xs"></sui-icon>
                <span>{saving() ? 'Saving…' : dirty() ? 'Save' : 'Saved'}</span>
              </button>
            {/if}
          </div>
        </div>
        {#if saveBanner()}
          <sui-alert tone={saveBanner().ok ? 'success' : 'destructive'} class="sd-save-banner">
            {saveBanner().msg}
          </sui-alert>
        {/if}
        <div class="se-editor-body">
          {#while-loading of fileContent}
            {#if selectedFile()}
              <div class="se-empty-state" role="status" aria-live="polite" aria-busy="true">
                <sui-spinner size="md"></sui-spinner>
                <span class="se-empty-desc">Loading file…</span>
              </div>
            {/if}
          {/while-loading}
          {#while-error err of fileContent}
            {#if selectedFile()}
              <sui-error-state variant="inline" size="sm" title="Couldn't load file" role="alert" aria-live="assertive">
                {err.message}
              </sui-error-state>
            {/if}
          {/while-error}
          {#if selectedFile() && fileContent().kind === 'ok' && fileContent().value && fileContent().value.path === selectedFile()}
            <div class="se-editor-content">
              {#if fileContent().value.ext === 'md'}
                <sui-markdown-editor data-testid="skill-editor"
                  attr:value={draft()}
                  on:sui-change={onEditorInput}
                  on:input={onEditorInput}></sui-markdown-editor>
              {:else}
                <pre class="se-code-view">{draft()}</pre>
              {/if}
            </div>
          {:else if !selectedFile()}
            {#if skill().value.body || dirty()}
              <div class="se-editor-content">
                <sui-markdown-editor data-testid="skill-editor"
                  attr:value={draft()}
                  on:sui-change={onEditorInput}
                  on:input={onEditorInput}></sui-markdown-editor>
              </div>
            {:else}
              <div class="se-empty-state" style="padding:40px 0">
                <sui-icon name="file" size="xl" tone="muted"></sui-icon>
                <span class="se-empty-desc">This skill has no SKILL.md content yet.</span>
              </div>
            {/if}
          {/if}
        </div>
      {:else if skill().kind === 'loading'}
        <div class="se-empty-state" role="status" aria-live="polite" aria-busy="true">
          <sui-spinner size="md"></sui-spinner>
          <span class="se-empty-desc">Loading skill…</span>
        </div>
      {:else if skill().kind === 'error'}
        <div class="se-empty-state">
          <sui-icon name="alert-triangle" size="xl" tone="warning"></sui-icon>
          <span class="se-empty-title">Couldn't load skill</span>
          <span class="se-empty-desc">{skill().error.message}</span>
        </div>
      {/if}
    </div>

    {#if skill().kind === 'ok' && skill().value}
      <aside class="skills-info" aria-label="Skill info panel">
        <div class="si-header">
          <span class="si-skill-id">{skill().value.id}</span>
        </div>
        <div class="si-body">
          <div class="si-section-label">Metadata</div>
          <div class="si-row">
            <span class="si-row-key">kind</span>
            <span class="si-row-val">{skill().value.kind}</span>
          </div>
          <div class="si-row">
            <span class="si-row-key">source</span>
            <span class="si-row-val">{skill().value.source}</span>
          </div>
          {#if skill().value.description}
            <div class="si-row">
              <span class="si-row-key">description</span>
              <span class="si-row-val" attr:title={skill().value.description}>{skill().value.description}</span>
            </div>
          {/if}
          {#if skill().value.tags && skill().value.tags.length > 0}
            <div class="si-section-label">Tags</div>
            <div style="display:flex;flex-wrap:wrap">
              {#for t of skill().value.tags key={t}}
                <span class="si-chip">{t}</span>
              {/for}
            </div>
          {/if}
          <div class="si-section-label">Variables ({skill().value.variables?.length ?? 0})</div>
          {#if skill().value.variables && skill().value.variables.length > 0}
            {#for v of skill().value.variables key={v}}
              <div class="si-row"><span class="si-row-key">{v}</span></div>
            {/for}
          {:else}
            <div class="si-vars-empty">No variables defined.</div>
          {/if}
          <div class="si-section-label">Files ({skill().value.files?.length ?? 0})</div>
          <div class="si-file-list">
            {#for f of (skill().value.files || []) key={f}}
              <span class="si-file-item">{f}</span>
            {/for}
          </div>
        </div>
      </aside>
    {/if}

  </div>
  <div class="skills-mobile">
    <sui-icon name="monitor" size="xl" tone="muted"></sui-icon>
    <span>Best experienced on desktop</span>
  </div>
</div>
