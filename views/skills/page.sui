<div class="ship-view ship-view-skills">
  <h1 class="sr-only">Skills</h1>
  <div class="skills-ide">

    <aside class="skills-explorer" aria-label="Skills file explorer">
      <div class="se-head">
        <div class="se-search">
          <sui-icon name="search" size="sm" tone="muted"></sui-icon>
          <input type="text" placeholder="Search skills…" spellcheck="false"
            aria-label="Search skills"
            bind:value={q}
            on:input={(e) => q.set(e.target.value)} />
        </div>
        {#if rail().kind === 'ok' && rail().value}
          <sui-cluster gap="1" role="group" aria-label="Filter by kind">
            {#for kc of (rail().value.kind_counts || []) key={kc.id}}
              <button class="se-pill" class:is-active={kind() === kc.id}
                on:click={() => kind.set(kc.id)}>
                {kc.label} <span class="se-pill-count">{kc.count}</span>
              </button>
            {/for}
          </sui-cluster>
        {/if}
      </div>

      <div class="se-body" role="tree" aria-label="Skills tree">
        {#while-loading of rail}
          <div class="se-skel" role="status" aria-live="polite" aria-busy="true" aria-label="Loading skills">
            {#for n of [0, 1, 2, 3, 4, 5] key={n}}
              <sui-cluster align="center">
                <sui-skeleton shape="line" size="md"></sui-skeleton>
              </sui-cluster>
            {/for}
          </div>
        {/while-loading}
        {#while-error err of rail}
          <sui-error-state variant="inline" size="sm" title="Couldn't load skills" role="alert" aria-live="assertive">
            {err.message}
          </sui-error-state>
        {/while-error}
        {#if rail().kind === 'ok' && rail().value}
          {#if (rail().value.groups || []).length === 0}
            <div class="se-empty">{q() ? 'No skills match "' + q() + '".' : 'No skills discovered.'}</div>
          {:else}
            {#for g of (rail().value.groups || []) key={g.source}}
              <div class="se-section">
                <div class="se-section-head">
                  <span class="se-section-label">
                    <sui-icon name="folder" size="xs" tone="muted"></sui-icon>
                    {g.source === 'PROJECT SKILLS' ? 'Project Skills' : g.source === 'USER SKILLS' ? 'Library' : g.source}
                    <span class="count">({g.skills.length})</span>
                  </span>
                </div>
                {#for s of g.skills key={s.id}}
                  <div class="se-skill-row" role="treeitem"
                    attr:aria-selected={s.id === skillId() ? 'true' : 'false'}>
                    <a class="se-skill" class:is-active={s.id === skillId()}
                      attr:href={'/skills/' + s.id}
                      attr:title={s.description}>
                      <span class="se-chevron" aria-hidden="true">
                        {#if s.id === skillId()}
                          <sui-icon name="chevron-down" size="xs"></sui-icon>
                        {:else}
                          <sui-icon name="chevron-right" size="xs"></sui-icon>
                        {/if}
                      </span>
                      <sui-icon name="zap" size="xs" tone="primary"></sui-icon>
                      <span class="se-name">{s.name}</span>
                      <span class="se-dots">
                        {#if s.has_vars}<span class="se-dot vars" title="Variables"></span>{/if}
                        {#if s.has_refs}<span class="se-dot refs" title="Reference docs"></span>{/if}
                        {#if s.has_evals}<span class="se-dot evals" title="Evals"></span>{/if}
                      </span>
                    </a>
                    {#if s.id === skillId() && s.files && s.files.length > 0}
                      {#for f of s.files key={f}}
                        <a class="se-file" class:is-active={selectedFile() === f}
                          role="treeitem"
                          attr:aria-current={selectedFile() === f ? 'true' : null}
                          attr:href={'/skills/' + s.id + '?file=' + f}
                          attr:title={f}>
                          <sui-icon size="xs"
                            attr:name={fileMetas()[f] ? fileMetas()[f].icon : 'file'}
                            attr:tone={fileMetas()[f] ? fileMetas()[f].tone : 'muted'}></sui-icon>
                          <span class="se-fname">{f}</span>
                          <span class="se-fkind" aria-hidden="true">{fileMetas()[f] ? fileMetas()[f].kind : ''}</span>
                        </a>
                      {/for}
                    {/if}
                  </div>
                {/for}
              </div>
            {/for}
          {/if}
        {/if}
      </div>
    </aside>

    <main class="skills-main">
      {#if !skillId()}
        <div class="se-empty-state">
          <sui-icon name="zap" size="xl" class="se-empty-icon" tone="muted"></sui-icon>
          <span class="se-empty-title">No skill open</span>
          <span class="se-empty-desc">Select a skill from the explorer to view its files and edit content.</span>
        </div>
      {:else if skill().kind === 'loading'}
        <div class="se-empty-state" role="status" aria-live="polite" aria-busy="true">
          <sui-spinner size="md"></sui-spinner>
          <span class="se-empty-desc">Loading skill…</span>
        </div>
      {:else if skill().kind === 'error'}
        <div class="se-empty-state">
          <sui-icon name="alert-triangle" size="xl" tone="warning"></sui-icon>
          <span class="se-empty-title">Couldn't load skill</span>
          <span class="se-empty-desc">{skill().error.message}</span>
        </div>
      {:else if sk()}
        <div class="sd-pane">
          <div class="sd-editor">
            <div class="se-toolbar">
              <div class="se-breadcrumb">
                <a href="/skills">skills</a>
                <span class="sep">/</span>
                <span class="active">{skName()}</span>
                {#if selectedFile()}
                  <span class="sep">/</span>
                  <span class="active">{selectedFileName()}</span>
                {/if}
              </div>
              <div class="se-toolbar-actions">
                {#if activeIsEditable()}
                  <button class="sd-action sd-save-btn" data-testid="skill-save"
                    prop:disabled={!dirty() || saving()}
                    on:click={save}>
                    <sui-icon name="save" size="xs"></sui-icon>
                    <span>{saving() ? 'Saving…' : dirty() ? 'Save' : 'Saved'}</span>
                  </button>
                {/if}
              </div>
            </div>
            {#if saveBanner()}
              <sui-alert tone={saveBanner().ok ? 'success' : 'destructive'} class="sd-save-banner">
                {saveBanner().msg}
              </sui-alert>
            {/if}
            <div class="se-editor-body">
              {#while-loading of fileContent}
                {#if selectedFile()}
                  <div class="se-empty-state" role="status" aria-live="polite" aria-busy="true">
                    <sui-spinner size="md"></sui-spinner>
                    <span class="se-empty-desc">Loading file…</span>
                  </div>
                {/if}
              {/while-loading}
              {#while-error err of fileContent}
                {#if selectedFile()}
                  <sui-error-state variant="inline" size="sm" title="Couldn't load file" role="alert" aria-live="assertive">
                    {err.message}
                  </sui-error-state>
                {/if}
              {/while-error}
              {#if selectedFile() && fileContent().kind === 'ok' && fileContent().value && fileContent().value.path === selectedFile()}
                <div class="se-editor-content">
                  {#if fileContent().value.ext === 'md'}
                    <sui-markdown-editor data-testid="skill-editor" full-height
                      attr:value={draft()}
                      on:sui-change={onEditorInput}
                      on:input={onEditorInput}></sui-markdown-editor>
                  {:else}
                    <pre class="se-code-view">{draft()}</pre>
                  {/if}
                </div>
              {:else if !selectedFile()}
                {#if skBody() || dirty()}
                  <div class="se-editor-content">
                    <sui-markdown-editor data-testid="skill-editor" full-height
                      attr:value={draft()}
                      on:sui-change={onEditorInput}
                      on:input={onEditorInput}></sui-markdown-editor>
                  </div>
                {:else}
                  <div class="se-empty-state">
                    <sui-icon name="file" size="xl" tone="muted"></sui-icon>
                    <span class="se-empty-desc">This skill has no SKILL.md content yet.</span>
                  </div>
                {/if}
              {/if}
            </div>
          </div>

          <aside class="skills-info" aria-label="Skill metadata panel">
            <div class="si-header">
              <div class="si-header-title">
                <sui-icon name="zap" size="sm" tone="primary"></sui-icon>
                <div class="si-header-text">
                  <span class="si-name">{skName()}</span>
                  <span class="si-skill-id">{skId()}</span>
                </div>
              </div>
            </div>

            <div class="si-body">
              <!-- ── Identity ────────────────────────────────────── -->
              <sui-collapsible class="si-coll" data-testid="si-section-identity"
                attr:open={openIdentityAttr()}
                on:sui-toggle={(e) => toggleSection('identity', e.detail.open)}>
                <div slot="trigger" class="si-coll-trigger">
                  <sui-icon name="id-card" size="xs" tone="muted"></sui-icon>
                  <span>Identity</span>
                  <sui-icon class="si-coll-caret" name="chevron-down" size="xs" tone="muted"></sui-icon>
                </div>
                <div class="si-coll-body">
                  <div class="si-row">
                    <span class="si-row-key">name</span>
                    <span class="si-row-val">{skName()}</span>
                  </div>
                  <div class="si-row">
                    <span class="si-row-key">id</span>
                    <span class="si-row-val si-row-mono">
                      <span class="si-id-text" attr:title={skId()}>{skId()}</span>
                      <button class="si-copy-btn" type="button" on:click={copyId}
                        aria-label="Copy skill id">
                        <sui-icon name="copy" size="xs"></sui-icon>
                      </button>
                    </span>
                  </div>
                  <div class="si-row">
                    <span class="si-row-key">kind</span>
                    <span class="si-row-val">{skKind()}</span>
                  </div>
                  <div class="si-row">
                    <span class="si-row-key">source</span>
                    <span class="si-row-val">{skSourceLabel()}</span>
                  </div>
                  {#if skAuthors().length > 0}
                    <div class="si-row">
                      <span class="si-row-key">authors</span>
                      <span class="si-row-val">{skAuthorsText()}</span>
                    </div>
                  {/if}
                </div>
              </sui-collapsible>

              <!-- ── Description ─────────────────────────────────── -->
              <sui-collapsible class="si-coll" data-testid="si-section-description"
                attr:open={openDescriptionAttr()}
                on:sui-toggle={(e) => toggleSection('description', e.detail.open)}>
                <div slot="trigger" class="si-coll-trigger">
                  <sui-icon name="info" size="xs" tone="muted"></sui-icon>
                  <span>Description</span>
                  {#if descSavedAgo()}
                    <span class="si-coll-meta">edited {descSavedAgo()}</span>
                  {/if}
                  <sui-icon class="si-coll-caret" name="chevron-down" size="xs" tone="muted"></sui-icon>
                </div>
                <div class="si-coll-body">
                  <textarea class="si-textarea" data-testid="si-desc-edit"
                    rows="4"
                    placeholder="What this skill does (one-liner shown in the rail)…"
                    prop:disabled={descSaving()}
                    prop:value={descDraft()}
                    on:input={onDescInput}></textarea>
                  <div class="si-section-actions">
                    <span class="si-edit-hint">
                      {descDirty() ? 'Unsaved changes' : 'Synced.'}
                    </span>
                    <button class="sd-action" type="button" data-testid="si-desc-reset"
                      prop:disabled={!descDirty() || descSaving()}
                      on:click={resetDesc}>Cancel</button>
                    <button class="sd-action sd-save-btn" type="button" data-testid="si-desc-save"
                      prop:disabled={!descDirty() || descSaving()}
                      on:click={saveDesc}>
                      <sui-icon name="save" size="xs"></sui-icon>
                      <span>{descSaving() ? 'Saving…' : 'Save'}</span>
                    </button>
                  </div>
                  {#if descBanner()}
                    <sui-alert tone={descBanner().ok ? 'success' : 'warning'} class="si-section-banner">
                      {descBanner().msg}
                    </sui-alert>
                  {/if}
                </div>
              </sui-collapsible>

              <!-- ── Tags ────────────────────────────────────────── -->
              <sui-collapsible class="si-coll" data-testid="si-section-tags"
                attr:open={openTagsAttr()}
                on:sui-toggle={(e) => toggleSection('tags', e.detail.open)}>
                <div slot="trigger" class="si-coll-trigger">
                  <sui-icon name="tag" size="xs" tone="muted"></sui-icon>
                  <span>Tags</span>
                  <span class="si-coll-count">{tagsList().length}</span>
                  <sui-icon class="si-coll-caret" name="chevron-down" size="xs" tone="muted"></sui-icon>
                </div>
                <div class="si-coll-body">
                  {#if tagsList().length > 0}
                    <div class="si-chips" data-testid="si-tag-chips">
                      {#for t of tagsList() key={t}}
                        <span class="si-chip">
                          <span class="si-chip-label">{t}</span>
                          <button type="button" class="si-chip-x"
                            attr:aria-label={'Remove tag ' + t}
                            attr:data-tag={t}
                            on:click={() => removeTag(t)}>×</button>
                        </span>
                      {/for}
                    </div>
                  {:else}
                    <div class="si-empty-inline">No tags yet.</div>
                  {/if}
                  <input class="si-input" type="text" data-testid="si-tags-input"
                    placeholder="Add tag (Enter or , to commit)"
                    prop:disabled={tagsSaving()}
                    prop:value={tagsInput()}
                    on:input={onTagsInput}
                    on:keydown={onTagsKeydown} />
                  <div class="si-section-actions">
                    <span class="si-edit-hint">
                      {tagsDirty() ? 'Unsaved changes' : 'Synced.'}
                    </span>
                    <button class="sd-action" type="button" data-testid="si-tags-reset"
                      prop:disabled={!tagsDirty() || tagsSaving()}
                      on:click={resetTags}>Cancel</button>
                    <button class="sd-action sd-save-btn" type="button" data-testid="si-tags-save"
                      prop:disabled={!tagsDirty() || tagsSaving()}
                      on:click={saveTags}>
                      <sui-icon name="save" size="xs"></sui-icon>
                      <span>{tagsSaving() ? 'Saving…' : 'Save'}</span>
                    </button>
                  </div>
                  {#if tagsBanner()}
                    <sui-alert tone={tagsBanner().ok ? 'success' : 'warning'} class="si-section-banner">
                      {tagsBanner().msg}
                    </sui-alert>
                  {/if}
                </div>
              </sui-collapsible>

              <!-- ── Triggers ────────────────────────────────────── -->
              <sui-collapsible class="si-coll" data-testid="si-section-triggers"
                attr:open={openTriggersAttr()}
                on:sui-toggle={(e) => toggleSection('triggers', e.detail.open)}>
                <div slot="trigger" class="si-coll-trigger">
                  <sui-icon name="zap" size="xs" tone="muted"></sui-icon>
                  <span>Triggers</span>
                  {#if skTriggerHints().length > 0}
                    <span class="si-coll-count">{skTriggerHints().length}</span>
                  {/if}
                  <sui-icon class="si-coll-caret" name="chevron-down" size="xs" tone="muted"></sui-icon>
                </div>
                <div class="si-coll-body">
                  {#if skTriggerHints().length > 0}
                    <ul class="si-trigger-list">
                      {#for hint of skTriggerHints() key={hint}}
                        <li class="si-trigger-row">{hint}</li>
                      {/for}
                    </ul>
                    <p class="si-help">
                      Trigger cues live in the skill body. Edit the SKILL.md to refine them.
                    </p>
                  {:else}
                    <div class="si-empty-inline">
                      No trigger cues declared. Library skills are surfaced by description match —
                      add <code>TRIGGER when:</code> lines in the body to narrow.
                    </div>
                  {/if}
                </div>
              </sui-collapsible>

              <!-- ── Variables ───────────────────────────────────── -->
              <sui-collapsible class="si-coll" data-testid="si-section-variables"
                attr:open={openVariablesAttr()}
                on:sui-toggle={(e) => toggleSection('variables', e.detail.open)}>
                <div slot="trigger" class="si-coll-trigger">
                  <sui-icon name="braces" size="xs" tone="muted"></sui-icon>
                  <span>Variables</span>
                  <span class="si-coll-count">{skVariables().length}</span>
                  <sui-icon class="si-coll-caret" name="chevron-down" size="xs" tone="muted"></sui-icon>
                </div>
                <div class="si-coll-body">
                  {#if skVariables().length > 0}
                    {#for v of skVariables() key={v}}
                      <div class="si-var-row">
                        <sui-icon name="braces" size="xs" tone="muted"></sui-icon>
                        <span class="si-var-name">{v}</span>
                      </div>
                    {/for}
                    <p class="si-help">
                      Defaults declared in <code>assets/vars.json</code>. Edit that file to change.
                    </p>
                  {:else}
                    <div class="si-empty-inline">No variables declared.</div>
                  {/if}
                </div>
              </sui-collapsible>

              <!-- ── Reference docs ──────────────────────────────── -->
              <sui-collapsible class="si-coll" data-testid="si-section-references"
                attr:open={openReferencesAttr()}
                on:sui-toggle={(e) => toggleSection('references', e.detail.open)}>
                <div slot="trigger" class="si-coll-trigger">
                  <sui-icon name="book-open" size="xs" tone="muted"></sui-icon>
                  <span>Reference docs</span>
                  <span class="si-coll-count">{skReferences().length}</span>
                  <sui-icon class="si-coll-caret" name="chevron-down" size="xs" tone="muted"></sui-icon>
                </div>
                <div class="si-coll-body">
                  {#if skReferences().length > 0}
                    {#for f of skReferences() key={f}}
                      <a class="si-file-row" data-testid="si-ref-link"
                        attr:href={'/skills/' + skId() + '?file=' + f}
                        attr:title={f}>
                        <sui-icon size="xs"
                          attr:name={fileMetas()[f] ? fileMetas()[f].icon : 'file'}
                          attr:tone={fileMetas()[f] ? fileMetas()[f].tone : 'muted'}></sui-icon>
                        <span class="si-file-name">{f}</span>
                      </a>
                    {/for}
                  {:else}
                    <div class="si-empty-inline">
                      No companion docs. Add markdown files under <code>references/</code>.
                    </div>
                  {/if}
                </div>
              </sui-collapsible>

              <!-- ── Evals (placeholder) ─────────────────────────── -->
              <sui-collapsible class="si-coll si-coll-disabled" data-testid="si-section-evals"
                attr:open={openEvalsAttr()}
                on:sui-toggle={(e) => toggleSection('evals', e.detail.open)}>
                <div slot="trigger" class="si-coll-trigger">
                  <sui-icon name="flask-conical" size="xs" tone="muted"></sui-icon>
                  <span>Evals</span>
                  <span class="si-coll-soon">Coming soon</span>
                  <sui-icon class="si-coll-caret" name="chevron-down" size="xs" tone="muted"></sui-icon>
                </div>
                <div class="si-coll-body">
                  <div class="si-empty-inline si-evals-empty">
                    <sui-icon name="flask-conical" size="md" tone="muted"></sui-icon>
                    <p>
                      Skill evals are not yet implemented. When they are, this section will
                      show pass/fail trends and let you run a test set against the skill.
                    </p>
                  </div>
                </div>
              </sui-collapsible>
            </div>
          </aside>
        </div>
      {/if}
    </main>

  </div>
  <div class="skills-mobile">
    <sui-icon name="monitor" size="xl" tone="muted"></sui-icon>
    <span>Best experienced on desktop</span>
  </div>
</div>
