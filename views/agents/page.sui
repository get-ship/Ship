<data name="agents" source="ship.agents.summaries()" live />

<div class="ship-view agents-view">
  <div class="agents-wrap">

    <header class="agents-head">
      <div class="agents-head-titles">
        <h1 class="agents-title">Agents</h1>
        <p class="agents-sub">{total()} agent{total() === 1 ? '' : 's'}</p>
      </div>
      <sui-button tone="primary" variant="solid" on:click={openNew}>
        <sui-icon slot="leading" name="plus"></sui-icon>
        New agent
      </sui-button>
    </header>

    {#while-loading of agents}
      <div class="agents-grid" data-test="loading" aria-label="Loading agents">
        {#for n of [0,1,2,3,4,5] key={n}}
          <div class="agents-skel-card" aria-hidden="true">
            <sui-skeleton shape="block" size="md" class="agents-skel-icon"></sui-skeleton>
            <div class="agents-skel-body">
              <sui-skeleton shape="line" size="md" style="width:70%"></sui-skeleton>
              <sui-skeleton shape="line" size="sm" style="width:95%"></sui-skeleton>
              <sui-skeleton shape="line" size="sm" style="width:55%"></sui-skeleton>
            </div>
          </div>
        {/for}
      </div>
    {/while-loading}

    {#while-error err of agents}
      <sui-error-state title="Couldn't load agents" data-test="error">
        {err.message}
        <sui-button slot="action" tone="primary" variant="solid" on:click={() => window.location.reload()}>Retry</sui-button>
      </sui-error-state>
    {/while-error}

    {#if agents().kind === 'ok'}
      {#if items().length === 0}
        <sui-empty-state icon="sparkles" variant="default" size="sm" data-test="empty">
          <span slot="title">No agents yet</span>
          Drop a JSONC file under
          <code class="agents-empty-code">.ship/agents/</code>
          or create one from the Studio.
          <sui-button slot="action" tone="primary" variant="solid" on:click={openNew} data-test="cta-create-first">
            <sui-icon slot="leading" name="plus"></sui-icon>
            Create your first agent
          </sui-button>
        </sui-empty-state>
      {:else}
        <div class="agents-grid" data-view-enter data-test="grid">
          {#for a of items() key={a.id}}
            <sui-list-tile variant="card" density="normal" interactive
                            navigable={'/agents/' + a.id}
                            class="agents-card-tile"
                            data-test="agent">
              <div class="agents-card-icon-tile" slot="leading">
                <span class="agents-card-letter">{a.letter}</span>
              </div>
              <div class="agents-card-body">
                <div class="agents-card-head">
                  <div class="agents-card-title">{a.name}</div>
                  <p class="agents-card-desc">{a.description || 'No description'}</p>
                </div>
                <div class="agents-card-stats">
                  <span>{a.skills_count} skill{a.skills_count === 1 ? '' : 's'}</span>
                  <span class="agents-card-sep">&middot;</span>
                  <span>{a.mcp_count} MCP</span>
                  <span class="agents-card-sep">&middot;</span>
                  <span>{a.rules_count} rule{a.rules_count === 1 ? '' : 's'}</span>
                </div>
                {#if a.providers && a.providers.length > 0}
                  <div class="agents-card-providers" aria-label="Compiles to">
                    {#for p of a.providers.slice(0, 4)}
                      <sui-chip tone="muted" variant="outline" size="sm" title={p}>{p}</sui-chip>
                    {/for}
                    {#if a.providers.length > 4}
                      <sui-chip tone="muted" variant="outline" size="sm">+{a.providers.length - 4}</sui-chip>
                    {/if}
                  </div>
                {/if}
                <div class="agents-card-badges">
                  <sui-badge tone="muted" variant="outline" size="sm" class="agents-card-badge-source">{a.source}</sui-badge>
                  {#if agentStatus()[a.id]}
                    <sui-chip
                        tone={agentStatus()[a.id] === 'errored' ? 'destructive' : agentStatus()[a.id] === 'completed' ? 'success' : 'primary'}
                        variant="soft"
                        size="sm"
                        data-test="live-status"
                        attr:data-status={agentStatus()[a.id]}>
                      <sui-status-dot
                          slot="leading"
                          tone={agentStatus()[a.id] === 'errored' ? 'destructive' : agentStatus()[a.id] === 'completed' ? 'success' : 'primary'}
                          size="sm"
                          attr:pulse={agentStatus()[a.id] === 'running' ? '' : null}
                          label={agentStatus()[a.id]}></sui-status-dot>
                      {agentStatus()[a.id]}
                    </sui-chip>
                  {:else}
                    {#if a.active}
                      <sui-chip tone="primary" variant="soft" size="sm">
                        <sui-status-dot slot="leading" tone="primary" size="sm" pulse label="Active session"></sui-status-dot>
                        active session
                      </sui-chip>
                    {/if}
                  {/if}
                  {#for t of (a.tags || []).slice(0, 2)}
                    <sui-chip tone="muted" variant="soft" size="sm">{t}</sui-chip>
                  {/for}
                  {#if (a.tags || []).length > 2}
                    <sui-chip tone="muted" variant="outline" size="sm">+{(a.tags || []).length - 2}</sui-chip>
                  {/if}
                </div>
              </div>
              <sui-button slot="trailing" variant="ghost" size="sm"
                  data-test="open-session"
                  attr:data-agent={a.id}
                  on:click={(e) => openSession(a.id, (a.providers && a.providers[0]) || 'claude', e)}>
                <sui-icon slot="leading" name="play" size="xs"></sui-icon>
                Open in session
              </sui-button>
            </sui-list-tile>
          {/for}
        </div>
      {/if}
    {/if}

  </div>

  <sui-dialog attr:open={dialogOpen() ? '' : null} size="sm" on:sui-close={closeNew} data-test="new-agent-dialog">
    <span slot="header">New agent</span>
    <sui-field label="Name" hint="Human-readable label.">
      <sui-input value={formName()} on:sui-input={nameInput} placeholder="e.g. Rust Compiler" autofocus></sui-input>
    </sui-field>
    <sui-field label="ID" hint="Lowercase kebab-case — becomes the filename stem.">
      <sui-input value={formId()} on:sui-input={idInput} placeholder="rust-compiler"></sui-input>
    </sui-field>
    <sui-field label="Provider">
      <sui-select value={formProvider()} on:sui-change={providerChange}>
        <option value="claude">claude</option>
        <option value="codex">codex</option>
        <option value="cursor">cursor</option>
        <option value="gemini">gemini</option>
        <option value="opencode">opencode</option>
      </sui-select>
    </sui-field>
    <sui-field label="Model" hint="Optional override — leave blank for the provider default.">
      <sui-select value={formModel()} on:sui-change={modelChange}>
        <option value="">(provider default)</option>
        {#for m of modelOptions() key={m}}
          <option attr:value={m}>{m}</option>
        {/for}
      </sui-select>
    </sui-field>
    {#if formErr()}
      <sui-alert tone="destructive" compact>{formErr()}</sui-alert>
    {/if}
    <sui-toolbar slot="footer">
      <sui-button variant="outline" on:click={closeNew}>Cancel</sui-button>
      <sui-button tone="primary" variant="solid"
          data-test="submit-new-agent"
          attr:loading={submitting() ? '' : null}
          attr:disabled={canSubmit() ? null : ''}
          on:click={submitNew}>
        <sui-icon slot="leading" name="plus" size="sm"></sui-icon>
        Create
      </sui-button>
    </sui-toolbar>
  </sui-dialog>
</div>
