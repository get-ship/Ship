<div class="ship-view hl-view ht-view">
  <header class="hl-head">
    <a class="hl-back" href="/harness" on:click={(e) => goNav(e, '/harness')}>
      <sui-icon name="chevron-left" size="14"></sui-icon> Harness
    </a>
    <h1 class="hl-title">Lab · Theme hot-swap</h1>
    <span class="hl-tag">override tokens · radius scale</span>
  </header>

  <section class="hl-room">
    <h2 class="hl-room-title">Primary tone override</h2>
    <p class="hl-room-hint">Calls chrome.theme.set('--primary', value). Auto-clears on view unmount.</p>
    <div class="hl-controls">
      {#for c of swatches() key={c.name}}
        <button class="ht-swatch" attr:style={'background:' + c.color}
          attr:data-active={primary() === c.color ? '1' : '0'}
          on:click={() => setPrimary(c.color)}
          attr:aria-label={c.name}></button>
      {/for}
      <sui-button size="sm" variant="ghost" on:click={clearAll}>Clear all overrides</sui-button>
    </div>
  </section>

  <section class="hl-room">
    <h2 class="hl-room-title">Radius scale</h2>
    <p class="hl-room-hint">Animate --radius-md while watching every rounded surface react.</p>
    <div class="hl-controls">
      <sui-slider min="0" max="20" prop:value={radius()} on:sui-change={(e) => setRadius(e.detail.value)}></sui-slider>
      <span class="ht-meta">{radius()}px</span>
    </div>
  </section>

  <section class="hl-room">
    <h2 class="hl-room-title">Preview surface</h2>
    <div class="ht-preview">
      <sui-button tone="primary" variant="solid">Solid</sui-button>
      <sui-button tone="primary" variant="outline">Outline</sui-button>
      <sui-button tone="primary" variant="ghost">Ghost</sui-button>
      <sui-badge tone="primary" variant="soft">Soft</sui-badge>
      <sui-badge tone="primary" variant="solid">Solid</sui-badge>
      <sui-input placeholder="input" prop:value={demo()} on:sui-input={(e) => demo.set(e.detail.value)}></sui-input>
      <sui-card class="ht-card">
        <span slot="header">Card header</span>
        <div class="ht-card-body">
          <p>Card body. Adjust radius / primary to watch this re-shape.</p>
          <sui-progress value="62" max="100"></sui-progress>
        </div>
      </sui-card>
    </div>
  </section>
</div>
