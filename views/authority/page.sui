<client name="ship" />
<data name="pending" source="ship.authority.pending()" live />

<div class="auth-page">

  <header class="auth-header">
    <div class="auth-header-main">
      <h1 class="auth-title">Authority</h1>
      <p class="auth-subtitle">Capability requests, command approvals, and the identities your spaces speak for.</p>
    </div>
    <div class="auth-header-actions">
      <button class="auth-btn auth-btn-ghost" type="button" on:click={replayDecisions}>Replay decisions</button>
      <button class="auth-btn auth-btn-ghost" type="button" on:click={openPolicy}>Policy…</button>
    </div>
  </header>

  {#while-loading of pending}
    <div class="auth-loading" aria-busy="true" role="status">Loading…</div>
  {/while-loading}

  {#while-error err of pending}
    <div class="auth-error" role="alert">{err.message}</div>
  {/while-error}

  {#if pending().kind === 'ok'}
    {#if visiblePending().length > 0}
      <section class="auth-queue" aria-label="Awaiting your decision">
        <div class="auth-section-header">
          <h2 class="auth-section-title">Awaiting your decision</h2>
          <span class="auth-counter">{visiblePending().length} pending</span>
        </div>
        <div class="auth-cards">
          {#for req of visiblePending() key={req.id}}
            <article class="auth-card">
              <div class="auth-card-row">
                {#if req.kind === 'capability'}
                  <button class="auth-agent-btn" type="button" on:click={() => openModal(req.id)}>{req.agent}</button>
                {:else}
                  <span class="auth-agent">{req.agent}</span>
                {/if}
                <span class="auth-sep" aria-hidden="true"> · </span>
                <span class="auth-space">{req.space}</span>
                <span class="auth-risk" attr:data-risk={req.risk}>{req.risk}</span>
              </div>
              <div class="auth-kind">{req.kind === 'command' ? 'WANTS TO RUN' : 'REQUESTS CAPABILITY'}</div>
              {#if req.kind === 'command'}
                <pre class="auth-command">$ {req.command}</pre>
              {:else}
                <div class="auth-scope-body">{req.scope} {req.path}</div>
              {/if}
              <div class="auth-why">Why · {req.why}</div>
              <div class="auth-card-actions">
                <button class="auth-btn auth-btn-deny" type="button" on:click={() => decide(req.id, 'deny')}>Deny</button>
                <button class="auth-btn auth-btn-secondary" type="button" on:click={() => decide(req.id, 'allow_once')}>Allow once</button>
                <button class="auth-btn auth-btn-primary" type="button" on:click={() => decide(req.id, 'allow_session')}>Allow this session</button>
              </div>
            </article>
          {/for}
        </div>
      </section>
    {:else}
      <div class="auth-empty" role="status">
        <p class="auth-empty-headline">You're all caught up</p>
        <p class="auth-empty-body">No requests awaiting your decision.</p>
      </div>
    {/if}
  {/if}

  {#if modalOpen()}
    <div class="auth-overlay" role="dialog" aria-modal="true" aria-label="Capability request">
      <div class="auth-modal">
        <p class="auth-modal-title">CAPABILITY REQUEST</p>
        {#if modalRequest()}
          <p class="auth-modal-sub">{modalRequest().agent} wants to access your filesystem</p>
          <div class="auth-modal-section">
            <h3 class="auth-modal-label">SCOPE</h3>
            <div class="auth-modal-value">{modalRequest().scope} {modalRequest().path}</div>
          </div>
          <div class="auth-modal-section">
            <h3 class="auth-modal-label">WHY</h3>
            <div class="auth-modal-value">{modalRequest().why}</div>
          </div>
          <div class="auth-modal-section">
            <h3 class="auth-modal-label">FOR HOW LONG</h3>
            <div class="auth-duration-group" role="group" aria-label="Duration">
              {#for d of durations() key={d.id}}
                <button
                  class="auth-duration-btn"
                  class:auth-duration-btn--selected={modalDuration() === d.id}
                  type="button"
                  attr:aria-pressed={modalDuration() === d.id ? 'true' : 'false'}
                  on:click={() => setModalDuration(d.id)}>
                  {d.label}
                </button>
              {/for}
            </div>
          </div>
        {/if}
        <footer class="auth-modal-footer">
          <span class="auth-modal-hint">⎋ to deny</span>
          <button class="auth-btn auth-btn-deny" type="button" on:click={modalDeny}>Deny</button>
          <button class="auth-btn auth-btn-primary" type="button" on:click={modalAllow}>Allow</button>
        </footer>
        <p class="auth-modal-tail">Decided in hub · never inside a space.</p>
      </div>
    </div>
  {/if}

</div>
