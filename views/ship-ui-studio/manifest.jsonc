// Route metadata for views/ship-ui-studio/. See
// docs/ship-adrs/references/docs/view-directory-convention.md.
//
// Detail page is served from the sibling [name]/ subdirectory under the
// same view name; the daemon resolver walks `[param]` segments to it.
{
  "name": "ship-ui-studio",
  "path": "/ship-ui-studio",
  "title": "SUI Studio",
  "layout": "default",
  "auth": "user",
  "rail": {
    "label": "UI Studio",
    "icon": "columns"
  }
}
