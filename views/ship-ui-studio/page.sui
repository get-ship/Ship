<div class="studio">
  <aside class="studio-sidebar">
    <div class="studio-sidebar-header">
      <span class="studio-brand-mark" aria-hidden="true">◐</span>
      <span class="studio-sidebar-title">SUI Studio</span>
      <sui-theme-picker label-style="compact" class="studio-theme-picker"></sui-theme-picker>
    </div>

    <sui-input
      type="search"
      placeholder="Search components…"
      value={filterText()}
      on:sui-input={(e) => filterText.set(e.detail.value)}
      size="sm"
      autocomplete="off"
    ></sui-input>

    <sui-segmented class="studio-filter" value={filterKind()} size="sm"
      aria-label="Filter catalog"
      on:sui-change={(e) => filterKind.set(e.detail.value)}>
      <sui-segmented-option value="all">All</sui-segmented-option>
      <sui-segmented-option value="sui">Components</sui-segmented-option>
      <sui-segmented-option value="view">Views</sui-segmented-option>
    </sui-segmented>

    <nav class="studio-catalog-nav" aria-label="Component catalog">
      {#if loading()}
        <div class="studio-catalog-loading">
          <sui-spinner size="sm"></sui-spinner>
        </div>
      {:else if filtered().length === 0}
        <p class="studio-catalog-empty">No matches</p>
      {:else}
        {#for item of filtered() key={item.id}}
          <a
            class="catalog-item"
            href={'/ship-ui-studio/' + item.id}
            data-test="catalog-item"
          >
            <code class="catalog-item-name">{item.id}</code>
            <sui-badge tone={item.kind === 'sui' ? 'primary' : 'info'} variant="soft" size="sm">{item.kind}</sui-badge>
          </a>
        {/for}
      {/if}
    </nav>

    <div class="studio-sidebar-counts">
      <span class="studio-count-text">{filteredCount()} of {totalCount()}</span>
      <span class="studio-search-hint"><sui-kbd>/</sui-kbd></span>
    </div>
  </aside>

  <main class="studio-main">
    {#if loading()}
      <div class="studio-loading">
        <sui-spinner size="md"></sui-spinner>
        <p class="studio-loading-text">Loading catalog</p>
      </div>
    {:else}
      <div class="studio-welcome">
        <div class="studio-welcome-mark" aria-hidden="true">◐</div>
        <h2 class="studio-welcome-title">SUI Studio</h2>
        <p class="studio-welcome-desc">Select a component from the sidebar to preview it.</p>
        <p class="studio-welcome-stats">{totalCount()} components available</p>
      </div>
    {/if}
  </main>
</div>
