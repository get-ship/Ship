<div class="ship-view overview-root">

  <!-- Toolbar -->
  <div class="overview-toolbar">
    <h1 class="ov-title">Overview</h1>
    {#if systems().kind === 'ok' && systems().value}
      <span style="color:var(--muted-foreground); font-size: var(--text-xs)">
        {systems().value.items.length} system{systems().value.items.length === 1 ? '' : 's'}
      </span>
    {/if}
    <span class="ov-sep"></span>
    <span class="ov-summary" data-test="live-summary" aria-live="polite">
      <span class="ov-summary-item" data-test="live-sessions" title="Sessions with a session.started not followed by session.ended in the most recent 50 events.">
        <span class="ov-summary-dot" data-tone={activeSessions() > 0 ? 'on' : 'off'}></span>
        <strong>{activeSessions()}</strong>
        <span>active session{activeSessions() === 1 ? '' : 's'}</span>
      </span>
      <span class="ov-summary-item" data-test="live-agents" title="Agents with an agent.started not followed by agent.completed/error in the most recent 50 events.">
        <span class="ov-summary-dot" data-tone={runningAgents() > 0 ? 'on' : 'off'}></span>
        <strong>{runningAgents()}</strong>
        <span>running agent{runningAgents() === 1 ? '' : 's'}</span>
      </span>
      <span class="ov-summary-item" data-test="live-last-event" title="Most recent kernel event observed by the live summary band.">
        <span>{lastEventLabel()}</span>
      </span>
    </span>
    <span class="ov-sep"></span>
    <sui-input size="sm" placeholder="Search…" style="width:180px;"
      bind:value={search}></sui-input>
    <span class="ov-sep"></span>

    <div class="ov-group" role="group" aria-label="Status">
      <sui-chip size="sm" class:selected={filterStatus() === ''}
        on:click={() => filterStatus.set('')}>all</sui-chip>
      {#for v of (['spec', 'building', 'shipping', 'complete']) key={v}}
        <sui-chip size="sm" class:selected={filterStatus() === v}
          on:click={() => filterStatus.set(filterStatus() === v ? '' : v)}>{v}</sui-chip>
      {/for}
    </div>
    <span class="ov-sep"></span>

    <div class="ov-group" role="group" aria-label="Layer">
      <sui-chip size="sm" class:selected={filterLayer() === ''}
        on:click={() => filterLayer.set('')}>all</sui-chip>
      {#for v of (['primitive', 'runtime', 'interface', 'meta']) key={v}}
        <sui-chip size="sm" class:selected={filterLayer() === v}
          on:click={() => filterLayer.set(filterLayer() === v ? '' : v)}>{v}</sui-chip>
      {/for}
    </div>

    <div style="flex:1"></div>
    <sui-button size="sm" tone="primary" variant="solid" on:click={openNewDrawer}>
      <sui-icon slot="leading" name="plus"></sui-icon>New system
    </sui-button>
    <sui-button size="sm" variant="ghost" aria-label="Fit view"
      on:click={fitView}>
      <sui-icon slot="leading" name="maximize"></sui-icon>Fit
    </sui-button>
  </div>

  <!-- Canvas -->
  <div class="overview-canvas-wrap" bind:this={wrapRef}>
    {#while-loading of systems}
      <div class="ov-empty">
        <sui-empty-state variant="connecting" tone="muted" size="md">
          <sui-icon slot="icon" name="loader"></sui-icon>
          <span slot="title">Loading systems&hellip;</span>
          Wiring up the canvas.
        </sui-empty-state>
      </div>
    {/while-loading}

    {#while-error err of systems}
      <div class="ov-empty">
        <sui-error-state variant="default" size="md" title="Couldn't load systems">
          {err.message}
        </sui-error-state>
      </div>
    {/while-error}

    {#if systems().kind === 'ok' && systems().value}
      {#if systems().value.items.length === 0}
        <div class="ov-empty">
          <sui-empty-state>
            <span slot="title">No systems yet</span>
            <span slot="description">Map your project by adding its first system.</span>
            <sui-button slot="actions" tone="primary" variant="solid" on:click={openNewDrawer}>
              Create first system
            </sui-button>
          </sui-empty-state>
        </div>
      {:else}
        <div class="overview-canvas" bind:this={canvasRef}>
          <svg class="ov-edges" bind:this={edgesRef} width="4000" height="4000"></svg>
          {#for item of systems().value.items key={item.id}}
            <div class="ov-node"
              attr:id={'node-' + item.id}
              attr:data-id={item.id}
              attr:data-status={item.data?.status ?? 'spec'}
              attr:data-layer={item.data?.layer ?? 'runtime'}
              attr:data-name={item.data?.name ?? ''}
              attr:data-depends={depsJson()[item.id]}
              class:dimmed={
                (search() !== '' && !(item.data?.name ?? '').toLowerCase().includes(search().toLowerCase())) ||
                (filterStatus() !== '' && item.data?.status !== filterStatus()) ||
                (filterLayer() !== '' && item.data?.layer !== filterLayer())
              }
              style={'left:' + (item.data?.position_x ?? 100) + 'px;top:' + (item.data?.position_y ?? 80) + 'px'}>
              <div class="ov-node-head">
                <sui-status-dot prop:status={item.data?.status ?? 'spec'}></sui-status-dot>
                <span>{item.data?.name ?? '(unnamed)'}</span>
              </div>
              <div class="ov-node-layer">
                {item.data?.layer ?? 'runtime'}{item.data?.doc_skill ? ' · ' + item.data.doc_skill : ''}
              </div>
              {#if item.data?.summary}
                <div class="ov-node-summary">
                  {item.data.summary.length > 80
                    ? item.data.summary.slice(0, 80) + '…'
                    : item.data.summary}
                </div>
              {/if}
              <div class="ov-connect" role="button" aria-label="Drag to connect"></div>
            </div>
          {/for}
        </div>
      {/if}
    {/if}

    <!-- Drawer -->
    <div class="ov-drawer" class:open={drawerOpen()} id="ov-drawer" role="dialog"
      aria-labelledby="ov-drawer-title" aria-modal="true">
      <div class="ov-drawer-head">
        <strong id="ov-drawer-title">{drawerTitle()}</strong>
        <sui-button size="sm" variant="ghost" aria-label="Close" on:click={closeDrawer}>
          <sui-icon slot="leading" name="x"></sui-icon>
        </sui-button>
      </div>
      <div class="ov-drawer-body">
        <div class="ship-form">
          <div class="ship-form-field">
            <label class="ship-form-label">name <span style="color:var(--destructive)">*</span></label>
            <sui-input size="sm" placeholder="ship-&lt;system&gt;" bind:value={fldName}></sui-input>
          </div>
          <div class="ship-form-field">
            <label class="ship-form-label">layer</label>
            <sui-select size="sm" bind:value={fldLayer}>
              <option value="">--</option>
              <option value="primitive">primitive</option>
              <option value="runtime">runtime</option>
              <option value="interface">interface</option>
              <option value="meta">meta</option>
            </sui-select>
          </div>
          <div class="ship-form-field">
            <label class="ship-form-label">status</label>
            <sui-select size="sm" bind:value={fldStatus}>
              <option value="spec">spec</option>
              <option value="building">building</option>
              <option value="shipping">shipping</option>
              <option value="complete">complete</option>
            </sui-select>
          </div>
          <div class="ship-form-field">
            <label class="ship-form-label">summary</label>
            <sui-input size="sm" placeholder="one-liner" bind:value={fldSummary}></sui-input>
          </div>
          <div class="ship-form-field">
            <label class="ship-form-label">doc skill</label>
            <sui-input size="sm" placeholder="ship-&lt;name&gt;" bind:value={fldDocSkill}></sui-input>
          </div>

          <div class="ship-form-field" style="flex-direction:column;align-items:stretch">
            <label class="ship-form-label">gaps</label>
            {#for (gap, idx) of fldGaps() key={'g_' + idx}}
              <div class="ov-list-row">
                <sui-input size="sm" prop:value={gap} style="flex:1"
                  on:ship-input={(e) => fldGaps.set(fldGaps().map((g: string, i: number) => i === idx ? e.detail?.value ?? g : g))}></sui-input>
                <sui-button size="xs" variant="ghost" aria-label="Remove gap"
                  on:click={() => fldGaps.set(fldGaps().filter((_: string, i: number) => i !== idx))}>
                  <sui-icon name="x"></sui-icon>
                </sui-button>
              </div>
            {/for}
            <sui-button size="sm" variant="outline" on:click={addGap}>
              <sui-icon slot="leading" name="plus"></sui-icon>Add gap
            </sui-button>
          </div>

          <div class="ship-form-field" style="flex-direction:column;align-items:stretch">
            <label class="ship-form-label">depends on</label>
            {#for (dep, idx) of fldDependsOn() key={'d_' + idx}}
              <div class="ov-list-row">
                <sui-input size="sm" prop:value={dep} placeholder="system name" style="flex:1"
                  on:ship-input={(e) => fldDependsOn.set(fldDependsOn().map((d: string, i: number) => i === idx ? e.detail?.value ?? d : d))}></sui-input>
                <sui-button size="xs" variant="ghost" aria-label="Remove dependency"
                  on:click={() => fldDependsOn.set(fldDependsOn().filter((_: string, i: number) => i !== idx))}>
                  <sui-icon name="x"></sui-icon>
                </sui-button>
              </div>
            {/for}
            <sui-button size="sm" variant="outline" on:click={addDependsOn}>
              <sui-icon slot="leading" name="plus"></sui-icon>Add dependency
            </sui-button>
          </div>
        </div>
      </div>
      <div class="ov-drawer-foot">
        <sui-button tone="primary" variant="solid" on:click={saveDrawer}>Save</sui-button>
        <sui-button variant="outline" aria-label="Send system to agent"
          on:click={askAgent}>
          <sui-icon slot="leading" name="send"></sui-icon>Ask agent
        </sui-button>
        <sui-button variant="ghost" on:click={closeDrawer}>Cancel</sui-button>
      </div>
    </div>
  </div>

</div>
