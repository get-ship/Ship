<data name="chatState" source="ship.chat.state({workspace_id: workspaceId()})" live />

<use-scroll-anchor />

<div class="ship-view ship-view-chat">
  <div class="chat-wrap">
    <div class="chat-header">
      <span class="dot"></span>
      <span>Chat</span>
      {#if workspaceId()}
        <span style="margin-left:auto">{workspaceId()}</span>
      {/if}
    </div>

    {#if workingTitle()}
      <div class="chat-working">
        <span class="pulse"></span>
        <span>Shipwright is working on <strong>{workingTitle()}</strong></span>
      </div>
    {/if}

    <div class="chat-messages" id="chat-messages">
      {#while-loading of chatState}
        <div class="chat-empty"><p>Loading&hellip;</p></div>
      {/while-loading}
      {#while-error err of chatState}
        <div class="chat-empty"><p style="color:var(--destructive)">{err.message}</p></div>
      {/while-error}
      {#if chatState().kind === 'ok'}
        {#if chatState().value.messages.length === 0}
          <div class="chat-empty">
            <p>No messages yet</p>
            <p style="font-size:10px;opacity:0.7">Send a message to the agent to get started.</p>
          </div>
        {:else}
          {#for m of chatState().value.messages key={m.id}}
            <div class="chat-row" attr:data-sender={m.sender}>
              {#if m.sender !== 'system'}
                <sui-avatar size="sm" shape="round"
                  attr:identity-hue={m.sender_id || m.sender}
                  attr:name={m.sender_name || m.sender}></sui-avatar>
              {/if}
              <div class="chat-bubble" attr:data-sender={m.sender}>
                <span class="content">{m.content}</span>
                {#if m.detail}<span class="detail">{m.detail}</span>{/if}
                <span class="meta">{m.timestamp}</span>
              </div>
            </div>
          {/for}
        {/if}
      {/if}
    </div>

    {#if annotations().length > 0}
      <div class="chat-annotations">
        {#for a of annotations() key={a.selector || a.tag || a.id}}
          <span class="chat-annotation-chip"
            on:click={() => removeAnnotation(a)}
            title="Remove annotation">
            <span>{a.selector || a.tag || 'ref'}</span>
            <span>&times;</span>
          </span>
        {/for}
      </div>
    {/if}

    <form class="chat-composer" id="chat-composer" on:submit={(e) => submitMessage(e)}>
      <textarea name="text" placeholder="Message the agent…"
        bind:value={draft}
        attr:disabled={sending() ? '' : null}
        on:keydown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); e.target.form.requestSubmit(); } }}></textarea>
      <sui-button type="submit" tone="primary" variant="solid" size="sm"
        attr:disabled={sending() ? '' : null}>Send</sui-button>
    </form>
  </div>
</div>
