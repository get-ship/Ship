// App manifest for the view-host `views/` app — a name → real-ESM-import map
// (the synthetic-view import map). Modeled on the deck-conformance manifest.
//
// This is the manifest the synthetic SSR + client emit resolve free names
// against for any view under `views/` (the synthetic SSR walks up from a
// `page.sui` to the nearest `app.manifest.jsonc`). `route`/`navigate` are the
// standard view-host handles; `construct: true` marks the route factory.
//
// The slice's picked view-host view (`views/showcase`) is a pure static
// component gallery — it references none of these, so it imports none. They
// are declared so any view under `views/` can resolve the view-host handles.
{
  "clients": {
    "route": { "from": "@ship/deck/route", "import": "route", "construct": true },
    "navigate": { "from": "@ship/deck/route", "import": "navigate" }
  }
}
