<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
{#async settings}
  {:loading}
  <sui-spinner size="md" centered></sui-spinner>

  {:error err}
  <p style="padding:var(--space-4); color:var(--destructive)">{err.message}</p>

  {:ok}
{#if agent()}
  <sui-view-chrome title={agent().name}>
    <sui-segmented slot="actions" value="settings" size="sm">
      <sui-segmented-option value="wire" on:click={goWire}>Wire</sui-segmented-option>
      <sui-segmented-option value="settings">Settings</sui-segmented-option>
    </sui-segmented>
    <sui-button slot="actions" variant="ghost" size="sm" on:click={goBack}>
      <sui-icon slot="leading" name="chevron-left" size="xs"></sui-icon>
      Agents
    </sui-button>
  </sui-view-chrome>

  <div class="ship-view ad-view">
    <div class="ad-body">
      <sui-stack gap="4">

        <sui-card padding="none">
          <div slot="header" class="ad-section-head">
            <h2 class="ad-section-title"><sui-icon name="zap"></sui-icon>Skills<span class="ad-section-count">{agent().skills.length} attached</span></h2>
            <sui-button variant="outline" size="sm" on:click={() => openPicker('skill')}><sui-icon slot="leading" name="plus"></sui-icon>Add</sui-button>
          </div>
          <div class="ad-section-body">
            {#if agent().skills.length === 0}
              <div class="ad-empty">No skills attached. Edit <code style="font-family:var(--font-mono);font-size:var(--text-xs)">.ship/agents/{agent().id}.jsonc</code> to add one.</div>
            {:else}
              <sui-cluster>
                {#for s of agent().skills key={s}}
                  <sui-list-tile variant="card" density="compact">
                    <span slot="leading" class="ad-chip-icon ad-chip-icon--skill">{s.slice(0,2)}</span>
                    <span class="ad-chip-name">{s}</span><span slot="meta" class="ad-chip-meta">project</span>
                  </sui-list-tile>
                {/for}
              </sui-cluster>
            {/if}
          </div>
        </sui-card>

        <sui-card padding="none">
          <div slot="header" class="ad-section-head">
            <h2 class="ad-section-title">
              <sui-icon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg></sui-icon>
              MCP Servers<span class="ad-section-count">{agent().mcp_servers.length} attached</span>
            </h2>
            <sui-button variant="outline" size="sm" on:click={() => openPicker('mcp')}><sui-icon slot="leading" name="plus"></sui-icon>Add</sui-button>
          </div>
          <div class="ad-section-body">
            {#if agent().mcp_servers.length === 0}
              <div class="ad-empty">No MCP servers connected. Edit <code style="font-family:var(--font-mono);font-size:var(--text-xs)">.ship/agents/{agent().id}.jsonc</code> to add one.</div>
            {:else}
              <sui-cluster>
                {#for m of agent().mcp_servers key={m}}
                  <sui-list-tile variant="card" density="compact">
                    <span slot="leading" class="ad-chip-icon ad-chip-icon--mcp">{m.slice(0,2)}</span>
                    <span class="ad-chip-name">{m}</span><span slot="meta" class="ad-chip-meta">server</span>
                  </sui-list-tile>
                {/for}
              </sui-cluster>
            {/if}
          </div>
        </sui-card>

        <sui-card padding="none">
          <div slot="header" class="ad-section-head">
            <h2 class="ad-section-title"><sui-icon name="lock"></sui-icon>Permissions</h2>
            <sui-button variant="outline" size="sm"
              attr:disabled={!pDirty() || pSaving()}
              on:click={savePermissions}>
              <sui-icon slot="leading" name="check"></sui-icon>Save
            </sui-button>
          </div>
          <div class="ad-section-body">
            <sui-field style="margin-bottom:var(--space-4)">
              <sui-label>Preset</sui-label>
              <sui-select size="sm" value={pPreset()} on:sui-change={(e) => { pPreset.set(e.detail.value); pDirty.set(true) }}>
                {#for p of (catalogs()?.presets ?? []) key={p.id}}
                  <option value={p.id} attr:selected={p.id === pPreset()}>{p.name}</option>
                {/for}
              </sui-select>
            </sui-field>
            <datalist id="perm-tool-catalog">
              {#for t of (catalogs()?.tool_patterns ?? []) key={t.pattern}}
                <option value={t.pattern}>{t.label}</option>
              {/for}
            </datalist>
            <div class="ad-perm-grid">
              {#for col of [['allow','allowDraft','Allow','check'],['ask','askDraft','Ask','info'],['deny','denyDraft','Deny','x']] key={col[0]}}
                <div class="ad-perm-card" attr:data-perm-tone={col[0]}>
                  <div attr:class={'ad-perm-card-head ad-perm-card-head--' + col[0]}>
                    <sui-icon attr:name={col[3]}></sui-icon>{col[2]}
                    <span class="ad-perm-count">{col[0] === 'allow' ? pAllow().length : col[0] === 'ask' ? pAsk().length : pDeny().length}</span>
                  </div>
                  <div class="ad-perm-add">
                    <input type="text" list="perm-tool-catalog" class="ad-perm-add-input" placeholder="Tool pattern…"
                      value={col[0] === 'allow' ? allowDraft() : col[0] === 'ask' ? askDraft() : denyDraft()}
                      on:input={(e) => (col[0] === 'allow' ? allowDraft : col[0] === 'ask' ? askDraft : denyDraft).set(e.target.value)}
                      on:keydown={(e) => addPerm(e, col[0])} />
                    <sui-button variant="ghost" size="sm" aria-label="Add"
                      attr:disabled={!(col[0] === 'allow' ? allowDraft() : col[0] === 'ask' ? askDraft() : denyDraft()).trim()}
                      on:click={() => commitPerm(col[0])}>
                      <sui-icon name="plus" size="xs"></sui-icon>
                    </sui-button>
                  </div>
                  <div class="ad-perm-list">
                    {#if pDirty()}
                      <span class="ad-perm-dirty-note">Unsaved changes — hit Save to apply.</span>
                    {:else}
                      {#for p of (col[0] === 'allow' ? pAllow() : col[0] === 'ask' ? pAsk() : pDeny()) key={p}}
                        <span class="ad-perm-chip">
                          <span class="ad-perm-chip-text">{p}</span>
                          <button type="button" class="ad-perm-chip-rm" aria-label="Remove" on:click={() => removePerm(col[0], p)}>×</button>
                        </span>
                      {:else}
                        <span class="ad-perm-none">none</span>
                      {/for}
                    {/if}
                  </div>
                </div>
              {/for}
            </div>
            <p class="ad-perm-hint">Tool patterns: <code>Read</code>, <code>Write</code>, <code>Bash(git *)</code>, <code>mcp__ship__*</code>. Globs allowed.</p>
          </div>
        </sui-card>

        <sui-card padding="none">
          <div slot="header" class="ad-section-head">
            <h2 class="ad-section-title"><sui-icon name="file"></sui-icon>Rules<span class="ad-section-count">{agent().rules.length} rules</span></h2>
            <sui-button variant="outline" size="sm" on:click={() => openPicker('rule')}><sui-icon slot="leading" name="plus"></sui-icon>Add</sui-button>
          </div>
          <div class="ad-section-body">
            {#if agent().rules.length === 0}
              <div class="ad-empty">No rules configured. This agent uses project defaults.</div>
            {:else}
              {#for r of agent().rules key={r}}
                <sui-list-tile density="compact">
                  <span slot="leading" class="ad-rule-name">{r}</span>
                  <span class="ad-rule-preview">Project rule</span>
                </sui-list-tile>
              {/for}
            {/if}
          </div>
        </sui-card>

        <sui-card padding="none">
          <div slot="header" class="ad-section-head">
            <h2 class="ad-section-title">
              <sui-icon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="2" y1="14" x2="6" y2="14"/><line x1="10" y1="8" x2="14" y2="8"/><line x1="18" y1="16" x2="22" y2="16"/></svg></sui-icon>
              Providers<span class="ad-section-count">{agent().providers.length} providers</span>
            </h2>
          </div>
          <div class="ad-section-body">
            {#if agent().providers.length === 0}
              <div class="ad-empty">No providers configured. Add one under <code style="font-family:var(--font-mono);font-size:var(--text-xs)">agent.providers</code> to run this agent.</div>
            {:else}
              <div class="ad-provider-grid">
                {#for p of providers() key={p.id}}
                  <sui-list-tile variant="card" density="compact" interactive>
                    <span slot="leading" class="ad-provider-logo">{p.id.slice(0,2)}</span>
                    <span class="ad-provider-name">{p.label}
                      {#if p.isDefault}<sui-badge tone="accent" variant="soft" size="sm">default</sui-badge>{/if}
                    </span>
                    <span slot="meta" class="ad-provider-sub"><sui-status-dot tone="success" size="sm"></sui-status-dot>defaults</span>
                  </sui-list-tile>
                {/for}
              </div>
            {/if}
          </div>
        </sui-card>

      </sui-stack>
      <div class="ad-bottom-spacer"></div>
    </div>
  </div>

  <sui-dialog prop:open={pickerOpen()} size="md" on:sui-close={closePicker}>
    <span slot="header">Add {pickerKind() === 'skill' ? 'skill' : pickerKind() === 'mcp' ? 'MCP server' : 'rule'} to <strong>{agent().name}</strong></span>
    <div class="ad-picker-body">
      {#if (catalogs()?.[pickerKind()] ?? []).length === 0}
        <sui-empty-state variant="placeholder" size="sm">
          <span slot="title">No {pickerKind()}s to add</span>
        </sui-empty-state>
      {:else}
        <sui-stack>
          {#for entry of (catalogs()?.[pickerKind()] ?? []) key={entry.id}}
            <label class="ad-picker-row">
              <input type="checkbox" class="ad-picker-check" checked={pickerSelected().includes(entry.id)} on:change={() => togglePick(entry.id)} />
              <span class="ad-picker-row-body">
                <span class="ad-picker-name">{entry.name}</span>
                <span class="ad-picker-desc">{entry.description || entry.id}</span>
              </span>
            </label>
          {/for}
        </sui-stack>
      {/if}
    </div>
    <sui-toolbar slot="footer">
      <span style="flex:1; font-size:var(--text-xs); color:var(--muted-foreground)">{pickerSelected().length} selected</span>
      <sui-button variant="ghost" size="sm" on:click={closePicker}>Cancel</sui-button>
      <sui-button tone="primary" variant="solid" size="sm" attr:disabled={pickerSelected().length === 0} on:click={savePicker}>Add</sui-button>
    </sui-toolbar>
  </sui-dialog>
{/if}
{/async}
  </main>
</div>
