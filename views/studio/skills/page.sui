<div class="ship-view studio-section-view" data-test="studio-section-view"
  attr:data-section={'skills'}>
  <section class="studio-section">
    <h1 class="studio-section-h1">Skills</h1>
    <p class="studio-section-sub">Skills available to agents in this project.</p>
    <div class="studio-section-empty">
      <sui-empty-state variant="placeholder" size="md">
        <sui-icon slot="icon" name="sparkles"></sui-icon>
        <span slot="title">Coming soon</span>
        This section's interior is coming in a follow-up. Other tracks are
        landing the per-section content.
      </sui-empty-state>
    </div>
  </section>
</div>
