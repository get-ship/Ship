// Route metadata for views/studio/. The Studio surface paints its own
// rail + top strip + content slot into the host shell's canvas.
// `layout: "full"` signals the shell-chrome layer to hide its own rail
// when this view is active (per the parallel shell-chrome job).
{
  "name": "studio",
  "path": "/studio",
  "title": "Studio",
  "layout": "full",
  "auth": "user",
  "rail": {
    "label": "Studio",
    "icon": "grid"
  }
}
