<div class="studio-view" data-test="studio-view">
  <sui-studio-rail></sui-studio-rail>
  <main class="studio-content" data-test="studio-content">
<div class="ship-view ship-theme-studio">

  <!-- Top bar: pack picker + actions -->
  <header class="ts-top" data-test="theme-studio-top">
    <div class="ts-pack">
      <label for="ts-pack-select" class="ts-top-label">Theme pack</label>
      <select id="ts-pack-select" class="ts-select"
        data-test="theme-studio-pack-select"
        on:change={(e) => selectPack(e.target.value)}>
        {#for p of packs() key={p.id}}
          <option value={p.id} attr:selected={activePack() === p.id}>{p.label}</option>
        {/for}
      </select>
    </div>

    <div class="ts-status" aria-live="polite">
      {#if status().tone === 'saved'}
        <span class="ts-pill ts-pill-ok" data-test="theme-studio-status-saved">{status().msg}</span>
      {/if}
      {#if status().tone === 'error'}
        <span class="ts-pill ts-pill-err">{status().msg}</span>
      {/if}
      {#if status().tone === 'idle' && status().msg}
        <span class="ts-pill">{status().msg}</span>
      {/if}
    </div>

    <div class="ts-actions">
      {#if isActive()}
        <button type="button" class="ts-btn ts-btn-active" disabled data-test="theme-active">
          ✓ Active
        </button>
      {:else}
        <button type="button" class="ts-btn ts-btn-primary"
          data-test="theme-set-active" on:click={setActive}>Set active</button>
      {/if}
      <button type="button" class="ts-btn"
        data-test="theme-studio-save" on:click={savePersist}>Save tokens</button>
      <button type="button" class="ts-btn"
        data-test="theme-studio-reset" on:click={resetToSaved}>Reset</button>
      <button type="button" class="ts-btn"
        data-test="theme-studio-reset-pack" on:click={resetToPack}>Reset to pack</button>
      <button type="button" class="ts-btn"
        data-test="theme-studio-export" on:click={exportJson}>Export</button>
      <label class="ts-btn ts-btn-file" for="ts-file-input">
        Import
        <input id="ts-file-input" class="ts-file" type="file" accept="application/json"
          data-test="theme-studio-import"
          on:change={(e) => importFiles(e.target.files)} />
      </label>
    </div>
  </header>

  <!-- Left: token editor, grouped by layer -->
  <aside class="ts-editor" data-test="theme-studio-editor">
    {#for layer of layers() key={layer.id}}
      <section class="ts-layer" attr:data-layer={layer.id}>
        <header class="ts-layer-head">
          <h2 class="ts-layer-title">{layer.label}</h2>
          <p class="ts-layer-blurb">{layer.blurb}</p>
        </header>
        <sui-grid>
          {#for tok of layer.tokens key={tok.name}}
            <div class="ts-row" attr:data-token={tok.name} attr:data-token-type={tok.type}>
              <label class="ts-row-name" attr:for={'ts-in-' + tok.name}>
                {tok.name}
                <span class="ts-row-intent">{tok.intent}</span>
              </label>
              {#if tok.type === 'color'}
                <span class="ts-swatch" style:background={values()[tok.name]} aria-hidden="true"></span>
              {/if}
              <input class="ts-input" type="text"
                attr:id={'ts-in-' + tok.name}
                attr:aria-label={tok.name}
                attr:value={values()[tok.name]}
                on:input={(e) => setToken(tok.name, e.target.value)} />
            </div>
          {/for}
        </sui-grid>
      </section>
    {/for}
  </aside>

  <!-- Right: live preview -->
  <section class="ts-preview" id="ts-preview" data-test="theme-studio-preview">
    <header class="ts-pv-head">
      <h2>Live preview</h2>
      <p>Reflects the active pack + your draft overrides in real time.</p>
    </header>

    <div class="ts-pv-grid">

      <article class="ts-pv-card">
        <h3 class="ts-pv-h">Buttons</h3>
        <sui-cluster>
          <button type="button" class="ts-pv-btn ts-tone-primary">Primary</button>
          <button type="button" class="ts-pv-btn ts-tone-accent">Accent</button>
          <button type="button" class="ts-pv-btn ts-tone-destructive">Destructive</button>
        </sui-cluster>
      </article>

      <article class="ts-pv-card">
        <h3 class="ts-pv-h">Card</h3>
        <div class="ts-pv-card-body">
          <strong>Card title</strong>
          <p class="ts-pv-muted">Content sits on --card, text reads --card-foreground.</p>
        </div>
      </article>

      <article class="ts-pv-card">
        <h3 class="ts-pv-h">Input</h3>
        <input type="text" class="ts-pv-input" placeholder="Type here…" />
      </article>

      <article class="ts-pv-card">
        <h3 class="ts-pv-h">Dialog</h3>
        <div class="ts-pv-dialog" role="dialog" aria-label="Preview dialog">
          <strong>Heads up</strong>
          <p class="ts-pv-muted">Modal sits on --popover with --backdrop scrim behind.</p>
          <div class="ts-pv-dialog-actions">
            <button type="button" class="ts-pv-btn ts-pv-btn-ghost">Cancel</button>
            <button type="button" class="ts-pv-btn ts-tone-primary">Confirm</button>
          </div>
        </div>
      </article>

      <article class="ts-pv-card ts-pv-wide">
        <h3 class="ts-pv-h">Navigation strip</h3>
        <nav class="ts-pv-nav" aria-label="Preview nav">
          <a class="ts-pv-nav-item ts-pv-nav-active">Dashboard</a>
          <a class="ts-pv-nav-item">Pipelines</a>
          <a class="ts-pv-nav-item">Agents</a>
          <a class="ts-pv-nav-item">Settings</a>
        </nav>
      </article>

      <article class="ts-pv-card">
        <h3 class="ts-pv-h">Command bar trigger</h3>
        <button type="button" class="ts-pv-cmdk">
          <span class="ts-pv-cmdk-dot" aria-hidden="true"></span>
          <span class="ts-pv-cmdk-text">Search, run, navigate…</span>
          <kbd class="ts-pv-kbd">⌘K</kbd>
        </button>
      </article>

      <article class="ts-pv-card ts-pv-wide">
        <h3 class="ts-pv-h">Toast tones</h3>
        <sui-grid>
          <div class="ts-pv-toast ts-tone-info">Info — preview tones reflect tone-ramp tokens.</div>
          <div class="ts-pv-toast ts-tone-success">Success — saved.</div>
          <div class="ts-pv-toast ts-tone-warning">Warning — check your inputs.</div>
          <div class="ts-pv-toast ts-tone-destructive">Error — something went wrong.</div>
        </sui-grid>
      </article>

    </div>
  </section>

</div>
  </main>
</div>
