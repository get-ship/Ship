<div class="ship-view hb-view">
  <header class="hb-head">
    <a class="hb-back" href="/harness" on:click={(e) => goNav(e, '/harness')} aria-label="Back to harness">
      <sui-icon name="chevron-left" size="14"></sui-icon> Harness
    </a>
    <h1 class="hb-title">Board</h1>
    <div class="hb-head-actions">
      <sui-badge tone="muted" variant="soft" size="sm" data-test="hb-count">{totalCards()} cards</sui-badge>
      <sui-button size="sm" variant="outline" on:click={addRandom} data-test="hb-add">
        <sui-icon slot="leading" name="plus"></sui-icon>Add
      </sui-button>
      <sui-button size="sm" variant="outline" tone="warning" on:click={chaos} data-test="hb-chaos">
        <sui-icon slot="leading" name="shuffle"></sui-icon>Chaos × 20
      </sui-button>
      <sui-button size="sm" variant="ghost" on:click={reset} data-test="hb-reset">Reset</sui-button>
    </div>
  </header>

  <div class="hb-cols" role="list" aria-label="Kanban columns">
    {#for col of columns() key={col.id}}
      <section class="hb-col" attr:data-col={col.id} role="listitem" aria-label={col.title}>
        <header class="hb-col-head">
          <span class="hb-col-dot" attr:data-tone={col.tone} aria-hidden="true"></span>
          <span class="hb-col-title">{col.title}</span>
          <sui-badge tone="muted" variant="soft" size="sm" data-test="hb-col-count">{col.cards.length}</sui-badge>
        </header>
        <ol class="hb-cards" attr:data-col-cards={col.id}
            on:dragover|preventDefault={(e) => onDragOver(e, col.id, null)}
            on:drop|preventDefault={(e) => onDrop(e, col.id, null)}>
          {#for card of col.cards key={card.id}}
            <li class="hb-card"
                attr:data-card={card.id}
                attr:data-tone={card.tone}
                draggable="true"
                in:scale={{ from: 0.92, duration: 180 }}
                out:fade={{ duration: 120 }}
                on:dragstart={(e) => onDragStart(e, card.id, col.id)}
                on:dragend={onDragEnd}
                on:dragover|preventDefault|stopPropagation={(e) => onDragOver(e, col.id, card.id)}
                on:drop|preventDefault|stopPropagation={(e) => onDrop(e, col.id, card.id)}
                on:click={() => openCard(card.id)}>
              <div class="hb-card-head">
                <span class="hb-card-title">{card.title}</span>
                {#if card.priority === 'high'}
                  <sui-badge tone="danger" variant="soft" size="sm">High</sui-badge>
                {:else if card.priority === 'low'}
                  <sui-badge tone="muted" variant="soft" size="sm">Low</sui-badge>
                {/if}
              </div>
              {#if card.summary}
                <p class="hb-card-summary">{card.summary}</p>
              {/if}
              <div class="hb-card-foot">
                <sui-avatar size="sm" attr:name={card.owner}
                  attr:initials={card.owner.slice(0, 1).toUpperCase()}></sui-avatar>
                <span class="hb-card-owner">{card.owner}</span>
                {#if card.tags && card.tags.length > 0}
                  <span class="hb-card-sep" aria-hidden="true">·</span>
                  {#for t of card.tags.slice(0, 2) key={t}}
                    <sui-chip tone="muted" variant="outline" size="sm">{t}</sui-chip>
                  {/for}
                {/if}
              </div>
            </li>
          {/for}
          {#if col.cards.length === 0}
            <li class="hb-empty">Drop a card here</li>
          {/if}
        </ol>
      </section>
    {/for}
  </div>

  <sui-drawer attr:open={drawerOpen() ? '' : null} side="right" size="md"
    on:sui-drawer-close={closeDrawer} data-test="hb-drawer">
    <span slot="title">{selectedTitle()}</span>
    {#if selectedCard()}
      <div class="hb-drawer-body">
        <sui-field label="Title">
          <sui-input prop:value={selectedTitle()} on:sui-input={(e) => editField('title', e.detail.value)}></sui-input>
        </sui-field>
        <sui-field label="Summary">
          <sui-textarea prop:value={selectedSummary()} on:sui-input={(e) => editField('summary', e.detail.value)}></sui-textarea>
        </sui-field>
        <sui-field label="Owner">
          <sui-input prop:value={selectedOwner()} on:sui-input={(e) => editField('owner', e.detail.value)}></sui-input>
        </sui-field>
        <sui-field label="Priority">
          <sui-select prop:value={selectedPriority()} on:sui-change={(e) => editField('priority', e.detail.value)}>
            <option value="high">High</option>
            <option value="normal">Normal</option>
            <option value="low">Low</option>
          </sui-select>
        </sui-field>
        <div class="hb-drawer-foot">
          <sui-button size="sm" variant="ghost" tone="danger" on:click={deleteSelected}>
            <sui-icon slot="leading" name="trash"></sui-icon>Delete card
          </sui-button>
          <sui-button size="sm" tone="primary" variant="solid" on:click={closeDrawer}>Done</sui-button>
        </div>
      </div>
    {/if}
  </sui-drawer>

</div>
