<div class="ship-view hl-view hv-view">
  <header class="hl-head">
    <a class="hl-back" href="/harness" on:click={(e) => goNav(e, '/harness')}>
      <sui-icon name="chevron-left" size="14"></sui-icon> Harness
    </a>
    <h1 class="hl-title">Lab · Virtualization</h1>
    <span class="hl-tag">{total()} rows · window {windowSize()}</span>
  </header>

  <section class="hl-room hv-controls-room">
    <div class="hl-controls">
      <sui-button size="sm" variant="outline" on:click={() => setCount(1000)}>1k</sui-button>
      <sui-button size="sm" variant="outline" on:click={() => setCount(10000)}>10k</sui-button>
      <sui-button size="sm" variant="outline" on:click={() => setCount(100000)}>100k</sui-button>
      <sui-button size="sm" variant="outline" on:click={() => jump(0.25)}>Jump 25%</sui-button>
      <sui-button size="sm" variant="outline" on:click={() => jump(0.75)}>Jump 75%</sui-button>
      <sui-button size="sm" variant="outline" attr:tone={mutating() ? 'danger' : 'primary'} on:click={toggleMutate}>
        {mutating() ? 'Stop mutate' : 'Mutate @ 60Hz'}
      </sui-button>
      <sui-button size="sm" variant="ghost" on:click={() => setDensity('compact')} attr:disabled={density() === 'compact' ? '' : null}>compact</sui-button>
      <sui-button size="sm" variant="ghost" on:click={() => setDensity('normal')} attr:disabled={density() === 'normal' ? '' : null}>normal</sui-button>
      <sui-button size="sm" variant="ghost" on:click={() => setDensity('roomy')} attr:disabled={density() === 'roomy' ? '' : null}>roomy</sui-button>
    </div>
    <div class="hv-stats">
      <span>scrollTop <strong>{scrollTop()}</strong></span>
      <span>·</span>
      <span>rendering rows <strong>{startIdx()}–{endIdx()}</strong></span>
      <span>·</span>
      <span>frame mutations <strong>{mutationCount()}</strong></span>
    </div>
  </section>

  <div class="hv-scroll" attr:data-density={density()}>
    <div class="hv-spacer" attr:style={'height:' + topPad() + 'px'}></div>
    <ol class="hv-list">
      {#for row of windowed() key={row.id}}
        <li class="hv-row" attr:data-tone={row.tone}>
          <span class="hv-row-id">#{row.id}</span>
          <span class="hv-row-title">{row.label}</span>
          <span class="hv-row-meta">{row.metric}</span>
          <span class="hv-row-bar" attr:style={'width:' + row.barPct + '%'}></span>
        </li>
      {/for}
    </ol>
    <div class="hv-spacer" attr:style={'height:' + bottomPad() + 'px'}></div>
  </div>
</div>
