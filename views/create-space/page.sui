<div class="cs-page">

  {#match step()}

    {:case 'welcome'}
    <div class="cs-welcome">
      <header class="cs-welcome-header">
        <div class="cs-logo-mark" aria-hidden="true">S</div>
        <div>
          <h1 class="cs-welcome-h1">Welcome to Ship.</h1>
          <p class="cs-welcome-meta">v1.4.2 &middot; macOS &middot; hub installed</p>
        </div>
      </header>
      <p class="cs-intro">
        Ship lives in your applications dock. Inside Ship, every <strong>space</strong> you
        create becomes its own app &mdash; its own window, its own theme, its own icon in your OS launcher.
      </p>
      <dl class="cs-terms">
        <div class="cs-term">
          <dt class="cs-term-label">Ship hub</dt>
          <dd class="cs-term-def">this app &mdash; manage spaces, account, marketplace, system settings, activity.</dd>
        </div>
        <div class="cs-term">
          <dt class="cs-term-label">Spaces</dt>
          <dd class="cs-term-def">each one runs in its own window. Switch between them like any other app.</dd>
        </div>
        <div class="cs-term">
          <dt class="cs-term-label">Studio</dt>
          <dd class="cs-term-def">inside the hub &mdash; customize a space's theme, dock, chrome.</dd>
        </div>
      </dl>
      <div class="cs-headsup" role="note">
        <span class="cs-headsup-dot" aria-hidden="true"></span>
        <p class="cs-headsup-text">
          Heads-up: Ship will register each space as an application on your system
          (Applications &middot; Start Menu &middot; Activities). You can uninstall them from the hub.
        </p>
      </div>
      <footer class="cs-footer">
        <button class="cs-btn cs-btn-ghost" type="button" on:click={skip}>Skip &mdash; explore the hub</button>
        <button class="cs-btn cs-btn-primary" type="button" on:click={goToStep1}>Create your first space</button>
      </footer>
    </div>

    {:case 'step1'}
    <div class="cs-step">
      <div class="cs-step-progress">
        <span class="cs-step-label">STEP 1</span>
        <div class="cs-progress-track" role="progressbar" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100">
          <div class="cs-progress-fill cs-progress-fill--33"></div>
        </div>
      </div>
      <h1 class="cs-step-h1">Name your space.</h1>
      <div class="cs-preview-card" aria-label="Preview">
        <div class="cs-preview-icon" attr:data-accent={accent()}>
          <span class="cs-preview-glyph" aria-hidden="true">{currentGlyphLabel()}</span>
        </div>
        <div class="cs-preview-info">
          <div class="cs-preview-name">{name() || 'Brand Voice'}</div>
          <div class="cs-preview-path">~/Spaces/{slug() || 'brand-voice'}</div>
        </div>
        <span class="cs-preview-badge">PREVIEW</span>
      </div>
      <label class="cs-field-label" for="cs-name-input">NAME</label>
      <input id="cs-name-input" class="cs-name-input" type="text" placeholder="Brand Voice" bind:value={name} />
      <div class="cs-section-label">GLYPH &amp; ACCENT</div>
      <div class="cs-glyph-row" role="group" aria-label="Choose glyph">
        {#for g of glyphs() key={g.id}}
          <button
            class="cs-glyph-tile"
            class:cs-glyph-tile--selected={glyph() === g.id}
            type="button"
            attr:aria-pressed={glyph() === g.id ? 'true' : 'false'}
            attr:data-accent={glyph() === g.id ? accent() : null}
            on:click={() => setGlyph(g.id)}>
            {g.label}
          </button>
        {/for}
      </div>
      <div class="cs-accent-row" role="group" aria-label="Choose accent color">
        {#for a of accents() key={a.id}}
          <button
            class="cs-accent-swatch"
            class:cs-accent-swatch--selected={accent() === a.id}
            type="button"
            attr:aria-pressed={accent() === a.id ? 'true' : 'false'}
            attr:data-accent={a.id}
            attr:aria-label={a.label}
            on:click={() => setAccent(a.id)}>
          </button>
        {/for}
      </div>
      <footer class="cs-footer cs-footer--steps">
        <button class="cs-btn cs-btn-ghost cs-btn-back" type="button" on:click={goBack}>&larr; Back</button>
        <button class="cs-btn cs-btn-primary" type="button" on:click={goToStep2}>Continue</button>
      </footer>
    </div>

    {:case 'step2'}
    <div class="cs-step">
      <div class="cs-step-progress">
        <span class="cs-step-label">STEP 2</span>
        <div class="cs-progress-track" role="progressbar" aria-valuenow="67" aria-valuemin="0" aria-valuemax="100">
          <div class="cs-progress-fill cs-progress-fill--67"></div>
        </div>
      </div>
      <h1 class="cs-step-h1">Pick its look.</h1>
      <div class="cs-picker-section">
        <div class="cs-picker-header">
          <span class="cs-section-label">THEME</span>
          <span class="cs-picker-note">7 built-in &middot; marketplace has more</span>
        </div>
        <div class="cs-theme-grid" role="group" aria-label="Choose theme">
          {#for t of themes() key={t.id}}
            <button
              class="cs-theme-card"
              class:cs-theme-card--selected={theme() === t.id}
              type="button"
              attr:aria-pressed={theme() === t.id ? 'true' : 'false'}
              attr:data-theme={t.id}
              on:click={() => setTheme(t.id)}>
              <div class="cs-theme-preview" attr:data-theme={t.id}>
                <div class="cs-theme-bar"></div>
                <div class="cs-theme-lines">
                  <div class="cs-theme-line cs-theme-line--lg"></div>
                  <div class="cs-theme-line cs-theme-line--sm"></div>
                </div>
              </div>
              <span class="cs-theme-label">{t.label}</span>
            </button>
          {/for}
        </div>
      </div>
      <div class="cs-two-col">
        <div class="cs-picker-section">
          <span class="cs-section-label">NAVIGATION</span>
          <div class="cs-option-row" role="group" aria-label="Choose navigation style">
            {#for n of navs() key={n.id}}
              <button
                class="cs-option-card"
                class:cs-option-card--selected={navigation() === n.id}
                type="button"
                attr:aria-pressed={navigation() === n.id ? 'true' : 'false'}
                on:click={() => setNavigation(n.id)}>
                <div class="cs-nav-preview" attr:data-nav={n.id}></div>
                <span class="cs-option-label">{n.label}</span>
              </button>
            {/for}
          </div>
        </div>
        <div class="cs-picker-section">
          <span class="cs-section-label">DOCK</span>
          <div class="cs-option-row" role="group" aria-label="Choose dock position">
            {#for d of docks() key={d.id}}
              <button
                class="cs-option-card"
                class:cs-option-card--selected={dock() === d.id}
                type="button"
                attr:aria-pressed={dock() === d.id ? 'true' : 'false'}
                on:click={() => setDock(d.id)}>
                <div class="cs-dock-preview" attr:data-dock={d.id}></div>
                <span class="cs-option-label">{d.label}</span>
              </button>
            {/for}
          </div>
        </div>
      </div>
      <p class="cs-tip"><span class="cs-tip-label">tip</span> You can change all of this later, in Studio.</p>
      <footer class="cs-footer cs-footer--steps">
        <button class="cs-btn cs-btn-ghost cs-btn-back" type="button" on:click={goBack}>&larr; Back</button>
        <button class="cs-btn cs-btn-primary" type="button" on:click={goToStep3}>Continue</button>
      </footer>
    </div>

    {:case 'step3'}
    <div class="cs-step">
      <div class="cs-step-progress">
        <span class="cs-step-label">STEP 3</span>
        <div class="cs-progress-track" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
          <div class="cs-progress-fill cs-progress-fill--100"></div>
        </div>
      </div>
      <h1 class="cs-step-h1">{name() || 'Your space'} is installed.</h1>
      <div class="cs-summary-card">
        <div class="cs-preview-icon" attr:data-accent={accent()}>
          <span class="cs-preview-glyph" aria-hidden="true">{currentGlyphLabel()}</span>
        </div>
        <div class="cs-preview-info">
          <div class="cs-preview-name">{name() || 'Brand Voice'}</div>
          <div class="cs-preview-path">{theme()} &middot; {navigation()} &middot; ~/Spaces/{slug()}</div>
        </div>
        <span class="cs-status-dot" aria-hidden="true"></span>
      </div>
      <div class="cs-find-section">
        <div class="cs-section-label">WHERE YOU'LL FIND IT</div>
        <div class="cs-find-list" role="list">
          <div class="cs-find-row" role="listitem">
            <span class="cs-find-check" aria-hidden="true">&#10003;</span>
            <strong class="cs-find-title">Applications</strong>
            <span class="cs-find-desc">macOS dock &mdash; drag to keep it there</span>
          </div>
          <div class="cs-find-row" role="listitem">
            <span class="cs-find-check" aria-hidden="true">&#10003;</span>
            <strong class="cs-find-title">Spotlight</strong>
            <span class="cs-find-desc">&#8984; Space &rarr; &ldquo;{name() || 'Brand Voice'}&rdquo;</span>
          </div>
          <div class="cs-find-row" role="listitem">
            <span class="cs-find-check" aria-hidden="true">&#10003;</span>
            <strong class="cs-find-title">Ship hub</strong>
            <span class="cs-find-desc">Spaces &middot; marked as installed</span>
          </div>
          <div class="cs-find-row" role="listitem">
            <span class="cs-find-check" aria-hidden="true">&#10003;</span>
            <strong class="cs-find-title">Shell PATH</strong>
            <span class="cs-find-desc">ship open {slug() || 'brand-voice'}</span>
          </div>
        </div>
      </div>
      <div class="cs-note" role="note">
        <span class="cs-note-label">note</span>
        Uninstall any space from Hub &rarr; Spaces &rarr; &hellip;&ensp;Ship removes the host-OS entries it created.
      </div>
      <footer class="cs-footer cs-footer--steps cs-footer--final">
        <button class="cs-btn cs-btn-ghost" type="button" on:click={done}>Done</button>
        <button class="cs-btn cs-btn-primary" type="button" on:click={launch}>Launch {name() || 'Space'}</button>
      </footer>
    </div>

    {:default}
    <div class="cs-step"></div>

  {/match}

</div>
