<div class="ship-view hi-view">
  <header class="hi-head">
    <a class="hi-back" href="/harness" on:click={(e) => goNav(e, '/harness')} aria-label="Back to harness">
      <sui-icon name="chevron-left" size="14"></sui-icon> Harness
    </a>
    <h1 class="hi-title">Inbox</h1>
    <div class="hi-head-actions">
      <sui-badge tone="muted" variant="soft" size="sm" data-test="hi-count">{filteredCount()} of {totalCount()}</sui-badge>
      <sui-button size="sm" variant="outline" on:click={burst} data-test="hi-burst">
        <sui-icon slot="leading" name="zap"></sui-icon>Burst × 50
      </sui-button>
      <sui-button size="sm" variant="outline"
        attr:tone={streaming() ? 'danger' : 'success'}
        on:click={() => toggleStream()} data-test="hi-stream">
        <sui-icon slot="leading" name={streaming() ? 'pause' : 'play'}></sui-icon>
        {streaming() ? 'Pause stream' : 'Start stream'}
      </sui-button>
      <sui-button size="sm" variant="ghost" on:click={markAllRead}>Mark all read</sui-button>
    </div>
  </header>

  <div class="hi-filters" role="tablist" aria-label="Filter">
    {#for f of filters() key={f.id}}
      <button
        class="hi-filter"
        attr:aria-selected={currentFilter() === f.id ? 'true' : 'false'}
        attr:data-active={currentFilter() === f.id ? '1' : '0'}
        on:click={() => setFilter(f.id)}
        data-test="hi-filter">
        <sui-icon name={f.icon} size="12"></sui-icon>
        {f.label}
        <sui-badge tone="muted" variant="soft" size="sm">{f.count}</sui-badge>
      </button>
    {/for}
  </div>

  <div class="hi-stream" attr:data-streaming={streaming() ? '1' : '0'}>
    <sui-status-dot prop:tone={streaming() ? 'success' : 'muted'}></sui-status-dot>
    <span>{streaming() ? 'Live — new items every ~400ms' : 'Stream paused'}</span>
    <span class="hi-stream-rate">avg {avgInterval()}ms</span>
  </div>

  <div class="hi-scroll" data-ref="scroll" role="region" aria-label="Inbox items">
    <div class="hi-spacer" attr:style={'height:' + topPad() + 'px'}></div>
    <ol class="hi-list">
      {#for item of windowedItems() key={item.id}}
        <li class="hi-item"
            attr:data-tone={item.tone}
            attr:data-read={item.read ? '1' : '0'}
            in:slide={{ axis: 'y', duration: 160 }}
            on:click={() => toggleRead(item.id)}>
          <div class="hi-item-bullet" aria-hidden="true">
            {#if !item.read}<span class="hi-item-dot"></span>{/if}
          </div>
          <div class="hi-item-body">
            <div class="hi-item-head">
              <span class="hi-item-from">{item.from}</span>
              <span class="hi-item-time">{item.timeLabel}</span>
            </div>
            <div class="hi-item-subject">{item.subject}</div>
            <p class="hi-item-preview">{item.preview}</p>
          </div>
          <sui-badge attr:tone={item.toneBadge} variant="soft" size="sm">{item.kind}</sui-badge>
        </li>
      {/for}
      {#if windowedItems().length === 0}
        <li class="hi-empty">No items match this filter.</li>
      {/if}
    </ol>
    <div class="hi-spacer" attr:style={'height:' + bottomPad() + 'px'}></div>
  </div>
</div>
