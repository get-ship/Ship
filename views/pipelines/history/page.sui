<style>
.ship-view-pipelines-history { color: var(--foreground); background: var(--background); }
.ship-hist-wrap {
  width: 100%; max-width: 96rem; margin: 0 auto;
  padding: var(--space-6) var(--space-8);
  display: flex; flex-direction: column; gap: var(--space-5);
}
.ship-hist-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }
.ship-hist-title {
  font-family: var(--font-display); font-size: var(--text-2xl);
  font-weight: var(--font-weight-bold); letter-spacing: -0.01em; margin: 0; color: var(--foreground);
}
.ship-hist-sub { font-size: var(--text-sm); color: var(--muted-foreground); margin-top: var(--space-1); }
.ship-hist-toolbar { display: flex; gap: var(--space-3); align-items: end; flex-wrap: wrap; }
.ship-hist-toolbar sui-field { flex: 1 1 16rem; min-width: 12rem; }
.ship-hist-toolbar sui-field[data-narrow] { flex: 0 0 14rem; }
.ship-hist-table-wrap {
  overflow-x: auto; border: 1px solid var(--border);
  border-radius: var(--radius-lg); background: var(--card);
}
.ship-hist-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.ship-hist-table th {
  text-align: left; padding: var(--space-3); border-bottom: 1px solid var(--border);
  font-weight: var(--font-weight-semibold); font-size: var(--text-xs);
  text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted-foreground);
  background: color-mix(in oklch, var(--muted) 40%, transparent); position: sticky; top: 0;
}
.ship-hist-table td { padding: var(--space-3); border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent); vertical-align: middle; }
.ship-hist-table tr:last-child td { border-bottom: none; }
.ship-hist-table tr:hover td { background: color-mix(in oklch, var(--muted) 30%, transparent); cursor: pointer; }
.ship-hist-slug { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--foreground); }
.ship-hist-duration, .ship-hist-agent { color: var(--muted-foreground); font-size: var(--text-xs); }
.ship-hist-pager {
  display: flex; justify-content: space-between; align-items: center;
  gap: var(--space-3); padding: var(--space-2) 0; font-size: var(--text-sm); color: var(--muted-foreground);
}
.ship-hist-empty { text-align: center; padding: var(--space-8) var(--space-4); color: var(--muted-foreground); }
</style>

{#while-loading of ctx}
  <sui-spinner size="md" centered></sui-spinner>
{/while-loading}
{#while-error err of ctx}
  <sui-alert tone="destructive">Failed to load history: {err.message}</sui-alert>
{/while-error}

<div class="ship-view ship-view-pipelines-history">
  <div class="ship-hist-wrap">
    <header class="ship-hist-head">
      <div>
        <sui-button variant="ghost" size="sm" style="margin-bottom: var(--space-2)" on:click={() => navigate('/pipelines')}>
          <sui-icon slot="leading" name="chevron-left" size="xs"></sui-icon>All pipelines
        </sui-button>
        <h1 class="ship-hist-title">History</h1>
        <p class="ship-hist-sub">
          {total()} run{total() !== 1 ? 's' : ''}
          {q() ? ' matching "' + q() + '"' : ''}
          {pipelineFilter() ? ' in ' + pipelineFilter() : ''}
        </p>
      </div>
    </header>

    <div class="ship-hist-toolbar">
      <sui-field label="Search" hint="Slug, agent, or pipeline name.">
        <sui-input bind:value={qInput} placeholder="e.g. shell-smoke, rust-lane…" on:keydown={(e) => e.key === 'Enter' && applyFilter()}></sui-input>
      </sui-field>
      <sui-field label="Pipeline" data-narrow>
        <sui-select bind:value={pipelineInput}>
          <option value="">(all)</option>
          {#for p of pipelines() key={p}}<option attr:value={p}>{p}</option>{/for}
        </sui-select>
      </sui-field>
      <sui-button variant="outline" size="sm" on:click={applyFilter}>
        <sui-icon slot="leading" name="search" size="sm"></sui-icon>Apply
      </sui-button>
      {#if q() || pipelineFilter()}
      <sui-button variant="ghost" size="sm" on:click={clearFilter}>Clear</sui-button>
      {/if}
    </div>

    <div class="ship-hist-table-wrap">
      {#if rows().length > 0}
      <table class="ship-hist-table">
        <thead>
          <tr>
            <th>Slug</th><th>Pipeline</th><th>State</th>
            <th>Agent</th><th>Duration</th><th>Finished</th>
          </tr>
        </thead>
        <tbody>
          {#for row of rows() key={row.slug}}
          <tr on:click={() => navigate('/pipelines/run/' + row.slug)}>
            <td><span class="ship-hist-slug">{row.slug}</span></td>
            <td>{#if row.pipeline}<code>{row.pipeline}</code>{:else}<span class="ship-hist-agent">—</span>{/if}</td>
            <td><sui-badge attr:tone={row.tone} size="sm">{row.state}</sui-badge></td>
            <td><span class="ship-hist-agent">{row.agent ?? '—'}</span></td>
            <td><span class="ship-hist-duration">{row.duration}</span></td>
            <td><sui-timestamp attr:value={row.updated_at} relative></sui-timestamp></td>
          </tr>
          {/for}
        </tbody>
      </table>
      {:else}
      <div class="ship-hist-empty">
        {q() || pipelineFilter() ? 'No runs match the current filter.' : 'No run history yet. Dispatch a pipeline to see runs here.'}
      </div>
      {/if}
    </div>

    {#if total() > limit()}
    <nav class="ship-hist-pager" aria-label="History pagination">
      <span>Showing {offset() + 1}–{offset() + rows().length} of {total()}</span>
      <div style="display: flex; gap: var(--space-2);">
        {#if hasPrev()}
        <sui-button variant="outline" size="sm" on:click={prevPage}>
          <sui-icon slot="leading" name="chevron-left" size="sm"></sui-icon>Previous
        </sui-button>
        {/if}
        {#if hasNext()}
        <sui-button variant="outline" size="sm" on:click={nextPage}>
          Next<sui-icon slot="trailing" name="chevron-right" size="sm"></sui-icon>
        </sui-button>
        {/if}
      </div>
    </nav>
    {/if}
  </div>
</div>
