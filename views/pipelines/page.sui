{#while-loading of ctx}
  <sui-spinner size="md" style="margin: var(--space-8) auto; display: block"></sui-spinner>
{/while-loading}
{#while-error err of ctx}
  <sui-alert tone="destructive">Failed to load pipelines: {err.message}</sui-alert>
{/while-error}

{#if defs() !== undefined}
<div class="ship-view ship-view-pipelines">
  <div class="ship-pipelines-wrap">
    <header class="ship-pipelines-head">
      <div>
        <h1 class="ship-pipelines-title">Pipelines</h1>
        <p class="ship-pipelines-sub">{statsSubtitle()}</p>
      </div>
      <div class="ship-pipelines-head-actions">
        <sui-button variant="outline" size="sm" on:click={() => navigate('/pipelines/history')}>
          <sui-icon slot="leading" name="list" size="sm"></sui-icon>History
        </sui-button>
        {#if workspaceId()}
        <sui-button variant="outline" size="sm" on:click={openNewPipe}>
          <sui-icon slot="leading" name="plus" size="sm"></sui-icon>New pipeline
        </sui-button>
        {/if}
        <sui-button tone="primary" variant="solid" size="sm" on:click={openDispatch}>
          <sui-icon slot="leading" name="play" size="sm"></sui-icon>Dispatch
        </sui-button>
      </div>
    </header>

    {#if activeRuns().length > 0}
    <div class="ship-pipelines-section">
      <div class="ship-pipelines-section-head">
        <h2 class="ship-pipelines-section-title">
          <sui-icon name="play" size="sm" tone="info"></sui-icon>Active runs
        </h2>
        <sui-badge tone="info">{activeRuns().length}</sui-badge>
      </div>
      <div class="ship-pipelines-run-list">
        {#for run of activeRuns() key={run.slug}}
          <sui-pipeline-run attr:state={run.state_attr} attr:slug={run.slug} attr:agent={run.agent}>
            <sui-timestamp slot="actions" attr:value={run.updated_at} relative></sui-timestamp>
            <sui-button slot="actions" variant="ghost" size="sm" on:click={() => navigate('/pipelines/run/' + run.slug)}>
              <sui-icon slot="leading" name="chevron-right"></sui-icon>Open
            </sui-button>
            <sui-button slot="actions" variant="outline" size="sm" tone="destructive" on:click={() => stopRun(run.job_id)}>
              <sui-icon slot="leading" name="stop"></sui-icon>Stop
            </sui-button>
            <div class="ship-run-detail">
              {#if run.agent}<sui-avatar size="sm" shape="round" attr:identity-hue={run.agent} attr:name={run.agent}></sui-avatar>{/if}
              {#if run.branch}<code>{run.branch}</code>{/if}
              {#if run.provider}<sui-provider-blob attr:provider={run.provider} size="sm" variant="glyph"></sui-provider-blob>{/if}
              {#if run.model}<sui-chip size="sm">{run.model}</sui-chip>{/if}
            </div>
            {#if run.blocker}<sui-alert tone="warning" compact>Blocked: {run.blocker}</sui-alert>{/if}
            {#if run.steps && run.steps.length > 0}
            <sui-pipeline-dag>
              {#for step of run.steps key={step.id}}
                <sui-pipeline-step attr:name={step.id} attr:state={step.state} attr:step-type={step.step_type} attr:agent={step.agent}></sui-pipeline-step>
                {#if !step.isLast}<span class="arrow" aria-hidden="true">→</span>{/if}
              {/for}
            </sui-pipeline-dag>
            {/if}
            <sui-log-stream slot="footer" attr:id={'logs-' + run.slug} attr:url={'/api/v1/pipelines/runs/' + run.slug + '/log/stream'} autoscroll></sui-log-stream>
          </sui-pipeline-run>
        {/for}
      </div>
    </div>
    {/if}

    <div class="ship-pipelines-section">
      <div class="ship-pipelines-section-head">
        <h2 class="ship-pipelines-section-title">
          <sui-icon name="git-merge" size="sm"></sui-icon>Pipelines
        </h2>
        <sui-badge tone="muted">{defs().length}</sui-badge>
      </div>
      {#if defs().length > 0}
      <div class="ship-pipelines-def-list">
        {#for def of defs() key={def.name}}
          <sui-card interactive status-rail attr:tone={def.active_runs > 0 ? 'info' : (def.last_run_tone ?? 'muted')} on:click={() => navigate('/pipelines/focus/' + def.name)}>
            <div class="ship-def-title">
              <span class="ship-def-name">{def.name}</span>
              {#if def.active_runs > 0}<sui-badge tone="info">{def.active_runs} running</sui-badge>{/if}
            </div>
            {#if def.description}<p class="ship-def-desc">{def.description}</p>{/if}
            <div class="ship-def-chips">
              <sui-chip size="sm" tone="muted">{def.step_count} step{def.step_count !== 1 ? 's' : ''}</sui-chip>
              {#if def.last_run_status}<sui-chip size="sm" attr:tone={def.last_run_tone ?? 'muted'}>{def.last_run_status}</sui-chip>{/if}
              {#if def.recent_outcomes}<span class="ship-def-spark" aria-label={'Last ' + def.recent_outcomes.length + ' run outcomes'}></span>{/if}
            </div>
            <div slot="footer" class="ship-def-stats">
              {#if def.total_runs > 0}
                <span class="ship-def-stat">
                  <span class="ship-def-stat-value">{def.total_runs}</span>
                  <span class="ship-def-stat-label">runs</span>
                </span>
                <span class="ship-def-stat">
                  <span class="ship-def-stat-value">{def.success_pct}<span class="ship-def-stat-unit">%</span></span>
                  <span class="ship-def-stat-label">success</span>
                </span>
                {#if def.last_run_at}
                <span class="ship-def-stat ship-def-stat-grow">
                  <span class="ship-def-stat-value ship-def-stat-time"><sui-timestamp attr:value={def.last_run_at} relative></sui-timestamp></span>
                  <span class="ship-def-stat-label">last run</span>
                </span>
                {/if}
              {:else}
                <span class="ship-def-stat-empty">No runs yet — click to dispatch</span>
              {/if}
            </div>
          </sui-card>
        {/for}
      </div>
      {:else}
      <sui-empty-state icon="git-merge" heading="No pipelines" description="Define a pipeline in .ship/pipelines/ to see it here."></sui-empty-state>
      {/if}
    </div>
  </div>

  <div class="ship-mobile-gate">
    <sui-icon name="monitor" size="xl" tone="muted"></sui-icon>
    <span>Best experienced on desktop</span>
  </div>

  <sui-dialog prop:open={dispatchOpen()} size="lg" on:sui-close={closeDispatch}>
    <span slot="header">Dispatch pipeline run</span>
    <sui-field label="Pipeline">
      <sui-select bind:value={dispatchPipeline}>
        {#for def of defs() key={def.name}}
          <option attr:value={def.name}>{def.name}{def.description ? ' — ' + def.description : ''}</option>
        {/for}
      </sui-select>
    </sui-field>
    <sui-field label="Spec" hint="Plain text or markdown — what the run should do.">
      <sui-textarea bind:value={dispatchSpec} rows="10" placeholder="Describe the work in one or two paragraphs..."></sui-textarea>
    </sui-field>
    <sui-field label="Provider override" hint="Optional — leave blank to use the pipeline's declared providers.">
      <sui-select bind:value={dispatchProvider}>
        <option value="">(from pipeline)</option>
        {#for p of providers() key={p}}<option attr:value={p}>{p}</option>{/for}
      </sui-select>
    </sui-field>
    <sui-field><sui-checkbox bind:checked={dispatchHeadless}>Headless (run without tmux)</sui-checkbox></sui-field>
    <sui-toolbar slot="footer">
      <sui-button variant="outline" on:click={closeDispatch}>Cancel</sui-button>
      <sui-button tone="accent" variant="solid" on:click={dispatchRun}>
        <sui-icon slot="leading" name="play" size="sm"></sui-icon>Dispatch
      </sui-button>
    </sui-toolbar>
  </sui-dialog>

  {#if workspaceId()}
  <sui-dialog prop:open={newPipeOpen()} size="sm" on:sui-close={closeNewPipe}>
    <span slot="header">New pipeline</span>
    <sui-field label="Name" hint="Lowercase, kebab-case. Becomes the filename.">
      <sui-input bind:value={newPipeName} placeholder="my-pipeline" autofocus></sui-input>
    </sui-field>
    {#if newPipeError()}<sui-alert tone="destructive" compact>{newPipeError()}</sui-alert>{/if}
    <sui-toolbar slot="footer">
      <sui-button variant="outline" on:click={closeNewPipe}>Cancel</sui-button>
      <sui-button tone="primary" variant="solid" attr:loading={newPipeCreating() ? '' : null} attr:disabled={newPipeCreating() ? '' : null} on:click={createPipeline}>
        <sui-icon slot="leading" name="plus" size="sm"></sui-icon>Create
      </sui-button>
    </sui-toolbar>
  </sui-dialog>
  {/if}
</div>
{/if}
