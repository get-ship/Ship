<style>
.ship-view-pipeline-focus { color: var(--foreground); background: var(--background); }
.ship-focus-wrap { width: 100%; max-width: 96rem; margin: 0 auto; padding: var(--space-6) var(--space-8); display: flex; flex-direction: column; gap: var(--space-6); }
.ship-focus-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); }
.ship-focus-title-block { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.ship-focus-title { display: flex; align-items: center; gap: var(--space-3); margin: 0; flex-wrap: wrap; }
.ship-focus-name { font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: var(--font-weight-bold); letter-spacing: -0.01em; color: var(--foreground); }
.ship-focus-desc { font-size: var(--text-sm); color: var(--muted-foreground); line-height: 1.55; margin: 0; max-width: 56rem; }
.ship-focus-actions { display: flex; gap: var(--space-2); }
.ship-focus-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
@media (max-width: 840px) { .ship-focus-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.ship-focus-section-label { font-family: var(--font-display); font-size: var(--text-xs); font-weight: var(--font-weight-semibold); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-foreground); margin: 0; }
.ship-focus-stack { display: flex; flex-direction: column; gap: var(--space-3); }
.ship-focus-header-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
.ship-focus-kbd { font-family: var(--font-mono); font-size: var(--text-xs); padding: 2px 6px; border-radius: 4px; background: color-mix(in oklch, var(--muted) 60%, transparent); border: 1px solid color-mix(in oklch, var(--border) 70%, transparent); color: var(--muted-foreground); }
.ship-focus-kbd-hint { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-xs); color: var(--muted-foreground); }
.ship-live-run { transition: box-shadow var(--duration-medium) var(--ease-out); border-radius: var(--radius-lg); }
.ship-live-run.ship-heartbeat { box-shadow: 0 0 0 3px color-mix(in oklch, var(--info) 30%, transparent); }
</style>

{#async ctx}
  {:loading}
  <sui-spinner size="md" centered></sui-spinner>

  {:error err}
  <sui-alert tone="destructive">Failed to load pipeline: {err.message}</sui-alert>

  {:ok}
{#if def()}
<div class="ship-view ship-view-pipeline-focus">
  <div class="ship-focus-wrap">
    <header class="ship-focus-head">
      <div class="ship-focus-title-block">
        <sui-button variant="ghost" size="sm" style="width: fit-content" on:click={() => navigate('/pipelines')}>
          <sui-icon slot="leading" name="chevron-left" size="xs"></sui-icon>All pipelines
        </sui-button>
        <h1 class="ship-focus-title">
          {#if def().active_runs > 0}<sui-status-dot tone="info" pulse></sui-status-dot>
          {:else if def().last_run_tone}<sui-status-dot attr:tone={def().last_run_tone_safe}></sui-status-dot>
          {:else}<sui-status-dot tone="muted"></sui-status-dot>{/if}
          <span class="ship-focus-name">{name()}</span>
          <sui-chip size="sm">{def().step_count} step{def().step_count !== 1 ? 's' : ''}</sui-chip>
          {#if doc().auto_merge}<sui-chip size="sm" tone="accent">auto-merge</sui-chip>{/if}
          {#if def().active_runs > 0}<sui-badge tone="info">{def().active_runs} running</sui-badge>{/if}
        </h1>
        {#if def().description}<p class="ship-focus-desc">{def().description}</p>{/if}
      </div>
      <div class="ship-focus-actions">
        {#if workspaceId()}
          {#if !editMode()}
          <sui-button variant="outline" on:click={startEdit}>
            <sui-icon slot="leading" name="edit-3" size="sm"></sui-icon>Edit
          </sui-button>
          {/if}
          {#if editMode()}
          <sui-button variant="outline" on:click={cancelEdit}>Cancel</sui-button>
          <sui-button tone="primary" variant="solid" attr:loading={editSaving()} attr:disabled={editSaving()} on:click={savePipeline}>
            <sui-icon slot="leading" name="check" size="sm"></sui-icon>Save
          </sui-button>
          <sui-button variant="outline" tone="destructive" size="sm" on:click={openDelete}>
            <sui-icon slot="leading" name="trash-2" size="sm"></sui-icon>Delete
          </sui-button>
          {/if}
        {/if}
        {#if !editMode()}
        <sui-button tone="primary" variant="solid" on:click={openDispatch}>
          <sui-icon slot="leading" name="play" size="sm"></sui-icon>Dispatch
        </sui-button>
        {/if}
      </div>
    </header>

    {#if opsMode() && activeForPipeline().length > 0}
    <section>
      <h2 class="ship-focus-section-label" style="margin-bottom: var(--space-3);">Ops · active now</h2>
      <div class="ship-focus-stack">
        {#for run of activeForPipeline() key={run.slug}}
          <ship-pipeline-run class="ship-live-run" attr:state={run.state_attr} attr:slug={run.slug} attr:agent={run.agent} on:ship-log-tick={(e) => pulseRun(e.currentTarget)}>
            <sui-timestamp slot="actions" attr:value={run.updated_at} relative></sui-timestamp>
            <sui-button slot="actions" variant="ghost" size="sm" on:click={() => navigate('/pipelines/run/' + run.slug)}>
              <sui-icon slot="leading" name="chevron-right"></sui-icon>Open
            </sui-button>
            <sui-button slot="actions" variant="outline" size="sm" tone="destructive" on:click={() => stopRun(run.job_id)}>
              <sui-icon slot="leading" name="stop"></sui-icon>Stop
            </sui-button>
            {#if run.steps && run.steps.length > 0}
            <ship-pipeline-dag>
              {#for step of run.steps key={step.id}}
                <ship-pipeline-step attr:name={step.id} attr:state={step.state} attr:step-type={step.step_type} attr:agent={step.agent}></ship-pipeline-step>
                {#if !step.isLast}<span class="arrow" aria-hidden="true">→</span>{/if}
              {/for}
            </ship-pipeline-dag>
            {/if}
            <ship-log-stream slot="footer" attr:url={'/api/v1/pipelines/runs/' + run.slug + '/log/stream'} active autoscroll></ship-log-stream>
          </ship-pipeline-run>
        {/for}
      </div>
    </section>
    {/if}

    <section>
      <h2 class="ship-focus-section-label" style="margin-bottom: var(--space-3);">{opsMode() ? 'Overview' : 'Stats'}</h2>
      <div class="ship-focus-stats">
        <sui-stat><span slot="label">Total runs</span>{def().total_runs ?? 0}</sui-stat>
        <sui-stat attr:accent={def().success_accent}>
          <span slot="label">Success rate</span>{def().success_pct}%
        </sui-stat>
        <sui-stat attr:accent={def().active_accent}>
          <span slot="label">Active now</span>{def().active_runs ?? 0}
        </sui-stat>
        <sui-stat>
          <span slot="label">Last run</span>
          {#if def().last_run_at}
            <sui-timestamp attr:value={def().last_run_at} relative></sui-timestamp>
            {#if def().last_run_status}<sui-badge slot="trend" size="sm" attr:tone={def().last_run_tone_safe}>{def().last_run_status}</sui-badge>{/if}
          {:else}—{/if}
        </sui-stat>
      </div>
    </section>

    {#if editMode()}
    <sui-card>
      <div slot="header" class="ship-focus-header-row">
        <h3 class="ship-focus-section-label">Edit {format()}</h3>
        <div style="display: flex; align-items: center; gap: var(--space-2);">
          <span class="ship-focus-kbd-hint"><kbd class="ship-focus-kbd">⌘S</kbd> save · <kbd class="ship-focus-kbd">Esc</kbd> cancel</span>
          <sui-chip size="sm" tone="info">editing</sui-chip>
        </div>
      </div>
      {#if editError()}
      <sui-alert tone="destructive" compact>
        <sui-icon slot="leading" name="triangle-alert" size="sm"></sui-icon>
        {editError()}{editErrorLine() > 0 ? ' at line ' + editErrorLine() + ':' + editErrorCol() : ''}
        {#if editIssueCount() > 1}<span slot="actions">+{editIssueCount() - 1} more — see inline markers</span>{/if}
      </sui-alert>
      {/if}
      <ship-code-editor id="pipeline-editor" bind:this={editorRef}
        attr:language={format() === 'jsonc' ? 'jsonc' : format() === 'json' ? 'json' : 'yaml'}
        attr:value={raw()} on:ship-save={savePipeline} on:ship-cancel={cancelEdit}
        style="min-height: 24rem;"></ship-code-editor>
    </sui-card>
    {/if}

    {#if !editMode()}
    <sui-card>
      <h3 slot="header" class="ship-focus-section-label">Steps</h3>
      {#if doc().steps && doc().steps.length > 0}
        {#for step of doc().steps key={step.id}}
          <ship-pipeline-step-def
            attr:index={step.index}
            attr:name={step.id}
            attr:step-type={step.step_type}
            attr:agent={step.agent} attr:provider={step.provider}
            attr:model={step.model} attr:after={step.after_joined}
            attr:command={step.run}>
            {#if step.gate}
            <div slot="gate">
              {#if step.gate.require_changed}<sui-chip size="sm" tone="info">require{step.gate.require_changed.match ? ' ' + step.gate.require_changed.match : ''}{step.gate.require_changed.min !== undefined ? ' ≥ ' + step.gate.require_changed.min : ''}</sui-chip>{/if}
              {#if step.gate.forbid_changed}<sui-chip size="sm" tone="warning">forbid{step.gate.forbid_changed.match ? ' ' + step.gate.forbid_changed.match : ''}{step.gate.forbid_changed.min !== undefined ? ' > ' + step.gate.forbid_changed.min : ''}</sui-chip>{/if}
            </div>
            {/if}
          </ship-pipeline-step-def>
        {/for}
      {:else}
        <sui-empty-state icon="list" heading="No steps" description="This pipeline file doesn't declare any steps."></sui-empty-state>
      {/if}
    </sui-card>
    {/if}

    {#if runs().length > 0}
    <sui-card>
      <h3 slot="header" class="ship-focus-section-label">{opsMode() ? 'Recent runs (history)' : 'Recent runs'}</h3>
      <div class="ship-focus-stack">
        {#for run of runs() key={run.slug}}
          {#if !opsMode() || (run.state !== 'dispatched' && run.state !== 'pending' && run.state !== 'gate-pending')}
          <ship-pipeline-run attr:state={run.state_attr} attr:slug={run.slug} attr:agent={run.agent}>
            <sui-timestamp slot="actions" attr:value={run.updated_at} relative></sui-timestamp>
            <sui-button slot="actions" variant="ghost" size="sm" on:click={() => navigate('/pipelines/run/' + run.slug)}>
              <sui-icon slot="leading" name="chevron-right"></sui-icon>Open
            </sui-button>
            {#if run.error}
            <sui-collapsible>
              <sui-alert slot="trigger" tone="destructive" compact>Error (expand for details)</sui-alert>
              <sui-code language="text">{run.error}</sui-code>
            </sui-collapsible>
            {/if}
            {#if run.steps && run.steps.length > 0}
            <ship-pipeline-dag>
              {#for step of run.steps key={step.id}}
                <ship-pipeline-step attr:name={step.id} attr:state={step.state} attr:step-type={step.step_type} attr:agent={step.agent}></ship-pipeline-step>
                {#if !step.isLast}<span class="arrow" aria-hidden="true">→</span>{/if}
              {/for}
            </ship-pipeline-dag>
            {/if}
          </ship-pipeline-run>
          {/if}
        {/for}
      </div>
    </sui-card>
    {/if}
  </div>

  <sui-dialog prop:open={dispatchOpen()} size="lg" on:sui-close={closeDispatch}>
    <span slot="header">Dispatch {name()}</span>
    <sui-field label="Spec" hint="Plain text or markdown — what the run should do.">
      <sui-textarea bind:value={dispatchSpec} rows="10" placeholder="Describe the work in one or two paragraphs..."></sui-textarea>
    </sui-field>
    <sui-field label="Provider override" hint="Optional — leave blank to use the pipeline's declared providers.">
      <sui-select bind:value={dispatchProvider}>
        <option value="">(from pipeline)</option>
        {#for p of providers() key={p}}<option attr:value={p}>{p}</option>{/for}
      </sui-select>
    </sui-field>
    <sui-field><sui-checkbox bind:checked={dispatchHeadless}>Headless (run without tmux)</sui-checkbox></sui-field>
    <sui-toolbar slot="footer">
      <sui-button variant="outline" on:click={closeDispatch}>Cancel</sui-button>
      <sui-button tone="primary" variant="solid" on:click={dispatchRun}>
        <sui-icon slot="leading" name="play" size="sm"></sui-icon>Dispatch
      </sui-button>
    </sui-toolbar>
  </sui-dialog>

  {#if workspaceId()}
  <sui-alert-dialog prop:open={deleteOpen()} tone="destructive" confirm-label="Delete pipeline" cancel-label="Keep it" on:sui-confirm={deletePipeline} on:sui-cancel={closeDelete}>
    <span slot="title">Delete <code>{name()}</code>?</span>
    <p style="margin: 0; color: var(--muted-foreground); line-height: 1.5;">This removes the pipeline file from <code>.ship/pipelines/</code>. Any runs already in flight keep going — only the definition is deleted.</p>
  </sui-alert-dialog>
  {/if}
</div>
{/if}
{/async}
