<div class="ship-view hl-view">
  <header class="hl-head">
    <a class="hl-back" href="/harness" on:click={(e) => goNav(e, '/harness')}>
      <sui-icon name="chevron-left" size="14"></sui-icon> Harness
    </a>
    <h1 class="hl-title">Lab · Motion</h1>
    <span class="hl-tag">enter/leave · transition stagger · reduced-motion</span>
  </header>

  <section class="hl-room">
    <h2 class="hl-room-title">Enter / leave on add</h2>
    <p class="hl-room-hint">Each chip scale-fades in on insert and fades out on remove. Click chips to remove individually.</p>
    <div class="hl-controls">
      <sui-button size="sm" variant="outline" on:click={addOne}>Add one</sui-button>
      <sui-button size="sm" variant="outline" on:click={addTen}>Add 10</sui-button>
      <sui-button size="sm" variant="outline" on:click={removeAll}>Remove all</sui-button>
      <sui-button size="sm" variant="ghost" on:click={shuffle}>Shuffle order</sui-button>
    </div>
    <div class="hl-chips">
      {#for chip of chips() key={chip.id}}
        <button class="hl-chip" attr:data-tone={chip.tone}
          in:scale={{ from: 0.6, duration: 220 }}
          out:fade={{ duration: 160 }}
          on:click={() => removeChip(chip.id)}>
          {chip.label}
        </button>
      {/for}
      {#if chips().length === 0}
        <span class="hl-empty">empty</span>
      {/if}
    </div>
  </section>

  <section class="hl-room">
    <h2 class="hl-room-title">Layout thrash</h2>
    <p class="hl-room-hint">Toggle keeps re-mounting 200 items. Watch frame budget. {iter()} iterations.</p>
    <div class="hl-controls">
      <sui-button size="sm" variant="outline" on:click={thrashOnce}>Re-mount × 200</sui-button>
      <sui-button size="sm" variant="outline" attr:tone={thrashing() ? 'danger' : 'primary'} on:click={toggleThrash}>
        {thrashing() ? 'Stop thrash' : 'Loop @ 60Hz'}
      </sui-button>
    </div>
    <div class="hl-grid">
      {#for n of grid() key={n}}
        <span class="hl-cell" in:fade={{ duration: 80 }}>{n}</span>
      {/for}
    </div>
  </section>

  <section class="hl-room">
    <h2 class="hl-room-title">Asymmetric slide</h2>
    <p class="hl-room-hint">Tabs change content with directional slide. Notice in/out independence.</p>
    <div class="hl-tabs">
      {#for t of tabs() key={t.id}}
        <button class="hl-tab" attr:data-active={currentTab() === t.id ? '1' : '0'}
          on:click={() => setTab(t.id)}>{t.label}</button>
      {/for}
    </div>
    <div class="hl-tab-pane">
      {#if currentTab() === 'a'}
        <div class="hl-pane" in:slide={{ axis: 'x', duration: 220 }} out:fade={{ duration: 100 }}>
          <h3>Alpha</h3>
          <p>Slides in horizontally. Leaves with a soft fade so the next pane has stage to itself.</p>
        </div>
      {:else if currentTab() === 'b'}
        <div class="hl-pane" in:slide={{ axis: 'x', duration: 220 }} out:fade={{ duration: 100 }}>
          <h3>Beta</h3>
          <p>Same recipe. Worth noting how the leave never collides with the enter.</p>
        </div>
      {:else}
        <div class="hl-pane" in:scale={{ from: 0.96, duration: 220 }} out:fade={{ duration: 100 }}>
          <h3>Gamma</h3>
          <p>Different in-form to make the asymmetry obvious.</p>
        </div>
      {/if}
    </div>
  </section>

  <section class="hl-room">
    <h2 class="hl-room-title">Reduced motion respect</h2>
    <p class="hl-room-hint">
      Current preference: <code>{prefersReduced() ? 'reduce' : 'no-preference'}</code>.
      The runtime skips animations when the OS asks. Toggle your OS setting and re-render to verify.
    </p>
    <sui-button size="sm" variant="outline" on:click={addOne}>Add one (animated unless reduce-motion)</sui-button>
  </section>

</div>
