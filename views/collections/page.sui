<data name="collections" source="ship.collections.list()" live />

<div class="ship-view data-view">

  {#if !activeId()}
    <div class="data-index">
      <div class="data-index-head">
        <div>
          <h1 class="data-index-title">Collections</h1>
          <div class="data-index-sub">
            Typed buckets for tracking specs, skills, artifacts, jobs, or anything else — stored in <span class="mono-snip">~/.ship/data.db</span>.
          </div>
        </div>
        <div class="data-index-actions">
          <sui-button size="sm" tone="accent" variant="solid" on:click={() => newColOpen.set(true)}>
            <sui-icon slot="leading" name="plus"></sui-icon>New collection
          </sui-button>
        </div>
      </div>
      {#if collections().kind === 'ok' && collections().value && collections().value.items.length === 0}
        <sui-empty-state role="status">
          <span slot="title">No collections yet</span>
          <span slot="description">Pick a template to start, or click &ldquo;New collection&rdquo; for a blank one.</span>
        </sui-empty-state>
        <div class="col-examples" aria-label="Example collections">
          {#for ex of examples() key={ex.id}}
            <button type="button" class="col-example" aria-label={'Create ' + ex.name + ' collection'}
              on:click={() => createFromExample(ex.id)}>
              <span class="col-example-icon"><sui-icon attr:name={ex.icon}></sui-icon></span>
              <span class="col-example-name">{ex.name}</span>
              <span class="col-example-desc">{ex.description}</span>
            </button>
          {/for}
        </div>
      {:else if collections().kind === 'ok' && collections().value}
        <div class="col-index-toolbar">
          <sui-input attr:value={indexQuery()} placeholder="Filter collections by name…"
            on:input={(e) => indexQuery.set(e.target.value)}>
            <sui-icon slot="leading" name="search" size="sm"></sui-icon>
          </sui-input>
          <span class="col-index-count">
            {filteredIndex().length} of {collections().value.items.length}
          </span>
        </div>
        {#if filteredIndex().length === 0}
          <div class="col-index-empty" role="status">No collections match &ldquo;{indexQuery()}&rdquo;.</div>
        {/if}
        <div class="data-card-grid">
          {#for c of filteredIndex() key={c.id}}
            <a class="data-card" attr:href={'/collections?collection=' + c.id}
              on:click={(e) => { e.preventDefault(); navigate('/collections?collection=' + c.id) }}>
              <sui-cluster gap="2" align="center">
                <span class="data-card-icon"><sui-icon name="database"></sui-icon></span>
                <div class="data-card-identity">
                  <div class="data-card-name">{c.name || c.id}</div>
                  <div class="data-card-id mono-snip">{c.builtin ? 'built-in' : '.ship/collections/' + c.id + '.jsonc'}</div>
                </div>
                <span class="data-card-count">
                  {c.item_count ?? 0} item{(c.item_count ?? 0) !== 1 ? 's' : ''}
                </span>
              </sui-cluster>
              {#if c.status_summary && c.status_summary.length > 0}
                <sui-cluster gap="1">
                  {#for sv of c.status_summary key={sv.value}}
                    <span class={'status-chip status-chip-' + sv.value}>
                      <span class="status-chip-dot" aria-hidden="true"></span>
                      <span class="status-chip-label">{sv.value}</span>
                      <span class="status-chip-count">{sv.count}</span>
                    </span>
                  {/for}
                </sui-cluster>
              {:else if c.fields && c.fields.length > 0}
                <sui-cluster gap="1">
                  {#for f of c.fields.slice(0, 5) key={f.name}}
                    <span class="data-card-field">
                      <sui-badge variant="soft" size="sm">{f.type}</sui-badge>
                      <span class="mono-snip">{f.name}</span>
                      {#if f.required}<span class="data-card-req">*</span>{/if}
                    </span>
                  {/for}
                  {#if c.fields.length > 5}
                    <span class="data-card-field data-card-field-more">+{c.fields.length - 5} more</span>
                  {/if}
                </sui-cluster>
              {/if}
              <div class="data-card-footer">
                <span>
                  <sui-icon name="columns" size="sm"></sui-icon>
                  {c.field_count} field{c.field_count !== 1 ? 's' : ''}
                </span>
                <span class="data-card-footer-sep" aria-hidden="true">·</span>
                <span>
                  <sui-icon name="clock" size="sm"></sui-icon>
                  {c.activity_label}
                </span>
              </div>
            </a>
          {/for}
        </div>
      {/if}
    </div>

  {:else}
    <div class="col-workspace">
      <aside class="col-nav">
        <div class="col-nav-section">
          <span>Collections</span>
          <span class="col-nav-add" title="New collection" style="cursor:pointer"
            on:click={() => newColOpen.set(true)}>
            <sui-icon name="plus" size="sm"></sui-icon>
          </span>
        </div>
        {#if collections().kind === 'ok' && collections().value}
          {#if collections().value.items.length === 0}<div class="col-nav-empty" role="status"><span slot="title">No collections defined</span></div>{/if}
          {#for c of collections().value.items key={c.id}}
            <a class="col-nav-row" class:is-active={c.id === activeId()}
              attr:href={'/collections?collection=' + c.id}
              on:click={(e) => { e.preventDefault(); navigate('/collections?collection=' + c.id) }}>
              <span class="col-nav-icon"><sui-icon name="database" size="sm"></sui-icon></span>
              <span class="col-nav-label">{c.name || c.id}</span>
              <span class="col-nav-count">{c.item_count ?? 0}</span>
            </a>
            {#if c.id === activeId()}
              <div class="col-nav-sub">
                <span class="col-nav-sub-dot"></span>
                <span>Default view</span>
              </div>
            {/if}
          {/for}
        {/if}
      </aside>

      <div class="col-work-main">
        <div class="col-head">
          <sui-cluster gap="2" align="center">
            <span class="col-head-icon"><sui-icon name="database" size="sm"></sui-icon></span>
            {#if colDetail().kind === 'ok' && colDetail().value}
              <span class="col-head-name">{colDetail().value.schema.name || activeId()}</span>
              <span class="col-head-id mono-snip">{activeId()}</span>
              <span class="col-head-count">{colDetail().value.items.length} of {colDetail().value.total_items}</span>
            {/if}
          </sui-cluster>
          <div class="col-head-right">
            {#if hasStatusField()}
              <sui-segmented size="sm" attr:value={statusFilter()} on:sui-change={(e) => statusFilter.set(e.detail.value)}>
                <sui-segmented-option value="">All</sui-segmented-option>
                {#for sv of statusValues() key={sv}}
                  <sui-segmented-option attr:value={sv}>{sv}</sui-segmented-option>
                {/for}
              </sui-segmented>
              <span class="col-head-sep" aria-hidden="true"></span>
            {/if}
            <sui-segmented size="sm" attr:value={tab()} on:change={(e) => tab.set(e.detail.value)}>
              <sui-segmented-option value="rows" icon="list-check">Rows</sui-segmented-option>
              <sui-segmented-option value="schema" icon="columns">Schema</sui-segmented-option>
            </sui-segmented>
            <span class="col-head-sep" aria-hidden="true"></span>
            <sui-button size="sm" tone="accent" variant="solid"
              on:click={() => { rowDraft.set({}); newRowOpen.set(true) }}>
              <sui-icon slot="leading" name="plus"></sui-icon>New row
            </sui-button>
          </div>
        </div>

        {#if tab() === 'rows'}
          <div class="col-tab-panel rows-panel">
            {#while-loading of colDetail}
              <div role="status" aria-live="polite" aria-busy="true" style="padding:var(--space-4);color:var(--muted-foreground)">Loading&hellip;</div>
            {/while-loading}
            {#if colDetail().kind === 'ok' && colDetail().value}
              {#if filteredRows().length === 0 && colDetail().value.items.length === 0}
                <sui-empty-state role="status" style="padding:var(--space-8)">
                  <span slot="title">No items in {colDetail().value.schema.name || activeId()}</span>
                  <span slot="description">Click &ldquo;New row&rdquo; to add the first item.</span>
                </sui-empty-state>
              {:else if filteredRows().length === 0}
                <div class="col-empty-filter" role="status">
                  No items with status &ldquo;{statusFilter()}&rdquo;.
                </div>
              {:else}
                <table class="col-table">
                  <thead>
                    <tr>
                      <th>id <span aria-label="sorted ascending">↑</span></th>
                      {#for f of colDetail().value.schema.fields key={f.name}}<th>{f.name}</th>{/for}
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    {#for row of filteredRows() key={row.id}}
                      <tr>
                        <td class="col-cell mono-snip">{row.id}</td>
                        {#for cell of row.cells key={cell.kind + ':' + cell.value}}
                          {#if cell.kind === 'status'}
                            <td class="col-cell col-cell-status">
                              <button type="button" class={cell.class_name}
                                aria-label={'Cycle status for ' + row.id}
                                on:click={(e) => { e.stopPropagation(); cycleStatus(row.raw) }}>
                                <span class="status-chip-dot" aria-hidden="true"></span>
                                <span class="status-chip-label">{cell.value}</span>
                              </button>
                            </td>
                          {:else if cell.kind === 'ref'}
                            <td class="col-cell">
                              <span class="ref-pill">
                                <sui-icon attr:name={cell.icon} size="xs"></sui-icon>
                                <span class="mono-snip">{cell.label}</span>
                              </span>
                            </td>
                          {:else}
                            <td class="col-cell">{cell.value}</td>
                          {/if}
                        {/for}
                        <td>
                          <sui-button size="sm" variant="ghost" aria-label={'Edit row ' + row.id}
                            on:click={() => openEditRow(row.raw)}>
                            <sui-icon name="edit" size="xs"></sui-icon>
                          </sui-button>
                        </td>
                      </tr>
                    {/for}
                  </tbody>
                </table>
              {/if}
            {/if}
          </div>
        {/if}

        {#if tab() === 'schema'}
          <div class="col-tab-panel schema-panel">
            {#if colDetail().kind === 'ok' && colDetail().value}
              <div class="schema-pane">
                <div class="schema-pane-head">
                  <div>
                    <h3 class="schema-pane-title">{colDetail().value.schema.name || activeId()}</h3>
                    <div class="schema-pane-sub mono-snip">
                      {colDetail().value.schema.builtin
                        ? 'built-in'
                        : '.ship/collections/' + activeId() + '.jsonc'}
                    </div>
                  </div>
                  <span class="schema-pane-count">
                    {colDetail().value.schema.fields.length} field{colDetail().value.schema.fields.length !== 1 ? 's' : ''}
                  </span>
                </div>
                {#if colDetail().value.schema.builtin}
                  <div class="schema-builtin-note">
                    <sui-icon name="lock" size="sm"></sui-icon>
                    Built-in collections ship with the runtime. Fields are listed for reference only.
                  </div>
                {/if}
                <sui-stack gap="1">
                  {#for f of schemaFieldsView() key={f.name}}
                    <div class="schema-field">
                      <span class={'ft-badge ft-' + f.field_type}>{f.field_type}</span>
                      <span class="schema-field-name mono-snip">{f.name}</span>
                      {#if f.required}<span class="schema-field-req">required</span>{/if}
                      {#if f.values && f.values.length > 0}
                        <span class="schema-field-values mono-snip">{f.values_pretty}</span>
                      {/if}
                      {#if !colDetail().value.schema.builtin}<sui-button size="sm" variant="ghost" aria-label="Remove field" on:click={() => removeSchemaField(f.name)}><sui-icon name="trash" size="xs"></sui-icon></sui-button>{/if}
                    </div>
                  {/for}
                </sui-stack>
              </div>
            {/if}
          </div>
        {/if}
      </div>
    </div>
  {/if}

  <sui-drawer attr:open={newRowOpen() ? '' : null} size="md"
    on:sui-close={() => { newRowOpen.set(false); drawerError.set('') }}>
    <span slot="title">New row</span>
    {#if colDetail().kind === 'ok' && colDetail().value}
      <span slot="description">Add a new item to {colDetail().value.schema.name || activeId()}</span>
      <sui-stack gap="3">
        {#for f of colDetail().value.schema.fields key={f.name}}
          <sui-stack gap="1">
            <label class="drawer-label">
              {f.name}{#if f.required}<span class="drawer-req">*</span>{/if}
              <span class="drawer-type">{f.field_type}</span>
            </label>
            {#if f.field_type === 'boolean'}
              <sui-switch attr:checked={rowDraft()[f.name] ? '' : null}
                on:change={(e) => setDraftField('row', f.name, e.target.checked)}></sui-switch>
            {:else if f.field_type === 'markdown'}
              <sui-textarea rows="4" attr:placeholder={f.name + '…'}
                attr:value={rowDraft()[f.name] ?? ''}
                on:input={(e) => setDraftField('row', f.name, e.target.value)}></sui-textarea>
            {:else}
              <sui-input attr:type={f.field_type === 'number' ? 'number' : 'text'}
                attr:value={rowDraft()[f.name] ?? ''} attr:placeholder={f.name}
                on:input={(e) => setDraftField('row', f.name, e.target.value)}></sui-input>
            {/if}
          </sui-stack>
        {/for}
        {#if drawerError()}<div class="drawer-error">{drawerError()}</div>{/if}
      </sui-stack>
      <div slot="footer">
        <sui-button variant="ghost" on:click={() => { newRowOpen.set(false); drawerError.set('') }}>Cancel</sui-button>
        <sui-button tone="accent" variant="solid" on:click={saveNewRow}>Save</sui-button>
      </div>
    {/if}
  </sui-drawer>

  <sui-drawer attr:open={editOpen() ? '' : null} size="md"
    on:sui-close={() => { editOpen.set(false); drawerError.set('') }}>
    <span slot="title">Edit row</span>
    {#if colDetail().kind === 'ok' && colDetail().value}
      <span slot="description">Editing {editId()}</span>
      <sui-stack gap="3">
        {#for f of colDetail().value.schema.fields key={f.name}}
          <sui-stack gap="1">
            <label class="drawer-label">
              {f.name}{#if f.required}<span class="drawer-req">*</span>{/if}
              <span class="drawer-type">{f.field_type}</span>
            </label>
            {#if f.field_type === 'boolean'}
              <sui-switch attr:checked={editDraft()[f.name] ? '' : null}
                on:change={(e) => setDraftField('edit', f.name, e.target.checked)}></sui-switch>
            {:else if f.field_type === 'markdown'}
              <sui-textarea rows="4" attr:placeholder={f.name + '…'}
                attr:value={editDraft()[f.name] ?? ''}
                on:input={(e) => setDraftField('edit', f.name, e.target.value)}></sui-textarea>
            {:else}
              <sui-input attr:type={f.field_type === 'number' ? 'number' : 'text'}
                attr:value={editDraft()[f.name] ?? ''} attr:placeholder={f.name}
                on:input={(e) => setDraftField('edit', f.name, e.target.value)}></sui-input>
            {/if}
          </sui-stack>
        {/for}
        {#if drawerError()}<div class="drawer-error">{drawerError()}</div>{/if}
      </sui-stack>
      <div slot="footer">
        <sui-button tone="destructive" variant="soft" style="margin-right:auto"
          on:click={deleteRow}>Delete</sui-button>
        <sui-button variant="ghost" on:click={() => { editOpen.set(false); drawerError.set('') }}>Cancel</sui-button>
        <sui-button tone="accent" variant="solid" on:click={saveEdit}>Save</sui-button>
      </div>
    {/if}
  </sui-drawer>

  <sui-drawer attr:open={newColOpen() ? '' : null} size="md"
    on:sui-close={() => { newColOpen.set(false); drawerError.set('') }}>
    <span slot="title">New collection</span>
    <span slot="description">Define a typed dataset stored in data.db</span>
    <sui-stack gap="3">
      <sui-stack gap="1">
        <label class="drawer-label">
          Collection ID <span class="drawer-req">*</span>
          <span class="drawer-type">snake_case</span>
        </label>
        <sui-input bind:value={newColDraftId} placeholder="my_collection" required
          style="font-family:var(--font-mono)"></sui-input>
      </sui-stack>
      <sui-stack gap="1">
        <label class="drawer-label">Display name</label>
        <sui-input bind:value={newColDraftName} placeholder="My Collection"></sui-input>
      </sui-stack>
      {#if drawerError()}<div class="drawer-error">{drawerError()}</div>{/if}
    </sui-stack>
    <div slot="footer">
      <sui-button variant="ghost" on:click={() => { newColOpen.set(false); drawerError.set('') }}>Cancel</sui-button>
      <sui-button tone="accent" variant="solid" on:click={createCollection}>Create collection</sui-button>
    </div>
  </sui-drawer>

</div>
