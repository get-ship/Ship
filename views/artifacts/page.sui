<!--
  views/artifacts/page.sui — the Artifacts browser view.

  Composes the @ship/artifacts pack:
    - <ship-artifact-list>    the live-data table (subscribes to ship.artifacts.list)
    - <ship-artifact-filters>  search + mime/collection/actor/age selects
    - <ship-artifact-actions>  promote / rename / delete verbs
    - <ship-artifact-upload>   drop / file select → host wires ship.artifacts.upload
    - <ship-artifact-preview>  mime-dispatched preview (image / text / json / binary)

  The host (this view) owns the SDK calls for upload / promote / delete / patch.
  The pack components are presentational; they emit `ship-artifact-*` events
  which the page wires to the SDK via the controller.

  Page-level drop (anywhere on the page) is handled by the host so a
  user can drop a file on empty space without opening the upload dialog.
-->
<client name="ship" />

<div class="art-wrap"
  on:dragenter={onDragOver}
  on:dragover={onDragOver}
  on:dragleave={onDragLeave}
  on:drop={onDrop}>

  <header class="art-head">
    <div class="art-head-titles">
      <h1 class="art-title">Artifacts</h1>
      <p class="art-sub">{visibleCount()} of {totalCount()} artifact{totalCount() === 1 ? '' : 's'}</p>
    </div>
    <sui-cluster gap="2" align="center">
      <sui-button tone="primary" variant="solid" size="sm"
        on:click={openUpload} data-test="upload-button">
        <sui-icon slot="leading" name="upload"></sui-icon>Upload
      </sui-button>
    </sui-cluster>
  </header>

  <ship-artifact-filters
    prop:collections={collectionsJson()}
    prop:actors={actorsJson()}
    on:ship-artifact-filter={onFilterChange}
  ></ship-artifact-filters>
  <ship-artifact-list
    on:ship-artifact-select={onRowSelect}
  ></ship-artifact-list>

  {#if dragActive()}
    <div class="art-drop-overlay" data-test="drop-overlay" aria-hidden="true">
      <sui-icon name="upload" size="lg"></sui-icon>
      <span>Drop to upload</span>
    </div>
  {/if}

  <sui-drawer prop:open={detailOpen()} size="lg"
    on:sui-close={closeDetail} data-test="detail-drawer">
    {#if detailItem()}
      <span slot="title">{detailItem().name || detailItem().id}</span>
      <span slot="description">{detailItem().mime} · {detailItem().size_label}</span>

      <sui-stack gap="4">
        <dl class="art-detail-meta">
          <div class="art-detail-row">
            <dt>ID</dt>
            <dd><span class="mono">{detailItem().id}</span></dd>
          </div>
          <div class="art-detail-row">
            <dt>Created</dt>
            <dd class="muted">{detailItem().created_at}</dd>
          </div>
          {#if detailItem().collection_id}
            <div class="art-detail-row">
              <dt>Collection</dt>
              <dd><sui-chip tone="muted" variant="soft" size="sm">{detailItem().collection_id}</sui-chip></dd>
            </div>
          {/if}
          {#if detailItem().scope}
            <div class="art-detail-row">
              <dt>Scope</dt>
              <dd><span class="mono-snip">{detailItem().scope}</span></dd>
            </div>
          {/if}
        </dl>

        <ship-artifact-actions
          prop:record={detailItemJson()}
          on:ship-artifact-promote={onPromote}
          on:ship-artifact-delete={onDelete}
          on:ship-artifact-rename={onRename}
        ></ship-artifact-actions>

        <div class="art-detail-preview" data-test="detail-preview">
          <ship-artifact-preview
            prop:record={detailItemJson()}
            prop:url={detailUrl()}
          ></ship-artifact-preview>
        </div>
      </sui-stack>

      <div slot="footer">
        <sui-button variant="ghost" on:click={closeDetail}>Close</sui-button>
        <a class="art-detail-download" attr:href={detailUrl()} data-no-router
          attr:download={detailItem().name || detailItem().id}>
          <sui-button tone="primary" variant="solid">
            <sui-icon slot="leading" name="download"></sui-icon>Download
          </sui-button>
        </a>
      </div>
    {/if}
  </sui-drawer>

  <sui-dialog prop:open={uploadOpen()} size="md"
    on:sui-close={closeUpload} data-test="upload-dialog">
    <span slot="header">Upload artifact</span>
    <sui-stack gap="3">
      <ship-artifact-upload
        prop:collection-id={uploadCollection()}
        prop:disabled={uploading()}
        on:ship-artifact-upload={(e) => submitUpload(e.detail.files)}
      ></ship-artifact-upload>

      <sui-stack gap="1">
        <label class="art-upload-label" for="art-upload-col">
          Collection <span class="art-upload-hint">(optional)</span>
        </label>
        <sui-select size="sm" attr:value={uploadCollection()}
          on:sui-change={(e) => onUploadCollection(e.detail.value)}
          prop:disabled={uploading()}
          data-test="upload-collection">
          <option value="">No collection</option>
          {#for c of collectionOptions() key={c.id}}
            <option attr:value={c.id}>{c.name || c.id}</option>
          {/for}
        </sui-select>
      </sui-stack>

      {#if uploadError()}
        <div class="art-upload-error" data-test="upload-error">{uploadError()}</div>
      {/if}
    </sui-stack>
    <div slot="footer">
      <sui-button variant="ghost" on:click={closeUpload}
        prop:disabled={uploading()}>Cancel</sui-button>
      <sui-button tone="primary" variant="solid" on:click={triggerUpload}
        prop:disabled={uploading()}
        prop:loading={uploading()}
        data-test="upload-submit">Upload</sui-button>

    </div>
  </sui-dialog>

</div>
