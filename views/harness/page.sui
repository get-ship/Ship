<div class="ship-view harness-view">
  <div class="harness-wrap">

    <header class="harness-head">
      <div class="harness-head-titles">
        <h1 class="harness-title" data-test="harness-title">SUI Harness</h1>
        <p class="harness-sub">A workbench for finding edge cases, regressions, and ergonomics gaps. Not a product surface.</p>
      </div>
      <div class="harness-head-side">
        <sui-badge tone="warning" variant="soft" size="sm">dev only</sui-badge>
      </div>
    </header>

    <section class="harness-section">
      <h2 class="harness-section-title">Trellis — feels like an app</h2>
      <p class="harness-section-hint">Whole-flow ergonomics. Use it like a real app and notice what feels off.</p>
      <div class="harness-grid">
        {#for room of trellisRooms() key={room.path}}
          <a class="harness-tile" href={room.path} on:click={(e) => goNav(e, room.path)}
            data-test="harness-tile" attr:data-room={room.key}>
            <div class="harness-tile-icon" attr:data-tone={room.key} aria-hidden="true">
              <sui-icon name={room.icon} size="18"></sui-icon>
            </div>
            <div class="harness-tile-body">
              <div class="harness-tile-name">{room.label}</div>
              <p class="harness-tile-desc">{room.desc}</p>
            </div>
            <sui-icon class="harness-tile-arrow" name="chevron-right" size="14" aria-hidden="true"></sui-icon>
          </a>
        {/for}
      </div>
    </section>

    <section class="harness-section">
      <h2 class="harness-section-title">Lab — surgical stressors</h2>
      <p class="harness-section-hint">Each room isolates one stressor. Easy to add regression cases.</p>
      <div class="harness-grid">
        {#for room of labRooms() key={room.path}}
          <a class="harness-tile" href={room.path} on:click={(e) => goNav(e, room.path)}
            data-test="harness-tile" attr:data-room={room.key}>
            <div class="harness-tile-icon" attr:data-tone={room.key} aria-hidden="true">
              <sui-icon name={room.icon} size="18"></sui-icon>
            </div>
            <div class="harness-tile-body">
              <div class="harness-tile-name">{room.label}</div>
              <p class="harness-tile-desc">{room.desc}</p>
            </div>
            <sui-icon class="harness-tile-arrow" name="chevron-right" size="14" aria-hidden="true"></sui-icon>
          </a>
        {/for}
      </div>
    </section>

    <footer class="harness-foot">
      <span class="harness-foot-key"><sui-kbd>g</sui-kbd> then <sui-kbd>b</sui-kbd> — board</span>
      <span class="harness-foot-key"><sui-kbd>g</sui-kbd> then <sui-kbd>l</sui-kbd> — lab</span>
      <span class="harness-foot-key"><sui-kbd>?</sui-kbd> — toggle perf overlay (planned)</span>
    </footer>

  </div>
</div>
