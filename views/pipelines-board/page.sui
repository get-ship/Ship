<style>
.pipelines-board-view {
  display: flex; flex-direction: column; gap: var(--space-3);
  padding: var(--space-4); height: 100%; min-height: 0;
}
.pipelines-board-view-head { flex: 0 0 auto; }
.pipelines-board-view-head h1 { margin: 0 0 var(--space-1); font-size: 1.5rem; font-weight: 600; }
.pipelines-board-view-head .lead { margin: 0; color: var(--muted-foreground); }
app-pipeline-board { flex: 1; min-height: 0; }
</style>

<div class="pipelines-board-view">
  <header class="pipelines-board-view-head">
    <h1>Pipeline runs</h1>
    <p class="lead">Live board of dispatched jobs. Select a run to see its DAG.</p>
  </header>
  <app-pipeline-board refresh-ms="2000" limit="50"></app-pipeline-board>
</div>
