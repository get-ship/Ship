<div class="ship-view" data-test="activity-view">
  <header class="view-head">
    <sui-cluster gap="2" align="center">
      <sui-icon name="activity" aria-hidden="true"></sui-icon>
      <h1>Activity</h1>
      <sui-badge tone="muted" variant="outline" size="sm">scaffold</sui-badge>
    </sui-cluster>
  </header>

  <sui-empty-state icon="activity" variant="default">
    <span slot="title">What's running, every space</span>
    Owner-level, cross-space monitor of running agents and compute — what
    <code>mesh</code> shows today, rebuilt fresh on the live snapshot.
    Not built yet — this is the placeholder so the surface exists and is reachable.
  </sui-empty-state>
</div>
