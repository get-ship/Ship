// Behavioral acceptance for views/eval — the eval-runs comparison surface.
// The given.ship rows mirror EXACTLY what .ship/skills/sui-eval/scripts/record.ts
// writes into the sui-eval-runs collection (one row per run_id × lane_id),
// including the optional behavior_* fields a behavior-spec'd run adds.
//
// Run headless:
//   bun .ship/skills/sui-eval/scripts/behavior-grade.ts . views/eval views/eval/page.behavior.jsonc
{
  "view": "eval",
  "scenarios": [
    {
      "name": "runs render grouped with per-lane compile, lint, and behavior stats",
      "given": {
        "url": "/eval",
        "ship": {
          "collections.items": {
            "items": [
              {
                "id": "260611-authority-ref/sonnet",
                "data": {
                  "run_id": "260611-authority-ref", "lane_id": "sonnet",
                  "composite": 0.95, "compile_passed": true,
                  "lint_errors": 0, "lint_warnings": 0,
                  "behavior_passed": 4, "behavior_total": 4, "behavior_score": 1.0
                }
              },
              {
                "id": "260611-authority-ref/haiku",
                "data": {
                  "run_id": "260611-authority-ref", "lane_id": "haiku",
                  "composite": 0.52, "compile_passed": false,
                  "lint_errors": 2, "lint_warnings": 1
                }
              }
            ]
          }
        }
      },
      "steps": [
        { "see": "Evals" },
        { "see": "260611-authority-ref" },
        { "see": "2 lanes" },
        { "see": "sonnet" },
        { "see": "0.95" },
        { "see": "4/4" },
        { "see": "haiku" },
        { "see": "fail" }
      ]
    },
    {
      "name": "no runs yet shows the empty state",
      "given": { "url": "/eval", "ship": { "collections.items": { "items": [] } } },
      "steps": [
        { "see": "Evals" },
        { "see": "No eval runs yet" },
        { "notSee": "composite" }
      ]
    }
  ]
}
