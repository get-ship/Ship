<data name="agentsSummaries" source="ship.agents.summaries()" live />
<data name="artifactsList" source="ship.artifacts.list()" live />

<div class="ship-view canvas-shell">

  <header class="canvas-header">
    <div class="canvas-header-title">
      <sui-icon name="image" aria-hidden="true"></sui-icon>
      <h1>Canvas</h1>
      <span class="canvas-id-chip" title="canvas session id">{shortId()}</span>
    </div>

    <div class="canvas-header-actions">
      {#if pairedAgentId()}
        <span class="canvas-pair-chip">
          <sui-icon name="user" aria-hidden="true"></sui-icon>
          {pairedAgentLabel()}
          <button type="button" class="canvas-pair-unpair" on:click={unpair} title="Unpair">
            <sui-icon name="x" aria-hidden="true"></sui-icon>
          </button>
        </span>
      {/if}

      <button type="button" class="canvas-btn" on:click={toggleRecent} aria-pressed={recentOpen()}>
        <sui-icon name="history" aria-hidden="true"></sui-icon>
        Recent
      </button>

      <button type="button" class="canvas-btn" on:click={newCanvas}>
        <sui-icon name="plus" aria-hidden="true"></sui-icon>
        New
      </button>

      <button type="button" class="canvas-btn canvas-btn-primary" on:click={saveCanvas}>
        <sui-icon name="save" aria-hidden="true"></sui-icon>
        Save
      </button>
    </div>

    {#if recentOpen()}
      <div class="canvas-recent-popover" role="dialog" aria-label="Recent canvases">
        <div class="canvas-recent-header">Recent canvases</div>
        {#if recentItems().length > 0}
          <div class="canvas-recent-list">
            {#for art of recentItems() key={art.id}}
              <button type="button" class="canvas-recent-item" on:click={(e) => { e.preventDefault(); loadArtifact(art.id) }}>
                <span class="canvas-recent-name">{art.name || art.id}</span>
                <span class="canvas-recent-meta">{(art.created_at || '').slice(0, 16)}</span>
              </button>
            {/for}
          </div>
        {:else}
          <div class="canvas-recent-empty">No saved canvases yet.</div>
        {/if}
      </div>
    {/if}
  </header>

  <main class="canvas-main">
    {#if !pairedAgentId()}
      <div class="canvas-empty-state">
        <sui-icon name="users" aria-hidden="true"></sui-icon>
        <div class="canvas-empty-title">Pair with an agent to begin</div>
        <div class="canvas-empty-desc">
          Pick an agent to author content into this canvas. The agent emits SUI markup;
          you annotate and send feedback; the agent applies morph patches in place.
        </div>

        <div class="canvas-agent-picker">
          {#if agentsSummaries().kind === 'ok' && agentsSummaries().value && agentsSummaries().value.items && agentsSummaries().value.items.length > 0}
            {#for ag of agentsSummaries().value.items key={ag.id}}
              <button type="button" class="canvas-agent-card" on:click={(e) => { e.preventDefault(); pair(ag.id) }}>
                <div class="canvas-agent-name">{ag.name || ag.id}</div>
                {#if ag.description}
                  <div class="canvas-agent-desc">{ag.description}</div>
                {/if}
              </button>
            {/for}
          {:else}
            <div class="canvas-agent-empty">No agents installed.</div>
          {/if}
        </div>
      </div>
    {:else}
      <div class="canvas-paired">
        <sui-annotation-layer
          attr:view-id={canvasId()}
          mode={annMode()}
          staging
          bind:this={annLayerEl}
          class="canvas-annotation-layer">
          <sui-canvas
            bind:this={canvasEl}
            attr:canvas-id={canvasId()}
            attr:agent-id={pairedAgentId()}
            full-height
          ></sui-canvas>
        </sui-annotation-layer>

        <aside class="canvas-side-rail">
          <div class="canvas-rail-section">
            <div class="canvas-rail-section-title">Annotate</div>
            <div class="canvas-rail-mode-row">
              <button type="button" class="canvas-mode-btn"
                class:active={annMode() === 'point'}
                on:click={() => setAnnMode('point')}>Point</button>
              <button type="button" class="canvas-mode-btn"
                class:active={annMode() === 'region'}
                on:click={() => setAnnMode('region')}>Region</button>
              <button type="button" class="canvas-mode-btn"
                class:active={annMode() === 'off'}
                on:click={() => setAnnMode('off')}>Off</button>
            </div>
          </div>

          <div class="canvas-rail-section canvas-rail-thread">
            <div class="canvas-rail-section-title">
              Thread <span class="canvas-rail-count">{annCount()}</span>
            </div>
            {#if annCount() === 0}
              <div class="canvas-rail-empty">No annotations queued.</div>
            {:else}
              <div class="canvas-rail-thread-items">
                {#for ann of annThread() key={ann.id}}
                  <div class="canvas-rail-thread-item">
                    <div class="canvas-rail-thread-kind">{ann.kind}</div>
                    <div class="canvas-rail-thread-note">{ann.note || '(no note)'}</div>
                  </div>
                {/for}
              </div>
            {/if}
          </div>

          <div class="canvas-rail-footer">
            <button type="button" class="canvas-btn"
              attr:disabled={annCount() === 0 ? '' : null}
              on:click={clearAnnotations}>Clear</button>
            <button type="button" class="canvas-btn canvas-btn-primary"
              attr:disabled={annCount() === 0 ? '' : null}
              on:click={sendAnnotations}>Send to agent</button>
          </div>
        </aside>
      </div>
    {/if}
  </main>

  <footer class="canvas-footer">
    <span class="canvas-footer-info">
      canvas <code>{shortId()}</code>
      {#if pairedAgentId()}<span class="canvas-footer-sep">·</span> agent <code>{pairedAgentLabel()}</code>{/if}
    </span>
    <span class="canvas-footer-info">{statusText()}</span>
  </footer>

</div>

