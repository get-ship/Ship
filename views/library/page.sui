<div class="ship-view" data-test="library-view">
  <header class="view-head">
    <sui-cluster gap="2" align="center">
      <sui-icon name="package" aria-hidden="true"></sui-icon>
      <h1>Library</h1>
      <sui-badge tone="muted" variant="outline" size="sm">scaffold</sui-badge>
    </sui-cluster>
  </header>

  <sui-empty-state icon="package" variant="default">
    <span slot="title">Explore what you have</span>
    Installed packs, the marketplace, and your authored components live here.
    Distinct from Studio (which edits primitives). Not built yet — this is the
    placeholder so the surface exists and is reachable.
  </sui-empty-state>
</div>
