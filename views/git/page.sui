<data name="overview" source="ship.git.overview()" live />

<use-kbd>
  <on key="1" action="showChanges" />
  <on key="2" action="showHistory" />
  <on key="3" action="showBranches" />
</use-kbd>

<div class="ship-view git-view">
  {#async overview}
    {:loading}
    <div class="git-skel" data-test="loading" aria-busy="true">
      <sui-skeleton shape="line" size="lg"></sui-skeleton>
      {#for n of [0, 1, 2] key={n}}
        <sui-skeleton shape="line" size="md"></sui-skeleton>
      {/for}
    </div>
  
    {:error err}
    {#if isNoRepo()}
      <div class="git-no-repo" data-test="no-repo">
        <sui-empty-state tone="muted" size="lg">
          <sui-icon slot="icon" name="git-branch" size="lg"></sui-icon>
          <span slot="title">Not a git repository</span>
          <span slot="description">{err.message}</span>
          <div slot="actions">
            <sui-button tone="primary" variant="solid" data-test="git-init"
              attr:loading={busy() === 'init' ? '' : null}
              attr:disabled={busy() === 'init' ? '' : null}
              on:click={initRepo}>
              <sui-icon slot="leading" name="plus" size="sm"></sui-icon>Initialize repository
            </sui-button>
          </div>
        </sui-empty-state>
      </div>
    {:else}
      <sui-error-state size="md" title="Couldn't load repo" data-test="error">{err.message}</sui-error-state>
    {/if}
  
    {:ok}
    {#if opError()}
      <sui-alert tone="destructive" data-test="git-op-error" dismissible on:sui-dismiss={dismissError}>
        <sui-icon slot="icon" name="alert-circle" size="sm"></sui-icon>
        {opError()}
      </sui-alert>
    {/if}
    {#if opInfo()}
      <sui-alert tone="success" data-test="git-op-info" dismissible on:sui-dismiss={dismissError}>
        <sui-icon slot="icon" name="check-circle" size="sm"></sui-icon>
        {opInfo()}
      </sui-alert>
    {/if}

    <header class="git-head">
      <div class="git-head-titles">
        <h1 class="git-title">Git</h1>
        <p class="git-sub">
          <span class="git-mono">{branch()}</span>
          {ahead() > 0 ? ' ↑' + ahead() : ''}
          {behind() > 0 ? ' ↓' + behind() : ''}
          &middot;
          <span class="git-mono">{headShort()}</span>
        </p>
      </div>
      <sui-cluster align="center">
        <sui-button variant="ghost" size="sm" data-test="git-fetch"
          attr:loading={busy() === 'fetch' ? '' : null}
          attr:disabled={busy() ? '' : null}
          on:click={fetchOrigin}>
          <sui-icon slot="leading" name="download" size="xs"></sui-icon>Fetch
        </sui-button>
        <sui-button variant="ghost" size="sm" data-test="git-pull"
          attr:loading={busy() === 'pull' ? '' : null}
          attr:disabled={busy() ? '' : null}
          on:click={pullCurrent}>
          <sui-icon slot="leading" name="arrow-down" size="xs"></sui-icon>Pull
        </sui-button>
        <sui-button variant="ghost" size="sm" data-test="git-push"
          attr:loading={busy() === 'push' ? '' : null}
          attr:disabled={busy() ? '' : null}
          on:click={pushCurrent}>
          <sui-icon slot="leading" name="arrow-up" size="xs"></sui-icon>Push
        </sui-button>
        <sui-button variant="ghost" size="sm" aria-label="Refresh" data-test="git-refresh" on:click={refresh}>
          <sui-icon name="refresh-cw" size="sm"></sui-icon>
        </sui-button>
        <sui-chip tone={clean() ? 'success' : 'warning'} variant="soft" size="sm">{clean() ? 'clean' : totalChanged() + ' changed'}</sui-chip>
      </sui-cluster>
    </header>

    <div class="git-tabs-row">
      <sui-tabs variant="underline">
        <sui-tab name="changes"  active={tab() === 'changes'}  count={totalChanged() + ''}  on:click={() => tab.set('changes')}>Changes</sui-tab>
        <sui-tab name="history"  active={tab() === 'history'}  count={commitsCount() + ''}  on:click={() => tab.set('history')}>History</sui-tab>
        <sui-tab name="branches" active={tab() === 'branches'} count={branchesCount() + ''} on:click={() => tab.set('branches')}>Branches</sui-tab>
      </sui-tabs>
      <div class="git-tabs-right">
        <sui-button variant="ghost" size="sm" on:click={() => navigate('/pipelines')}>
          <sui-icon slot="leading" name="play" size="xs"></sui-icon>Run checks
        </sui-button>
      </div>
    </div>

    <div class="git-body">
      {#if tab() === 'changes'}
        {#if clean()}
          <div class="git-clean">
            <div class="git-hero">
              <div class="git-halo"><sui-icon name="check" size="md"></sui-icon></div>
              <div>
                <h2 class="git-hero-title">Working tree is clean.</h2>
                <p class="git-hero-sub">
                  Nothing to commit on <span class="git-mono">{branch()}</span>.
                  {ahead() === 0 && behind() === 0 ? "You're up to date with the upstream." : ''}
                  {ahead() > 0 ? ahead() + ' commit' + (ahead() === 1 ? '' : 's') + ' ahead of upstream.' : ''}
                  {behind() > 0 ? ' ' + behind() + ' commit' + (behind() === 1 ? '' : 's') + ' behind upstream.' : ''}
                </p>
              </div>
            </div>

            <div class="git-two-col">
              <section class="git-sec">
                <h3>Recent on this branch</h3>
                {#if recentCommits().length === 0}<p class="git-empty">No commits yet.</p>{/if}
                {#for c of recentCommits() key={c.sha}}
                  <div class="git-row">
                    <sui-avatar size="sm" shape="round" name={c.author}></sui-avatar>
                    <div class="git-row-body">
                      <div class="git-row-title">{c.subject}</div>
                      <div class="git-row-sub">{c.short_sha} &middot; {c.author} &middot; {c.date}</div>
                    </div>
                    <div class="git-deltas">
                      <span class="git-add">+{c.additions}</span>
                      <span class="git-del">−{c.deletions}</span>
                    </div>
                  </div>
                {/for}
              </section>
              <section class="git-sec">
                <h3>Branches</h3>
                {#if recentBranches().length === 0}<p class="git-empty">No branches.</p>{/if}
                {#for b of recentBranches() key={b.name}}
                  <div class="git-row">
                    <sui-icon name="git-branch" size="xs" class={b.active ? 'git-icon-active' : 'git-icon-muted'}></sui-icon>
                    <div class="git-row-body">
                      <div class="git-row-title git-mono">{b.name}</div>
                      <div class="git-row-sub">{b.upstream ? b.upstream : 'local only'}</div>
                    </div>
                    <div class="git-deltas">
                      {b.ahead > 0 ? '↑' + b.ahead : ''}
                      {b.behind > 0 ? ' ↓' + b.behind : ''}
                    </div>
                  </div>
                {/for}
              </section>
            </div>
          </div>
        {:else}
          <div class="git-split">
            <aside class="git-left" aria-label="Changed files">
              <sui-toolbar variant="bordered" class="git-left-head">
                <sui-icon name="git-branch" size="xs"></sui-icon>
                <strong class="git-left-title">Changes</strong>
                <span slot="spacer"></span>
                <span class="git-mono">{totalChanged()} files</span>
              </sui-toolbar>
              <div class="git-bulk-row">
                <sui-button size="xs" variant="outline" data-test="git-stage-all"
                  attr:disabled={unstagedCount() === 0 || busy() ? '' : null}
                  on:click={stageAll}>
                  <sui-icon slot="leading" name="plus" size="xs"></sui-icon>Stage all
                </sui-button>
                <sui-button size="xs" variant="outline" data-test="git-unstage-all"
                  attr:disabled={stagedCount() === 0 || busy() ? '' : null}
                  on:click={unstageAll}>
                  <sui-icon slot="leading" name="minus" size="xs"></sui-icon>Unstage all
                </sui-button>
                <span class="git-bulk-spacer"></span>
                <sui-button size="xs" variant="solid" tone="primary" data-test="git-open-commit"
                  attr:disabled={!canCommit() || busy() ? '' : null}
                  on:click={openCommit}>
                  <sui-icon slot="leading" name="git-commit" size="xs"></sui-icon>Commit ({stagedCount()})
                </sui-button>
              </div>
              <div class="git-chips-row">
                {#for g of fileGroups() key={g.key}}
                  <sui-chip tone={g.tone} variant={g.variant} size="sm">{g.items.length} {g.key}</sui-chip>
                {/for}
              </div>
              <sui-scroll-area class="git-file-list">
                {#for g of fileGroups() key={g.key}}
                  <div class="git-file-group-head">{g.label}</div>
                  {#for f of g.items key={f.path}}
                    <div class="git-file-row-wrap" attr:data-active={selectedFile() === f.path ? '' : null}>
                      <button class="git-file-row git-mono" type="button"
                        data-test="git-file-row"
                        on:click={() => selectFile(f)}>
                        <span class="git-file-status">{g.glyph || f.status}</span>{f.path}
                      </button>
                      {#if g.key === 'staged'}
                        <button class="git-file-act" type="button"
                          data-test="git-unstage-file"
                          aria-label="Unstage file"
                          title="Unstage"
                          on:click={() => unstageFile(f)}>−</button>
                      {:else}
                        <button class="git-file-act" type="button"
                          data-test="git-stage-file"
                          aria-label="Stage file"
                          title="Stage"
                          on:click={() => stageFile(f)}>+</button>
                      {/if}
                    </div>
                  {/for}
                {/for}
              </sui-scroll-area>
            </aside>

            <section class="git-right" aria-label="Diff">
              {#if !selectedCommit()}
                <sui-empty-state tone="muted" size="md" class="git-diff-empty">
                  <span slot="title">Select a file</span>
                  Pick a file on the left to view its diff.
                </sui-empty-state>
              {:else if !diffReady()}
                <div class="git-diff-loading" data-test="diff-loading">Loading diff&hellip;</div>
              {:else if diffFiles().length === 0}
                <sui-empty-state tone="muted" size="md" class="git-diff-empty">
                  <span slot="title">No changes in this diff</span>
                </sui-empty-state>
              {:else}
                <sui-toolbar variant="bordered" class="git-diff-toolbar">
                  <sui-badge tone="warning" variant="soft" size="sm">diff</sui-badge>
                  <span class="git-mono git-diff-path" data-test="diff-path">{diffFiles()[0].path}</span>
                  <span slot="spacer"></span>
                  <span class="git-mono"><span class="git-add">+{diffFiles()[0].additions}</span> <span class="git-del">−{diffFiles()[0].deletions}</span></span>
                  <sui-segmented value={diffMode()} size="sm" on:sui-change={(e) => setDiffMode(e.detail.value)}>
                    <sui-segmented-option value="unified">Unified</sui-segmented-option>
                    <sui-segmented-option value="split">Split</sui-segmented-option>
                  </sui-segmented>
                </sui-toolbar>
                {#if diffIsWorking()}
                  <sui-alert tone="muted" class="git-diff-banner"><sui-icon slot="icon" name="git-commit" size="xs"></sui-icon>Viewing working tree changes vs HEAD.</sui-alert>
                {/if}
                <sui-scroll-area class="git-diff-scroll" data-test="diff-body">
                  {#for file of diffFiles() key={file.path}}
                    <sui-git-diff files="1">
                      <sui-git-diff-file path={file.path}
                        additions={file.additions + ''}
                        deletions={file.deletions + ''}>
                        {#for hunk of file.hunks key={hunk.header}}
                          <sui-git-diff-hunk header={hunk.header}></sui-git-diff-hunk>
                          {#for line of hunk.lines key={(line.old_num || 0) + ':' + (line.new_num || 0)}}
                            <sui-git-diff-line
                              type={line.kind}
                              attr:old={line.old_num ? (line.old_num + '') : null}
                              attr:new={line.new_num ? (line.new_num + '') : null}>{line.content}</sui-git-diff-line>
                          {/for}
                        {/for}
                      </sui-git-diff-file>
                    </sui-git-diff>
                  {/for}
                </sui-scroll-area>
              {/if}
            </section>
          </div>
        {/if}
      {/if}

      {#if tab() === 'history'}
        <div class="git-history">
          <sui-cluster align="center">
            <input class="git-search" placeholder="Filter by subject, sha, or author"
              bind:value={commitFilter.query} />
            <span class="git-history-count">{commitFilter.filtered().length} of {commitsCount()}</span>
          </sui-cluster>
          {#if commitFilter.filtered().length === 0}
            <sui-empty-state tone="muted" size="md">
              {#if commitsCount() === 0}
                <span slot="title">No commits</span>
              {:else}
                <span slot="title">No matching commits</span>
              {/if}
            </sui-empty-state>
          {:else}
            <div class="git-history-rows" data-test="history-rows">
              {#for c of commitFilter.filtered() key={c.sha}}
                <sui-history-row
                  sha={c.short_sha}
                  subject={c.subject}
                  author={c.author}
                  timestamp={c.date}
                  additions={c.additions + ''}
                  deletions={c.deletions + ''}
                  on:sui-select={() => selectCommit(c.sha)}>
                </sui-history-row>
              {/for}
            </div>
          {/if}
        </div>
      {/if}

      {#if tab() === 'branches'}
        <div class="git-branches">
        <div class="git-branches-actions">
          <sui-button size="sm" variant="solid" tone="primary" data-test="git-open-branch-create"
            attr:disabled={busy() ? '' : null}
            on:click={openBranchCreate}>
            <sui-icon slot="leading" name="plus" size="xs"></sui-icon>New branch
          </sui-button>
        </div>
        {#if branches().length === 0}
          <sui-empty-state tone="muted" size="md">
            <span slot="title">No branches</span>
          </sui-empty-state>
        {:else}
          <div class="git-branches-split">
            <aside class="git-bleft" aria-label="Branches">
              <sui-scroll-area class="git-branches-rail">
                {#for b of branches() key={b.name}}
                  <sui-list-tile interactive density="compact"
                    data-test="git-branch-tile"
                    attr:tone={b.active ? 'accent' : null}
                    attr:selected={activeBranchName() === b.name ? '' : null}
                    on:sui-select={() => selectBranch(b.name)}>
                    <sui-status-dot slot="leading"
                      attr:tone={b.active ? 'success' : 'muted'}
                      attr:pulse={b.active ? '' : null}></sui-status-dot>
                    <span class="git-mono git-branch-name">{b.name}</span>
                    <span slot="meta">{b.upstream ? b.upstream : 'local only'}</span>
                    <span slot="trailing" class="git-mono git-branch-deltas">
                      {b.ahead > 0 ? '↑' + b.ahead : ''}
                      {b.behind > 0 ? ' ↓' + b.behind : ''}
                    </span>
                  </sui-list-tile>
                {/for}
              </sui-scroll-area>
            </aside>
            <section class="git-bright" aria-label="Branch detail">
              {#if activeBranch()}
                <div class="git-branch-detail" data-test="git-branch-detail">
                  <sui-toolbar justify="between" class="git-branch-head">
                    <div>
                      <div class="git-mono git-branch-detail-name">{activeBranch().name}</div>
                      <div class="git-branch-detail-sub">
                        {activeBranch().upstream ? 'tracking ' + activeBranch().upstream : 'no upstream'}
                      </div>
                    </div>
                    <sui-toolbar>
                      {#if !activeBranch().active}
                        <sui-button size="sm" variant="solid" tone="primary" data-test="git-checkout"
                          attr:loading={busy() === 'checkout' ? '' : null}
                          attr:disabled={busy() ? '' : null}
                          on:click={() => checkoutBranch(activeBranch().name)}>
                          <sui-icon slot="leading" name="git-branch" size="xs"></sui-icon>Checkout
                        </sui-button>
                        <sui-button size="sm" variant="ghost" tone="destructive" data-test="git-delete-branch"
                          attr:disabled={busy() ? '' : null}
                          on:click={() => openBranchDelete(activeBranch().name)}>
                          <sui-icon slot="leading" name="trash" size="xs"></sui-icon>Delete
                        </sui-button>
                      {/if}
                    </sui-toolbar>
                  </sui-toolbar>
                  <div class="git-branch-grid">
                    <sui-card>
                      <div slot="header" class="git-card-head">Status</div>
                      <sui-metachip label="Head" value={activeBranch().name}></sui-metachip>
                      {#if activeBranch().upstream}
                        <sui-metachip label="Upstream" value={activeBranch().upstream}></sui-metachip>
                      {/if}
                      <sui-metachip label="Divergence"
                        value={'↑' + activeBranch().ahead + ' ↓' + activeBranch().behind}></sui-metachip>
                    </sui-card>
                    <sui-card>
                      <div slot="header" class="git-card-head">Actions</div>
                      <sui-button variant="ghost" size="sm" on:click={pullCurrent}
                        attr:loading={busy() === 'pull' ? '' : null}
                        attr:disabled={busy() ? '' : null}>
                        <sui-icon slot="leading" name="arrow-down" size="xs"></sui-icon>Pull latest
                      </sui-button>
                      <sui-button variant="ghost" size="sm" on:click={pushCurrent}
                        attr:loading={busy() === 'push' ? '' : null}
                        attr:disabled={busy() ? '' : null}>
                        <sui-icon slot="leading" name="arrow-up" size="xs"></sui-icon>Push changes
                      </sui-button>
                      <sui-button variant="ghost" size="sm" on:click={fetchOrigin}
                        attr:loading={busy() === 'fetch' ? '' : null}
                        attr:disabled={busy() ? '' : null}>
                        <sui-icon slot="leading" name="download" size="xs"></sui-icon>Fetch
                      </sui-button>
                    </sui-card>
                  </div>
                </div>
              {/if}
            </section>
          </div>
        {/if}
        </div>
      {/if}
    </div>

    <!-- Commit dialog -->
    <sui-dialog prop:open={commitOpen()} size="md" on:sui-close={closeCommit} data-test="git-commit-dialog">
      <span slot="header">Commit ({stagedCount()} staged)</span>
      <sui-field label="Subject" hint="One line, imperative mood.">
        <sui-input bind:value={commitSubject} placeholder="fix: …" autofocus></sui-input>
      </sui-field>
      <sui-field label="Body" hint="Optional. Explain the why, not the what.">
        <sui-textarea bind:value={commitBody} rows="6" placeholder="Optional description…"></sui-textarea>
      </sui-field>
      {#if commitError()}<sui-alert tone="destructive" compact>{commitError()}</sui-alert>{/if}
      <sui-toolbar slot="footer">
        <sui-button variant="outline" on:click={closeCommit}>Cancel</sui-button>
        <sui-button tone="primary" variant="solid" data-test="git-commit-submit"
          attr:loading={busy() === 'commit' ? '' : null}
          attr:disabled={busy() === 'commit' ? '' : null}
          on:click={submitCommit}>
          <sui-icon slot="leading" name="git-commit" size="sm"></sui-icon>Commit
        </sui-button>
      </sui-toolbar>
    </sui-dialog>

    <!-- Branch create dialog -->
    <sui-dialog prop:open={branchCreateOpen()} size="sm" on:sui-close={closeBranchCreate} data-test="git-branch-create-dialog">
      <span slot="header">New branch</span>
      <sui-field label="Name" hint="Created from current HEAD.">
        <sui-input bind:value={branchCreateName} placeholder="feature/my-branch" autofocus></sui-input>
      </sui-field>
      <sui-field>
        <sui-checkbox bind:checked={branchCreateCheckout}>Switch to this branch after creating</sui-checkbox>
      </sui-field>
      {#if branchCreateError()}<sui-alert tone="destructive" compact>{branchCreateError()}</sui-alert>{/if}
      <sui-toolbar slot="footer">
        <sui-button variant="outline" on:click={closeBranchCreate}>Cancel</sui-button>
        <sui-button tone="primary" variant="solid" data-test="git-branch-create-submit"
          attr:loading={busy() === 'branch create' ? '' : null}
          attr:disabled={busy() === 'branch create' ? '' : null}
          on:click={submitBranchCreate}>Create</sui-button>
      </sui-toolbar>
    </sui-dialog>

    <!-- Branch delete confirm dialog -->
    <sui-dialog prop:open={branchDeleteOpen()} size="sm" on:sui-close={closeBranchDelete} data-test="git-branch-delete-dialog">
      <span slot="header">Delete branch</span>
      <p class="git-confirm-msg">Delete <span class="git-mono">{branchDeleteTarget()}</span>? This cannot be undone.</p>
      <sui-field>
        <sui-checkbox bind:checked={branchDeleteForce}>Force-delete even if unmerged</sui-checkbox>
      </sui-field>
      {#if branchDeleteError()}<sui-alert tone="destructive" compact>{branchDeleteError()}</sui-alert>{/if}
      <sui-toolbar slot="footer">
        <sui-button variant="outline" on:click={closeBranchDelete}>Cancel</sui-button>
        <sui-button tone="destructive" variant="solid" data-test="git-branch-delete-submit"
          attr:loading={busy() === 'branch delete' ? '' : null}
          attr:disabled={busy() === 'branch delete' ? '' : null}
          on:click={submitBranchDelete}>Delete</sui-button>
      </sui-toolbar>
    </sui-dialog>
  
  {/async}
</div>
