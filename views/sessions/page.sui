<data name="sessions" source="ship.sessions.list()" live />

<div class="ship-view ship-view-sessions">
  <div class="ses-wrap">

    <header class="ses-head">
      <div class="ses-head-titles">
        <h1 class="ses-title">Sessions</h1>
        <p class="ses-sub">{total()} live session{total() === 1 ? '' : 's'}</p>
      </div>
      <sui-button tone="primary" variant="solid"
        prop:disabled={spawning()}
        on:click={spawnShell}>
        <sui-icon slot="leading" name="plus"></sui-icon>
        {spawning() ? 'Spawning…' : 'New shell session'}
      </sui-button>
    </header>

    {#if mutationError()}
      <sui-error-state variant="inline" size="sm" title="Session operation failed" data-test="mutation-error">
        {mutationError()}
        <sui-button slot="action" size="sm" variant="outline"
          on:click={() => mutationError.set('')}>Dismiss</sui-button>
      </sui-error-state>
    {/if}

    {#while-loading of sessions}
      <ul class="ses-list" data-test="loading" aria-label="Loading sessions">
        {#for n of [0,1,2,3] key={n}}
          <li class="ses-skel-row" aria-hidden="true">
            <div class="ses-skel-main">
              <sui-skeleton shape="circle" size="sm"></sui-skeleton>
              <sui-skeleton shape="line" size="sm" style="width:64px"></sui-skeleton>
              <sui-skeleton shape="line" size="sm" style="width:200px"></sui-skeleton>
            </div>
            <sui-skeleton shape="line" size="sm" style="width:56px"></sui-skeleton>
          </li>
        {/for}
      </ul>
    {/while-loading}

    {#while-error err of sessions}
      <sui-error-state title="Couldn't load sessions" data-test="error">
        {err.message}
        <sui-button slot="action" tone="primary" variant="solid"
          on:click={() => window.location.reload()}>Retry</sui-button>
      </sui-error-state>
    {/while-error}

    {#if sessions().kind === 'ok'}
      {#if items().length === 0}
        <sui-empty-state variant="default" size="sm" data-test="empty">
          <sui-icon slot="icon" name="terminal"></sui-icon>
          <span slot="title">No sessions running</span>
          Spawn a shell or start an agent chat to populate this list.
          <sui-button slot="action" tone="primary" variant="solid"
            prop:disabled={spawning()}
            on:click={spawnShell}>
            <sui-icon slot="leading" name="plus"></sui-icon>
            New shell session
          </sui-button>
        </sui-empty-state>
      {:else}
        <ul class="ses-list" data-test="list" data-view-enter>
          {#for s of items() key={s.id}}
            <li class="ses-row" data-test="row" data-status={s.status}>
              <div class="ses-row-main">
                <sui-status-dot
                  prop:tone={s.status === 'running' ? 'success' : s.status === 'exited' ? 'muted' : 'warning'}
                  size="sm"
                  label={s.status}></sui-status-dot>
                <span class="ses-row-kind">{s.kind}</span>
                <span class="ses-row-id" attr:title={s.id}>{s.id}</span>
                {#if s.agent_id}<sui-chip tone="primary" variant="soft" size="sm">{s.agent_id}</sui-chip>{/if}
                {#if s.provider}<sui-chip tone="muted" variant="outline" size="sm">{s.provider}</sui-chip>{/if}
              </div>
              <div class="ses-row-meta">
                <span class="ses-row-status">{s.status}</span>
                <sui-button size="sm" variant="outline"
                  aria-label={'End session ' + s.id}
                  prop:disabled={endingId() === s.id || s.status === 'exited'}
                  on:click={() => endSession(s.id)}>
                  {endingId() === s.id ? 'Ending…' : 'End'}
                </sui-button>
              </div>
            </li>
          {/for}
        </ul>
      {/if}
    {/if}
  </div>
</div>
