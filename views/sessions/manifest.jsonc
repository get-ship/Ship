// Route metadata for views/sessions/. Live PTY-session registry +
// start/end controls — first surface that calls the typed mutation
// path through `ship.sessions.{start,end}()`.
{
  "name": "sessions",
  "path": "/sessions",
  "title": "Sessions",
  "layout": "default",
  "auth": "user",
  "rail": {
    "label": "Sessions",
    "icon": "terminal"
  },
  "events": ["session.started", "session.ended", "session.attached"]
}
