{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [],
    // `views/` is not a workspace member (root package.json doesn't
    // include it in `workspaces.packages`), so tsc walking up from
    // a controller's import never finds `@ship/sui-runtime` in the
    // root node_modules. Map the package names to their on-disk
    // entries directly so tsc resolves the imports.
    "paths": {
      // `@ship/sui-runtime*` + `@ship/sui-dom*` aliases now point at the
      // external sui repo (post-carve). TEMP — relativized to `../sui/...`
      // in the layout-reshuffle capstone.
      "@ship/sui-runtime": ["/home/madvib/dev/sui/packages/sui/runtime/src/index.ts"],
      "@ship/sui-runtime/*": ["/home/madvib/dev/sui/packages/sui/runtime/src/*"],
      "@ship/sui-dom/test-utils": ["/home/madvib/dev/sui/packages/sui/dom/src/test-utils/index.ts"],
      "@ship/sui-dom/test-utils/*": ["/home/madvib/dev/sui/packages/sui/dom/src/test-utils/*"],
      "@ship/sdk-client": ["../packages/sdk-client/src/index.ts"],
      "@ship/sdk-client/*": ["../packages/sdk-client/src/*"],
      "@ship/sdk": ["../packages/sdk/src/index.ts"],
      "@ship/sdk/*": ["../packages/sdk/src/*"],
    },
    // Controllers do `import type { Scope } from './page.sui'`. The
    // sui-compiler emits `page.sui.d.ts` into the project mirror tree
    // at `<repo-root>/.ship/sui-out/views/<name>/`. `rootDirs` lets tsc
    // treat the source tree and its mirror as a single virtual root for
    // relative module resolution.
    "rootDirs": [".", "../.ship/sui-out/views"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
