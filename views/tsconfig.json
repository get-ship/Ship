{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [],
    // Controllers do `import type { Scope } from './page.sui'`. The
    // sui-compiler emits `page.sui.d.ts` into the project mirror tree
    // at `<repo-root>/.ship/sui-out/views/<name>/`. `rootDirs` lets tsc
    // treat the source tree and its mirror as a single virtual root for
    // relative module resolution.
    "rootDirs": [".", "../.ship/sui-out/views"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
