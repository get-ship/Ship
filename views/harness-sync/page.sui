<data name="dash" source="ship.dashboard.state()" live />
<data name="git"  source="ship.git.overview()" live />

<div class="ship-view hs-view">
  <header class="hs-head">
    <a class="hs-back" href="/harness" on:click={(e) => goNav(e, '/harness')} aria-label="Back to harness">
      <sui-icon name="chevron-left" size="14"></sui-icon> Harness
    </a>
    <h1 class="hs-title">Sync</h1>
    <div class="hs-head-actions">
      <sui-badge tone="muted" variant="soft" size="sm" data-test="hs-patches">{totalPatches()} patches</sui-badge>
      <sui-button size="sm" variant="ghost" on:click={resetCounters}>Reset counters</sui-button>
    </div>
  </header>

  <section class="hs-banner">
    <p class="hs-banner-text">
      Subscribes to three real shipd live sources. Each tile lights up on patch arrival.
      Watch the events stream to verify SSE round-trips. Open another tab and make changes (e.g. <code>just seed</code>) to see patches.
    </p>
  </section>

  <div class="hs-grid">

    <article class="hs-tile" attr:data-fresh={dashFresh() ? '1' : '0'}>
      <header class="hs-tile-head">
        <h2 class="hs-tile-title">ship.dashboard.state()</h2>
        <span class="hs-tile-state" attr:data-kind={dashKind()}>{dashKind()}</span>
      </header>
      <div class="hs-tile-stat">
        <div class="hs-stat-row"><span>Jobs</span><strong>{dashJobs()}</strong></div>
        <div class="hs-stat-row"><span>Agents</span><strong>{dashAgents()}</strong></div>
        <div class="hs-stat-row"><span>Events total</span><strong>{dashEvents()}</strong></div>
      </div>
      <footer class="hs-tile-foot">
        <span class="hs-meta">patches: <strong>{dashPatches()}</strong></span>
        <span class="hs-meta">last: <strong>{dashLastLabel()}</strong></span>
      </footer>
    </article>

    <article class="hs-tile" attr:data-fresh={gitFresh() ? '1' : '0'}>
      <header class="hs-tile-head">
        <h2 class="hs-tile-title">ship.git.overview()</h2>
        <span class="hs-tile-state" attr:data-kind={gitKind()}>{gitKind()}</span>
      </header>
      <div class="hs-tile-stat">
        <div class="hs-stat-row"><span>Branch</span><strong class="hs-mono">{gitBranch()}</strong></div>
        <div class="hs-stat-row"><span>HEAD</span><strong class="hs-mono">{gitHead()}</strong></div>
        <div class="hs-stat-row"><span>Status</span><strong>{gitStatus()}</strong></div>
      </div>
      <footer class="hs-tile-foot">
        <span class="hs-meta">patches: <strong>{gitPatches()}</strong></span>
        <span class="hs-meta">last: <strong>{gitLastLabel()}</strong></span>
      </footer>
    </article>

    <article class="hs-tile hs-tile--wide" attr:data-fresh={evsFresh() ? '1' : '0'}>
      <header class="hs-tile-head">
        <h2 class="hs-tile-title">ship.events.list({'{ limit: 30 }'})</h2>
        <span class="hs-tile-state" attr:data-kind={evsKind()}>{evsKind()}</span>
      </header>
      <ol class="hs-events">
        {#for row of recentEvents() key={row.key}}
          <li class="hs-event" in:fade={{ duration: 120 }}>
            <span class="hs-event-ts">{row.timestamp}</span>
            <span class="hs-event-type">{row.event_type}</span>
            <span class="hs-event-actor">{row.actor || '—'}</span>
          </li>
        {/for}
        {#if recentEvents().length === 0}
          <li class="hs-event-empty">no events yet</li>
        {/if}
      </ol>
      <footer class="hs-tile-foot">
        <span class="hs-meta">patches: <strong>{evsPatches()}</strong></span>
        <span class="hs-meta">last: <strong>{evsLastLabel()}</strong></span>
      </footer>
    </article>

  </div>

  <section class="hs-explainer">
    <h3 class="hs-explainer-title">What this exercises</h3>
    <ul class="hs-explainer-list">
      <li>Three concurrent SSE channels through the same view scope.</li>
      <li>Patch counters per channel (effect tracking off the LiveSignal).</li>
      <li>Visual "fresh" pulse on each tile to make patch cadence visible.</li>
      <li>Asymmetric enter animations on the events list (newest items fade in).</li>
    </ul>
  </section>

</div>
