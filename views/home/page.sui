<data name="dash" source="ship.dashboard.state()" live />
<data name="git" source="ship.git.overview()" live />

<div class="ship-view home-view">
  <div class="home-wrap">

    <header class="home-head">
      <sui-cluster gap="3" align="center" class="home-wordmark">
        <sui-app-icon class="home-logo" name="dashboard" variant="solid"
          size="lg" radius="md" aria-hidden="true"></sui-app-icon>
        <div>
          <h1 class="home-title" data-test="home-title">SHIP</h1>
          <p class="home-workspace" data-test="home-workspace">{workspaceLabel()}</p>
        </div>
      </sui-cluster>
      <sui-cluster gap="2" align="center" class="home-head-side">
        <div class="home-live-badge" role="status" aria-label="Live updates active">
          <span class="home-live-dot"></span>live
        </div>
      </sui-cluster>
    </header>

    {#async dash}
      {:loading}
      <div class="home-stats" data-test="home-loading" aria-busy="true" aria-label="Loading workspace">
        {#for n of [0, 1, 2, 3] key={n}}
          <sui-skeleton shape="block" size="md"></sui-skeleton>
        {/for}
      </div>
    
      {:error err}
      <sui-error-state title="Couldn't load workspace" data-test="home-error" role="alert" aria-live="assertive">
        {err.message}
        <sui-button slot="action" tone="primary" variant="solid" on:click={() => window.location.reload()}>Retry</sui-button>
      </sui-error-state>
    
      {:ok}
      {#if isFirstRun()}
        <sui-empty-state icon="sparkles" variant="default" size="lg"
          data-test="home-empty" role="status" class="home-empty">
          <span slot="title">Welcome to Ship</span>
          This workspace is empty. Start by adding an agent or scaffolding a view —
          everything else fills in as you work.
          <sui-cluster slot="action" gap="2" justify="center" class="home-empty-actions">
            <sui-button tone="primary" variant="solid" on:click={() => navigate('/agents/create')} data-test="home-empty-agent">
              <sui-icon slot="leading" name="user-plus"></sui-icon>
              Add an agent
            </sui-button>
            <sui-button variant="outline" on:click={() => navigate('/skills')} data-test="home-empty-skill">
              <sui-icon slot="leading" name="book"></sui-icon>
              Browse skills
            </sui-button>
            <sui-button variant="ghost" on:click={() => navigate('/ship-ui-studio')} data-test="home-empty-studio">
              <sui-icon slot="leading" name="sparkles"></sui-icon>
              Open Studio
            </sui-button>
          </sui-cluster>
        </sui-empty-state>
      {:else}
        <div class="home-stats" role="list" aria-label="Workspace statistics" data-test="home-stats" data-view-enter>
          <div class="home-stat-wrap home-stat-wrap--jobs" role="listitem">
            <sui-stat>
              <span slot="label">Jobs</span>
              {totalJobs()}
              <span slot="hint">{activeJobs()} active</span>
            </sui-stat>
          </div>
          <div class="home-stat-wrap home-stat-wrap--agents" role="listitem">
            <sui-stat>
              <span slot="label">Agents</span>
              {agentCount()}
              <span slot="hint">configured</span>
            </sui-stat>
          </div>
          <div class="home-stat-wrap home-stat-wrap--events" role="listitem">
            <sui-stat>
              <span slot="label">Events</span>
              {totalEvents()}
              <span slot="hint">in stream</span>
            </sui-stat>
          </div>
          <div class="home-stat-wrap home-stat-wrap--collections" role="listitem">
            <sui-stat>
              <span slot="label">Collections</span>
              {collectionsCount()}
              <span slot="hint">schemas defined</span>
            </sui-stat>
          </div>
        </div>

        <div class="home-body">

          <sui-card padding="none" class="home-section home-body--wide" aria-label="Project at-a-glance" data-test="home-glance">
            <div slot="header" class="home-section-head">
              <h2 class="home-section-title">
                <sui-icon class="home-section-icon" name="git-branch" aria-hidden="true"></sui-icon>
                Project at-a-glance
              </h2>
              <a class="home-section-link" href="/git" on:click={(e) => goNav(e, '/git')}>
                Git view <sui-icon name="chevron-right" size="xs" aria-hidden="true"></sui-icon>
              </a>
            </div>
            <div class="home-glance">
              {#async git}
                {:loading}
                <span class="home-glance-skel" data-test="git-loading">Loading git status&hellip;</span>
              
                {:error err}
                <span class="home-glance-err" data-test="git-error">Git stream offline: {err.message}</span>
              
                {:ok}
                <span class="home-glance-line" data-test="git-summary">
                  <span class="home-glance-dot" data-clean={isClean() ? '1' : '0'} aria-hidden="true"></span>
                  <span>Branch <strong class="home-mono" data-test="git-branch">{branchName()}</strong></span>
                  <span class="home-glance-sep">&middot;</span>
                  <span class="home-mono" data-test="git-head">{headShort()}</span>
                  <span class="home-glance-sep">&middot;</span>
                  <span data-test="git-status">{isClean() ? 'clean' : changedSummary()}</span>
                </span>
              
              {/async}
            </div>
          </sui-card>

          <sui-card padding="none" class="home-section" aria-label="Recent jobs" data-test="home-jobs">
            <div slot="header" class="home-section-head">
              <h2 class="home-section-title">
                <sui-icon class="home-section-icon" name="workflow" aria-hidden="true"></sui-icon>
                Recent jobs
              </h2>
              <a class="home-section-link" href="/pipelines" on:click={(e) => goNav(e, '/pipelines')}>
                View all <sui-icon name="chevron-right" size="xs" aria-hidden="true"></sui-icon>
              </a>
            </div>
            <sui-stack>
              {#if recentJobs().length > 0}
                {#for run of recentJobs() key={run.id}}
                  <sui-list-tile density="compact" class="home-job-tile" data-test="home-job">
                    <sui-status-dot slot="leading" prop:tone={run.tone ?? 'muted'}></sui-status-dot>
                    <span class="home-job-name">{run.slug ?? run.id}</span>
                    <span slot="trailing" class="home-job-trailing">
                      {#if run.agent}
                        <sui-avatar size="sm" attr:name={run.agent}
                          attr:initials={run.agent.slice(0, 1).toUpperCase()}></sui-avatar>
                        <span class="home-job-agent">{run.agent}</span>
                      {:else}
                        <span class="home-job-agent">&mdash;</span>
                      {/if}
                      {#if run.started_at ?? run.created_at}
                        <sui-timestamp prop:value={run.started_at ?? run.created_at} class="home-job-time"></sui-timestamp>
                      {/if}
                    </span>
                  </sui-list-tile>
                {/for}
              {:else}
                <sui-empty-state variant="placeholder" size="sm" icon="play" data-test="home-jobs-empty">
                  <span slot="title">No jobs yet</span>
                  Start a workflow to see runs here.
                </sui-empty-state>
              {/if}
            </sui-stack>
          </sui-card>

          <sui-card padding="none" class="home-section" aria-label="Agents" data-test="home-agents">
            <div slot="header" class="home-section-head">
              <h2 class="home-section-title">
                <sui-icon class="home-section-icon" name="users" aria-hidden="true"></sui-icon>
                Agents
                <sui-badge tone="muted" variant="soft" size="sm">{agentCount()}</sui-badge>
              </h2>
              <a class="home-section-link" href="/agents" on:click={(e) => goNav(e, '/agents')}>
                Manage <sui-icon name="chevron-right" size="xs" aria-hidden="true"></sui-icon>
              </a>
            </div>
            <div class="home-section-body">
              {#if agentSlice().length > 0}
                <div class="home-agents-grid" data-view-enter>
                  {#for agent of agentSlice() key={agent.id}}
                    <sui-list-tile variant="card" density="compact" interactive
                      navigable={'/agents/' + agent.id}
                      class="home-agent-tile" data-test="home-agent">
                      <sui-avatar slot="leading" size="md" shape="square"
                        attr:name={agent.name ?? agent.id}
                        attr:initials={agent.initials}></sui-avatar>
                      <div class="home-agent-body">
                        <span class="home-agent-name">{agent.name ?? agent.id}</span>
                        {#if agent.description}
                          <p class="home-agent-desc">{agent.description}</p>
                        {/if}
                      </div>
                    </sui-list-tile>
                  {/for}
                </div>
              {:else}
                <sui-empty-state variant="placeholder" size="sm" icon="user-plus" data-test="home-agents-empty">
                  <span slot="title">No agents configured</span>
                  <sui-button slot="action" size="sm" tone="primary" variant="solid" on:click={() => navigate('/agents/create')}>
                    <sui-icon slot="leading" name="plus"></sui-icon>
                    Add an agent
                  </sui-button>
                </sui-empty-state>
              {/if}
            </div>
          </sui-card>

          <sui-card padding="none" class="home-section home-body--wide" aria-label="Recent activity" data-test="home-activity">
            <div slot="header" class="home-section-head">
              <h2 class="home-section-title">
                <sui-icon class="home-section-icon" name="activity" aria-hidden="true"></sui-icon>
                Recent activity
                <sui-badge tone="muted" variant="soft" size="sm">{recentEvents().length}</sui-badge>
              </h2>
              <a class="home-section-link" href="/events" on:click={(e) => goNav(e, '/events')}>
                Full stream <sui-icon name="chevron-right" size="xs" aria-hidden="true"></sui-icon>
              </a>
            </div>
            <div class="home-section-body">
              {#if recentEvents().length > 0}
                <ol class="home-activity-stream" data-view-enter>
                  {#for r of recentEvents() key={r.id ?? r.timestamp}}
                    <li class="home-activity-row" data-test="home-activity-row">
                      <span class="home-activity-rail" aria-hidden="true"></span>
                      <span class="home-event-ts">{r.timestamp}</span>
                      <span class="home-event-type">{r.event_type}</span>
                      <span class="home-event-actor">
                        {#if r.actor}
                          <sui-avatar size="sm" attr:name={r.actor}
                            attr:initials={r.actor.slice(0, 1).toUpperCase()}></sui-avatar>
                          <span>{r.actor}</span>
                        {:else}
                          <span>&mdash;</span>
                        {/if}
                      </span>
                    </li>
                  {/for}
                </ol>
              {:else}
                <sui-empty-state variant="placeholder" size="sm" icon="activity" data-test="home-activity-empty">
                  <span slot="title">Waiting for activity</span>
                  The stream will fill as the daemon emits events.
                </sui-empty-state>
              {/if}
            </div>
          </sui-card>

          <sui-card padding="none" class="home-section home-body--wide" aria-label="Quick links" data-test="home-links">
            <div slot="header" class="home-section-head">
              <h2 class="home-section-title">
                <sui-icon class="home-section-icon" name="external-link" aria-hidden="true"></sui-icon>
                Quick links
              </h2>
            </div>
            <div class="home-links">
              {#for link of quickLinks() key={link.href}}
                <a class="home-link-btn" href={link.href} on:click={(e) => goNav(e, link.href)}
                  data-test="home-link" attr:data-link={link.key}>
                  <div class="home-link-icon" attr:data-tone={link.key} aria-hidden="true">
                    <sui-icon name={link.icon}></sui-icon>
                  </div>{link.label}
                </a>
              {/for}
            </div>
          </sui-card>

        </div>
      {/if}
    
    {/async}

  </div>
</div>
