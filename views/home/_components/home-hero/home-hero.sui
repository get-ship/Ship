<!--
  home-hero — view-private widget for the home page.

  Tag prefix matches the parent view name ("home-") so the runtime can register
  it without colliding with any other view's _components/ tree. Not exported
  outside views/home/.
-->

<prop name="title" type="string" default="" />
<prop name="tone" values="default|accent" default="default" reflect />

<style>
  :host { display: block; }
  .hero {
    padding: 1.5rem 1.75rem;
    border-radius: 0.75rem;
    background: var(--surface-1, #f6f8fa);
    border: 1px solid var(--border, #d0d7de);
  }
  :host([tone='accent']) .hero {
    background: var(--accent, #0969da);
    color: var(--accent-foreground, #fff);
    border-color: transparent;
  }
  .hero h1 {
    margin: 0 0 0.25rem;
    font-family: var(--heading-font);
    font-size: var(--text-2xl);
    font-weight: var(--heading-weight);
    line-height: 32px;
    letter-spacing: var(--heading-tracking);
  }
  .hero p { margin: 0; opacity: 0.85; }
</style>

<div class="hero" part="hero">
  <h1>{title}</h1>
  <p><slot>Build views with the page.sui convention.</slot></p>
</div>
