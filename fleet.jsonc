// fleet.jsonc — include org source (ship-meta) for shared rules/agents/skills/mcp
//
// Sibling layout (default under ~/dev/Ship/<repo>): relative include works.
// Job worktrees live at ~/dev/Ship/worktrees/<repo>/<slug> — from there
// `../ship-meta` does NOT resolve. Use env expansion instead, e.g.:
//   "include": ["$SHIP_META"]
// with SHIP_META=/home/.../Ship/ship-meta (or absolute path). See
// ship-meta/RULES.md "Polyrepo pattern".
{
  "include": ["../ship-meta"]
}
