{
  "name": "view-session-e2e",
  "description": "End-to-end validation of the Phase 1 agent-canvas-views framework. Exercises open → subscribe → patch → receive → close through the daemon's REST surface. Shell steps call the daemon directly via curl because the pipeline runner does not yet understand a first-class `tool:` step kind.\n\nRequired env: SHIP_DAEMON_TOKEN (bearer token for the daemon REST API). Optional env: SHIP_DAEMON_URL (default http://127.0.0.1:9315); SHIP_MISSION_SCRATCH (when set, the per-run scratch dir — else the working directory).\n\nRun with `ship pipelines run view-session-e2e` while the daemon is up.",
  "steps": [
    {
      "run": "set -euo pipefail\n: \"${SHIP_DAEMON_TOKEN:?SHIP_DAEMON_TOKEN must be set}\"\nurl=\"${SHIP_DAEMON_URL:-http://127.0.0.1:9315}\"\n# Evidence lives in the mission scratch when one is in scope — same\n# rule as web-qa / diff-review (c-2026-07-05T18-10 et al.). Falling back\n# to cwd when no mission scratch is set is fine for local-dev runs.\n: \"${SHIP_MISSION_SCRATCH:=$(pwd)}\"\n\nresp=$(curl -fsS -X POST \"$url/api/view-sessions\" \\\n  -H \"Authorization: Bearer $SHIP_DAEMON_TOKEN\" \\\n  -H \"x-ship-agent-id: pipeline.e2e\" \\\n  -H \"content-type: application/json\" \\\n  -d '{\"template\":\"canvas/blank\",\"title\":\"e2e\"}')\necho \"$resp\" | tee \"$SHIP_MISSION_SCRATCH/view-session-open.json\"\nview_id=$(echo \"$resp\" | sed -n 's/.*\"view_id\":\"\\([^\"]*\\)\".*/\\1/p')\ntest -n \"$view_id\" || { echo \"open: no view_id in response\"; exit 1; }\necho \"$resp\" | grep -q 'ui://ship/view-session/' \\\n  || { echo \"open: _meta.ui.resourceUri missing\"; exit 1; }\necho \"$view_id\" > \"$SHIP_MISSION_SCRATCH/view-session-id\"\n"
    },
    {
      "run": "set -euo pipefail\n: \"${SHIP_DAEMON_TOKEN:?SHIP_DAEMON_TOKEN must be set}\"\nurl=\"${SHIP_DAEMON_URL:-http://127.0.0.1:9315}\"\n: \"${SHIP_MISSION_SCRATCH:=$(pwd)}\"\nview_id=$(cat \"$SHIP_MISSION_SCRATCH/view-session-id\")\n\n# Subscribe in the background, capture SSE body, look for the beacon.\n( timeout 5 curl -sS -N \"$url/api/view-sessions/$view_id\" \\\n    -H \"Authorization: Bearer $SHIP_DAEMON_TOKEN\" \\\n    -H \"x-ship-agent-id: pipeline.e2e\" \\\n    > \"$SHIP_MISSION_SCRATCH/view-session-sse.log\" ) &\nsub_pid=$!\nsleep 1\n\ncurl -fsS -X POST \"$url/api/view-sessions/$view_id/patch\" \\\n  -H \"Authorization: Bearer $SHIP_DAEMON_TOKEN\" \\\n  -H \"x-ship-agent-id: pipeline.e2e\" \\\n  -H \"content-type: application/json\" \\\n  -d '{\"selector\":\"#root\",\"html\":\"<p>beacon-e2e-ok</p>\"}'\n\n# Le…\n"
    },
    {
      "run": "set -euo pipefail\n: \"${SHIP_DAEMON_TOKEN:?SHIP_DAEMON_TOKEN must be set}\"\nurl=\"${SHIP_DAEMON_URL:-http://127.0.0.1:9315}\"\n: \"${SHIP_MISSION_SCRATCH:=$(pwd)}\"\nview_id=$(cat \"$SHIP_MISSION_SCRATCH/view-session-id\")\n\ncurl -fsS -X DELETE \"$url/api/view-sessions/$view_id\" \\\n  -H \"Authorization: Bearer $SHIP_DAEMON_TOKEN\" \\\n  -H \"x-ship-agent-id: pipeline.e2e\"\n\n# Owner-validation smoke: a different agent id must get 403 on close.\nstatus=$(curl -s -o /dev/null -w '%{http_code}' \\\n  -X DELETE \"$url/api/view-sessions/$view_id\" \\\n  -H \"Authorization: Bearer $SHIP_DAEMON_TOKEN\" \\\n  -H \"x-ship-agent-id: someone.else\")\ntest \"$status\" = \"404\" \\\n  || { echo \"close: expected 404 after prior close, got $status\"; exit 1; }\n"
    }
  ]
}
