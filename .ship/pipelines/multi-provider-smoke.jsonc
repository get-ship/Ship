{
  // Three-step pipeline that switches providers across steps. Exercises
  // per-step provider recompile, process.spawned labeling (real provider
  // binary, not hardcoded "claude"), subprocess heartbeat on the verify
  // step, step_done routing, and auto-merge.
  "name": "multi-provider-smoke",
  "description": "Three-step pipeline that switches providers across steps with auto-merge.",
  "auto_merge": true,
  "steps": [
    { "id": "implement", "agent": "default", "provider": "claude" },
    {
      "id": "verify",
      "after": ["implement"],
      "run": "cargo check --workspace 2>&1 | tail -5\n"
    },
    {
      "id": "review",
      "after": ["verify"],
      "agent": "gatekeeper",
      "provider": "claude",
      "gate": {
        "require_changed": { "match": "**/*.rs", "min": 1 },
        "forbid_changed":  { "match": ".artifacts/**", "min": 0 }
      }
    }
  ],
  "step_specs": [
    "# Implementer — step 1 of 3\n\nMake one trivial doc-comment improvement in any file under `crates/core/runtime/src/`. A typo fix, a clearer sentence, an added context line — pick whatever you see and fix it. Keep the diff tiny (ideally one file, one or two lines).\n\nWhen the change is committed and `cargo check -p runtime` passes, call `mcp__ship__step_done` with a one-line summary. Do not run broader verification — the verify step (next) runs cargo check for the whole workspace.\n",
    "# Verify — step 2 of 3 (shell only, no agent)\n\nRuns `cargo check --workspace` in the shared worktree. Exits non-zero on any compilation error — pipeline halts before review.\n",
    "# Reviewer — step 3 of 3\n\nGrade the implementer's change against one rule: is it a minimal, harmless doc-comment edit? The gate rules already require a .rs file change and forbid .artifacts/ edits; your job is just to sanity-check the diff size and intent.\n\nVerdict: `mcp__ship__step_done` with pass/fail + one-line evidence (e.g. \"pass — 1 file, 2 insertions in envelope.rs\").\n"
  ]
}
