<style>
/* =============================================================
   Data view — Drizzle-Studio-like collections browser.
   Scoped to `.data-view` so these rules never escape the view.
   ============================================================= */

.data-view {
  /* Fill the shell's content area; the table scrolls internally.
     min-height fallback for when the parent has no intrinsic height
     (daemon-served fragments mounted via mount.ts don't always inherit
     100%). */
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  background: var(--background);
  color: var(--foreground);
}

/* Reusable inline monospace snippet (paths, ids). Named `mono-snip` so it
   can't collide with the shared `.mono` class `styles()` already emits. */
.data-view .mono-snip {
  font-family: var(--font-mono, "JetBrains Mono", ui-monospace, SFMono-Regular, monospace);
  font-variant-ligatures: none;
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  background: color-mix(in oklch, var(--muted) 60%, transparent);
  padding: 1px 5px;
  border-radius: var(--radius-sm);
  line-height: 1.4;
}
.data-view .mono-snip.id-cell,
.data-view .mono-snip.td-time,
.data-view .mono-snip.td-num { background: transparent; padding: 0; }

/* =============================================================
   INDEX SURFACE
   ============================================================= */
.data-view .data-index {
  padding: var(--space-6) var(--space-6) var(--space-8);
  overflow: auto;
}
.data-view .data-index-head {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
}
.data-view .data-index-title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--font-weight-semibold);
  letter-spacing: -0.01em;
  margin: 0 0 var(--space-1);
}
.data-view .data-index-sub {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
}
.data-view .data-index-actions { display: flex; gap: var(--space-2); }

.data-view .data-card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: var(--space-3);
}
.data-view .data-card {
  display: grid;
  gap: var(--space-3);
  padding: var(--space-4);
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  color: inherit;
  text-decoration: none;
  cursor: pointer;
  transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
}
.data-view .data-card:hover {
  border-color: color-mix(in oklch, var(--primary) 55%, var(--border));
  transform: translateY(-1px);
}
.data-view .data-card-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.data-view .data-card-icon {
  width: 28px;
  height: 28px;
  border-radius: var(--radius-md);
  display: grid;
  place-items: center;
  background: color-mix(in oklch, var(--primary) 14%, transparent);
  color: var(--primary);
}
.data-view .data-card-identity { flex: 1; min-width: 0; }
.data-view .data-card-name {
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: var(--font-weight-semibold);
  line-height: 1.2;
}
.data-view .data-card-id {
  display: inline-block;
  margin-top: 2px;
  font-size: 10.5px;
  color: var(--muted-foreground);
}
.data-view .data-card-count {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  background: var(--muted);
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.data-view .data-card-fields {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}
.data-view .data-card-field {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 2px var(--space-2);
  border: 1px dashed var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}
.data-view .data-card-field .mono-snip { background: transparent; padding: 0; color: var(--foreground); }
.data-view .data-card-field-more { color: var(--muted-foreground); }
.data-view .data-card-req { color: var(--destructive); font-family: var(--font-mono); font-size: 10px; }
.data-view .data-card-footer {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1px solid var(--border);
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}
.data-view .data-card-footer ship-icon { color: var(--muted-foreground); }

/* ── Drawer form styles ─────────────────────────────── */
.data-view .drawer-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
.data-view .drawer-field {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.data-view .drawer-label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}
.data-view .drawer-req {
  color: var(--destructive);
  font-weight: var(--font-weight-bold);
}
.data-view .drawer-type {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted-foreground);
  background: var(--muted);
  padding: 1px 5px;
  border-radius: var(--radius-sm);
  margin-left: auto;
}
.data-view .drawer-error {
  font-size: var(--text-sm);
  color: var(--destructive);
  padding: var(--space-2) var(--space-3);
  background: color-mix(in oklch, var(--destructive) 8%, transparent);
  border: 1px solid color-mix(in oklch, var(--destructive) 30%, var(--border));
  border-radius: var(--radius-md);
}
.data-view .drawer-field-group-label {
  font-size: 10.5px;
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted-foreground);
  padding-top: var(--space-2);
}
.data-view .data-index-actions {
  display: flex;
  gap: var(--space-2);
  align-items: flex-start;
}

</style>
