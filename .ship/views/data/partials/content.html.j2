{#- Data content partial — rendered by the generic SSE handler.
   Root element MUST have id="data-content" for Datastar patching. -#}
{% from '_ship.html.j2' import show, form, loading, spinner, update, confirm_delete %}
{% set per_page = 25 %}
<div id="data-content">
  {% if schema is defined and items is defined and items | length > 0 %}
  <table class="ship-table">
    <thead><tr>
      <th style="width:90px">ID</th>
      {% for field_name, _ in schema.fields %}<th>{{ field_name }}</th>{% endfor %}
      <th style="width:100px">Updated</th>
      <th style="width:40px"></th>
    </tr></thead>
    <tbody>
      {% for item in items %}
      <tr id="item-{{ item.id }}"
          data-on:click="$selectedId = $selectedId === '{{ item.id }}' ? '' : '{{ item.id }}'; $editForm = {{ item.data | tojson }}"
          data-class:row-selected="$selectedId === '{{ item.id }}'">
        <td class="mono muted" title="{{ item.id }}">{{ item.id[:10] }}</td>
        {% for field_name, field_def in schema.fields %}
        <td>
          {% set val = item.data[field_name] if item.data[field_name] is defined else none %}
          {% if val is none or val == "" %}<span class="null">--</span>
          {% elif field_def.field_type == "enum" %}<ship-chip>{{ val }}</ship-chip>
          {% elif field_def.field_type == "boolean" %}<ship-badge variant="{{ 'success' if val else 'secondary' }}">{{ "Yes" if val else "No" }}</ship-badge>
          {% elif field_def.field_type == "number" %}<span class="mono">{{ val }}</span>
          {% elif field_def.field_type == "array" and val is iterable and val is not string %}{% for v in val[:4] %}<ship-chip>{{ v }}</ship-chip> {% endfor %}{% if val | length > 4 %}<ship-badge variant="secondary">+{{ val | length - 4 }}</ship-badge>{% endif %}
          {% else %}{{ val }}{% endif %}
        </td>
        {% endfor %}
        <td class="mono muted">{{ item.updated_at[:16] if item.updated_at else "--" }}</td>
        <td>
          <ship-button size="sm" tone="destructive" variant="soft"
            data-on:click="evt.stopPropagation(); confirm('Delete this item?') && @delete('/api/collections/{{ active_collection }}/items/{{ item.id }}')"
            {{ loading('_deleting') }}
            aria-label="Delete">
            <ship-icon slot="leading" name="trash"></ship-icon>
          </ship-button>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {# -- Pagination -- #}
  {% if items | length > per_page %}
  <div class="data-pagination">
    <ship-pagination page="1" total="{{ items | length }}" per-page="{{ per_page }}"
      data-on:ship-change="$_page = evt.detail.page">
    </ship-pagination>
  </div>
  {% endif %}

  {# -- Detail panel (shows when a row is selected) -- #}
  {% for item in items %}
  <div {{ show("$selectedId === '" ~ item.id ~ "'") }}>
    <ship-card style="margin-top:var(--space-4,16px)">
      <div class="data-detail-head">
        <strong>Edit item</strong>
        <span class="data-detail-id">{{ item.id }}</span>
      </div>
      {{ form(schema, active_collection, 'editForm') }}
      <ship-separator></ship-separator>
      <div class="data-detail-actions">
        <ship-button size="sm" tone="accent" variant="solid"
          {{ update(active_collection, item.id, '$editForm') }}>
          Save
        </ship-button>
        <ship-button size="sm" tone="destructive" variant="soft"
          {{ confirm_delete(active_collection, item.id) }}
          {{ loading('_deleting') }}>
          Delete
        </ship-button>
        <ship-button size="sm" variant="ghost"
          data-on:click="$selectedId = ''">
          Close
        </ship-button>
        {{ spinner('_deleting') }}
      </div>
    </ship-card>
  </div>
  {% endfor %}

  {% elif schema is defined %}
  <ship-empty-state>
    <span slot="title">No items in {{ active_collection }}</span>
    <span slot="description">Click + New to create one</span>
  </ship-empty-state>
  {% else %}
  <ship-empty-state>
    <span slot="title">No collections defined</span>
    <span slot="description">Add a schema to .ship/schemas/</span>
  </ship-empty-state>
  {% endif %}
</div>
