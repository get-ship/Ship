{#-
  Data browser — server-rendered collection viewer/editor.
  Uses Ship View SDK macros. Datastar for all interactions.
-#}
{#- SDK gaps:
    - no navigation macro for linking between views
-#}
{% from '_ship.html.j2' import head, signal, show, live, create, loading, spinner, form, styles %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Data') }}
  {{ styles() }}
  <style>
  .data-wrap { max-width: 76rem; margin: 0 auto; padding: var(--space-6, 24px) var(--space-4, 16px); }
  .data-toolbar { display: flex; align-items: center; gap: var(--space-3, 10px); margin-bottom: var(--space-4, 16px); flex-wrap: wrap; }
  .data-count { font-size: var(--text-xs, 11px); color: var(--muted-foreground); margin-left: auto; }
  </style>
</head>
<body>
<div class="ship-view"
     {{ signal('collection', active_collection) }}
     {{ signal('_showForm', false) }}
     {{ signal('_creating', false) }}
     {{ signal('_deleting', false) }}
     {{ signal('form', {}) }}>
  <div class="data-wrap">

    {# -- Header -- #}
    <div style="margin-bottom: var(--space-5, 20px)">
      <h2 style="font-size: var(--text-xl, 20px); font-weight: 600; margin: 0">Data</h2>
      <p class="muted" style="font-size: var(--text-xs, 12px); margin-top: 4px">
        {% if items is defined %}{{ items | length }}{% else %}0{% endif %}
        item{{ "s" if not items or items | length != 1 else "" }}
        {% if active_collection is defined %} in {{ active_collection }}{% endif %}
      </p>
    </div>

    {# -- Toolbar (uses ship_collections() instead of context-injected collections) -- #}
    {% set sdk_collections = ship_collections() %}
    {% if sdk_collections | length > 0 %}
    <div class="data-toolbar">
      <ship-select size="sm" value="{{ active_collection }}"
        data-on:ship-change="$collection = evt.detail.value; @get('/api/runtime/view/data/sse')">
        {% for c in sdk_collections %}
        <option value="{{ c.id }}" {% if c.id == active_collection %}selected{% endif %}>
          {{ c.name or c.id }} ({{ c.field_count }})
        </option>
        {% endfor %}
      </ship-select>
      {% if schema is defined %}
      <ship-button size="sm"
        data-on:click="$_showForm = !$_showForm">
        + New
      </ship-button>
      {% endif %}
      <span class="data-count">{{ items | length if items is defined else 0 }} items</span>
    </div>
    {% endif %}

    {# -- Create form (uses SDK form macro) -- #}
    {% if schema is defined %}
    <ship-card {{ show('$_showForm') }} style="display:none; margin-bottom: var(--space-4, 16px)">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-3,12px)">
        <strong>New {{ active_collection }}</strong>
        <ship-button size="sm" variant="ghost"
          data-on:click="$_showForm = false">x</ship-button>
      </div>
      {{ form(schema, active_collection) }}
      <ship-separator></ship-separator>
      <div style="display:flex;gap:var(--space-2,8px);margin-top:var(--space-3,12px);align-items:center">
        <ship-button size="sm"
          {{ create(active_collection, '$form') }}
          {{ loading('_creating') }}>Create</ship-button>
        <ship-button size="sm" variant="ghost"
          data-on:click="$_showForm = false">Cancel</ship-button>
        {{ spinner('_creating') }}
      </div>
    </ship-card>
    {% endif %}

    {# -- Content (SSE-driven) -- #}
    <div {{ live('data') }}>
      <div id="data-content">
        <p class="muted" style="padding: var(--space-4, 16px) 0">Loading...</p>
      </div>
    </div>

  </div>
</div>
</body>
</html>
