{#-
  Data browser — server-rendered collection viewer/editor.
  Uses Ship View SDK macros. Datastar for all interactions.
-#}
{% from '_ship.html.j2' import head, signal, show, live, create, loading, spinner, form, styles %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Data') }}</head>
<body>
{% endif %}
{% set sdk_collections = ship_collections() %}
{% set item_count = items | length if items is defined else 0 %}
<div class="ship-view"
     {{ signal('collection', active_collection) }}
     {{ signal('_showForm', false) }}
     {{ signal('_showSchema', false) }}
     {{ signal('selectedId', '') }}
     {{ signal('_creating', false) }}
     {{ signal('_deleting', false) }}
     {{ signal('_page', 1) }}
     {{ signal('editForm', {}) }}
     {{ signal('form', {}) }}>
  {{ styles() }}
  {% include 'data/partials/styles.html.j2' %}
  <div class="data-wrap">

    {# -- Header -- #}
    <div class="data-header">
      <h2 class="data-title">Data</h2>
      <p class="muted data-subtitle">
        {{ item_count }} item{{ "s" if item_count != 1 else "" }}
        {% if active_collection is defined %} in {{ active_collection }}{% endif %}
      </p>
    </div>

    {# -- Toolbar -- #}
    {% if sdk_collections | length > 0 %}
    <div class="data-toolbar">
      <ship-select size="sm" value="{{ active_collection }}"
        data-on:ship-change="$collection = evt.detail.value; $selectedId = ''; $_page = 1; @get('/api/runtime/view/data/sse')">
        {% for c in sdk_collections %}
        <option value="{{ c.id }}" {% if c.id == active_collection %}selected{% endif %}>
          {{ c.name or c.id }}
        </option>
        {% endfor %}
      </ship-select>
      {% for c in sdk_collections %}
      {% if c.id == active_collection %}
      <ship-badge variant="secondary">{{ c.field_count }} field{{ "s" if c.field_count != 1 else "" }}</ship-badge>
      {% endif %}
      {% endfor %}
      {% if schema is defined %}
      <ship-button size="sm" tone="accent" variant="solid"
        data-on:click="$_showForm = !$_showForm">
        <ship-icon slot="leading" name="plus"></ship-icon>New
      </ship-button>
      <ship-button size="sm" variant="ghost"
        data-on:click="$_showSchema = !$_showSchema">
        <ship-icon slot="leading" name="columns"></ship-icon>Schema
      </ship-button>
      {% endif %}
      <span class="data-count">{{ item_count }} items</span>
    </div>
    {% else %}
    <ship-empty-state>
      <span slot="title">No collections</span>
      <span slot="description">Add a schema to .ship/schemas/ to get started</span>
    </ship-empty-state>
    {% endif %}

    {# -- Schema info (collapsible) -- #}
    {% if schema is defined %}
    <div {{ show('$_showSchema') }}>
      <ship-card class="data-schema-card">
        <div class="data-schema-head">
          <strong>Schema: {{ active_collection }}</strong>
          <ship-button size="sm" variant="ghost" aria-label="Close"
            data-on:click="$_showSchema = false">
            <ship-icon slot="leading" name="x"></ship-icon>
          </ship-button>
        </div>
        <table class="schema-table">
          <thead><tr>
            <th>Field</th><th>Type</th><th>Required</th><th>Default</th>
          </tr></thead>
          <tbody>
          {% for field_name, field_def in schema.fields %}
            <tr>
              <td class="mono">{{ field_name }}</td>
              <td><ship-chip>{{ field_def.field_type }}</ship-chip></td>
              <td>{% if field_def.required %}<ship-badge variant="warning">yes</ship-badge>{% else %}<span class="muted">no</span>{% endif %}</td>
              <td class="mono muted">{{ field_def.default if field_def.default else "--" }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </ship-card>
    </div>
    {% endif %}

    {# -- Create form -- #}
    {% if schema is defined %}
    <ship-card {{ show('$_showForm') }} class="data-form-card">
      <div class="data-form-head">
        <strong>New {{ active_collection }}</strong>
        <ship-button size="sm" variant="ghost" aria-label="Close"
          data-on:click="$_showForm = false">
          <ship-icon slot="leading" name="x"></ship-icon>
        </ship-button>
      </div>
      {{ form(schema, active_collection) }}
      <ship-separator></ship-separator>
      <div class="data-form-actions">
        <ship-button size="sm" tone="accent" variant="solid"
          {{ create(active_collection, '$form') }}
          {{ loading('_creating') }}>Create</ship-button>
        <ship-button size="sm" variant="ghost"
          data-on:click="$_showForm = false">Cancel</ship-button>
        {{ spinner('_creating') }}
      </div>
    </ship-card>
    {% endif %}

    {# -- Content (SSE-driven) -- #}
    <div {{ live('data') }}>
      <div id="data-content">
        <p class="muted data-loading">Loading...</p>
      </div>
    </div>

  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
