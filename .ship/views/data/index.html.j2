{#-
  Data browser — server-rendered collection viewer/editor.
  Uses Ship View SDK macros. Datastar for all interactions.
-#}
{#- SDK gaps:
    - no navigation macro for linking between views
-#}
{% from '_ship.html.j2' import head, signal, show, live, create, loading, spinner, form, styles, on %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Data') }}
  {{ styles() }}
  <style>
  .data-wrap { max-width: 76rem; margin: 0 auto; padding: var(--space-6) var(--space-4); }
  .data-header { margin-bottom: var(--space-5); }
  .data-header h2 { font-size: var(--text-xl); font-weight: var(--font-weight-semibold); }
  .data-header p { font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1); }
  </style>
</head>
<body>
<div class="ship-view"
     {{ signal('collection', active_collection) }}
     {{ signal('_showForm', false) }}
     {{ signal('_creating', false) }}
     {{ signal('_deleting', false) }}
     {{ signal('form', {}) }}>
  <div class="data-wrap">

    {# -- Header -- #}
    <div class="data-header">
      <h2>Data</h2>
      <p>
        {% if items is defined %}{{ items | length }}{% else %}0{% endif %}
        item{{ "s" if not items or items | length != 1 else "" }}
        {% if active_collection is defined %} in {{ active_collection }}{% endif %}
      </p>
    </div>

    {# -- Toolbar (uses ship_collections() instead of context-injected collections) -- #}
    {% set sdk_collections = ship_collections() %}
    {% if sdk_collections | length > 0 %}
    <ship-toolbar>
      <ship-select size="sm" value="{{ active_collection }}"
        {{ on('ship-select-change', "$collection = evt.detail.value; @get('/api/runtime/view/data/sse')") }}>
        {% for c in sdk_collections %}
        <ship-option value="{{ c.id }}" {% if c.id == active_collection %}selected{% endif %}>
          {{ c.name or c.id }} ({{ c.field_count }})
        </ship-option>
        {% endfor %}
      </ship-select>
      {% if schema is defined %}
      <ship-button size="sm"
        {{ on('click', "$_showForm = !$_showForm") }}>
        + New
      </ship-button>
      {% endif %}
    </ship-toolbar>
    {% endif %}

    {# -- Create form (uses SDK form macro) -- #}
    {% if schema is defined %}
    <ship-card {{ show('$_showForm') }}>
      <ship-toolbar>
        <strong>New {{ active_collection }}</strong>
        <ship-button size="sm" variant="ghost"
          {{ on('click', "$_showForm = false") }}>x</ship-button>
      </ship-toolbar>
      {{ form(schema, active_collection) }}
      <ship-separator></ship-separator>
      <ship-toolbar>
        <ship-button size="sm"
          {{ create(active_collection, '$form') }}
          {{ loading('_creating') }}>Create</ship-button>
        <ship-button size="sm" variant="ghost"
          {{ on('click', "$_showForm = false") }}>Cancel</ship-button>
        {{ spinner('_creating') }}
      </ship-toolbar>
    </ship-card>
    {% endif %}

    {# -- Content (SSE-driven) -- #}
    <div {{ live('data') }}>
      <div id="data-content">
        <p>Loading...</p>
      </div>
    </div>

  </div>
</div>
</body>
</html>
