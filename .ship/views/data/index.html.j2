{#-
  Data — Drizzle-Studio-style collections browser.
  Nav + workspace shell render once; the Rows tab body patches via SSE from
  partials/content.html.j2 whenever collection.item_* events fire.
-#}
{% from '_ship.html.j2' import head, signal, show, live, styles, tab, tab_panel, nav %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Data') }}</head>
<body>
{% endif %}
{% set sdk_collections = ship_collections() %}
{% set active_field_count = 0 %}
{% for c in sdk_collections %}{% if c.id == active_collection %}{% set active_field_count = c.field_count %}{% endif %}{% endfor %}
<div class="ship-view data-view"
     {{ signal('collection', active_collection) }}
     {{ signal('tab', 'rows') }}
     {{ signal('_density', 'cozy') }}
     {{ signal('selected', []) }}
     {{ signal('_page', 1) }}>
  {{ styles() }}
  {% include 'data/partials/styles.html.j2' %}
  {% include 'data/partials/workspace-styles.html.j2' %}
  {% include 'data/partials/table-styles.html.j2' %}

  {% if sdk_collections | length == 0 %}
    {# Empty workspace — no schemas on disk. #}
    <div class="data-index">
      <div class="data-index-head">
        <h1 class="data-index-title">Collections</h1>
        <div class="data-index-sub">
          Typed datasets defined in <span class="mono-snip">.ship/schemas/</span>,
          stored in <span class="mono-snip">~/.ship/data.db</span>.
        </div>
      </div>
      <ship-empty-state>
        <span slot="title">No collections yet</span>
        <span slot="description">Add a schema .jsonc file to .ship/schemas/ to get started.</span>
      </ship-empty-state>
    </div>
  {% elif query.browse == 'index' or active_collection is not defined or schema is not defined %}
    {# Collections index surface — grid of cards. #}
    {% include 'data/partials/index.html.j2' %}
  {% else %}
    {# Collection workspace — nav + header + tab body. #}
    <div class="col-workspace no-events">

      {# -- Left nav -- #}
      <aside class="col-nav">
        <div class="col-nav-section">
          <span>Collections</span>
          <span class="col-nav-add" title="New collection (coming soon)" aria-disabled="true">
            <ship-icon name="plus" size="sm"></ship-icon>
          </span>
        </div>
        {% for c in sdk_collections %}
        <a href="/data/{{ c.id }}" data-route="/data/{{ c.id }}"
           class="col-nav-row{% if c.id == active_collection %} is-active{% endif %}"
           data-on:click.prevent="window.router ? window.router.navigate('/data/{{ c.id }}') : (location.href = '/data/{{ c.id }}')">
          <span class="col-nav-icon"><ship-icon name="database" size="sm"></ship-icon></span>
          <span class="col-nav-label">{{ c.name or c.id }}</span>
          <span class="col-nav-count">{{ c.field_count }} field{% if c.field_count != 1 %}s{% endif %}</span>
        </a>
        {% if c.id == active_collection %}
          <div class="col-nav-sub">
            <span class="col-nav-sub-dot"></span>
            <span>Default view</span>
          </div>
        {% endif %}
        {% endfor %}

        <div class="col-nav-section" style="margin-top:var(--space-4)">
          <span>Saved queries</span>
          <span class="col-nav-add" title="Save current query (coming soon)" aria-disabled="true">
            <ship-icon name="plus" size="sm"></ship-icon>
          </span>
        </div>
        <div class="col-nav-row is-muted" aria-disabled="true">
          <span class="col-nav-icon"><ship-icon name="filter" size="sm"></ship-icon></span>
          <span class="col-nav-label">No saved queries</span>
        </div>
      </aside>

      {# -- Main workspace pane -- #}
      <div class="col-work-main">

        {# Workspace header — collection identity + tabs + actions. #}
        <div class="col-head">
          <div class="col-head-identity">
            <span class="col-head-icon"><ship-icon name="database" size="sm"></ship-icon></span>
            <span class="col-head-name">{{ schema.name or active_collection }}</span>
            <span class="col-head-id mono-snip">{{ active_collection }}</span>
            <span class="col-head-count">
              {{ items | length if items is defined else 0 }} of {{ items | length if items is defined else 0 }}
            </span>
          </div>
          <div class="col-head-right">
            <div class="col-tabs" role="tablist">
              <button type="button" role="tab" class="col-tab"
                {{ tab('tab', 'rows') }}>
                <ship-icon name="list-check" size="sm"></ship-icon>
                <span>Rows</span>
              </button>
              <button type="button" role="tab" class="col-tab"
                {{ tab('tab', 'schema') }}>
                <ship-icon name="columns" size="sm"></ship-icon>
                <span>Schema</span>
              </button>
            </div>
            <span class="col-head-sep" aria-hidden="true"></span>
            {#- Build a stub JSON body for required fields as a signal so the
                @post expression stays readable. Use &quot; in attribute context
                so the browser normalizes to " before Datastar evaluates. -#}
            {% set _stub_parts = [] %}
            {% for f in schema.fields %}{% if f[1].required %}{% if f[1].field_type == 'number' %}{% set _stub_parts = _stub_parts + [('&quot;' ~ f[0] ~ '&quot;: 0')] %}{% elif f[1].field_type == 'boolean' %}{% set _stub_parts = _stub_parts + [('&quot;' ~ f[0] ~ '&quot;: false')] %}{% elif f[1].field_type == 'enum' and f[1].values and f[1].values | length > 0 %}{% set _stub_parts = _stub_parts + [('&quot;' ~ f[0] ~ '&quot;: &quot;' ~ f[1].values[0] ~ '&quot;')] %}{% elif f[1].field_type == 'array' %}{% set _stub_parts = _stub_parts + [('&quot;' ~ f[0] ~ '&quot;: []')] %}{% else %}{% set _stub_parts = _stub_parts + [('&quot;' ~ f[0] ~ '&quot;: &quot;New ' ~ f[0] ~ '&quot;')] %}{% endif %}{% endif %}{% endfor %}
            <ship-button size="sm" tone="accent" variant="solid"
              data-on:click="@post('/api/collections/{{ active_collection }}/items', {contentType: 'json', body: {data: { {{- _stub_parts | join(', ') -}} }}})">
              <ship-icon slot="leading" name="plus"></ship-icon>New row
            </ship-button>
          </div>
        </div>

        {# Rows tab — table body. Patched via SSE. #}
        <div {{ tab_panel('tab', 'rows') }} class="col-tab-panel rows-panel"
          data-class:is-dense="$_density == 'compact'">
          <div {{ live('data') }}>
            <div id="data-content">
              <div class="data-loading">
                <span class="ship-spinner"></span>
                <span>Loading rows…</span>
              </div>
            </div>
          </div>
        </div>

        {# Schema tab — inline editor. Built-in collections (runtime-owned) are
           presented read-only; user-defined collections are fully editable
           via PUT /api/collections/<id>/schema. #}
        {% set _is_builtin = active_collection in ['specs', 'adrs', 'notes', 'feedback', 'annotations'] %}
        <div {{ tab_panel('tab', 'schema') }} class="col-tab-panel schema-panel">
          <div class="schema-pane"
               {{ signal('_savedAt', 0) }}
               {{ signal('_saveError', '') }}>
            <div class="schema-pane-head">
              <div>
                <h3 class="schema-pane-title">{{ schema.name or active_collection }}</h3>
                <div class="schema-pane-sub mono-snip">
                  {% if _is_builtin %}built-in · defined in crates/core/runtime/src/collections/builtin.rs
                  {%- else -%}.ship/schemas/{{ active_collection }}.jsonc{% endif -%}
                </div>
              </div>
              <span class="schema-pane-count">{{ schema.fields | length }} field{% if schema.fields | length != 1 %}s{% endif %}</span>
            </div>

            {% if _is_builtin %}
            <div class="schema-builtin-note">
              <ship-icon name="lock" size="sm"></ship-icon>
              Built-in collections ship with the runtime. Fields are listed below for reference — editing would require a code change + rebuild.
            </div>
            {% endif %}

            {% if _is_builtin %}
            {# Read-only view. #}
            <div class="schema-fields">
              {% for f in schema.fields %}
              <div class="schema-field">
                <span class="ft-badge ft-{{ f[1].field_type }}">{{ f[1].field_type }}</span>
                <span class="schema-field-name mono-snip">{{ f[0] }}</span>
                {% if f[1].required %}<span class="schema-field-req" title="Required">required</span>{% endif %}
                {% if f[1].values %}<span class="schema-field-values mono-snip">{{ f[1].values | join(' | ') }}</span>{% endif %}
              </div>
              {% endfor %}
            </div>
            {% else %}
            {# Editable form. Each field row binds to a signal slot in $schemaDraft. #}
            {% set _field_json_parts = [] %}
            {% for f in schema.fields %}{% set _field_json_parts = _field_json_parts + [
              '{&quot;name&quot;: &quot;' ~ f[0] ~ '&quot;, &quot;type&quot;: &quot;' ~ f[1].field_type ~ '&quot;, &quot;required&quot;: ' ~ ('true' if f[1].required else 'false') ~ ', &quot;values&quot;: ' ~ (f[1].values | tojson if f[1].values else '[]') ~ '}'
            ] %}{% endfor %}
            <form class="schema-form"
                  {{ signal('schemaDraft', '') }}
                  data-signals:schemaDraft="{id: '{{ active_collection }}', name: '{{ schema.name or active_collection }}', fields: [{{- _field_json_parts | join(', ') -}}]}"
                  data-on:submit.prevent="@put('/api/collections/{{ active_collection }}/schema', {contentType: 'json', body: $schemaDraft}); $_savedAt = Date.now(); $_saveError = ''">
              <div class="schema-edit-table">
                <div class="schema-edit-head">
                  <span>Type</span>
                  <span>Name</span>
                  <span>Required</span>
                  <span>Values (enum)</span>
                  <span></span>
                </div>
                <template data-for="(f, i) in $schemaDraft.fields">
                  {# Datastar doesn't ship a native for-template, so we render one row per field server-side and
                     bind indexes. Keeps the editor declarative; the template comment above is a placeholder for future
                     dynamic row counts — add/remove will reload the view for now (Phase 2.5). #}
                </template>
                {% for f in schema.fields %}
                <div class="schema-edit-row">
                  <ship-select size="sm" data-bind="schemaDraft.fields.{{ loop.index0 }}.type">
                    <option value="string">string</option>
                    <option value="markdown">markdown</option>
                    <option value="number">number</option>
                    <option value="boolean">boolean</option>
                    <option value="enum">enum</option>
                    <option value="date">date</option>
                    <option value="file">file</option>
                    <option value="array">array</option>
                    <option value="object">object</option>
                  </ship-select>
                  <ship-input size="sm" data-bind="schemaDraft.fields.{{ loop.index0 }}.name"></ship-input>
                  <label class="schema-edit-check">
                    <input type="checkbox" data-bind="schemaDraft.fields.{{ loop.index0 }}.required">
                  </label>
                  <ship-input size="sm" placeholder="comma-separated"
                    data-bind="schemaDraft.fields.{{ loop.index0 }}._valuesCsv"
                    data-attr:disabled="$schemaDraft.fields.{{ loop.index0 }}.type != 'enum'"></ship-input>
                  <ship-button size="sm" variant="ghost" aria-label="Remove field"
                    data-on:click="$schemaDraft.fields.splice({{ loop.index0 }}, 1)">
                    <ship-icon name="trash" size="sm"></ship-icon>
                  </ship-button>
                </div>
                {% endfor %}
              </div>
              <div class="schema-edit-footer">
                <ship-button size="sm" variant="ghost"
                  data-on:click.prevent="$schemaDraft.fields.push({name: 'new_field', type: 'string', required: false, values: []})">
                  <ship-icon slot="leading" name="plus"></ship-icon>Add field
                </ship-button>
                <span class="schema-edit-spacer"></span>
                <span class="schema-edit-saved" data-show="$_savedAt > 0">Saved</span>
                <span class="schema-edit-error" data-text="$_saveError" data-show="$_saveError"></span>
                <ship-button size="sm" tone="accent" variant="solid" type="submit">
                  <ship-icon slot="leading" name="check"></ship-icon>Save schema
                </ship-button>
              </div>
            </form>
            {% endif %}
          </div>
        </div>

      </div>
    </div>
  {% endif %}
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
