{#-
  Git content partial — live-patched over SSE into #git-content.
  Context: branch, clean, total_changed, staged, modified, untracked,
           commits, selected_commit, completed_jobs, error, workspace_id.
-#}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}
{%- set base_url = '/api/runtime/view/git' -%}
{%- set sse_url = '/api/runtime/view/git/sse' -%}
{%- set diff_url = base_url ~ '?commit=WORKING' ~ ws_qs -%}

<div id="git-content">
{% if error %}
  <div style="padding: 16px;">
    <h2 style="font-size: 14px; color: var(--destructive);">{{ error.title }}</h2>
    <p style="font-size: 12px; color: var(--muted-foreground);">{{ error.body }}</p>
  </div>
{% elif selected_commit %}
  {# -- Diff viewer mode -- #}
  <div class="ship-git-diff-header">
    <button type="button" class="ship-git-back" aria-label="Back"
      data-on:click="@get('{{ sse_url }}{% if workspace_id %}?workspace_id={{ workspace_id }}{% endif %}')">
      <ship-icon name="arrow-left" size="sm"></ship-icon>
    </button>
    <ship-icon name="git-branch" size="sm" class="ship-git-header-icon"></ship-icon>
    <span class="ship-git-diff-title">
      {% if selected_commit.is_working %}Working tree diff
      {% else %}Commit {{ selected_commit.short_sha }}{% endif %}
    </span>
    {% if not selected_commit.is_working %}
      <button type="button" class="ship-git-show-working"
        data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
        Show working tree
      </button>
    {% endif %}
  </div>

  {# Review banner #}
  {% if completed_jobs and completed_jobs|length > 0 %}
  <div class="ship-git-review-banner" role="status">
    <ship-icon name="check-circle" size="sm"></ship-icon>
    <div>
      {% for j in completed_jobs %}
        <p>Pipeline <strong>{{ j.slug }}</strong> completed. Review the diff below.</p>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="ship-git-diff-body">
    {% set parsed = selected_commit.parsed %}
    {% if parsed and parsed.files and parsed.files|length > 0 %}
      <ship-git-diff
        files="{{ parsed.files|length }}"
        additions="{{ parsed.total_additions }}"
        deletions="{{ parsed.total_deletions }}">
        {% for file in parsed.files %}
          <ship-git-diff-file
            path="{{ file.path }}"
            additions="{{ file.additions }}"
            deletions="{{ file.deletions }}">
            {% for hunk in file.hunks %}
              <ship-git-diff-hunk header="{{ hunk.header }}"></ship-git-diff-hunk>
              {% for line in hunk.lines %}
                <ship-git-diff-line
                  type="{{ line.kind }}"
                  old="{% if line.old_num %}{{ line.old_num }}{% endif %}"
                  new="{% if line.new_num %}{{ line.new_num }}{% endif %}">{{ line.content }}</ship-git-diff-line>
              {% endfor %}
            {% endfor %}
          </ship-git-diff-file>
        {% endfor %}
      </ship-git-diff>
    {% else %}
      <ship-empty-state>
        <ship-icon slot="icon" name="check"></ship-icon>
        <span slot="title">No changes to display</span>
      </ship-empty-state>
    {% endif %}
  </div>

{% else %}
  {# -- Status overview mode -- #}
  <div class="ship-git-header">
    <ship-icon name="git-branch" size="md" class="ship-git-header-icon"></ship-icon>
    <h1>Git</h1>
    {% if branch %}
      <span class="ship-git-state {% if clean %}clean{% else %}dirty{% endif %}">
        {% if clean %}Clean{% else %}Changes{% endif %}
      </span>
    {% endif %}
  </div>

  {# Review banner #}
  {% if completed_jobs and completed_jobs|length > 0 %}
  <div class="ship-git-review-banner" role="status">
    <ship-icon name="check-circle" size="sm"></ship-icon>
    <div>
      {% for j in completed_jobs %}
        <p>Pipeline <strong>{{ j.slug }}</strong> completed. Review the diff below.</p>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# Status block #}
  <div class="ship-git-section">
    {% if branch %}
    <div class="ship-git-toolbar" role="toolbar" aria-label="Branch">
      <span class="ship-git-toolbar-chip">
        <ship-icon name="git-branch" size="xs"></ship-icon>
        {{ branch }}
      </span>
      <span class="ship-git-toolbar-meta">
        {{ modified|length }} modified / {{ untracked|length }} untracked
      </span>
      {% if total_changed and total_changed > 0 %}
        <span class="ship-git-toolbar-meta">·</span>
        <span class="ship-git-toolbar-meta">{{ total_changed }} file{% if total_changed != 1 %}s{% endif %} changed</span>
      {% endif %}
      <span class="ship-git-toolbar-spacer"></span>
      {% if total_changed and total_changed > 0 %}
        <button type="button" class="ship-git-toolbar-link"
          data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
          <ship-icon name="git-compare" size="xs"></ship-icon>
          View diff
        </button>
      {% endif %}
    </div>
    {% endif %}

    {% if not clean %}
      <div class="ship-git-breakdown">
        {% if staged|length > 0 %}<span><ship-status-dot tone="success" size="sm"></ship-status-dot>{{ staged|length }} staged</span>{% endif %}
        {% if modified|length > 0 %}<span><ship-status-dot tone="warning" size="sm"></ship-status-dot>{{ modified|length }} modified</span>{% endif %}
        {% if untracked|length > 0 %}<span><ship-status-dot tone="destructive" size="sm"></ship-status-dot>{{ untracked|length }} untracked</span>{% endif %}
      </div>

      <div class="ship-git-file-list" role="list">
        {% for f in staged %}
          <button type="button" role="listitem" class="ship-git-file-row"
            data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
            <ship-status-dot tone="{{ f.tone }}" size="sm"></ship-status-dot>
            <span class="ship-git-file-name" title="{{ f.path }}">{{ f.path }}</span>
          </button>
        {% endfor %}
        {% for f in modified %}
          <button type="button" role="listitem" class="ship-git-file-row"
            data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
            <ship-status-dot tone="{{ f.tone }}" size="sm"></ship-status-dot>
            <span class="ship-git-file-name" title="{{ f.path }}">{{ f.path }}</span>
          </button>
        {% endfor %}
        {% for f in untracked %}
          <button type="button" role="listitem" class="ship-git-file-row"
            data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
            <ship-status-dot tone="{{ f.tone }}" size="sm"></ship-status-dot>
            <span class="ship-git-file-name" title="{{ f.path }}">{{ f.path }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}

    {% if total_changed and total_changed > 0 %}
      <div class="ship-git-view-diff">
        <ship-button tone="accent" variant="solid" size="md"
          data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
          <ship-icon name="git-compare" size="xs"></ship-icon>
          View diff
        </ship-button>
      </div>
    {% endif %}
  </div>

  {# Log section #}
  {% if commits and commits|length > 0 %}
    {% if branch or (total_changed and total_changed > 0) %}
      <div class="ship-git-divider"></div>
    {% endif %}
    <div class="ship-git-log-heading">Recent Commits</div>
    <div class="ship-git-log">
      {% for c in commits[:10] %}
        <button type="button" class="ship-git-commit"
          data-on:click="@get('{{ sse_url }}?commit={{ c.sha }}{{ ws_qs }}')">
          <div class="ship-git-commit-subject">{{ c.subject|truncate(60) }}</div>
          <div class="ship-git-commit-meta">
            <span class="ship-git-commit-sha">{{ c.short_sha }}</span>
            <span>{{ c.date }}</span>
            <span class="spacer"></span>
            <ship-icon class="hint" name="message-square" size="xs"></ship-icon>
          </div>
        </button>
      {% endfor %}
    </div>
  {% elif not branch %}
    <p class="ship-git-empty">Connect CLI to see git info.</p>
  {% endif %}
{% endif %}
</div>
