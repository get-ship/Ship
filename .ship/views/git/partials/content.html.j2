{#- SDK gaps:
    - no diff_viewer() macro — must render ship-git-diff elements manually
    - no toolbar() macro for branch/status bar
    - no file_list() macro for staged/modified/untracked file rows
    - no commit_log() macro for recent commits listing
    - no review_banner() macro for completed job notifications
-#}
{#-
  Git content partial — live-patched over SSE into #git-content.
  Context: branch, clean, total_changed, staged, modified, untracked,
           commits, selected_commit, completed_jobs, error, workspace_id.
-#}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}
{%- set base_url = '/api/runtime/view/git' -%}
{%- set sse_url = '/api/runtime/view/git/sse' -%}
{%- set diff_url = base_url ~ '?commit=WORKING' ~ ws_qs -%}

<div id="git-content">
{% if error %}
  <ship-alert tone="destructive">
    <span slot="title">{{ error.title }}</span>
    {{ error.body }}
  </ship-alert>
{% elif selected_commit %}
  {# -- Diff viewer mode -- #}
  <ship-toolbar>
    <ship-button variant="ghost" size="sm" aria-label="Back"
      data-on:click="@get('{{ sse_url }}{% if workspace_id %}?workspace_id={{ workspace_id }}{% endif %}')">
      <ship-icon name="arrow-left" size="sm"></ship-icon>
    </ship-button>
    <ship-icon name="git-branch" size="sm"></ship-icon>
    <span>
      {% if selected_commit.is_working %}Working tree diff
      {% else %}Commit {{ selected_commit.short_sha }}{% endif %}
    </span>
    {% if not selected_commit.is_working %}
      <ship-button variant="ghost" size="sm"
        data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
        Show working tree
      </ship-button>
    {% endif %}
  </ship-toolbar>

  {# Review banner #}
  {% if completed_jobs and completed_jobs|length > 0 %}
  <div class="git-review-banner" role="status">
    <ship-icon name="check-circle" size="sm"></ship-icon>
    <div>
      {% for j in completed_jobs %}
        <p>Pipeline <strong>{{ j.slug }}</strong> completed. Review the diff below.</p>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div>
    {% set parsed = selected_commit.parsed %}
    {% if parsed and parsed.files and parsed.files|length > 0 %}
      <ship-git-diff
        files="{{ parsed.files|length }}"
        additions="{{ parsed.total_additions }}"
        deletions="{{ parsed.total_deletions }}">
        {% for file in parsed.files %}
          <ship-git-diff-file
            path="{{ file.path }}"
            additions="{{ file.additions }}"
            deletions="{{ file.deletions }}">
            {% for hunk in file.hunks %}
              <ship-git-diff-hunk header="{{ hunk.header }}"></ship-git-diff-hunk>
              {% for line in hunk.lines %}
                <ship-git-diff-line
                  type="{{ line.kind }}"
                  old="{% if line.old_num %}{{ line.old_num }}{% endif %}"
                  new="{% if line.new_num %}{{ line.new_num }}{% endif %}">{{ line.content }}</ship-git-diff-line>
              {% endfor %}
            {% endfor %}
          </ship-git-diff-file>
        {% endfor %}
      </ship-git-diff>
    {% else %}
      <ship-empty-state>
        <ship-icon slot="icon" name="check"></ship-icon>
        <span slot="title">No changes to display</span>
      </ship-empty-state>
    {% endif %}
  </div>

{% else %}
  {# -- Status overview mode -- #}
  <div class="git-header">
    <ship-icon name="git-branch" size="md"></ship-icon>
    <h1>Git</h1>
    {% if branch %}
      <ship-badge tone="{% if clean %}success{% else %}warning{% endif %}">
        {% if clean %}Clean{% else %}Changes{% endif %}
      </ship-badge>
    {% endif %}
  </div>

  {# Review banner #}
  {% if completed_jobs and completed_jobs|length > 0 %}
  <div class="git-review-banner" role="status">
    <ship-icon name="check-circle" size="sm"></ship-icon>
    <div>
      {% for j in completed_jobs %}
        <p>Pipeline <strong>{{ j.slug }}</strong> completed. Review the diff below.</p>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# Status block #}
  <div class="git-section">
    {% if branch %}
    <ship-toolbar role="toolbar" aria-label="Branch">
      <ship-chip>
        <ship-icon name="git-branch" size="xs"></ship-icon>
        {{ branch }}
      </ship-chip>
      <span>{{ modified|length }} modified / {{ untracked|length }} untracked</span>
      {% if total_changed and total_changed > 0 %}
        <span>&#183; {{ total_changed }} file{% if total_changed != 1 %}s{% endif %} changed</span>
        <ship-button variant="ghost" size="sm"
          data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
          <ship-icon name="git-compare" size="xs"></ship-icon>
          View diff
        </ship-button>
      {% endif %}
    </ship-toolbar>
    {% endif %}

    {% if not clean %}
      <div class="git-breakdown">
        {% if staged|length > 0 %}<span><ship-status-dot tone="success" size="sm"></ship-status-dot>{{ staged|length }} staged</span>{% endif %}
        {% if modified|length > 0 %}<span><ship-status-dot tone="warning" size="sm"></ship-status-dot>{{ modified|length }} modified</span>{% endif %}
        {% if untracked|length > 0 %}<span><ship-status-dot tone="destructive" size="sm"></ship-status-dot>{{ untracked|length }} untracked</span>{% endif %}
      </div>

      <ship-card>
        {% for f in staged %}
          <ship-file-row path="{{ f.path }}" tone="{{ f.tone }}"
            data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')"></ship-file-row>
        {% endfor %}
        {% for f in modified %}
          <ship-file-row path="{{ f.path }}" tone="{{ f.tone }}"
            data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')"></ship-file-row>
        {% endfor %}
        {% for f in untracked %}
          <ship-file-row path="{{ f.path }}" tone="{{ f.tone }}"
            data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')"></ship-file-row>
        {% endfor %}
      </ship-card>
    {% endif %}

    {% if total_changed and total_changed > 0 %}
      <ship-button tone="accent" variant="solid" size="md"
        data-on:click="@get('{{ sse_url }}?commit=WORKING{{ ws_qs }}')">
        <ship-icon name="git-compare" size="xs"></ship-icon>
        View diff
      </ship-button>
    {% endif %}
  </div>

  {# Log section #}
  {% if commits and commits|length > 0 %}
    {% if branch or (total_changed and total_changed > 0) %}
      <ship-separator></ship-separator>
    {% endif %}
    <div class="git-log-heading">Recent Commits</div>
    <div class="git-log">
      {% for c in commits[:10] %}
        <button type="button" class="git-commit"
          data-on:click="@get('{{ sse_url }}?commit={{ c.sha }}{{ ws_qs }}')">
          <div class="git-commit-subject">{{ c.subject|truncate(60) }}</div>
          <div class="git-commit-meta">
            <span class="git-commit-sha">{{ c.short_sha }}</span>
            <span>{{ c.date }}</span>
          </div>
        </button>
      {% endfor %}
    </div>
  {% elif not branch %}
    <ship-empty-state><span slot="title">Connect CLI to see git info.</span></ship-empty-state>
  {% endif %}
{% endif %}
</div>
