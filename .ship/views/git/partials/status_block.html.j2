{#-
  Working-tree status: branch bar, breakdown dots, file list, view-diff button.
  Expects: branch, clean, total_changed, staged[], modified[], untracked[],
           workspace_id.
-#}
{% from '_urls.html.j2' import view_git %}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}
{%- set diff_url = view_git() ~ '?commit=WORKING' ~ ws_qs -%}

{% if branch %}
<div class="git-branch-bar">
  <span class="git-branch-name">
    <ship-icon name="git-branch" size="xs"></ship-icon>
    {{ branch }}
  </span>
  <span class="git-dot {% if clean %}git-dot--ok{% else %}git-dot--warn{% endif %}"></span>
  {% if total_changed and total_changed > 0 %}
    <span class="git-changed-count">
      <ship-icon name="file-text" size="xs"></ship-icon>
      {{ total_changed }} file{% if total_changed != 1 %}s{% endif %}
    </span>
  {% endif %}
</div>
{% endif %}

{% if not clean %}
  <div class="git-breakdown">
    {% if staged|length > 0 %}
      <span><ship-status-dot tone="success" size="sm"></ship-status-dot>{{ staged|length }} staged</span>
    {% endif %}
    {% if modified|length > 0 %}
      <span><ship-status-dot tone="warning" size="sm"></ship-status-dot>{{ modified|length }} modified</span>
    {% endif %}
    {% if untracked|length > 0 %}
      <span><ship-status-dot tone="destructive" size="sm"></ship-status-dot>{{ untracked|length }} untracked</span>
    {% endif %}
  </div>

  <div class="git-file-list" role="list">
    {% for f in staged %}
      <button type="button" role="listitem" class="git-file-row"
        data-on:click="@get('{{ diff_url | safe }}')">
        <span class="git-file-badge git-file-badge--stg">S</span>
        <span class="git-file-name" title="{{ f.path }}">{{ f.basename }}</span>
      </button>
    {% endfor %}
    {% for f in modified %}
      <button type="button" role="listitem" class="git-file-row"
        data-on:click="@get('{{ diff_url | safe }}')">
        <span class="git-file-badge git-file-badge--mod">M</span>
        <span class="git-file-name" title="{{ f.path }}">{{ f.basename }}</span>
      </button>
    {% endfor %}
    {% for f in untracked %}
      <button type="button" role="listitem" class="git-file-row"
        data-on:click="@get('{{ diff_url | safe }}')">
        <span class="git-file-badge git-file-badge--unt">?</span>
        <span class="git-file-name" title="{{ f.path }}">{{ f.basename }}</span>
      </button>
    {% endfor %}
  </div>
{% endif %}

{% if total_changed and total_changed > 0 %}
  <ship-button variant="outline" size="sm" tone="accent"
    data-on:click="@get('{{ diff_url | safe }}')">
    View diff
  </ship-button>
{% endif %}
