{#- History tab: chronological commit rows, click-to-diff. -#}
<div class="gv-panel" data-show="$tab == 'history'" style="display:none">
  {% if commits and commits | length > 0 %}
    <ship-scroll-area style="flex:1">
      <div style="padding:6px 0 16px">
        {% for c in commits %}
          <ship-history-row
            sha="{{ c.short_sha | e }}"
            subject="{{ c.subject | e }}"
            author="{{ c.author | e }}"
            timestamp="{{ c.date | e }}"
            additions="{{ c.additions }}"
            deletions="{{ c.deletions }}"
            data-on:ship-select="$tab = 'changes'; @get('{{ base_url }}?commit={{ c.sha }}{{ ws_qs }}')">
          </ship-history-row>
        {% endfor %}
      </div>
    </ship-scroll-area>
  {% else %}
    <ship-empty-state icon="git-commit" tone="muted" size="md" style="flex:1">
      <span slot="title">No commits</span>
    </ship-empty-state>
  {% endif %}
</div>
