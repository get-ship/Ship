{#-
  Git view -- single-column layout with two mutually exclusive states:
    A) Status overview (branch, file changes, commit log)
    B) Diff viewer (toolbar, summary, per-file hunks)

  Context from daemon (views_git.rs -> GitCtx):
    workspace_id, branch, clean, total_changed, staged[], modified[],
    untracked[], commits[], selected_commit, completed_jobs[], error
-#}
{% from '_ship.html.j2' import head %}
{% from '_urls.html.j2' import view_git %}
{%- set ws_qs = '' -%}
{%- if workspace_id %}{%- set ws_qs = '&workspace_id=' ~ workspace_id -%}{%- endif -%}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Git') }}
  <style>
  {#- Base layout -#}
  .ship-view-git { color: var(--foreground); }
  .git-wrap { width: 100%; max-width: 672px; margin: 0 auto; padding: 24px 16px; }
  .git-wrap--diff { max-width: none; padding: 0; }

  {#- Header -#}
  .git-header {
    display: flex; align-items: center; gap: 8px;
    margin-bottom: 16px;
  }
  .git-header h1 {
    font-family: var(--font-display);
    font-size: 18px; font-weight: 600;
    letter-spacing: -0.01em; margin: 0;
  }
  .git-header-icon { color: var(--muted-foreground); }
  .git-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 12px; font-weight: 500;
    padding: 2px 8px; border-radius: 9999px;
  }
  .git-badge--clean { color: var(--success); background: color-mix(in oklch, var(--success) 10%, transparent); }
  .git-badge--dirty { color: var(--warning); background: color-mix(in oklch, var(--warning) 10%, transparent); }

  {#- Review banner -#}
  .git-review-banner {
    display: flex; align-items: flex-start; gap: 8px;
    margin-bottom: 12px; padding: 8px 12px;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklch, var(--success) 30%, transparent);
    background: color-mix(in oklch, var(--success) 10%, transparent);
  }
  .git-review-banner ship-icon { color: var(--success); flex-shrink: 0; margin-top: 1px; }
  .git-review-banner p { font-size: 12px; color: var(--foreground); margin: 0; }
  .git-review-banner strong { font-weight: 500; }

  {#- Branch toolbar -#}
  .git-branch-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 12px; margin-bottom: 12px;
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--card) 80%, var(--muted));
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
  }
  .git-branch-name {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
  }
  .git-dot {
    width: 6px; height: 6px; border-radius: 9999px; flex-shrink: 0;
  }
  .git-dot--ok { background: var(--success); }
  .git-dot--warn { background: var(--warning); }
  .git-changed-count {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; color: var(--muted-foreground);
  }

  {#- Status breakdown -#}
  .git-breakdown {
    display: flex; gap: 12px; font-size: 10px;
    color: var(--muted-foreground); margin-bottom: 10px;
  }
  .git-breakdown span { display: inline-flex; align-items: center; gap: 4px; }

  {#- File list -#}
  .git-file-list {
    display: flex; flex-direction: column;
    margin-bottom: 12px;
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    border-radius: var(--radius-md); overflow: hidden;
  }
  .git-file-row {
    display: flex; align-items: center; gap: 8px;
    width: 100%; padding: 6px 10px;
    background: transparent; border: 0;
    font-family: var(--font-mono); font-size: 12px;
    color: var(--foreground); cursor: pointer; text-align: left;
    transition: background var(--duration-fast) ease;
  }
  .git-file-row + .git-file-row {
    border-top: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
  }
  .git-file-row:hover {
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    color: var(--foreground);
  }
  .git-file-badge {
    display: inline-block;
    font-family: var(--font-mono); font-size: 9px; line-height: 1;
    padding: 2px 5px; border-radius: 3px;
    font-weight: 700; letter-spacing: 0.02em;
    flex-shrink: 0; text-align: center; min-width: 18px;
  }
  .git-file-badge--stg { background: color-mix(in oklch, var(--success) 15%, transparent); color: var(--success); }
  .git-file-badge--mod { background: color-mix(in oklch, var(--warning) 15%, transparent); color: var(--warning); }
  .git-file-badge--unt { background: color-mix(in oklch, var(--destructive) 15%, transparent); color: var(--destructive); }
  .git-file-badge--add { background: color-mix(in oklch, var(--success) 15%, transparent); color: var(--success); }
  .git-file-badge--del { background: color-mix(in oklch, var(--destructive) 15%, transparent); color: var(--destructive); }
  .git-file-name {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;
  }

  {#- View diff button -#}
  .git-view-diff-btn {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    width: 100%; padding: 7px 12px;
    font-size: 10px; font-weight: 500;
    color: var(--primary);
    border: 1px solid color-mix(in oklch, var(--primary) 20%, transparent);
    border-radius: var(--radius-md);
    background: transparent; cursor: pointer;
    transition: background var(--duration-fast) ease;
  }
  .git-view-diff-btn:hover {
    background: color-mix(in oklch, var(--primary) 5%, transparent);
  }

  {#- Divider -#}
  .git-divider {
    border: 0;
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    margin: 16px 0;
  }

  {#- Commit log -#}
  .git-log-heading {
    font-size: 10px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: color-mix(in oklch, var(--muted-foreground) 50%, transparent);
    margin-bottom: 8px;
  }
  .git-log { display: flex; flex-direction: column; gap: 2px; }
  .git-commit {
    display: block; width: 100%; text-align: left;
    background: transparent; border: 0;
    padding: 8px; margin: 0 -4px;
    border-radius: var(--radius-md); cursor: pointer;
    transition: background var(--duration-fast) ease;
  }
  .git-commit:hover {
    background: color-mix(in oklch, var(--muted) 40%, transparent);
  }
  .git-commit-subject {
    font-size: 13px; color: var(--muted-foreground);
    line-height: 1.4;
    transition: color var(--duration-fast) ease;
  }
  .git-commit:hover .git-commit-subject { color: var(--foreground); }
  .git-commit-meta {
    display: flex; align-items: center; gap: 8px;
    margin-top: 3px; font-size: 10px;
    color: color-mix(in oklch, var(--muted-foreground) 50%, transparent);
  }
  .git-commit-sha { font-family: var(--font-mono); }
  .git-commit-meta .spacer { flex: 1; }
  .git-commit-meta .hint {
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
    color: var(--muted-foreground);
  }
  .git-commit:hover .git-commit-meta .hint { opacity: 0.6; }

  .git-empty {
    font-size: 10px;
    color: color-mix(in oklch, var(--muted-foreground) 60%, transparent);
  }

  {#- Diff toolbar -#}
  .git-diff-toolbar {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 16px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    flex-shrink: 0;
  }
  .git-back {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    border-radius: var(--radius-md);
    background: transparent; border: 0;
    color: var(--foreground); cursor: pointer;
    transition: background var(--duration-fast) ease;
  }
  .git-back:hover {
    background: color-mix(in oklch, var(--muted) 60%, transparent);
  }
  .git-diff-label {
    font-size: 12px; font-weight: 500;
    color: var(--foreground);
  }
  .git-show-working {
    background: transparent; border: 0;
    font-size: 10px; color: var(--muted-foreground);
    cursor: pointer; margin-left: 8px;
    transition: color var(--duration-fast) ease;
  }
  .git-show-working:hover { color: var(--foreground); }

  {#- Diff body -#}
  .git-diff-body { padding: 0 16px 16px; }
  </style>
</head>
<body>
<div id="ship-view-root" class="ship-view ship-view-git">
  <div class="git-wrap{% if selected_commit %} git-wrap--diff{% endif %}">
    {% if error %}
      {% include 'git/partials/error.html.j2' %}
    {% elif selected_commit %}
      {% include 'git/partials/diff_toolbar.html.j2' %}
      {% include 'git/partials/review_banner.html.j2' %}
      {% include 'git/partials/diff_body.html.j2' %}
    {% else %}
      {% include 'git/partials/header.html.j2' %}
      {% include 'git/partials/review_banner.html.j2' %}
      {% include 'git/partials/status_block.html.j2' %}
      {% include 'git/partials/commit_log.html.j2' %}
    {% endif %}
  </div>
</div>
</body>
</html>
