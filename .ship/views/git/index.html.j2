{#- SDK gaps:
    - no diff_viewer() macro for git diff rendering
    - no toolbar() macro for branch/status toolbar
    - no file_list() macro for changed file listings
    - no commit_log() macro for git log display
    - live() macro does not support query string passthrough (workspace_id)
-#}
{#-
  Git view — single-column, information-dense layout.
  The daemon passes branch, clean, total_changed, staged, modified,
  untracked, commits, selected_commit, completed_jobs, error as Jinja context.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal %}
{% from '_urls.html.j2' import view_git, view_git_sse %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Git') }}
  <style>
  .ship-view-git { color: var(--foreground); }
  .ship-git-wrap { width: 100%; max-width: none; margin: 0; padding: 16px 20px; }
  .ship-git-wrap.ship-git-wrap-detail { padding: 0; }
  .ship-git-header {
    display: flex; align-items: center; gap: 8px; padding: 0 4px; margin-bottom: 12px;
  }
  .ship-git-header h1 {
    font-family: var(--font-display); font-size: 18px; font-weight: 600;
    letter-spacing: -0.01em; margin: 0;
  }
  .ship-git-header-icon { color: var(--muted-foreground); }
  .ship-git-state { font-size: 11px; margin-left: 8px; }
  .ship-git-state.clean { color: var(--success); }
  .ship-git-state.dirty { color: var(--warning); }
  .ship-git-review-banner {
    display: flex; align-items: flex-start; gap: 8px; margin: 0 16px 12px;
    padding: 8px 12px; border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklch, var(--success) 35%, transparent);
    background: color-mix(in oklch, var(--success) 10%, transparent);
  }
  .ship-git-review-banner ship-icon { color: var(--success); flex-shrink: 0; margin-top: 1px; }
  .ship-git-review-banner p { font-size: 12px; color: var(--foreground); margin: 0; }
  .ship-git-review-banner strong { font-weight: 500; }
  .ship-git-section { padding: 0 4px; margin-bottom: 12px; }
  .ship-git-toolbar {
    display: flex; align-items: center; gap: 8px; padding: 6px 10px;
    margin-bottom: 12px; border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--muted) 25%, transparent);
  }
  .ship-git-toolbar-chip {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    color: var(--foreground); padding: 2px 8px; border-radius: 9999px;
    border: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    background: var(--background);
  }
  .ship-git-toolbar-meta { font-size: 11px; color: var(--muted-foreground); }
  .ship-git-toolbar-spacer { flex: 1; }
  .ship-git-toolbar-link {
    display: inline-flex; align-items: center; gap: 4px; font-size: 11px;
    color: var(--primary); background: transparent; border: 0; cursor: pointer;
    padding: 2px 6px; border-radius: var(--radius-sm);
  }
  .ship-git-toolbar-link:hover {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
  }
  .ship-git-breakdown {
    display: flex; gap: 12px; font-size: 10px; color: var(--muted-foreground);
    margin-bottom: 10px;
  }
  .ship-git-breakdown span { display: inline-flex; align-items: center; gap: 4px; }
  .ship-git-file-list {
    display: flex; flex-direction: column; gap: 1px; margin-bottom: 12px;
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    border-radius: var(--radius-md); overflow: hidden;
  }
  .ship-git-file-row {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 5px 10px;
    min-height: 26px; background: transparent; border: 0;
    font-family: var(--font-mono); font-size: 12px; color: var(--foreground);
    cursor: pointer; text-align: left;
    transition: background var(--duration-fast) ease;
  }
  .ship-git-file-row + .ship-git-file-row {
    border-top: 1px solid color-mix(in oklch, var(--border) 35%, transparent);
  }
  .ship-git-file-row:hover {
    background: color-mix(in oklch, var(--muted) 50%, transparent);
  }
  .ship-git-file-name {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .ship-git-view-diff { width: 100%; }
  .ship-git-view-diff ship-button { width: 100%; display: block; }
  .ship-git-view-diff ship-button::part(button) { width: 100%; justify-content: center; }
  .ship-git-divider {
    border-top: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    margin: 0 12px 12px;
  }
  .ship-git-log-heading {
    font-size: 10px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in oklch, var(--muted-foreground) 75%, transparent);
    padding: 0 12px; margin-bottom: 8px;
  }
  .ship-git-log { display: flex; flex-direction: column; gap: 2px; padding: 0 8px; }
  .ship-git-commit {
    display: block; width: 100%; text-align: left; background: transparent;
    border: 0; padding: 8px; border-radius: var(--radius-md); cursor: pointer;
    transition: background var(--duration-fast) ease;
  }
  .ship-git-commit:hover {
    background: color-mix(in oklch, var(--muted) 50%, transparent);
  }
  .ship-git-commit-subject {
    font-size: 13px; color: var(--muted-foreground); line-height: 1.35;
    transition: color var(--duration-fast) ease;
  }
  .ship-git-commit:hover .ship-git-commit-subject { color: var(--foreground); }
  .ship-git-commit-meta {
    display: flex; align-items: center; gap: 8px; margin-top: 4px;
    font-size: 10px;
    color: color-mix(in oklch, var(--muted-foreground) 65%, transparent);
  }
  .ship-git-commit-sha { font-family: var(--font-mono); }
  .ship-git-commit-meta .spacer { flex: 1; }
  .ship-git-commit-meta .hint {
    opacity: 0; transition: opacity var(--duration-fast) ease;
    color: var(--muted-foreground);
  }
  .ship-git-commit:hover .ship-git-commit-meta .hint { opacity: 0.6; }
  .ship-git-empty {
    font-size: 10px;
    color: color-mix(in oklch, var(--muted-foreground) 65%, transparent);
    padding: 0 12px;
  }
  .ship-git-diff-header {
    display: flex; align-items: center; gap: 8px; padding: 0 12px; margin-bottom: 12px;
  }
  .ship-git-back {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: var(--radius-md);
    background: transparent; border: 0; color: var(--foreground); cursor: pointer;
    transition: background var(--duration-fast) ease;
  }
  .ship-git-back:hover {
    background: color-mix(in oklch, var(--muted) 60%, transparent);
  }
  .ship-git-diff-title { font-size: 12px; font-weight: 500; }
  .ship-git-show-working {
    background: transparent; border: 0; font-size: 10px;
    color: var(--muted-foreground); cursor: pointer; margin-left: 8px;
    transition: color var(--duration-fast) ease;
  }
  .ship-git-show-working:hover { color: var(--foreground); }
  .ship-git-diff-body { padding: 0 12px; }
  </style>
</head>
<body>
<div id="git-root" class="ship-view ship-view-git"
     {{ signal('commit', selected_commit.sha if selected_commit else '') }}>
  <div class="ship-git-wrap{% if selected_commit %} ship-git-wrap-detail{% endif %}">
    <div data-init="@get('{{ view_git_sse() }}{% if workspace_id %}?workspace_id={{ workspace_id }}{% endif %}')">
      <div id="git-content">
        <p style="padding: 16px 0; font-size: 11px; color: var(--muted-foreground)">Loading...</p>
      </div>
    </div>
  </div>
</div>
</body>
</html>
