{#- SDK gaps:
    - no diff_viewer() macro for git diff rendering
    - no toolbar() macro for branch/status toolbar
    - no file_list() macro for changed file listings
    - no commit_log() macro for git log display
-#}
{#-
  Git view — single-column, information-dense layout.
  The daemon passes branch, clean, total_changed, staged, modified,
  untracked, commits, selected_commit, completed_jobs, error as Jinja context.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal, on %}
{% from '_urls.html.j2' import view_git, view_git_sse %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Git') }}
  <style>
  .git-wrap { width: 100%; padding: var(--space-4); }
  .git-wrap.git-wrap-detail { padding: 0; }
  .git-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
  .git-header h1 { font-family: var(--font-display); font-size: var(--text-md); font-weight: var(--font-weight-semibold); }
  .git-review-banner { display: flex; gap: var(--space-2); margin-bottom: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius-lg); border: 1px solid color-mix(in oklch, var(--success) 35%, transparent); background: color-mix(in oklch, var(--success) 10%, transparent); }
  .git-breakdown { display: flex; gap: var(--space-3); font-size: var(--text-xs); color: var(--muted-foreground); margin-bottom: var(--space-3); }
  .git-breakdown span { display: inline-flex; align-items: center; gap: var(--space-1); }
  .git-log-heading { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); }
  .git-commit { display: block; width: 100%; text-align: left; background: transparent; border: 0; padding: var(--space-2); border-radius: var(--radius-md); cursor: pointer; }
  .git-commit:hover { background: var(--muted); }
  .git-commit-subject { font-size: var(--text-sm); color: var(--muted-foreground); }
  .git-commit:hover .git-commit-subject { color: var(--foreground); }
  .git-commit-meta { font-size: var(--text-xs); color: var(--muted-foreground); }
  .git-commit-sha { font-family: var(--font-mono); }
  </style>
</head>
<body>
<div id="git-root" class="ship-view"
     {{ signal('commit', selected_commit.sha if selected_commit else '') }}>
  <div class="git-wrap{% if selected_commit %} git-wrap-detail{% endif %}">
    <div data-init="@get('{{ view_git_sse() }}{% if workspace_id %}?workspace_id={{ workspace_id }}{% endif %}')">
      <div id="git-content">
        <p>Loading...</p>
      </div>
    </div>
  </div>
</div>
</body>
</html>
