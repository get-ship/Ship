{#-
  Pipelines content — dispatches on active_tab signal.
  Root element MUST have id="pipelines-content" for Datastar patching.
  Composed from ship-components: <ship-pipeline-run>, <ship-pipeline-dag>,
  <ship-pipeline-step>, <ship-empty-state>, <ship-chip>, <ship-alert>.
-#}
{% from '_urls.html.j2' import create_job, end_job, view_pipelines %}
{% macro render_run(run, allow_stop) -%}
  {# Normalize legacy `gate-pending` → `gatepending` for ship-pipeline-run. #}
  {% set run_state = run.state | replace('-', '') %}
  <ship-pipeline-run state="{{ run_state }}" slug="{{ run.slug }}" agent="{{ run.agent }}">
    <ship-timestamp slot="actions" value="{{ run.updated_at }}" relative></ship-timestamp>
    <ship-button slot="actions" variant="ghost" size="sm"
      data-on:click="
        const s = document.getElementById('logs-{{ run.slug }}');
        s.active = !s.active;
        evt.currentTarget.setAttribute('tone', s.active ? 'accent' : 'default');
      ">
      <ship-icon slot="leading" name="terminal"></ship-icon>
      Logs
    </ship-button>
    {% if allow_stop and (run.state == 'dispatched' or run.state == 'pending') %}
    <ship-button slot="actions" variant="outline" size="sm" tone="destructive"
      data-on:click="@post('{{ end_job() }}', {contentType: 'json', body: JSON.stringify({job_id: '{{ run.job_id }}'})})">
      <ship-icon slot="leading" name="stop"></ship-icon>
      Stop
    </ship-button>
    {% endif %}

    <div class="ship-run-detail">
      {% if run.branch %}<code>{{ run.branch }}</code>{% endif %}
      {% if run.provider %}<span>{{ run.provider }}</span>{% endif %}
      {% if run.model %}<span>{{ run.model }}</span>{% endif %}
    </div>

    {% if run.blocker %}
    <ship-alert tone="warning" compact>Blocked: {{ run.blocker }}</ship-alert>
    {% endif %}

    {% if run.error %}
      {% set error_lines = run.error.split('\n') %}
      {% if error_lines | length > 1 %}
      <ship-collapsible>
        <ship-alert slot="trigger" tone="destructive" compact>
          Error: {{ error_lines[0] }}
        </ship-alert>
        <ship-code language="text">{{ run.error }}</ship-code>
      </ship-collapsible>
      {% else %}
      <ship-alert tone="destructive" compact>Error: {{ run.error }}</ship-alert>
      {% endif %}
    {% endif %}

    {% if run.depends_on and run.depends_on | length > 0 %}
    <div class="ship-run-deps">
      <span class="ship-run-deps-label">depends on:</span>
      {% for dep in run.depends_on %}<ship-chip size="sm">{{ dep }}</ship-chip>{% endfor %}
    </div>
    {% endif %}

    {% if run.steps and run.steps | length > 0 %}
    <ship-pipeline-dag>
      {% for step in run.steps %}
      <ship-pipeline-step
        name="{{ step.id }}"
        state="{{ step.state }}"
        step-type="{{ step.step_type }}"
        {% if step.agent %}agent="{{ step.agent }}"{% endif %}></ship-pipeline-step>
      {% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}
      {% endfor %}
    </ship-pipeline-dag>
    {% endif %}

    <ship-log-stream slot="footer"
      id="logs-{{ run.slug }}"
      url="/api/runtime/jobs/{{ run.slug }}/log/stream"
      autoscroll></ship-log-stream>
  </ship-pipeline-run>
{%- endmacro %}

<div id="pipelines-content" class="ship-pipelines-content">
  {% if active_tab == 'definitions' %}
    <div class="ship-def-templates-head">
      <span class="ship-def-templates-desc">Pipeline templates define multi-step agent workflows.</span>
    </div>
    {% if defs and defs | length > 0 %}
    <div class="ship-pipelines-def-list">
      {% for def in defs %}
      <ship-card>
        <div class="ship-def-header" tabindex="0" role="button" aria-expanded="false">
          <ship-icon name="git-merge" size="sm" tone="muted"></ship-icon>
          <span class="ship-def-name">{{ def.name }}</span>
          <span class="ship-def-desc">{{ def.description }}</span>
          <ship-chip size="sm">{{ def.step_count }} step{{ 's' if def.step_count != 1 else '' }}</ship-chip>
          <ship-icon name="chevron-right" size="xs" tone="muted"></ship-icon>
        </div>
      </ship-card>
      {% endfor %}
    </div>
    {% else %}
    <ship-empty-state icon="git-merge" heading="No pipeline templates" description="Create a pipeline in .ship/pipelines/"></ship-empty-state>
    {% endif %}

  {% elif active_tab == 'history' %}
    {% if history_runs and history_runs | length > 0 %}
    <div class="ship-pipelines-run-list">
      {% for run in history_runs %}{{ render_run(run, false) }}{% endfor %}
    </div>
    {% if stats.history > history_runs | length %}
    <p class="ship-pipelines-load-more">
      <ship-chip size="sm"
        data-on:click="@get('{{ view_pipelines() }}?tab=history')">
        Load {{ stats.history - (history_runs | length) }} more
      </ship-chip>
    </p>
    {% endif %}
    {% else %}
    <ship-empty-state icon="list" heading="No completed runs" description="Completed, merged, and failed runs will appear here."></ship-empty-state>
    {% endif %}

  {% else %}
    {% if active_runs and active_runs | length > 0 %}
    <div class="ship-pipelines-run-list">
      {% for run in active_runs %}{{ render_run(run, true) }}{% endfor %}
    </div>
    {% else %}
    <ship-empty-state icon="play" heading="No active runs" description="Dispatch a pipeline from the command line: ship run &lt;pipeline&gt; --spec &lt;path&gt;"></ship-empty-state>
    {% endif %}
  {% endif %}
</div>
