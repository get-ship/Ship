{#-
  Pipelines content — pipeline-first layout.

  Each entry in `defs` is a PipelineDef (name, description, step_count,
  total_runs, success_runs, failed_runs, active_runs, success_rate,
  last_run_{at,status,tone,slug}). Active runs across all pipelines
  still render as a prominent section at the top so operators see
  what's live without drilling into a specific pipeline.
-#}
{% from '_urls.html.j2' import end_job %}

<div id="pipelines-content" class="ship-pipelines-content">

  {# ── Active runs (all pipelines) ───────────────────────────────── #}
  {% if active_runs and active_runs | length > 0 %}
  <div class="ship-pipelines-section">
    <div class="ship-pipelines-section-head">
      <h2 class="ship-pipelines-section-title">
        <ship-icon name="play" size="sm" tone="info"></ship-icon>
        Active runs
      </h2>
      <ship-badge tone="info">{{ active_runs | length }}</ship-badge>
    </div>
    <div class="ship-pipelines-run-list" data-view-enter>
      {% for run in active_runs %}
        {% set run_state = run.state | replace('-', '') %}
        <ship-pipeline-run state="{{ run_state }}" slug="{{ run.slug }}" agent="{{ run.agent }}">
          <ship-timestamp slot="actions" value="{{ run.updated_at }}" relative></ship-timestamp>
          <ship-button slot="actions" variant="ghost" size="sm"
            data-on:click="window.location.href='/pipelines/run/{{ run.slug }}'">
            <ship-icon slot="leading" name="chevron-right"></ship-icon>
            Open
          </ship-button>
          <ship-button slot="actions" variant="outline" size="sm" tone="destructive"
            data-on:click="@post('{{ end_job() }}', {contentType: 'json', body: JSON.stringify({job_id: '{{ run.job_id }}'})})">
            <ship-icon slot="leading" name="stop"></ship-icon>
            Stop
          </ship-button>

          <div class="ship-run-detail">
            {% if run.agent %}
            <ship-avatar size="sm" shape="circle" identity-hue="{{ run.agent }}"
              name="{{ run.agent }}" title="{{ run.agent }}"></ship-avatar>
            {% endif %}
            {% if run.branch %}<code>{{ run.branch }}</code>{% endif %}
            {% if run.provider %}
            <ship-provider-blob provider="{{ run.provider }}" size="sm" variant="glyph"
              title="{{ run.provider }}"></ship-provider-blob>
            {% endif %}
            {% if run.model %}<ship-chip size="sm">{{ run.model }}</ship-chip>{% endif %}
          </div>

          {% if run.blocker %}
          <ship-alert tone="warning" compact>Blocked: {{ run.blocker }}</ship-alert>
          {% endif %}

          {% if run.steps and run.steps | length > 0 %}
          <ship-pipeline-dag>
            {% for step in run.steps %}
            <ship-pipeline-step
              name="{{ step.id }}"
              state="{{ step.state }}"
              step-type="{{ step.step_type }}"
              {% if step.agent %}agent="{{ step.agent }}"{% endif %}></ship-pipeline-step>
            {% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}
            {% endfor %}
          </ship-pipeline-dag>
          {% endif %}

          <ship-log-stream slot="footer"
            id="logs-{{ run.slug }}"
            url="/api/runtime/jobs/{{ run.slug }}/log/stream"
            autoscroll></ship-log-stream>
        </ship-pipeline-run>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# ── Pipelines list ───────────────────────────────────────────── #}
  <div class="ship-pipelines-section">
    <div class="ship-pipelines-section-head">
      <h2 class="ship-pipelines-section-title">
        <ship-icon name="git-merge" size="sm"></ship-icon>
        Pipelines
      </h2>
      <ship-badge tone="muted">{{ defs | length }}</ship-badge>
    </div>
    {% if defs and defs | length > 0 %}
    <div class="ship-pipelines-def-list" data-view-enter>
      {% for def in defs %}
      {% set tile_tone = 'info' if (def.active_runs and def.active_runs > 0) else (def.last_run_tone or 'muted') %}
      <ship-card interactive status-rail tone="{{ tile_tone }}"
        data-on:click="window.location.href='/pipelines/pipeline/{{ def.name }}'">
        <div class="ship-def-title">
          <span class="ship-def-name">{{ def.name }}</span>
          {% if def.active_runs and def.active_runs > 0 %}
          <ship-badge tone="info">{{ def.active_runs }} running</ship-badge>
          {% endif %}
        </div>
        {% if def.description %}
        <p class="ship-def-desc">{{ def.description }}</p>
        {% endif %}
        <div class="ship-def-chips">
          <ship-chip size="sm" tone="muted">{{ def.step_count }} step{{ 's' if def.step_count != 1 else '' }}</ship-chip>
          {% if def.last_run_status %}
          <ship-chip size="sm" tone="{{ def.last_run_tone or 'muted' }}">{{ def.last_run_status }}</ship-chip>
          {% endif %}
          {% if def.recent_outcomes and def.recent_outcomes | length > 0 %}
          <span class="ship-def-spark" aria-label="Last {{ def.recent_outcomes | length }} run outcomes">
            {% for outcome in def.recent_outcomes %}
            <span class="ship-def-spark-cell ship-def-spark-{{ outcome | replace('-', '') }}"
              title="{{ outcome }}"></span>
            {% endfor %}
          </span>
          {% endif %}
        </div>
        <div slot="footer" class="ship-def-stats">
          {% if def.total_runs and def.total_runs > 0 %}
            <span class="ship-def-stat">
              <span class="ship-def-stat-value">{{ def.total_runs }}</span>
              <span class="ship-def-stat-label">runs</span>
            </span>
            <span class="ship-def-stat">
              <span class="ship-def-stat-value">{{ (def.success_rate * 100) | int }}<span class="ship-def-stat-unit">%</span></span>
              <span class="ship-def-stat-label">success</span>
            </span>
            {% if def.last_run_at %}
            <span class="ship-def-stat ship-def-stat-grow">
              <span class="ship-def-stat-value ship-def-stat-time">
                <ship-timestamp value="{{ def.last_run_at }}" relative></ship-timestamp>
              </span>
              <span class="ship-def-stat-label">last run</span>
            </span>
            {% endif %}
          {% else %}
            <span class="ship-def-stat-empty">No runs yet — click to dispatch</span>
          {% endif %}
        </div>
      </ship-card>
      {% endfor %}
    </div>
    {% else %}
    <ship-empty-state icon="git-merge" heading="No pipelines"
      description="Define a pipeline in .ship/pipelines/ to see it here."></ship-empty-state>
    {% endif %}
  </div>

</div>
