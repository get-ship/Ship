{#- Layout styles for the pipelines view. Component-internal styling
    lives inside each <ship-*> element; this file covers only the
    surrounding page layout. -#}
<style>
.ship-pipelines-section {
  margin-bottom: var(--space-6);
}
.ship-pipelines-section-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}
.ship-pipelines-section-title {
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: 0;
  color: var(--foreground);
  letter-spacing: -0.01em;
}
.ship-pipelines-run-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.ship-pipelines-def-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));
  gap: var(--space-3);
}

/* Run detail line inside ship-pipeline-run default slot. */
.ship-run-detail {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-items: center;
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  margin-bottom: var(--space-2);
}
.ship-run-detail code {
  font-family: var(--font-mono);
  background: color-mix(in oklch, var(--muted) 50%, transparent);
  padding: 1px 6px;
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
}

/* Pipeline definition cards. */
.ship-def-card-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  cursor: pointer;
}
.ship-def-card-head {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.ship-def-card-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.ship-def-name {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
}
.ship-def-desc {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  margin: 0;
  line-height: 1.5;
}
.ship-def-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-5);
  padding-top: var(--space-2);
  border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
}
.ship-def-meta-cell {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: var(--text-xs);
}
.ship-def-meta-label {
  font-size: var(--text-xs);
  color: color-mix(in oklch, var(--muted-foreground) 70%, transparent);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: var(--font-weight-medium);
}
.ship-def-meta-value {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
  font-variant-numeric: tabular-nums;
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.ship-def-meta-empty {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  font-style: italic;
}
</style>
