{#- Layout styles for the pipelines view. Component-internal styling
    lives inside each <ship-*> element; this file covers only the
    surrounding page layout. -#}
<style>
.ship-pipelines-section {
  margin-bottom: var(--space-8);
}
.ship-pipelines-section-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}
.ship-pipelines-section-title {
  font-family: var(--font-display);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: 0;
  color: var(--muted-foreground);
}
.ship-pipelines-run-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

/* Pipeline definition tiles — grid of interactive cards. */
.ship-pipelines-def-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
  gap: var(--space-4);
}
.ship-def-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}
.ship-def-name {
  font-family: var(--font-mono);
  font-size: var(--text-base);
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  letter-spacing: -0.005em;
}
.ship-def-desc {
  font-size: var(--text-sm);
  color: var(--muted-foreground);
  margin: 0 0 var(--space-3);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ship-def-chips {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  align-items: center;
}
.ship-def-stats {
  display: flex;
  align-items: baseline;
  gap: var(--space-5);
}
.ship-def-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.ship-def-stat-grow { margin-left: auto; align-items: flex-end; text-align: right; }
.ship-def-stat-value {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-semibold);
  font-variant-numeric: tabular-nums;
  color: var(--foreground);
  letter-spacing: -0.01em;
  line-height: 1.1;
  display: inline-flex;
  align-items: baseline;
  gap: 1px;
}
.ship-def-stat-unit {
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
}
.ship-def-stat-time { font-size: var(--text-sm); font-weight: var(--font-weight-medium); }
.ship-def-stat-label {
  font-size: 10px;
  color: var(--muted-foreground);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: var(--font-weight-medium);
}
.ship-def-stat-empty {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  font-style: italic;
}

/* Run detail line inside ship-pipeline-run default slot. */
.ship-run-detail {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-items: center;
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  margin-bottom: var(--space-2);
}
.ship-run-detail code {
  font-family: var(--font-mono);
  background: color-mix(in oklch, var(--muted) 50%, transparent);
  padding: 1px 6px;
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
}

/* Run-outcome sparkline — tiny strip in the list tile, reads left→right
   as old→new. Each cell is tone-tinted via a status class; hover tooltip
   exposes the raw status token for accessibility. */
.ship-def-spark {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  margin-left: auto;
  padding: 0;
}
.ship-def-spark-cell {
  display: inline-block;
  width: 4px;
  height: 14px;
  border-radius: 2px;
  background: var(--muted);
  transition: transform var(--duration-fast) var(--ease-out);
}
.ship-def-spark-cell:hover { transform: scaleY(1.12); }
.ship-def-spark-completed,
.ship-def-spark-merged { background: var(--success); }
.ship-def-spark-failed { background: var(--destructive); }
.ship-def-spark-blocked { background: var(--warning); }
.ship-def-spark-dispatched,
.ship-def-spark-gatepending,
.ship-def-spark-pending { background: var(--info); }
.ship-def-spark-cancelled { background: color-mix(in oklch, var(--muted-foreground) 45%, transparent); }
</style>
