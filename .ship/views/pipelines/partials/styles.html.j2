{#- Content styles for pipelines view — remaining non-component layout only.
    Run cards are <ship-pipeline-run>; steps are <ship-pipeline-step>; errors
    are <ship-alert> / <ship-collapsible>; depends-on tags are <ship-chip>.
    This file covers only the surrounding layout that isn't a component. -#}
<style>
.ship-pipelines-run-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.ship-run-detail {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-items: center;
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  margin-bottom: var(--space-2);
}
.ship-run-detail code {
  font-family: var(--font-mono);
  background: color-mix(in oklch, var(--muted) 50%, transparent);
  padding: 1px 6px;
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
}
.ship-run-deps {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  flex-wrap: wrap;
  margin: var(--space-2) 0;
}
.ship-run-deps-label {
  font-size: var(--text-xs);
  color: color-mix(in oklch, var(--muted-foreground) 50%, transparent);
}

/* Definitions tab — templates list. */
.ship-pipelines-def-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.ship-def-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  cursor: pointer;
}
.ship-def-name { font-size: var(--text-sm); font-weight: var(--font-weight-semibold); }
.ship-def-desc {
  font-size: var(--text-xs);
  color: color-mix(in oklch, var(--muted-foreground) 60%, transparent);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.ship-def-templates-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}
.ship-def-templates-desc {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
}
.ship-pipelines-load-more {
  text-align: center;
  margin: var(--space-4) 0 var(--space-1);
}
</style>
