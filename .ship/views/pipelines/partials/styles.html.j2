{#- Content styles for pipelines view — extracted to stay under 300-line cap. -#}
<style>
/* --- Run card --- */
.ship-run-card {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
  background: var(--card);
  border-radius: 0.5rem;
  padding: 1rem;
  transition: border-color 0.15s;
}
.ship-run-card:hover { border-color: var(--border); }
.ship-run-dot { flex-shrink: 0; margin-top: 0.375rem; }
.ship-run-body { flex: 1; min-width: 0; }
.ship-run-title-row { display: flex; align-items: center; gap: 0.5rem; }
.ship-run-slug {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--foreground);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ship-run-status { font-size: 10px; font-weight: 500; }
.ship-run-detail {
  font-size: 0.75rem;
  color: color-mix(in oklch, var(--muted-foreground) 60%, transparent);
  margin-top: 0.125rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ship-run-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.25rem;
  flex-shrink: 0;
  margin-top: 0.125rem;
}
.ship-run-when {
  font-size: 11px;
  color: color-mix(in oklch, var(--muted-foreground) 50%, transparent);
}

/* --- Banners --- */
.ship-run-banner {
  margin-top: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.375rem 0.75rem;
  font-size: 0.75rem;
}
.ship-run-banner.blocker,
.ship-run-banner.error {
  border: 1px solid color-mix(in oklch, var(--destructive) 20%, transparent);
  background: color-mix(in oklch, var(--destructive) 5%, transparent);
  color: var(--destructive);
}

/* --- Depends-on tags --- */
.ship-run-deps {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  flex-wrap: wrap;
  margin-top: 0.375rem;
}
.ship-run-deps-label {
  font-size: 10px;
  color: color-mix(in oklch, var(--muted-foreground) 50%, transparent);
}
.ship-run-dep-tag {
  font-size: 10px;
  padding: 0.125rem 0.375rem;
  border-radius: 0.25rem;
  border: 1px solid var(--border);
  color: var(--muted-foreground);
}

/* --- Step progress pills --- */
.ship-run-steps {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  margin-top: 0.5rem;
}
.ship-step-pill {
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 10px;
  font-weight: 500;
}
.ship-step-pill.done {
  background: color-mix(in oklch, var(--success) 10%, transparent);
  color: var(--success);
}
.ship-step-pill.running {
  background: color-mix(in oklch, var(--info) 10%, transparent);
  color: var(--info);
  box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--info) 30%, transparent);
}
.ship-step-pill.pending {
  background: color-mix(in oklch, var(--muted) 30%, transparent);
  color: color-mix(in oklch, var(--muted-foreground) 60%, transparent);
}
.ship-step-pill.failed {
  background: color-mix(in oklch, var(--destructive) 10%, transparent);
  color: var(--destructive);
}

/* --- Stop button --- */
.ship-run-stop {
  font-size: 10px;
  color: var(--muted-foreground);
  cursor: pointer;
  background: none;
  border: none;
  padding: 0.125rem 0.375rem;
  border-radius: 0.25rem;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  transition: color 0.15s, background 0.15s;
}
.ship-run-stop:hover {
  color: var(--destructive);
  background: color-mix(in oklch, var(--destructive) 10%, transparent);
}

/* --- Definitions --- */
.ship-pipelines-def-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.ship-def-card {
  border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
  background: var(--card);
  border-radius: 0.5rem;
  overflow: hidden;
}
.ship-def-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  cursor: pointer;
  transition: background 0.15s;
}
.ship-def-header:hover {
  background: color-mix(in oklch, var(--muted) 20%, transparent);
}
.ship-def-name { font-size: 0.875rem; font-weight: 600; }
.ship-def-desc {
  font-size: 0.75rem;
  color: color-mix(in oklch, var(--muted-foreground) 60%, transparent);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.ship-def-steps-count {
  font-size: 10px;
  color: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
  flex-shrink: 0;
}
.ship-def-templates-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.ship-def-templates-desc {
  font-size: 0.75rem;
  color: var(--muted-foreground);
}
.ship-pipelines-load-more {
  text-align: center;
  margin: 1rem 0 0.25rem;
}
</style>
