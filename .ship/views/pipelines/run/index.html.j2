{#-
  Run detail — single run, full timeline, per-step observations,
  live log tail. Composed from ship-components. No hand-rolled cards.

  Context: RunDetailCtx
    slug, run (RunView), observations (StepObservationRow[]),
    timeline (TimelineRow[])
-#}
{% from '_ship.html.j2' import head, signal %}
{% from '_urls.html.j2' import view_pipelines, end_job %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head(run.slug) }}</head>
<body>
{% endif %}
{#- Shell provides <main id="ship-view-root">; classes do the styling. -#}
<div class="ship-view ship-view-run-detail">
  <style>
  .ship-view-run-detail {
    color: var(--foreground);
    background: var(--background);
  }
  .ship-run-detail-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .ship-run-detail-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .ship-run-detail-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .ship-run-detail-slug {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }
  .ship-run-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    margin-top: var(--space-1);
  }
  .ship-run-detail-meta code {
    font-family: var(--font-mono);
    background: color-mix(in oklch, var(--muted) 50%, transparent);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }
  .ship-run-detail-section-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0 0 var(--space-2);
    letter-spacing: -0.01em;
  }
  .ship-obs-row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    font-size: var(--text-xs);
  }
  .ship-obs-row:first-child { border-top: none; }
  .ship-obs-name {
    font-family: var(--font-mono);
    font-weight: var(--font-weight-medium);
  }
  .ship-obs-meta {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .ship-timeline-scroll {
    max-height: 28rem;
    overflow-y: auto;
  }
  </style>

  <div class="ship-run-detail-wrap">
    <div class="ship-run-detail-head">
      <div>
        <div class="ship-run-detail-title-row">
          <ship-button size="sm" variant="ghost"
            data-on:click="window.location.href='/pipelines'">
            <ship-icon slot="leading" name="chevron-left"></ship-icon>
            All runs
          </ship-button>
          <span class="ship-run-detail-slug">{{ run.slug }}</span>
          <ship-badge tone="{{ run.tone }}">{{ run.status_text }}</ship-badge>
        </div>
        <div class="ship-run-detail-meta">
          <code>{{ run.agent }}</code>
          {% if run.branch %}<span>{{ run.branch }}</span>{% endif %}
          {% if run.provider %}<span>{{ run.provider }}</span>{% endif %}
          {% if run.model %}<span>{{ run.model }}</span>{% endif %}
          <ship-timestamp value="{{ run.updated_at }}" relative></ship-timestamp>
        </div>
      </div>
      <div style="display: flex; gap: var(--space-2);">
        {% if run.state == 'dispatched' or run.state == 'pending' %}
        <ship-button variant="outline" size="sm" tone="destructive"
          data-on:click="@post('{{ end_job() }}', {contentType: 'json', body: JSON.stringify({job_id: '{{ run.job_id }}'})})">
          <ship-icon slot="leading" name="stop"></ship-icon>
          Stop
        </ship-button>
        {% endif %}
      </div>
    </div>

    {% if run.error %}
      {% set error_lines = run.error.split('\n') %}
      {% if error_lines | length > 1 %}
      <ship-collapsible>
        <ship-alert slot="trigger" tone="destructive" compact>
          Error: {{ error_lines[0] }}
        </ship-alert>
        <ship-code language="text">{{ run.error }}</ship-code>
      </ship-collapsible>
      {% else %}
      <ship-alert tone="destructive" compact>Error: {{ run.error }}</ship-alert>
      {% endif %}
    {% endif %}

    {% if run.steps and run.steps | length > 0 %}
    <ship-card>
      <h3 slot="header" class="ship-run-detail-section-title">Pipeline</h3>
      <ship-pipeline-dag>
        {% for step in run.steps %}
        <ship-pipeline-step
          name="{{ step.id }}"
          state="{{ step.state }}"
          step-type="{{ step.step_type }}"
          {% if step.agent %}agent="{{ step.agent }}"{% endif %}></ship-pipeline-step>
        {% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}
        {% endfor %}
      </ship-pipeline-dag>
    </ship-card>
    {% endif %}

    {% if observations and observations | length > 0 %}
    <ship-card>
      <h3 slot="header" class="ship-run-detail-section-title">Step observations</h3>
      {% for obs in observations %}
      <div class="ship-obs-row">
        <span class="ship-obs-name">{{ obs.step_name }}</span>
        <div class="ship-obs-meta">
          <span>{{ obs.trigger }}</span>
          <span>{{ obs.duration_secs }}s</span>
          {% if obs.exit_code is not none %}<span>exit {{ obs.exit_code }}</span>{% endif %}
          {% if obs.commits > 0 %}<span>{{ obs.commits }} commit{{ 's' if obs.commits != 1 else '' }}</span>{% endif %}
          {% if obs.done_declared %}<ship-badge size="sm" tone="success">step_done</ship-badge>{% endif %}
        </div>
        <ship-badge tone="{{ 'success' if obs.succeeded else ('destructive' if obs.verdict == 'Block' else 'muted') }}">{{ obs.verdict }}</ship-badge>
        <span></span>
      </div>
      {% if obs.log_tail %}
      <ship-collapsible>
        <span slot="trigger" class="ship-obs-meta" style="padding: 0 var(--space-3);">log tail</span>
        <ship-code language="text">{{ obs.log_tail }}</ship-code>
      </ship-collapsible>
      {% endif %}
      {% endfor %}
    </ship-card>
    {% endif %}

    <ship-card>
      <h3 slot="header" class="ship-run-detail-section-title">Live log</h3>
      <ship-log-stream
        url="/api/pipelines/runs/{{ run.slug }}/log/stream"
        autoscroll active></ship-log-stream>
    </ship-card>

    {% if timeline and timeline | length > 0 %}
    <ship-card>
      <h3 slot="header" class="ship-run-detail-section-title">Event timeline</h3>
      <div class="ship-timeline-scroll">
        <ship-timeline>
          {% for ev in timeline %}
          <ship-timeline-item>
            <span slot="timestamp"><ship-timestamp value="{{ ev.at }}" relative></ship-timestamp></span>
            <span slot="title">{{ ev.event_type }}</span>
            <span>{{ ev.summary }}</span>
          </ship-timeline-item>
          {% endfor %}
        </ship-timeline>
      </div>
    </ship-card>
    {% endif %}
  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
