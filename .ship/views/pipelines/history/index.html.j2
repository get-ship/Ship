{#-
  Pipelines history — paginated log of every completed run. Data pulled
  via `ship.pipelines.history()`. All filtering/pagination server-side.
-#}
{% from '_ship.html.j2' import head, signal %}

{% set ctx = ship.pipelines.history(
  q=ship.query.q | default(''),
  pipeline=ship.query.pipeline | default(''),
  offset=(ship.query.offset | default('0') | int),
  limit=(ship.query.limit | default('50') | int),
) %}
{% set q = ctx.q %}
{% set pipeline_filter = ctx.pipeline_filter %}
{% set rows = ctx.rows %}
{% set total = ctx.total %}
{% set offset = ctx.offset %}
{% set limit = ctx.limit %}
{% set has_prev = ctx.has_prev %}
{% set has_next = ctx.has_next %}
{% set pipelines = ctx.pipelines %}

{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Pipelines history') }}</head>
<body>
{% endif %}
<div class="ship-view ship-view-pipelines-history"
     {{ signal('hist_q', q) }}
     {{ signal('hist_pipeline', pipeline_filter) }}>
  <style>
  .ship-view-pipelines-history { color: var(--foreground); background: var(--background); }
  .ship-hist-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .ship-hist-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .ship-hist-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--foreground);
  }
  .ship-hist-sub {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin-top: var(--space-1);
  }
  .ship-hist-toolbar {
    display: flex;
    gap: var(--space-3);
    align-items: end;
    flex-wrap: wrap;
  }
  .ship-hist-toolbar ship-field { flex: 1 1 16rem; min-width: 12rem; }
  .ship-hist-toolbar ship-field[data-narrow] { flex: 0 0 14rem; }
  .ship-hist-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .ship-hist-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .ship-hist-table th {
    text-align: left;
    padding: var(--space-3) var(--space-3);
    border-bottom: 1px solid var(--border);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    position: sticky;
    top: 0;
  }
  .ship-hist-table td {
    padding: var(--space-3) var(--space-3);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    vertical-align: middle;
  }
  .ship-hist-table tr:last-child td { border-bottom: none; }
  .ship-hist-table tr:hover td { background: color-mix(in oklch, var(--muted) 30%, transparent); cursor: pointer; }
  .ship-hist-slug {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--foreground);
  }
  .ship-hist-duration, .ship-hist-agent {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }
  .ship-hist-pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .ship-hist-empty {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    color: var(--muted-foreground);
  }
  </style>

  <div class="ship-hist-wrap">
    <header class="ship-hist-head">
      <div>
        <ship-button variant="ghost" size="sm"
          data-on:click="window.location.href='/pipelines'"
          style="margin-bottom: var(--space-2);">
          <ship-icon slot="leading" name="chevron-left" size="xs"></ship-icon>
          All pipelines
        </ship-button>
        <h1 class="ship-hist-title">History</h1>
        <p class="ship-hist-sub">
          {{ total }} run{{ 's' if total != 1 else '' }}
          {% if q %}matching "{{ q }}"{% endif %}
          {% if pipeline_filter %}in <code>{{ pipeline_filter }}</code>{% endif %}
        </p>
      </div>
    </header>

    {# Native GET form — browser serializes signals into the URL, shell
       router matches `/pipelines/history?...` and re-mounts with the
       updated query. No API path hardcoded. #}
    <form class="ship-hist-toolbar" action="/pipelines/history" method="get">
      <ship-field label="Search" hint="Slug, agent, or pipeline name.">
        <ship-input name="q" value="{{ q }}" placeholder="e.g. shell-smoke, rust-lane…"></ship-input>
      </ship-field>
      <ship-field label="Pipeline" data-narrow>
        <ship-select name="pipeline">
          <option value="">(all)</option>
          {% for p in pipelines %}
          <option value="{{ p }}" {% if p == pipeline_filter %}selected{% endif %}>{{ p }}</option>
          {% endfor %}
        </ship-select>
      </ship-field>
      <ship-button type="submit" variant="outline" size="sm">
        <ship-icon slot="leading" name="search" size="sm"></ship-icon>
        Apply
      </ship-button>
      {% if q or pipeline_filter %}
      <ship-button type="button" variant="ghost" size="sm"
        data-on:click="window.location.href='/pipelines/history'">
        Clear
      </ship-button>
      {% endif %}
    </form>

    <div class="ship-hist-table-wrap">
    {% if rows and rows | length > 0 %}
      <table class="ship-hist-table">
        <thead>
          <tr>
            <th>Slug</th>
            <th>Pipeline</th>
            <th>State</th>
            <th>Agent</th>
            <th>Duration</th>
            <th>Finished</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
          <tr data-on:click="window.location.href='/pipelines/run/{{ row.slug }}'">
            <td><span class="ship-hist-slug">{{ row.slug }}</span></td>
            <td>{% if row.pipeline %}<code>{{ row.pipeline }}</code>{% else %}<span class="ship-hist-agent">—</span>{% endif %}</td>
            <td><ship-badge tone="{{ row.tone }}" size="sm">{{ row.state }}</ship-badge></td>
            <td><span class="ship-hist-agent">{{ row.agent or '—' }}</span></td>
            <td><span class="ship-hist-duration">{{ row.duration }}</span></td>
            <td><ship-timestamp value="{{ row.updated_at }}" relative></ship-timestamp></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="ship-hist-empty">
        {% if q or pipeline_filter %}
        No runs match the current filter.
        {% else %}
        No run history yet. Dispatch a pipeline to see runs here.
        {% endif %}
      </div>
    {% endif %}
    </div>

    {% if total > limit %}
    <nav class="ship-hist-pager" aria-label="History pagination">
      <span>
        Showing {{ offset + 1 }}–{{ (offset + (rows | length)) }} of {{ total }}
      </span>
      <div style="display: flex; gap: var(--space-2);">
        {% if has_prev %}
        {% set prev_offset = [offset - limit, 0] | max %}
        <ship-button variant="outline" size="sm"
          data-on:click="window.location.href='/pipelines/history?offset={{ prev_offset }}&limit={{ limit }}{% if q %}&q={{ q }}{% endif %}{% if pipeline_filter %}&pipeline={{ pipeline_filter }}{% endif %}'">
          <ship-icon slot="leading" name="chevron-left" size="sm"></ship-icon>
          Previous
        </ship-button>
        {% endif %}
        {% if has_next %}
        <ship-button variant="outline" size="sm"
          data-on:click="window.location.href='/pipelines/history?offset={{ offset + limit }}&limit={{ limit }}{% if q %}&q={{ q }}{% endif %}{% if pipeline_filter %}&pipeline={{ pipeline_filter }}{% endif %}'">
          Next
          <ship-icon slot="trailing" name="chevron-right" size="sm"></ship-icon>
        </ship-button>
        {% endif %}
      </div>
    </nav>
    {% endif %}
  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
