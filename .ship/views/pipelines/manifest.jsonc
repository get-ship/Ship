{
  "name": "pipelines",
  "type": "html",
  "claims": [],

  // Heavy island bundles this view needs. The `pipelines/focus` sub-route
  // hosts `<ship-code-editor>` for the raw-edit mode (JSONC/YAML definition
  // editing). Loading `editor` pulls in both TipTap + CodeMirror bundles;
  // future pipeline editing surfaces that need markdown get it for free.
  "packs": ["editor"]
}
