{#-
  Pipeline focus — single pipeline: full definition + its runs.
  Context: PipelineFocusCtx { name, def, doc, runs, providers }
-#}
{% from '_ship.html.j2' import head, signal %}
{% from '_urls.html.j2' import end_job %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head(name) }}</head>
<body>
{% endif %}
<div id="ship-view-root" class="ship-view ship-view-pipeline-focus">
  <style>
  .ship-view-pipeline-focus { color: var(--foreground); background: var(--background); }
  .ship-focus-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .ship-focus-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .ship-focus-title-block { display: flex; flex-direction: column; gap: var(--space-2); }
  .ship-focus-breadcrumb {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    width: fit-content;
  }
  .ship-focus-breadcrumb:hover { color: var(--foreground); }
  .ship-focus-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }
  .ship-focus-name {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .ship-focus-desc {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: 1.55;
    margin: 0;
    max-width: 56rem;
  }
  .ship-focus-actions { display: flex; gap: var(--space-2); }

  .ship-focus-section-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0 0 var(--space-2);
    letter-spacing: -0.005em;
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
  }

  .ship-focus-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .ship-focus-stat {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    background: color-mix(in oklch, var(--card) 40%, transparent);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .ship-focus-stat-label {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--font-weight-medium);
  }
  .ship-focus-stat-value {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--foreground);
    letter-spacing: -0.01em;
  }

  .ship-step-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .ship-step-row:first-child { border-top: none; }
  .ship-step-index {
    font-family: var(--font-mono);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    min-width: 2ch;
    padding-top: 2px;
  }
  .ship-step-body { display: flex; flex-direction: column; gap: var(--space-2); }
  .ship-step-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .ship-step-id {
    font-family: var(--font-mono);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    font-size: var(--text-sm);
  }
  .ship-step-meta {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .ship-step-run {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    white-space: pre-wrap;
    color: var(--foreground);
    overflow-x: auto;
  }
  .ship-step-gate {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-xs);
    padding: var(--space-2);
    border-left: 2px solid color-mix(in oklch, var(--warning) 40%, transparent);
    color: var(--muted-foreground);
  }
  .ship-step-gate-rule code {
    font-family: var(--font-mono);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--foreground);
  }
  </style>

  <div class="ship-focus-wrap">
    <header class="ship-focus-head">
      <div class="ship-focus-title-block">
        <a href="/api/runtime/view/pipelines" class="ship-focus-breadcrumb">
          <ship-icon name="chevron-left" size="xs"></ship-icon>
          All pipelines
        </a>
        <h1 class="ship-focus-title">
          {% if def.active_runs and def.active_runs > 0 %}
            <ship-status-dot tone="info" pulse></ship-status-dot>
          {% elif def.last_run_tone %}
            <ship-status-dot tone="{{ def.last_run_tone }}"></ship-status-dot>
          {% else %}
            <ship-status-dot tone="muted"></ship-status-dot>
          {% endif %}
          <span class="ship-focus-name">{{ name }}</span>
          <ship-chip size="sm">{{ def.step_count }} step{{ 's' if def.step_count != 1 else '' }}</ship-chip>
          {% if doc.auto_merge %}<ship-chip size="sm" tone="accent">auto-merge</ship-chip>{% endif %}
          {% if def.active_runs and def.active_runs > 0 %}<ship-badge tone="info">{{ def.active_runs }} running</ship-badge>{% endif %}
        </h1>
        {% if def.description %}
        <p class="ship-focus-desc">{{ def.description }}</p>
        {% endif %}
      </div>
      <div class="ship-focus-actions">
        <ship-button tone="accent" variant="solid"
          data-on:click="document.getElementById('dispatch-dialog').showModal()">
          <ship-icon slot="leading" name="play" size="sm"></ship-icon>
          Dispatch
        </ship-button>
      </div>
    </header>

    {# ── Stats ──────────────────────────────────────────────────── #}
    <div class="ship-focus-stats">
      <div class="ship-focus-stat">
        <span class="ship-focus-stat-label">Total runs</span>
        <span class="ship-focus-stat-value">{{ def.total_runs or 0 }}</span>
      </div>
      <div class="ship-focus-stat">
        <span class="ship-focus-stat-label">Success rate</span>
        <span class="ship-focus-stat-value">{{ (def.success_rate * 100) | int }}%</span>
      </div>
      <div class="ship-focus-stat">
        <span class="ship-focus-stat-label">Active now</span>
        <span class="ship-focus-stat-value">{{ def.active_runs or 0 }}</span>
      </div>
      <div class="ship-focus-stat">
        <span class="ship-focus-stat-label">Last run</span>
        <span class="ship-focus-stat-value" style="font-size: var(--text-sm);">
          {% if def.last_run_at %}<ship-timestamp value="{{ def.last_run_at }}" relative></ship-timestamp>{% else %}—{% endif %}
        </span>
      </div>
    </div>

    {# ── Steps definition ──────────────────────────────────────── #}
    <ship-card>
      <h3 slot="header" class="ship-focus-section-title">Steps</h3>
      {% if doc.steps and doc.steps | length > 0 %}
        {% for step in doc.steps %}
        <div class="ship-step-row">
          <span class="ship-step-index">{{ loop.index }}</span>
          <div class="ship-step-body">
            <div class="ship-step-head">
              <span class="ship-step-id">{{ step.id }}</span>
              {% if step.run %}<ship-chip size="sm" tone="muted">run</ship-chip>
              {% elif step.gate %}<ship-chip size="sm" tone="warning">gate</ship-chip>
              {% elif step.agent %}<ship-chip size="sm" tone="info">agent</ship-chip>
              {% endif %}
              {% if step.after %}<span class="ship-step-meta">after: {{ step.after | join(', ') }}</span>{% endif %}
            </div>
            <div class="ship-step-meta">
              {% if step.agent %}<ship-chip size="sm">{{ step.agent }}</ship-chip>{% endif %}
              {% if step.provider %}<ship-chip size="sm">{{ step.provider }}</ship-chip>{% endif %}
              {% if step.model %}<ship-chip size="sm">{{ step.model }}</ship-chip>{% endif %}
            </div>
            {% if step.run %}
            <pre class="ship-step-run">{{ step.run }}</pre>
            {% endif %}
            {% if step.gate %}
            <div class="ship-step-gate">
              {% if step.gate.require_changed %}
              <span class="ship-step-gate-rule">
                require_changed:
                <code>{{ step.gate.require_changed.match or step.gate.require_changed }}</code>
                {% if step.gate.require_changed.min is defined %}≥ {{ step.gate.require_changed.min }}{% endif %}
              </span>
              {% endif %}
              {% if step.gate.forbid_changed %}
              <span class="ship-step-gate-rule">
                forbid_changed:
                <code>{{ step.gate.forbid_changed.match or step.gate.forbid_changed }}</code>
                {% if step.gate.forbid_changed.min is defined %}≥ {{ step.gate.forbid_changed.min }}{% endif %}
              </span>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      {% else %}
        <p class="ship-focus-desc" style="padding: var(--space-3);">No steps defined.</p>
      {% endif %}
    </ship-card>

    {# ── Runs ──────────────────────────────────────────────────── #}
    <ship-card>
      <h3 slot="header" class="ship-focus-section-title">Recent runs</h3>
      {% if runs and runs | length > 0 %}
        {% for run in runs %}
          {% set run_state = run.state | replace('-', '') %}
          <ship-pipeline-run state="{{ run_state }}" slug="{{ run.slug }}" agent="{{ run.agent }}">
            <ship-timestamp slot="actions" value="{{ run.updated_at }}" relative></ship-timestamp>
            <ship-button slot="actions" variant="ghost" size="sm"
              data-on:click="window.location.href='/api/runtime/view/pipelines/run/{{ run.slug }}'">
              <ship-icon slot="leading" name="chevron-right"></ship-icon>
              Open
            </ship-button>
            {% if run.state == 'dispatched' or run.state == 'pending' %}
            <ship-button slot="actions" variant="outline" size="sm" tone="destructive"
              data-on:click="@post('{{ end_job() }}', {contentType: 'json', body: JSON.stringify({job_id: '{{ run.job_id }}'})})">
              <ship-icon slot="leading" name="stop"></ship-icon>
              Stop
            </ship-button>
            {% endif %}

            <div class="ship-step-meta" style="margin-bottom: var(--space-2);">
              {% if run.branch %}<code style="font-family: var(--font-mono); background: color-mix(in oklch, var(--muted) 40%, transparent); padding: 1px 6px; border-radius: 4px;">{{ run.branch }}</code>{% endif %}
              {% if run.provider %}<ship-chip size="sm">{{ run.provider }}</ship-chip>{% endif %}
            </div>

            {% if run.error %}
              {% if '\n' in run.error %}
              <ship-collapsible>
                <ship-alert slot="trigger" tone="destructive" compact>Error (expand for details)</ship-alert>
                <ship-code language="text">{{ run.error }}</ship-code>
              </ship-collapsible>
              {% else %}
              <ship-alert tone="destructive" compact>Error: {{ run.error }}</ship-alert>
              {% endif %}
            {% endif %}

            {% if run.steps and run.steps | length > 0 %}
            <ship-pipeline-dag>
              {% for step in run.steps %}
              <ship-pipeline-step
                name="{{ step.id }}"
                state="{{ step.state }}"
                step-type="{{ step.step_type }}"
                {% if step.agent %}agent="{{ step.agent }}"{% endif %}></ship-pipeline-step>
              {% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}
              {% endfor %}
            </ship-pipeline-dag>
            {% endif %}
          </ship-pipeline-run>
        {% endfor %}
      {% else %}
        <ship-empty-state icon="play" heading="No runs yet"
          description="Dispatch this pipeline to see it in action."></ship-empty-state>
      {% endif %}
    </ship-card>
  </div>

  {# ── Dispatch dialog (scoped to this pipeline) ────────────────── #}
  <ship-dialog id="dispatch-dialog" size="lg"
    {{ signal('dispatch_spec', '') }}
    {{ signal('dispatch_provider', '') }}
    {{ signal('dispatch_headless', true) }}>
    <span slot="header">Dispatch {{ name }}</span>
    <ship-field label="Spec" hint="Plain text or markdown — what the run should do.">
      <ship-textarea data-bind="dispatch_spec" rows="10"
        placeholder="Describe the work in one or two paragraphs..."></ship-textarea>
    </ship-field>
    <ship-field label="Provider override" hint="Optional — leave blank to use the pipeline's declared providers.">
      <ship-select data-bind="dispatch_provider">
        <option value="">(from pipeline)</option>
        {% for p in providers %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
      </ship-select>
    </ship-field>
    <ship-field>
      <ship-checkbox data-bind="dispatch_headless">Headless (run without tmux)</ship-checkbox>
    </ship-field>
    <div slot="footer">
      <ship-button variant="outline"
        data-on:click="document.getElementById('dispatch-dialog').close()">
        Cancel
      </ship-button>
      <ship-button tone="accent" variant="solid"
        data-on:click="@post('/api/runtime/dispatch', {
          contentType: 'json',
          body: JSON.stringify({
            pipeline: '{{ name }}',
            spec: $dispatch_spec,
            provider: $dispatch_provider || null,
            headless: $dispatch_headless
          })
        }); document.getElementById('dispatch-dialog').close()">
        <ship-icon slot="leading" name="play" size="sm"></ship-icon>
        Dispatch
      </ship-button>
    </div>
  </ship-dialog>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
