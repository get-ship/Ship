{#-
  Pipeline focus — single pipeline: full definition + its runs.
  Ops-center mode: when the pipeline has active runs, the active
  runs section promotes to the top with logs auto-open.

  Context: PipelineFocusCtx { name, def, doc, runs, providers }
-#}
{% from '_ship.html.j2' import head, signal %}
{% from '_urls.html.j2' import end_job %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head(name) }}</head>
<body>
{% endif %}
<div id="ship-view-root" class="ship-view ship-view-pipeline-focus"
     data-pipeline-raw="{{ raw }}"
     {{ signal('edit_mode', false) }}
     {{ signal('edit_draft', raw) }}
     {{ signal('edit_saving', false) }}
     {{ signal('edit_error', '') }}
     {{ signal('edit_error_line', 0) }}
     {{ signal('edit_error_col', 0) }}
     {{ signal('edit_issue_count', 0) }}>
  <style>
  .ship-view-pipeline-focus { color: var(--foreground); background: var(--background); }
  .ship-focus-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .ship-focus-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .ship-focus-title-block { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .ship-focus-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    flex-wrap: wrap;
  }
  .ship-focus-name {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .ship-focus-desc {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: 1.55;
    margin: 0;
    max-width: 56rem;
  }
  .ship-focus-actions { display: flex; gap: var(--space-2); }
  .ship-focus-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .ship-focus-section-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin: 0;
  }
  .ship-focus-stack { display: flex; flex-direction: column; gap: var(--space-3); }
  .ship-focus-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  </style>

  <div class="ship-focus-wrap">
    <header class="ship-focus-head">
      <div class="ship-focus-title-block">
        <ship-button variant="ghost" size="sm"
          data-on:click="window.location.href='/api/runtime/view/pipelines'"
          style="width: fit-content;">
          <ship-icon slot="leading" name="chevron-left" size="xs"></ship-icon>
          All pipelines
        </ship-button>
        <h1 class="ship-focus-title">
          {% if def.active_runs and def.active_runs > 0 %}
            <ship-status-dot tone="info" pulse></ship-status-dot>
          {% elif def.last_run_tone %}
            <ship-status-dot tone="{{ def.last_run_tone }}"></ship-status-dot>
          {% else %}
            <ship-status-dot tone="muted"></ship-status-dot>
          {% endif %}
          <span class="ship-focus-name">{{ name }}</span>
          <ship-chip size="sm">{{ def.step_count }} step{{ 's' if def.step_count != 1 else '' }}</ship-chip>
          {% if doc.auto_merge %}<ship-chip size="sm" tone="accent">auto-merge</ship-chip>{% endif %}
          {% if def.active_runs and def.active_runs > 0 %}
          <ship-badge tone="info">{{ def.active_runs }} running</ship-badge>
          {% endif %}
        </h1>
        {% if def.description %}
        <p class="ship-focus-desc">{{ def.description }}</p>
        {% endif %}
      </div>
      <div class="ship-focus-actions">
        {% if workspace_id %}
        <ship-button variant="outline" data-show="!$edit_mode"
          data-on:click="$edit_mode = true; $edit_draft = {{ raw | tojson }}; $edit_error = ''">
          <ship-icon slot="leading" name="edit-3" size="sm"></ship-icon>
          Edit
        </ship-button>
        <ship-button variant="outline" data-show="$edit_mode"
          data-on:click="window.tryCancelEdit(document.getElementById('ship-view-root'), {{ raw | tojson }})">
          Cancel
        </ship-button>
        <ship-button tone="accent" variant="solid" data-show="$edit_mode"
          data-attr:loading="$edit_saving"
          data-attr:disabled="$edit_saving"
          data-on:click="window.savePipeline('{{ workspace_id }}', '{{ name }}', $edit_draft, document.getElementById('ship-view-root'))">
          <ship-icon slot="leading" name="check" size="sm"></ship-icon>
          Save
        </ship-button>
        <ship-button variant="outline" tone="destructive" size="sm" data-show="$edit_mode"
          data-on:click="document.getElementById('delete-pipeline-dialog').open = true">
          <ship-icon slot="leading" name="trash-2" size="sm"></ship-icon>
          Delete
        </ship-button>
        {% endif %}
        <ship-button tone="accent" variant="solid" data-show="!$edit_mode"
          data-on:click="document.getElementById('dispatch-dialog').showModal()">
          <ship-icon slot="leading" name="play" size="sm"></ship-icon>
          Dispatch
        </ship-button>
      </div>
    </header>

    {# ── Ops center: promote active runs when any are live ─────────── #}
    {% set ops_mode = def.active_runs and def.active_runs > 0 %}
    {% set active_for_pipeline = [] %}
    {% if runs %}
      {% for r in runs %}
        {% if r.state == 'dispatched' or r.state == 'pending' or r.state == 'gate-pending' %}
          {% set _ = active_for_pipeline.append(r) %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if ops_mode and active_for_pipeline | length > 0 %}
    <section>
      <h2 class="ship-focus-section-label" style="margin-bottom: var(--space-3);">
        Ops · active now
      </h2>
      <div class="ship-focus-stack">
        {% for run in active_for_pipeline %}
          {% set run_state = run.state | replace('-', '') %}
          <ship-pipeline-run state="{{ run_state }}" slug="{{ run.slug }}" agent="{{ run.agent }}">
            <ship-timestamp slot="actions" value="{{ run.updated_at }}" relative></ship-timestamp>
            <ship-button slot="actions" variant="ghost" size="sm"
              data-on:click="window.location.href='/api/runtime/view/pipelines/run/{{ run.slug }}'">
              <ship-icon slot="leading" name="chevron-right"></ship-icon>
              Open
            </ship-button>
            <ship-button slot="actions" variant="outline" size="sm" tone="destructive"
              data-on:click="@post('{{ end_job() }}', {contentType: 'json', body: JSON.stringify({job_id: '{{ run.job_id }}'})})">
              <ship-icon slot="leading" name="stop"></ship-icon>
              Stop
            </ship-button>

            {% if run.steps and run.steps | length > 0 %}
            <ship-pipeline-dag>
              {% for step in run.steps %}
              <ship-pipeline-step
                name="{{ step.id }}"
                state="{{ step.state }}"
                step-type="{{ step.step_type }}"
                {% if step.agent %}agent="{{ step.agent }}"{% endif %}></ship-pipeline-step>
              {% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}
              {% endfor %}
            </ship-pipeline-dag>
            {% endif %}

            {# Ops mode: log stream is always open so you see what's happening #}
            <ship-log-stream slot="footer"
              url="/api/runtime/jobs/{{ run.slug }}/log/stream"
              active autoscroll></ship-log-stream>
          </ship-pipeline-run>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# ── Stats ──────────────────────────────────────────────────── #}
    <section>
      <h2 class="ship-focus-section-label" style="margin-bottom: var(--space-3);">
        {% if ops_mode %}Overview{% else %}Stats{% endif %}
      </h2>
      <div class="ship-focus-stats">
        <ship-stat>
          <span slot="label">Total runs</span>
          {{ def.total_runs or 0 }}
        </ship-stat>
        <ship-stat accent="{{ 'success' if def.success_rate >= 0.8 else ('warning' if def.success_rate >= 0.5 else 'destructive') if def.total_runs > 0 else 'default' }}">
          <span slot="label">Success rate</span>
          {{ (def.success_rate * 100) | int }}%
        </ship-stat>
        <ship-stat accent="{{ 'info' if def.active_runs and def.active_runs > 0 else 'default' }}">
          <span slot="label">Active now</span>
          {{ def.active_runs or 0 }}
        </ship-stat>
        <ship-stat>
          <span slot="label">Last run</span>
          {% if def.last_run_at %}
            <ship-timestamp value="{{ def.last_run_at }}" relative></ship-timestamp>
            {% if def.last_run_status %}
            <ship-badge slot="trend" size="sm" tone="{{ def.last_run_tone or 'muted' }}">{{ def.last_run_status }}</ship-badge>
            {% endif %}
          {% else %}—{% endif %}
        </ship-stat>
      </div>
    </section>

    {# ── Raw editor (edit mode) ────────────────────────────────── #}
    <ship-card data-show="$edit_mode">
      <div slot="header" class="ship-focus-header-row">
        <h3 class="ship-focus-section-label">
          Edit {{ format }}
        </h3>
        <ship-chip size="sm" tone="warning">editing</ship-chip>
      </div>
      <ship-alert tone="destructive" compact data-show="$edit_error">
        <ship-icon slot="leading" name="triangle-alert" size="sm"></ship-icon>
        <span data-text="$edit_error"></span>
        <span data-show="$edit_error_line > 0" style="margin-left: var(--space-2); opacity: 0.85;">
          at line <span data-text="$edit_error_line"></span>:<span data-text="$edit_error_col"></span>
        </span>
        <span slot="actions" data-show="$edit_issue_count > 1" style="font-size: var(--text-xs); opacity: 0.85;">
          +<span data-text="$edit_issue_count - 1"></span> more — see inline markers
        </span>
      </ship-alert>
      <ship-code-editor
        language="{{ 'jsonc' if format == 'jsonc' else ('json' if format == 'json' else 'yaml') }}"
        value="{{ raw }}"
        data-bind="edit_draft"
        data-on:ship-save="window.savePipeline('{{ workspace_id }}', '{{ name }}', $edit_draft, document.getElementById('ship-view-root'))"
        data-on:ship-cancel="if ($edit_mode) { window.tryCancelEdit(document.getElementById('ship-view-root'), {{ raw | tojson }}) }"
        style="min-height: 24rem;"></ship-code-editor>
    </ship-card>

    {# ── Steps definition (read mode) ───────────────────────────── #}
    <ship-card data-show="!$edit_mode">
      <h3 slot="header" class="ship-focus-section-label">Steps</h3>
      {% if doc.steps and doc.steps | length > 0 %}
        {% for step in doc.steps %}
          {% set step_type = 'run' if step.run else ('gate' if step.gate else 'agent') %}
          <ship-pipeline-step-def
            index="{{ loop.index }}"
            name="{{ step.id }}"
            step-type="{{ step_type }}"
            {% if step.agent %}agent="{{ step.agent }}"{% endif %}
            {% if step.provider %}provider="{{ step.provider }}"{% endif %}
            {% if step.model %}model="{{ step.model }}"{% endif %}
            {% if step.after %}after="{{ step.after | join(',') }}"{% endif %}
            {% if step.run %}command="{{ step.run }}"{% endif %}>
            {% if step.gate %}
            <div slot="gate">
              {% if step.gate.require_changed %}
              <ship-chip size="sm" tone="warning">
                require
                {% if step.gate.require_changed.match %}&nbsp;<code>{{ step.gate.require_changed.match }}</code>{% endif %}
                {% if step.gate.require_changed.min is defined %}&nbsp;≥ {{ step.gate.require_changed.min }}{% endif %}
              </ship-chip>
              {% endif %}
              {% if step.gate.forbid_changed %}
              <ship-chip size="sm" tone="destructive">
                forbid
                {% if step.gate.forbid_changed.match %}&nbsp;<code>{{ step.gate.forbid_changed.match }}</code>{% endif %}
                {% if step.gate.forbid_changed.min is defined %}&nbsp;&gt; {{ step.gate.forbid_changed.min }}{% endif %}
              </ship-chip>
              {% endif %}
            </div>
            {% endif %}
          </ship-pipeline-step-def>
        {% endfor %}
      {% else %}
        <ship-empty-state icon="list" heading="No steps"
          description="This pipeline file doesn't declare any steps."></ship-empty-state>
      {% endif %}
    </ship-card>

    {# ── Recent runs (non-ops history) ────────────────────────── #}
    {% if runs and runs | length > 0 %}
    <ship-card>
      <h3 slot="header" class="ship-focus-section-label">
        {% if ops_mode %}Recent runs (history){% else %}Recent runs{% endif %}
      </h3>
      <div class="ship-focus-stack">
        {% for run in runs %}
          {# In ops mode, active runs are already shown above — skip here #}
          {% if not ops_mode or not (run.state == 'dispatched' or run.state == 'pending' or run.state == 'gate-pending') %}
          {% set run_state = run.state | replace('-', '') %}
          <ship-pipeline-run state="{{ run_state }}" slug="{{ run.slug }}" agent="{{ run.agent }}">
            <ship-timestamp slot="actions" value="{{ run.updated_at }}" relative></ship-timestamp>
            <ship-button slot="actions" variant="ghost" size="sm"
              data-on:click="window.location.href='/api/runtime/view/pipelines/run/{{ run.slug }}'">
              <ship-icon slot="leading" name="chevron-right"></ship-icon>
              Open
            </ship-button>

            {% if run.error %}
              {% if '\n' in run.error %}
              <ship-collapsible>
                <ship-alert slot="trigger" tone="destructive" compact>Error (expand for details)</ship-alert>
                <ship-code language="text">{{ run.error }}</ship-code>
              </ship-collapsible>
              {% else %}
              <ship-alert tone="destructive" compact>Error: {{ run.error }}</ship-alert>
              {% endif %}
            {% endif %}

            {% if run.steps and run.steps | length > 0 %}
            <ship-pipeline-dag>
              {% for step in run.steps %}
              <ship-pipeline-step
                name="{{ step.id }}"
                state="{{ step.state }}"
                step-type="{{ step.step_type }}"
                {% if step.agent %}agent="{{ step.agent }}"{% endif %}></ship-pipeline-step>
              {% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}
              {% endfor %}
            </ship-pipeline-dag>
            {% endif %}
          </ship-pipeline-run>
          {% endif %}
        {% endfor %}
      </div>
    </ship-card>
    {% endif %}
  </div>

  {# ── Dispatch dialog (scoped to this pipeline) ────────────────── #}
  <ship-dialog id="dispatch-dialog" size="lg"
    {{ signal('dispatch_spec', '') }}
    {{ signal('dispatch_provider', '') }}
    {{ signal('dispatch_headless', true) }}>
    <span slot="header">Dispatch {{ name }}</span>
    <ship-field label="Spec" hint="Plain text or markdown — what the run should do.">
      <ship-textarea data-bind="dispatch_spec" rows="10"
        placeholder="Describe the work in one or two paragraphs..."></ship-textarea>
    </ship-field>
    <ship-field label="Provider override" hint="Optional — leave blank to use the pipeline's declared providers.">
      <ship-select data-bind="dispatch_provider">
        <option value="">(from pipeline)</option>
        {% for p in providers %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
      </ship-select>
    </ship-field>
    <ship-field>
      <ship-checkbox data-bind="dispatch_headless">Headless (run without tmux)</ship-checkbox>
    </ship-field>
    <div slot="footer">
      <ship-button variant="outline"
        data-on:click="document.getElementById('dispatch-dialog').close()">
        Cancel
      </ship-button>
      <ship-button tone="accent" variant="solid"
        data-on:click="@post('/api/runtime/dispatch', {
          contentType: 'json',
          body: JSON.stringify({
            pipeline: '{{ name }}',
            spec: $dispatch_spec,
            provider: $dispatch_provider || null,
            headless: $dispatch_headless
          })
        }); document.getElementById('dispatch-dialog').close()">
        <ship-icon slot="leading" name="play" size="sm"></ship-icon>
        Dispatch
      </ship-button>
    </div>
  </ship-dialog>

  {# ── Delete confirmation ──────────────────────────────────────── #}
  {% if workspace_id %}
  <ship-alert-dialog id="delete-pipeline-dialog" tone="destructive"
    confirm-label="Delete pipeline" cancel-label="Keep it"
    data-on:ship-confirm="window.deletePipeline('{{ workspace_id }}', '{{ name }}')"
    data-on:ship-cancel="document.getElementById('delete-pipeline-dialog').open = false">
    <span slot="title">Delete <code>{{ name }}</code>?</span>
    <p style="margin: 0; color: var(--muted-foreground); line-height: 1.5;">
      This removes the pipeline file from <code>.ship/pipelines/</code>.
      Any runs already in flight keep going — only the definition is deleted.
    </p>
  </ship-alert-dialog>
  {% endif %}
</div>
<script>
// Raw-editor save helper — fetches the workspace PUT endpoint, reads
// the structured parse/schema errors so the editor can place markers.
// Signals on the root element are mutated via Datastar's proxied
// signals API when available; falls back to `data-signal-*` writes.
(function () {
  // Honor `?edit=1` query param — the New-pipeline flow redirects here
  // after creating the file so the user lands in the editor immediately.
  // Retry briefly because Datastar may not have bound signals yet on
  // first paint.
  if (/[?&]edit=1(&|$)/.test(window.location.search)) {
    let tries = 0;
    const flip = () => {
      const root = document.getElementById('ship-view-root');
      const sigs = root && root.__ds?.signals;
      if (sigs && sigs.edit_mode) {
        sigs.edit_mode.value = true;
        return;
      }
      if (++tries < 20) setTimeout(flip, 50);
    };
    window.addEventListener('DOMContentLoaded', flip);
  }

  function getSignals(root) {
    return root.__ds?.signals;
  }
  function setSignal(root, k, v) {
    const sigs = getSignals(root);
    if (sigs && sigs[k]) { sigs[k].value = v; return; }
    root.setAttribute('data-signal-' + k, v);
  }
  function getSignal(root, k) {
    const sigs = getSignals(root);
    return sigs && sigs[k] ? sigs[k].value : undefined;
  }

  // Called by the Cancel button and by the editor's ship-cancel event.
  // Confirms before discarding a dirty draft; plain cancel otherwise.
  window.tryCancelEdit = function (root, original) {
    const draft = getSignal(root, 'edit_draft');
    if (draft !== undefined && draft !== original) {
      if (!window.confirm('Discard unsaved changes to this pipeline?')) return;
    }
    setSignal(root, 'edit_draft', original);
    setSignal(root, 'edit_mode', false);
    setSignal(root, 'edit_error', '');
    setSignal(root, 'edit_issue_count', 0);
    const editor = root.querySelector('ship-code-editor');
    if (editor && typeof editor.setDiagnostics === 'function') {
      editor.setDiagnostics([]);
    }
  };

  // Browser beforeunload — warn if leaving with a dirty draft.
  window.addEventListener('beforeunload', function (e) {
    const root = document.getElementById('ship-view-root');
    if (!root) return;
    const editMode = getSignal(root, 'edit_mode');
    const draft = getSignal(root, 'edit_draft');
    const orig = root.getAttribute('data-pipeline-raw') || '';
    if (editMode && draft !== undefined && draft !== orig) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  window.deletePipeline = async function (workspaceId, name) {
    const url = '/api/workspaces/' + encodeURIComponent(workspaceId)
      + '/pipelines/' + encodeURIComponent(name);
    try {
      const resp = await fetch(url, { method: 'DELETE', credentials: 'include' });
      if (resp.ok) {
        window.location.href = '/api/runtime/view/pipelines';
        return;
      }
      const body = await resp.json().catch(function () { return {}; });
      const msg = (body && body.data) || ('HTTP ' + resp.status);
      window.alert('Delete failed: ' + (typeof msg === 'string' ? msg : JSON.stringify(msg)));
    } catch (err) {
      window.alert('Delete failed: ' + (err && err.message ? err.message : String(err)));
    }
  };

  window.savePipeline = async function (workspaceId, name, draft, root) {
    const set = function (k, v) { setSignal(root, k, v); };
    const editor = root.querySelector('ship-code-editor');
    const pushDiagnostics = function (issues) {
      if (!editor || typeof editor.setDiagnostics !== 'function') return;
      editor.setDiagnostics((issues || []).map(function (i) {
        return {
          line: i.line || 1,
          column: i.column || 1,
          severity: i.kind === 'parse' ? 'error' : 'warning',
          message: i.message || 'validation error',
          source: i.path || i.kind,
        };
      }));
    };
    set('edit_saving', true);
    set('edit_error', '');
    set('edit_error_line', 0);
    set('edit_error_col', 0);
    set('edit_issue_count', 0);
    pushDiagnostics([]);
    const url = '/api/workspaces/' + encodeURIComponent(workspaceId)
      + '/pipelines/' + encodeURIComponent(name);
    try {
      const resp = await fetch(url, {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: draft }),
      });
      if (resp.ok) {
        set('edit_mode', false);
        set('edit_saving', false);
        window.location.reload();
        return;
      }
      const body = await resp.json().catch(function () { return {}; });
      const data = (body && body.data) || {};
      const issues = Array.isArray(data.issues) ? data.issues : (data.parse ? [data.parse] : []);
      const primary = issues[0];
      if (primary) {
        set('edit_error', primary.message || 'validation error');
        set('edit_error_line', primary.line || 0);
        set('edit_error_col', primary.column || 0);
        set('edit_issue_count', issues.length);
        pushDiagnostics(issues);
      } else {
        set('edit_error', data.error || ('HTTP ' + resp.status));
      }
    } catch (err) {
      set('edit_error', 'network: ' + (err && err.message ? err.message : String(err)));
    } finally {
      set('edit_saving', false);
    }
  };
})();
</script>
{% if not fragment %}
</body>
</html>
{% endif %}
