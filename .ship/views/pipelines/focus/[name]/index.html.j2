{#-
  Pipeline focus — single pipeline: full definition + its runs.
  Data pulled via `ship.pipelines.focus(name=ship.route.name)`.

  The op pre-computes `active_for_pipeline`, `other_for_pipeline`, and
  `ops_mode` so this template no longer mutates lists in jinja
  (minijinja 2.x doesn't support list.append / namespace mutation).
-#}
{% from '_ship.html.j2' import head, signal, show, on, on_click, attr_if %}
{% from '_urls.html.j2' import end_job %}

{% set name = ship.route.name %}
{% set ctx = ship.pipelines.focus(name=name) %}
{% set def = ctx.def %}
{% set doc = ctx.doc %}
{% set raw = ctx.raw %}
{% set format = ctx.format %}
{% set workspace_id = ctx.workspace_id %}
{% set runs = ctx.runs %}
{% set active_for_pipeline = ctx.active_for_pipeline %}
{% set other_for_pipeline = ctx.other_for_pipeline %}
{% set ops_mode = ctx.ops_mode %}
{% set providers = ctx.providers %}

{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head(name) }}</head>
<body>
{% endif %}
<div class="ship-view ship-view-pipeline-focus"
     {{ signal('edit_mode', false) }}
     {{ signal('edit_saving', false) }}
     {{ signal('edit_error', '') }}
     {{ signal('edit_error_line', 0) }}
     {{ signal('edit_error_col', 0) }}
     {{ signal('edit_issue_count', 0) }}>
  <style>
  .ship-view-pipeline-focus { color: var(--foreground); background: var(--background); }
  .ship-focus-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .ship-focus-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .ship-focus-title-block { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .ship-focus-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    flex-wrap: wrap;
  }
  .ship-focus-name {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .ship-focus-desc {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: 1.55;
    margin: 0;
    max-width: 56rem;
  }
  .ship-focus-actions { display: flex; gap: var(--space-2); }
  .ship-focus-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }
  @media (max-width: 840px) {
    .ship-focus-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .ship-focus-kbd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 2px 6px;
    border-radius: 4px;
    background: color-mix(in oklch, var(--muted) 60%, transparent);
    border: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    color: var(--muted-foreground);
  }
  .ship-focus-kbd-hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .ship-focus-section-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin: 0;
  }
  .ship-focus-stack { display: flex; flex-direction: column; gap: var(--space-3); }
  .ship-live-run { transition: box-shadow var(--duration-medium) var(--ease-out); border-radius: var(--radius-lg); }
  .ship-live-run.ship-heartbeat {
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--info) 30%, transparent);
  }
  .ship-focus-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  </style>

  <div class="ship-focus-wrap">
    <header class="ship-focus-head">
      <div class="ship-focus-title-block">
        <ship-button variant="ghost" size="sm"
          {{ on_click("window.location.href='/pipelines'") }}
          style="width: fit-content;">
          <ship-icon slot="leading" name="chevron-left" size="xs"></ship-icon>
          All pipelines
        </ship-button>
        <h1 class="ship-focus-title">
          {% if def.active_runs and def.active_runs > 0 %}
            <ship-status-dot tone="info" pulse></ship-status-dot>
          {% elif def.last_run_tone %}
            <ship-status-dot tone="{{ def.last_run_tone }}"></ship-status-dot>
          {% else %}
            <ship-status-dot tone="muted"></ship-status-dot>
          {% endif %}
          <span class="ship-focus-name">{{ name }}</span>
          <ship-chip size="sm">{{ def.step_count }} step{{ 's' if def.step_count != 1 else '' }}</ship-chip>
          {% if doc.auto_merge %}<ship-chip size="sm" tone="accent">auto-merge</ship-chip>{% endif %}
          {% if def.active_runs and def.active_runs > 0 %}
          <ship-badge tone="info">{{ def.active_runs }} running</ship-badge>
          {% endif %}
        </h1>
        {% if def.description %}
        <p class="ship-focus-desc">{{ def.description }}</p>
        {% endif %}
      </div>
      <div class="ship-focus-actions">
        {% if workspace_id %}
        <ship-button variant="outline" {{ show('!$edit_mode') }}
          {{ on_click("$edit_mode = true; $edit_error = ''; $edit_issue_count = 0") }}>
          <ship-icon slot="leading" name="edit-3" size="sm"></ship-icon>
          Edit
        </ship-button>
        <ship-button variant="outline" {{ show('$edit_mode') }}
          {{ on_click("$edit_mode = false; $edit_error = ''; $edit_issue_count = 0; window.resetPipelineEditor()") }}>
          Cancel
        </ship-button>
        <ship-button tone="primary" variant="solid" {{ show('$edit_mode') }}
          {{ attr_if('$edit_saving', 'loading') }}
          {{ attr_if('$edit_saving', 'disabled') }}
          {{ on_click("window.savePipeline('" ~ workspace_id ~ "', '" ~ name ~ "')") }}>
          <ship-icon slot="leading" name="check" size="sm"></ship-icon>
          Save
        </ship-button>
        <ship-button variant="outline" tone="destructive" size="sm" {{ show('$edit_mode') }}
          {{ on_click("document.getElementById('delete-pipeline-dialog').open = true") }}>
          <ship-icon slot="leading" name="trash-2" size="sm"></ship-icon>
          Delete
        </ship-button>
        {% endif %}
        <ship-button tone="primary" variant="solid" {{ show('!$edit_mode') }}
          {{ on_click("document.getElementById('dispatch-dialog').showModal()") }}>
          <ship-icon slot="leading" name="play" size="sm"></ship-icon>
          Dispatch
        </ship-button>
      </div>
    </header>

    {# Ops center: promote active runs when any are live. `ops_mode` and
       `active_for_pipeline` come pre-computed from the registry op. #}
    {% if ops_mode and active_for_pipeline | length > 0 %}
      {% include 'pipelines/focus/partials/ops_center.html.j2' %}
    {% endif %}

    {% include 'pipelines/focus/partials/stats.html.j2' %}
    {% include 'pipelines/focus/partials/edit_card.html.j2' %}
    {% include 'pipelines/focus/partials/steps_card.html.j2' %}

    {% if runs and runs | length > 0 %}
      {% include 'pipelines/focus/partials/recent_runs.html.j2' %}
    {% endif %}
  </div>

  {# Dispatch dialog (scoped to this pipeline). #}
  {% set fixed_pipeline = name %}
  {% include 'pipelines/partials/dispatch_dialog.html.j2' %}

  {# Delete confirmation. #}
  {% if workspace_id %}
  <ship-alert-dialog id="delete-pipeline-dialog" tone="destructive"
    confirm-label="Delete pipeline" cancel-label="Keep it"
    {{ on('ship-confirm', "window.deletePipeline('" ~ workspace_id ~ "', '" ~ name ~ "')") }}
    {{ on('ship-cancel', "document.getElementById('delete-pipeline-dialog').open = false") }}>
    <span slot="title">Delete <code>{{ name }}</code>?</span>
    <p style="margin: 0; color: var(--muted-foreground); line-height: 1.5;">
      This removes the pipeline file from <code>.ship/pipelines/</code>.
      Any runs already in flight keep going — only the definition is deleted.
    </p>
  </ship-alert-dialog>
  {% endif %}
</div>
{% include 'pipelines/focus/partials/editor_script.html.j2' %}
{% if not fragment %}
</body>
</html>
{% endif %}
