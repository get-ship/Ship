{#-
  Editor save/cancel/delete helpers for the pipeline focus view.

  The editor element (`<ship-code-editor id="pipeline-editor">`) owns its
  own content — its `value="{{ raw }}"` attribute sets the initial text,
  and its `.value` property is the current draft. There is no parallel
  `edit_draft` signal: single source of truth lives on the element.

  Exposes three functions on `window`:
    - tryCancelEdit() — exit edit mode, confirm on dirty
    - savePipeline(workspaceId, name) — PUT and push diagnostics
    - deletePipeline(workspaceId, name) — DELETE and redirect
  Plus: `?edit=1` auto-enters edit mode (the New-pipeline flow redirects
        here with it); beforeunload warns on nav-away with a dirty draft.
-#}
<script>
(function () {
  // `.ship-view-pipeline-focus` is the daemon's view root — that's where
  // Datastar binds signals. The shell's <main id="ship-view-root"> wraps
  // it but holds no signal state.
  const VIEW_SELECTOR = '.ship-view-pipeline-focus';
  const EDITOR_ID = 'pipeline-editor';

  function root() { return document.querySelector(VIEW_SELECTOR); }
  function editor() { return document.getElementById(EDITOR_ID); }

  // Read/write Datastar signals — ignore silently when the editor is not
  // mounted or Datastar hasn't bound yet, so initial-load helpers can
  // retry without throwing.
  function sigs() { return root()?.__ds?.signals; }
  function setSignal(k, v) {
    const s = sigs();
    if (s && s[k]) { s[k].value = v; return; }
    // Datastar not bound yet — set the attribute so initial render picks it up.
    root()?.setAttribute('data-signal-' + k, v);
  }
  function getSignal(k) { return sigs()?.[k]?.value; }

  // Honor `?edit=1` query param — the New-pipeline flow lands here
  // expecting to start in the editor immediately.
  if (/[?&]edit=1(&|$)/.test(window.location.search)) {
    let tries = 0;
    const flip = () => {
      const s = sigs();
      if (s?.edit_mode) { s.edit_mode.value = true; return; }
      if (++tries < 20) setTimeout(flip, 50);
    };
    window.addEventListener('DOMContentLoaded', flip);
  }

  // Draft is dirty when the editor's current value differs from the
  // initial `value=` attribute the daemon rendered.
  function isDirty() {
    const ed = editor();
    if (!ed) return false;
    const original = ed.getAttribute('value') ?? '';
    return ed.value !== original;
  }

  function clearErrorUi() {
    setSignal('edit_error', '');
    setSignal('edit_error_line', 0);
    setSignal('edit_error_col', 0);
    setSignal('edit_issue_count', 0);
    editor()?.setDiagnostics?.([]);
  }

  window.tryCancelEdit = function () {
    if (isDirty() && !window.confirm('Discard unsaved changes to this pipeline?')) return;
    const ed = editor();
    if (ed) ed.value = ed.getAttribute('value') ?? '';
    setSignal('edit_mode', false);
    clearErrorUi();
  };

  // Browser-level guard against nav-away with unsaved changes.
  window.addEventListener('beforeunload', function (e) {
    if (getSignal('edit_mode') && isDirty()) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  window.deletePipeline = async function (workspaceId, name) {
    const url = '/api/workspaces/' + encodeURIComponent(workspaceId)
      + '/pipelines/' + encodeURIComponent(name);
    try {
      const resp = await fetch(url, { method: 'DELETE', credentials: 'include' });
      if (resp.ok) { window.location.href = '/pipelines'; return; }
      const body = await resp.json().catch(() => ({}));
      const msg = body?.data || ('HTTP ' + resp.status);
      window.alert('Delete failed: ' + (typeof msg === 'string' ? msg : JSON.stringify(msg)));
    } catch (err) {
      window.alert('Delete failed: ' + (err?.message || String(err)));
    }
  };

  function pushDiagnostics(issues) {
    editor()?.setDiagnostics?.((issues || []).map(i => ({
      line: i.line || 1,
      column: i.column || 1,
      severity: i.kind === 'parse' ? 'error' : 'warning',
      message: i.message || 'validation error',
      source: i.path || i.kind,
    })));
  }

  window.savePipeline = async function (workspaceId, name) {
    const ed = editor();
    if (!ed) return;
    const draft = ed.value;
    setSignal('edit_saving', true);
    clearErrorUi();
    const url = '/api/workspaces/' + encodeURIComponent(workspaceId)
      + '/pipelines/' + encodeURIComponent(name);
    try {
      const resp = await fetch(url, {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: draft }),
      });
      if (resp.ok) {
        setSignal('edit_mode', false);
        setSignal('edit_saving', false);
        window.location.reload();
        return;
      }
      const body = await resp.json().catch(() => ({}));
      const data = body?.data || {};
      const issues = Array.isArray(data.issues) ? data.issues : (data.parse ? [data.parse] : []);
      const primary = issues[0];
      if (primary) {
        setSignal('edit_error', primary.message || 'validation error');
        setSignal('edit_error_line', primary.line || 0);
        setSignal('edit_error_col', primary.column || 0);
        setSignal('edit_issue_count', issues.length);
        pushDiagnostics(issues);
      } else {
        setSignal('edit_error', data.error || ('HTTP ' + resp.status));
      }
    } catch (err) {
      setSignal('edit_error', 'network: ' + (err?.message || String(err)));
    } finally {
      setSignal('edit_saving', false);
    }
  };
})();
</script>
