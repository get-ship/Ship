{#-
  Pipelines view — pipeline-first layout with live ops state.
  The daemon passes PipelinesCtx as Jinja context.
-#}
{% from '_ship.html.j2' import head, signal, live %}
{% from '_urls.html.j2' import view_pipelines_sse, end_job %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Pipelines') }}</head>
<body>
{% endif %}
<div id="ship-view-root" class="ship-view ship-view-pipelines">
  <style>
  .ship-view-pipelines {
    color: var(--foreground);
    background: var(--background);
  }
  .ship-pipelines-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
  }
  .ship-pipelines-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .ship-pipelines-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--foreground);
  }
  .ship-pipelines-sub {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin-top: var(--space-1);
  }
  .ship-pipelines-head-actions {
    display: flex;
    gap: var(--space-2);
  }
  @media (max-width: 767px) {
    .ship-pipelines-wrap { display: none; }
    .ship-mobile-gate { display: flex; }
  }
  @media (min-width: 768px) {
    .ship-mobile-gate { display: none; }
  }
  .ship-mobile-gate {
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  </style>
  {% include 'pipelines/partials/styles.html.j2' %}

  <div class="ship-pipelines-wrap">
    <header class="ship-pipelines-head">
      <div>
        <h1 class="ship-pipelines-title">Pipelines</h1>
        <p class="ship-pipelines-sub">{{ stats_subtitle }}</p>
      </div>
      <div class="ship-pipelines-head-actions">
        <ship-button variant="outline" size="sm"
          data-on:click="window.location.href='/api/runtime/view/pipelines?history=1'">
          <ship-icon slot="leading" name="list" size="sm"></ship-icon>
          History
        </ship-button>
        <ship-button tone="accent" variant="solid" size="sm"
          data-on:click="document.getElementById('dispatch-dialog').showModal()">
          <ship-icon slot="leading" name="play" size="sm"></ship-icon>
          Dispatch
        </ship-button>
      </div>
    </header>

    {# Initial content rendered server-side so the first paint shows
       real data. SSE ({{ live('pipelines') }}) patches this on any
       job.* / step.* event. #}
    <div {{ live('pipelines') }}>
      {% include 'pipelines/partials/content.html.j2' %}
    </div>
  </div>

  <div class="ship-mobile-gate">
    <ship-icon name="monitor" size="xl" tone="muted"></ship-icon>
    <span>Best experienced on desktop</span>
  </div>

  <ship-dialog id="dispatch-dialog" size="lg"
    {{ signal('dispatch_pipeline', (defs[0].name if defs and defs | length > 0 else '')) }}
    {{ signal('dispatch_spec', '') }}
    {{ signal('dispatch_provider', '') }}
    {{ signal('dispatch_headless', true) }}>
    <span slot="header">Dispatch pipeline run</span>
    <ship-field label="Pipeline">
      <ship-select data-bind="dispatch_pipeline">
        {% for def in defs %}
        <option value="{{ def.name }}">{{ def.name }}{% if def.description %} — {{ def.description }}{% endif %}</option>
        {% endfor %}
      </ship-select>
    </ship-field>
    <ship-field label="Spec" hint="Plain text or markdown — what the run should do.">
      <ship-textarea data-bind="dispatch_spec" rows="10"
        placeholder="Describe the work in one or two paragraphs..."></ship-textarea>
    </ship-field>
    <ship-field label="Provider override" hint="Optional — leave blank to use the pipeline's declared providers.">
      <ship-select data-bind="dispatch_provider">
        <option value="">(from pipeline)</option>
        {% for p in providers %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
      </ship-select>
    </ship-field>
    <ship-field>
      <ship-checkbox data-bind="dispatch_headless">Headless (run without tmux)</ship-checkbox>
    </ship-field>
    <div slot="footer">
      <ship-button variant="outline"
        data-on:click="document.getElementById('dispatch-dialog').close()">
        Cancel
      </ship-button>
      <ship-button tone="accent" variant="solid"
        data-on:click="@post('/api/runtime/dispatch', {
          contentType: 'json',
          body: JSON.stringify({
            pipeline: $dispatch_pipeline,
            spec: $dispatch_spec,
            provider: $dispatch_provider || null,
            headless: $dispatch_headless
          })
        }); document.getElementById('dispatch-dialog').close()">
        <ship-icon slot="leading" name="play" size="sm"></ship-icon>
        Dispatch
      </ship-button>
    </div>
  </ship-dialog>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
