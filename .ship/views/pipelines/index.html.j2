{#- SDK gaps:
    - no status_summary() macro for status pill row
-#}
{#-
  Pipelines view — self-contained, Datastar-driven.
  All state is managed via signals (tab, agent). ZERO URL query strings.
  The daemon passes PipelinesCtx as Jinja context.
-#}
{% from '_ship.html.j2' import head, signal, show, live, loading, spinner, chip, chip_all, on %}
{% from '_urls.html.j2' import create_job, view_pipelines_sse, get_job, end_job %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Pipelines') }}
  <style>
  .pip-wrap { max-width: 1400px; margin: 0 auto; padding: var(--space-3) var(--space-5); }
  .pip-head { margin-bottom: var(--space-4); }
  .pip-head h1 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: var(--font-weight-semibold); }
  .pip-head p { font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1); }
  .pip-status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); padding: var(--space-2) 0; margin-bottom: var(--space-3); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .pip-status-pill { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); }
  .pip-status-pill .count { font-variant-numeric: tabular-nums; color: var(--foreground); font-weight: var(--font-weight-medium); }
  </style>
</head>
<body>
<div id="pipelines-root" class="ship-view"
     {{ signal('tab', active_tab) }}
     {{ signal('agent', agent_filter) }}
     {{ signal('_creating', false) }}>
  <div class="pip-wrap">
    <ship-toolbar>
      <div class="pip-head">
        <h1>Pipelines</h1>
        <p>{{ stats_subtitle }}</p>
      </div>
      <ship-button size="sm" tone="accent" variant="solid"
        {{ on('click', "@post('" ~ create_job() ~ "', {contentType: 'json', body: JSON.stringify({})})") }}
        {{ loading('_creating') }}>
        + Run
      </ship-button>
      {{ spinner('_creating') }}
    </ship-toolbar>

    <div class="pip-status" role="group" aria-label="Run status summary">
      {% for pill in status_pills %}
      <span class="pip-status-pill">
        <ship-status-dot tone="{{ pill.tone }}"></ship-status-dot>
        <span>{{ pill.label }}</span>
        <span class="count">{{ pill.count }}</span>
      </span>
      {% endfor %}
    </div>

    <ship-tabs variant="underline" active="{{ active_tab }}"
      {{ on('ship-tab-change', "$tab = evt.detail.name; @get('/api/runtime/view/pipelines/sse')") }}>
      <ship-tab name="active" label="Active" count="{{ stats.active }}"></ship-tab>
      <ship-tab name="definitions" label="Definitions" count="{{ stats.definitions }}"></ship-tab>
      <ship-tab name="history" label="History" count="{{ stats.history }}"></ship-tab>
    </ship-tabs>

    <ship-toolbar>
      <ship-chip size="sm" {{ chip_all('agent', 'pipelines') }}>All agents</ship-chip>
      {% for a in agents %}
      <ship-chip size="sm" {{ chip('agent', a, 'pipelines') }}>{{ a }}</ship-chip>
      {% endfor %}
    </ship-toolbar>

    <div {{ live('pipelines') }}>
      <div id="pipelines-content">
        <p>Loading...</p>
      </div>
    </div>
  </div>
</div>
</body>
</html>
