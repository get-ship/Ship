{#-
  Pipelines view — view, edit, and dispatch pipelines with live ops state.
  Single-column centered layout. Datastar-driven tab switching and SSE content patches.
  The daemon passes PipelinesCtx as Jinja context.
-#}
{% from '_ship.html.j2' import head, signal, show, live, loading, spinner, chip, chip_all %}
{% from '_urls.html.j2' import view_pipelines_sse, end_job %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Pipelines') }}</head>
<body>
{% endif %}
<div id="ship-view-root" class="ship-view ship-view-pipelines"
     {{ signal('tab', active_tab) }}
     {{ signal('agent', agent_filter) }}
     {{ signal('_creating', false) }}>
  <style>
  .ship-view-pipelines {
    color: var(--foreground);
    background: var(--background);
  }
  .ship-pipelines-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
  }
  .ship-pipelines-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }
  .ship-pipelines-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--foreground);
  }
  .ship-pipelines-sub {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin-top: var(--space-1);
  }
  .ship-pipelines-stats {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    background: color-mix(in oklch, var(--card) 50%, transparent);
    padding: var(--space-3) var(--space-4);
  }
  .ship-stat { display: inline-flex; align-items: center; gap: var(--space-1); }
  .ship-stat-label { font-size: var(--text-xs); color: var(--muted-foreground); }
  .ship-stat-count {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
  }
  .ship-pipelines-tabs-row { margin-bottom: var(--space-4); }
  .ship-pipelines-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }
  .ship-pipelines-content { padding: 0; }

  @media (max-width: 767px) {
    .ship-pipelines-scroll { display: none; }
    .ship-mobile-gate { display: flex; }
  }
  @media (min-width: 768px) {
    .ship-mobile-gate { display: none; }
  }
  .ship-mobile-gate {
    align-items: center;
    justify-content: center;
    height: 100%;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  </style>
  {% include 'pipelines/partials/styles.html.j2' %}

    <div class="ship-pipelines-wrap">
      <div class="ship-pipelines-head">
        <div>
          <h1 class="ship-pipelines-title">Pipelines</h1>
          <p class="ship-pipelines-sub">{{ stats_subtitle }}</p>
        </div>
        <ship-button size="sm" tone="accent" variant="solid"
          data-on:click="document.getElementById('dispatch-dialog').showModal()">
          <ship-icon slot="leading" name="play" size="sm"></ship-icon>
          New Run
        </ship-button>
      </div>

      {% if status_pills and status_pills | length > 0 %}
      <div class="ship-pipelines-stats" role="group" aria-label="Run status summary">
        {% for pill in status_pills %}
        <span class="ship-stat">
          <ship-status-dot tone="{{ pill.tone }}"></ship-status-dot>
          <span class="ship-stat-label">{{ pill.label }}</span>
          <span class="ship-stat-count">{{ pill.count }}</span>
        </span>
        {% endfor %}
      </div>
      {% endif %}

      <div class="ship-pipelines-tabs-row">
        <ship-tabs variant="underline" active="{{ active_tab }}"
          data-on:ship-tab-change="$tab = evt.detail.name; @get('/api/runtime/view/pipelines/sse?tab=' + evt.detail.name)">
          <ship-tab name="active" label="Active Runs" count="{{ stats.active }}"></ship-tab>
          <ship-tab name="definitions" label="Templates" count="{{ stats.definitions }}"></ship-tab>
          <ship-tab name="history" label="History" count="{{ stats.history }}"></ship-tab>
        </ship-tabs>
      </div>

      {% if agents and agents | length > 0 %}
      <div class="ship-pipelines-filters" role="group" aria-label="Filter by agent">
        <ship-chip size="sm" {{ chip_all('agent', 'pipelines') }}>All agents</ship-chip>
        {% for a in agents %}
        <ship-chip size="sm" {{ chip('agent', a, 'pipelines') }}>{{ a }}</ship-chip>
        {% endfor %}
      </div>
      {% endif %}

      {# Initial content rendered server-side so the first paint shows
         real data. SSE ({{ live('pipelines') }}) patches this on any
         job.* / step.* event. #}
      <div {{ live('pipelines') }}>
        {% include 'pipelines/partials/content.html.j2' %}
      </div>
    </div>

  <div class="ship-mobile-gate">
    <ship-icon name="monitor" size="xl" tone="muted"></ship-icon>
    <span>Best experienced on desktop</span>
  </div>

  <ship-dialog id="dispatch-dialog" size="lg"
    {{ signal('dispatch_pipeline', (defs[0].name if defs and defs | length > 0 else '')) }}
    {{ signal('dispatch_spec', '') }}
    {{ signal('dispatch_provider', '') }}
    {{ signal('dispatch_headless', true) }}>
    <span slot="header">Dispatch pipeline run</span>
    <ship-field label="Pipeline">
      <ship-select data-bind="dispatch_pipeline">
        {% for def in defs %}
        <option value="{{ def.name }}">{{ def.name }}{% if def.description %} — {{ def.description }}{% endif %}</option>
        {% endfor %}
      </ship-select>
    </ship-field>
    <ship-field label="Spec" hint="Plain text or markdown — what the run should do.">
      <ship-textarea data-bind="dispatch_spec" rows="10"
        placeholder="Describe the work in one or two paragraphs..."></ship-textarea>
    </ship-field>
    <ship-field label="Provider override" hint="Optional — leave blank to use the pipeline's declared providers.">
      <ship-select data-bind="dispatch_provider">
        <option value="">(from pipeline)</option>
        {% for p in providers %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
      </ship-select>
    </ship-field>
    <ship-field>
      <ship-checkbox data-bind="dispatch_headless">Headless (no tmux window)</ship-checkbox>
    </ship-field>
    <div slot="footer">
      <ship-button variant="outline"
        data-on:click="document.getElementById('dispatch-dialog').close()">
        Cancel
      </ship-button>
      <ship-button tone="accent" variant="solid"
        data-on:click="@post('/api/runtime/dispatch', {
          contentType: 'json',
          body: JSON.stringify({
            pipeline: $dispatch_pipeline,
            spec: $dispatch_spec,
            provider: $dispatch_provider || null,
            headless: $dispatch_headless
          })
        }); document.getElementById('dispatch-dialog').close()">
        <ship-icon slot="leading" name="play" size="sm"></ship-icon>
        Dispatch
      </ship-button>
    </div>
  </ship-dialog>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
