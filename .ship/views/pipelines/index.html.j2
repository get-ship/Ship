{#-
  Pipelines — list view. Data pulled inline via `ship.pipelines.summaries()`.
  The call returns the pre-shaped ctx (stats, defs, active_runs, history_runs,
  providers, workspace_id, agents, status_pills, ...). We destructure into
  flat names so the sibling partials (`partials/content.html.j2`,
  `partials/dispatch_dialog.html.j2`) stay unchanged.
-#}
{% from '_ship.html.j2' import head, signal, bind, on_click, attr_if %}

{% set ctx = ship.pipelines.summaries(
  q=ship.query.q | default(''),
  agent=ship.query.agent | default(''),
  pipeline=ship.query.pipeline | default(''),
  status=ship.query.status | default(''),
  tab=ship.query.tab | default(''),
) %}
{% set stats_subtitle = ctx.stats_subtitle %}
{% set stats = ctx.stats %}
{% set defs = ctx.defs %}
{% set active_runs = ctx.active_runs %}
{% set history_runs = ctx.history_runs %}
{% set providers = ctx.providers %}
{% set workspace_id = ctx.workspace_id %}
{% set agents = ctx.agents %}
{% set status_pills = ctx.status_pills %}
{% set active_tab = ctx.active_tab %}
{% set agent_filter = ctx.agent_filter %}
{% set filter = ctx.filter %}

{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Pipelines') }}</head>
<body>
{% endif %}
<div class="ship-view ship-view-pipelines">
  <style>
  .ship-view-pipelines {
    color: var(--foreground);
    background: var(--background);
  }
  .ship-pipelines-wrap {
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-8);
  }
  .ship-pipelines-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .ship-pipelines-title {
    font-family: var(--heading-font);
    font-size: var(--text-2xl);
    font-weight: var(--heading-weight);
    letter-spacing: var(--heading-tracking);
    margin: 0;
    color: var(--foreground);
  }
  .ship-pipelines-sub {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin-top: var(--space-1);
  }
  .ship-pipelines-head > div:first-child { position: relative; }
  .ship-pipelines-head > div:first-child::after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    margin-top: var(--space-2);
    border-radius: 2px;
    background: linear-gradient(90deg, var(--primary), transparent);
  }
  .ship-pipelines-head-actions {
    display: flex;
    gap: var(--space-2);
  }
  @media (max-width: 767px) {
    .ship-pipelines-wrap { display: none; }
    .ship-mobile-gate { display: flex; }
  }
  @media (min-width: 768px) {
    .ship-mobile-gate { display: none; }
  }
  .ship-mobile-gate {
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  </style>
  {% include 'pipelines/partials/styles.html.j2' %}

  <div class="ship-pipelines-wrap">
    <header class="ship-pipelines-head">
      <div>
        <h1 class="ship-pipelines-title">Pipelines</h1>
        <p class="ship-pipelines-sub">{{ stats_subtitle }}</p>
      </div>
      <div class="ship-pipelines-head-actions">
        <ship-button variant="outline" size="sm"
          {{ on_click("window.location.href='/pipelines/history'") }}>
          <ship-icon slot="leading" name="list" size="sm"></ship-icon>
          History
        </ship-button>
        {% if workspace_id %}
        <ship-button variant="outline" size="sm"
          {{ on_click("document.getElementById('new-pipeline-dialog').showModal()") }}>
          <ship-icon slot="leading" name="plus" size="sm"></ship-icon>
          New pipeline
        </ship-button>
        {% endif %}
        <ship-button tone="primary" variant="solid" size="sm"
          {{ on_click("document.getElementById('dispatch-dialog').showModal()") }}>
          <ship-icon slot="leading" name="play" size="sm"></ship-icon>
          Dispatch
        </ship-button>
      </div>
    </header>

    <div>
      {% include 'pipelines/partials/content.html.j2' %}
    </div>
  </div>

  <div class="ship-mobile-gate">
    <ship-icon name="monitor" size="xl" tone="muted"></ship-icon>
    <span>Best experienced on desktop</span>
  </div>

  {% include 'pipelines/partials/dispatch_dialog.html.j2' %}

  {# ── New pipeline ─────────────────────────────────────────────── #}
  {% if workspace_id %}
  <ship-dialog id="new-pipeline-dialog" size="sm"
    {{ signal('new_pipe_name', '') }}
    {{ signal('new_pipe_error', '') }}
    {{ signal('new_pipe_creating', false) }}>
    <span slot="header">New pipeline</span>
    <ship-field label="Name" hint="Lowercase, kebab-case. Becomes the filename.">
      <ship-input {{ bind('new_pipe_name') }} placeholder="my-pipeline"
        autofocus></ship-input>
    </ship-field>
    <ship-alert tone="destructive" compact data-show="$new_pipe_error">
      <span data-text="$new_pipe_error"></span>
    </ship-alert>
    <div slot="footer">
      <ship-button variant="outline"
        {{ on_click("document.getElementById('new-pipeline-dialog').close()") }}>
        Cancel
      </ship-button>
      <ship-button tone="primary" variant="solid"
        {{ attr_if('$new_pipe_creating', 'loading') }}
        {{ attr_if('$new_pipe_creating', 'disabled') }}
        {{ on_click("window.createPipeline('" ~ workspace_id ~ "', $new_pipe_name, document.querySelector('.ship-view-pipelines'))") }}>
        <ship-icon slot="leading" name="plus" size="sm"></ship-icon>
        Create
      </ship-button>
    </div>
  </ship-dialog>
  <script>
  (function () {
    function setSig(root, k, v) {
      const sigs = root.__ds?.signals;
      if (sigs && sigs[k]) { sigs[k].value = v; return; }
      root.setAttribute('data-signal-' + k, v);
    }
    const KEBAB = /^[a-z0-9][a-z0-9-]*$/;
    const TEMPLATE = [
      '{',
      '  // Pipeline definition. Lowercase-kebab name, one or more steps.',
      '  "name": "__NAME__",',
      '  "description": "",',
      '  "steps": [',
      '    { "id": "one", "run": "echo hello" }',
      '  ]',
      '}',
      '',
    ].join('\n');

    window.createPipeline = async function (workspaceId, name, root) {
      const trimmed = (name || '').trim();
      if (!KEBAB.test(trimmed)) {
        setSig(root, 'new_pipe_error', 'Name must be lowercase kebab-case (a–z, 0–9, -).');
        return;
      }
      setSig(root, 'new_pipe_creating', true);
      setSig(root, 'new_pipe_error', '');
      const body = TEMPLATE.replace('__NAME__', trimmed);
      const url = '/api/workspaces/' + encodeURIComponent(workspaceId)
        + '/pipelines/' + encodeURIComponent(trimmed);
      try {
        const resp = await fetch(url, {
          method: 'PUT',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: body }),
        });
        if (resp.ok) {
          window.location.href = '/pipelines/focus/' + encodeURIComponent(trimmed) + '?edit=1';
          return;
        }
        const parsed = await resp.json().catch(function () { return {}; });
        const data = (parsed && parsed.data) || {};
        setSig(root, 'new_pipe_error', data.error || data || ('HTTP ' + resp.status));
      } catch (err) {
        setSig(root, 'new_pipe_error', 'network: ' + (err && err.message ? err.message : String(err)));
      } finally {
        setSig(root, 'new_pipe_creating', false);
      }
    };
  })();
  </script>
  {% endif %}
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
