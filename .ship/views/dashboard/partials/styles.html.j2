{#- Dashboard styles — included from index.html.j2.
    Keeps only what ship-elements don't provide: view-local layout,
    per-card stripe, live-pulse badge, quick-link tiles, events 3-col grid,
    section header inner paddings (since ship-card uses padding="none"). -#}
<style>
/* Layout */
.dash { color: var(--foreground); font-family: var(--font-body); min-height: 100vh; background: var(--background); }
.dash-wrap { max-width: 80rem; margin: 0 auto; padding: var(--space-6) var(--space-4); }

/* Header */
.dash-header {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--space-4); margin-bottom: var(--space-6);
  padding-bottom: var(--space-5); border-bottom: 1px solid var(--border);
}
.dash-wordmark { display: flex; align-items: center; gap: var(--space-3); }
.dash-logo {
  --tile-size: 36px; --glyph-size: 22px;
  width: 36px; height: 36px; flex-shrink: 0;
}
.dash-title {
  font-family: var(--heading-font); font-size: var(--text-2xl); font-weight: var(--heading-weight);
  letter-spacing: var(--heading-tracking); line-height: 1; margin: 0 0 var(--space-1); color: var(--foreground);
}
.dash-wordmark > div { position: relative; }
.dash-wordmark > div::after {
  content: ''; display: block; width: 60px; height: 4px;
  margin-top: var(--space-2); border-radius: 2px;
  background: linear-gradient(90deg, var(--primary), transparent);
}
.dash-workspace { font-size: var(--text-xs); color: var(--muted-foreground); font-family: var(--font-mono); margin: 0; }
.dash-status-row { display: flex; align-items: center; gap: var(--space-2); flex-shrink: 0; }

/* Live-pulse badge — no ship-element covers this animated status pill. */
.dash-live-badge {
  display: inline-flex; align-items: center; gap: var(--space-1);
  font-size: var(--text-xs); font-family: var(--font-mono); color: var(--success);
  padding: var(--space-1) var(--space-2);
  border: 1px solid color-mix(in oklch, var(--success) 30%, transparent);
  border-radius: var(--radius-full);
  background: color-mix(in oklch, var(--success) 8%, transparent);
}
.dash-live-dot {
  width: 6px; height: 6px; border-radius: 50%; background: var(--success);
  animation: dash-pulse 2s ease-in-out infinite;
}
@keyframes dash-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

/* Stats row — grid + per-stat top accent stripe.
   ship-stat supplies card chrome (border, radius, background, padding,
   label/value/hint typography). The stripe is view-local because
   ship-stat's `accent` attr tints the value, not a top bar. */
.dash-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); margin-bottom: var(--space-6); }
@media (min-width: 640px) { .dash-stats { grid-template-columns: repeat(4, 1fr); } }
.dash-stat-wrap { position: relative; border-radius: var(--radius-lg); overflow: hidden; }
.dash-stat-wrap > ship-stat { width: 100%; box-sizing: border-box; }
.dash-stat-wrap::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  z-index: 1; pointer-events: none;
}
.dash-stat-wrap--jobs::before        { background: var(--primary); }
.dash-stat-wrap--agents::before      { background: var(--accent); }
.dash-stat-wrap--events::before      { background: var(--info); }
.dash-stat-wrap--collections::before { background: var(--success); }

/* Body grid */
.dash-body { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
@media (min-width: 900px) {
  .dash-body { grid-template-columns: 1fr 1fr; }
  .dash-body--wide { grid-column: 1 / -1; }
}

/* Section header — lives in ship-card's slot="header". Card provides the
   border-bottom divider (ship-card .header[data-filled]); we only supply
   the flex layout, inner padding (card is padding="none"), and the
   inline icon-next-to-title composition that slot="header" receives as
   arbitrary HTML. */
.dash-section { display: block; }
.dash-section-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--space-4) var(--space-5);
}
.dash-section-title {
  font-family: var(--label-font, var(--font-mono));
  font-weight: var(--label-weight, 500);
  letter-spacing: var(--label-tracking, 0.12em);
  text-transform: uppercase;
  font-size: 10.5px;
  color: var(--muted-foreground);
  margin: 0; display: flex; align-items: center; gap: var(--space-2);
}
.dash-section-icon { width: 16px; height: 16px; color: var(--muted-foreground); }
.dash-section-link {
  font-size: var(--text-xs); color: var(--muted-foreground); text-decoration: none;
  display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
  transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
}
.dash-section-link:hover { color: var(--foreground); background: color-mix(in oklch, var(--muted) 50%, transparent); }
.dash-section-link:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--ring); }
.dash-section-body { padding: 0; }

/* Recent jobs list — ship-list-tile (row, compact) for each entry. We
   keep row dividers and the custom row horizontal padding view-local:
   list-tile renders each tile with its own radius/transparent border and
   a hover-muted background, but doesn't draw a divider between siblings
   (its hover paints the full row, so the divider here is the rest-state
   seam only). */
.dash-jobs-list { display: flex; flex-direction: column; }
.dash-job-tile {
  padding: 0 var(--space-5);
  border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
}
.dash-job-tile:last-child { border-bottom: none; }
.dash-job-name {
  font-family: var(--font-mono); font-size: var(--text-xs);
  color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-weight: var(--font-weight-normal);
}
.dash-job-trailing { display: inline-flex; align-items: center; gap: var(--space-3); }
.dash-job-agent { font-size: var(--text-xs); color: var(--muted-foreground); white-space: nowrap; }
.dash-job-time { font-size: var(--text-xs); color: var(--muted-foreground); font-family: var(--font-mono); white-space: nowrap; }

/* Agents grid — ship-list-tile variant="card" supplies the chrome
   (background, border, radius, shadow, hover lift). ship-avatar with
   `initials` supplies the gradient tile. The grid container is view-local
   because the grid layout is a view concern. */
.dash-agents-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  align-items: stretch;
}
.dash-agent-tile { min-width: 0; overflow: hidden; }
/* Column body: head grows, foot pins to bottom — uniform tile heights. */
.dash-agent-body {
  display: flex; flex-direction: column; gap: var(--space-2);
  min-width: 0; flex: 1;
}
.dash-agent-head { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
.dash-agent-name {
  font-size: var(--text-xs); font-weight: var(--font-weight-semibold); color: var(--foreground);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;
}
.dash-agent-desc {
  font-size: var(--text-xs); color: var(--muted-foreground);
  line-height: 1.4; margin: 0;
  display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
}
.dash-agent-foot {
  display: flex; align-items: center; gap: 4px;
  flex-wrap: nowrap; overflow: hidden; min-height: 22px;
}
.dash-agent-providers { display: inline-flex; align-items: center; gap: 4px; }

/* Events feed — 3-column grid (timestamp / type / actor). No ship-element
   covers a grid-tile shape; kept view-local. */
.dash-event-row {
  display: grid; grid-template-columns: 80px 1fr 100px; gap: var(--space-3);
  padding: var(--space-2) var(--space-5); align-items: baseline; font-size: var(--text-xs);
  border-bottom: 1px solid color-mix(in oklch, var(--border) 25%, transparent);
}
.dash-event-row:last-child { border-bottom: none; }
.dash-event-row:hover { background: color-mix(in oklch, var(--muted) 20%, transparent); }
.dash-event-ts { color: var(--muted-foreground); font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dash-event-type { font-family: var(--font-mono); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dash-event-actor {
  color: var(--muted-foreground); overflow: hidden; white-space: nowrap;
  display: inline-flex; align-items: center; gap: var(--space-1);
  justify-content: flex-end; min-width: 0;
}
.dash-event-actor > span { overflow: hidden; text-overflow: ellipsis; }
.dash-job-trailing ship-avatar { flex-shrink: 0; }

/* Quick links — vertical icon-above-label tiles. No ship-element covers
   this shape. Kept entirely view-local. */
.dash-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); padding: var(--space-4) var(--space-5); }
@media (min-width: 640px) { .dash-links { grid-template-columns: repeat(6, 1fr); } }
.dash-link-btn {
  display: flex; flex-direction: column; align-items: center; gap: var(--space-2); padding: var(--space-4);
  border: 1px solid var(--border); border-radius: var(--radius-md); text-decoration: none; text-align: center;
  background: color-mix(in oklch, var(--muted) 15%, transparent); color: var(--muted-foreground);
  font-size: var(--text-xs); font-weight: var(--font-weight-medium); cursor: pointer;
  transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out),
              background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
}
.dash-link-btn:hover { border-color: color-mix(in oklch, var(--primary) 50%, transparent); color: var(--foreground); background: color-mix(in oklch, var(--muted) 30%, transparent); transform: translateY(-1px); }
.dash-link-btn:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--ring); }
.dash-link-icon { width: 32px; height: 32px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; }
.dash-link-icon--workflows { background: color-mix(in oklch, var(--primary) 15%, transparent); color: var(--primary); }
.dash-link-icon--agents    { background: color-mix(in oklch, var(--accent)  15%, transparent); color: var(--accent); }
.dash-link-icon--skills    { background: color-mix(in oklch, var(--info)    15%, transparent); color: var(--info); }
.dash-link-icon--settings  { background: color-mix(in oklch, var(--muted)   40%, transparent); color: var(--muted-foreground); }
.dash-link-icon--data      { background: color-mix(in oklch, var(--success) 15%, transparent); color: var(--success); }
.dash-link-icon--events    { background: color-mix(in oklch, var(--warning) 15%, transparent); color: var(--warning); }

/* Responsive */
@media (max-width: 639px) {
  .dash-header { flex-direction: column; }
  .dash-agents-grid { grid-template-columns: 1fr; }
  .dash-event-row { grid-template-columns: 70px 1fr; }
  .dash-event-actor { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .dash-live-dot { animation: none; }
  .dash-link-btn, .dash-section-link { transition: none; }
  .dash-link-btn:hover { transform: none; }
}
</style>
