{#- Dashboard styles — only page-level layout that no ship-element covers. -#}
<style>
.dash { color: var(--foreground); font-family: var(--font-body); min-height: 100vh; background: var(--background); }
.dash-wrap { max-width: 80rem; margin: 0 auto; padding: var(--space-6) var(--space-4); }

.dash-header {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--space-4); margin-bottom: var(--space-6);
  padding-bottom: var(--space-5); border-bottom: 1px solid var(--border);
}
.dash-wordmark { display: flex; align-items: center; gap: var(--space-3); }
.dash-logo {
  width: 36px; height: 36px; border-radius: var(--radius-md); background: var(--primary);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.dash-title {
  font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700;
  letter-spacing: -0.02em; line-height: 1; margin: 0 0 var(--space-1);
}
.dash-workspace { font-size: var(--text-xs); color: var(--muted-foreground); font-family: var(--font-mono); margin: 0; }

.dash-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); margin-bottom: var(--space-6); }
@media (min-width: 640px) { .dash-stats { grid-template-columns: repeat(4, 1fr); } }

.dash-body { display: grid; grid-template-columns: 1fr; gap: var(--space-4); align-items: start; }
@media (min-width: 900px) {
  .dash-body { grid-template-columns: 1fr 1fr; }
  .dash-body--wide { grid-column: 1 / -1; }
}

/* Section header row inside <ship-card slot="header">.
   Ship-card provides the surface + separator; this only lays out the
   title + trailing button that sit in its header slot. */
.dash-head-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
.dash-head-title { font-size: var(--text-sm); font-weight: var(--font-weight-semibold); margin: 0; display: flex; align-items: center; gap: var(--space-2); }

.dash-agents-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
.dash-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
@media (min-width: 640px) { .dash-links { grid-template-columns: repeat(6, 1fr); } }

.dash-mono { font-family: var(--font-mono); font-size: var(--text-xs); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dash-muted { color: var(--muted-foreground); }
.dash-ts { min-width: 80px; font-variant-numeric: tabular-nums; }
.dash-event-actor { max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }

@media (max-width: 639px) {
  .dash-header { flex-direction: column; }
  .dash-agents-grid { grid-template-columns: 1fr; }
  .dash-event-actor { display: none; }
}
</style>
