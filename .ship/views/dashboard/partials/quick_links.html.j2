{#- Quick links tile row — vertical icon-above-label cards. Composition
    kept view-local (no ship-element covers this shape today). Separated
    from index.html.j2 to stay under the 300-line file cap.

    SDK gap: this is a HARDCODED route catalog. Labels, icons, hrefs and
    color keys are duplicated here from the shell rail / router. Candidate:
    a runtime-provided `ship_quick_links()` filter (or a manifest
    declaration) that returns the same metadata the shell uses to draw its
    primary nav, so adding a first-party view adds a dashboard tile for
    free. Until that exists, both this file and the shell must be edited
    together when nav changes. -#}
{% from '_ship.html.j2' import on_click_prevent %}
<div class="dash-links">
  <a class="dash-link-btn" href="/api/view/pipelines" {{ on_click_prevent("@get('/api/view/pipelines')") }}>
    <div class="dash-link-icon dash-link-icon--workflows" aria-hidden="true">
      <ship-icon name="workflow" size="16"></ship-icon>
    </div>Workflows
  </a>
  <a class="dash-link-btn" href="/api/v/agents" {{ on_click_prevent("@get('/api/v/agents')") }}>
    <div class="dash-link-icon dash-link-icon--agents" aria-hidden="true">
      <ship-icon name="users" size="16"></ship-icon>
    </div>Agents
  </a>
  <a class="dash-link-btn" href="/api/view/skills" {{ on_click_prevent("@get('/api/view/skills')") }}>
    <div class="dash-link-icon dash-link-icon--skills" aria-hidden="true">
      <ship-icon name="book" size="16"></ship-icon>
    </div>Skills
  </a>
  <a class="dash-link-btn" href="/api/v/collections" {{ on_click_prevent("@get('/api/v/collections')") }}>
    <div class="dash-link-icon dash-link-icon--data" aria-hidden="true">
      <ship-icon name="database" size="16"></ship-icon>
    </div>Data
  </a>
  <a class="dash-link-btn" href="/api/view/events" {{ on_click_prevent("@get('/api/view/events')") }}>
    <div class="dash-link-icon dash-link-icon--events" aria-hidden="true">
      <ship-icon name="activity" size="16"></ship-icon>
    </div>Events
  </a>
  <a class="dash-link-btn" href="/api/view/settings" {{ on_click_prevent("@get('/api/view/settings')") }}>
    <div class="dash-link-icon dash-link-icon--settings" aria-hidden="true">
      <ship-icon name="settings" size="16"></ship-icon>
    </div>Settings
  </a>
</div>
