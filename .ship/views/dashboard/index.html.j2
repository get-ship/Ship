{#-
  Workspace Dashboard — landing page for a developer using Ship.
  Composes <ship-*> elements (ship-stat, ship-card, ship-list-tile,
  ship-empty-state, ship-status-dot, ship-avatar, ship-icon, ship-badge,
  ship-timestamp). Only page-level layout CSS lives in partials/styles.html.j2.
-#}
{% from '_ship.html.j2' import head, styles, navigate %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Dashboard') }}
</head>
<body>
{% endif %}
<div class="ship-view dash">
  {{ styles() }}
  {% include 'dashboard/partials/styles.html.j2' %}
  <div class="dash-wrap">

    {# ── Header ───────────────────────────────────────────────── #}
    <header class="dash-header">
      <div class="dash-wordmark">
        <div class="dash-logo" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <div>
          <h1 class="dash-title">Ship</h1>
          <p class="dash-workspace">
            {%- if settings is defined and settings.workspace_name is defined -%}
              {{ settings.workspace_name }}
            {%- else -%}workspace dashboard{%- endif -%}
          </p>
        </div>
      </div>
      <ship-badge tone="success" variant="soft" size="sm" pill
                  aria-label="Live updates active">
        <ship-status-dot slot="leading" tone="success" size="sm" pulse></ship-status-dot>
        live
      </ship-badge>
    </header>

    {# ── Stats row ────────────────────────────────────────────── #}
    {%- set total_jobs    = (stats.active + stats.history) if stats is defined else 0 -%}
    {%- set active_jobs   = stats.active if stats is defined else 0 -%}
    {%- set all_agents    = ship_agents() -%}
    {%- set all_cols      = ship_collections() -%}
    {%- set event_total   = total if total is defined else 0 -%}

    <div class="dash-stats" role="list" aria-label="Workspace statistics">
      <ship-stat accent="primary" role="listitem">
        <span slot="label">Total jobs</span>
        {{ total_jobs }}
        <span slot="hint">{{ active_jobs }} active</span>
      </ship-stat>
      <ship-stat accent="accent" role="listitem">
        <span slot="label">Agents</span>
        {{ all_agents | length }}
        <span slot="hint">configured</span>
      </ship-stat>
      <ship-stat accent="info" role="listitem">
        <span slot="label">Events</span>
        {{ event_total }}
        <span slot="hint">in stream</span>
      </ship-stat>
      <ship-stat accent="success" role="listitem">
        <span slot="label">Collections</span>
        {{ all_cols | length }}
        <span slot="hint">schemas defined</span>
      </ship-stat>
    </div>

    {# ── Body grid ────────────────────────────────────────────── #}
    <div class="dash-body">

      {# Recent jobs #}
      <ship-card padding="sm" aria-label="Recent jobs">
        <div slot="header" class="dash-head-row">
          <h2 class="dash-head-title">
            <ship-icon name="refresh" size="sm" tone="muted"></ship-icon>
            Recent jobs
          </h2>
          <ship-button variant="ghost" size="sm" {{ navigate('/api/runtime/view/pipelines') }}>
            View all
            <ship-icon slot="trailing" name="chevron-right" size="sm"></ship-icon>
          </ship-button>
        </div>
        <div role="list">
          {%- set recent_jobs = (active_runs | take(5)) if active_runs is defined else
                                (history_runs | take(5)) if history_runs is defined else [] -%}
          {% if recent_jobs | length > 0 %}
            {% for run in recent_jobs %}
              <ship-list-tile density="compact" interactive role="listitem"
                              tone="{{ run.tone if run.tone is defined else 'default' }}"
                              {{ navigate('/api/runtime/view/pipelines') }}>
                <ship-status-dot slot="leading" size="sm"
                                 tone="{{ run.tone if run.tone is defined else 'muted' }}"></ship-status-dot>
                <span class="dash-mono">{{ run.slug if run.slug is defined else run.id }}</span>
                <span slot="meta">{{ run.agent if run.agent is defined else '—' }}</span>
                <span slot="trailing" class="dash-mono dash-muted">
                  {%- if run.started_at is defined -%}
                    <ship-timestamp value="{{ run.started_at }}"></ship-timestamp>
                  {%- elif run.created_at is defined -%}
                    <ship-timestamp value="{{ run.created_at }}"></ship-timestamp>
                  {%- else -%}—{%- endif -%}
                </span>
              </ship-list-tile>
            {% endfor %}
          {% else %}
            <ship-empty-state variant="placeholder" size="sm" icon="play">
              <span slot="title">No jobs yet</span>
              Start a workflow to see activity here.
            </ship-empty-state>
          {% endif %}
        </div>
      </ship-card>

      {# Agents #}
      <ship-card padding="sm" aria-label="Agents">
        <div slot="header" class="dash-head-row">
          <h2 class="dash-head-title">
            <ship-icon name="users" size="sm" tone="muted"></ship-icon>
            Agents
            <ship-badge tone="muted" variant="soft" size="sm">{{ all_agents | length }}</ship-badge>
          </h2>
          <ship-button variant="ghost" size="sm" {{ navigate('/api/runtime/view/agents') }}>
            Manage
            <ship-icon slot="trailing" name="chevron-right" size="sm"></ship-icon>
          </ship-button>
        </div>
        {% if all_agents | length > 0 %}
        <div class="dash-agents-grid" role="list">
          {% for agent in all_agents | take(8) %}
            <ship-list-tile variant="card" density="compact" interactive role="listitem"
                            data-on:click="window.router ? window.router.navigate('/agents/{{ agent.id }}') : window.location.href='/agents/{{ agent.id }}'">
              <ship-avatar slot="leading" size="sm" tone="accent"
                           name="{{ agent.name if agent.name is defined else agent.id }}"></ship-avatar>
              {{ agent.name if agent.name is defined else agent.id }}
              <span slot="meta">
                {%- if agent.role is defined -%}{{ agent.role }}
                {%- elif agent.description is defined -%}{{ agent.description }}
                {%- else -%}{{ agent.id }}{%- endif -%}
              </span>
            </ship-list-tile>
          {% endfor %}
        </div>
        {% else %}
          <ship-empty-state variant="placeholder" size="sm" icon="users">
            <span slot="title">No agents configured</span>
            Add an agent profile to start dispatching work.
          </ship-empty-state>
        {% endif %}
      </ship-card>

      {# Latest events — full width #}
      <ship-card padding="sm" class="dash-body--wide" aria-label="Latest events">
        <div slot="header" class="dash-head-row">
          <h2 class="dash-head-title">
            <ship-icon name="zap" size="sm" tone="muted"></ship-icon>
            Latest events
          </h2>
          <ship-button variant="ghost" size="sm" {{ navigate('/api/runtime/view/events') }}>
            Full stream
            <ship-icon slot="trailing" name="chevron-right" size="sm"></ship-icon>
          </ship-button>
        </div>
        <div role="list">
          {%- if rows is defined and rows | length > 0 -%}
            {% for r in rows | take(10) %}
              {% include 'dashboard/_components/event_tile.html.j2' %}
            {% endfor %}
          {%- elif groups is defined and groups | length > 0 -%}
            {%- set ev = namespace(n=0) -%}
            {% for g in groups %}{% if ev.n < 10 %}{% for r in g.rows %}{% if ev.n < 10 %}
              {% include 'dashboard/_components/event_tile.html.j2' %}
              {%- set ev.n = ev.n + 1 -%}
            {% endif %}{% endfor %}{% endif %}{% endfor %}
          {%- else -%}
            <ship-empty-state variant="connecting" size="sm" icon="zap">
              <span slot="title">Waiting for events</span>
              New kernel events will appear here as they stream.
            </ship-empty-state>
          {%- endif -%}
        </div>
      </ship-card>

      {# Quick links — full width #}
      <ship-card padding="sm" class="dash-body--wide" aria-label="Quick links">
        <div slot="header" class="dash-head-row">
          <h2 class="dash-head-title">
            <ship-icon name="external-link" size="sm" tone="muted"></ship-icon>
            Quick links
          </h2>
        </div>
        {%- set quick_links = [
          { 'label': 'Workflows', 'href': '/api/runtime/view/pipelines', 'icon': 'refresh',  'tone': 'primary' },
          { 'label': 'Agents',    'href': '/api/runtime/view/agents',    'icon': 'users',    'tone': 'accent'  },
          { 'label': 'Skills',    'href': '/api/runtime/view/skills',    'icon': 'sparkles', 'tone': 'info'    },
          { 'label': 'Data',      'href': '/api/runtime/view/data',      'icon': 'folder',   'tone': 'success' },
          { 'label': 'Events',    'href': '/api/runtime/view/events',    'icon': 'zap',      'tone': 'warning' },
          { 'label': 'Settings',  'href': '/api/runtime/view/settings',  'icon': 'settings', 'tone': 'muted'   }
        ] -%}
        <div class="dash-links" role="list">
          {% for link in quick_links %}
            <ship-list-tile variant="card" density="compact" interactive role="listitem"
                            {{ navigate(link.href) }}>
              <ship-icon slot="leading" name="{{ link.icon }}" size="md" tone="{{ link.tone }}"></ship-icon>
              {{ link.label }}
              <ship-icon slot="trailing" name="chevron-right" size="sm" tone="muted"></ship-icon>
            </ship-list-tile>
          {% endfor %}
        </div>
      </ship-card>

    </div>{# /.dash-body #}
  </div>{# /.dash-wrap #}
</div>{# /.ship-view #}
{% if not fragment %}
</body>
</html>
{% endif %}
