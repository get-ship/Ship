{#-
  Workspace Dashboard — landing page overview for a developer using Ship.
  Shows: header, quick stats, recent jobs, agents, events feed, quick links.
  All data loaded via manifest.yaml. No hardcoded colors or px values.
-#}
{% from '_ship.html.j2' import head, signal, styles %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Dashboard') }}
</head>
<body>
{% endif %}
<div class="ship-view dash">
  {{ styles() }}
  {% include 'dashboard/partials/styles.html.j2' %}
  <div class="dash-wrap">

    {# ── Header ───────────────────────────────────────────────── #}
    <header class="dash-header">
      <div class="dash-wordmark">
        <div class="dash-logo" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <div>
          <h1 class="dash-title">Ship</h1>
          <p class="dash-workspace">
            {%- if settings is defined and settings.workspace_name is defined -%}
              {{ settings.workspace_name }}
            {%- else -%}workspace dashboard{%- endif -%}
          </p>
        </div>
      </div>
      <div class="dash-status-row">
        {#- SDK gap: no ship-element for a live/pulsing status badge.
            Candidate: ship-status-dot with `pulse` + a label slot, or a
            dedicated ship-live-indicator. Kept view-local. -#}
        <div class="dash-live-badge" role="status" aria-label="Live updates active">
          <span class="dash-live-dot"></span>live
        </div>
      </div>
    </header>

    {# ── Stats row ────────────────────────────────────────────── #}
    {%- set total_jobs    = (stats.active + stats.history) if stats is defined else 0 -%}
    {%- set active_jobs   = stats.active if stats is defined else 0 -%}
    {%- set all_agents    = ship_agents() -%}
    {%- set all_cols      = ship_collections() -%}
    {%- set event_total   = total if total is defined else 0 -%}

    {#- SDK gap: ship-stat has no "accent stripe" channel (its `accent` attr
        tints the value text, not a top border-bar). The 2px colored stripe
        is part of dashboard visual identity, so we keep a thin view-local
        wrapper that paints the stripe via `::before` on top of ship-stat. -#}
    <div class="dash-stats" role="list" aria-label="Workspace statistics">
      <div class="dash-stat-wrap dash-stat-wrap--jobs" role="listitem">
        <ship-stat>
          <span slot="label">Total jobs</span>
          {{ total_jobs }}
          <span slot="hint">{{ active_jobs }} active</span>
        </ship-stat>
      </div>
      <div class="dash-stat-wrap dash-stat-wrap--agents" role="listitem">
        <ship-stat>
          <span slot="label">Agents</span>
          {{ all_agents | length }}
          <span slot="hint">configured</span>
        </ship-stat>
      </div>
      <div class="dash-stat-wrap dash-stat-wrap--events" role="listitem">
        <ship-stat>
          <span slot="label">Events</span>
          {{ event_total }}
          <span slot="hint">in stream</span>
        </ship-stat>
      </div>
      <div class="dash-stat-wrap dash-stat-wrap--collections" role="listitem">
        <ship-stat>
          <span slot="label">Collections</span>
          {{ all_cols | length }}
          <span slot="hint">schemas defined</span>
        </ship-stat>
      </div>
    </div>

    {# ── Body grid ────────────────────────────────────────────── #}
    <div class="dash-body">

      {# Recent jobs #}
      <ship-card padding="none" class="dash-section" aria-label="Recent jobs">
        <div slot="header" class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.07 4.93A10 10 0 0 0 6.99 3.34M4 6h.01M2.29 9.62A10 10 0 1 0 21.54 16"/>
            </svg>
            Recent jobs
          </h2>
          <a class="dash-section-link" href="/api/runtime/view/pipelines"
             data-on:click.prevent="@get('/api/runtime/view/pipelines')">
            View all <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="dash-jobs-list">
          {%- set recent_jobs = (active_runs | take(5)) if active_runs is defined else
                                (history_runs | take(5)) if history_runs is defined else [] -%}
          {% if recent_jobs | length > 0 %}
            {% for run in recent_jobs %}
            <ship-list-tile density="compact" class="dash-job-tile">
              <ship-status-dot slot="leading" tone="{{ run.tone if run.tone is defined else 'muted' }}"></ship-status-dot>
              <span class="dash-job-name">{{ run.slug if run.slug is defined else run.id }}</span>
              <span slot="trailing" class="dash-job-trailing">
                <span class="dash-job-agent">{{ run.agent if run.agent is defined else '—' }}</span>
                {%- set ts = run.started_at if run.started_at is defined else (run.created_at if run.created_at is defined else '') -%}
                {%- if ts -%}
                  <ship-timestamp value="{{ ts }}" class="dash-job-time"></ship-timestamp>
                {%- else -%}
                  <span class="dash-job-time">—</span>
                {%- endif -%}
              </span>
            </ship-list-tile>
            {% endfor %}
          {% else %}
            <ship-empty-state variant="placeholder" size="sm" icon="play">
              <span slot="title">No jobs yet</span>
              Start a workflow to see runs here.
            </ship-empty-state>
          {% endif %}
        </div>
      </ship-card>

      {# Agents #}
      <ship-card padding="none" class="dash-section" aria-label="Agents">
        <div slot="header" class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            Agents
            <ship-badge tone="muted" variant="soft" size="sm">{{ all_agents | length }}</ship-badge>
          </h2>
          <a class="dash-section-link" href="/api/runtime/view/agents"
             data-on:click.prevent="@get('/api/runtime/view/agents')">
            Manage <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="dash-section-body">
          {% if all_agents | length > 0 %}
          <div class="dash-agents-grid">
            {% for agent in all_agents | take(8) %}
            {%- set agent_name = agent.name if agent.name is defined else agent.id -%}
            {%- set agent_initial = (agent.name[0] if agent.name is defined and agent.name | length > 0 else 'A') -%}
            <ship-list-tile
               variant="card"
               density="compact"
               interactive
               class="dash-agent-tile"
               data-on:click.prevent="window.router ? window.router.navigate('/agents/{{ agent.id }}') : void(0)">
              <ship-avatar slot="leading" size="sm" initials="{{ agent_initial }}" name="{{ agent_name }}"></ship-avatar>
              <span class="dash-agent-name">{{ agent_name }}</span>
              <span slot="meta" class="dash-agent-role">
                {%- if agent.role is defined -%}{{ agent.role }}
                {%- elif agent.description is defined -%}{{ agent.description }}
                {%- else -%}{{ agent.id }}{%- endif -%}
              </span>
            </ship-list-tile>
            {% endfor %}
          </div>
          {% else %}
          <ship-empty-state variant="placeholder" size="sm" icon="user-plus">
            <span slot="title">No agents configured</span>
            Add an agent to dispatch work.
          </ship-empty-state>
          {% endif %}
        </div>
      </ship-card>

      {# Latest events — full width #}
      {#- SDK gap: the events feed is a 3-column grid (timestamp / type / actor)
          that doesn't flex into ship-list-tile's leading/primary/trailing slot
          layout cleanly. Kept as view-local composition until we add a
          grid-tile primitive or a ship-log-row. -#}
      <ship-card padding="none" class="dash-section dash-body--wide" aria-label="Latest events">
        <div slot="header" class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            Latest events
          </h2>
          <a class="dash-section-link" href="/api/runtime/view/events"
             data-on:click.prevent="@get('/api/runtime/view/events')">
            Full stream <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="dash-section-body">
          {%- if rows is defined and rows | length > 0 -%}
            {% for r in rows | take(10) %}
            <div class="dash-event-row">
              <span class="dash-event-ts">{{ r.timestamp }}</span>
              <span class="dash-event-type">{{ r.event_type }}</span>
              <span class="dash-event-actor">{{ r.actor if r.actor is defined else '—' }}</span>
            </div>
            {% endfor %}
          {%- elif groups is defined and groups | length > 0 -%}
            {%- set ev = namespace(n=0) -%}
            {% for g in groups %}{% if ev.n < 10 %}{% for r in g.rows %}{% if ev.n < 10 %}
            <div class="dash-event-row">
              <span class="dash-event-ts">{{ r.timestamp }}</span>
              <span class="dash-event-type">{{ r.event_type }}</span>
              <span class="dash-event-actor">{{ r.actor if r.actor is defined else '—' }}</span>
            </div>
            {%- set ev.n = ev.n + 1 -%}
            {% endif %}{% endfor %}{% endif %}{% endfor %}
          {%- else -%}
            <ship-empty-state variant="placeholder" size="sm" icon="activity">
              <span slot="title">Waiting for events</span>
              The stream will fill as the daemon emits events.
            </ship-empty-state>
          {%- endif -%}
        </div>
      </ship-card>

      {# Quick links — full width #}
      {#- SDK gap: vertical icon-above-label tile pattern. No ship-element
          covers this shape today — ship-list-tile is row-oriented with
          leading/primary/trailing; ship-card is a full panel, not a
          compact action tile. Candidate: a `ship-action-tile` primitive
          (icon tile + label) for quick-nav grids. Kept view-local. -#}
      <ship-card padding="none" class="dash-section dash-body--wide" aria-label="Quick links">
        <div slot="header" class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            Quick links
          </h2>
        </div>
        {% include 'dashboard/partials/quick_links.html.j2' %}
      </ship-card>

    </div>{# /.dash-body #}
  </div>{# /.dash-wrap #}
</div>{# /#ship-view-root #}
{% if not fragment %}
</body>
</html>
{% endif %}
