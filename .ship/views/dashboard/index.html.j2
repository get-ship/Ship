{#-
  Workspace Dashboard — landing page overview for a developer using Ship.
  Shows: header, quick stats, recent jobs, agents, events feed, quick links.
  All data loaded via manifest.yaml. No hardcoded colors or px values.
-#}
{% from '_ship.html.j2' import head, signal, styles %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Dashboard') }}
</head>
<body>
{% endif %}
<div id="ship-view-root" class="ship-view dash">
  {{ styles() }}
  {% include 'dashboard/partials/styles.html.j2' %}
  <div class="dash-wrap">

    {# ── Header ───────────────────────────────────────────────── #}
    <header class="dash-header">
      <div class="dash-wordmark">
        <div class="dash-logo" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
        </div>
        <div>
          <h1 class="dash-title">Ship</h1>
          <p class="dash-workspace">
            {%- if settings is defined and settings.workspace_name is defined -%}
              {{ settings.workspace_name }}
            {%- else -%}workspace dashboard{%- endif -%}
          </p>
        </div>
      </div>
      <div class="dash-status-row">
        <div class="dash-live-badge" role="status" aria-label="Live updates active">
          <span class="dash-live-dot"></span>live
        </div>
      </div>
    </header>

    {# ── Stats row ────────────────────────────────────────────── #}
    {%- set total_jobs    = (stats.active + stats.history) if stats is defined else 0 -%}
    {%- set active_jobs   = stats.active if stats is defined else 0 -%}
    {%- set all_agents    = ship_agents() -%}
    {%- set all_cols      = ship_collections() -%}
    {%- set event_total   = total if total is defined else 0 -%}

    <div class="dash-stats" role="list" aria-label="Workspace statistics">
      <div class="dash-stat-card dash-stat-card--jobs" role="listitem">
        <span class="dash-stat-label">Total jobs</span>
        <span class="dash-stat-value">{{ total_jobs }}</span>
        <span class="dash-stat-sub">{{ active_jobs }} active</span>
      </div>
      <div class="dash-stat-card dash-stat-card--agents" role="listitem">
        <span class="dash-stat-label">Agents</span>
        <span class="dash-stat-value">{{ all_agents | length }}</span>
        <span class="dash-stat-sub">configured</span>
      </div>
      <div class="dash-stat-card dash-stat-card--events" role="listitem">
        <span class="dash-stat-label">Events</span>
        <span class="dash-stat-value">{{ event_total }}</span>
        <span class="dash-stat-sub">in stream</span>
      </div>
      <div class="dash-stat-card dash-stat-card--collections" role="listitem">
        <span class="dash-stat-label">Collections</span>
        <span class="dash-stat-value">{{ all_cols | length }}</span>
        <span class="dash-stat-sub">schemas defined</span>
      </div>
    </div>

    {# ── Body grid ────────────────────────────────────────────── #}
    <div class="dash-body">

      {# Recent jobs #}
      <section class="dash-section" aria-label="Recent jobs">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.07 4.93A10 10 0 0 0 6.99 3.34M4 6h.01M2.29 9.62A10 10 0 1 0 21.54 16"/>
            </svg>
            Recent jobs
          </h2>
          <a class="dash-section-link" href="/api/runtime/view/pipelines"
             data-on:click.prevent="@get('/api/runtime/view/pipelines')">
            View all <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="dash-section-body">
          {%- set recent_jobs = (active_runs | take(5)) if active_runs is defined else
                                (history_runs | take(5)) if history_runs is defined else [] -%}
          {% if recent_jobs | length > 0 %}
            {% for run in recent_jobs %}
            <div class="dash-job-item">
              <span class="dash-job-dot">
                <ship-status-dot tone="{{ run.tone if run.tone is defined else 'muted' }}"></ship-status-dot>
              </span>
              <span class="dash-job-name">{{ run.slug if run.slug is defined else run.id }}</span>
              <span class="dash-job-agent">{{ run.agent if run.agent is defined else '—' }}</span>
              <span class="dash-job-time">
                {%- if run.started_at is defined -%}{{ run.started_at }}
                {%- elif run.created_at is defined -%}{{ run.created_at }}
                {%- else -%}—{%- endif -%}
              </span>
            </div>
            {% endfor %}
          {% else %}
            <div class="dash-empty">
              <ship-icon name="play" size="lg" tone="muted"></ship-icon>
              <span class="dash-empty-label">No jobs yet — start a workflow</span>
            </div>
          {% endif %}
        </div>
      </section>

      {# Agents #}
      <section class="dash-section" aria-label="Agents">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            Agents
            <ship-badge tone="muted" variant="soft" size="sm">{{ all_agents | length }}</ship-badge>
          </h2>
          <a class="dash-section-link" href="/api/runtime/view/agents"
             data-on:click.prevent="@get('/api/runtime/view/agents')">
            Manage <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="dash-section-body">
          {% if all_agents | length > 0 %}
          <div class="dash-agents-grid">
            {% for agent in all_agents | take(8) %}
            <a class="dash-agent-pill"
               href="/agents/{{ agent.id }}"
               data-on:click.prevent="window.router ? window.router.navigate('/agents/{{ agent.id }}') : void(0)">
              <div class="dash-agent-avatar" aria-hidden="true">
                {{ agent.name[0] if agent.name is defined and agent.name | length > 0 else 'A' }}
              </div>
              <div class="dash-agent-info">
                <p class="dash-agent-name">{{ agent.name if agent.name is defined else agent.id }}</p>
                <p class="dash-agent-role">
                  {%- if agent.role is defined -%}{{ agent.role }}
                  {%- elif agent.description is defined -%}{{ agent.description }}
                  {%- else -%}{{ agent.id }}{%- endif -%}
                </p>
              </div>
            </a>
            {% endfor %}
          </div>
          {% else %}
          <div class="dash-empty">
            <ship-icon name="user-plus" size="lg" tone="muted"></ship-icon>
            <span class="dash-empty-label">No agents configured</span>
          </div>
          {% endif %}
        </div>
      </section>

      {# Latest events — full width #}
      <section class="dash-section dash-body--wide" aria-label="Latest events">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            Latest events
          </h2>
          <a class="dash-section-link" href="/api/runtime/view/events"
             data-on:click.prevent="@get('/api/runtime/view/events')">
            Full stream <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
        <div class="dash-section-body">
          {%- if rows is defined and rows | length > 0 -%}
            {% for r in rows | take(10) %}
            <div class="dash-event-row">
              <span class="dash-event-ts">{{ r.timestamp }}</span>
              <span class="dash-event-type">{{ r.event_type }}</span>
              <span class="dash-event-actor">{{ r.actor if r.actor is defined else '—' }}</span>
            </div>
            {% endfor %}
          {%- elif groups is defined and groups | length > 0 -%}
            {%- set ev = namespace(n=0) -%}
            {% for g in groups %}{% if ev.n < 10 %}{% for r in g.rows %}{% if ev.n < 10 %}
            <div class="dash-event-row">
              <span class="dash-event-ts">{{ r.timestamp }}</span>
              <span class="dash-event-type">{{ r.event_type }}</span>
              <span class="dash-event-actor">{{ r.actor if r.actor is defined else '—' }}</span>
            </div>
            {%- set ev.n = ev.n + 1 -%}
            {% endif %}{% endfor %}{% endif %}{% endfor %}
          {%- else -%}
            <div class="dash-empty">
              <ship-icon name="activity" size="lg" tone="muted"></ship-icon>
              <span class="dash-empty-label">Waiting for events</span>
            </div>
          {%- endif -%}
        </div>
      </section>

      {# Quick links — full width #}
      <section class="dash-section dash-body--wide" aria-label="Quick links">
        <div class="dash-section-head">
          <h2 class="dash-section-title">
            <svg class="dash-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            Quick links
          </h2>
        </div>
        <div class="dash-links">
          <a class="dash-link-btn" href="/api/runtime/view/pipelines" data-on:click.prevent="@get('/api/runtime/view/pipelines')">
            <div class="dash-link-icon dash-link-icon--workflows" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 0 0 6.99 3.34M4 6h.01M2.29 9.62A10 10 0 1 0 21.54 16"/>
              </svg>
            </div>Workflows
          </a>
          <a class="dash-link-btn" href="/api/runtime/view/agents" data-on:click.prevent="@get('/api/runtime/view/agents')">
            <div class="dash-link-icon dash-link-icon--agents" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
            </div>Agents
          </a>
          <a class="dash-link-btn" href="/api/runtime/view/skills" data-on:click.prevent="@get('/api/runtime/view/skills')">
            <div class="dash-link-icon dash-link-icon--skills" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>Skills
          </a>
          <a class="dash-link-btn" href="/api/runtime/view/data" data-on:click.prevent="@get('/api/runtime/view/data')">
            <div class="dash-link-icon dash-link-icon--data" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
              </svg>
            </div>Data
          </a>
          <a class="dash-link-btn" href="/api/runtime/view/events" data-on:click.prevent="@get('/api/runtime/view/events')">
            <div class="dash-link-icon dash-link-icon--events" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            </div>Events
          </a>
          <a class="dash-link-btn" href="/api/runtime/view/settings" data-on:click.prevent="@get('/api/runtime/view/settings')">
            <div class="dash-link-icon dash-link-icon--settings" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 0-14.14 0M4.93 19.07a10 10 0 0 0 14.14 0M20.83 9A10 10 0 0 0 3.17 9m17.66 6a10 10 0 0 1-17.66 0"/>
              </svg>
            </div>Settings
          </a>
        </div>
      </section>

    </div>{# /.dash-body #}
  </div>{# /.dash-wrap #}
</div>{# /#ship-view-root #}
{% if not fragment %}
</body>
</html>
{% endif %}
