{#-
  First-run setup wizard — welcome → workspace → provider → done.
  Rendered at /api/v1/view/setup; installer-lane mounts it at /setup.

  State: client-side Datastar signals (no SSE). Writes go via `@post`;
  servers patch response signals (`$ws_error`, `$provider_test_result`)
  per the CQRS pattern in the ship-views skill.
-#}
{% from '_ship.html.j2' import head, signal, attr_if %}

{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Set up Ship') }}</head>
<body>
{% endif %}

<div class="ship-view setup-view"
     {{ signal('step', 1) }}
     {{ signal('ws_mode', 'new') }}
     {{ signal('ws_name', '') }}
     {{ signal('ws_path', '') }}
     {{ signal('ws_error', '') }}
     {{ signal('provider', '') }}
     {{ signal('api_key', '') }}
     {{ signal('provider_test_result', 'idle') }}
     {{ signal('provider_test_error', '') }}>

  {#- Minimal bespoke CSS: only page-frame + progress-dots + provider-grid.
      Everything else is ship-* primitives + canonical tokens.          -#}
  <style>
    .setup-view {
      color: var(--foreground);
      background: var(--background);
      font-family: var(--font-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .setup-wrap {
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-5);
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .setup-stepper-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: var(--space-8);
    }

    .setup-eyebrow {
      font-size: var(--text-xs);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted-foreground);
      margin: 0 0 var(--space-3);
      font-weight: var(--font-weight-semibold);
    }
    .setup-title {
      font-family: var(--heading-font);
      font-size: var(--text-3xl);
      font-weight: var(--heading-weight);
      line-height: var(--leading-tight);
      letter-spacing: var(--heading-tracking);
      margin: 0 0 var(--space-3);
      color: var(--foreground);
    }
    .setup-lede {
      font-size: var(--text-md);
      line-height: var(--leading-normal);
      color: var(--muted-foreground);
      margin: 0 0 var(--space-6);
    }
    .setup-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-3);
      margin-top: var(--space-7);
    }
    .setup-actions--end { justify-content: flex-end; }

    .setup-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
    .setup-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2);
    }
    @media (max-width: 420px) {
      .setup-grid-2, .setup-grid-3 { grid-template-columns: 1fr; }
    }

  </style>

  <div class="setup-wrap">

    {# ── Progress indicator ───────────────────────────────────────── #}
    <div class="setup-stepper-wrap">
      <ship-stepper total="4" label="Setup progress"
                    {{ attr_if('$step', 'current') }}></ship-stepper>
    </div>

    {# ── Step panels ──────────────────────────────────────────────── #}
    <ship-card padding="lg" role="region" aria-labelledby="setup-step-title">
      <div data-show="$step == 1">
        {% include 'setup/partials/step-welcome.html.j2' %}
      </div>
      <div data-show="$step == 2" style="display:none">
        {% include 'setup/partials/step-workspace.html.j2' %}
      </div>
      <div data-show="$step == 3" style="display:none">
        {% include 'setup/partials/step-provider.html.j2' %}
      </div>
      <div data-show="$step == 4" style="display:none">
        {% include 'setup/partials/step-done.html.j2' %}
      </div>
    </ship-card>
  </div>

</div>
{% if not fragment %}
</body>
</html>
{% endif %}
