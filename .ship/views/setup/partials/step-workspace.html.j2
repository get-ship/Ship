{#- Step 2 — Create or open a workspace.
    Submit → @post /api/projects. Server patches $ws_error on failure. -#}
{% from '_ship.html.j2' import bind, on, on_fetch_error, on_click, attr_if %}

<p class="setup-eyebrow">Step 2 of 4</p>
<h2 class="setup-title">Pick a project folder</h2>
<p class="setup-lede">
  Ship stores agents, pipelines, and sessions under
  <ship-code>.ship/</ship-code> in the project folder. Start a new one
  or point at an existing repo.
</p>

{#- Segmented control; `active` reflects on the host so Datastar can
    drive it via data-attr:active, and we listen to ship-tab-change to
    mirror it back into $ws_mode.                                      -#}
<ship-tabs variant="segmented" size="md"
           {{ attr_if('$ws_mode', 'active') }}
           {{ on('ship-tab-change', "$ws_mode = evt.detail.name; $ws_error = ''") }}
           style="width:100%; margin-bottom: var(--space-5)">
  <ship-tab name="new" label="Create new project"></ship-tab>
  <ship-tab name="existing" label="Open existing project"></ship-tab>

  <ship-tab-panel name="new" style="padding-top: var(--space-2)">
    <ship-field>
      <ship-label for="setup-ws-name">Project name</ship-label>
      <ship-input id="setup-ws-name" size="md" placeholder="my-ship-project"
                  {{ bind('ws_name') }}></ship-input>
      <span slot="hint" style="font-size:var(--text-xs); color:var(--muted-foreground)">
        Stored at <ship-code>~/Documents/Ship/&lt;name&gt;</ship-code> by default.
      </span>
    </ship-field>
  </ship-tab-panel>

  <ship-tab-panel name="existing" style="padding-top: var(--space-2)">
    <ship-field>
      <ship-label for="setup-ws-path">Folder path</ship-label>
      <ship-input id="setup-ws-path" size="md"
                  placeholder="/Users/you/code/my-repo"
                  {{ bind('ws_path') }}></ship-input>
      <span slot="hint" style="font-size:var(--text-xs); color:var(--muted-foreground)">
        Must exist and not already be a Ship workspace.
      </span>
    </ship-field>
  </ship-tab-panel>
</ship-tabs>

{#- Server patches $ws_error via SSE on failure. -#}
<ship-alert tone="destructive" data-show="$ws_error" style="display:none; margin-bottom:var(--space-4)">
  <span data-text="$ws_error"></span>
</ship-alert>

<div class="setup-actions">
  <ship-button variant="ghost" size="md"
               {{ on_click('$step = 1') }}>
    <ship-icon slot="leading" name="arrow-left"></ship-icon>
    Back
  </ship-button>

  {#- Optimistic advance; `on_fetch_error` scopes a listener on this
      element so a 4xx / 5xx / non-SSE response patches $ws_error into
      the inline error slot without any custom JS.                   -#}
  <ship-button tone="primary" variant="solid" size="md"
               {{ attr_if("($ws_mode == 'new' ? !$ws_name : !$ws_path)", 'disabled') }}
               {{ on_click("$step = 3; @post('/api/projects', {payload: {mode: $ws_mode, name: $ws_name, path: $ws_path}})") }}
               {{ on_fetch_error('ws_error', "'Could not create workspace (HTTP ' + (evt.detail.argsRaw && evt.detail.argsRaw.status || '?') + ')'") }}>
    Continue
    <ship-icon slot="trailing" name="arrow-right"></ship-icon>
  </ship-button>
</div>
