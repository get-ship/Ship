{#- Step 3 — Pick and test an AI provider. Skippable. -#}
{% from '_ship.html.j2' import bind, on_fetch_error %}

<p class="setup-eyebrow">Step 3 of 4</p>
<h2 class="setup-title">Connect an AI provider</h2>
<p class="setup-lede">
  Ship talks to whichever provider CLIs you have installed. Pick one to
  start with — add more or change later from settings.
</p>

{#- Provider picker: one interactive card per provider, tinted via
    `fill + tone=accent` when selected. Selection mirrors into
    $provider; switching resets the test state.                    -#}
<div class="setup-grid-2" role="radiogroup" aria-label="AI provider"
     style="margin-bottom: var(--space-5)">
  {% for p in [
    { 'id': 'claude',   'name': 'Claude',   'sub': 'Anthropic · claude' },
    { 'id': 'gemini',   'name': 'Gemini',   'sub': 'Google · gemini' },
    { 'id': 'codex',    'name': 'Codex',    'sub': 'OpenAI · codex' },
    { 'id': 'opencode', 'name': 'OpenCode', 'sub': 'Open source · opencode' },
  ] %}
  <ship-card interactive padding="md" role="radio"
             data-attr:tone="$provider == '{{ p.id }}' ? 'accent' : ''"
             data-attr:fill="$provider == '{{ p.id }}'"
             data-attr:aria-checked="$provider == '{{ p.id }}'"
             data-on:click="$provider = '{{ p.id }}'; $api_key = ''; $provider_test_result = 'idle'; $provider_test_error = ''">
    <div style="display:flex; align-items:center; gap:var(--space-3)">
      <ship-provider-blob provider="{{ p.id }}" size="md" variant="glyph"></ship-provider-blob>
      <div style="min-width:0">
        <div style="font-size:var(--text-md); font-weight:var(--font-weight-semibold); color:var(--foreground)">
          {{ p.name }}
        </div>
        <div style="font-size:var(--text-xs); color:var(--muted-foreground); margin-top:2px">
          {{ p.sub }}
        </div>
      </div>
    </div>
  </ship-card>
  {% endfor %}
</div>

{#- Per-provider key + test ────────────────────────────────────── -#}
<div data-show="$provider" style="display:none; margin-bottom: var(--space-4)">
  <ship-field>
    <ship-label for="setup-api-key">API key</ship-label>
    <ship-input id="setup-api-key" size="md" type="password"
                placeholder="sk-..."
                {{ bind('api_key') }}
                data-on:input="$provider_test_result = 'idle'; $provider_test_error = ''"></ship-input>
    <span slot="hint" style="font-size:var(--text-xs); color:var(--muted-foreground)">
      Stored locally in your Ship settings. Never sent anywhere but the
      provider you chose.
    </span>
  </ship-field>

  <div style="display:flex; align-items:center; gap:var(--space-3); margin-top:var(--space-3)">
    {#- Single document-level listener on this element: on error, flip
        the result signal to 'failed' AND drop a human-readable message
        into $provider_test_error. Two SDK macros would clobber each
        other on the same data-on attribute, so we inline the chain.  -#}
    <ship-button variant="outline" size="sm"
                 data-attr:disabled="!$api_key || $provider_test_result == 'testing'"
                 data-attr:loading="$provider_test_result == 'testing'"
                 data-on:click="$provider_test_result = 'testing'; @post('/api/providers/test', {payload: {provider: $provider, key: $api_key}})"
                 data-on:datastar-fetch__document="evt.detail && evt.detail.el === el && evt.detail.type === 'error' ? ($provider_test_result = 'failed', $provider_test_error = 'Could not reach ' + $provider + ' (HTTP ' + (evt.detail.argsRaw && evt.detail.argsRaw.status || '?') + ')') : null">
      Test connection
    </ship-button>

    <ship-badge tone="success" variant="soft" size="sm"
                data-show="$provider_test_result == 'ok'" style="display:none">
      <ship-icon slot="leading" name="check"></ship-icon>
      Connected
    </ship-badge>
    <ship-badge tone="destructive" variant="soft" size="sm"
                data-show="$provider_test_result == 'failed'" style="display:none">
      <span data-text="$provider_test_error || 'Connection failed.'"></span>
    </ship-badge>
  </div>
</div>

<div class="setup-actions">
  <ship-button variant="ghost" size="md"
               data-on:click="$provider = ''; $api_key = ''; $provider_test_result = 'idle'; $step = 4">
    Skip, configure later
  </ship-button>

  <ship-button tone="accent" variant="solid" size="md"
               data-attr:disabled="$provider_test_result != 'ok'"
               data-on:click="$step = 4; @post('/api/settings', {payload: {provider: $provider, key: $api_key}})">
    Save &amp; continue
    <ship-icon slot="trailing" name="arrow-right"></ship-icon>
  </ship-button>
</div>
