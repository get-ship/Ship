{#- Override: one message bubble with identity-hue avatar per sender.
    Embedded fallback at apps/shipd/templates/chat/partials/message.html.j2. -#}
<div class="chat-row" data-sender="{{ m.sender }}">
  {% if m.sender != 'system' %}
    <ship-avatar size="sm" shape="round"
                 identity-hue="{{ m.sender_id | default(m.sender) }}"
                 name="{{ m.sender_name | default(m.sender) }}"></ship-avatar>
  {% endif %}
  <div class="chat-bubble" data-sender="{{ m.sender }}" data-event-type="{{ m.event_type }}">
    <span class="content">{{ m.content }}</span>
    {% if m.detail %}<span class="detail">{{ m.detail }}</span>{% endif %}
    <span class="meta">{{ m.timestamp }}</span>
  </div>
</div>
