{#- SDK gaps:
    - no submit() macro — must use raw data-on:submit for form submission
    - no bind() macro — must use raw data-bind for two-way input binding
    - no keyboard shortcut macro (Enter-to-submit pattern)
-#}
{#-
  Chat view -- conversation + composer.
  The daemon passes workspace_id, messages, total as Jinja context.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal, show, live, loading, attr %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Chat') }}
  <style>
  .ship-view-chat { color: var(--foreground); display: flex; flex-direction: column; height: 100%; min-height: 420px; }
  .chat-wrap { display: flex; flex-direction: column; flex: 1; min-height: 0; max-width: 720px; width: 100%; margin: 0 auto; }
  .chat-header { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--border); font-size: 12px; color: var(--muted-foreground); }
  .chat-header .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--primary); }
  .chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; min-height: 0; }
  .chat-bubble { max-width: 78%; padding: 8px 12px; border-radius: var(--radius-md); font-size: 12px; line-height: 1.45; }
  .chat-bubble[data-sender="user"] { align-self: flex-end; background: color-mix(in oklch, var(--primary) 12%, transparent); }
  .chat-bubble[data-sender="agent"] { align-self: flex-start; background: color-mix(in oklch, var(--muted) 40%, transparent); }
  .chat-bubble[data-sender="system"] { align-self: center; background: transparent; font-size: 11px; color: var(--muted-foreground); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 4px 12px; }
  .chat-bubble .meta { display: block; font-size: 10px; color: var(--muted-foreground); margin-top: 4px; }
  .chat-bubble .detail { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; color: var(--warning); margin-top: 4px; }
  .chat-empty { text-align: center; color: var(--muted-foreground); font-size: 12px; padding: 48px 16px; }
  .chat-composer { border-top: 1px solid var(--border); padding: 10px 12px; display: flex; gap: 8px; align-items: flex-end; }
  .chat-composer textarea { flex: 1; min-height: 36px; max-height: 160px; resize: vertical; border: 1px solid var(--border); background: var(--background); color: var(--foreground); border-radius: var(--radius-md); padding: 8px 10px; font: inherit; font-size: 12px; }
  .chat-composer textarea:focus { outline: none; border-color: color-mix(in oklch, var(--primary) 50%, var(--border)); }
  </style>
</head>
<body>
<div id="chat-root" class="ship-view ship-view-chat"
     {{ signal('draft', '') }}
     {{ signal('workspace_id', workspace_id) }}
     {{ signal('sending', false) }}>
  <div class="chat-wrap">
    <div class="chat-header">
      <span class="dot"></span>
      <span>Chat</span>
      {% if workspace_id %}<span style="margin-left:auto">{{ workspace_id }}</span>{% endif %}
    </div>

    <div id="chat-messages" class="chat-messages"
         data-init="@get('/api/runtime/view/chat/sse{% if workspace_id %}?workspace_id={{ workspace_id }}{% endif %}', {requestCancellation: 'disabled'})">
      {% include 'chat/partials/messages.html.j2' %}
    </div>

    <form id="chat-composer" class="chat-composer"
          data-on:submit="event.preventDefault(); $sending = true; @post('/api/runtime/view/chat/send', {contentType: 'json', body: JSON.stringify({text: $draft, workspace_id: $workspace_id || null})}); $draft = ''; $sending = false">
      <textarea name="text" placeholder="Message the agent..."
                data-bind="draft"
                {{ loading('sending') }}
                data-on:keydown="if (evt.key === 'Enter' && !evt.shiftKey) { evt.preventDefault(); evt.target.form.requestSubmit(); }"></textarea>
      <ship-button type="submit" tone="accent" variant="solid" size="sm"
                   {{ attr('disabled', '$sending') }}>Send</ship-button>
    </form>
  </div>
</div>
</body>
</html>
