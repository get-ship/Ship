{#- SDK gaps:
    - no submit() macro — must use raw data-on:submit for form submission
    - no bind() macro — must use raw data-bind for two-way input binding
    - no keyboard shortcut macro (Enter-to-submit pattern)
-#}
{#-
  Chat view -- conversation + composer.
  The daemon passes workspace_id, messages, total as Jinja context.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal, show, live, loading, attr %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Chat') }}</head>
<body>
{% endif %}
{%- set _state = ship.chat.state(workspace_id=ship.query.workspace_id | default('')) -%}
{%- set workspace_id = _state.workspace_id -%}
{%- set messages = _state.messages -%}
{%- set total = _state.total -%}
<div class="ship-view ship-view-chat"
     {{ signal('draft', '') }}
     {{ signal('workspace_id', workspace_id) }}
     {{ signal('sending', false) }}>
  <style>
  .ship-view-chat { color: var(--foreground); display: flex; flex-direction: column; height: 100%; min-height: 420px; }
  .chat-wrap { display: flex; flex-direction: column; flex: 1; min-height: 0; max-width: 720px; width: 100%; margin: 0 auto; }
  .chat-header { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--border); font-size: var(--text-xs); color: var(--muted-foreground); }
  .chat-header .dot { width: var(--space-1); height: var(--space-1); border-radius: 999px; background: var(--primary); }
  .chat-messages { flex: 1; overflow-y: auto; padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); min-height: 0; }
  .chat-row { display: flex; gap: var(--space-2); align-items: flex-end; max-width: 100%; }
  .chat-row[data-sender="user"] { flex-direction: row-reverse; margin-left: auto; }
  .chat-row[data-sender="system"] { justify-content: center; }
  .chat-bubble { max-width: 78%; padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); font-size: var(--text-xs); line-height: 1.45; }
  .chat-bubble[data-sender="user"] { background: color-mix(in oklch, var(--primary) 12%, transparent); }
  .chat-bubble[data-sender="agent"] { background: color-mix(in oklch, var(--muted) 40%, transparent); }
  .chat-bubble[data-sender="system"] { background: transparent; font-size: var(--text-xs); color: var(--muted-foreground); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: var(--space-1) var(--space-3); }
  .chat-bubble .meta { display: block; font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1); }
  .chat-bubble .detail { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-xs); color: var(--warning); margin-top: var(--space-1); }
  .chat-empty { text-align: center; color: var(--muted-foreground); font-size: var(--text-xs); padding: var(--space-12) var(--space-4); }
  .chat-composer { border-top: 1px solid var(--border); padding: var(--space-2) var(--space-3); display: flex; gap: var(--space-2); align-items: flex-end; }
  .chat-composer textarea { flex: 1; min-height: 36px; max-height: 160px; resize: vertical; border: 1px solid var(--border); background: var(--background); color: var(--foreground); border-radius: var(--radius-md); padding: var(--space-2) var(--space-2); font: inherit; font-size: var(--text-xs); }
  .chat-composer textarea:focus { outline: none; border-color: color-mix(in oklch, var(--primary) 50%, var(--border)); }
  </style>
  <div class="chat-wrap">
    <div class="chat-header">
      <span class="dot"></span>
      <span>Chat</span>
      {% if workspace_id %}<span style="margin-left:auto">{{ workspace_id }}</span>{% endif %}
    </div>

    <div id="chat-messages" class="chat-messages"
         data-init="@get('/api/sse/chat{% if workspace_id %}?workspace_id={{ workspace_id }}{% endif %}', {requestCancellation: 'disabled'})">
      {% include 'chat/partials/messages.html.j2' %}
    </div>

    <form id="chat-composer" class="chat-composer"
          data-on:submit="event.preventDefault(); $sending = true; @post('/api/chat/send', {contentType: 'json', body: JSON.stringify({text: $draft, workspace_id: $workspace_id || null})}); $draft = ''; $sending = false">
      <textarea name="text" placeholder="Message the agent..."
                data-bind="draft"
                {{ loading('sending') }}
                data-on:keydown="if (evt.key === 'Enter' && !evt.shiftKey) { evt.preventDefault(); evt.target.form.requestSubmit(); }"></textarea>
      <ship-button type="submit" tone="accent" variant="solid" size="sm"
                   {{ attr('disabled', '$sending') }}>Send</ship-button>
    </form>
  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
