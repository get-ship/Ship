{#- SDK gaps:
    - no submit() macro — must use raw data-on:submit for form submission
    - no bind() macro — must use raw data-bind for two-way input binding
    - no keyboard shortcut macro (Enter-to-submit pattern)
-#}
{#-
  Chat view -- conversation + composer.
  The daemon passes workspace_id, messages, total as Jinja context.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal, show, live, loading, attr, bind, submit, on %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Chat') }}
  <style>
  .chat-root { display: flex; flex-direction: column; height: 100%; min-height: 420px; }
  .chat-wrap { display: flex; flex-direction: column; flex: 1; min-height: 0; max-width: 720px; width: 100%; margin: 0 auto; }
  .chat-messages { flex: 1; overflow-y: auto; padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  .chat-bubble { max-width: 78%; padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); font-size: var(--text-sm); }
  .chat-bubble[data-sender="user"] { align-self: flex-end; background: color-mix(in oklch, var(--primary) 12%, transparent); }
  .chat-bubble[data-sender="agent"] { align-self: flex-start; background: var(--muted); }
  .chat-bubble[data-sender="system"] { align-self: center; font-size: var(--text-xs); color: var(--muted-foreground); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .chat-composer { border-top: 1px solid var(--border); padding: var(--space-3); display: flex; gap: var(--space-2); align-items: flex-end; }
  </style>
</head>
<body>
<div id="chat-root" class="ship-view chat-root"
     {{ signal('draft', '') }}
     {{ signal('workspace_id', workspace_id) }}
     {{ signal('sending', false) }}>
  <div class="chat-wrap">
    <ship-toolbar>
      <ship-status-dot tone="accent"></ship-status-dot>
      <span>Chat</span>
      {% if workspace_id %}<span>{{ workspace_id }}</span>{% endif %}
    </ship-toolbar>

    <div id="chat-messages" class="chat-messages"
         data-init="@get('/api/runtime/view/chat/sse{% if workspace_id %}?workspace_id={{ workspace_id }}{% endif %}', {requestCancellation: 'disabled'})">
      {% include 'chat/partials/messages.html.j2' %}
    </div>

    <form id="chat-composer" class="chat-composer"
          {{ on('submit', "event.preventDefault(); $sending = true; @post('/api/runtime/view/chat/send', {contentType: 'json', body: JSON.stringify({text: $draft, workspace_id: $workspace_id || null})}); $draft = ''; $sending = false") }}>
      <ship-textarea placeholder="Message the agent..."
                {{ bind('draft') }}
                {{ loading('sending') }}
                {{ on('keydown', "if (evt.key === 'Enter' && !evt.shiftKey) { evt.preventDefault(); evt.target.closest('form').requestSubmit(); }") }}></ship-textarea>
      <ship-button type="submit" tone="accent" variant="solid" size="sm"
                   {{ attr('disabled', '$sending') }}>Send</ship-button>
    </form>
  </div>
</div>
</body>
</html>
