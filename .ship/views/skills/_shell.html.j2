{#-
  Shared IDE shell for the skills view. Both `/api/v/skills` and
  `/api/v/skills/<id>` include this to render the explorer + editor +
  optional info panel.

  Inputs (callers set via `{% set ... %}` before include):
    selected_id (str, optional) — currently focused skill id.
-#}
{% from '_ship.html.j2' import head %}

{% set rail = ship.skills.summaries(
  q=ship.query.q | default(''),
  kind=ship.query.kind | default('all'),
  tag=ship.query.tag | default(''),
) %}

{% set skill = none %}
{% set file = none %}
{% if selected_id %}
  {% set skill = ship.skills.detail(id=selected_id) %}
  {% if ship.query.file %}
    {% set file = ship.skills.file(id=selected_id, path=ship.query.file) %}
  {% endif %}
{% endif %}

{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Skills') }}</head>
<body>
{% endif %}
<div class="ship-view ship-view-skills">
  <style>
  .ship-view-skills {
    color: var(--foreground);
    background: var(--background);
    height: 100vh;
    overflow: hidden;
  }
  .skills-ide { display: flex; height: 100%; min-height: 0; }
  @media (max-width: 767px) {
    .skills-ide { display: none; }
    .skills-mobile { display: flex; }
  }
  @media (min-width: 768px) {
    .skills-mobile { display: none; }
  }
  .skills-mobile {
    align-items: center; justify-content: center; height: 100%;
    flex-direction: column; gap: var(--space-2);
    color: var(--muted-foreground); font-size: 14px;
  }
  </style>
  <div class="skills-ide">
    {% include 'skills/partials/explorer.html.j2' %}
    {% include 'skills/partials/editor.html.j2' %}
    {% if skill %}
      {% include 'skills/partials/info.html.j2' %}
    {% endif %}
  </div>
  <div class="skills-mobile">
    <ship-icon name="monitor" size="xl" tone="muted"></ship-icon>
    <span>Best experienced on desktop</span>
  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
