{#-
  File explorer — 240px left pane with search, filter chips, and nested
  skill-to-file tree. Matches React SkillsFileExplorer layout.
-#}
{#- URLs hit the file-routed framework directly: /api/v1/v/skills[/<id>]. -#}
{% from '_ship.html.j2' import on_click %}
<style>
.skills-explorer {
  display: flex; flex-direction: column;
  width: 240px; flex-shrink: 0;
  border-right: 1px solid var(--border);
  background: color-mix(in oklch, var(--card) 30%, var(--background));
  min-height: 0; overflow: hidden;
}
.se-head {
  padding: 10px; border-bottom: 1px solid var(--border);
  display: flex; flex-direction: column; gap: var(--space-1); flex-shrink: 0;
}
.se-search {
  display: flex; align-items: center; gap: var(--space-2);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: color-mix(in oklch, var(--background) 80%, transparent);
  padding: 6px 10px;
  transition: border-color 0.15s ease;
}
.se-search:focus-within { border-color: color-mix(in oklch, var(--primary) 50%, transparent); }
.se-search input {
  flex: 1; min-width: 0;
  background: transparent; border: none; outline: none;
  font-size: var(--text-xs); color: var(--foreground);
  font-family: inherit;
}
.se-search input::placeholder { color: var(--muted-foreground); }
.se-filters {
  display: flex; flex-wrap: wrap; gap: var(--space-1);
}
.se-pill {
  display: inline-flex; align-items: center; gap: var(--space-1);
  padding: 2px var(--space-2); border-radius: 9999px;
  border: 1px solid var(--border);
  font-size: 10px; cursor: pointer;
  color: var(--muted-foreground);
  background: transparent;
  transition: all 0.15s ease;
  font-family: inherit;
}
.se-pill:hover { border-color: color-mix(in oklch, var(--primary) 30%, var(--border)); }
.se-pill.is-active {
  border-color: color-mix(in oklch, var(--primary) 50%, transparent);
  background: color-mix(in oklch, var(--primary) 10%, transparent);
  color: var(--primary);
  font-weight: var(--font-weight-medium);
}
.se-body {
  flex: 1; overflow-y: auto; padding: 0 0 var(--space-4);
}
.se-body::-webkit-scrollbar { width: 5px; }
.se-body::-webkit-scrollbar-thumb {
  background: color-mix(in oklch, var(--border) 60%, transparent);
  border-radius: var(--radius-sm);
}
.se-section { padding: 6px 0; }
.se-section-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--space-1) 14px;
}
.se-section-label {
  display: flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight: var(--font-weight-semibold);
  text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--muted-foreground);
}
.se-section-label .count {
  font-weight: 400; text-transform: none; letter-spacing: 0;
}
.se-divider { height: 1px; background: var(--border); margin: 0 var(--space-3); }
.se-empty {
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-xs); font-style: italic;
  color: var(--muted-foreground);
}

/* --- Skill row (folder) ------------------------------------------------ */
.se-skill {
  display: flex; width: 100%; align-items: center; gap: 6px;
  padding: var(--space-1) var(--space-3); border: none; background: none;
  font-size: var(--text-xs); cursor: pointer;
  color: color-mix(in oklch, var(--foreground) 80%, transparent);
  font-family: inherit; text-align: left;
  transition: color 0.15s ease;
}
.se-skill:hover { color: var(--foreground); }
.se-skill .se-chevron {
  width: var(--space-3); height: var(--space-3); flex-shrink: 0;
  color: var(--muted-foreground);
  display: inline-flex;
  transition: transform 0.15s ease;
}
.se-skill .se-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: var(--font-weight-medium); }
.se-dots { display: inline-flex; gap: 3px; align-items: center; margin-left: auto; flex-shrink: 0; }
.se-dot { width: 6px; height: 6px; border-radius: 50%; }
.se-dot.vars { background: oklch(0.82 0.19 84); }
.se-dot.refs { background: oklch(0.72 0.19 162); }
.se-dot.evals { background: oklch(0.63 0.21 303); }

/* --- File row (leaf) --------------------------------------------------- */
.se-file {
  display: flex; width: 100%; align-items: center; gap: 6px;
  padding: var(--space-1) var(--space-3) var(--space-1) 36px; border: none; background: none;
  font-size: var(--text-xs); cursor: pointer;
  color: color-mix(in oklch, var(--foreground) 80%, transparent);
  border-left: 2px solid transparent;
  font-family: inherit; text-align: left;
  transition: all 0.15s ease;
}
.se-file:hover {
  color: var(--foreground);
  background: color-mix(in oklch, var(--muted) 30%, transparent);
}
.se-file.is-active {
  border-left-color: var(--primary);
  background: color-mix(in oklch, var(--primary) 5%, transparent);
  color: var(--primary);
}
.se-file .se-fname {
  flex: 1; min-width: 0; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}
</style>

<aside class="skills-explorer" aria-label="Skills file explorer">
  <div class="se-head">
    <div class="se-search">
      <ship-icon name="search" size="sm" tone="muted"></ship-icon>
      <input
        type="text"
        value="{{ rail.q }}"
        placeholder="Search skills..."
        spellcheck="false"
        aria-label="Search skills"
        data-on:input__debounce.250ms="@get('/api/v1/v/skills?q=' + encodeURIComponent(evt.target.value) + '&kind={{ rail.active_kind }}')"
      >
    </div>
    <div class="se-filters" role="group" aria-label="Filter by kind">
      {% for kc in rail.kind_counts %}
        <button class="se-pill{% if kc.selected %} is-active{% endif %}"
          {{ on_click("@get('/api/v1/v/skills?kind=" ~ kc.id ~ (('&q=' ~ rail.q) if rail.q else '') ~ "')") }}>
          {{ kc.label }} <span style="opacity:0.6;font-variant-numeric:tabular-nums">{{ kc.count }}</span>
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="se-body" role="tree" aria-label="Skills tree">
    {% if rail.groups|length == 0 %}
      <div class="se-empty">
        {% if rail.q %}No skills match "{{ rail.q }}".{% else %}No skills discovered.{% endif %}
      </div>
    {% else %}
      {# Groups are BTreeMap-ordered: PROJECT SKILLS before USER SKILLS #}
      {% for g in rail.groups %}
        {% if not loop.first %}
          <div class="se-divider"></div>
        {% endif %}
        <div class="se-section">
          <div class="se-section-head">
            <span class="se-section-label">
              <ship-icon name="folder" size="xs" tone="muted"></ship-icon>
              {% if g.source == 'PROJECT SKILLS' %}Project Skills{% elif g.source == 'USER SKILLS' %}Library{% else %}{{ g.source }}{% endif %}
              <span class="count">({{ g.skills|length }})</span>
            </span>
          </div>
          {% if g.skills|length == 0 %}
            <div class="se-empty">
              {% if rail.q %}No matches.{% else %}No skills yet.{% endif %}
            </div>
          {% else %}
            {% for s in g.skills %}
              {% set is_active = skill and (skill.id == s.id) %}
              {% set is_expanded = is_active %}
              <div role="treeitem">
                <button class="se-skill"
                  {{ on_click("window.ship && window.ship.navigate('/skills/" ~ s.id ~ "/SKILL.md')") }}
                  title="{{ s.description }}">
                  <span class="se-chevron" aria-hidden="true">
                    {% if is_expanded %}
                      <ship-icon name="chevron-down" size="xs"></ship-icon>
                    {% else %}
                      <ship-icon name="chevron-right" size="xs"></ship-icon>
                    {% endif %}
                  </span>
                  <ship-icon name="zap" size="xs" tone="primary"></ship-icon>
                  <span class="se-name">{{ s.name }}</span>
                  <span class="se-dots">
                    {% if s.has_vars %}<span class="se-dot vars" title="Variables"></span>{% endif %}
                    {% if s.has_refs %}<span class="se-dot refs" title="Reference docs"></span>{% endif %}
                    {% if s.has_evals %}<span class="se-dot evals" title="Evals"></span>{% endif %}
                  </span>
                  {% if g.source == 'USER SKILLS' %}
                    <span style="font-size:9px;color:oklch(0.63 0.21 303);background:oklch(0.63 0.21 303 / 0.15);padding:1px 6px;border-radius:var(--radius-sm);">library</span>
                  {% endif %}
                </button>
                {% if is_expanded and s.files|length > 0 %}
                  {% for f in s.files %}
                    {% set is_file_active = file and (file.path == f) %}
                    <button class="se-file{% if is_file_active %} is-active{% endif %}"
                      role="treeitem"
                      {{ on_click("window.ship && window.ship.navigate('/skills/" ~ s.id ~ "/" ~ f ~ "')") }}
                      title="{{ f }}">
                      {% if f == 'SKILL.md' %}
                        <ship-icon name="file" size="xs" tone="info"></ship-icon>
                      {% elif '.json' in f %}
                        <ship-icon name="file" size="xs" tone="warning"></ship-icon>
                      {% elif '.md' in f %}
                        <ship-icon name="file" size="xs" tone="success"></ship-icon>
                      {% else %}
                        <ship-icon name="file" size="xs" tone="muted"></ship-icon>
                      {% endif %}
                      <span class="se-fname">{{ f|split('/')|last }}</span>
                    </button>
                  {% endfor %}
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</aside>
