{#-
  Left rail — search, filter chips, grouped skill list.

  Context:
    rail (RailCtx)
    skill (SkillDetail, optional) — used to highlight the active row.

  Navigation is URL-driven (no client signals):
    - search input updates ?q=…&kind=… and re-requests the shell.
    - chips update ?kind=…&q=… and re-request the shell.
    - a skill row navigates to /api/runtime/view/skills/detail/<id>.
-#}
{% from '_urls.html.j2' import view_skills, view_skill_detail %}
<aside class="skills-rail" aria-label="Skills navigator">
  <div class="skills-rail-head">
    <div class="skills-rail-title">
      <ship-icon name="sparkles" size="sm" tone="accent" label=""></ship-icon>
      <h1>Skills</h1>
      <span class="skills-rail-count">{{ rail.filtered }}/{{ rail.total }}</span>
    </div>

    {#- Search. Native ship-input emits `input` on every keystroke; we
        debounce and navigate with the updated ?q value, preserving kind. -#}
    <ship-input
      size="sm"
      value="{{ rail.q }}"
      placeholder="Search skills…"
      aria-label="Search skills"
      data-on:input__debounce.250ms="@get('{{ view_skills() }}?q=' + encodeURIComponent(evt.target.value) + '&kind={{ rail.active_kind }}')"
    >
      <ship-icon slot="leading" name="search" size="sm" tone="muted"></ship-icon>
    </ship-input>

    <div class="skills-filter-row" role="group" aria-label="Filter by kind">
      {% for kc in rail.kind_counts %}
        <ship-chip size="sm"
          {% if kc.selected %}selected{% endif %}
          data-on:click="@get('{{ view_skills() }}?kind={{ kc.id }}{% if rail.q %}&q=' + encodeURIComponent('{{ rail.q }}'){% endif %}')">
          {{ kc.label }}
          <span style="opacity:0.65;margin-left:4px;font-variant-numeric:tabular-nums">{{ kc.count }}</span>
        </ship-chip>
      {% endfor %}
    </div>
  </div>

  <div class="skills-rail-body" role="listbox" aria-label="Available skills">
    {% if rail.groups|length == 0 %}
      <div class="skills-empty-hint">
        {% if rail.q %}
          No skills match <em>"{{ rail.q }}"</em>.
        {% else %}
          No skills discovered.
        {% endif %}
      </div>
    {% else %}
      {% for g in rail.groups %}
        <div class="skills-group">
          <div class="skills-group-head">
            <span class="icon">
              <ship-icon name="folder" size="sm" tone="muted"></ship-icon>
            </span>
            <span>{{ g.source }}</span>
            <span class="count">{{ g.skills|length }}</span>
          </div>

          {% for s in g.skills %}
            {% set is_active = (skill is defined) and (skill.id == s.id) %}
            <div
              role="option"
              tabindex="0"
              aria-selected="{{ 'true' if is_active else 'false' }}"
              class="skills-row kind-{{ s.kind }}{% if is_active %} is-active{% endif %}"
              title="{{ s.description }}"
              data-on:click="@get('{{ view_skill_detail(s.id) }}?q={{ rail.q }}&kind={{ rail.active_kind }}')"
              data-on:keydown="evt.key === 'Enter' || evt.key === ' ' ? (evt.preventDefault(), @get('{{ view_skill_detail(s.id) }}?q={{ rail.q }}&kind={{ rail.active_kind }}')) : null"
            >
              <span class="skills-row-glyph" aria-hidden="true">
                {% if s.kind == 'docs' %}
                  <ship-icon name="file" size="sm"></ship-icon>
                {% else %}
                  <ship-icon name="sparkles" size="sm"></ship-icon>
                {% endif %}
              </span>
              <span class="skills-row-name">{{ s.name }}</span>
              {% if s.tags|length > 0 %}
                <span class="skills-row-tags" aria-label="{{ s.tags|length }} tag{{ 's' if s.tags|length != 1 else '' }}">
                  {% for _ in s.tags[:3] %}
                    <span class="skills-row-tag-dot"></span>
                  {% endfor %}
                </span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</aside>
