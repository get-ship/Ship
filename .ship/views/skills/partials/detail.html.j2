{#-
  Detail pane — renders when the `skill` (SkillDetail) context var is set.

  Structure:
    header (icon + name)
    description (muted)
    metadata row (kind + source + author/artifact/var chips)
    tag chips
    separator
    <ship-markdown> body
-#}
<div id="skills-content">
  <article class="skills-detail">
    <header class="skill-head">
      <div class="skill-head-top">
        <div class="skill-head-icon{% if skill.kind == 'docs' %} docs{% endif %}" aria-hidden="true">
          {% if skill.kind == 'docs' %}
            <ship-icon name="file" size="lg"></ship-icon>
          {% else %}
            <ship-icon name="sparkles" size="lg"></ship-icon>
          {% endif %}
        </div>
        <div style="min-width:0;flex:1">
          <h1 class="skill-title">{{ skill.name }}</h1>
          {% if skill.description %}
            <p class="skill-desc">{{ skill.description }}</p>
          {% endif %}
        </div>
      </div>
    </header>

    <div class="skill-meta-row">
      <ship-metachip label="kind" value="{{ skill.kind }}"></ship-metachip>
      <ship-metachip label="source" value="{{ skill.source|lower }}"></ship-metachip>
      {% if skill.authors|length > 0 %}
        <ship-metachip label="authors" value="{{ skill.authors|join(', ') }}"></ship-metachip>
      {% endif %}
      {% if skill.variables|length > 0 %}
        <ship-metachip label="vars" value="{{ skill.variables|length }}"></ship-metachip>
      {% endif %}
      {% if skill.artifacts|length > 0 %}
        <ship-metachip label="artifacts" value="{{ skill.artifacts|length }}"></ship-metachip>
      {% endif %}
    </div>

    {% if skill.tags|length > 0 %}
      <div class="skill-meta-row" aria-label="Tags">
        {% for t in skill.tags %}
          <ship-chip size="sm" variant="outline">{{ t }}</ship-chip>
        {% endfor %}
      </div>
    {% endif %}

    <ship-separator></ship-separator>

    <div class="skill-body">
      {% if skill.body %}
        <ship-markdown value="{{ skill.body }}"></ship-markdown>
      {% else %}
        <ship-empty-state variant="placeholder" icon="file">
          <span slot="title">Empty skill body</span>
          This skill has frontmatter but no SKILL.md content yet.
        </ship-empty-state>
      {% endif %}
    </div>
  </article>
</div>
