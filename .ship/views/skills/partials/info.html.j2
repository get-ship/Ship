{#-
  Right info panel — 320px. Shows skill metadata, variables, and files
  list. Matches React SkillsPreviewPanel layout.

  Context:
    skill (SkillDetail) — always defined when this partial is included.
-#}
<style>
.skills-info {
  display: flex; flex-direction: column;
  width: 320px; flex-shrink: 0;
  border-left: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  background: var(--card);
  min-height: 0; overflow: hidden;
}
.si-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 16px;
  border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  flex-shrink: 0;
}
.si-skill-id {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: var(--foreground);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.si-tabs {
  display: flex; border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  flex-shrink: 0;
}
.si-tab {
  flex: 1; padding: 8px 12px;
  font-size: 12px; font-weight: 500;
  color: var(--muted-foreground);
  background: none; border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer; text-align: center;
  font-family: inherit;
  transition: all 0.15s ease;
}
.si-tab:hover { color: var(--foreground); }
.si-tab.is-active {
  color: var(--primary);
  border-bottom-color: var(--primary);
}
.si-body {
  flex: 1; overflow-y: auto;
  padding: 12px 16px;
}
.si-body::-webkit-scrollbar { width: 5px; }
.si-body::-webkit-scrollbar-thumb {
  background: color-mix(in oklch, var(--border) 50%, transparent);
  border-radius: 3px;
}
.si-section-label {
  font-size: 10px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--muted-foreground);
  margin: 12px 0 6px;
}
.si-section-label:first-child { margin-top: 0; }
.si-row {
  display: flex; justify-content: space-between;
  align-items: baseline;
  padding: 3px 0;
  font-size: 12px;
}
.si-row-key {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted-foreground);
}
.si-row-val {
  color: var(--foreground);
  text-align: right;
  max-width: 60%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.si-chip {
  display: inline-flex; align-items: center;
  padding: 2px 8px; border-radius: 4px;
  font-size: 10px;
  background: color-mix(in oklch, var(--muted) 60%, transparent);
  color: var(--foreground);
  margin: 0 4px 4px 0;
}
.si-vars-empty {
  font-size: 12px;
  color: var(--muted-foreground);
  padding: 8px 0;
}
.si-file-list {
  display: flex; flex-direction: column; gap: 2px;
}
.si-file-item {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--muted-foreground);
  padding: 2px 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
</style>

<aside class="skills-info" aria-label="Skill info panel">
  <div class="si-header">
    <span class="si-skill-id">{{ skill.id }}</span>
  </div>

  <div class="si-tabs" role="tablist">
    <button class="si-tab is-active" role="tab" aria-selected="true">Info</button>
    <button class="si-tab" role="tab" aria-selected="false">Vars</button>
    <button class="si-tab" role="tab" aria-selected="false">Used by</button>
  </div>

  <div class="si-body">
    {# Info tab — shown by default #}

    {# Metadata rows #}
    <div class="si-section-label">Metadata</div>
    <div class="si-row">
      <span class="si-row-key">kind</span>
      <span class="si-row-val">{{ skill.kind }}</span>
    </div>
    <div class="si-row">
      <span class="si-row-key">source</span>
      <span class="si-row-val">{{ skill.source }}</span>
    </div>
    {% if skill.description %}
      <div class="si-row">
        <span class="si-row-key">description</span>
        <span class="si-row-val" title="{{ skill.description }}">{{ skill.description }}</span>
      </div>
    {% endif %}
    {% if skill.authors|length > 0 %}
      <div class="si-row">
        <span class="si-row-key">authors</span>
        <span class="si-row-val">{{ skill.authors|join(', ') }}</span>
      </div>
    {% endif %}

    {# Tags #}
    {% if skill.tags|length > 0 %}
      <div class="si-section-label">Tags</div>
      <div style="display:flex;flex-wrap:wrap">
        {% for t in skill.tags %}
          <span class="si-chip">{{ t }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {# Variables summary #}
    <div class="si-section-label">Variables ({{ skill.variables|length }})</div>
    {% if skill.variables|length > 0 %}
      {% for v in skill.variables %}
        <div class="si-row">
          <span class="si-row-key">{{ v }}</span>
        </div>
      {% endfor %}
    {% else %}
      <div class="si-vars-empty">No variables defined.</div>
    {% endif %}

    {# Files list #}
    <div class="si-section-label">Files ({{ skill.files|length }})</div>
    <div class="si-file-list">
      {% for f in skill.files %}
        <span class="si-file-item">{{ f }}</span>
      {% endfor %}
    </div>
  </div>
</aside>
