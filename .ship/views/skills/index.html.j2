{#-
  Skills — polished two-pane rail + detail view.

  Context:
    rail (RailCtx) — groups, kind_counts, q, active_kind, active_tag
    skill (SkillDetail, optional) — populated when /skills/detail/<id>

  Layout:
    ┌─────────────────┬──────────────────────────────┐
    │  RAIL           │  DETAIL                      │
    │  • search       │  • header (name, desc)       │
    │  • chips        │  • frontmatter metachips     │
    │  • groups       │  • tag chips                 │
    │    ├ list-items │  • separator                 │
    │    └ ...        │  • <ship-markdown>           │
    └─────────────────┴──────────────────────────────┘

  The detail pane defaults to an empty state; `skill_detail` handler
  re-renders the whole shell with `skill` defined so this template
  swaps the right pane accordingly.
-#}
{% from '_ship.html.j2' import head, styles, search %}
{% from '_urls.html.j2' import view_skills, view_skills_rail, view_skill_detail %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Skills') }}
  {{ styles() }}
  <style>
  /* --- layout shell -------------------------------------------------- */
  .ship-view-skills {
    color: var(--foreground);
    background: var(--background);
    height: 100vh;
    overflow: hidden;
  }
  .skills-layout {
    display: grid;
    grid-template-columns: 288px 1fr;
    height: 100%;
    min-height: 0;
  }
  @media (max-width: 720px) {
    .skills-layout { grid-template-columns: 1fr; }
    .skills-rail { border-right: none; border-bottom: 1px solid var(--border); max-height: 40vh; }
  }

  /* --- rail ---------------------------------------------------------- */
  .skills-rail {
    display: flex; flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--border);
    background: color-mix(in oklch, var(--card) 60%, var(--background));
    overflow: hidden;
  }
  .skills-rail-head {
    padding: 14px 12px 10px;
    border-bottom: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 10px;
    flex-shrink: 0;
  }
  .skills-rail-title {
    display: flex; align-items: center; gap: 8px;
    padding: 0 4px 2px;
  }
  .skills-rail-title h1 {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .skills-rail-count {
    margin-left: auto;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }
  .skills-filter-row {
    display: flex; flex-wrap: wrap; gap: 4px;
  }
  .skills-rail-body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 4px 0 20px;
  }
  .skills-rail-body::-webkit-scrollbar { width: 6px; }
  .skills-rail-body::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--border) 70%, transparent);
    border-radius: 3px;
  }

  .skills-group { padding: 10px 0 4px; }
  .skills-group-head {
    display: flex; align-items: center; gap: 6px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    padding: 4px 16px 6px;
  }
  .skills-group-head .count {
    margin-left: auto;
    font-weight: 400;
    color: color-mix(in oklch, var(--muted-foreground) 70%, transparent);
    letter-spacing: 0;
    text-transform: none;
  }
  .skills-group-head .icon {
    opacity: 0.55;
    display: inline-flex;
  }

  /* Row — tight IDE-like list entry. Uses anchor semantics (data-on:click
     handles navigation). */
  .skills-row {
    position: relative;
    display: flex; align-items: center; gap: 8px;
    padding: 5px 12px 5px 20px;
    min-height: 28px;
    font-size: 12px;
    line-height: 1.3;
    color: var(--foreground);
    cursor: pointer;
    border-left: 2px solid transparent;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .skills-row:hover {
    background: color-mix(in oklch, var(--muted) 45%, transparent);
  }
  .skills-row:focus-visible {
    outline: none;
    background: color-mix(in oklch, var(--muted) 55%, transparent);
    box-shadow: inset 2px 0 0 var(--primary);
  }
  .skills-row.is-active {
    background: color-mix(in oklch, var(--primary) 10%, transparent);
    border-left-color: var(--primary);
    color: var(--foreground);
  }
  .skills-row.is-active .skills-row-name { font-weight: 600; }

  .skills-row-glyph {
    display: inline-flex;
    width: 14px; height: 14px;
    align-items: center; justify-content: center;
    flex-shrink: 0;
    color: var(--muted-foreground);
  }
  .skills-row.kind-smart .skills-row-glyph { color: var(--primary); }
  .skills-row.kind-docs .skills-row-glyph { color: color-mix(in oklch, var(--muted-foreground) 85%, var(--foreground)); }
  .skills-row-glyph svg { width: 12px; height: 12px; }

  .skills-row-name {
    flex: 1; min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }
  .skills-row-tags {
    display: inline-flex; gap: 3px; flex-shrink: 0;
    align-items: center;
  }
  .skills-row-tag-dot {
    width: 4px; height: 4px; border-radius: 50%;
    background: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
  }

  .skills-empty-hint {
    padding: 28px 16px;
    text-align: center;
    font-size: 12px;
    color: var(--muted-foreground);
    font-style: italic;
  }

  /* --- detail pane --------------------------------------------------- */
  .skills-detail-wrap {
    min-height: 0;
    display: flex; flex-direction: column;
    overflow: hidden;
    background: var(--background);
  }
  .skills-detail-wrap > * { min-height: 0; }

  #skills-content {
    flex: 1;
    overflow-y: auto;
    display: flex; flex-direction: column;
  }

  .skills-detail {
    padding: 36px 48px 56px;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    display: flex; flex-direction: column; gap: 20px;
  }
  .skills-detail.empty {
    padding: 0;
    max-width: none;
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  .skill-head { display: flex; flex-direction: column; gap: 10px; }
  .skill-head-top { display: flex; align-items: flex-start; gap: 12px; }
  .skill-head-icon {
    width: 40px; height: 40px;
    border-radius: var(--radius-lg);
    display: inline-flex; align-items: center; justify-content: center;
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    color: var(--primary);
    flex-shrink: 0;
  }
  .skill-head-icon.docs {
    background: color-mix(in oklch, var(--muted) 75%, transparent);
    color: var(--muted-foreground);
  }
  .skill-head-icon svg { width: 20px; height: 20px; }

  .skill-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.15;
  }
  .skill-desc {
    font-size: 14px;
    color: var(--muted-foreground);
    margin: 0;
    line-height: 1.55;
    max-width: 68ch;
  }
  .skill-meta-row {
    display: flex; flex-wrap: wrap; gap: 6px;
    align-items: center;
  }
  .skill-body {
    padding-top: 6px;
  }
  .skill-body ship-markdown {
    font-size: 14px;
    line-height: 1.65;
  }
  </style>
</head>
<body>
<div id="skills-root" class="ship-view ship-view-skills">
  <div class="skills-layout">
    {% include 'skills/partials/rail.html.j2' %}

    <section class="skills-detail-wrap" aria-label="Skill detail">
      {% if skill is defined %}
        {% include 'skills/partials/detail.html.j2' %}
      {% else %}
        <div id="skills-content">
          {% include 'skills/partials/content.html.j2' %}
        </div>
      {% endif %}
    </section>
  </div>
</div>
</body>
</html>
