{#-
  Skills index — two-pane layout (rail + detail) with SSE live updates.
  Context: rail (RailCtx), optionally skill (SkillDetail).
-#}
{% from '_ship.html.j2' import head, signal, live, attr, styles, on %}
{% from '_urls.html.j2' import view_skills_rail, view_skill_detail %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Skills') }}
  <style>
  .skills-layout { display: grid; grid-template-columns: 260px 1fr; height: 100%; min-height: 500px; }
  .skills-left { border-right: 1px solid var(--border); display: flex; flex-direction: column; background: var(--card); overflow: hidden; }
  .skills-left > :nth-child(2) { overflow: auto; flex: 1 1 auto; }
  .skills-detail { padding: var(--space-5) var(--space-6); overflow: auto; display: flex; flex-direction: column; gap: var(--space-4); }
  .skills-detail.empty { align-items: center; justify-content: center; }
  .skills-rail-head { padding: var(--space-3); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: var(--space-2); }
  .skills-group-head { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); padding: var(--space-2) var(--space-3); }
  .skills-row { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); font-size: var(--text-sm); cursor: pointer; }
  .skills-row:hover { background: var(--muted); }
  .skills-row[aria-selected="true"] { background: color-mix(in oklch, var(--primary) 12%, transparent); }
  </style>
</head>
<body>
<div id="skills-root" class="ship-view"
     {{ signal('activeSkill', active_skill_id | default('')) }}>
  <div class="skills-layout">
    <aside class="skills-left">
      <div class="skills-rail-head">
        <ship-input
          size="sm"
          placeholder="Search skills..."
          value="{{ rail.q }}"
          {{ on('input__debounce.250ms', "@get('" ~ view_skills_rail() ~ "?q=' + encodeURIComponent(evt.target.value) + '&kind=" ~ rail.active_kind ~ "')") }}></ship-input>
        <ship-toolbar role="group" aria-label="Filter by kind">
          {% for kc in rail.kind_counts %}
            <ship-chip size="sm" {% if kc.selected %}selected{% endif %}
              {{ on('click', "@get('" ~ view_skills_rail() ~ "?kind=" ~ kc.id ~ ("&q=" ~ rail.q if rail.q else "") ~ "')") }}>{{ kc.label }} &middot; {{ kc.count }}</ship-chip>
          {% endfor %}
        </ship-toolbar>
      </div>
      <div id="skills-rail">
        {% if rail.groups|length == 0 %}
          <ship-empty-state><span slot="title">No skills match.</span></ship-empty-state>
        {% else %}
          {% for g in rail.groups %}
            <div class="skills-group">
              <div class="skills-group-head">{{ g.source }}</div>
              {% for s in g.skills %}
                <div class="skills-row"
                     {{ attr('aria-selected', "$activeSkill == '" ~ s.id ~ "'") }}
                     {{ on('click', "$activeSkill = '" ~ s.id ~ "'; @get('/api/runtime/view/skills/sse')") }}>
                  <span class="skills-name">{{ s.name }}</span>
                  <ship-status-dot tone="{% if s.kind == 'docs' %}muted{% else %}success{% endif %}" size="sm"></ship-status-dot>
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </aside>

    <div {{ live('skills') }}>
      <div id="skills-content">
        <main class="skills-detail empty">
          <ship-empty-state
            icon="sparkles"
            title="No skill open"
            body="Select a skill from the rail to start reading."></ship-empty-state>
        </main>
      </div>
    </div>
  </div>
</div>
</body>
</html>
