<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Code Editor Test</title>
  <link rel="stylesheet" href="/api/runtime/assets/view-tokens.css">
  <script type="module" src="/api/runtime/assets/datastar.js"></script>
  <script type="module" src="/api/runtime/assets/ship-elements.js"></script>
  <script type="module" src="/api/runtime/assets/ship-code-editor.js"></script>
  <style>
    body {
      margin: 0;
      padding: 24px;
      background: var(--background);
      color: var(--foreground);
      font-family: var(--font-body);
      font-size: var(--text-base);
    }
    h1 {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      margin: 0 0 8px;
    }
    .subtitle {
      color: var(--muted-foreground);
      margin: 0 0 32px;
      font-size: var(--text-md);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    @media (max-width: 768px) {
      .grid { grid-template-columns: 1fr; }
    }
    .panel {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .panel-label {
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--muted-foreground);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .output-panel {
      background: var(--muted);
      border-radius: var(--radius-md);
      padding: 12px;
      font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
      font-size: var(--text-sm);
      white-space: pre-wrap;
      word-break: break-all;
      min-height: 80px;
      max-height: 300px;
      overflow-y: auto;
      border: 1px solid var(--border);
    }
    section {
      margin-bottom: 40px;
    }
    section > h2 {
      font-size: var(--text-lg);
      font-weight: 600;
      margin: 0 0 16px;
    }
  </style>
</head>
<body>
  <h1>Code Editor Component</h1>
  <p class="subtitle">ship-code-editor &mdash; CodeMirror 6 island with syntax highlighting</p>

  <!-- YAML Editor -->
  <section data-signals="{yamlValue: 'name: my-pipeline\nsteps:\n  - name: build\n    run: cargo build\n  - name: test\n    run: cargo test'}">
    <h2>YAML</h2>
    <div class="grid">
      <div class="panel">
        <span class="panel-label">Editor</span>
        <ship-code-editor
          language="yaml"
          data-bind-value="yamlValue"
          placeholder="Enter YAML..."
        ></ship-code-editor>
      </div>
      <div class="panel">
        <span class="panel-label">Raw Value</span>
        <div class="output-panel" data-text="yamlValue"></div>
      </div>
    </div>
  </section>

  <!-- JSON Editor -->
  <section data-signals='{jsonValue: "{\n  \"name\": \"ship\",\n  \"version\": \"0.1.0\",\n  \"features\": [\"pipelines\", \"agents\", \"canvas\"]\n}"}'>
    <h2>JSON</h2>
    <div class="grid">
      <div class="panel">
        <span class="panel-label">Editor</span>
        <ship-code-editor
          language="json"
          data-bind-value="jsonValue"
          placeholder="Enter JSON..."
        ></ship-code-editor>
      </div>
      <div class="panel">
        <span class="panel-label">Raw Value</span>
        <div class="output-panel" data-text="jsonValue"></div>
      </div>
    </div>
  </section>

  <!-- JavaScript Editor -->
  <section data-signals="{jsValue: 'function greet(name) {\n  // Say hello\n  const message = `Hello, ${name}!`;\n  console.log(message);\n  return message;\n}'}">
    <h2>JavaScript</h2>
    <div class="grid">
      <div class="panel">
        <span class="panel-label">Editor</span>
        <ship-code-editor
          language="javascript"
          data-bind-value="jsValue"
          placeholder="Enter JavaScript..."
        ></ship-code-editor>
      </div>
      <div class="panel">
        <span class="panel-label">Raw Value</span>
        <div class="output-panel" data-text="jsValue"></div>
      </div>
    </div>
  </section>

  <!-- Readonly Example -->
  <section>
    <h2>Readonly (Rust)</h2>
    <div class="panel">
      <span class="panel-label">Read-only editor</span>
      <ship-code-editor
        language="rust"
        readonly
        value="fn main() {
    let msg = &quot;Ship is running&quot;;
    println!(&quot;{}&quot;, msg);
}"
      ></ship-code-editor>
    </div>
  </section>

  <!-- Size Variants -->
  <section>
    <h2>Size Variants</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div class="panel">
        <span class="panel-label">Small</span>
        <ship-code-editor
          language="yaml"
          size="sm"
          value="size: sm"
        ></ship-code-editor>
      </div>
      <div class="panel">
        <span class="panel-label">Medium (default)</span>
        <ship-code-editor
          language="yaml"
          size="md"
          value="size: md"
        ></ship-code-editor>
      </div>
      <div class="panel">
        <span class="panel-label">Large</span>
        <ship-code-editor
          language="yaml"
          size="lg"
          value="size: lg"
        ></ship-code-editor>
      </div>
    </div>
  </section>
</body>
</html>
