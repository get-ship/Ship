{#-
  Canvas doc — demo of <ship-terminal> in read-only log viewer mode.

  Loads the terminal bundle lazily from /vendor/ship-terminal.js (served
  by the shell dev server at :3100 from apps/shell/public/vendor/).

  Demonstrates:
  - Read-only log viewer with ANSI-colored output
  - Button-driven writes to show streaming behavior
  - Ctrl+F search within terminal output
-#}

<style>
  .term-demo-wrap { max-width: 78rem; margin: 0 auto; padding: var(--space-6) var(--space-5); }
  .term-title { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--font-weight-bold); margin: 0 0 var(--space-2); letter-spacing: -0.015em; }
  .term-sub { color: var(--muted-foreground); font-size: var(--text-sm); margin: 0 0 var(--space-6); max-width: 52rem; }
  .term-grid { display: flex; flex-direction: column; gap: var(--space-4); }
  .term-legend { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: 0 0 var(--space-2); display: flex; align-items: center; gap: 8px; }
  .term-legend .pill { font-size: 10px; padding: 1px 6px; border-radius: 999px; background: color-mix(in oklch, var(--primary) 14%, var(--muted)); color: var(--foreground); text-transform: none; letter-spacing: 0; font-weight: 500; }
  .term-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-3); }
  .term-actions button {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .term-actions button:hover { background: var(--muted); }
  @media (max-width: 640px) { .term-actions { flex-direction: column; } }
</style>

<script type="module" src="/vendor/ship-terminal.js"></script>

<div class="ship-view">
  <div class="term-demo-wrap">
    <h1 class="term-title">Terminal demo</h1>
    <p class="term-sub">
      Read-only log viewer using <code>&lt;ship-terminal&gt;</code>. Click the
      buttons to write sample output. Use <kbd>Ctrl+F</kbd> to search within
      the terminal content.
    </p>

    <div class="term-grid">
      <div>
        <p class="term-legend">Log output <span class="pill">readonly</span></p>
        <ship-terminal
          id="demo-term"
          readonly
          rows="20"
          fit
          style="height: 420px;"
        ></ship-terminal>
      </div>

      <div class="term-actions">
        <button onclick="writeBuildOutput()">Run build</button>
        <button onclick="writeAnsiDemo()">ANSI colors</button>
        <button onclick="writeProgressBar()">Progress bar</button>
        <button onclick="document.getElementById('demo-term').clear()">Clear</button>
      </div>
    </div>
  </div>
</div>

<script type="module">
  const term = document.getElementById('demo-term');

  // Wait for terminal to be ready
  term.addEventListener('ship-ready', () => {
    term.writeln('\x1b[2m--- ship terminal ready ---\x1b[0m');
    term.writeln('');
  });

  // Make functions available globally for onclick handlers
  window.writeBuildOutput = function() {
    term.writeln('\x1b[1;36m$\x1b[0m ship build');
    term.writeln('\x1b[2m[1/4]\x1b[0m Resolving dependencies...');
    term.writeln('\x1b[2m[2/4]\x1b[0m Compiling workspace...');
    term.writeln('\x1b[2m[3/4]\x1b[0m Running tests...');
    term.writeln('  \x1b[32m\u2713\x1b[0m ship-terminal.test.ts (8 tests)');
    term.writeln('  \x1b[32m\u2713\x1b[0m ship-button.test.ts (12 tests)');
    term.writeln('  \x1b[32m\u2713\x1b[0m ship-card.test.ts (6 tests)');
    term.writeln('\x1b[2m[4/4]\x1b[0m Bundling assets...');
    term.writeln('');
    term.writeln('\x1b[32m\u2713 Done\x1b[0m in 2.4s');
    term.writeln('  \x1b[2mship-elements.js\x1b[0m  142kb');
    term.writeln('  \x1b[2mship-terminal.js\x1b[0m   68kb');
    term.writeln('');
  };

  window.writeAnsiDemo = function() {
    term.writeln('\x1b[1mANSI color demo:\x1b[0m');
    term.writeln('  \x1b[30mblack\x1b[0m  \x1b[31mred\x1b[0m  \x1b[32mgreen\x1b[0m  \x1b[33myellow\x1b[0m  \x1b[34mblue\x1b[0m  \x1b[35mmagenta\x1b[0m  \x1b[36mcyan\x1b[0m  \x1b[37mwhite\x1b[0m');
    term.writeln('  \x1b[1;31mbold red\x1b[0m  \x1b[4;32munderline green\x1b[0m  \x1b[7;34mreverse blue\x1b[0m');
    term.writeln('  \x1b[41m bg red \x1b[0m  \x1b[42m bg green \x1b[0m  \x1b[44m bg blue \x1b[0m  \x1b[45m bg magenta \x1b[0m');
    term.writeln('');
  };

  window.writeProgressBar = function() {
    let i = 0;
    const total = 30;
    const interval = setInterval(() => {
      i++;
      const filled = '\u2588'.repeat(i);
      const empty = '\u2591'.repeat(total - i);
      const pct = Math.round((i / total) * 100);
      term.write(`\r  \x1b[36m${filled}${empty}\x1b[0m ${pct}%`);
      if (i >= total) {
        clearInterval(interval);
        term.writeln(' \x1b[32mcomplete\x1b[0m');
      }
    }, 60);
  };
</script>
