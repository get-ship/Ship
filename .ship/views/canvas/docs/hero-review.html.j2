{#- Canvas doc — design review with structured feedback (fragment). -#}
{% from '_ship.html.j2' import signal, bind, feedback %}

<style>
  .canvas-wrap { max-width: 64rem; margin: 0 auto; padding: var(--space-6) var(--space-5); }
  .canvas-title { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--font-weight-bold); margin: 0 0 var(--space-2); letter-spacing: -0.015em; }
  .canvas-sub { color: var(--muted-foreground); font-size: var(--text-sm); margin: 0 0 var(--space-6); }
  .options { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .hero {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    min-height: 220px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .hero.bold { background: linear-gradient(135deg, color-mix(in oklch, var(--accent) 18%, var(--card)), var(--card)); }
  .hero-eyebrow { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin-bottom: var(--space-2); }
  .hero-title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--font-weight-semibold); margin: 0 0 var(--space-2); letter-spacing: -0.01em; }
  .hero.bold .hero-title { font-size: var(--text-2xl); font-weight: var(--font-weight-bold); }
  .hero-body { color: var(--muted-foreground); font-size: var(--text-sm); line-height: 1.5; }
  .rating-row { display: flex; gap: var(--space-2); align-items: center; margin-top: var(--space-4); }
  .rating-label { font-size: var(--text-xs); color: var(--muted-foreground); min-width: 60px; }
  .actions { margin-top: var(--space-6); display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-4); background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .actions ship-textarea { flex: 1; }
</style>

<div class="ship-view" {{ signal('comment', '') }}>
  <div class="canvas-wrap">

    <h1 class="canvas-title">Hero section — two directions</h1>
    <p class="canvas-sub">Rate each option 1–5 and leave a note. Your feedback streams back to the agent in real time.</p>

    <div class="options">

      {# -- Option A: restrained -- #}
      <div class="hero">
        <div class="hero-eyebrow">Option A — Restrained</div>
        <h2 class="hero-title">Ship your extension in five minutes.</h2>
        <p class="hero-body">Write one file. No build step. See it live.</p>
        <div class="rating-row">
          <span class="rating-label">Rate A:</span>
          {% for n in [1, 2, 3, 4, 5] %}
          <ship-button size="sm" variant="outline"
            {{ feedback("{option: 'A', rating: " ~ n ~ "}") }}>{{ n }}</ship-button>
          {% endfor %}
        </div>
      </div>

      {# -- Option B: bold -- #}
      <div class="hero bold">
        <div class="hero-eyebrow">Option B — Bold</div>
        <h2 class="hero-title">The fastest way from idea to running app.</h2>
        <p class="hero-body">Server-rendered, reactive, zero framework. Drop a file, refresh, done.</p>
        <div class="rating-row">
          <span class="rating-label">Rate B:</span>
          {% for n in [1, 2, 3, 4, 5] %}
          <ship-button size="sm" variant="outline"
            {{ feedback("{option: 'B', rating: " ~ n ~ "}") }}>{{ n }}</ship-button>
          {% endfor %}
        </div>
      </div>

    </div>

    <div class="actions">
      <ship-textarea {{ bind('comment') }} rows="2"
        placeholder="Anything specific? Copy direction, tone, pacing..."></ship-textarea>
      <ship-button tone="accent" variant="solid"
        {{ feedback("{kind: 'comment', text: $comment}") }}>
        Send note
      </ship-button>
    </div>

  </div>
</div>
