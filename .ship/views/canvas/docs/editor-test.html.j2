{#-
  Canvas doc — demo of <ship-markdown-editor> with Datastar two-way binding
  plus the selection bubble → ship-feedback pipeline.

  Loads the editor bundle lazily from /vendor/ship-markdown-editor.js (served
  by the shell dev server at :3100 from apps/shell/public/vendor/).

  The initial markdown is attached as a JSON-escaped single-line expression
  inside data-signals (Datastar compiles signal defaults as JS, so a raw
  newline would crash the parser). The editor fires an `input` event on
  mount so the data-bind signal picks up the starting value automatically.
-#}

<style>
  .mde-demo-wrap { max-width: 78rem; margin: 0 auto; padding: var(--space-6) var(--space-5); }
  .mde-title { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--font-weight-bold); margin: 0 0 var(--space-2); letter-spacing: -0.015em; }
  .mde-sub { color: var(--muted-foreground); font-size: var(--text-sm); margin: 0 0 var(--space-6); max-width: 52rem; }
  .mde-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-4); }
  .mde-side { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .mde-legend { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: 0 0 var(--space-2); display: flex; align-items: center; gap: 8px; }
  .mde-legend .pill { font-size: 10px; padding: 1px 6px; border-radius: 999px; background: color-mix(in oklch, var(--primary) 14%, var(--muted)); color: var(--foreground); text-transform: none; letter-spacing: 0; font-weight: 500; }
  .mde-pane {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.55;
    white-space: pre-wrap;
    overflow: auto;
    max-height: 280px;
    min-height: 120px;
    color: var(--foreground);
  }
  .mde-pane.preview { max-height: 520px; min-height: 200px; }
  .mde-pane.empty { color: var(--muted-foreground); font-style: italic; }
  @media (max-width: 980px) { .mde-grid { grid-template-columns: 1fr; } }
</style>

<script type="module" src="/vendor/ship-markdown-editor.js"></script>

{%- set default_md = '# Canvas — Editor test\n\nThis is a **rich-text** editor bound to a Datastar signal.\n\nTry:\n\n- Select any phrase. A floating toolbar appears above it.\n- Click **B** to bold, or the speech-bubble icon to leave a comment.\n- Click the sparkle icon to emit a Generate request.\n\nThe comment/generate actions post to `/api/runtime/feedback`, the same pipeline canvas buttons use. The agent receives the payload on its next turn.\n\n```js\nconsole.log("code blocks too")\n```\n' -%}

<div class="ship-view" data-signals="{content: '', lastFeedback: ''}">
  <div class="mde-demo-wrap">
    <h1 class="mde-title">Markdown editor demo</h1>
    <p class="mde-sub">
      Two-way bound to <code>$content</code> via <code>data-bind</code>. The selection bubble
      exposes <strong>Comment</strong> and <strong>Generate</strong> actions — both route through
      <code>ship-feedback</code> into the agent's feedback inbox.
    </p>

    <div class="mde-grid">
      <div>
        <p class="mde-legend">Editor <span class="pill">bubble on select</span></p>
        <ship-markdown-editor
          value="{{ default_md | e }}"
          label="Canvas draft"
          placeholder="Write freely. Select text to reveal the floating toolbar."
          rows="16"
          allow-comment
          allow-generate
          data-on:input="$content = evt.target.value"
          data-on:ship-feedback="$lastFeedback = JSON.stringify(evt.detail, null, 2); @post('/api/runtime/feedback', {payload: {id: '', kind: 'action', target: {file_path: location.pathname}, author_kind: 'human', created_at: new Date().toISOString(), payload: evt.detail}})"
        ></ship-markdown-editor>
      </div>
      <div class="mde-side">
        <div>
          <p class="mde-legend">Markdown (live)</p>
          <pre class="mde-pane preview" data-text="$content"></pre>
        </div>
        <div>
          <p class="mde-legend">Latest feedback <span class="pill">ship-feedback</span></p>
          <pre class="mde-pane" data-class:empty="!$lastFeedback" data-text="$lastFeedback || 'No feedback yet. Select text and click the speech bubble or sparkle.'"></pre>
        </div>
      </div>
    </div>
  </div>
</div>
