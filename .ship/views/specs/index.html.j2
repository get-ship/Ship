{#-
  Specs view — two-pane layout: left rail (grouped by status) + right detail.
  Data pulled inline via `ship.specs.*`. Selection is carried by `?id=`
  query — the template branches on `ship.query.id`.
-#}
{% from '_ship.html.j2' import head, signal, bind, on, on_click %}

{% set q = ship.query.q | default('') %}
{% set selected_id = ship.query.id | default('') %}
{% set rail = ship.specs.summaries(q=q, selected=selected_id) %}
{% set selected = none %}
{% if selected_id %}
  {% set selected = ship.specs.detail(id=selected_id) %}
{% endif %}

{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Specs') }}</head>
<body>
{% endif %}
<div class="ship-view ship-view-specs">
  <style>
  .ship-view-specs { padding: 0; color: var(--foreground); }
  .specs-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    min-height: calc(100vh - 48px);
  }
  .specs-rail {
    border-right: 1px solid var(--border);
    background: var(--background);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .specs-rail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-3) var(--space-2);
  }
  .specs-rail-head h1 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .specs-rail-filter { padding: 0 var(--space-3) var(--space-2); }
  .specs-rail-group { padding: var(--space-2) var(--space-2) var(--space-1); }
  .specs-rail-group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-2) var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }
  .specs-rail-group-head .count { opacity: 0.6; }
  .specs-rail-items { display: flex; flex-direction: column; gap: 2px; }
  .spec-row-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .spec-row-name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .spec-row-when { font-size: var(--text-xs); color: var(--muted-foreground); }
  .spec-row-pipeline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    margin-left: auto;
    flex-shrink: 0;
  }
  .specs-detail {
    overflow-y: auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .specs-detail-inner {
    max-width: 48rem;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-6) var(--space-6) 0;
    flex: 1;
  }
  .specs-detail-head { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-5); }
  .specs-detail-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .specs-detail-title-row h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0;
    color: var(--foreground);
  }
  .specs-detail-title-row h1 ship-code { font-size: var(--text-lg); }
  .specs-detail-actions { display: flex; gap: var(--space-1); flex-shrink: 0; }
  .specs-metachips {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .specs-prose h2 {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    margin: var(--space-6) 0 var(--space-2);
  }
  .specs-prose :first-child h2,
  .specs-prose > h2:first-child { margin-top: 0; }
  .specs-acceptance {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .specs-acceptance li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  .specs-acceptance li.done .acc-text {
    text-decoration: line-through;
    color: var(--muted-foreground);
  }
  .specs-launch-bar {
    position: sticky;
    bottom: 0;
    background: color-mix(in oklch, var(--background) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(var(--space-2));
    border-top: 1px solid var(--border);
    padding: var(--space-3) var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    justify-content: center;
  }
  .specs-launch-bar-inner {
    max-width: 48rem;
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .specs-launch-hint {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    flex: 1;
  }
  .specs-launch-hint ship-code { font-size: var(--text-xs); }
  .specs-empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12);
  }
  </style>
  <div class="specs-grid"
       {{ signal('q', q) }}
       {{ signal('confirmDelete', false) }}>

    <aside class="specs-rail" aria-label="Spec list">
      <div class="specs-rail-head">
        <h1>Specs</h1>
        <ship-button variant="solid" tone="accent" size="sm"
                     {{ on_click("@post('/api/specs', {contentType: 'json', body: JSON.stringify({title: 'New spec', body: '## Goal\n\n## Acceptance\n- [ ] '})})") }}>
          + New
        </ship-button>
      </div>
      <div class="specs-rail-filter">
        <ship-input size="sm" placeholder="Filter..." value="{{ q }}"
                    {{ bind('q') }}
                    {{ on('input.debounce.200ms', "@get('/api/v/specs?q=' + encodeURIComponent($q)" ~ ((" + '&id=" ~ selected_id ~ "'") if selected_id else '') ~ ")") }}></ship-input>
      </div>
      <div id="specs-rail-list">
        {% include 'specs/partials/rail.html.j2' %}
      </div>
    </aside>

    <main class="specs-detail" aria-label="Spec detail">
      {% include 'specs/partials/content.html.j2' %}
    </main>
  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
