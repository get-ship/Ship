{#- SDK gaps:
    - no panel/layout macro for two-pane rail+detail layout
    - no confirmation dialog macro for destructive actions
    - no navigation macro for linking between views
    - no search/filter input macro with debounce
-#}
{#-
  Specs view — two-pane layout: left rail (grouped by status) + right detail.
  Daemon passes: selected_id, q, counts, groups, total, selected, pipelines.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal, on, bind %}
{% from '_urls.html.j2' import create_spec, view_specs, view_specs_sse %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Specs') }}
  <style>
  .specs-grid { display: grid; grid-template-columns: 280px 1fr; min-height: calc(100vh - 48px); }
  .specs-rail { border-right: 1px solid var(--border); overflow-y: auto; display: flex; flex-direction: column; }
  .specs-rail-filter { padding: 0 var(--space-3) var(--space-3); }
  .specs-rail-group-head { display: flex; justify-content: space-between; padding: var(--space-2); font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); }
  .specs-detail { overflow-y: auto; display: flex; flex-direction: column; }
  .specs-detail-inner { max-width: 48rem; width: 100%; margin: 0 auto; padding: var(--space-5); flex: 1; }
  .specs-detail-title-row h1 { font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--font-weight-semibold); }
  .specs-metachips { display: flex; flex-wrap: wrap; padding: var(--space-2) 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .specs-prose h2 { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: var(--space-5) 0 var(--space-3); }
  .specs-acceptance { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
  .specs-acceptance li { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--text-sm); }
  .specs-acceptance li.done .acc-text { text-decoration: line-through; color: var(--muted-foreground); }
  .specs-launch-bar { position: sticky; bottom: 0; backdrop-filter: blur(8px); border-top: 1px solid var(--border); padding: var(--space-3) var(--space-5); }
  .specs-launch-bar-inner { max-width: 48rem; margin: 0 auto; display: flex; align-items: center; gap: var(--space-4); }
  .specs-launch-hint { font-size: var(--text-xs); color: var(--muted-foreground); flex: 1; }
  </style>
</head>
<body>
<div id="specs-root" class="ship-view">
  <div class="specs-grid"
       {{ signal('q', q) }}
       {{ signal('confirmDelete', false) }}>

    <aside class="specs-rail" aria-label="Spec list">
      <ship-toolbar class="specs-rail-head">
        <h1>Specs</h1>
        <ship-button variant="solid" tone="accent" size="sm"
                     {{ on('click', "@post('" ~ create_spec() ~ "', {contentType: 'json', body: JSON.stringify({title: 'New spec', body: '## Goal\\n\\n## Acceptance\\n- [ ] '})})") }}>
          + New
        </ship-button>
      </ship-toolbar>
      <div class="specs-rail-filter">
        <ship-input size="sm" placeholder="Filter..." value="{{ q }}"
                    {{ bind('q') }}
                    {{ on('input.debounce.200ms', "@get('" ~ view_specs() ~ "?q=' + encodeURIComponent($q)" ~ ("+ '&selected=" ~ selected_id ~ "'" if selected_id else "") ~ ")") }}></ship-input>
      </div>
      <div id="specs-rail-list"
           data-init="@get('{{ view_specs_sse() }}?q={{ q }}{% if selected_id %}&selected={{ selected_id }}{% endif %}', {requestCancellation: 'disabled'})">
        {% include 'specs/partials/rail.html.j2' %}
      </div>
    </aside>

    <main class="specs-detail" aria-label="Spec detail">
      <div id="specs-content"
           data-init="@get('/api/runtime/view/specs/sse{% if selected_id %}?selected={{ selected_id }}{% endif %}')">
        {% include 'specs/content.html.j2' %}
      </div>
    </main>
  </div>
</div>
</body>
</html>
