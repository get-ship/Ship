{#- SDK gaps:
    - no panel/layout macro for two-pane rail+detail layout
    - no confirmation dialog macro for destructive actions
    - no navigation macro for linking between views
    - no search/filter input macro with debounce
-#}
{#-
  Specs view — two-pane layout: left rail (grouped by status) + right detail.
  Daemon passes: selected_id, q, counts, groups, total, selected, pipelines.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal %}
{% from '_urls.html.j2' import create_spec, view_specs, view_specs_sse %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Specs') }}</head>
<body>
{% endif %}
<div id="ship-view-root" class="ship-view ship-view-specs">
  <style>
  .ship-view-specs { padding: 0; color: var(--foreground); }
  .specs-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    min-height: calc(100vh - 48px);
  }
  .specs-rail {
    border-right: 1px solid var(--border);
    background: var(--background);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .specs-rail-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 14px 8px;
  }
  .specs-rail-head h1 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .specs-rail-filter { padding: 0 14px 10px; }
  .specs-rail-group { padding: 10px 8px 4px; }
  .specs-rail-group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px 6px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }
  .specs-rail-group-head .count { opacity: 0.6; }
  .specs-rail-items { display: flex; flex-direction: column; gap: 2px; }
  .spec-row-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .spec-row-name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .spec-row-when { font-size: 10px; color: var(--muted-foreground); }
  .spec-row-pipeline {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted-foreground);
    margin-left: auto;
    flex-shrink: 0;
  }
  .specs-detail {
    overflow-y: auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .specs-detail-inner {
    max-width: 48rem;
    width: 100%;
    margin: 0 auto;
    padding: 24px 24px 0;
    flex: 1;
  }
  .specs-detail-head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
  .specs-detail-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  .specs-detail-title-row h1 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0;
    color: var(--foreground);
  }
  .specs-detail-title-row h1 ship-code { font-size: 18px; }
  .specs-detail-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .specs-metachips {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    padding: 8px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .specs-prose h2 {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    margin: 24px 0 10px;
  }
  .specs-prose :first-child h2,
  .specs-prose > h2:first-child { margin-top: 0; }
  .specs-acceptance {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .specs-acceptance li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--foreground);
  }
  .specs-acceptance li.done .acc-text {
    text-decoration: line-through;
    color: var(--muted-foreground);
  }
  .specs-launch-bar {
    position: sticky;
    bottom: 0;
    background: color-mix(in oklch, var(--background) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-top: 1px solid var(--border);
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 14px;
    justify-content: center;
  }
  .specs-launch-bar-inner {
    max-width: 48rem;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .specs-launch-hint {
    font-size: 11px;
    color: var(--muted-foreground);
    flex: 1;
  }
  .specs-launch-hint ship-code { font-size: 10px; }
  .specs-empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px;
  }
  </style>
  <div class="specs-grid"
       {{ signal('q', q) }}
       {{ signal('confirmDelete', false) }}>

    <aside class="specs-rail" aria-label="Spec list">
      <div class="specs-rail-head">
        <h1>Specs</h1>
        <ship-button variant="solid" tone="accent" size="sm"
                     data-on:click="@post('{{ create_spec() }}', {contentType: 'json', body: JSON.stringify({title: 'New spec', body: '## Goal\n\n## Acceptance\n- [ ] '})})">
          + New
        </ship-button>
      </div>
      <div class="specs-rail-filter">
        <ship-input size="sm" placeholder="Filter..." value="{{ q }}"
                    data-bind="q"
                    data-on:input.debounce.200ms="@get('{{ view_specs() }}?q=' + encodeURIComponent($q){% if selected_id %} + '&selected={{ selected_id }}'{% endif %})"></ship-input>
      </div>
      <div id="specs-rail-list"
           data-init="@get('{{ view_specs_sse() }}?q={{ q }}{% if selected_id %}&selected={{ selected_id }}{% endif %}', {requestCancellation: 'disabled'})">
        {% include 'specs/partials/rail.html.j2' %}
      </div>
    </aside>

    <main class="specs-detail" aria-label="Spec detail">
      <div id="specs-content"
           data-init="@get('/api/runtime/view/specs/sse{% if selected_id %}?selected={{ selected_id }}{% endif %}')">
        {% include 'specs/content.html.j2' %}
      </div>
    </main>
  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
