{# Demo view exercising the .ship SFC pipeline end-to-end. #}
{# Mounts two <app-typeahead> instances on the same page to prove #}
{# per-instance signal scoping. The global li.active rule below #}
{# proves component style scoping wins inside the component. #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ship — Typeahead demo</title>
  <link rel="stylesheet" href="/api/assets/view-tokens.css" />
  <script type="module" src="/api/assets/datastar.js"></script>
  <script type="module" src="/_ship/components/app-typeahead.js"></script>
  <style>
    /* Page-level style. Confirms scoping: this should NOT change the */
    /* color of `li.active` inside <app-typeahead>, because the */
    /* component's own style block prefixes its rules with the */
    /* [data-component="app-typeahead"] selector. */
    li.active { color: red; }
    body { font-family: system-ui, sans-serif; padding: 24px; max-width: 720px; }
    .pair { display: grid; gap: 32px; margin-top: 24px; }
    h1 { letter-spacing: -0.01em; }
    .selected { font-family: ui-monospace, monospace; color: var(--ship-color-fg-muted, #888); }
  </style>
</head>
<body>
  <main>
    <h1>Typeahead — SFC demo</h1>
    <p>
      Two independent <code>&lt;app-typeahead&gt;</code> instances. Each owns
      its own <code>$query</code> / <code>$items</code> signals — typing in
      one does not affect the other.
    </p>

    <div class="pair">
      <section>
        <h2>Instance A</h2>
        <app-typeahead
          fetch-url="/api/v1/agents/search"
          placeholder="Search agents (A)…"
          min-chars="1"
          debounce-ms="200"
          data-on:select="document.getElementById('sel-a').textContent = JSON.stringify(evt.detail)"
        ></app-typeahead>
        <p class="selected">Selected: <span id="sel-a">(none)</span></p>
      </section>

      <section>
        <h2>Instance B</h2>
        <app-typeahead
          fetch-url="/api/v1/agents/search"
          placeholder="Search agents (B)…"
          min-chars="1"
          debounce-ms="200"
          data-on:select="document.getElementById('sel-b').textContent = JSON.stringify(evt.detail)"
        ></app-typeahead>
        <p class="selected">Selected: <span id="sel-b">(none)</span></p>
      </section>
    </div>
  </main>
</body>
</html>
