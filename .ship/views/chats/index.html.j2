{#-
  Mission Control — every PTY session the daemon knows about.
  Server-renders the full list via ship.sessions.list(). Datastar
  only handles filter-tab toggling via a class on the grid; each
  card carries data-status so CSS shows/hides accordingly.
-#}
{% from '_ship.html.j2' import head, signals %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Chats') }}</head>
<body>
{% endif %}
{%- set all_items = ship.sessions.list().items -%}
{#- Chats = agent sessions only. Shell + pipeline sessions live
    elsewhere (dock terminal, pipelines view). -#}
{%- set items = all_items | selectattr('kind', 'equalto', 'agent') | list -%}
{%- set active_count = items | selectattr('status', 'ne', 'ended') | list | length -%}
<ship-view-chrome title="Chats"></ship-view-chrome>
<div class="ship-view ship-chats">
  <style>
  .ship-chats { padding: var(--space-5, 20px); max-width: 1280px; margin: 0 auto; color: var(--foreground); }
  .chats-head { display: flex; align-items: baseline; gap: var(--space-4, 16px); margin-bottom: var(--space-4, 16px); flex-wrap: wrap; }
  .chats-head h1 { margin: 0; font-size: var(--text-2xl); font-weight: var(--font-weight-medium, 500); }
  .chats-head .sub { color: var(--muted-foreground); font-size: var(--text-sm); }
  .chats-filters { display: inline-flex; border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; margin-left: auto; }
  .chats-filter { appearance: none; background: transparent; color: var(--muted-foreground); border: 0; padding: 4px 12px; font: inherit; font-size: var(--text-xs); cursor: pointer; border-right: 1px solid var(--border); }
  .chats-filter:last-child { border-right: 0; }
  .chats-filter[aria-pressed="true"] { background: var(--muted); color: var(--foreground); }
  .chats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-3, 12px); }
  .chat-card { border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-3, 12px); background: var(--card, var(--background)); display: grid; gap: 6px; cursor: pointer; transition: border-color var(--duration-fast, 120ms) var(--ease-out, ease); }
  .chat-card:hover { border-color: color-mix(in oklch, var(--foreground) 30%, var(--border)); }
  .chat-card[data-status="ended"] { opacity: 0.6; }
  .chats-grid[data-filter="active"] .chat-card[data-status="ended"] { display: none; }
  .chats-grid[data-filter="ended"] .chat-card:not([data-status="ended"]) { display: none; }
  .card-head { display: flex; align-items: center; gap: 8px; }
  .card-head .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--muted-foreground); }
  .card-head .dot[data-status="idle"] { background: var(--success, #16a34a); }
  .card-head .dot[data-status="thinking"] { background: var(--warning, #d97706); }
  .card-head .agent { font-weight: var(--font-weight-medium, 500); }
  .card-head .kind { font-size: var(--text-xs); color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.04em; margin-left: auto; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: var(--text-xs); color: var(--muted-foreground); font-family: var(--font-mono); }
  .card-actions { display: flex; gap: 8px; margin-top: 4px; }
  .card-action { appearance: none; font: inherit; font-size: var(--text-xs); padding: 3px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm, 4px); background: transparent; color: var(--foreground); cursor: pointer; }
  .card-action.danger:hover { color: var(--destructive); border-color: var(--destructive); }
  .chats-empty { padding: var(--space-12, 48px) var(--space-5, 20px); text-align: center; color: var(--muted-foreground); border: 1px dashed var(--border); border-radius: var(--radius-md); }
  </style>

  <header class="chats-head">
    <h1>Chats</h1>
    <div class="sub">{{ active_count }} active · total {{ items | length }}</div>
  </header>

  {% if items | length == 0 %}
    <div class="chats-empty">
      No sessions. Open the command bar (⌘K or Space Space) and start one.
    </div>
  {% else %}
    <div class="chats-grid">
      {% for s in items %}
      <div class="chat-card" data-status="{{ s.status }}"
           data-on-click="window.ship.navigate('/')">
        <div class="card-head">
          <span class="dot" data-status="{{ s.status }}"></span>
          <span class="agent">{{ s.agent_id or '(shell)' }}</span>
          <span class="kind">{{ s.kind }}</span>
        </div>
        <div class="card-meta">
          <span>workspace: {{ s.workspace_id }}</span>
          {% if s.provider %}<span>provider: {{ s.provider }}</span>{% endif %}
          <span>pid: {{ s.pid or '—' }}</span>
          <span>status: {{ s.status }}</span>
        </div>
        <div class="card-actions">
          <button class="card-action"
                  data-on-click__stop="window.ship.navigate('/')">Attach</button>
          <button class="card-action danger"
                  data-on-click__stop="fetch('/api/sessions/{{ s.id }}', {method: 'DELETE', credentials: 'same-origin'}).then(() => window.ship.navigate('/chats'))">End</button>
        </div>
      </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
