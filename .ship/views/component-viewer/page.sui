<!--
  component-viewer — the campaign's "eyes on active dev" surface.

  Browses the campaign `<sui-*>` tags and mounts the selected one live in a
  <sui-render mode="tag"> stage (COMPONENT-MODE; no live source editing — that
  needs the daemon-WASM change, task #241).

  Every tag in the browse list is registered into this view bundle by the
  controller's side-effect imports, so the stage mounts by NAME with no
  in-browser compile. See index.controller.ts for the registration seam + the
  stub-compile rationale.
-->

<div class="cv">
  <header class="cv-head">
    <div class="cv-head-text">
      <h1 class="cv-title">Components</h1>
      <p class="cv-sub">Live preview of the campaign's <code>&lt;sui-*&gt;</code> tags — click a tag to mount it.</p>
    </div>
    <span class="cv-mode-pill">component-mode</span>
  </header>

  <div class="cv-body">
    <nav class="cv-list" aria-label="Available components">
      {#for tag of tags() key={tag.name}}
        <button
          type="button"
          class="cv-list-item"
          class:active={tag.name === selected()}
          aria-pressed={tag.name === selected() ? 'true' : 'false'}
          on:click={() => selected.set(tag.name)}
        >
          <span class="cv-item-label">{tag.label}</span>
          <code class="cv-item-tag">{tag.name}</code>
          <span class="cv-item-group">{tag.group}</span>
        </button>
      {/for}
    </nav>

    <section class="cv-stage-wrap" aria-label="Render stage">
      <div class="cv-stage-head">
        <code class="cv-stage-tag">&lt;{current().name}&gt;</code>
        <p class="cv-stage-blurb">{current().blurb}</p>
      </div>

      <div class="cv-stage">
        <sui-render
          mode="tag"
          component-name={current().name}
          viewport-width="full"
          prop:compile={compile()}
          prop:source={source()}
          prop:prop-values={propValues()}
        ></sui-render>
      </div>
    </section>
  </div>
</div>
