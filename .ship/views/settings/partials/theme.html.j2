{#- Theme picker section for the settings view.
    Renders preset cards with color swatches + mode toggle.
    Theme switching calls window.setShipTheme(name) from the shell. -#}
{% from '_ship.html.j2' import section, endsection %}
<style>
  /* Theme preset grid — a 5-tile swatch picker is a view-specific composition
     (gradient-sampled color swatches + name), not a library pattern. Kept view-local. */
  .s-theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-2);
    padding: var(--space-3) 0;
  }
  .s-theme-card {
    border: 2px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
    background: var(--card);
  }
  .s-theme-card:hover {
    border-color: color-mix(in oklch, var(--primary) 50%, var(--border));
  }
  .s-theme-card.is-active {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 20%, transparent);
  }
  .s-theme-swatches {
    display: flex;
    gap: 3px;
    margin-bottom: var(--space-2);
    height: 28px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .s-theme-swatches span {
    flex: 1;
    display: block;
  }
  .s-theme-name {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    text-align: center;
  }
  /* Color-mode row — horizontal label + 3-button picker; ship-list-tile's
     meta/trailing split puts the buttons below the label at this density,
     so the inline layout stays view-local. */
  .s-mode-row {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) 0;
  }
</style>

<div id="settings-theme">
  {{ section('Theme', icon='eye') }}
    <div class="s-section-body">
      <div class="s-mode-row">
        <div class="s-row-label">Color mode</div>
        <div class="s-mode-ctrl">
          <ship-button size="sm" variant="outline"
            onclick="document.documentElement.classList.remove('dark');localStorage.setItem('ship-shell-theme','light')">Light</ship-button>
          <ship-button size="sm" variant="outline"
            onclick="document.documentElement.classList.add('dark');localStorage.setItem('ship-shell-theme','dark')">Dark</ship-button>
          <ship-button size="sm" variant="outline"
            onclick="const d=matchMedia('(prefers-color-scheme:dark)').matches;document.documentElement.classList.toggle('dark',d);localStorage.removeItem('ship-shell-theme')">System</ship-button>
        </div>
      </div>

      <div class="s-row-label" style="margin-top:var(--space-2)">Presets</div>
      <div class="s-theme-grid">
        <div class="s-theme-card is-active" onclick="window.setShipTheme && window.setShipTheme('ship')">
          <div class="s-theme-swatches">
            <span style="background:oklch(0.98 0.005 75)"></span>
            <span style="background:oklch(0.65 0.19 45)"></span>
            <span style="background:oklch(0.55 0.14 250)"></span>
            <span style="background:oklch(0.92 0.005 75)"></span>
          </div>
          <div class="s-theme-name">Ship</div>
        </div>

        <div class="s-theme-card" onclick="window.setShipTheme && window.setShipTheme('gruvbox')">
          <div class="s-theme-swatches">
            <span style="background:oklch(0.97 0.008 90)"></span>
            <span style="background:oklch(0.62 0.17 55)"></span>
            <span style="background:oklch(0.65 0.16 145)"></span>
            <span style="background:oklch(0.92 0.012 85)"></span>
          </div>
          <div class="s-theme-name">Gruvbox</div>
        </div>

        <div class="s-theme-card" onclick="window.setShipTheme && window.setShipTheme('nord')">
          <div class="s-theme-swatches">
            <span style="background:oklch(0.97 0.005 230)"></span>
            <span style="background:oklch(0.62 0.10 250)"></span>
            <span style="background:oklch(0.70 0.12 175)"></span>
            <span style="background:oklch(0.93 0.008 230)"></span>
          </div>
          <div class="s-theme-name">Nord</div>
        </div>

        <div class="s-theme-card" onclick="window.setShipTheme && window.setShipTheme('catppuccin')">
          <div class="s-theme-swatches">
            <span style="background:oklch(0.96 0.01 240)"></span>
            <span style="background:oklch(0.60 0.18 290)"></span>
            <span style="background:oklch(0.70 0.15 180)"></span>
            <span style="background:oklch(0.92 0.012 250)"></span>
          </div>
          <div class="s-theme-name">Catppuccin</div>
        </div>

        <div class="s-theme-card" onclick="window.setShipTheme && window.setShipTheme('tokyo-night')">
          <div class="s-theme-swatches">
            <span style="background:oklch(0.18 0.02 260)"></span>
            <span style="background:oklch(0.65 0.18 280)"></span>
            <span style="background:oklch(0.70 0.16 180)"></span>
            <span style="background:oklch(0.25 0.02 260)"></span>
          </div>
          <div class="s-theme-name">Tokyo Night</div>
        </div>
      </div>
    </div>
  {{ endsection() }}
</div>
