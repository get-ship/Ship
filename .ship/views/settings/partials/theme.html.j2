{#- Theme settings — retired. The canonical theme picker lives in the
    shell topbar (palette icon, top-right). Every Ship theme is now a
    complete aesthetic bundle (palette + surfaces + motion + radii +
    shadows + typography + interaction). See the `ship-design-system`
    skill and the "Customizing Ship" doc for details.
-#}
{% from '_ship.html.j2' import section, endsection %}

<div id="settings-theme">
  {{ section('Theme', icon='eye') }}
    <div class="s-section-body">
      <ship-empty-state icon="palette" tone="muted" size="sm"
        style="padding: var(--space-4) 0">
        <span slot="title">Theme lives in the top bar</span>
        Open the palette icon in the top-right to pick a theme. Every
        Ship theme bundles a full aesthetic — palette, motion, radii,
        shadows, typography — not just color.
      </ship-empty-state>
    </div>
  {{ endsection() }}
</div>
