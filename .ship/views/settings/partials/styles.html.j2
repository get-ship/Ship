{#- Settings CSS -- included by content.html.j2 -#}
<style>
  .s-card {
    margin-bottom: var(--space-4);
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    background: var(--card, #fff);
  }
  .s-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .s-card-title {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-base); font-weight: var(--font-weight-semibold); color: var(--muted-foreground);
  }
  .s-card-title svg { width: 15px; height: 15px; color: var(--muted-foreground); flex-shrink: 0; }
  .s-card-body { padding: var(--space-1) var(--space-4); }

  .s-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-2) 0;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
  }
  .s-row:last-child { border-bottom: 0; }
  .s-row-label { font-size: var(--text-sm); color: color-mix(in oklch, var(--foreground) 80%, transparent); }
  .s-row-sub { display: block; margin-top: 2px; font-size: var(--text-xs); color: var(--muted-foreground); }
  .s-row-ctrl { display: flex; align-items: center; gap: var(--space-2); flex-shrink: 0; }

  .s-provider-label {
    font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--muted-foreground); padding: var(--space-2) 0 var(--space-1);
  }
  .s-prov { display: flex; align-items: center; justify-content: space-between; padding: var(--space-1) 0; }
  .s-prov-left { display: flex; align-items: center; gap: var(--space-2); }
  .s-prov-dot {
    width: var(--space-2); height: var(--space-2); border-radius: var(--radius-full); flex-shrink: 0;
    background: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
  }
  .s-prov-dot.on { background: var(--success); }
  .s-prov-name { font-size: var(--text-xs); color: color-mix(in oklch, var(--foreground) 80%, transparent); font-family: var(--font-mono); }
  .s-prov-right { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); }
  .s-prov-right .mono { font-family: var(--font-mono); }

  /* Collapsible trigger styling */
  .s-collapse-trigger {
    display: flex; align-items: center; justify-content: space-between;
    width: 100%; padding: var(--space-3) var(--space-4); cursor: pointer; box-sizing: border-box;
  }
  .s-collapse-trigger:focus-visible {
    outline: var(--ring-width) solid color-mix(in oklch, var(--ring) 50%, transparent);
    outline-offset: -3px; border-radius: var(--radius-xl);
  }
  .s-chevron {
    width: var(--space-4); height: var(--space-4); color: var(--muted-foreground);
    transition: transform var(--duration-medium) var(--ease-out);
  }
  .s-chevron.open { transform: rotate(180deg); }
  /* Separator between trigger and collapsible content */
  .s-collapse-inner {
    border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }

  .s-link {
    display: inline-flex; align-items: center; gap: var(--space-1);
    font-size: var(--text-xs); color: var(--primary); text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .s-link:hover { text-decoration: underline; }
  .s-link svg { width: var(--space-3); height: var(--space-3); }

  .s-save-badge {
    display: inline-flex; align-items: center; gap: var(--space-1);
    font-size: var(--text-xs); color: var(--success); opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  .s-save-badge.visible { opacity: 1; }
  .s-save-badge svg { width: var(--space-3); height: var(--space-3); }

  .s-status { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); }
  .s-status-dot { width: var(--space-2); height: var(--space-2); border-radius: var(--radius-full); background: var(--success); }
  .s-status-text { color: var(--foreground); font-size: var(--text-xs); }
  .s-mono-val { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--foreground); }

  /* ship-input width override for settings layout */
  ship-input { width: 160px; }

  @media (max-width: 640px) {
    .s-row { flex-direction: column; align-items: flex-start; gap: 6px; }
    .s-row-ctrl { width: 100%; }
    ship-input { width: 100%; }
  }
</style>
