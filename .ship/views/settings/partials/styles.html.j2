{#- Settings CSS -- included by content.html.j2 -#}
<style>
  .s-card {
    margin-bottom: 16px;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    background: var(--card, #fff);
  }
  .s-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  }
  .s-card-title {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; color: var(--muted-foreground);
  }
  .s-card-title svg { width: 15px; height: 15px; color: var(--muted-foreground); flex-shrink: 0; }
  .s-card-body { padding: 4px 16px; }

  .s-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
  }
  .s-row:last-child { border-bottom: 0; }
  .s-row-label { font-size: 12px; color: color-mix(in oklch, var(--foreground) 80%, transparent); }
  .s-row-sub { display: block; margin-top: 2px; font-size: 10px; color: var(--muted-foreground); }
  .s-row-ctrl { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  .s-select {
    border-radius: 8px;
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    background: color-mix(in oklch, var(--muted, #f0f0f0) 30%, transparent);
    padding: 4px 8px; font-size: 11px; color: var(--foreground);
    outline: none; font-family: inherit; cursor: pointer;
  }
  .s-select:focus { border-color: var(--ring); }
  .s-input {
    width: 160px; border-radius: 8px;
    border: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    background: color-mix(in oklch, var(--muted, #f0f0f0) 30%, transparent);
    padding: 4px 8px; font-size: 11px; color: var(--foreground);
    outline: none; font-family: var(--font-mono);
  }
  .s-input:focus { border-color: var(--ring); }
  .s-input::placeholder { color: var(--muted-foreground); opacity: 0.6; }

  .s-provider-label {
    font-size: 10px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--muted-foreground); padding: 8px 0 4px;
  }
  .s-prov { display: flex; align-items: center; justify-content: space-between; padding: 4px 0; }
  .s-prov-left { display: flex; align-items: center; gap: 8px; }
  .s-prov-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
    background: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
  }
  .s-prov-dot.on { background: oklch(0.596 0.145 163.225); }
  .s-prov-name { font-size: 11px; color: color-mix(in oklch, var(--foreground) 80%, transparent); font-family: var(--font-mono); }
  .s-prov-right { display: flex; align-items: center; gap: 8px; font-size: 10px; color: var(--muted-foreground); }
  .s-prov-right .mono { font-family: var(--font-mono); }

  .s-collapse-btn {
    all: unset; display: flex; align-items: center; justify-content: space-between;
    width: 100%; padding: 12px 16px; cursor: pointer; box-sizing: border-box;
  }
  .s-collapse-btn:focus-visible {
    outline: 3px solid color-mix(in oklch, var(--ring) 50%, transparent);
    outline-offset: -3px; border-radius: 14px;
  }
  .s-chevron { width: 16px; height: 16px; color: var(--muted-foreground); transition: transform 0.2s ease; }
  .s-chevron.open { transform: rotate(180deg); }
  .s-collapse-body { display: none; border-top: 1px solid color-mix(in oklch, var(--border) 40%, transparent); }
  .s-collapse-body.open { display: block; }

  .s-link {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; color: var(--primary); text-decoration: none; transition: all 0.15s;
  }
  .s-link:hover { text-decoration: underline; }
  .s-link svg { width: 12px; height: 12px; }

  .s-save-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; color: oklch(0.596 0.145 163.225); opacity: 0; transition: opacity 0.3s;
  }
  .s-save-badge.visible { opacity: 1; }
  .s-save-badge svg { width: 12px; height: 12px; }

  .s-status { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; }
  .s-status-dot { width: 8px; height: 8px; border-radius: 50%; background: oklch(0.596 0.145 163.225); }
  .s-status-text { color: var(--foreground); font-size: 11px; }
  .s-mono-val { font-family: var(--font-mono); font-size: 11px; color: var(--foreground); }

  @media (max-width: 640px) {
    .s-row { flex-direction: column; align-items: flex-start; gap: 6px; }
    .s-row-ctrl { width: 100%; }
    .s-input { width: 100%; }
  }
</style>
