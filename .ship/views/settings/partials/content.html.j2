{#- Settings content partial -- rendered by the SSE handler.
   Root element MUST have id="settings-content" for Datastar patching.
   Matches React /studio/settings parity spec. -#}
{% from '_ship.html.j2' import section, endsection %}
{% from '_urls.html.j2' import update_setting %}
<div id="settings-content">
  {% include 'settings/partials/styles.html.j2' %}

  {# ── THEME ── #}
  {% include 'settings/partials/theme.html.j2' %}

  {# ── PROVIDERS ── #}
  {#- SDK gap: section() macro takes an icon= name string which maps to the
      ship-icon built-in registry; lucide "cpu" isn't in the registry so we
      pass the SVG via ship-icon's default slot by opening the ship-card
      directly. Alternative: add "cpu" to packages/ship-set/src/web-components/core/ship-icon.ts ICONS. -#}
  <ship-card padding="none">
    <div slot="header" class="s-section-head">
      <h2 class="s-section-title">
        <ship-icon><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/></svg></ship-icon>
        Providers
      </h2>
    </div>
    <div class="s-section-body">
      <ship-list-tile density="compact">
        <span class="s-row-label">Default provider</span>
        <span slot="meta">Used when no provider is specified</span>
        <span slot="trailing" class="s-row-trailing">
          <ship-badge id="save-provider" tone="success" variant="soft" size="sm" class="s-save-badge">
            <ship-icon slot="leading" name="check" size="sm"></ship-icon>Saved
          </ship-badge>
          <ship-select size="sm" id="sel-provider"
            value="{{ default_provider }}">
            {% for p in providers %}
              <option value="{{ p.id }}"
                {% if p.id == default_provider %}selected{% endif %}>{{ p.id }}</option>
            {% endfor %}
          </ship-select>
        </span>
      </ship-list-tile>

      <ship-list-tile density="compact">
        <span class="s-row-label">Default model</span>
        <span slot="meta">Model name passed to the provider</span>
        <span slot="trailing" class="s-row-trailing">
          <ship-badge id="save-model" tone="success" variant="soft" size="sm" class="s-save-badge">
            <ship-icon slot="leading" name="check" size="sm"></ship-icon>Saved
          </ship-badge>
          <ship-input size="sm" id="inp-model"
            value="{{ default_model }}"
            placeholder="e.g. sonnet"
            data-key="defaults.model"></ship-input>
        </span>
      </ship-list-tile>

      {% if providers and providers | length > 0 %}
      <div class="s-provider-list">
        <div class="s-provider-label">Installed providers</div>
        {% for p in providers %}
        <ship-list-tile density="compact" class="s-prov-tile">
          <ship-status-dot slot="leading" tone="{{ 'success' if p.available else 'muted' }}"></ship-status-dot>
          <span class="s-prov-name">{{ p.id }}</span>
          <span slot="trailing" class="s-prov-right">
            <span>{% if p.available %}installed{% else %}not found{% endif %}</span>
            {% if p.version %}
              <span class="mono">v{{ p.version }}{% if p.label %} ({{ p.label }}){% endif %}</span>
            {% endif %}
          </span>
        </ship-list-tile>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </ship-card>

  {# ── TERMINAL ── #}
  {{ section('Terminal', icon='terminal') }}
    <div class="s-section-body">
      <ship-list-tile density="compact">
        <span class="s-row-label">Terminal program</span>
        <span slot="meta">Used when launching sessions</span>
        <span slot="trailing" class="s-row-trailing">
          <ship-badge id="save-terminal" tone="success" variant="soft" size="sm" class="s-save-badge">
            <ship-icon slot="leading" name="check" size="sm"></ship-icon>Saved
          </ship-badge>
          <ship-select size="sm" id="sel-terminal"
            value="{{ terminal.program }}">
            {% for opt in terminal.options %}
              <option value="{{ opt.value }}"
                {% if opt.value == terminal.program %}selected{% endif %}>{{ opt.label }}</option>
            {% endfor %}
          </ship-select>
        </span>
      </ship-list-tile>

      <ship-list-tile density="compact">
        <span class="s-row-label">Worktree base directory</span>
        <span slot="meta">Root for git worktrees</span>
        <span slot="trailing" class="s-row-trailing">
          <ship-badge id="save-worktree" tone="success" variant="soft" size="sm" class="s-save-badge">
            <ship-icon slot="leading" name="check" size="sm"></ship-icon>Saved
          </ship-badge>
          <ship-input size="sm" id="inp-worktree"
            value="{{ terminal.worktree_base }}"
            placeholder="/path/to/worktrees"
            data-key="worktree.base_dir"></ship-input>
        </span>
      </ship-list-tile>
    </div>
  {{ endsection() }}

  {# ── ADVANCED (collapsible) ──
     SDK gap: the section() macro pairs with ship-card but a collapsible card
     with a trigger slot doesn't fit the header-divider model. Kept as a
     hand-wrapped ship-card + ship-collapsible until a ship-collapsible-card
     primitive lands (or section() grows a `collapsible=` arg). -#}
  <ship-card padding="none" id="advanced-card">
    <ship-collapsible id="advanced-collapsible">
      <div slot="trigger" class="s-collapse-trigger">
        <h2 class="s-section-title">
          <ship-icon name="settings"></ship-icon>
          Advanced
        </h2>
        <ship-icon class="s-chevron" id="advanced-chevron" name="chevron-down"></ship-icon>
      </div>
      <div class="s-collapse-inner">
        <div class="s-section-body">
          <ship-list-tile density="compact">
            <span class="s-row-label">Daemon status</span>
            <span slot="trailing" class="s-row-trailing">
              <ship-status-dot tone="success" label="Connected"></ship-status-dot>
              <span class="s-status-text">Connected</span>
            </span>
          </ship-list-tile>
          <ship-list-tile density="compact">
            <span class="s-row-label">Daemon endpoint</span>
            <span slot="trailing" class="s-mono-val">{{ daemon_endpoint }}</span>
          </ship-list-tile>
          <ship-list-tile density="compact">
            <span class="s-row-label">Registry endpoint</span>
            <span slot="meta">Package registry URL</span>
            <span slot="trailing" class="s-row-trailing">
              <ship-badge id="save-registry" tone="success" variant="soft" size="sm" class="s-save-badge">
                <ship-icon slot="leading" name="check" size="sm"></ship-icon>Saved
              </ship-badge>
              <ship-input size="sm" id="inp-registry"
                value="{{ advanced_registry }}"
                placeholder="https://registry.getship.dev"
                data-key="registry.endpoint"></ship-input>
            </span>
          </ship-list-tile>
        </div>
      </div>
    </ship-collapsible>
  </ship-card>

  {# ── ABOUT ── #}
  {{ section('About', icon='info') }}
    <div class="s-section-body">
      <ship-list-tile density="compact">
        <span class="s-row-label">Documentation</span>
        <span slot="trailing">
          <ship-link href="{{ about.docs }}" external>getship.dev/docs</ship-link>
        </span>
      </ship-list-tile>
      <ship-list-tile density="compact">
        <span class="s-row-label">Source</span>
        <span slot="trailing">
          <ship-link href="{{ about.source }}" external>GitHub</ship-link>
        </span>
      </ship-list-tile>
    </div>
  {{ endsection() }}

  <script>
    function shipSaveSetting(key, value, badgeId) {
      var badge = document.getElementById(badgeId);
      fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: key, value: value })
      }).then(function() {
        if (badge) {
          badge.classList.add('visible');
          setTimeout(function() { badge.classList.remove('visible'); }, 1500);
        }
      }).catch(function(err) {
        console.error('Save failed:', key, err);
      });
    }

    /* Wire ship-select elements to save on change */
    (function() {
      var selProvider = document.getElementById('sel-provider');
      if (selProvider) {
        selProvider.addEventListener('ship-change', function(e) {
          shipSaveSetting('defaults.provider', e.detail.value, 'save-provider');
        });
      }
      var selTerminal = document.getElementById('sel-terminal');
      if (selTerminal) {
        selTerminal.addEventListener('ship-change', function(e) {
          shipSaveSetting('terminal.program', e.detail.value, 'save-terminal');
        });
      }

      /* Wire ship-input elements to commit on blur / Enter */
      function wireInput(id, badgeId) {
        var el = document.getElementById(id);
        if (!el) return;
        var origVal = el.getAttribute('value') || '';
        el.addEventListener('ship-input', function() {});
        el.addEventListener('focusout', function() {
          var val = (el.value || '').trim();
          if (val === origVal) return;
          origVal = val;
          shipSaveSetting(el.getAttribute('data-key'), val, badgeId);
        });
        el.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') el.blur();
        });
      }
      wireInput('inp-model', 'save-model');
      wireInput('inp-worktree', 'save-worktree');
      wireInput('inp-registry', 'save-registry');

      /* Wire ship-collapsible chevron rotation */
      var collapsible = document.getElementById('advanced-collapsible');
      if (collapsible) {
        collapsible.addEventListener('ship-toggle', function(e) {
          var chevron = document.getElementById('advanced-chevron');
          if (chevron) chevron.classList.toggle('open', e.detail.open);
        });
      }
    })();
  </script>
</div>
