{#- Settings content partial -- rendered by the SSE handler.
   Root element MUST have id="settings-content" for Datastar patching.
   Matches React /studio/settings parity spec. -#}
{% from '_urls.html.j2' import update_setting %}
<div id="settings-content">
  {% include 'settings/partials/styles.html.j2' %}
  {% include 'settings/partials/icons.html.j2' %}

  {# ── THEME ── #}
  {% include 'settings/partials/theme.html.j2' %}

  {# ── PROVIDERS ── #}
  <div class="s-card">
    <div class="s-card-head">
      <div class="s-card-title">
        <svg><use href="#ico-cpu"/></svg>
        Providers
      </div>
    </div>
    <div class="s-card-body">
      <div class="s-row">
        <div>
          <div class="s-row-label">Default provider</div>
          <span class="s-row-sub">Used when no provider is specified</span>
        </div>
        <div class="s-row-ctrl">
          <span id="save-provider" class="s-save-badge">
            <svg><use href="#ico-check"/></svg> Saved
          </span>
          <ship-select size="sm" id="sel-provider"
            value="{{ default_provider }}">
            {% for p in providers %}
              <option value="{{ p.id }}"
                {% if p.id == default_provider %}selected{% endif %}>{{ p.id }}</option>
            {% endfor %}
          </ship-select>
        </div>
      </div>

      <div class="s-row">
        <div>
          <div class="s-row-label">Default model</div>
          <span class="s-row-sub">Model name passed to the provider</span>
        </div>
        <div class="s-row-ctrl">
          <span id="save-model" class="s-save-badge">
            <svg><use href="#ico-check"/></svg> Saved
          </span>
          <ship-input size="sm" id="inp-model"
            value="{{ default_model }}"
            placeholder="e.g. sonnet"
            data-key="defaults.model"></ship-input>
        </div>
      </div>

      {% if providers and providers | length > 0 %}
      <div style="padding: var(--space-1) 0 var(--space-2)">
        <div class="s-provider-label">Installed providers</div>
        {% for p in providers %}
        <div class="s-prov">
          <div class="s-prov-left">
            <span class="s-prov-dot {% if p.available %}on{% endif %}"></span>
            <span class="s-prov-name">{{ p.id }}</span>
          </div>
          <div class="s-prov-right">
            <span>{% if p.available %}installed{% else %}not found{% endif %}</span>
            {% if p.version %}
              <span class="mono">v{{ p.version }}{% if p.label %} ({{ p.label }}){% endif %}</span>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>

  {# ── TERMINAL ── #}
  <div class="s-card">
    <div class="s-card-head">
      <div class="s-card-title">
        <svg><use href="#ico-terminal"/></svg>
        Terminal
      </div>
    </div>
    <div class="s-card-body">
      <div class="s-row">
        <div>
          <div class="s-row-label">Terminal program</div>
          <span class="s-row-sub">Used when launching sessions</span>
        </div>
        <div class="s-row-ctrl">
          <span id="save-terminal" class="s-save-badge">
            <svg><use href="#ico-check"/></svg> Saved
          </span>
          <ship-select size="sm" id="sel-terminal"
            value="{{ terminal.program }}">
            {% for opt in terminal.options %}
              <option value="{{ opt.value }}"
                {% if opt.value == terminal.program %}selected{% endif %}>{{ opt.label }}</option>
            {% endfor %}
          </ship-select>
        </div>
      </div>

      <div class="s-row">
        <div>
          <div class="s-row-label">Worktree base directory</div>
          <span class="s-row-sub">Root for git worktrees</span>
        </div>
        <div class="s-row-ctrl">
          <span id="save-worktree" class="s-save-badge">
            <svg><use href="#ico-check"/></svg> Saved
          </span>
          <ship-input size="sm" id="inp-worktree"
            value="{{ terminal.worktree_base }}"
            placeholder="/path/to/worktrees"
            data-key="worktree.base_dir"></ship-input>
        </div>
      </div>
    </div>
  </div>

  {# ── ADVANCED (collapsible) ── #}
  <div class="s-card" id="advanced-card">
    <ship-collapsible id="advanced-collapsible">
      <div slot="trigger" class="s-collapse-trigger">
        <div class="s-card-title">
          <svg><use href="#ico-settings2"/></svg>
          Advanced
        </div>
        <svg class="s-chevron" id="advanced-chevron"><use href="#ico-chevron-down"/></svg>
      </div>
      <div class="s-collapse-inner">
        <div class="s-card-body">
          <div class="s-row">
            <div><div class="s-row-label">Daemon status</div></div>
            <div class="s-row-ctrl">
              <span class="s-status">
                <span class="s-status-dot"></span>
                <span class="s-status-text">Connected</span>
              </span>
            </div>
          </div>
          <div class="s-row">
            <div><div class="s-row-label">Daemon endpoint</div></div>
            <div class="s-row-ctrl">
              <span class="s-mono-val">{{ daemon_endpoint }}</span>
            </div>
          </div>
          <div class="s-row">
            <div>
              <div class="s-row-label">Registry endpoint</div>
              <span class="s-row-sub">Package registry URL</span>
            </div>
            <div class="s-row-ctrl">
              <span id="save-registry" class="s-save-badge">
                <svg><use href="#ico-check"/></svg> Saved
              </span>
              <ship-input size="sm" id="inp-registry"
                value="{{ advanced_registry }}"
                placeholder="https://registry.getship.dev"
                data-key="registry.endpoint"></ship-input>
            </div>
          </div>
        </div>
      </div>
    </ship-collapsible>
  </div>

  {# ── ABOUT ── #}
  <div class="s-card">
    <div class="s-card-head">
      <div class="s-card-title">
        <svg><use href="#ico-info"/></svg>
        About
      </div>
    </div>
    <div class="s-card-body">
      <div class="s-row">
        <div><div class="s-row-label">Documentation</div></div>
        <div class="s-row-ctrl">
          <a class="s-link" href="{{ about.docs }}" target="_blank" rel="noopener noreferrer">
            getship.dev/docs
            <svg><use href="#ico-external"/></svg>
          </a>
        </div>
      </div>
      <div class="s-row">
        <div><div class="s-row-label">Source</div></div>
        <div class="s-row-ctrl">
          <a class="s-link" href="{{ about.source }}" target="_blank" rel="noopener noreferrer">
            GitHub
            <svg><use href="#ico-external"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    function shipSaveSetting(key, value, badgeId) {
      var badge = document.getElementById(badgeId);
      fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: key, value: value })
      }).then(function() {
        if (badge) {
          badge.classList.add('visible');
          setTimeout(function() { badge.classList.remove('visible'); }, 1500);
        }
      }).catch(function(err) {
        console.error('Save failed:', key, err);
      });
    }

    function shipCommitInput(el, badgeId) {
      var key = el.getAttribute('data-key');
      var orig = el.defaultValue;
      var val = el.value.trim();
      if (val === orig) return;
      el.defaultValue = val;
      shipSaveSetting(key, val, badgeId);
    }

    function toggleAdvanced() {
      var body = document.getElementById('advanced-body');
      var chevron = document.getElementById('advanced-chevron');
      var btn = body.previousElementSibling;
      var isOpen = body.classList.contains('open');
      body.classList.toggle('open');
      chevron.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!isOpen));
    }

    /* Wire ship-select elements to save on change */
    (function() {
      var selProvider = document.getElementById('sel-provider');
      if (selProvider) {
        selProvider.addEventListener('ship-change', function(e) {
          shipSaveSetting('defaults.provider', e.detail.value, 'save-provider');
        });
      }
      var selTerminal = document.getElementById('sel-terminal');
      if (selTerminal) {
        selTerminal.addEventListener('ship-change', function(e) {
          shipSaveSetting('terminal.program', e.detail.value, 'save-terminal');
        });
      }

      /* Wire ship-input elements to commit on blur / Enter */
      function wireInput(id, badgeId) {
        var el = document.getElementById(id);
        if (!el) return;
        var origVal = el.getAttribute('value') || '';
        el.addEventListener('ship-input', function() {});
        el.addEventListener('focusout', function() {
          var val = (el.value || '').trim();
          if (val === origVal) return;
          origVal = val;
          shipSaveSetting(el.getAttribute('data-key'), val, badgeId);
        });
        el.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') el.blur();
        });
      }
      wireInput('inp-model', 'save-model');
      wireInput('inp-worktree', 'save-worktree');
      wireInput('inp-registry', 'save-registry');

      /* Wire ship-collapsible chevron rotation */
      var collapsible = document.getElementById('advanced-collapsible');
      if (collapsible) {
        collapsible.addEventListener('ship-toggle', function(e) {
          var chevron = document.getElementById('advanced-chevron');
          if (chevron) chevron.classList.toggle('open', e.detail.open);
        });
      }
    })();
  </script>
</div>
