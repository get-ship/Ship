{#- Settings content partial -- rendered by the SSE handler.
   Root element MUST have id="settings-content" for Datastar patching. -#}
{% from '_ship.html.j2' import on %}
{% from '_urls.html.j2' import update_setting %}
<div id="settings-content">
  <style>
  .settings-section { margin: var(--space-5) 0 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .settings-section:first-child { margin-top: 0; }
  .settings-section-head { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); }
  .settings-section-desc { font-size: var(--text-sm); color: var(--muted-foreground); }
  .settings-row { display: grid; grid-template-columns: minmax(180px, 220px) 1fr; gap: var(--space-4); align-items: center; padding: var(--space-3) 0; border-bottom: 1px solid var(--border); }
  .settings-row:last-child { border-bottom: 0; }
  .settings-row-label { font-size: var(--text-sm); }
  .settings-row-sub { display: block; font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px; }
  .settings-row-control { display: flex; align-items: center; gap: var(--space-2); justify-content: flex-end; }
  @media (max-width: 700px) { .settings-row { grid-template-columns: 1fr; } .settings-row-control { justify-content: flex-start; } }
  .provider-row { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-3); align-items: center; padding: var(--space-3) 0; border-bottom: 1px solid var(--border); }
  .provider-row:last-child { border-bottom: 0; }
  .provider-name { font-size: var(--text-sm); font-weight: var(--font-weight-medium); display: inline-flex; align-items: center; gap: var(--space-2); }
  .provider-meta { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); display: inline-flex; align-items: center; gap: var(--space-2); }
  .about-list { display: grid; grid-template-columns: 160px 1fr; gap: var(--space-2) var(--space-4); font-size: var(--text-sm); padding: var(--space-3) 0; }
  .about-list dt { color: var(--muted-foreground); font-weight: var(--font-weight-medium); }
  .about-list dd { margin: 0; font-family: var(--font-mono); font-size: var(--text-xs); }
  .about-list a { color: var(--primary); text-decoration: none; }
  .about-list a:hover { text-decoration: underline; }
  </style>

  {# -- PROVIDERS -- #}
  <section class="settings-section" aria-labelledby="settings-providers-head">
    <div id="settings-providers-head" class="settings-section-head">PROVIDERS</div>
    <p class="settings-section-desc">
      LLM provider CLIs detected on PATH. Configuration lives in
      <code>.ship/</code> and keys, when used, in <code>.ship/secrets/</code>.
    </p>
    <ship-card>
      {% if providers and providers | length > 0 %}
        {% for p in providers %}
        <div class="provider-row" data-provider-id="{{ p.id }}">
          <span aria-hidden="true">{{ p.glyph }}</span>
          <div>
            <span class="provider-name">
              {{ p.label }}
              {% if p.is_default %}<ship-badge tone="accent" size="sm">default</ship-badge>{% endif %}
            </span>
            <span class="provider-meta">
              <ship-status-dot tone="{% if p.available %}success{% else %}muted{% endif %}" size="sm"></ship-status-dot>
              <span>{{ p.binary }}</span>
              <span>{% if p.available %}{% if p.version %}v{{ p.version }}{% else %}installed{% endif %}{% else %}not found{% endif %}</span>
            </span>
          </div>
          <input
            type="radio"
            name="default-provider"
            value="{{ p.id }}"
            {% if p.is_default %}checked{% endif %}
            aria-label="Use {{ p.label }} as default provider"
            {{ on('click', "@put('" ~ update_setting() ~ "', {contentType: 'json', body: JSON.stringify({key: 'defaults.provider', value: '" ~ p.id ~ "'})})") }}
          />
        </div>
        {% endfor %}
      {% else %}
        <ship-empty-state>
          <span slot="title">No provider CLIs found on PATH</span>
        </ship-empty-state>
      {% endif %}

      <div class="settings-row">
        <div class="settings-row-label">
          Default model
          <span class="settings-row-sub">Model id passed to the default provider</span>
        </div>
        <div class="settings-row-control">
          <ship-input size="sm" placeholder="sonnet" value="{{ default_model }}"
            {{ on('ship-input__debounce.500ms', "@put('" ~ update_setting() ~ "', {contentType: 'json', body: JSON.stringify({key: 'defaults.model', value: evt.detail.value})})") }}></ship-input>
        </div>
      </div>
    </ship-card>
  </section>

  {# -- TERMINAL -- #}
  <section class="settings-section" aria-labelledby="settings-terminal-head">
    <div id="settings-terminal-head" class="settings-section-head">TERMINAL</div>
    <p class="settings-section-desc">
      Launcher used when starting agent sessions and the base directory for
      git worktrees.
    </p>
    <div class="settings-row">
      <div class="settings-row-label">
        Terminal program
        <span class="settings-row-sub">Launched for new sessions</span>
      </div>
      <div class="settings-row-control">
        <ship-select size="sm" value="{{ terminal.program }}"
          {{ on('ship-select-change', "@put('" ~ update_setting() ~ "', {contentType: 'json', body: JSON.stringify({key: 'terminal.program', value: evt.detail.value})})") }}>
          {% for opt in terminal.options %}
            <ship-option value="{{ opt.value }}" {% if opt.value == terminal.program %}selected{% endif %}>{{ opt.label }}</ship-option>
          {% endfor %}
        </ship-select>
      </div>
    </div>
    <div class="settings-row">
      <div class="settings-row-label">
        Worktree base directory
        <span class="settings-row-sub">Root for git worktrees</span>
      </div>
      <div class="settings-row-control">
        <ship-input size="sm" placeholder="/path/to/worktrees" value="{{ terminal.worktree_base }}"
          {{ on('ship-input__debounce.500ms', "@put('" ~ update_setting() ~ "', {contentType: 'json', body: JSON.stringify({key: 'worktree.base_dir', value: evt.detail.value})})") }}></ship-input>
      </div>
    </div>
  </section>

  {# -- ADVANCED -- #}
  <section class="settings-section" aria-labelledby="settings-advanced-head">
    <div id="settings-advanced-head" class="settings-section-head">ADVANCED</div>
    <p class="settings-section-desc">
      Low-level endpoints and experimental toggles. Change only if you know
      what you're doing.
    </p>
    <div class="settings-row">
      <div class="settings-row-label">
        Registry endpoint
        <span class="settings-row-sub">Package registry URL</span>
      </div>
      <div class="settings-row-control">
        <ship-input size="sm" placeholder="https://registry.getship.dev" value="{{ advanced_registry }}"
          {{ on('ship-input__debounce.500ms', "@put('" ~ update_setting() ~ "', {contentType: 'json', body: JSON.stringify({key: 'registry.endpoint', value: evt.detail.value})})") }}></ship-input>
      </div>
    </div>
    {% if advanced and advanced | length > 0 %}
      {% for flag in advanced %}
      <div class="settings-row">
        <div class="settings-row-label">
          {{ flag.label }}
          <span class="settings-row-sub">{{ flag.description }}</span>
        </div>
        <div class="settings-row-control">
          <ship-switch {% if flag.enabled %}checked{% endif %}
            {{ on('ship-switch-change', "@put('" ~ update_setting() ~ "', {contentType: 'json', body: JSON.stringify({key: '" ~ flag.key ~ "', value: evt.detail.checked})})") }}></ship-switch>
        </div>
      </div>
      {% endfor %}
    {% else %}
      <ship-empty-state><span slot="title">No experimental features available</span></ship-empty-state>
    {% endif %}
  </section>

  {# -- ABOUT -- #}
  <section class="settings-section" aria-labelledby="settings-about-head">
    <div id="settings-about-head" class="settings-section-head">ABOUT</div>
    <p class="settings-section-desc">
      Ship is the project intelligence layer. Planning, workspaces, sessions.
    </p>
    <dl class="about-list">
      <dt>Ship</dt>
      <dd>v{{ about.ship_version }}</dd>
      <dt>Daemon</dt>
      <dd>v{{ about.daemon_version }}</dd>
      <dt>CLI</dt>
      <dd>v{{ about.cli_version }}</dd>
      <dt>License</dt>
      <dd>{{ about.license }}</dd>
      <dt>Homepage</dt>
      <dd><a href="{{ about.homepage }}" target="_blank" rel="noopener noreferrer">{{ about.homepage }}</a></dd>
      <dt>Documentation</dt>
      <dd><a href="{{ about.docs }}" target="_blank" rel="noopener noreferrer">{{ about.docs }}</a></dd>
      <dt>Source</dt>
      <dd><a href="{{ about.source }}" target="_blank" rel="noopener noreferrer">{{ about.source }}</a></dd>
    </dl>
  </section>
</div>
