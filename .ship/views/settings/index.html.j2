{#-
  Settings view -- matches React /studio/settings parity.
  Single-column centered layout with four card sections:
  Providers, Terminal, Advanced (collapsible), About.
-#}
{% from '_ship.html.j2' import head, signal, live, styles %}
{% from '_urls.html.j2' import view_settings_sse %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Settings') }}</head>
<body>
{% endif %}
<div id="ship-view-root" class="ship-view ship-view-settings"
     {{ signal('section', 'all') }}
     {{ signal('advancedOpen', false) }}>
  {{ styles() }}
  <style>
    .ship-view-settings { color: var(--foreground); }
    .settings-wrap {
      max-width: 768px;
      margin: 0 auto;
      padding: 24px 24px 96px;
      width: 100%;
    }
    .settings-header { margin-bottom: 24px; }
    .settings-header h1 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      line-height: 28px;
      margin: 0;
      color: var(--foreground);
    }
    .settings-header p {
      font-size: 13px;
      line-height: 19.5px;
      color: var(--muted-foreground);
      margin: 2px 0 0;
    }
  </style>
  <main class="settings-wrap">
    <header class="settings-header">
      <h1>Settings</h1>
      <p>CLI and studio configuration</p>
    </header>

    <div id="settings-panel"
         {{ live('settings') }}>
      <div id="settings-content">
        <p style="font-size: 12px; color: var(--muted-foreground); padding: 12px 0">Loading...</p>
      </div>
    </div>
  </main>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
