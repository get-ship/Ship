{#-
  Settings view -- matches React /studio/settings parity.
  Single-column centered layout with four card sections:
  Providers, Terminal, Advanced (collapsible), About.
-#}
{% from '_ship.html.j2' import head, signal, live, styles %}
{% from '_urls.html.j2' import view_settings_sse %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Settings') }}</head>
<body>
{% endif %}
<div class="ship-view ship-view-settings"
     {{ signal('section', 'all') }}
     {{ signal('advancedOpen', false) }}>
  {{ styles() }}
  <style>
    .ship-view-settings { color: var(--foreground); }
    .settings-wrap {
      max-width: 768px;
      margin: 0 auto;
      padding: 24px 24px 96px;
      width: 100%;
    }
    .settings-header { margin-bottom: 24px; }
    .settings-header h1 {
      font-family: var(--heading-font);
      font-size: 20px;
      font-weight: var(--heading-weight);
      letter-spacing: var(--heading-tracking);
      line-height: 28px;
      margin: 0;
      color: var(--foreground);
    }
    .settings-header { position: relative; }
    .settings-header::after {
      content: '';
      display: block;
      width: 60px;
      height: 4px;
      margin-top: var(--space-2);
      border-radius: 2px;
      background: linear-gradient(90deg, var(--primary), transparent);
    }
    .settings-header p {
      font-size: 13px;
      line-height: 19.5px;
      color: var(--muted-foreground);
      margin: 2px 0 0;
    }
  </style>
  <main class="settings-wrap">
    <header class="settings-header">
      <h1>Settings</h1>
      <p>CLI and studio configuration</p>
    </header>

    {#- File-routed view — data pulled inline via ship.* SDK. The
        `live()` directive still subscribes to the legacy SSE endpoint
        for settings-save echo updates. The `{% set %}` rehydration
        lives inside content.html.j2 so SSE re-renders of the partial
        in isolation still have all the variables they need. -#}
    <div id="settings-panel"
         {{ live('settings') }}>
      {% include 'settings/partials/content.html.j2' %}
    </div>
  </main>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
