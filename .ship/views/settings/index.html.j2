{#-
  Settings view -- self-contained shell with Datastar live updates.
  Loaded by the daemon via .ship/views/settings/. The Rust handler
  supplies SettingsCtx (providers, terminal, advanced, about).
-#}
{% from '_ship.html.j2' import head, signal, live, styles %}
{% from '_urls.html.j2' import view_settings_sse %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Settings') }}
  {{ styles() }}
  <style>
  .settings-wrap { max-width: 768px; margin: 0 auto; padding: var(--space-5) var(--space-4) var(--space-8); width: 100%; }
  .settings-header { margin-bottom: var(--space-5); }
  .settings-header h1 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: var(--font-weight-bold); }
  .settings-header p { font-size: var(--text-sm); color: var(--muted-foreground); margin-top: var(--space-1); }
  </style>
</head>
<body>
<div id="settings-root" class="ship-view"
     {{ signal('section', 'all') }}>
  <main class="settings-wrap">
    <header class="settings-header">
      <h1>Settings</h1>
      <p>CLI and studio configuration</p>
    </header>

    <div id="settings-panel"
         {{ live('settings') }}>
      <div id="settings-content">
        <p>Loading...</p>
      </div>
    </div>
  </main>
</div>
</body>
</html>
