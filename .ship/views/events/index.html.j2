{#- SDK gaps:
    - no navigation macro for linking between views
-#}
{#-
  Events browser — live event-stream feed with filter chips and entity groupings.
  The daemon passes rows, types, actors, groups, total as Jinja context.
  Datastar for all interactions. ZERO script tags.
-#}
{% from '_ship.html.j2' import head, signal, show, live, chip, chip_all, search %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Events') }}
  <style>
  .events-wrap { max-width: 960px; margin: 0 auto; padding: var(--space-4); }
  .events-head h1 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: var(--font-weight-semibold); }
  .events-sub { font-size: var(--text-xs); color: var(--muted-foreground); }
  .events-content details { margin-bottom: var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; background: var(--card); }
  .events-content summary { list-style: none; cursor: pointer; padding: var(--space-2) var(--space-3); font-size: var(--text-sm); display: flex; align-items: center; gap: var(--space-2); background: var(--muted); }
  .events-content summary::-webkit-details-marker { display: none; }
  .events-content summary .entity { font-family: var(--font-mono); }
  .events-content summary .count { font-size: var(--text-xs); color: var(--muted-foreground); margin-left: auto; }
  .events-row { display: grid; grid-template-columns: 90px 1fr 140px 140px; gap: var(--space-3); padding: var(--space-2) var(--space-3); border-top: 1px solid var(--border); font-size: var(--text-xs); }
  .events-row .ts, .events-row .id { color: var(--muted-foreground); }
  .events-row .kind, .events-row .id { font-family: var(--font-mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  </style>
</head>
<body>
<div id="events-root" class="ship-view"
     {{ signal('eventType', '') }}
     {{ signal('actor', '') }}
     {{ signal('entity', '') }}
     {{ signal('q', '') }}>
  <div class="events-wrap">
    <div class="events-head">
      <h1>Events</h1>
      <div class="events-sub">{{ total }} events</div>
    </div>

    {# -- Filter chips -- #}
    <ship-toolbar role="group" aria-label="Filter events">
      <ship-chip size="sm" {{ chip_all('eventType', 'events') }}>All types</ship-chip>
      {% for t in types %}
      <ship-chip size="sm" {{ chip('eventType', t, 'events') }}>{{ t }}</ship-chip>
      {% endfor %}
      {% if actors|length > 0 %}
      <ship-separator vertical></ship-separator>
      <ship-chip size="sm" {{ chip_all('actor', 'events') }}>All actors</ship-chip>
      {% for a in actors %}
      <ship-chip size="sm" {{ chip('actor', a, 'events') }}>{{ a }}</ship-chip>
      {% endfor %}
      {% endif %}
      <ship-input size="sm" placeholder="Search events..."
             {{ search('q', 'events') }}></ship-input>
    </ship-toolbar>

    {# -- Content (SSE-driven) -- #}
    <div {{ live('events') }}>
      <div id="events-content" class="events-content">
        <p>Loading...</p>
      </div>
    </div>

  </div>
</div>
</body>
</html>
