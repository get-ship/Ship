{#- Events content — grouped by entity, live-patched over SSE.
   Root element MUST have id="events-content" for Datastar patching.

   Row model (agents-view parity):
   - ship-avatar (sm, identity-hue=actor) replaces the plain actor string so
     identity reads at a glance without widening the row.
   - Flex column layout on the row instead of grid-auto-rows:1fr — rows stretch
     naturally; short payloads don't produce ragged heights.
   - payload preview clamped to 2 lines in the collapsed summary; full payload
     still renders in the <pre> drawer once expanded.
-#}
<div id="events-content" class="events-content">
  {% if groups|length == 0 %}
    <ship-empty-state
      icon="activity"
      title="Waiting for events..."
      body="No events match the current filter yet."></ship-empty-state>
  {% else %}
    {% for g in groups %}
      <details {% if not g.collapsed %}open{% endif %}>
        <summary>
          <span class="entity">{{ g.entity_id }}</span>
          <span class="count">{{ g.count }} event{% if g.count != 1 %}s{% endif %}</span>
        </summary>
        {% for r in g.rows %}
        <details class="events-row-wrap">
          <summary class="events-row">
            <span class="ts">{{ r.timestamp }}</span>
            <span class="kind">{{ r.event_type }}</span>
            <span class="actor-cell">
              <ship-avatar size="sm" identity-hue="{{ r.actor }}" name="{{ r.actor }}"></ship-avatar>
              <span class="actor-name">{{ r.actor }}</span>
            </span>
            <span class="id" title="{{ r.id }}">{{ r.id }}</span>
          </summary>
          <pre>{{ r.payload_pretty }}</pre>
        </details>
        {% endfor %}
      </details>
    {% endfor %}
  {% endif %}
</div>
