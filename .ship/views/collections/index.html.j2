{#-
  Collections — Drizzle-Studio-style collections browser.
  Nav + workspace shell render once; the Rows tab body patches via SSE from
  partials/content.html.j2 whenever collection.item_* events fire.

  CRUD via ship-drawer:
    - New row: opens _newRowDrawer with per-schema inputs
    - Edit row: opens _editDrawer prefilled from clicked row
    - New collection: opens _newCollectionDrawer
-#}
{% from '_ship.html.j2' import head, signal, show, live, styles, tab_panel, on, on_click, on_click_prevent, on_submit, on_change, class_if, attr_if, bind %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Collections') }}</head>
<body>
{% endif %}
{%- set _state = ship.collections.state(active=ship.query.collection | default('')) -%}
{%- set collections = _state.collections -%}
{%- set active_collection = _state.active_collection -%}
{%- set schema = _state.schema -%}
{%- set items = _state.items -%}
{%- set total_items = _state.total_items -%}
{% set sdk_collections = collections %}
{% set active_field_count = 0 %}
{% for c in sdk_collections %}{% if c.id == active_collection %}{% set active_field_count = c.field_count %}{% endif %}{% endfor %}
<div class="ship-view data-view"
     {{ signal('collection', active_collection) }}
     {{ signal('tab', 'rows') }}
     {{ signal('_density', 'cozy') }}
     {{ signal('selected', []) }}
     {{ signal('_page', 1) }}
     {{ signal('_newRowOpen', false) }}
     {{ signal('_editOpen', false) }}
     {{ signal('_editId', '') }}
     {{ signal('_newColOpen', false) }}
     {{ signal('_rowDraft', {}) }}
     {{ signal('_editDraft', {}) }}
     {{ signal('_newColDraft', {id: '', name: '', fields: [{name: 'title', type: 'string', required: true}]}) }}
     {{ signal('_drawerError', '') }}>
  {{ styles() }}
  {% include 'collections/partials/styles.html.j2' %}
  {% include 'collections/partials/workspace-styles.html.j2' %}
  {% include 'collections/partials/table-styles.html.j2' %}

  {% if sdk_collections | length == 0 %}
    {# Empty workspace — no schemas on disk. #}
    <div class="data-index">
      <div class="data-index-head">
        <h1 class="data-index-title">Collections</h1>
        <div class="data-index-sub">
          Typed datasets defined in <span class="mono-snip">.ship/collections/</span>,
          stored in <span class="mono-snip">~/.ship/data.db</span>.
        </div>
        <div class="data-index-actions">
          <ship-button size="sm" tone="accent" variant="solid"
            {{ on_click('$_newColOpen = true') }}>
            <ship-icon slot="leading" name="plus"></ship-icon>New collection
          </ship-button>
        </div>
      </div>
      <ship-empty-state>
        <span slot="title">No collections yet</span>
        <span slot="description">Click "New collection" or drop a .jsonc file in .ship/collections/ to get started.</span>
      </ship-empty-state>
    </div>
  {% elif query.browse == 'index' or active_collection is not defined or schema is not defined %}
    {# Collections index surface — grid of cards. #}
    {% include 'collections/partials/index.html.j2' %}
  {% else %}
    {# Collection workspace — nav + header + tab body. #}
    {% set _is_builtin = active_collection in ['notes', 'feedback', 'annotations'] %}
    <div class="col-workspace no-events">

      {# -- Left nav -- #}
      <aside class="col-nav">
        <div class="col-nav-section">
          <span>Collections</span>
          <span class="col-nav-add" title="New collection"
            {{ on_click('$_newColOpen = true') }} style="cursor:pointer">
            <ship-icon name="plus" size="sm"></ship-icon>
          </span>
        </div>
        {% for c in sdk_collections %}
        <a href="/collections/{{ c.id }}" data-route="/collections/{{ c.id }}"
           class="col-nav-row{% if c.id == active_collection %} is-active{% endif %}"
           {{ on_click_prevent("window.router ? window.router.navigate('/collections/" ~ c.id ~ "') : (location.href = '/collections/" ~ c.id ~ "')") }}>
          <span class="col-nav-icon"><ship-icon name="database" size="sm"></ship-icon></span>
          <span class="col-nav-label">{{ c.name or c.id }}</span>
          <span class="col-nav-count">{{ c.field_count }} field{% if c.field_count != 1 %}s{% endif %}</span>
        </a>
        {% if c.id == active_collection %}
          <div class="col-nav-sub">
            <span class="col-nav-sub-dot"></span>
            <span>Default view</span>
          </div>
        {% endif %}
        {% endfor %}
      </aside>

      {# -- Main workspace pane -- #}
      <div class="col-work-main">

        {# Workspace header — collection identity + tabs + actions. #}
        <div class="col-head">
          <div class="col-head-identity">
            <span class="col-head-icon"><ship-icon name="database" size="sm"></ship-icon></span>
            <span class="col-head-name">{{ schema.name or active_collection }}</span>
            <span class="col-head-id mono-snip">{{ active_collection }}</span>
            <span class="col-head-count">
              {{ items | length if items is defined else 0 }} of {{ items | length if items is defined else 0 }}
            </span>
          </div>
          <div class="col-head-right">
            <ship-segmented size="sm"
              {{ attr_if('$tab', 'value') }}
              {{ on_change('$tab = evt.detail.value') }}>
              <ship-segmented-option value="rows" icon="list-check">Rows</ship-segmented-option>
              <ship-segmented-option value="schema" icon="columns">Schema</ship-segmented-option>
            </ship-segmented>
            <span class="col-head-sep" aria-hidden="true"></span>
            <ship-button size="sm" tone="accent" variant="solid"
              {{ on_click('$_rowDraft = {}; $_newRowOpen = true') }}>
              <ship-icon slot="leading" name="plus"></ship-icon>New row
            </ship-button>
          </div>
        </div>

        {# Rows tab — table body. Data inline via ship.collections.state();
           routed SSE at /api/sse/collections re-renders on item events. #}
        <div {{ tab_panel('tab', 'rows') }} class="col-tab-panel rows-panel"
          {{ class_if("$_density == 'compact'", 'is-dense') }}>
          {% include 'collections/partials/content.html.j2' %}
        </div>

        {# Schema tab #}
        <div {{ tab_panel('tab', 'schema') }} class="col-tab-panel schema-panel">
          <div class="schema-pane"
               {{ signal('_savedAt', 0) }}
               {{ signal('_saveError', '') }}>
            <div class="schema-pane-head">
              <div>
                <h3 class="schema-pane-title">{{ schema.name or active_collection }}</h3>
                <div class="schema-pane-sub mono-snip">
                  {% if _is_builtin %}built-in · defined in crates/core/runtime/src/collections/builtin.rs
                  {%- else -%}.ship/collections/{{ active_collection }}.jsonc{% endif -%}
                </div>
              </div>
              <span class="schema-pane-count">{{ schema.fields | length }} field{% if schema.fields | length != 1 %}s{% endif %}</span>
            </div>

            {% if _is_builtin %}
            <div class="schema-builtin-note">
              <ship-icon name="lock" size="sm"></ship-icon>
              Built-in collections ship with the runtime. Fields are listed below for reference — editing requires a code change + rebuild.
            </div>
            <div class="schema-fields">
              {% for f in schema.fields %}
              <div class="schema-field">
                <span class="ft-badge ft-{{ f[1].field_type }}">{{ f[1].field_type }}</span>
                <span class="schema-field-name mono-snip">{{ f[0] }}</span>
                {% if f[1].required %}<span class="schema-field-req" title="Required">required</span>{% endif %}
                {% if f[1].values %}<span class="schema-field-values mono-snip">{{ f[1].values | join(' | ') }}</span>{% endif %}
              </div>
              {% endfor %}
            </div>
            {% else %}
            {# Editable schema form #}
            {% set _field_json_parts = [] %}
            {% for f in schema.fields %}{% set _field_json_parts = _field_json_parts + [
              '{&quot;name&quot;: &quot;' ~ f[0] ~ '&quot;, &quot;type&quot;: &quot;' ~ f[1].field_type ~ '&quot;, &quot;required&quot;: ' ~ ('true' if f[1].required else 'false') ~ ', &quot;values&quot;: ' ~ (f[1].values | tojson if f[1].values else '[]') ~ '}'
            ] %}{% endfor %}
            <form class="schema-form"
                  {{ signal('schemaDraft', '') }}
                  data-signals:schemaDraft="{id: '{{ active_collection }}', name: '{{ schema.name or active_collection }}', fields: [{{- _field_json_parts | join(', ') -}}]}"
                  {{ on_submit("@put('/api/collections/" ~ active_collection ~ "/schema', {contentType: 'json', body: $schemaDraft}); $_savedAt = Date.now(); $_saveError = ''") }}>
              <div class="schema-edit-table">
                <div class="schema-edit-head">
                  <span>Type</span>
                  <span>Name</span>
                  <span>Required</span>
                  <span>Values (enum)</span>
                  <span></span>
                </div>
                {% for f in schema.fields %}
                <div class="schema-edit-row">
                  <ship-select size="sm" {{ bind('schemaDraft.fields.' ~ loop.index0 ~ '.type') }}>
                    <option value="string">string</option>
                    <option value="markdown">markdown</option>
                    <option value="number">number</option>
                    <option value="boolean">boolean</option>
                    <option value="enum">enum</option>
                    <option value="date">date</option>
                    <option value="file">file</option>
                    <option value="array">array</option>
                    <option value="object">object</option>
                  </ship-select>
                  <ship-input size="sm" {{ bind('schemaDraft.fields.' ~ loop.index0 ~ '.name') }}></ship-input>
                  <label class="schema-edit-check">
                    <input type="checkbox" {{ bind('schemaDraft.fields.' ~ loop.index0 ~ '.required') }}>
                  </label>
                  <ship-input size="sm" placeholder="comma-separated"
                    {{ bind('schemaDraft.fields.' ~ loop.index0 ~ '._valuesCsv') }}
                    {{ attr_if("$schemaDraft.fields[" ~ loop.index0 ~ "].type != 'enum'", 'disabled') }}></ship-input>
                  <ship-button size="sm" variant="ghost" aria-label="Remove field"
                    {{ on_click_prevent('$schemaDraft.fields.splice(' ~ loop.index0 ~ ', 1)') }}>
                    <ship-icon name="trash" size="sm"></ship-icon>
                  </ship-button>
                </div>
                {% endfor %}
              </div>
              <div class="schema-edit-footer">
                <ship-button size="sm" variant="ghost" type="button"
                  {{ on_click_prevent("$schemaDraft.fields.push({name: 'new_field', type: 'string', required: false, values: []})") }}>
                  <ship-icon slot="leading" name="plus"></ship-icon>Add field
                </ship-button>
                <span class="schema-edit-spacer"></span>
                <span class="schema-edit-saved" data-show="$_savedAt > 0">Saved</span>
                <span class="schema-edit-error" data-text="$_saveError" data-show="$_saveError"></span>
                <ship-button size="sm" tone="accent" variant="solid" type="submit">
                  <ship-icon slot="leading" name="check"></ship-icon>Save schema
                </ship-button>
              </div>
            </form>
            {% endif %}
          </div>
        </div>

      </div>
    </div>
  {% endif %}

  {# ── New Row Drawer ─────────────────────────────────────────────────────── #}
  {% if schema is defined %}
  <ship-drawer {{ attr_if('$_newRowOpen ? &quot;&quot; : null', 'open') }} size="md"
    {{ on('ship-close', "$_newRowOpen = false; $_drawerError = ''") }}>
    <span slot="title">New row</span>
    <span slot="description">Add a new item to {{ schema.name or active_collection }}</span>
    <div class="drawer-form">
      {% for f in schema.fields %}
      <div class="drawer-field">
        <label class="drawer-label">
          {{ f[0] }}{% if f[1].required %}<span class="drawer-req">*</span>{% endif %}
          <span class="drawer-type">{{ f[1].field_type }}</span>
        </label>
        {% if f[1].field_type == 'boolean' %}
        <ship-switch {{ bind('_rowDraft.' ~ f[0]) }}></ship-switch>
        {% elif f[1].field_type == 'enum' and f[1].values %}
        <ship-select {{ bind('_rowDraft.' ~ f[0]) }}>
          {% if not f[1].required %}<option value="">— none —</option>{% endif %}
          {% for v in f[1].values %}<option value="{{ v }}">{{ v }}</option>{% endfor %}
        </ship-select>
        {% elif f[1].field_type == 'markdown' %}
        <ship-textarea rows="4" {{ bind('_rowDraft.' ~ f[0]) }}
          placeholder="{{ f[0] }}..."></ship-textarea>
        {% elif f[1].field_type == 'number' %}
        <ship-input type="number" {{ bind('_rowDraft.' ~ f[0]) }}
          placeholder="0"></ship-input>
        {% elif f[1].field_type == 'array' %}
        <ship-input {{ bind('_rowDraft.' ~ f[0]) }}
          placeholder="item1, item2, item3"></ship-input>
        {% else %}
        <ship-input {{ bind('_rowDraft.' ~ f[0]) }}
          placeholder="{{ f[0] }}"
          {%- if f[1].required %} required{% endif %}></ship-input>
        {% endif %}
      </div>
      {% endfor %}
      <div {{ show('$_drawerError') }} class="drawer-error" data-text="$_drawerError"></div>
    </div>
    <div slot="footer">
      <ship-button variant="ghost"
        {{ on_click("$_newRowOpen = false; $_drawerError = ''") }}>Cancel</ship-button>
      <ship-button tone="accent" variant="solid"
        {{ on_click("@post('/api/collections/" ~ active_collection ~ "/items', {contentType: 'json', body: {data: $_rowDraft}}); $_newRowOpen = false; $_rowDraft = {}; $_drawerError = ''") }}>
        Save
      </ship-button>
    </div>
  </ship-drawer>

  {# ── Edit Row Drawer ────────────────────────────────────────────────────── #}
  <ship-drawer {{ attr_if('$_editOpen ? &quot;&quot; : null', 'open') }} size="md"
    {{ on('ship-close', "$_editOpen = false; $_drawerError = ''") }}>
    <span slot="title">Edit row</span>
    <span slot="description" data-text="'Editing ' + $_editId"></span>
    <div class="drawer-form">
      {% for f in schema.fields %}
      <div class="drawer-field">
        <label class="drawer-label">
          {{ f[0] }}{% if f[1].required %}<span class="drawer-req">*</span>{% endif %}
          <span class="drawer-type">{{ f[1].field_type }}</span>
        </label>
        {% if f[1].field_type == 'boolean' %}
        <ship-switch {{ bind('_editDraft.' ~ f[0]) }}></ship-switch>
        {% elif f[1].field_type == 'enum' and f[1].values %}
        <ship-select {{ bind('_editDraft.' ~ f[0]) }}>
          {% if not f[1].required %}<option value="">— none —</option>{% endif %}
          {% for v in f[1].values %}<option value="{{ v }}">{{ v }}</option>{% endfor %}
        </ship-select>
        {% elif f[1].field_type == 'markdown' %}
        <ship-textarea rows="4" {{ bind('_editDraft.' ~ f[0]) }}
          placeholder="{{ f[0] }}..."></ship-textarea>
        {% elif f[1].field_type == 'number' %}
        <ship-input type="number" {{ bind('_editDraft.' ~ f[0]) }}
          placeholder="0"></ship-input>
        {% elif f[1].field_type == 'array' %}
        <ship-input {{ bind('_editDraft.' ~ f[0]) }}
          placeholder="item1, item2, item3"></ship-input>
        {% else %}
        <ship-input {{ bind('_editDraft.' ~ f[0]) }}
          placeholder="{{ f[0] }}"></ship-input>
        {% endif %}
      </div>
      {% endfor %}
      <div {{ show('$_drawerError') }} class="drawer-error" data-text="$_drawerError"></div>
    </div>
    <div slot="footer">
      <ship-button tone="destructive" variant="soft" style="margin-right:auto"
        {{ on_click("if(confirm('Delete this row?')) { @delete('/api/collections/" ~ active_collection ~ "/items/' + $_editId); $_editOpen = false; $_drawerError = '' }") }}>
        Delete
      </ship-button>
      <ship-button variant="ghost"
        {{ on_click("$_editOpen = false; $_drawerError = ''") }}>Cancel</ship-button>
      <ship-button tone="accent" variant="solid"
        {{ on_click("@put('/api/collections/" ~ active_collection ~ "/items/' + $_editId, {contentType: 'json', body: {data: $_editDraft}}); $_editOpen = false; $_drawerError = ''") }}>
        Save
      </ship-button>
    </div>
  </ship-drawer>
  {% endif %}

  {# ── New Collection Drawer ──────────────────────────────────────────────── #}
  <ship-drawer {{ attr_if('$_newColOpen ? &quot;&quot; : null', 'open') }} size="md"
    {{ on('ship-close', "$_newColOpen = false; $_drawerError = ''") }}>
    <span slot="title">New collection</span>
    <span slot="description">Define a typed dataset stored in data.db</span>
    <div class="drawer-form">
      <div class="drawer-field">
        <label class="drawer-label">
          Collection ID <span class="drawer-req">*</span>
          <span class="drawer-type">snake_case</span>
        </label>
        <ship-input {{ bind('_newColDraft.id') }} placeholder="my_collection" required
          style="font-family: var(--font-mono)"></ship-input>
      </div>
      <div class="drawer-field">
        <label class="drawer-label">Display name</label>
        <ship-input {{ bind('_newColDraft.name') }} placeholder="My Collection"></ship-input>
      </div>
      <div class="drawer-field-group-label">Fields</div>
      <div class="schema-edit-table">
        <div class="schema-edit-head">
          <span>Type</span>
          <span>Name</span>
          <span>Required</span>
          <span></span>
        </div>
        <div id="new-col-fields-placeholder">
          {# Fields rendered via _newColDraft signal — at minimum one #}
          <div class="schema-edit-row">
            <ship-select size="sm" {{ bind('_newColDraft.fields.0.type') }}>
              <option value="string">string</option>
              <option value="markdown">markdown</option>
              <option value="number">number</option>
              <option value="boolean">boolean</option>
              <option value="enum">enum</option>
              <option value="date">date</option>
              <option value="array">array</option>
              <option value="object">object</option>
            </ship-select>
            <ship-input size="sm" {{ bind('_newColDraft.fields.0.name') }}></ship-input>
            <label class="schema-edit-check">
              <input type="checkbox" {{ bind('_newColDraft.fields.0.required') }}>
            </label>
            <ship-button size="sm" variant="ghost" aria-label="Remove field"
                         {{ attr_if('$_newColDraft.fields.length <= 1', 'disabled') }}
                         {{ on_click('$_newColDraft.fields.splice(0, 1)') }}>
              <ship-icon name="trash" size="sm"></ship-icon>
            </ship-button>
          </div>
        </div>
      </div>
      <div {{ show('$_drawerError') }} class="drawer-error" data-text="$_drawerError"></div>
    </div>
    <div slot="footer">
      <ship-button variant="ghost"
        {{ on_click("$_newColOpen = false; $_drawerError = ''") }}>Cancel</ship-button>
      <ship-button tone="accent" variant="solid"
        {{ on_click("@post('/api/collections', {contentType: 'json', body: {id: $_newColDraft.id, name: $_newColDraft.name, fields: Object.fromEntries($_newColDraft.fields.map(f => [f.name, {type: f.type, required: f.required}]))}}); $_newColOpen = false; window.router && window.router.navigate('/collections/' + $_newColDraft.id)") }}>
        Create collection
      </ship-button>
    </div>
  </ship-drawer>

</div>
{% if not fragment %}
</body>
</html>
{% endif %}
