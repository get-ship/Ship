{#-
  Rows tab body — sticky-id Drizzle-style table. Root element must keep
  id="data-content" so the generic SSE handler can patch it on every
  collection.item_* event.
-#}
{% from '_ship.html.j2' import on_click %}
{% set item_total = items | length if items is defined else 0 %}
<div id="data-content">
  {% if schema is defined and items is defined and items | length > 0 %}
  <div class="tbl-wrap">
    <ship-table variant="native" sticky-header sticky-first-col gutter>
      <table class="tbl">
        <colgroup>
          <col class="cg-gutter">
          <col class="cg-sticky">
          {% for _f in schema.fields %}<col class="cg-field">{% endfor %}
          <col class="cg-time">
        </colgroup>
        <thead>
          <tr>
            <th class="th-sticky" scope="col">
              <span class="th-inner">
                <span class="ft-badge ft-string">string</span>
                <span class="fname">id</span>
                <span class="sort-ind" aria-label="sorted ascending">↑</span>
              </span>
            </th>
            {% for field_name, field_def in schema.fields %}
            <th scope="col">
              <span class="th-inner">
                <span class="ft-badge ft-{{ field_def.field_type }}">{{ field_def.field_type }}</span>
                <span class="fname">{{ field_name }}</span>
                {% if field_def.required %}<span class="req">*</span>{% endif %}
              </span>
            </th>
            {% endfor %}
            <th scope="col" class="th-updated">
              <span class="th-inner">
                <span class="ft-badge ft-timestamp">time</span>
                <span class="fname">updated</span>
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          {% for item in items %}
          <tr data-row-id="{{ item.id }}">
            <td class="td-sticky mono-snip id-cell" title="{{ item.id }}"
              data-item-id="{{ item.id }}"
              data-item-data="{{ item.data | to_attr_json }}"
              {{ on_click('$_editId = evt.currentTarget.dataset.itemId; try { $_editDraft = JSON.parse(evt.currentTarget.dataset.itemData) } catch(_e) { $_editDraft = {} }; $_editOpen = true') }}
              style="cursor:pointer" tabindex="0" role="button" aria-label="Edit row {{ item.id }}">
              {{ item.id[:12] }}{% if item.id | length > 12 %}…{% endif %}
            </td>
            {% for field_name, field_def in schema.fields %}
            <td class="{% if field_name == 'title' %}title-cell{% endif %}">
              {% set val = item.data[field_name] if item.data[field_name] is defined else none %}
              {% if val is none or val == "" %}
                <span class="td-null">—</span>
              {% elif field_def.field_type == "enum" %}
                <ship-chip>{{ val }}</ship-chip>
              {% elif field_def.field_type == "boolean" %}
                <ship-badge variant="{{ 'success' if val else 'secondary' }}">{{ "yes" if val else "no" }}</ship-badge>
              {% elif field_def.field_type == "number" %}
                <span class="mono-snip td-num">{{ val }}</span>
              {% elif field_def.field_type == "array" and val is iterable and val is not string %}
                {% for v in val[:3] %}<ship-chip>{{ v }}</ship-chip>{% if not loop.last %} {% endif %}{% endfor %}
                {% if val | length > 3 %}<ship-badge variant="secondary">+{{ val | length - 3 }}</ship-badge>{% endif %}
              {% else %}
                <span class="td-text">{{ val }}</span>
              {% endif %}
            </td>
            {% endfor %}
            <td class="mono-snip td-time">{{ item.updated_at[:16] if item.updated_at else "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </ship-table>
  </div>

  <div class="tbl-footer">
    <span class="tbl-footer-live">
      <span class="tbl-footer-dot"></span>
      live · <span class="mono-snip">collection.item_*</span>
    </span>
    <span class="tbl-footer-spacer"></span>
    <span>{{ item_total }} items</span>
  </div>

  {% elif schema is defined %}
  <ship-empty-state>
    <span slot="title">No items in {{ schema.name or active_collection }}</span>
    <span slot="description">Click "New row" to create the first item.</span>
  </ship-empty-state>
  {% else %}
  <ship-empty-state>
    <span slot="title">No collections defined</span>
    <span slot="description">Add a schema to .ship/collections/</span>
  </ship-empty-state>
  {% endif %}
</div>
