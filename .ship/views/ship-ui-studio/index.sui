<state name="sui"        value="[]" />
<state name="views"      value="[]" />
<state name="loading"    value="true" />
<state name="filterKind" value="'all'" />
<state name="filterText" value="''" />

<div class="studio">
  <aside class="studio-sidebar">
    <div class="studio-sidebar-header">
      <span class="studio-brand-mark" aria-hidden="true">◐</span>
      <span class="studio-sidebar-title">SUI Studio</span>
    </div>

    <input
      class="studio-search"
      type="search"
      placeholder="Search components…"
      value={filterText()}
      on:input={(e) => filterText.set(e.target.value)}
      autocomplete="off"
      spellcheck="false"
    />

    <div class="studio-filter" role="tablist">
      <button class="studio-filter-pill" data-active={filterKind() === 'all'} on:click={() => filterKind.set('all')}>All</button>
      <button class="studio-filter-pill" data-active={filterKind() === 'sui'} on:click={() => filterKind.set('sui')}>Components</button>
      <button class="studio-filter-pill" data-active={filterKind() === 'view'} on:click={() => filterKind.set('view')}>Views</button>
    </div>

    <div class="studio-sidebar-counts">
      <span class="studio-count-text">{filteredCount()} of {totalCount()}</span>
    </div>
  </aside>

  <main class="studio-main">
    {#if loading()}
      <div class="studio-loading">
        <sui-spinner size="md"></sui-spinner>
        <p class="studio-loading-text">Loading catalog</p>
      </div>
    {:else if filtered().length === 0}
      <sui-empty-state size="lg">
        <span slot="title">Nothing matches</span>
        <span slot="description">Try a different filter or search term.</span>
      </sui-empty-state>
    {:else}
      <div class="tile-grid" data-test="grid">
        {#for item of filtered() key={item.id}}
          <a class="tile" href={'/ship-ui-studio/' + item.id} data-test="tile">
            <div class="tile-head">
              <code class="tile-name">{item.id}</code>
              <sui-badge tone={item.kind === 'sui' ? 'primary' : 'info'} variant="soft" size="sm">{item.kind}</sui-badge>
            </div>
            {#if item.description}
              <p class="tile-desc">{item.description}</p>
            {/if}
          </a>
        {/for}
      </div>
    {/if}
  </main>
</div>
