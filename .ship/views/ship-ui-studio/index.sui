<state name="lit"        value="[]" />
<state name="sui"        value="[]" />
<state name="views"      value="[]" />
<state name="loading"    value="true" />
<state name="filterKind" value="'all'" />
<state name="filterText" value="''" />

<div class="studio">
  <aside class="studio-sidebar">
    <div class="studio-sidebar-header">
      <ship-icon name="columns" size="sm"></ship-icon>
      <span class="studio-sidebar-title">UI Studio</span>
    </div>

    <div class="studio-sidebar-search">
      <ship-input placeholder="Search components..." size="sm" value={filterText()} on:ship-input={(e) => filterText.set(e.detail.value)}></ship-input>
    </div>

    <div class="studio-sidebar-filters">
      <ship-segmented value={filterKind()} size="sm" on:ship-change={(e) => filterKind.set(e.detail.value)}>
        <ship-segmented-option value="all">All</ship-segmented-option>
        <ship-segmented-option value="lit">Lit</ship-segmented-option>
        <ship-segmented-option value="sui">SUI</ship-segmented-option>
        <ship-segmented-option value="view">Views</ship-segmented-option>
      </ship-segmented>
    </div>

    <div class="studio-sidebar-counts">
      <span class="studio-count-badge">
        {totalCount()} total
      </span>
    </div>
  </aside>

  <main class="studio-main">
    {#if loading()}
      <div class="studio-loading">
        <ship-spinner size="md"></ship-spinner>
        <p class="studio-loading-text">Loading catalog…</p>
      </div>
    {:else if filtered().length === 0}
      <ship-empty-state icon="search" variant="default" size="lg">
        <span slot="title">Nothing matches</span>
        <span slot="description">Try a different filter or search term.</span>
      </ship-empty-state>
    {:else}
      <div class="tile-grid" data-test="grid">
        {#for item of filtered() key={item.id}}
          <div class="tile" data-test="tile" on:click={() => window.ship?.navigate('/ship-ui-studio/' + item.id)}>
            <div class="tile-head">
              <code class="tile-name">{item.id}</code>
              <ship-badge tone={item.kind === 'lit' ? 'primary' : item.kind === 'sui' ? 'accent' : 'muted'} variant="soft" size="sm">{item.kind}</ship-badge>
            </div>
            {#if item.description}
              <p class="tile-desc">{item.description}</p>
            {/if}
          </div>
        {/for}
      </div>
    {/if}
  </main>
</div>
