<!-- Sidebar fragment — content is inlined in index.sui.
     Kept here as a documentation artifact showing the sidebar structure. -->
<aside class="studio-sidebar">
  <div class="studio-sidebar-header">
    <ship-icon name="columns" size="sm"></ship-icon>
    <span class="studio-sidebar-title">UI Studio</span>
  </div>

  <div class="studio-sidebar-search">
    <ship-input placeholder="Search components..." size="sm"></ship-input>
  </div>

  <div class="studio-sidebar-filters">
    <ship-segmented size="sm">
      <ship-segmented-option value="all">All</ship-segmented-option>
      <ship-segmented-option value="lit">Lit</ship-segmented-option>
      <ship-segmented-option value="sui">SUI</ship-segmented-option>
      <ship-segmented-option value="view">Views</ship-segmented-option>
    </ship-segmented>
  </div>
</aside>
