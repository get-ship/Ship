{#- Skills section. Context: agent (AgentDetail).
    Parity: apps/web/src/features/agents/sections/SkillsSection.tsx -#}
<section id="section-skills" class="ad-section">
  <div class="ad-section-head">
    <h2 class="ad-section-label">
      <svg class="ad-section-icon" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
      </svg>
      Skills
      <span class="ad-section-count">{{ agent.skills | length }} attached</span>
    </h2>
    <button class="ad-section-action" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add
    </button>
  </div>
  {% if agent.skills | length == 0 %}
    <div class="ad-empty">
      No skills attached. Edit
      <code style="font-family:var(--font-mono);font-size:11px">.ship/agents/{{ agent.id }}.jsonc</code>
      to add one.
    </div>
  {% else %}
    <div class="ad-chip-grid">
      {% for skill in agent.skills %}
        <div class="ad-chip">
          <span class="ad-chip-icon ad-chip-icon--skill">{{ skill[:2] }}</span>
          <div class="ad-chip-body">
            <div class="ad-chip-name">{{ skill }}</div>
            <div class="ad-chip-meta">project</div>
          </div>
        </div>
      {% endfor %}
      <button class="ad-add-chip" disabled>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Add skill
      </button>
    </div>
  {% endif %}
</section>
