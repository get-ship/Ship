{#- Skills section. Context: agent (AgentDetail).
    Hand-wrapped ship-card — the section() macro doesn't support an
    action-button slot in the header.
    Parity: apps/web/src/features/agents/sections/SkillsSection.tsx -#}
<ship-card padding="none" id="section-skills">
  <div slot="header" class="ad-section-head">
    <h2 class="ad-section-title">
      <ship-icon name="zap"></ship-icon>
      Skills
      <span class="ad-section-count">{{ agent.skills | length }} attached</span>
    </h2>
    <ship-button variant="outline" size="sm" disabled>
      <ship-icon slot="leading" name="plus"></ship-icon>
      Add
    </ship-button>
  </div>
  <div class="ad-section-body">
    {% if agent.skills | length == 0 %}
      <div class="ad-empty">
        No skills attached. Edit
        <code style="font-family:var(--font-mono);font-size:var(--text-xs)">.ship/agents/{{ agent.id }}.jsonc</code>
        to add one.
      </div>
    {% else %}
      <div class="ad-chip-grid">
        {% for skill in agent.skills %}
          <ship-list-tile variant="card" density="compact">
            <span slot="leading" class="ad-chip-icon ad-chip-icon--skill">{{ skill[:2] }}</span>
            <span class="ad-chip-name">{{ skill }}</span>
            <span slot="meta" class="ad-chip-meta">project</span>
          </ship-list-tile>
        {% endfor %}
        <button type="button" class="ad-add-chip" disabled>
          <ship-icon name="plus"></ship-icon>
          Add skill
        </button>
      </div>
    {% endif %}
  </div>
</ship-card>
