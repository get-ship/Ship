{#- Skills tab panel. Context: agent (AgentDetail). -#}
<ship-tab-panel name="skills">
  <div class="ad-panel">
    <div class="ad-section-head">
      <h2 class="ad-section-title">
        <ship-icon name="sparkles" size="sm"></ship-icon>
        Skills
        <span class="ad-section-count">{{ agent.skills | length }} attached</span>
      </h2>
      <ship-button size="sm" variant="ghost" disabled>
        <ship-icon slot="leading" name="plus"></ship-icon>
        Add skill
      </ship-button>
    </div>
    {% if agent.skills | length == 0 %}
      <div class="ad-empty">
        No skills attached. Edit <code style="font-family:var(--font-mono);font-size:11px">.ship/agents/{{ agent.id }}.jsonc</code> to add one.
      </div>
    {% else %}
      <div class="ad-chip-grid">
        {% for skill in agent.skills %}
          <span class="ad-item-chip">
            <span class="lead">{{ skill[:2] }}</span>
            {{ skill }}
          </span>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</ship-tab-panel>
