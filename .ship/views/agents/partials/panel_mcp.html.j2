{#- MCP Servers section. Context: agent (AgentDetail).
    Parity: apps/web/src/features/agents/sections/McpSection.tsx -#}
<section id="section-mcp" class="ad-section">
  <div class="ad-section-head">
    <h2 class="ad-section-label">
      <svg class="ad-section-icon" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round">
        <rect width="7" height="7" x="3" y="3" rx="1"/>
        <rect width="7" height="7" x="14" y="3" rx="1"/>
        <rect width="7" height="7" x="14" y="14" rx="1"/>
        <rect width="7" height="7" x="3" y="14" rx="1"/>
      </svg>
      MCP Servers
      <span class="ad-section-count">{{ agent.mcp_servers | length }} attached</span>
    </h2>
    <button class="ad-section-action" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add
    </button>
  </div>
  {% if agent.mcp_servers | length == 0 %}
    <div class="ad-empty">
      No MCP servers connected. Add one in the agent profile.
    </div>
  {% else %}
    <div class="ad-chip-grid">
      {% for server in agent.mcp_servers %}
        <div class="ad-chip">
          <span class="ad-chip-icon ad-chip-icon--mcp">{{ server[:2] }}</span>
          <div class="ad-chip-body">
            <div class="ad-chip-name">{{ server }}</div>
            <div class="ad-chip-meta">server</div>
          </div>
        </div>
      {% endfor %}
      <button class="ad-add-chip" disabled>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Add server
      </button>
    </div>
  {% endif %}
</section>
