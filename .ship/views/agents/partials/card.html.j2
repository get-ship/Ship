{#- One agent card. Context: `a` = AgentSummary.
    ship-list-tile variant=card supplies surface chrome (border, radius,
    hover lift, shadow). navigable renders an <a href> so cmd/middle-click
    open in a new tab — the whole tile is the click target, so no
    trailing chevron is needed (a static arrow that does nothing on click
    reads as a misleading affordance).
    ship-avatar is rendered as a rounded orange square (tone=primary,
    shape=square) for the pre-migration brand treatment. Primary slot
    holds the vertical stack: name, description, stats row, source badge
    — stacked view-locally because the tile's meta slot flex-rows its
    children at 10px font.
    Matches: apps/web/src/routes/studio/agents/index.tsx L141-203.

    agent.icon handling (template-only, schema field already exists):
      - "simpleicons:<slug>"  → ship-avatar icon-slug=<slug>
      - short string (≤3)     → literal initials
      - longer string         → ship-icon registry name (future)
      - empty/undefined       → first-letter initials (a.letter)
    In every branch the tile stays orange + square so the grid reads
    consistently even when a subset of agents provide branded icons. -#}
{% set _icon_raw = a.icon if a.icon is defined else '' %}
{% set _icon_s = _icon_raw | string %}
{#- MiniJinja lacks `.startswith`; use the slice trick: `s[:N] == prefix`.
    `simpleicons:` is 12 chars. -#}
{% set _is_simpleicons = _icon_s and _icon_s[:12] == 'simpleicons:' %}
{% set _slug = _icon_s[12:] if _is_simpleicons else '' %}
{% set _is_short = (not _is_simpleicons) and _icon_s and _icon_s|length <= 3 %}
{% set _is_registry = (not _is_simpleicons) and _icon_s and _icon_s|length > 3 %}
<ship-list-tile variant="card" density="normal" interactive
                navigable="/agents/{{ a.id }}"
                class="agents-card-tile">
  {% if _is_simpleicons and _slug %}
    <ship-avatar slot="leading" size="lg" tone="primary" shape="square"
                 icon-slug="{{ _slug }}" name="{{ a.name }}"></ship-avatar>
  {% elif _is_short %}
    <ship-avatar slot="leading" size="lg" tone="primary" shape="square"
                 initials="{{ _icon_s }}" name="{{ a.name }}"></ship-avatar>
  {% elif _is_registry %}
    {#- Registry name — render ship-icon centered inside a manually-
        styled square tile so the tone/shape treatment matches. -#}
    <span slot="leading" class="agents-card-icon-tile" aria-label="{{ a.name }}">
      <ship-icon name="{{ _icon_s }}" size="md"></ship-icon>
    </span>
  {% else %}
    <ship-avatar slot="leading" size="lg" tone="primary" shape="square"
                 initials="{{ a.letter }}" name="{{ a.name }}"></ship-avatar>
  {% endif %}
  <div class="agents-card-body">
    <div class="agents-card-head">
      <div class="agents-card-title">{{ a.name }}</div>
      <p class="agents-card-desc">{{ a.description or "No description" }}</p>
    </div>
    <div class="agents-card-stats">
      <span>{{ a.skills_count }} skill{% if a.skills_count != 1 %}s{% endif %}</span>
      <span class="agents-card-sep">&middot;</span>
      <span>{{ a.mcp_count }} MCP</span>
      <span class="agents-card-sep">&middot;</span>
      <span>{{ a.rules_count }} rule{% if a.rules_count != 1 %}s{% endif %}</span>
    </div>
    <div class="agents-card-badges">
      <ship-badge tone="muted" variant="outline" size="sm" class="agents-card-badge-source">{{ a.source }}</ship-badge>
    </div>
  </div>
</ship-list-tile>
