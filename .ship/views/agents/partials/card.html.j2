{#- One agent card. Context: `a` = AgentSummary.
    ship-list-tile variant=card supplies surface chrome (border, radius,
    hover lift, shadow). navigable renders an <a href> so cmd/middle-click
    open in a new tab. ship-avatar (size=lg → 40px) supplies the gradient
    tile in the leading slot. Primary slot holds the vertical stack:
    name, description, stats row, source badge — stacked view-locally
    because the tile's meta slot flex-rows its children at 10px font.
    Matches: apps/web/src/routes/studio/agents/index.tsx L141-203. -#}
<ship-list-tile variant="card" density="normal" interactive
                navigable="/agents/{{ a.id }}"
                class="agents-card-tile">
  <ship-avatar slot="leading" size="lg" initials="{{ a.letter }}" name="{{ a.name }}"></ship-avatar>
  <div class="agents-card-body">
    <div class="agents-card-head">
      <div class="agents-card-title">{{ a.name }}</div>
      <p class="agents-card-desc">{{ a.description or "No description" }}</p>
    </div>
    <div class="agents-card-stats">
      <span>{{ a.skills_count }} skill{% if a.skills_count != 1 %}s{% endif %}</span>
      <span class="agents-card-sep">&middot;</span>
      <span>{{ a.mcp_count }} MCP</span>
      <span class="agents-card-sep">&middot;</span>
      <span>{{ a.rules_count }} rule{% if a.rules_count != 1 %}s{% endif %}</span>
    </div>
    <div class="agents-card-badges">
      <ship-badge tone="muted" variant="outline" size="sm" class="agents-card-badge-source">{{ a.source }}</ship-badge>
    </div>
  </div>
  <ship-icon slot="trailing" class="agents-card-arrow" name="arrow-right" tone="muted"></ship-icon>
</ship-list-tile>
