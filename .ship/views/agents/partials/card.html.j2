{#- One agent card. Context: `a` = AgentSummary.
    Renders as a plain <a> element with hover border tint.
    Matches: apps/web/src/routes/studio/agents/index.tsx L141-203. -#}
{% from '_ship.html.j2' import nav %}
<a class="agent-card" href="javascript:void(0)" {{ nav('/agents/' ~ a.id) }}>
  <div class="agent-card-head">
    <div class="agent-avatar">{{ a.letter }}</div>
    <div class="agent-card-body">
      <div class="agent-name">{{ a.name }}</div>
      <p class="agent-desc">{{ a.description or "No description" }}</p>
    </div>
    <ship-icon class="agent-arrow" name="arrow-right" tone="muted"></ship-icon>
  </div>
  <div class="agent-stats">
    <span>{{ a.skills_count }} skill{% if a.skills_count != 1 %}s{% endif %}</span>
    <span class="agent-stats-sep">&middot;</span>
    <span>{{ a.mcp_count }} MCP</span>
    <span class="agent-stats-sep">&middot;</span>
    <span>{{ a.rules_count }} rule{% if a.rules_count != 1 %}s{% endif %}</span>
  </div>
  <div class="agent-badges">
    <span class="agent-badge agent-badge--project">{{ a.source }}</span>
  </div>
</a>
