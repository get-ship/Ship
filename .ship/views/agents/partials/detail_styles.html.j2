{#- Detail page styles — every retained rule is justified inline:
    either an element gap, a view-specific identity concern, or layout
    glue around ship-list-tile / ship-card compositions. -#}
<style>
/* View shell owns height/scroll — the daemon view sits inside the shell's
   main panel but the detail page provides its own sticky header + scroll
   body (matches React parity). */
.ad-view {
  color: var(--foreground);
  font-family: var(--font-body);
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
}

/* Sticky header — avatar + name + version + delete. No ship-element
   covers "detail page sticky header with backdrop blur". The ship-button
   primitives handle the back + delete controls; the row chrome is
   view-local. */
.ad-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  border-bottom: 1px solid var(--border);
  background: color-mix(in oklch, var(--background) 80%, transparent);
  backdrop-filter: saturate(160%) blur(var(--space-2));
  -webkit-backdrop-filter: saturate(160%) blur(var(--space-2));
  padding: 0 var(--space-5);
  height: 48px;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
}
/* Header name typography — display-family bold at 14px is the React
   parity. ship-list-tile's primary slot is sans-medium-base. */
.ad-name {
  font-family: var(--font-display); font-size: 14px; font-weight: var(--font-weight-bold);
  color: var(--foreground); overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; margin: 0;
}
/* Version tag — tabular-nums, right-aligned before the spacer. No
   ship-element covers "version chip next to heading". */
.ad-version {
  font-size: 10px; color: var(--muted-foreground);
  font-variant-numeric: tabular-nums;
}
@media (max-width: 639px) { .ad-version { display: none; } }
.ad-header-spacer { flex: 1; }

/* Scrollable body — section cards stack with gap via .s-sections. */
.ad-body { flex: 1; overflow-y: auto; overflow-x: hidden; padding: var(--space-5); }

/* Vertical rhythm between stacked section cards. The section() macro
   emits <ship-card> siblings; without a gap they bump up against each
   other. Mirrors the settings view's .s-sections pattern. */
.ad-sections { display: flex; flex-direction: column; gap: var(--space-4); }

/* Section body padding — ship-card is padding="none" and the card
   provides a header-divider via slot=header. Body uses 16px left/right
   and 16px bottom to match React parity; top is 0 because the header
   divider supplies the visual separation. */
.ad-section-body { padding: 0 var(--space-5) var(--space-4); }

/* Hand-wrapped section header (used for sections whose header carries
   an action button, which section() macro doesn't cover). Visually
   mirrors the macro's inline-styled header exactly — 16/20 padding
   matches the section() macro's inline header. */
.ad-section-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--space-3); padding: var(--space-4) var(--space-5);
  width: 100%; box-sizing: border-box;
}
.ad-section-title {
  display: flex; align-items: center; gap: var(--space-2);
  margin: 0;
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--muted-foreground);
}
.ad-section-title ship-icon {
  color: var(--muted-foreground);
  width: 16px; height: 16px;
}
/* Count pill — subtle muted-foreground text next to title. The React
   parity shows "N attached" / "N rules" at reduced opacity. */
.ad-section-count {
  font-size: var(--text-xs); font-weight: var(--font-weight-normal);
  color: var(--muted-foreground); opacity: 0.7;
}

/* Chip grid — Skills and MCP sections use a wrap-grid of fixed-min
   ship-list-tile cards. No ship-element covers a responsive wrap grid
   of tile-cards. */
.ad-chip-grid { display: flex; flex-wrap: wrap; gap: var(--radius-md); }
.ad-chip-grid > ship-list-tile { min-width: 180px; flex: 0 1 auto; }

/* Chip icon — colored square with 2-letter abbreviation. The React
   parity uses primary-tinted tiles for skills and blue-tinted for MCP.
   ship-avatar uses a primary/accent gradient which doesn't match the
   solid tinted-square treatment. Kept view-local. */
.ad-chip-icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; border-radius: var(--radius-lg);
  font-size: 10px; font-weight: var(--font-weight-semibold);
  text-transform: uppercase; flex-shrink: 0;
}
.ad-chip-icon--skill {
  background: color-mix(in oklch, var(--primary) 10%, transparent);
  color: var(--primary);
}
.ad-chip-icon--mcp {
  background: color-mix(in oklch, oklch(0.55 0.2 260) 10%, transparent);
  color: oklch(0.55 0.2 260);
}
/* Tile primary override — 12px medium-weight name + 10px muted meta.
   ship-list-tile defaults to 14px medium in primary and 10px muted in
   secondary; the font size mostly aligns, but name needs 12px to match
   the React parity exactly. */
.ad-chip-name {
  font-size: 12px; font-weight: var(--font-weight-medium);
  color: var(--foreground);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ad-chip-meta { font-size: 10px; color: var(--muted-foreground); opacity: 0.6; }

/* "Add" dashed-border placeholder chip — matches React parity.
   ship-button's variant="ghost" is opaque bg with hover tint; this
   placeholder needs a dashed border. No ship-element covers this
   shape (candidate: ship-button variant="dashed" or ship-add-tile). */
.ad-add-chip {
  display: inline-flex; align-items: center; justify-content: center;
  gap: var(--space-1); min-width: 120px; padding: var(--space-2) var(--space-3);
  border: 1px dashed color-mix(in oklch, var(--border) 60%, transparent);
  border-radius: var(--radius-lg); background: transparent;
  color: color-mix(in oklch, var(--muted-foreground) 50%, transparent);
  font-size: var(--text-xs); cursor: pointer; transition: all var(--duration-fast) var(--ease-out);
  font-family: inherit;
}
.ad-add-chip:hover { border-color: var(--primary); color: var(--primary); }
.ad-add-chip ship-icon { width: 14px; height: 14px; }

/* Permissions preset row — 3 radio-style cards. Uses ship-button with
   role=radio; button sizes itself via text content, but the preset cells
   need equal-flex + stacked label/description which ship-button doesn't
   support. Kept view-local. (Candidate: ship-radio-tile primitive.) */
.ad-preset-row { display: flex; gap: var(--radius-md); margin-bottom: var(--space-3); }
.ad-preset-btn {
  flex: 1; display: flex; flex-direction: column; gap: var(--space-1);
  padding: var(--space-3);
  border: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  border-radius: var(--radius-lg);
  background: color-mix(in oklch, var(--card) 30%, transparent);
  color: color-mix(in oklch, var(--muted-foreground) 60%, transparent);
  cursor: pointer; text-align: left; transition: all var(--duration-fast) var(--ease-out);
  font-family: inherit;
}
.ad-preset-btn:hover {
  border-color: color-mix(in oklch, var(--primary) 30%, transparent);
}
.ad-preset-btn[aria-checked="true"] {
  border-color: var(--primary); color: var(--primary);
  background: color-mix(in oklch, var(--primary) 5%, transparent);
}
.ad-preset-label {
  display: flex; align-items: center; gap: var(--radius-md);
  font-size: var(--text-xs); font-weight: var(--font-weight-medium);
}
.ad-preset-label ship-icon { width: 14px; height: 14px; }
.ad-preset-desc { font-size: 9px; opacity: 0.6; margin: 0; line-height: 1.4; }

/* Permission cards grid — 3 equal columns: allow/ask/deny. Each card has
   a colored header (green/yellow/red) and a list. No ship-element covers
   "status-tinted list card with header". Kept view-local. */
.ad-perm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
@media (max-width: 767px) {
  .ad-preset-row { flex-direction: column; }
  .ad-perm-grid { grid-template-columns: 1fr; }
}
.ad-perm-card {
  padding: var(--space-3);
  border: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
  border-radius: var(--radius-lg);
  background: color-mix(in oklch, var(--card) 30%, transparent);
}
.ad-perm-card-head {
  display: flex; align-items: center; gap: var(--radius-md);
  font-size: var(--text-xs); font-weight: var(--font-weight-medium); color: var(--foreground);
  margin-bottom: var(--radius-md);
}
.ad-perm-card-head ship-icon { width: 14px; height: 14px; }
.ad-perm-card-head--allow { color: oklch(0.55 0.2 155); }
.ad-perm-card-head--ask { color: oklch(0.65 0.16 70); }
.ad-perm-card-head--deny { color: var(--destructive); }
.ad-perm-card-list {
  font-size: var(--text-xs); color: var(--muted-foreground);
  margin: 0; line-height: 1.5;
}
.ad-perm-none { font-style: italic; opacity: 0.5; }

/* Rules row — list of ship-list-tile rows with the rule name in primary
   (mono) and an edit ship-button in trailing. The mono-styled primary
   needs a view-local override because ship-list-tile's primary is sans. */
.ad-rule-name {
  font-family: var(--font-mono); font-size: var(--text-xs);
  color: oklch(0.6 0.18 240); background: var(--muted);
  padding: 2px var(--space-2); border-radius: var(--radius-sm);
  font-weight: var(--font-weight-normal);
}
.ad-rule-preview {
  font-size: var(--text-xs);
  color: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* Providers grid — responsive 2-col (single col on narrow). Cards show
   a colored logo + name + status dot. Uses ship-list-tile variant=card
   density=compact for chrome; provider logo is a view-local colored tile
   because ship-avatar's gradient doesn't mirror the muted-gray solid. */
.ad-provider-grid {
  display: grid; grid-template-columns: 1fr; gap: var(--space-2);
}
@media (min-width: 640px) {
  .ad-provider-grid { grid-template-columns: repeat(2, 1fr); }
}
.ad-provider-logo {
  width: 36px; height: 36px; border-radius: var(--radius-lg);
  background: var(--muted); display: flex;
  align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold); color: var(--foreground);
  text-transform: uppercase; flex-shrink: 0;
}
/* Provider name is 80%-opacity foreground at 12px; ship-list-tile's
   primary is 100%-foreground at 14px. View override. */
.ad-provider-name {
  font-size: 12px; font-weight: var(--font-weight-medium);
  color: color-mix(in oklch, var(--foreground) 80%, transparent);
  display: inline-flex; align-items: center; gap: var(--radius-md);
}
.ad-provider-sub {
  display: inline-flex; align-items: center; gap: var(--radius-md);
  font-size: var(--text-xs); color: var(--muted-foreground);
}

/* Empty state copy — dashed-border rectangle with italic muted text.
   ship-empty-state is variant=default (centered) which is too much
   chrome for the thin "no rules configured" strip inside a section.
   Kept view-local (candidate: ship-empty-state variant="inline"). */
.ad-empty {
  font-size: var(--text-sm); color: var(--muted-foreground);
  padding: var(--space-4); text-align: center;
  border: 1px dashed color-mix(in oklch, var(--border) 50%, transparent);
  border-radius: var(--radius-lg);
}

/* Bottom spacer — ensures the last section can scroll clear of the
   shell's bottom bar / status rail. */
.ad-bottom-spacer { height: 96px; }

@media (prefers-reduced-motion: reduce) {
  .ad-preset-btn, .ad-add-chip { transition: none; }
}
</style>
