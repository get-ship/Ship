{#- Agents wire view — all view-local styles. Extracted from wire.html.j2
    so the top-level template stays under the 300-line file cap. -#}
<style>
  .agents-wire { display: grid; grid-template-columns: 260px 1fr 320px; height: calc(100vh - 60px); overflow: hidden; }
  @media (max-width: 1200px) { .agents-wire { grid-template-columns: 220px 1fr 280px; } }

  /* ── Palette (left) ── */
  .wire-palette { border-right: 1px solid var(--border-subtle); overflow-y: auto; padding: var(--space-3); }
  .wire-palette .section-h {
    display: flex; align-items: center; gap: 6px;
    font-size: 10px; font-weight: var(--font-weight-semibold);
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted-foreground);
    margin: var(--space-3) 0 6px;
  }
  .wire-palette .section-h .count { margin-left: auto; font-size: 10px; padding: 1px 6px; border-radius: 999px; background: var(--muted); }
  .wire-palette .add-btn { margin-left: 4px; }
  .palette-item {
    display: flex; align-items: center; gap: 6px;
    padding: 4px 6px; border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .palette-item .mono { font-family: var(--font-mono); color: var(--foreground); }
  .tip-card {
    margin-top: var(--space-4); padding: 8px 10px;
    border: 1px dashed var(--border); border-radius: var(--radius-md);
    font-size: 11px; color: var(--muted-foreground); line-height: 1.5;
  }

  /* ── Canvas (center) ── */
  .wire-canvas {
    position: relative; overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, var(--border-subtle) 1px, transparent 0)
      0 0 / 28px 28px, var(--background);
  }
  .wire-canvas svg.wires {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
  }
  .node {
    position: absolute; z-index: 1;
    border: 1px solid var(--border-subtle);
    background: var(--surface-1);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-xs);
  }
  .node:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }
  .node[data-selected="true"] { box-shadow: 0 0 0 3px var(--tone-primary-ring); border-color: var(--primary); }
  .node-h { display: flex; align-items: center; gap: 6px; font-size: 10px; letter-spacing: .06em;
    text-transform: uppercase; font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground); margin-bottom: 4px; }
  .node-h .swatch { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .node-title { font-family: var(--font-mono); font-size: 12.5px; font-weight: var(--font-weight-semibold);
    color: var(--foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .node-sub { font-size: 10.5px; color: var(--muted-foreground); margin-top: 2px; }

  .node.skill  { --tone-accent: var(--tone-success-fg); color: var(--tone-success-fg); }
  .node.mcp    { --tone-accent: var(--tone-info-fg);    color: var(--tone-info-fg); }
  .node.rule   { --tone-accent: var(--tone-warning-fg); color: var(--tone-warning-fg); }
  .node.perm   { --tone-accent: var(--tone-destructive-fg); color: var(--tone-destructive-fg); }
  .node.prov   { --tone-accent: var(--tone-accent-fg);  color: var(--tone-accent-fg); }
  .node.agent  { --tone-accent: var(--primary);         color: var(--primary);
    border: 2px solid var(--primary);
    background: color-mix(in oklch, var(--primary) 4%, var(--surface-1)); }
  .node.agent .node-title { font-size: 15px; font-family: var(--heading-font); }

  .wire-legend {
    position: absolute; left: 12px; bottom: 12px;
    display: flex; gap: 10px; padding: 6px 10px;
    background: color-mix(in oklch, var(--surface-1) 92%, transparent);
    border: 1px solid var(--border-subtle); border-radius: 999px;
    backdrop-filter: blur(4px);
    font-size: 10.5px; color: var(--muted-foreground);
  }
  .wire-legend .sw { display: flex; align-items: center; gap: 5px; }
  .wire-legend .sw i { width: 14px; height: 2px; border-radius: 1px; display: inline-block; }

  /* ── Inspector (right) ── */
  .wire-inspector {
    border-left: 1px solid var(--border-subtle);
    overflow-y: auto;
    padding: var(--space-4);
  }
  .insp-h { display: flex; align-items: center; gap: 10px; margin-bottom: var(--space-3); padding-bottom: var(--space-3); border-bottom: 1px solid var(--border-subtle); }
  .insp-h .tag { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted-foreground); }
  .insp-h .title { font-family: var(--heading-font); font-size: var(--text-md); font-weight: var(--heading-weight); }
  .insp-field { margin-bottom: var(--space-3); }
  .insp-field label { display: block; font-size: var(--text-xs); color: var(--muted-foreground); margin-bottom: 4px; }
  .insp-field .mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }
  .insp-help { font-size: var(--text-xs); color: var(--muted-foreground); line-height: 1.5; margin-top: var(--space-3); }
</style>
