{#- Rules section. Context: agent (AgentDetail).
    Hand-wrapped ship-card — section() macro has no action-button slot.
    Parity: apps/web/src/features/agents/sections/RulesSection.tsx -#}
<ship-card padding="none" id="section-rules">
  <div slot="header" class="ad-section-head">
    <h2 class="ad-section-title">
      <ship-icon name="file"></ship-icon>
      Rules
      <span class="ad-section-count">{{ agent.rules | length }} rules</span>
    </h2>
    <ship-button variant="outline" size="sm" disabled>
      <ship-icon slot="leading" name="plus"></ship-icon>
      Add
    </ship-button>
  </div>
  <div class="ad-section-body">
    {% if agent.rules | length == 0 %}
      <div class="ad-empty">
        No rules configured. This agent uses project defaults.
      </div>
    {% else %}
      <div class="ad-rule-list">
        {% for rule in agent.rules %}
          <ship-list-tile density="compact">
            <span slot="leading" class="ad-rule-name">{{ rule }}</span>
            <span class="ad-rule-preview">Project rule</span>
            <ship-button slot="trailing" variant="ghost" size="sm" disabled>edit</ship-button>
          </ship-list-tile>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</ship-card>
