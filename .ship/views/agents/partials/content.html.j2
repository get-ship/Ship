{#- Agents SSE content partial. Target: <div id="agents-content">.
    Context: agents (Vec<AgentSummary>), total (usize). -#}
{% from '_urls.html.j2' import view_agent_detail %}
<div id="agents-content">
  {% if agents | length == 0 %}
    <ship-empty-state icon="sparkles" variant="default" size="lg">
      <span slot="title">No agents yet</span>
      Drop a JSONC file under
      <code style="font-family:var(--font-mono);font-size:var(--text-xs);padding:2px var(--radius-md);border-radius:var(--radius-sm);background:var(--muted);color:var(--foreground)">.ship/agents/</code>
      or create one from the Studio.
      <ship-button slot="action" tone="accent" variant="solid"
        data-on:click="window.router ? window.router.navigate('/agents/create') : location.href='/agents/create'">
        <ship-icon slot="leading" name="plus"></ship-icon>
        New agent
      </ship-button>
    </ship-empty-state>
  {% else %}
    <div class="agents-grid" data-view-enter>
      {% for a in agents %}
        {% include 'agents/partials/card.html.j2' %}
      {% endfor %}
    </div>
  {% endif %}
</div>
