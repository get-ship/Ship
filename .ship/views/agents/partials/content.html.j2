{#- Agents content — SSE-patchable region.
   Root element MUST have id="agents-content" for Datastar patching. -#}
{% from '_urls.html.j2' import view_agent_detail %}
<div id="agents-content">
  {% if agents|length == 0 %}
    <ship-empty-state
      icon="bot"
      title="No agents yet"
      body="Drop a JSONC file under .ship/agents/ to configure one."></ship-empty-state>
  {% else %}
    <div class="agents-grid">
      {% for a in agents %}
      <div class="agent-card"
           data-on:click="@get('{{ view_agent_detail(a.id) }}')">
        <div class="agent-card-head">
          <div class="agent-avatar">{{ a.letter }}</div>
          <div class="agent-card-title">
            <div class="agent-name">{{ a.name }}</div>
            <div class="agent-desc">{{ a.description | truncate(120) }}</div>
          </div>
        </div>
        <div class="agent-card-foot">
          <div class="agent-stats">
            <span>{{ a.skills_count }} skill{% if a.skills_count != 1 %}s{% endif %}</span>
            <span class="agent-stats-sep">&#183;</span>
            <span>{{ a.mcp_count }} MCP</span>
            <span class="agent-stats-sep">&#183;</span>
            <span>{{ a.rules_count }} rule{% if a.rules_count != 1 %}s{% endif %}</span>
          </div>
          <span class="agent-arrow" aria-hidden="true">&#8594;</span>
        </div>
      </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
