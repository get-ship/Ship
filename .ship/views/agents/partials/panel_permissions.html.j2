{#- Permissions section. Context: agent (AgentDetail), tiers (Vec<TierRow>).
    Hand-wrapped ship-card — action button in header; preset-cards and
    permission-cards are specialized view-local compositions.
    Parity: apps/web/src/features/agents/sections/PermissionsSection.tsx -#}
{% from '_ship.html.j2' import radio %}
<ship-card padding="none" id="section-permissions">
  <div slot="header" class="ad-section-head">
    <h2 class="ad-section-title">
      <ship-icon name="lock"></ship-icon>
      Permissions
    </h2>
    <ship-button variant="outline" size="sm" disabled>
      <ship-icon slot="leading" name="edit"></ship-icon>
      Edit
    </ship-button>
  </div>
  <div class="ad-section-body">
    <!-- Preset buttons -->
    <div class="ad-preset-row" role="radiogroup" aria-label="Permission preset">
      {% for t in tiers %}
        <button type="button" class="ad-preset-btn"
                role="radio"
                tabindex="0"
                {{ radio('tier', t.id) }}
                aria-checked="{% if t.selected %}true{% else %}false{% endif %}">
          <span class="ad-preset-label">
            {% if t.id == 'standard' %}
              <ship-icon name="lock"></ship-icon>
            {% elif t.id == 'autonomous' %}
              <ship-icon name="check"></ship-icon>
            {% else %}
              <ship-icon name="eye-off"></ship-icon>
            {% endif %}
            {{ t.label }}
          </span>
          <p class="ad-preset-desc">{{ t.description }}</p>
        </button>
      {% endfor %}
    </div>

    <!-- Permission cards -->
    <div class="ad-perm-grid">
      <div class="ad-perm-card">
        <div class="ad-perm-card-head ad-perm-card-head--allow">
          <ship-icon name="check"></ship-icon>
          Allow
        </div>
        <p class="ad-perm-card-list"><span class="ad-perm-none">none</span></p>
      </div>
      <div class="ad-perm-card">
        <div class="ad-perm-card-head ad-perm-card-head--ask">
          <ship-icon name="info"></ship-icon>
          Ask
        </div>
        <p class="ad-perm-card-list"><span class="ad-perm-none">none</span></p>
      </div>
      <div class="ad-perm-card">
        <div class="ad-perm-card-head ad-perm-card-head--deny">
          <ship-icon name="x"></ship-icon>
          Deny
        </div>
        <p class="ad-perm-card-list"><span class="ad-perm-none">none</span></p>
      </div>
    </div>
  </div>
</ship-card>
