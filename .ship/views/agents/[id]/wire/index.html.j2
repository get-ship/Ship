{#- Agent wire view — explicit /agents/{id}/wire path. Identical payload
    to the canonical detail view; kept as a distinct route so the shell's
    segmented toggle retains a stable URL for the wire mode. -#}
{% from '_ship.html.j2' import head %}
{% set ctx = ship.agents.wire(id=ship.route.id) %}
{% set agent = ctx.agent %}
