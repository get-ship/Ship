{#- Agent settings — panels layout (pre-wire detail). Five stacked
    section cards: Skills / MCP / Permissions / Rules / Providers.
    Data pulled via `ship.agents.settings(id=ship.route.id)`. -#}
{% from '_ship.html.j2' import head, signal, nav %}
{% set ctx = ship.agents.settings(id=ship.route.id) %}
{% set agent = ctx.agent %}
{% set tiers = ctx.tiers %}
{% set catalogs = ctx.catalogs %}

{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head(agent.name) }}</head>
<body>
{% endif %}

<ship-view-chrome title="{{ agent.name }}">
  <ship-segmented slot="actions" value="settings" size="sm">
    <ship-segmented-option value="wire"
      data-on:click="window.router ? window.router.navigate('/agents/{{ agent.id }}/wire') : location.href='/agents/{{ agent.id }}'">
      Wire
    </ship-segmented-option>
    <ship-segmented-option value="settings"
      data-on:click="window.router ? window.router.navigate('/agents/{{ agent.id }}/settings') : location.href='/agents/{{ agent.id }}/settings'">
      Settings
    </ship-segmented-option>
  </ship-segmented>
  <ship-button slot="actions" variant="ghost" size="sm" {{ nav('/agents') }}>
    <ship-icon slot="leading" name="chevron-left" size="xs"></ship-icon>
    Agents
  </ship-button>
</ship-view-chrome>

<div class="ship-view ad-view"
     {{ signal('tier', agent.permissions_tier) }}
     data-signals:pickerOpen="false"
     data-signals:pickerKind="'skill'"
     data-signals:pickerSelected="[]"
     data-signals:catalogsLoaded="false"
     data-signals:catalogs="{skills: [], mcp: [], rules: []}">
  {% include 'agents/partials/detail_styles.html.j2' %}

  <div class="ad-body">
    <div class="ad-sections">
      {% include 'agents/partials/panel_skills.html.j2' %}
      {% include 'agents/partials/panel_mcp.html.j2' %}
      {% include 'agents/partials/panel_permissions.html.j2' %}
      {% include 'agents/partials/panel_rules.html.j2' %}
      {% include 'agents/partials/panel_providers.html.j2' %}
    </div>
    <div class="ad-bottom-spacer"></div>
  </div>

  {% include 'agents/partials/picker_dialog.html.j2' %}
</div>

{% if not fragment %}
</body>
</html>
{% endif %}
