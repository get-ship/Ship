{#-
  Agent detail — self-contained tabbed config page.
  Context: agent (AgentDetail), tiers (Vec<TierRow>).
-#}
{% from '_ship.html.j2' import head, styles, get %}
{% from '_urls.html.j2' import view_agents %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head(agent.name) }}
  <style>
  .ad-wrap { max-width: 1024px; margin: 0 auto; padding: var(--space-6) var(--space-5) var(--space-8); }
  .ad-head { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-5); }
  .ad-name { font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--font-weight-bold); }
  .ad-desc { font-size: var(--text-sm); color: var(--muted-foreground); margin-top: var(--space-1); }
  .ad-meta { margin-top: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .ad-list { list-style: none; }
  .ad-list-item { display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) 0; border-top: 1px solid var(--border); font-size: var(--text-sm); }
  .ad-list-item:first-child { border-top: 0; }
  .ad-list-name { font-family: var(--font-mono); font-size: var(--text-xs); }
  .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-top: var(--space-3); }
  .provider-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-3); }
  </style>
</head>
<body>
<div id="agent-detail-root" class="ship-view">
  <div class="ad-wrap">
    <ship-breadcrumb>
      <ship-breadcrumb-item {{ get(view_agents()) }}>Agents</ship-breadcrumb-item>
      <ship-breadcrumb-item>{{ agent.name }}</ship-breadcrumb-item>
    </ship-breadcrumb>
    <header class="ad-head">
      <ship-avatar letter="{{ agent.letter }}" size="lg"></ship-avatar>
      <div>
        <h1 class="ad-name">{{ agent.name }}</h1>
        <div class="ad-desc">{{ agent.description }}</div>
        <div class="ad-meta">
          <span>{{ agent.skills|length }} skill{% if agent.skills|length != 1 %}s{% endif %}</span>
          <span>&#183;</span>
          <span>{{ agent.mcp_servers|length }} MCP</span>
          <span>&#183;</span>
          <span>{{ agent.rules|length }} rule{% if agent.rules|length != 1 %}s{% endif %}</span>
          <span>&#183;</span>
          <span>{{ agent.providers|length }} provider{% if agent.providers|length != 1 %}s{% endif %}</span>
        </div>
      </div>
    </header>

    <ship-tabs variant="underline" active="skills">
      <ship-tab name="skills" label="Skills" count="{{ agent.skills|length }}"></ship-tab>
      <ship-tab name="mcp" label="MCP" count="{{ agent.mcp_servers|length }}"></ship-tab>
      <ship-tab name="rules" label="Rules" count="{{ agent.rules|length }}"></ship-tab>
      <ship-tab name="provider" label="Provider" count="{{ agent.providers|length }}"></ship-tab>

      <ship-tab-panel name="skills">
        <ship-card>
          <ship-toolbar>
            <h2>Skills</h2>
            <ship-button size="sm" tone="neutral" variant="ghost" disabled>+ Add skill</ship-button>
          </ship-toolbar>
          {% if agent.skills|length == 0 %}
            <ship-empty-state><span slot="title">No skills attached. Add one to extend this agent.</span></ship-empty-state>
          {% else %}
            <ul class="ad-list">
              {% for item in agent.skills %}
                <li class="ad-list-item"><span class="ad-list-name">{{ item.name | default(item) }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}
        </ship-card>
      </ship-tab-panel>

      <ship-tab-panel name="mcp">
        <ship-card>
          <ship-toolbar>
            <h2>MCP Servers</h2>
            <ship-button size="sm" tone="neutral" variant="ghost" disabled>+ Add server</ship-button>
          </ship-toolbar>
          {% if agent.mcp_servers|length == 0 %}
            <ship-empty-state><span slot="title">No MCP servers connected.</span></ship-empty-state>
          {% else %}
            <ul class="ad-list">
              {% for item in agent.mcp_servers %}
                <li class="ad-list-item"><span class="ad-list-name">{{ item.name | default(item) }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}
        </ship-card>
      </ship-tab-panel>

      <ship-tab-panel name="rules">
        <ship-card>
          <ship-toolbar>
            <h2>Rules</h2>
            <ship-button size="sm" tone="neutral" variant="ghost" disabled>+ Add rule</ship-button>
          </ship-toolbar>
          {% if agent.rules|length == 0 %}
            <ship-empty-state><span slot="title">No rules. The agent uses project defaults.</span></ship-empty-state>
          {% else %}
            <ul class="ad-list">
              {% for item in agent.rules %}
                <li class="ad-list-item"><span class="ad-list-name">{{ item.name | default(item) }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}
        </ship-card>
        <ship-card>
          <ship-toolbar><h2>Permissions</h2></ship-toolbar>
          <div class="tier-grid" role="radiogroup" aria-label="Permission tier">
            {% for t in tiers %}
              <ship-card role="radio"
                   aria-checked="{% if t.selected %}true{% else %}false{% endif %}">
                <strong>{{ t.label }}</strong>
                <p>{{ t.description }}</p>
              </ship-card>
            {% endfor %}
          </div>
        </ship-card>
      </ship-tab-panel>

      <ship-tab-panel name="provider">
        <ship-card>
          <ship-toolbar>
            <h2>Providers</h2>
            <ship-button size="sm" tone="neutral" variant="ghost" disabled>+ Add provider</ship-button>
          </ship-toolbar>
          {% if agent.providers|length == 0 %}
            <ship-empty-state><span slot="title">No providers configured. Add one to run this agent.</span></ship-empty-state>
          {% else %}
            <div class="provider-grid">
              {% for p in agent.providers %}
                <ship-card>
                  <div>{{ p }}</div>
                  {% if agent.default_provider == p %}<ship-badge tone="accent" size="sm">Default</ship-badge>{% endif %}
                </ship-card>
              {% endfor %}
            </div>
          {% endif %}
        </ship-card>
      </ship-tab-panel>
    </ship-tabs>
  </div>
</div>
</body>
</html>
