{#-
  Agent detail — stacked sections with sticky header.
  Context: agent (AgentDetail), tiers (Vec<TierRow>).

  Parity target: apps/web/src/routes/studio/agents/$id.tsx
  - Sticky header: avatar (28px, ship-avatar sm) + name (display bold) + version + delete
  - Five stacked section cards: Skills, MCP, Permissions, Rules, Providers
  - Each section wraps in ship-card via section() macro (title-only) or
    a hand-wrapped card when the header carries an action button.
-#}
{% from '_ship.html.j2' import head, signal, nav %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head(agent.name) }}
</head>
<body>
{% endif %}
<div class="ship-view ad-view"
     {{ signal('tier', agent.permissions_tier) }}>
  {% include 'agents/partials/detail_styles.html.j2' %}

  <!-- Sticky header -->
  <header class="ad-header">
    <ship-button variant="ghost" size="sm" {{ nav('/agents') }}
            aria-label="Back to agents">
      <ship-icon slot="leading" name="chevron-left"></ship-icon>
    </ship-button>
    <ship-avatar size="sm" initials="{{ agent.letter }}" name="{{ agent.name }}"></ship-avatar>
    <h1 class="ad-name">{{ agent.name }}</h1>
    <span class="ad-version">0.0.0</span>
    <div class="ad-header-spacer"></div>
    <ship-button variant="ghost" size="sm" tone="destructive" aria-label="Delete agent">
      <ship-icon slot="leading" name="trash"></ship-icon>
    </ship-button>
  </header>

  <!-- Scrollable body with all sections -->
  <div class="ad-body">
    <div class="ad-sections">
      {% include 'agents/partials/panel_skills.html.j2' %}
      {% include 'agents/partials/panel_mcp.html.j2' %}
      {% include 'agents/partials/panel_permissions.html.j2' %}
      {% include 'agents/partials/panel_rules.html.j2' %}
      {% include 'agents/partials/panel_providers.html.j2' %}
    </div>
    <div class="ad-bottom-spacer"></div>
  </div>

</div>
{% if not fragment %}
</body>
</html>
{% endif %}
