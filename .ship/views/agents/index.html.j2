{#-
  Agents index — self-contained card grid with SSE live updates.
  Context: agents (Vec<AgentSummary>), total (usize).
-#}
{% from '_urls.html.j2' import view_agents_create %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agents</title>
  <link rel="stylesheet" href="/api/runtime/assets/view-tokens.css">
  <script type="module" src="/api/runtime/assets/datastar.js"></script>
  <script type="module" src="/api/runtime/assets/ship-elements.js"></script>
  <style>
  .ship-view-agents { color: var(--foreground); }
  .agents-wrap { max-width: 1280px; margin: 0 auto; padding: 28px 24px 56px; }
  .agents-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 16px; margin: 0 0 28px;
  }
  .agents-title {
    font-family: var(--font-display); font-size: 26px; font-weight: 700;
    letter-spacing: -0.015em; margin: 0;
  }
  .agents-sub { font-size: 13px; color: var(--muted-foreground); margin-top: 6px; }
  .agents-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
  }
  .agent-card {
    display: flex; flex-direction: column; justify-content: space-between; gap: 18px;
    border: 1px solid var(--border); background: var(--card);
    border-radius: var(--radius-lg); padding: 20px; min-height: 150px; cursor: pointer;
    transition: border-color 0.12s ease, background-color 0.12s ease;
  }
  .agent-card:hover {
    border-color: color-mix(in oklch, var(--primary) 45%, var(--border));
  }
  .agent-card-head { display: flex; gap: 14px; align-items: flex-start; }
  .agent-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: color-mix(in oklch, var(--primary) 18%, var(--card));
    color: var(--primary);
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 600; font-size: 16px; flex-shrink: 0;
  }
  .agent-card-title { min-width: 0; flex: 1; }
  .agent-name { font-size: 15px; font-weight: 600; color: var(--foreground); margin: 0 0 4px; }
  .agent-desc { font-size: 13px; color: var(--muted-foreground); margin: 0; line-height: 1.5; }
  .agent-card-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
  }
  .agent-stats {
    font-size: 12px; color: var(--muted-foreground);
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .agent-stats-sep { opacity: 0.6; }
  .agent-arrow {
    color: var(--muted-foreground); font-size: 14px;
    transition: transform 0.12s ease, color 0.12s ease;
  }
  .agent-card:hover .agent-arrow { color: var(--primary); transform: translateX(2px); }
  </style>
</head>
<body>
<div id="agents-root" class="ship-view ship-view-agents"
     data-signals="{search: ''}">
  <div class="agents-wrap">
    <div class="agents-head">
      <div>
        <h1 class="agents-title">Agents</h1>
        <div class="agents-sub">{{ total }} {% if total == 1 %}agent configured{% else %}agents configured{% endif %}</div>
      </div>
      <ship-button size="sm" tone="accent" variant="solid"
        data-on:click="@post('{{ view_agents_create() }}', {contentType: 'json', body: JSON.stringify({})})">
        + New Agent
      </ship-button>
    </div>

    <div data-init="@get('/api/runtime/view/agents/sse')">
      <div id="agents-content">
        <p class="agents-sub" style="padding: 16px 0">Loading...</p>
      </div>
    </div>
  </div>
</div>
</body>
</html>
