{#-
  Agents index — grid of agent cards with SSE live updates.
  Context: agents (Vec<AgentSummary>), total (usize).

  Parity target: apps/web/src/routes/studio/agents/index.tsx
  - display headline + "N agents configured" subtitle
  - responsive card grid (~320px min)
  - ship-avatar + name + description + stats footer
  - ship-empty-state when total == 0
-#}
{% from '_ship.html.j2' import head, signal, live, get, post %}
{% from '_urls.html.j2' import view_agent_detail, view_agents_create %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head('Agents') }}
  <style>
  .agents-view { color: var(--foreground); font-family: var(--font-body); }
  .agents-wrap {
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-8);
  }
  .agents-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: var(--space-4); margin-bottom: var(--space-6);
  }
  .agents-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-1);
    color: var(--foreground);
  }
  .agents-sub {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin: 0;
  }
  .agents-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-3);
  }
  /* ship-card interactive already provides hover/focus treatment. We just
     pin padding + lay out the inner row. */
  .agent-card { cursor: pointer; padding: var(--space-4); }
  .agent-card-head {
    display: flex; align-items: flex-start; gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .agent-card-body { min-width: 0; flex: 1; }
  .agent-name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0 0 2px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .agent-desc {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .agent-arrow {
    color: var(--muted-foreground);
    transition: color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
    margin-top: 2px;
    flex-shrink: 0;
  }
  .agent-card:hover .agent-arrow {
    color: var(--foreground);
    transform: translateX(2px);
  }
  .agent-stats {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: 11px;
    color: var(--muted-foreground);
  }
  .agent-stats-sep { color: var(--border); }
  .loading-copy {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    padding: var(--space-4) 0;
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .agent-card:hover .agent-arrow { transform: none; }
  }
  </style>
</head>
<body>
<div class="agents-view" {{ signal('_creating', false) }}>
  <div class="agents-wrap">

    <header class="agents-head">
      <div>
        <h1 class="agents-title">Agents</h1>
        <p class="agents-sub">
          {{ total }} agent{% if total != 1 %}s{% endif %} configured
        </p>
      </div>
      <ship-button size="sm" tone="accent" variant="solid"
        {{ post(view_agents_create(), '{}') }}>
        <ship-icon slot="leading" name="plus"></ship-icon>
        New agent
      </ship-button>
    </header>

    <div {{ live('agents') }}>
      <div id="agents-content">
        <p class="loading-copy">Loading...</p>
      </div>
    </div>

  </div>
</div>
</body>
</html>
