{#-
  Agents index — grid of agent cards with SSE live updates.
  Context: agents (Vec<AgentSummary>), total (usize).

  Parity target: apps/web/src/routes/studio/agents/index.tsx
  - Syne display heading + "N agents" subtitle
  - responsive card grid (grid-cols-1 / md:2 / lg:3)
  - avatar (colored circle, first letter) + name + description + stats + badges
  - card hover: border-primary/30 + arrow foreground (ship-list-tile supplies)
  - empty state (ship-empty-state in content partial)
-#}
{% from '_ship.html.j2' import head, signal, live, post %}
{% from '_urls.html.j2' import view_agents_create %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Agents') }}</head>
<body>
{% endif %}
<div class="ship-view agents-view"
     {{ signal('_creating', false) }}>
  <style>
  /* Page-level typography — the view header precedes any ship-card, so the
     shell container owns font + color context. */
  .agents-view { color: var(--foreground); font-family: var(--font-body); }

  /* Outer wrap. The agents view sits inside the shell's main panel; the
     1024px clamp + symmetric padding match the React parity exactly. */
  .agents-wrap { max-width: 1024px; margin: 0 auto; padding: 32px var(--space-6); }

  /* Title row — display-family heading left, primary CTA right. No
     ship-element covers a heading-with-subtitle + action layout; kept
     view-local. */
  .agents-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: var(--space-4); margin-bottom: var(--space-6);
  }
  .agents-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    line-height: 32px;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-1);
    color: var(--foreground);
  }
  .agents-sub { font-size: 14px; color: var(--muted-foreground); margin: 0; }

  /* Grid layout — breakpoints mirror the React parity (1/2/3 cols).
     ship-list-tile doesn't own its own layout context, so the grid rules
     live here. `grid-auto-rows: 1fr` + `align-items: stretch` forces
     every row to match the tallest card in that row, so short
     descriptions don't produce ragged card heights. */
  .agents-grid {
    display: grid; grid-template-columns: 1fr; gap: var(--space-3);
    grid-auto-rows: 1fr;
    align-items: stretch;
  }
  .agents-grid > ship-list-tile.agents-card-tile { height: 100%; }
  @media (min-width: 768px) {
    .agents-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .agents-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Card body vertical stack — the ship-list-tile primary slot renders
     as an inline span (.primary), but a block-level child lays out as a
     column regardless. We need a 3-stack inside the tile's primary
     region so this wrapper restores block flow. */
  .agents-card-body {
    display: flex; flex-direction: column; gap: var(--space-2);
    min-width: 0; flex: 1;
  }

  /* Title + description stack. The tile's primary slot is font-weight
     medium + text-base; agent cards want a tighter semibold title with a
     clamped 2-line description below — keep view-local. */
  .agents-card-head { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .agents-card-title {
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .agents-card-desc {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    margin: 0; line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stats row — 10px dotted separators. No ship-element covers this
     micro-row. */
  .agents-card-stats {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: 10px; color: var(--muted-foreground);
  }
  .agents-card-sep { color: var(--border); }

  /* Source badge row — gives the badge a dedicated line so it doesn't
     wrap with the stats. ship-badge size=sm is the correct primitive. */
  .agents-card-badges {
    display: flex; align-items: center; gap: var(--radius-md);
  }

  /* Keep the tile body's primary slot happy — it wraps its content in a
     span (.primary) that's flex:1 min-width:0 inside the tile row. Our
     body wants the same so long text clamps. */
  ship-list-tile.agents-card-tile::part(primary) { min-width: 0; }

  /* Loading copy — shown pre-SSE-patch. ship-empty-state is the loaded
     empty state (in content partial). */
  .loading-copy {
    font-size: 14px; color: var(--muted-foreground);
    padding: var(--space-4) 0; margin: 0;
  }
  </style>
  <div class="agents-wrap">

    <header class="agents-head">
      <div>
        <h1 class="agents-title">Agents</h1>
        <p class="agents-sub">{{ total }} agent{% if total != 1 %}s{% endif %}</p>
      </div>
      <ship-button tone="accent" variant="solid" {{ post(view_agents_create(), '{}') }}>
        <ship-icon slot="leading" name="plus"></ship-icon>
        New agent
      </ship-button>
    </header>

    <div {{ live('agents') }}>
      <div id="agents-content">
        <p class="loading-copy">Loading...</p>
      </div>
    </div>

  </div>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
