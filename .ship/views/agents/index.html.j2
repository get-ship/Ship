{#-
  Agents index — self-contained card grid with SSE live updates.
  Context: agents (Vec<AgentSummary>), total (usize).
-#}
{% from '_ship.html.j2' import head, signal, live, styles, post, on %}
{% from '_urls.html.j2' import view_agents_create %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Agents') }}
  <style>
  .agents-wrap { max-width: 1280px; margin: 0 auto; padding: var(--space-6) var(--space-5); }
  .agents-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-4); }
  .agent-card-head { display: flex; gap: var(--space-3); align-items: flex-start; }
  .agent-card-title { min-width: 0; flex: 1; }
  .agent-name { font-weight: var(--font-weight-semibold); }
  .agent-desc { font-size: var(--text-sm); color: var(--muted-foreground); }
  .agent-stats { font-size: var(--text-xs); color: var(--muted-foreground); display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .agents-sub { font-size: var(--text-sm); color: var(--muted-foreground); }
  </style>
</head>
<body>
<div id="agents-root" class="ship-view"
     {{ signal('search', '') }}>
  <div class="agents-wrap">
    <ship-toolbar>
      <div class="agents-head">
        <h1>Agents</h1>
        <div class="agents-sub">{{ total }} {% if total == 1 %}agent configured{% else %}agents configured{% endif %}</div>
      </div>
      <ship-button size="sm" tone="accent" variant="solid"
        {{ post(view_agents_create(), '{}') }}>
        + New Agent
      </ship-button>
    </ship-toolbar>

    <div {{ live('agents') }}>
      <div id="agents-content">
        <p class="agents-sub">Loading...</p>
      </div>
    </div>
  </div>
</div>
</body>
</html>
