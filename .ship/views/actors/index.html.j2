{#-
  Actors dashboard — every running thing in Ship, presentable.
  Backed by the ActorProjection table via ship.actors.list().
  Live derived from /proc/{pid} (real liveness, not the sticky
  status field). Dead actors collapse into a "stopped" footer
  by default; toggle to show them.
-#}
{% from '_ship.html.j2' import head %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Actors') }}</head>
<body>
{% endif %}
{%- set items = ship.actors.list().items -%}
{%- set live_items = items | selectattr('live', 'equalto', true) | list -%}
{%- set dead_items = items | rejectattr('live', 'equalto', true) | list -%}
{%- set chats = live_items | selectattr('kind', 'equalto', 'agent') | list -%}
{%- set pipelines = live_items | selectattr('kind', 'equalto', 'pipeline-step') | list -%}
{%- set shells = live_items | selectattr('kind', 'equalto', 'shell') | list -%}
<ship-view-chrome title="Actors"></ship-view-chrome>
<div class="ship-view ship-actors">
  <style>
  .ship-actors { padding: var(--space-5, 20px); max-width: 1280px; margin: 0 auto; color: var(--foreground); }
  .actors-head { display: flex; align-items: baseline; gap: var(--space-4, 16px); margin-bottom: var(--space-5, 20px); flex-wrap: wrap; }
  .actors-head-title { position: relative; }
  .actors-head-title::after {
    content: ''; display: block; width: 60px; height: 4px;
    margin-top: var(--space-2, 8px); border-radius: 2px;
    background: linear-gradient(90deg, var(--primary), transparent);
  }
  .actors-head h1 {
    margin: 0; font-size: var(--text-2xl);
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    letter-spacing: var(--heading-tracking);
  }
  .actors-counts { display: flex; gap: 14px; font-size: var(--text-sm); color: var(--muted-foreground); margin-left: auto; }
  .actors-counts strong { color: var(--foreground); font-weight: var(--font-weight-medium, 500); }

  .actors-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--space-3, 12px); }
  .actor-card {
    border: 1px solid var(--border); border-radius: var(--radius-md);
    padding: var(--space-3, 12px); background: var(--card, var(--background));
    display: grid; gap: 8px;
    transition: border-color var(--duration-fast, 120ms) var(--ease-out, ease);
  }
  .actor-card:hover { border-color: color-mix(in oklch, var(--foreground) 30%, var(--border)); }
  .actor-card[data-live="false"] { opacity: 0.65; }

  .card-head { display: flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: 999px; flex: none; }
  .dot[data-live="true"] { background: var(--success, #16a34a); box-shadow: 0 0 0 3px color-mix(in oklch, var(--success, #16a34a) 22%, transparent); }
  .dot[data-live="false"] { background: var(--muted-foreground); }
  .card-head .name { font-weight: var(--font-weight-medium, 500); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .badge { font-size: 10px; padding: 2px 7px; border-radius: 999px; background: var(--muted); color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.04em; font-weight: var(--font-weight-medium, 500); }

  .meta { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; font-size: 12px; color: var(--muted-foreground); }
  .meta .k { opacity: 0.7; }
  .meta .v { color: var(--foreground); font-family: var(--font-mono); font-size: 11px; word-break: break-all; }
  .meta .v.dim { color: var(--muted-foreground); font-family: inherit; }

  .actions { display: flex; gap: 6px; margin-top: 2px; }
  .act { appearance: none; font: inherit; font-size: 12px; padding: 4px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm, 4px); background: transparent; color: var(--foreground); cursor: pointer; }
  .act:hover { border-color: color-mix(in oklch, var(--foreground) 35%, var(--border)); }
  .act.danger:hover { color: var(--destructive); border-color: var(--destructive); }
  .act.primary { background: var(--foreground); color: var(--background); border-color: var(--foreground); }

  .empty { padding: var(--space-12, 48px) var(--space-5, 20px); text-align: center; color: var(--muted-foreground); border: 1px dashed var(--border); border-radius: var(--radius-md); }

  details.dead { margin-top: var(--space-6, 24px); }
  details.dead summary { cursor: pointer; color: var(--muted-foreground); font-size: var(--text-sm); padding: 6px 0; user-select: none; }
  details.dead summary:hover { color: var(--foreground); }
  details.dead .actors-grid { margin-top: var(--space-3, 12px); }
  </style>
  <script type="module">
    // Inline relative-time rendering. Avoids a custom element for one
    // small label and re-runs cheaply on view re-entry.
    const fmt = (iso) => {
      const t = Date.parse(iso); if (!t) return '';
      const s = Math.max(0, Math.floor((Date.now() - t) / 1000));
      if (s < 5) return 'just now';
      if (s < 60) return s + 's ago';
      const m = Math.floor(s / 60); if (m < 60) return m + 'm ago';
      const h = Math.floor(m / 60); if (h < 24) return h + 'h ago';
      const d = Math.floor(h / 24); return d + 'd ago';
    };
    const apply = () => document.querySelectorAll('.ts[data-ts]').forEach(el => {
      const r = fmt(el.dataset.ts); if (r) el.textContent = r;
    });
    apply();
    // Re-tick every 30s while the view is mounted.
    const id = setInterval(apply, 30000);
    document.addEventListener('ship:before-mount', () => clearInterval(id), { once: true });
  </script>

  <header class="actors-head">
    <div class="actors-head-title"><h1>Actors</h1></div>
    <div class="actors-counts">
      <span><strong>{{ live_items | length }}</strong> live</span>
      <span><strong>{{ chats | length }}</strong> chats</span>
      <span><strong>{{ pipelines | length }}</strong> pipelines</span>
      <span><strong>{{ shells | length }}</strong> shells</span>
      {% if dead_items | length > 0 %}<span style="opacity: 0.5;">· {{ dead_items | length }} stopped</span>{% endif %}
    </div>
  </header>

  {% if live_items | length == 0 and dead_items | length == 0 %}
    <div class="empty">No actors. Open the command bar (⌘K) to spawn one.</div>
  {% endif %}

  {% if live_items | length > 0 %}
    <div class="actors-grid">
      {% for a in live_items %}
        {%- set name = a.agent_id if a.agent_id else (a.kind ~ ' ' ~ a.id[:8]) -%}
        <div class="actor-card" data-live="true" data-kind="{{ a.kind }}">
          <div class="card-head">
            <span class="dot" data-live="true" title="alive (pid {{ a.pid }})"></span>
            <span class="name">{{ name }}</span>
            <span class="badge">{{ a.kind }}</span>
          </div>
          <div class="meta">
            {% if a.provider %}<span class="k">provider</span><span class="v">{{ a.provider }}{% if a.model %} · {{ a.model }}{% endif %}</span>{% endif %}
            {% if a.workspace_id %}<span class="k">workspace</span><span class="v dim">{{ a.workspace_id }}</span>{% endif %}
            {% if a.transport %}<span class="k">mode</span><span class="v dim">{{ a.transport }}{% if a.persistence %} · {{ a.persistence }}{% endif %}</span>{% endif %}
            <span class="k">last activity</span><span class="v dim ts" data-ts="{{ a.last_event_at or a.created_at }}">{{ (a.last_event_at or a.created_at)[:19] | replace('T', ' ') }}</span>
          </div>
          <div class="actions">
            {% if a.kind == 'agent' %}
              <button class="act primary"
                      data-on-click__stop="window.ship.navigate('/chat?actor={{ a.id }}')">
                Open chat
              </button>
            {% endif %}
            <button class="act"
                    data-on-click__stop="window.ship.navigate('/events?actor={{ a.id }}')">
              Events
            </button>
            <button class="act danger"
                    data-on-click__stop="if (confirm('End this actor?')) fetch('/api/sessions/{{ a.id }}', {method: 'DELETE', credentials: 'same-origin'}).then(() => window.location.reload())">
              End
            </button>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {% if dead_items | length > 0 %}
    <details class="dead">
      <summary>{{ dead_items | length }} stopped or dead actor{{ '' if dead_items | length == 1 else 's' }}</summary>
      <div class="actors-grid">
        {% for a in dead_items %}
          {%- set name = a.agent_id if a.agent_id else (a.kind ~ ' ' ~ a.id[:8]) -%}
          <div class="actor-card" data-live="false" data-kind="{{ a.kind }}">
            <div class="card-head">
              <span class="dot" data-live="false"></span>
              <span class="name">{{ name }}</span>
              <span class="badge">{{ a.kind }}</span>
            </div>
            <div class="meta">
              {% if a.provider %}<span class="k">provider</span><span class="v">{{ a.provider }}</span>{% endif %}
              {% if a.exit_code is not none and a.exit_code != 0 %}<span class="k">exit</span><span class="v">{{ a.exit_code }}{% if a.exit_reason %} · {{ a.exit_reason }}{% endif %}</span>{% endif %}
              {% if a.duration_ms %}<span class="k">ran for</span><span class="v dim">{{ (a.duration_ms / 1000) | round(1) }}s</span>{% endif %}
              <span class="k">last activity</span><span class="v dim ts" data-ts="{{ a.last_event_at or a.created_at }}">{{ (a.last_event_at or a.created_at)[:19] | replace('T', ' ') }}</span>
            </div>
            <div class="actions">
              <button class="act"
                      data-on-click__stop="window.ship.navigate('/events?actor={{ a.id }}')">
                Events
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    </details>
  {% endif %}
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
