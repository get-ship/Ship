{#- Resolve an agent's avatar from its `icon` field with a sensible fallback.

    Inputs (Jinja vars expected to be set by the includer):
      _agent_id        — agent id (used for identity-hue + alt resolution)
      _agent_name      — display name (alt text)
      _agent_icon      — raw `icon` field (may be empty/undefined)
      _agent_letter    — fallback initial (single char)
      _avatar_size     — ship-avatar size (sm|md|lg). Default: md.
      _avatar_shape    — ship-avatar shape (square|round|rounded). Default: square.

    Resolution rules (mirrors agents/partials/card.html.j2):
      "simpleicons:<slug>"  → ship-avatar icon-slug=<slug>   (CDN brand mark)
      short string (≤3)     → literal initials
      longer string         → ship-icon registry name (centered tile)
      empty/undefined       → first-letter initials (_agent_letter)
-#}
{%- set _icon_s = (_agent_icon if _agent_icon is defined else '') | string -%}
{%- set _is_simpleicons = _icon_s and _icon_s[:12] == 'simpleicons:' -%}
{%- set _slug = _icon_s[12:] if _is_simpleicons else '' -%}
{%- set _is_short = (not _is_simpleicons) and _icon_s and _icon_s|length <= 3 -%}
{%- set _is_registry = (not _is_simpleicons) and _icon_s and _icon_s|length > 3 -%}
{%- set _size = _avatar_size if _avatar_size is defined else 'md' -%}
{%- set _shape = _avatar_shape if _avatar_shape is defined else 'square' -%}
{%- if _is_simpleicons and _slug -%}
  <ship-avatar slot="leading" size="{{ _size }}" shape="{{ _shape }}"
               identity-hue="{{ _agent_id }}"
               icon-slug="{{ _slug }}" name="{{ _agent_name }}"></ship-avatar>
{%- elif _is_short -%}
  <ship-avatar slot="leading" size="{{ _size }}" shape="{{ _shape }}"
               identity-hue="{{ _agent_id }}"
               initials="{{ _icon_s }}" name="{{ _agent_name }}"></ship-avatar>
{%- elif _is_registry -%}
  <span slot="leading" class="agents-card-icon-tile" aria-label="{{ _agent_name }}">
    <ship-icon name="{{ _icon_s }}" size="md"></ship-icon>
  </span>
{%- else -%}
  <ship-avatar slot="leading" size="{{ _size }}" shape="{{ _shape }}"
               identity-hue="{{ _agent_id }}"
               initials="{{ _agent_letter }}" name="{{ _agent_name }}"></ship-avatar>
{%- endif -%}
