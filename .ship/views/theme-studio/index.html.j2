{#-
  Theme Studio — draft theme tokens on the left, live preview of a
  shipped view on the right, contrast report beneath. Uses a CSS
  layer (`@layer theme-draft`) so draft tokens win over the user's
  currently-applied theme without mutating :root globally — easy to
  roll back on exit. Calls POST /api/themes/contrast on every debounced
  change so the pass/fail counts update inline.
-#}
{% from '_ship.html.j2' import head, signal, signals, on, init %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Theme Studio') }}</head>
<body>
{% endif %}
<ship-view-chrome title="Theme Studio"></ship-view-chrome>
<div class="ship-view ship-theme-studio"
     {{ signals({
       'tokens': {
         'foreground': '#0a0a0a',
         'background': '#ffffff',
         'primary': 'oklch(0.53 0.22 263)',
         'primary-foreground': '#ffffff',
         'border': '#e5e5e5',
         'muted': '#f5f5f5',
         'muted-foreground': '#737373',
         'destructive': '#dc2626',
         'destructive-foreground': '#ffffff',
         'success': '#16a34a',
         'warning': '#d97706',
         'accent': '#f4f4f5',
         'accent-foreground': '#0a0a0a',
       },
       'report': none,
     }) }}>
  <style>
    .ship-theme-studio {
      display: grid;
      grid-template-columns: 360px 1fr;
      grid-template-rows: 1fr auto;
      height: calc(100vh - 60px);
      min-height: 0;
    }
    .ts-editor {
      grid-column: 1;
      grid-row: 1 / span 2;
      border-right: 1px solid var(--border);
      overflow: auto;
      padding: var(--space-4);
      display: grid;
      gap: var(--space-3);
    }
    .ts-editor h2 {
      margin: 0;
      font-size: var(--text-sm);
      font-weight: var(--font-weight-medium);
      color: var(--muted-foreground);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .ts-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px;
      align-items: center;
    }
    .ts-row label {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
    }
    .ts-row input[type="text"] {
      grid-column: 1 / -1;
      font: inherit;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      border: 1px solid var(--border);
      background: var(--background);
      color: var(--foreground);
      border-radius: var(--radius-sm);
      padding: 4px 8px;
    }
    .ts-swatch {
      width: 24px;
      height: 24px;
      border: 1px solid var(--border);
      border-radius: 4px;
    }
    .ts-preview {
      grid-column: 2;
      grid-row: 1;
      padding: var(--space-4);
      overflow: auto;
      /* Preview scope — draft tokens apply only here. */
    }
    .ts-preview[data-theme-draft] {
      --foreground: var(--draft-foreground);
      --background: var(--draft-background);
      --primary: var(--draft-primary);
      --primary-foreground: var(--draft-primary-foreground);
      --border: var(--draft-border);
      --muted: var(--draft-muted);
      --muted-foreground: var(--draft-muted-foreground);
      --destructive: var(--draft-destructive);
      --destructive-foreground: var(--draft-destructive-foreground);
      --success: var(--draft-success);
      --warning: var(--draft-warning);
      --accent: var(--draft-accent);
      --accent-foreground: var(--draft-accent-foreground);
      background: var(--background);
      color: var(--foreground);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      padding: var(--space-5);
      min-height: 420px;
    }
    .ts-preview .hero {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-bottom: var(--space-4);
    }
    .ts-preview .card {
      background: var(--muted);
      color: var(--muted-foreground);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-3);
      min-width: 180px;
    }
    .ts-preview .btn-primary {
      background: var(--primary);
      color: var(--primary-foreground);
      border: 0;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      font: inherit;
    }
    .ts-preview .btn-destructive {
      background: var(--destructive);
      color: var(--destructive-foreground);
      border: 0;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      font: inherit;
      margin-left: 8px;
    }
    .ts-contrast {
      grid-column: 2;
      grid-row: 2;
      border-top: 1px solid var(--border);
      padding: var(--space-3) var(--space-4);
      max-height: 220px;
      overflow: auto;
      background: var(--sidebar);
      font-size: var(--text-xs);
      font-family: var(--font-mono);
    }
    .ts-contrast table {
      width: 100%;
      border-collapse: collapse;
    }
    .ts-contrast th, .ts-contrast td {
      text-align: left;
      padding: 3px 10px 3px 0;
      color: var(--muted-foreground);
    }
    .ts-contrast th { color: var(--foreground); }
    .ts-contrast .pass { color: var(--success); }
    .ts-contrast .fail { color: var(--destructive); }
  </style>

  <!-- Draft token propagation: mirror each $tokens key into --draft-<key>
       on the preview container so CSS vars cascade into the sample view.
       Also POST to /api/themes/contrast whenever tokens change. -->
  <div
    data-computed-tokens-css="Object.entries($tokens).map(([k,v]) => `--draft-${k}: ${v}`).join('; ')"
    data-effect="document.getElementById('ts-preview')?.setAttribute('style', $tokens_css); (async () => { try { const r = await fetch('/api/themes/contrast', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tokens: $tokens }) }); if (r.ok) $report = await r.json(); } catch {} })()"
  ></div>

  <aside class="ts-editor">
    <h2>Tokens</h2>
    <template data-for="name in Object.keys($tokens)">
      <div class="ts-row">
        <label data-text="name"></label>
        <span class="ts-swatch" data-attr-style="'background: ' + $tokens[name]"></span>
        <input type="text" data-attr-value="$tokens[name]"
               data-on-change="$tokens = {...$tokens, [name]: evt.target.value}" />
      </div>
    </template>
  </aside>

  <section class="ts-preview" id="ts-preview" data-theme-draft>
    <div class="hero">
      <h1 style="margin:0">Primary headline</h1>
    </div>
    <p style="color: var(--muted-foreground); max-width: 520px">
      Body copy lives in muted-foreground. Interactive elements use primary.
      Destructive actions should remain legible against the background.
    </p>
    <div style="display:flex; gap:12px; margin: 16px 0">
      <button class="btn-primary">Primary action</button>
      <button class="btn-destructive">Destructive</button>
    </div>
    <div class="hero">
      <div class="card">
        <strong>Card title</strong>
        <div style="margin-top:6px">Muted on muted — legibility matters here.</div>
      </div>
      <div class="card">
        <strong>Another</strong>
        <div style="margin-top:6px">Borders should read at arm's length.</div>
      </div>
    </div>
  </section>

  <section class="ts-contrast">
    <div data-show="!$report">Computing contrast…</div>
    <table data-show="$report">
      <thead>
        <tr><th>Pair</th><th>Ratio</th><th>Min</th><th>AA body</th><th>AAA</th><th>Status</th></tr>
      </thead>
      <tbody>
        <template data-for="p in ($report?.pairs || [])">
          <tr>
            <td data-text="p.label + ' (' + p.foreground + '/' + p.background + ')'"></td>
            <td data-text="p.ratio ? p.ratio.toFixed(2) : '—'"></td>
            <td data-text="p.required_min.toFixed(2)"></td>
            <td data-text="p.aa_body === true ? '✓' : p.aa_body === false ? '✗' : '?'"></td>
            <td data-text="p.aaa_body === true ? '✓' : p.aaa_body === false ? '✗' : '?'"></td>
            <td>
              <span data-class-pass="p.passes === true" data-class-fail="p.passes === false"
                    data-text="p.passes === true ? 'pass' : p.passes === false ? 'fail' : '—'"></span>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </section>
</div>
{% if not fragment %}
</body>
</html>
{% endif %}
