{#-
  Mesh — sanity check for what Ship is running on this machine.
  Three populations:
    1. Actors with kernel mailboxes (agents, pipelines, services)
    2. Ship system processes (daemon, supervisor)
    3. Integrations (Telegram, channel capabilities, etc.)

  This is the trust surface. Daily flow lives elsewhere.
-#}
{% from '_ship.html.j2' import head %}
{% if not fragment %}
<!DOCTYPE html>
<html lang="en">
<head>{{ head('Mesh') }}</head>
<body>
{% endif %}
{%- set snap = ship.mesh.snapshot() -%}
<ship-view-chrome title="Mesh"></ship-view-chrome>
<div class="ship-view ship-mesh">
  <style>
  .ship-mesh { padding: var(--space-5, 20px); max-width: 1280px; margin: 0 auto; color: var(--foreground); }
  .head { display: flex; align-items: baseline; gap: var(--space-4, 16px); margin-bottom: var(--space-5, 20px); flex-wrap: wrap; }
  .head h1 { margin: 0; font-size: var(--text-2xl); font-weight: var(--font-weight-medium, 500); }
  .head .sub { color: var(--muted-foreground); font-size: var(--text-sm); }
  .counts { margin-left: auto; display: flex; gap: 14px; font-size: var(--text-sm); color: var(--muted-foreground); }
  .counts strong { color: var(--foreground); font-weight: var(--font-weight-medium, 500); }

  section { margin-bottom: var(--space-6, 24px); }
  section > header { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
  section > header h2 { margin: 0; font-size: var(--text-base); font-weight: var(--font-weight-medium, 500); }
  section > header .n { color: var(--muted-foreground); font-size: var(--text-sm); }
  section > header .desc { color: var(--muted-foreground); font-size: 12px; margin-left: auto; font-style: italic; }

  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead th { text-align: left; font-weight: var(--font-weight-medium, 500); color: var(--muted-foreground); padding: 6px 10px; border-bottom: 1px solid var(--border); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
  tbody td { padding: 8px 10px; border-bottom: 1px solid color-mix(in oklch, var(--border) 50%, transparent); vertical-align: middle; }
  tbody tr:hover { background: var(--muted); }

  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 999px; }
  .dot[data-state="live"] { background: var(--success, #16a34a); box-shadow: 0 0 0 3px color-mix(in oklch, var(--success, #16a34a) 22%, transparent); }
  .dot[data-state="dead"] { background: var(--muted-foreground); }
  .dot[data-state="warn"] { background: var(--warning, #d97706); }

  .id, .pid, .ts { font-family: var(--font-mono); font-size: 12px; }
  .id { word-break: break-all; }
  .ts { color: var(--muted-foreground); }
  .muted { color: var(--muted-foreground); }
  .badge { font-size: 10px; padding: 2px 6px; border-radius: 3px; background: var(--muted); color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.04em; }

  .empty { color: var(--muted-foreground); font-size: 12px; padding: 12px 0; font-style: italic; }
  </style>

  <header class="head">
    <h1>Mesh</h1>
    <div class="sub">what Ship is running on this machine, right now</div>
    <div class="counts">
      <span><strong>{{ snap.counts.actors }}</strong> actors</span>
      <span><strong>{{ snap.counts.processes }}</strong> processes</span>
      <span><strong>{{ snap.counts.integrations }}</strong> integrations</span>
    </div>
  </header>

  <section>
    <header>
      <h2>Actors</h2>
      <span class="n">{{ snap.actors | length }}</span>
      <span class="desc">live mailboxes — anything reachable via target_actor_id</span>
    </header>
    {% if snap.actors | length == 0 %}
      <div class="empty">No actors on the mesh. Spawn an agent or run a pipeline.</div>
    {% else %}
      <table>
        <thead>
          <tr>
            <th></th><th>Kind</th><th>Name</th><th>Provider</th><th>Workspace</th><th>Pid</th><th>Last activity</th>
          </tr>
        </thead>
        <tbody>
          {% for a in snap.actors %}
          <tr>
            <td><span class="dot" data-state="live"></span></td>
            <td><span class="badge">{{ a.kind }}</span></td>
            <td>
              {% if a.agent_id %}{{ a.agent_id }}<div class="id muted">{{ a.actor_id }}</div>
              {% else %}<span class="id">{{ a.actor_id }}</span>{% endif %}
            </td>
            <td>{{ a.provider or '—' }}{% if a.transport %} · <span class="muted">{{ a.transport }}</span>{% endif %}</td>
            <td>{{ a.workspace_id or '—' }}</td>
            <td class="pid">{{ a.pid or '—' }}</td>
            <td class="ts" data-ts="{{ a.last_event_at or '' }}">{{ (a.last_event_at or '—')[:19] | replace('T', ' ') }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </section>

  <section>
    <header>
      <h2>Ship processes</h2>
      <span class="n">{{ snap.processes | length }}</span>
      <span class="desc">OS-level processes Ship spawned on your machine</span>
    </header>
    {% if snap.processes | length == 0 %}
      <div class="empty">No process info available.</div>
    {% else %}
      <table>
        <thead>
          <tr><th></th><th>Name</th><th>Role</th><th>Pid</th><th>Detail</th></tr>
        </thead>
        <tbody>
          {% for p in snap.processes %}
          <tr>
            <td><span class="dot" data-state="{{ 'live' if p.alive else 'dead' }}"></span></td>
            <td><strong>{{ p.name }}</strong></td>
            <td><span class="badge">{{ p.role }}</span></td>
            <td class="pid">{{ p.pid }}</td>
            <td class="muted" style="font-size: 11px;">
              {%- if p.version -%}{{ p.version }}{%- endif -%}
              {%- if p.log -%} · {{ p.log }}{%- endif -%}
              {%- if p.parent -%}parent pid {{ p.parent }}{%- if p.parent_cmd %} ({{ p.parent_cmd }}){% endif %}{%- endif -%}
              {%- if p.cmdline_preview -%}<code style="font-family: var(--font-mono);">{{ p.cmdline_preview }}</code>{%- endif -%}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </section>

  <section>
    <header>
      <h2>Integrations</h2>
      <span class="n">{{ snap.integrations | length }}</span>
      <span class="desc">external bridges + channel capabilities</span>
    </header>
    <table>
      <thead><tr><th></th><th>Name</th><th>Kind</th><th>Hint</th></tr></thead>
      <tbody>
        {% for i in snap.integrations %}
        <tr>
          <td><span class="dot" data-state="{{ 'live' if i.active else 'dead' }}"></span></td>
          <td><strong>{{ i.name }}</strong></td>
          <td><span class="badge">{{ i.kind }}</span></td>
          <td class="muted">{{ i.hint }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>
<script type="module">
  // Light auto-refresh — re-pull every 5s. Cheap, server-rendered,
  // datastar-free since this view is read-only sanity check.
  const refresh = () => {
    fetch(window.location.pathname + '?fragment=true', { credentials: 'same-origin' })
      .then(r => r.text())
      .then(html => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const fresh = doc.querySelector('.ship-mesh');
        if (fresh) document.querySelector('.ship-mesh')?.replaceWith(fresh);
      })
      .catch(() => {});
  };
  const id = setInterval(refresh, 5000);
  document.addEventListener('ship:before-mount', () => clearInterval(id), { once: true });
</script>
{% if not fragment %}
</body>
</html>
{% endif %}
