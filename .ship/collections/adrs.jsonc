{
  "id": "adrs",
  "name": "Architecture Decisions",
  "fields": {
    "title":        { "type": "string",   "required": true, "filterable": true },
    "status":       { "type": "enum",     "values": ["proposed", "accepted", "superseded", "deprecated"], "filterable": true, "default": "proposed" },
    "context":      { "type": "markdown" },
    "decision":     { "type": "markdown" },
    "consequences": { "type": "markdown" }
  }
}
