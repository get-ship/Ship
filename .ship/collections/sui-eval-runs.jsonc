{
  // Per-lane scores from .ship/skills/sui-eval.jsonc.
  //
  // One row per (run_id, lane_id). Lanes vary by model + harness; the same
  // task spec is dispatched across all of them. The grade step writes the
  // jsonl artifact; the record step replays it into this collection so the
  // data is queryable from views (e.g. views/eval/runs).
  "id": "sui-eval-runs",
  "name": "SUI Eval Runs",
  "fields": {
    "run_id":    { "type": "string", "required": true, "filterable": true },
    "lane_id":   { "type": "string", "required": true, "filterable": true },
    "model":     { "type": "string", "filterable": true },
    "harness":   { "type": "string", "filterable": true },
    "composite": { "type": "number", "filterable": true },
    "compile_passed": { "type": "boolean", "filterable": true },
    "lint_errors":    { "type": "number" },
    "lint_warnings":  { "type": "number" },
    "worktree":       { "type": "string" },
    "view_files":     { "type": "json" },
    "css_violations": { "type": "json" },
    "missing_fragments": { "type": "json" }
  }
}
