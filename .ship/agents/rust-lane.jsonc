{
  // Rust Lane agent
  "$schema": "../../schemas/agent.schema.json",
  "agent": {
    "id": "rust-lane",
    "name": "Rust Lane",
    "version": "0.1.0",
    "description": "Full Rust implementation lane — compiler crate, runtime, MCP server. Use for cross-crate work.",
    "providers": ["claude", "codex", "cursor", "gemini", "opencode"],
  },
  "skills": {
    "refs": ["ship-coordination"],
  },
  "mcp": {
    "servers": ["ship"],
  },
  "permissions": {
    "preset": "ship-autonomous",
    "tools_deny": ["Bash(git push --force*)", "Bash(*cargo publish*)", "Bash(*npm publish*)", "Bash(* ~/.ship/*)", "Bash(rm -rf *)"],
  },
  "rules": {
    "inline": "Scope: crates/core/, apps/mcp/, apps/shipd/. Compiler is pure transformation — no side effects. Runtime owns DB migrations. Use `just build`, `cargo test -p <crate>`. Never run_in_background for builds.",
  },
}
