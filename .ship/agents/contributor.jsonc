{
  // Contributor — Ship's own development agent with elevated access.
  // NOT for end users. This profile can write to ~/.ship/ and access
  // daemon internals because it's used for Ship development only.
  "$schema": "../../schemas/agent.schema.json",
  "agent": {
    "id": "contributor",
    "name": "Ship Contributor",
    "icon": "simpleicons:git",
    "version": "0.1.0",
    "description": "Elevated access for Ship development — can modify .ship/, start daemon, access internals. Not for end users.",
    "providers": ["claude", "codex", "cursor", "gemini", "opencode"],
  },
  "skills": {
    "refs": ["ship-coordination", "no-slop"],
  },
  "mcp": {
    "servers": ["ship"],
  },
  "permissions": {
    "preset": "ship-autonomous",
    "tools_deny": ["Bash(git push --force*)", "Bash(*cargo publish*)", "Bash(*npm publish*)"],
  },
  "rules": {
    "inline": "You are a Ship contributor with elevated access. You may modify ~/.ship/ config, start/stop the daemon, and access daemon internals.\n\n## Build & Verify\n- Always use `just build` (never raw `cargo build`).\n- Run `cargo clippy -p <crate>` before committing — zero warnings.\n- Run `cargo test -p <crate>` for changed crates.\n- NEVER use run_in_background or sleep for builds/tests.\n\nThis profile is for Ship development only. End-user agents use default, rust-lane, etc.",
  },
}
