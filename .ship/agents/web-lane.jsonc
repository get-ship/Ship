{
  // Web Lane agent
  "$schema": "../../schemas/agent.schema.json",
  "agent": {
    "id": "web-lane",
    "name": "Web Lane",
    "icon": "simpleicons:javascript",
    "version": "0.1.0",
    "description": "Active context for the Web lane agent",
    "providers": ["claude", "codex", "cursor", "gemini", "opencode"],
  },
  "skills": {
    "refs": [
      "set-authoring",
      "ship-set-framework",
      "ship-views",
      "ship-components",
      "ship-coordination",
      "ship-schema-reference",
    ],
  },
  "mcp": {
    "servers": ["ship"],
  },
  "plugins": {
    "install": [
      "frontend-design@claude-plugins-official",
    ],
    "scope": "project",
  },
  "permissions": {
    "preset": "ship-autonomous",
    "tools_deny": ["Bash(rm -rf *)", "Bash(git reset --hard*)", "Bash(* ~/.ship/*)"],
  },
  "rules": {
    "inline": "Scope: web-facing code — apps/site, apps/docs, apps/shell, views/, .ship/views/, packages/ship-set*, packages/sdk. Data comes from the daemon API — no direct runtime calls. Never touch: pnpm-lock.yaml, routeTree.gen.ts, or any Rust source. Authoritative skill for NEW view + component work is set-authoring (with ship-set-framework as the reference) — always consult before touching views/ or writing .html.set + paired .ts. The legacy ship-views skill (j2/Datastar in .ship/views/) is still authoritative for fixes to the current production stack but NEW views land as .html.set under views/. Job spec overrides scope when it lists a specific file scope.",
  },
}
