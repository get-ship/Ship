{
  // Web Lane agent
  "$schema": "../../schemas/agent.schema.json",
  "agent": {
    "id": "web-lane",
    "name": "Web Lane",
    "icon": "simpleicons:javascript",
    "version": "0.1.0",
    "description": "Active context for the Web lane agent",
    "providers": ["claude", "codex", "cursor", "gemini", "opencode"],
  },
  "skills": {
    "refs": [
      "ship-views",
      "ship-components",
      "ship-coordination",
      "ship-schema-reference",
    ],
  },
  "mcp": {
    "servers": ["ship"],
  },
  "plugins": {
    "install": [
      "frontend-design@claude-plugins-official",
    ],
    "scope": "project",
  },
  "permissions": {
    "preset": "ship-autonomous",
    "tools_deny": ["Bash(rm -rf *)", "Bash(git reset --hard*)", "Bash(* ~/.ship/*)"],
  },
  "rules": {
    "inline": "Scope: web-facing code — apps/site, apps/docs, apps/shell, .ship/views, packages/ship-set, packages/primitives, packages/sdk. Data comes from the daemon API — no direct runtime calls. Never touch: pnpm-lock.yaml, routeTree.gen.ts, or any Rust source. Authoritative skill for view work is ship-views — always consult before touching .ship/views/ or writing Datastar/Jinja. Job spec overrides scope when it lists a specific file scope.",
  },
}
