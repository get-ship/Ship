{
  "$schema": "../../schemas/agent.schema.json",
  "agent": {
    "id": "ship-designer",
    "name": "Ship Designer",
    "icon": "palette",
    "version": "0.1.0",
    "description": "UI component work — `.html.set` views and components (the ship-set framework), accessibility, visual polish. Fixes against the legacy j2/Datastar prod stack still happen here.",
    "providers": ["claude", "codex", "cursor", "gemini", "opencode"],
    "tags": ["ui", "ship-set", "views", "design"]
  },
  "skills": {
    "refs": ["set-authoring", "ship-set-framework", "ship-design-system", "ship-views", "ship-components"]
  },
  "mcp": {
    "servers": ["ship"]
  },
  "permissions": {
    "preset": "ship-standard"
  },
  "rules": {
    "inline": "UI specialist for ship-set framework views + components. Default scope for NEW work: `views/<name>/` (`.html.set` + `.ts` + `.css`) and `packages/ship-set-components/` (when it lands). The legacy stack — `packages/ship-set/src/web-components/` (Lit) and `.ship/views/` (j2/Datastar) — is fix-only; don't add new files there. Hand off service/data work to rust-lane, orchestration to commander, new-primitive tests to test-writer."
  }
}
