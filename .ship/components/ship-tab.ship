<script>
  // <ship-tab> is a declarative data-carrier child of <ship-tabs>. The parent
  // queries `:scope > ship-tab` to discover panels and reads `name`, `label`,
  // `count`, `disabled` from each. The element renders nothing on its own.
  const { name = '', label = '', count = null, disabled = false } = props

  onConnect(el => {
    // Hide the host element. SFC scoping doesn't have a `:host` equivalent
    // yet, so set inline display=none directly. (Gap #2 in conversion notes.)
    el.style.display = 'none'
  })
</script>

<!-- ship-tab is a data carrier; its parent renders the tab button -->

