<script>
  // Input + send. Reads pending annotations from the parent modal via
  // a window-level signal bridge (ship:chat:annotate accumulates,
  // ship:chat:annotations:clear empties).
  //
  // Props:
  //   session-id  — target session
  //   placeholder — input placeholder text
  const { sessionId = '', placeholder = 'Message…' } = props

  const $draft = signal('')
  const $sending = signal(false)
  const $annotations = signal([])
  const $error = signal('')

  function onAnnotate(e) {
    const ann = e.detail
    if (!ann) return
    $annotations.set([...$annotations.get(), ann])
  }

  function clearAnnotations() {
    $annotations.set([])
  }

  function removeAnnotation(idx) {
    const next = $annotations.get().slice()
    next.splice(idx, 1)
    $annotations.set(next)
  }

  async function send() {
    const text = $draft.get().trim()
    if (!text || $sending.get() || !props.sessionId) return
    $sending.set(true)
    $error.set('')

    // Optimistic user-turn render — broadcast on window so the
    // sibling <app-agent-thread> can append before the request
    // returns. The annotations[] body extension is wired server-side.
    window.dispatchEvent(new CustomEvent('ship:chat:send', {
      detail: { text, annotations: $annotations.get() }
    }))

    try {
      const body = { text }
      if ($annotations.get().length) body.annotations = $annotations.get()
      const r = await fetch(`/api/v1/sessions/${encodeURIComponent(props.sessionId)}/message`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        credentials: 'include',
      })
      if (!r.ok) throw new Error(`HTTP ${r.status}`)
      $draft.set('')
      clearAnnotations()
    } catch (e) {
      $error.set(String(e?.message ?? e))
    } finally {
      $sending.set(false)
    }
  }

  function onKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      send()
    }
  }

  onConnect(el => {
    el.querySelector('textarea').addEventListener('keydown', onKey)
    window.addEventListener('ship:chat:annotate', onAnnotate)
    window.addEventListener('ship:chat:annotations:clear', clearAnnotations)
  })

  onDisconnect(() => {
    window.removeEventListener('ship:chat:annotate', onAnnotate)
    window.removeEventListener('ship:chat:annotations:clear', clearAnnotations)
  })
</script>

<div class="composer">
  <div class="annotations" data-show="$annotations.length > 0">
    <template data-for="(ann, i) in $annotations" data-key="i">
      <button type="button" class="chip" data-on:click="removeAnnotation(i)">
        <span class="chip-kind" data-text="ann.type"></span>
        <span class="chip-source" data-text="ann.source?.ref || ''"></span>
        <span class="chip-x" aria-hidden="true">×</span>
      </button>
    </template>
  </div>
  <div class="error" data-show="$error" data-text="$error"></div>
  <div class="input-row">
    <textarea
      placeholder="{{ props.placeholder }}"
      data-bind:value="$draft"
      data-attr:disabled="$sending"
      rows="1"></textarea>
    <button type="button" class="send"
            data-on:click="send"
            data-attr:disabled="$sending || !$draft.trim()">
      Send
    </button>
  </div>
</div>

<style>
  .composer {
    display: flex;
    flex-direction: column;
    gap: var(--ship-space-2);
    padding: var(--ship-space-3) var(--ship-space-4);
    border-top: 1px solid var(--ship-color-border);
    background: var(--ship-color-background);
  }
  .annotations { display: flex; flex-wrap: wrap; gap: var(--ship-space-1); }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--ship-space-1);
    padding: var(--ship-space-1) var(--ship-space-2);
    border: 1px solid var(--ship-color-border);
    border-radius: var(--ship-radius-pill, 999px);
    background: var(--ship-color-surface);
    color: var(--ship-color-foreground);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .chip:hover { background: var(--ship-color-accent-soft, var(--ship-color-surface)); }
  .chip-kind { text-transform: uppercase; font-weight: 600; opacity: 0.7; }
  .chip-x { opacity: 0.6; }
  .error { color: var(--ship-color-danger, var(--ship-color-muted)); font-size: 0.875rem; }
  .input-row { display: flex; align-items: flex-end; gap: var(--ship-space-2); }
  textarea {
    flex: 1;
    min-height: 2.25rem;
    max-height: 10rem;
    padding: var(--ship-space-2) var(--ship-space-3);
    border: 1px solid var(--ship-color-border);
    border-radius: var(--ship-radius-md, 6px);
    background: var(--ship-color-surface);
    color: var(--ship-color-foreground);
    font-family: inherit;
    font-size: inherit;
    resize: vertical;
  }
  .send {
    padding: var(--ship-space-2) var(--ship-space-4);
    border: 1px solid var(--ship-color-accent);
    border-radius: var(--ship-radius-md, 6px);
    background: var(--ship-color-accent);
    color: var(--ship-color-on-accent, white);
    cursor: pointer;
    font-family: inherit;
  }
  .send:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
