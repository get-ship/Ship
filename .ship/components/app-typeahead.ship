<script>
  const { placeholder = 'Search...', fetchUrl, minChars = 1, debounceMs = 200 } = props

  const $query = signal('')
  const $items = signal([])
  const $loading = signal(false)
  const $activeIndex = signal(-1)
  const $open = signal(false)

  let timer
  effect($query, () => {
    clearTimeout(timer)
    if ($query.get().length < minChars) { $items.set([]); return }
    timer = setTimeout(async () => {
      $loading.set(true)
      const resp = await fetch(`${props.fetchUrl}?q=${encodeURIComponent($query.get())}`)
      $items.set(await resp.json())
      $activeIndex.set(-1)
      $loading.set(false)
    }, debounceMs)
  })

  function onKey(e) {
    if (!$open.get()) return
    const items = $items.get(), i = $activeIndex.get()
    if (e.key === 'ArrowDown') { e.preventDefault(); $activeIndex.set(Math.min(i + 1, items.length - 1)) }
    else if (e.key === 'ArrowUp') { e.preventDefault(); $activeIndex.set(Math.max(i - 1, 0)) }
    else if (e.key === 'Enter' && i >= 0) { emit('select', items[i]); $open.set(false) }
    else if (e.key === 'Escape') $open.set(false)
  }

  onConnect(el => el.querySelector('input').addEventListener('keydown', onKey))
</script>

<div class="typeahead">
  <input
    type="text"
    placeholder="{{ props.placeholder }}"
    data-bind:value="$query"
    data-on:input="$open = true"
    data-on:focus="$open = true"
    aria-autocomplete="list"
    data-attr:aria-expanded="$open"
  />

  <ul role="listbox" class="suggestions" data-show="$open">
    <li class="loading" data-show="$loading">Loading...</li>
    <li class="empty" data-show="!$loading && $items.length === 0 && $query.length >= minChars">No matches</li>

    <template data-for="(item, i) in $items" data-key="item.id">
      <li
        role="option"
        data-attr:aria-selected="i === $activeIndex"
        data-class:active="i === $activeIndex"
        data-on:mousedown="emit('select', item); $open = false"
      >
        <slot name="item" item="item" query="$query">
          <span data-text="item.label"></span>
        </slot>
      </li>
    </template>
  </ul>
</div>

<style>
  .typeahead { position: relative; }
  .suggestions { position: absolute; top: 100%; left: 0; right: 0; background: var(--ship-color-surface); }
  .suggestions li.active { background: var(--ship-color-accent); }
</style>
