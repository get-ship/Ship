<script>
  // Wraps <ship-terminal> + the daemon's session SSE/input/resize rails.
  // Drop on a page with `actor-id="<ulid>"` and you get a live xterm-
  // backed view of that actor's PTY. Output streams in via SSE; user
  // keystrokes batch + POST to /input; resize POSTs to /resize whenever
  // xterm reports a layout change.
  //
  // Props:
  //   actor-id  — required; the session whose PTY we attach to
  //   readonly  — read-only attach (no input forwarding); useful for
  //               the mesh view's debug attach
  //   on-exit   — "keep" (default) | "hide" | "remove" — what to do
  //               when the SSE closes (child exited)
  const { actorId = '', readonly = false, onExit = 'keep' } = props

  const $connecting = signal(true)
  const $exited = signal(false)
  const $error = signal('')

  let term = null            // <ship-terminal>
  let source = null          // EventSource
  let inputBuffer = ''
  let inputInflight = false
  let inputTimer = null
  let lastCols = 0
  let lastRows = 0

  function flushInput(actor) {
    if (inputInflight || !inputBuffer || !actor) return
    inputInflight = true
    const data = inputBuffer
    inputBuffer = ''
    fetch(`/api/v1/sessions/${encodeURIComponent(actor)}/input`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ data }),
    }).catch(() => { /* dropped keystrokes — best-effort */ })
      .finally(() => {
        inputInflight = false
        if (inputBuffer) flushInput(actor)
      })
  }

  function postResize(actor, cols, rows) {
    if (!actor || cols === lastCols && rows === lastRows) return
    lastCols = cols
    lastRows = rows
    fetch(`/api/v1/sessions/${encodeURIComponent(actor)}/resize`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ cols, rows }),
    }).catch(() => { /* mesh-view debug attach may hit 501; ignore */ })
  }

  function attach(host) {
    const actor = props.actorId
    if (!actor) { $error.set('actor-id is required'); return }
    if (!term) return
    detach()
    $connecting.set(true)
    $exited.set(false)
    $error.set('')

    source = new EventSource(`/api/v1/sessions/${encodeURIComponent(actor)}/stream`, { withCredentials: true })
    source.addEventListener('open', () => $connecting.set(false))
    source.addEventListener('error', () => {
      // EventSource fires error on close too; reflect as exit if we
      // were connected, else treat as failed connect.
      if (!$connecting.get()) $exited.set(true)
      else $error.set('connection failed')
      emit('exit', { actorId: actor })
      if (props.onExit === 'hide') host.style.display = 'none'
      if (props.onExit === 'remove') host.remove()
    })
    source.addEventListener('bytes', (ev) => term.write(ev.data))

    if (!props.readonly) {
      term.addEventListener('ship-data', (ev) => {
        inputBuffer += ev.detail?.data ?? ''
        clearTimeout(inputTimer)
        // 16ms ≈ one paint frame; coalesces fast bursts (paste,
        // arrow-key spam) into a single POST without feeling laggy.
        inputTimer = setTimeout(() => flushInput(actor), 16)
      })
    }

    // Initial size sync — xterm fires no resize until it lays out, so
    // poke it with the current cols/rows on the next tick.
    requestAnimationFrame(() => {
      const t = term.terminal
      if (t) postResize(actor, t.cols, t.rows)
    })
    term.addEventListener('ship-resize', (ev) => {
      const { cols, rows } = ev.detail ?? {}
      if (cols && rows) postResize(actor, cols, rows)
    })
  }

  function detach() {
    if (source) { source.close(); source = null }
    inputBuffer = ''
    clearTimeout(inputTimer)
  }

  onConnect(host => {
    term = host.querySelector('ship-terminal')
    if (term && term.updateComplete) {
      term.updateComplete.then(() => attach(host))
    } else {
      attach(host)
    }
  })

  onDisconnect(() => detach())
</script>

<div class="pty-attach">
  <div class="state" data-show="$connecting">connecting…</div>
  <div class="state error" data-show="$error" data-text="$error"></div>
  <div class="state exited" data-show="$exited && !$error">stream closed</div>
  <ship-terminal
    fit
    data-attr:rows="props.rows || 24"
    data-attr:cols="props.cols || 120"
    data-attr:readonly="props.readonly ? 'readonly' : null"></ship-terminal>
</div>

<style>
  :host { display: flex; flex-direction: column; height: 100%; min-height: 0; }
  .pty-attach {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    background: var(--ship-color-surface);
    border: 1px solid var(--ship-color-border);
    border-radius: var(--ship-radius-md, 6px);
    overflow: hidden;
  }
  ship-terminal {
    flex: 1;
    min-height: 0;
  }
  .state {
    padding: var(--ship-space-2) var(--ship-space-3);
    font-size: 0.875rem;
    color: var(--ship-color-muted);
    border-bottom: 1px solid var(--ship-color-border);
  }
  .state.error { color: var(--ship-color-danger, var(--ship-color-muted)); }
  .state.exited { color: var(--ship-color-muted); font-style: italic; }
</style>
