<script>
  // <ship-tab-panel> is a child of <ship-tabs>. Visible when its `name`
  // matches the parent's `active`. The parent sets `active` (boolean)
  // on each panel as the active tab changes; we read `active` to control
  // visibility.
  const { name = '', active = false } = props

  onConnect(el => {
    // ARIA + identity setup. Mirrors the original LitElement behavior so
    // <ship-tabs> can wire aria-controls/aria-labelledby by ID convention.
    if (!el.hasAttribute('role')) el.setAttribute('role', 'tabpanel')
    if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0')
    if (name && !el.id) el.id = `ship-tabpanel-${name}`
    if (name) el.setAttribute('aria-labelledby', `ship-tab-${name}`)
  })
</script>

<slot></slot>

<style>
  /* The host is shown/hidden based on the `active` attribute the parent
     sets. Scoped to this component so global `[hidden]` rules can't
     interfere. */
  :host([active]) { display: block; }
  :host(:not([active])) { display: none; }
</style>
