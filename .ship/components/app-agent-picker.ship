<script>
  // Agent + provider picker for the chat modal. Renders before a
  // session is established; on selection emits `select` with
  // {agentId, provider} for the parent (<app-agent-modal>) to spawn-
  // or-attach against.
  //
  // Props (auto-signal: $defaultAgent / $defaultProvider work directly)
  //   default-agent     — pre-select this id
  //   default-provider  — pre-select this provider id
  //
  // Emits:
  //   select  — { agentId, provider }
  //   cancel  — operator dismissed without picking
  const { defaultAgent = '', defaultProvider = '' } = props

  // Mount-time fetches. AbortSignal wired to disconnectedCallback so
  // unmounting mid-request cancels cleanly.
  const $agentsResp = data(({ signal }) =>
    fetch('/api/v1/agents', { signal, credentials: 'same-origin' })
      .then(r => r.json())
  )
  const $providersResp = data(({ signal }) =>
    fetch('/api/v1/providers/installed', { signal, credentials: 'same-origin' })
      .then(r => r.json())
  )

  // Selection — internal state, separate from the prop defaults.
  const $agentId = signal('')
  const $provider = signal('')

  // Derive the selectable lists from the fetch results. The
  // /agents endpoint returns { ok, items }; /providers/installed
  // returns { providers }.
  const $agents = signal([])
  const $providers = signal([])
  effect($agentsResp, () => {
    const r = $agentsResp.get()
    if (!r) return
    const list = r.items ?? r.data?.agents ?? r.data ?? []
    $agents.set(list)
    if (!$agentId.get()) {
      const want = props.defaultAgent
      $agentId.set(list.find(a => a.id === want) ? want : (list[0]?.id ?? ''))
    }
  })
  effect($providersResp, () => {
    const r = $providersResp.get()
    if (!r) return
    const list = r.providers ?? []
    $providers.set(list)
    if (!$provider.get()) {
      const want = props.defaultProvider
      $provider.set(list.includes(want) ? want : (list[0] ?? ''))
    }
  })

  function commit() {
    const agentId = $agentId.get()
    const provider = $provider.get()
    if (!agentId || !provider) return
    emit('select', { agentId, provider })
  }

  function cancel() { emit('cancel') }

  function onKey(e) {
    if (e.key === 'Enter') { e.preventDefault(); commit() }
    if (e.key === 'Escape') { e.preventDefault(); cancel() }
  }

  onConnect(host => host.addEventListener('keydown', onKey))
</script>

<div class="picker">
  <div class="state" data-show="!$agentsResp || !$providersResp">loading…</div>

  <div class="row" data-show="$agentsResp && $providersResp">
    <label class="field">
      <span class="label">Agent</span>
      <select data-bind:value="$agentId">
        <template data-for="a in $agents" data-key="a.id">
          <option data-attr:value="a.id" data-text="a.id"></option>
        </template>
      </select>
    </label>

    <label class="field">
      <span class="label">Provider</span>
      <select data-bind:value="$provider">
        <template data-for="p in $providers" data-key="p">
          <option data-attr:value="p" data-text="p"></option>
        </template>
      </select>
    </label>
  </div>

  <div class="actions" data-show="$agentsResp && $providersResp">
    <button type="button" class="ghost" data-on:click="cancel">Cancel</button>
    <button type="button" class="primary"
            data-on:click="commit"
            data-attr:disabled="!$agentId || !$provider">
      Start chat
    </button>
  </div>
</div>

<style>
  .picker {
    display: flex;
    flex-direction: column;
    gap: var(--ship-space-3);
    padding: var(--ship-space-4);
  }
  .state { color: var(--ship-color-muted); font-size: 0.875rem; }
  .row { display: flex; gap: var(--ship-space-3); flex-wrap: wrap; }
  .field { display: flex; flex-direction: column; gap: var(--ship-space-1); flex: 1; min-width: 12rem; }
  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ship-color-muted);
  }
  select {
    padding: var(--ship-space-2) var(--ship-space-3);
    border: 1px solid var(--ship-color-border);
    border-radius: var(--ship-radius-md, 6px);
    background: var(--ship-color-surface);
    color: var(--ship-color-foreground);
    font-family: inherit;
    font-size: inherit;
  }
  .actions { display: flex; justify-content: flex-end; gap: var(--ship-space-2); }
  button {
    padding: var(--ship-space-2) var(--ship-space-4);
    border-radius: var(--ship-radius-md, 6px);
    font-family: inherit;
    cursor: pointer;
  }
  .ghost { background: transparent; border: 1px solid var(--ship-color-border); color: var(--ship-color-foreground); }
  .primary { background: var(--ship-color-accent); color: var(--ship-color-on-accent, white); border: 1px solid var(--ship-color-accent); }
  .primary:disabled, .ghost:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
