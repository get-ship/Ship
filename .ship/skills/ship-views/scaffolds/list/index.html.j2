{% from '_ship.html.j2' import head, chrome, signal, show, for_each %}
{% set items = ship.agents.summaries().items %}
<!DOCTYPE html>
<html>
<head>{{ head('{{TITLE}}') }}</head>
<body>
<ship-view-chrome title="{{TITLE}}"></ship-view-chrome>
<div class="ship-view" style="padding: 24px; max-width: 960px; margin: 0 auto;">
  <ship-card>
    <ship-list>
      {% for item in items %}
        <ship-list-tile
          label="{{ item.label }}"
          description="{{ item.description|default('') }}"
        ></ship-list-tile>
      {% endfor %}
    </ship-list>
  </ship-card>
</div>
</body>
</html>
