<div class="ship-view ship-view-{{NAME}}">
  <header>
    <h1>{{TITLE}}</h1>
  </header>
  <main>
    {#while-loading of items}
      <sui-skeleton shape="line" size="md"></sui-skeleton>
    {/while-loading}
    {#while-error err of items}
      <sui-error-state variant="default" size="md" title="Couldn't load items">
        {err.message}
      </sui-error-state>
    {/while-error}
    {#if items().kind === 'ok'}
      <ul>
        {#for item of items().value key={item.id}}
          <li>{item.name}</li>
        {/for}
      </ul>
    {/if}
  </main>
</div>
