{% from '_ship.html.j2' import head, signal %}
<!DOCTYPE html>
<html>
<head>{{ head('{{TITLE}}') }}</head>
<body>
<ship-view-chrome title="{{TITLE}}"></ship-view-chrome>
<div
  class="ship-view"
  style="padding: 24px; max-width: 560px; margin: 0 auto;"
  {{ signal('form', {'name': '', 'note': ''}) }}
>
  <ship-card style="padding: 24px; display: grid; gap: 16px;">
    <h2 style="margin: 0;">{{TITLE}}</h2>
    <label style="display: grid; gap: 6px;">
      <span>Name</span>
      <ship-input data-bind="form.name" placeholder="..."></ship-input>
    </label>
    <label style="display: grid; gap: 6px;">
      <span>Note</span>
      <ship-textarea data-bind="form.note" placeholder="..."></ship-textarea>
    </label>
    <ship-button variant="primary" data-on-click="@post('/api/your-endpoint')">
      Save
    </ship-button>
  </ship-card>
</div>
</body>
</html>
