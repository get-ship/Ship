<div class="ship-view ship-view-{{NAME}}">
  <header>
    <h1>{{TITLE}}</h1>
  </header>
  <main>
    <form mutation="ship.{{NAME}}.submit" on:success={() => submitted.set(true)}>
      <sui-input name="title" placeholder="Title" required></sui-input>
      <sui-textarea name="body" placeholder="Body" rows="4"></sui-textarea>
      <div class="actions">
        <sui-button type="submit" variant="primary">Save</sui-button>
        {#if submitted()}
          <sui-badge tone="success" variant="soft">Saved</sui-badge>
        {/if}
      </div>
    </form>
  </main>
</div>
