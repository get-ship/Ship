<div class="ship-view ship-view-{{NAME}}">
  <header>
    <h1>{{TITLE}}</h1>
  </header>
  <main class="grid">
    <sui-card padding="md">
      <h2 slot="header">Metric A</h2>
      <p class="metric">{metricA() ?? '—'}</p>
    </sui-card>
    <sui-card padding="md">
      <h2 slot="header">Metric B</h2>
      <p class="metric">{metricB() ?? '—'}</p>
    </sui-card>
    <sui-card padding="md">
      <h2 slot="header">Recent activity</h2>
      <ul>
        {#for entry of recent() key={entry.id}}
          <li>{entry.label}</li>
        {/for}
      </ul>
    </sui-card>
  </main>
</div>
