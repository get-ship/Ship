{% from '_ship.html.j2' import head %}
<!DOCTYPE html>
<html>
<head>{{ head('{{TITLE}}') }}</head>
<body>
<ship-view-chrome title="{{TITLE}}"></ship-view-chrome>
<div class="ship-view" style="padding: 24px;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
    <ship-card style="padding: 16px;">
      <h3 style="margin: 0 0 8px;">Tile A</h3>
      <p style="margin: 0; color: var(--muted-foreground);">Replace with a real metric.</p>
    </ship-card>
    <ship-card style="padding: 16px;">
      <h3 style="margin: 0 0 8px;">Tile B</h3>
      <p style="margin: 0; color: var(--muted-foreground);">Replace with a real metric.</p>
    </ship-card>
    <ship-card style="padding: 16px;">
      <h3 style="margin: 0 0 8px;">Tile C</h3>
      <p style="margin: 0; color: var(--muted-foreground);">Replace with a real metric.</p>
    </ship-card>
  </div>
</div>
</body>
</html>
