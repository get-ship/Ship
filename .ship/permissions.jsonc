{
  // Ship permission presets — strict → loose continuum.
  "$schema": "../schemas/permissions.schema.json",
  //
  // Referenced via: "permissions": { "preset": "<name>" }
  // Presets are templates, not security boundaries.
  //
  // ── HARD RULES (all presets) ──────────────────────────────────────────
  //
  // ~/.ship/ is the platform database. It contains project state, event
  // stores, artifacts, and configuration. NO agent may delete, overwrite,
  // or rm -rf anything under ~/.ship/ without explicit human confirmation.
  //
  // Violations: deleting platform.db, wiping artifacts/specs, removing
  // project entries. These are production data — treat them as such.
  //
  // The base deny rules below apply to EVERY preset. Individual presets
  // may add more denials but cannot remove these.

  "_base_deny": [
    // Never delete platform state
    "Bash(rm */.ship/*)",
    "Bash(rm -r */.ship/*)",
    "Bash(rm -rf */.ship/*)",
    "Bash(rm *~/.ship/*)",
    "Bash(rm -r *~/.ship/*)",
    "Bash(rm -rf *~/.ship/*)",
    "Bash(rm */home/*/.ship/*)",
    "Bash(rm -r */home/*/.ship/*)",
    "Bash(rm -rf */home/*/.ship/*)",
  ],

  "ship-readonly": {
    // Read-only analysis. Reviewer agents, gate agents, auditors, tutors.
    "default_mode": "plan",
    "tools_allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ship *)",
      "mcp__ship__*",
      "mcp__*__read*",
      "mcp__*__list*",
      "mcp__*__search*",
    ],
    "tools_deny": [
      "Write(*)",
      "Edit(*)",
      "Bash(rm*)",
      // Platform state protection (inherited from _base_deny)
      "Bash(rm */.ship/*)",
      "Bash(rm -r*/.ship/*)",
      "Bash(rm -rf*/.ship/*)",
    ],
  },

  "ship-standard": {
    // Interactive sessions. Human-paired work, commander, brainstorming.
    "default_mode": "default",
    "tools_allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ship *)",
      "mcp__ship__*",
    ],
    "tools_deny": [
      "Write(apps/**/migrations/**/*.sql)",
      "Edit(apps/**/migrations/**/*.sql)",
      // Platform state protection
      "Bash(rm */.ship/*)",
      "Bash(rm -r*/.ship/*)",
      "Bash(rm -rf*/.ship/*)",
    ],
  },

  "ship-autonomous": {
    // Dispatched specialist agents in worktrees. Zero prompts.
    // Deny list is a guardrail, not a security boundary. Real security = worktree isolation + gate review.
    "default_mode": "dontAsk",
    "tools_allow": [
      "Read", "Write", "Edit", "Glob", "Grep",
      "Bash(*)",
      "mcp__ship__*",
    ],
    "tools_deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git push*)",
      "Bash(cargo publish*)",
      "Bash(npm publish*)",
      "Write(apps/**/migrations/**/*.sql)",
      "Edit(apps/**/migrations/**/*.sql)",
      // Platform state protection
      "Bash(rm */.ship/*)",
      "Bash(rm -r*/.ship/*)",
      "Bash(rm -rf*/.ship/*)",
    ],
  },

  "ship-elevated": {
    // Deploy and release agents. Unlocks git push and publish.
    "default_mode": "dontAsk",
    "tools_allow": [
      "Read", "Write", "Edit", "Glob", "Grep",
      "Bash(*)",
      "mcp__ship__*",
    ],
    "tools_deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Write(apps/**/migrations/**/*.sql)",
      "Edit(apps/**/migrations/**/*.sql)",
      // Platform state protection
      "Bash(rm */.ship/*)",
      "Bash(rm -r*/.ship/*)",
      "Bash(rm -rf*/.ship/*)",
    ],
  },
}
