{
  "$schema": "../schemas/mcp.schema.json",
  "schema_version": "1",
  "mcp": {
    "servers": {
      "antigravity": {
        "id": "",
        "name": "Antigravity",
        "command": "antigravity",
        "args": [
          "mcp"
        ],
        "scope": "project",
        "server_type": "stdio",
        "disabled": true,
        "env": {}
      },
      "rust-docs": {
        "id": "",
        "name": "Rust Docs Bridge",
        "command": "",
        "args": [],
        "scope": "project",
        "server_type": "http",
        "url": "http://127.0.0.1:7771/mcp",
        "disabled": true,
        "env": {}
      },
      "frontend-docs": {
        "id": "",
        "name": "Frontend Docs Bridge",
        "command": "",
        "args": [],
        "scope": "project",
        "server_type": "http",
        "url": "http://127.0.0.1:7772/mcp",
        "disabled": true,
        "env": {}
      },
      "mcp-docs": {
        "id": "",
        "name": "MCP Docs Bridge",
        "command": "",
        "args": [],
        "scope": "project",
        "server_type": "http",
        "url": "http://127.0.0.1:7773/mcp",
        "disabled": true,
        "env": {}
      },
      "ship": {
        "id": "",
        "name": "Ship",
        "command": "ship",
        "args": [
          "mcp",
          "serve"
        ],
        "scope": "project",
        "server_type": "stdio",
        "disabled": false,
        "timeout_secs": 30,
        "env": {}
      },
      "helm": {
        "id": "",
        "name": "Helm",
        "command": "",
        "args": [],
        "scope": "project",
        "server_type": "http",
        "url": "http://localhost:3000/mcp",
        "disabled": false,
        "env": {}
      },
      "github": {
        "id": "",
        "name": "GitHub MCP",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "scope": "project",
        "server_type": "stdio",
        "disabled": true,
        "env": {
          "GITHUB_TOKEN": "${GITHUB_TOKEN}"
        }
      },
      "playwright": {
        "id": "",
        "name": "Playwright MCP",
        "command": "npx",
        "args": [
          "@playwright/mcp@latest"
        ],
        "scope": "project",
        "server_type": "stdio",
        "disabled": true,
        "env": {}
      }
    }
  }
}