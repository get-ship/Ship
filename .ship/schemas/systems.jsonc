// Systems collection — planning surface for Ship (and any Ship project).
// Each item is one primitive, runtime system, interface, or meta surface.
// The /overview view renders items as draggable nodes; depends_on drives
// arrows between them.
{
  "id": "systems",
  "name": "Ship Systems",
  "fields": {
    "name":          { "type": "string",   "required": true, "filterable": true },
    "layer":         { "type": "enum",     "values": ["primitive", "runtime", "interface", "meta"], "filterable": true },
    "status":        { "type": "enum",     "values": ["spec", "building", "shipping", "complete"], "filterable": true, "default": "spec" },
    "summary":       { "type": "string" },
    "current_state": { "type": "markdown" },
    "desired_state": { "type": "markdown" },
    "gaps":          { "type": "array" },
    "diagram":       { "type": "markdown" },
    "doc_skill":     { "type": "string",  "filterable": true },
    "code_paths":    { "type": "array" },
    "depends_on":    { "type": "array",   "filterable": true },
    "position_x":    { "type": "number" },
    "position_y":    { "type": "number" }
  }
}
