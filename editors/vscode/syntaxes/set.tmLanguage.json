{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sail Set",
  "scopeName": "source.set",
  "fileTypes": ["set"],
  "patterns": [
    { "include": "#script-block" },
    { "include": "#template-block" },
    { "include": "#style-block" },
    { "include": "#html-comment" }
  ],
  "repository": {
    "html-comment": {
      "name": "comment.block.html.set",
      "begin": "<!--",
      "end": "-->"
    },

    "script-block": {
      "begin": "(<)(script)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.script.set" },
        "3": { "patterns": [{ "include": "#tag-attributes" }] },
        "4": { "name": "punctuation.definition.tag.end.set" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.script.set" },
        "3": { "name": "punctuation.definition.tag.end.set" }
      },
      "name": "meta.embedded.block.set.script",
      "contentName": "source.js",
      "patterns": [
        { "include": "#sail-script-keywords" },
        { "include": "source.js" }
      ]
    },

    "style-block": {
      "begin": "(<)(style)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.style.set" },
        "3": { "patterns": [{ "include": "#tag-attributes" }] },
        "4": { "name": "punctuation.definition.tag.end.set" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.style.set" },
        "3": { "name": "punctuation.definition.tag.end.set" }
      },
      "name": "meta.embedded.block.set.style",
      "contentName": "source.css",
      "patterns": [
        { "include": "source.css" }
      ]
    },

    "template-block": {
      "begin": "(<)(template)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.template.set" },
        "3": { "patterns": [{ "include": "#tag-attributes" }] },
        "4": { "name": "punctuation.definition.tag.end.set" }
      },
      "end": "(</)(template)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.template.set" },
        "3": { "name": "punctuation.definition.tag.end.set" }
      },
      "name": "meta.embedded.block.set.template",
      "patterns": [
        { "include": "#html-comment" },
        { "include": "#template-control-flow" },
        { "include": "#raw-html-block" },
        { "include": "#interpolation" },
        { "include": "#host-tag" },
        { "include": "#tag" }
      ]
    },

    "sail-script-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.sail.set",
          "match": "\\b(prop|state|derived|data|effect|event|mount|unmount|function|component|async|once)\\b"
        },
        {
          "name": "keyword.control.sail.set",
          "match": "\\bon\\s+(form_reset|form_restore|form_disabled|form_associated)\\b"
        },
        {
          "name": "keyword.control.sail.set",
          "match": "\\b(formAssociated)\\b"
        }
      ]
    },

    "tag-attributes": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*=\\s*(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.set" },
            "2": { "name": "string.quoted.set" }
          }
        },
        {
          "name": "entity.other.attribute-name.set",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b"
        }
      ]
    },

    "host-tag": {
      "begin": "(<)(:host)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.host.set" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.set" }
      },
      "patterns": [
        { "include": "#tag-attribute-with-binding" },
        { "include": "#interpolation" }
      ]
    },

    "tag": {
      "begin": "(</?)([a-zA-Z][a-zA-Z0-9-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.set" },
        "2": { "name": "entity.name.tag.set" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.set" }
      },
      "patterns": [
        { "include": "#tag-attribute-with-binding" },
        { "include": "#interpolation" }
      ]
    },

    "tag-attribute-with-binding": {
      "patterns": [
        {
          "match": "\\b(bind|on|use|class|style|transition|in|out|animate)(:)([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "storage.modifier.directive.set" },
            "2": { "name": "punctuation.separator.directive.set" },
            "3": { "name": "entity.other.attribute-name.directive.set" }
          }
        },
        {
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "punctuation.definition.directive.set" },
            "2": { "name": "entity.other.attribute-name.directive.set" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(=)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.set" },
            "2": { "name": "punctuation.separator.key-value.set" }
          }
        },
        {
          "name": "string.quoted.double.set",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.single.set",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#interpolation" }]
        },
        {
          "name": "entity.other.attribute-name.set",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b"
        }
      ]
    },

    "template-control-flow": {
      "patterns": [
        {
          "begin": "(\\{)(#if|#for|#await)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.section.embedded.begin.set" },
            "2": { "name": "keyword.control.directive.set" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.set" }
          },
          "contentName": "source.js",
          "patterns": [
            { "include": "#each-keywords" },
            { "include": "source.js" }
          ]
        },
        {
          "begin": "(\\{)(:elif|:else if|:then|:catch)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.section.embedded.begin.set" },
            "2": { "name": "keyword.control.directive.set" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.set" }
          },
          "contentName": "source.js",
          "patterns": [{ "include": "source.js" }]
        },
        {
          "match": "(\\{)(:else|:empty)(\\})",
          "captures": {
            "1": { "name": "punctuation.section.embedded.begin.set" },
            "2": { "name": "keyword.control.directive.set" },
            "3": { "name": "punctuation.section.embedded.end.set" }
          }
        },
        {
          "match": "(\\{)(/if|/for|/await)(\\})",
          "captures": {
            "1": { "name": "punctuation.section.embedded.begin.set" },
            "2": { "name": "keyword.control.directive.set" },
            "3": { "name": "punctuation.section.embedded.end.set" }
          }
        }
      ]
    },

    "each-keywords": {
      "patterns": [
        {
          "name": "keyword.operator.directive.set",
          "match": "\\b(of|as|key)\\b"
        }
      ]
    },

    "raw-html-block": {
      "begin": "(\\{@html)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.set" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.set" }
      },
      "contentName": "source.js",
      "patterns": [{ "include": "source.js" }]
    },

    "interpolation": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.set" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.set" }
      },
      "contentName": "source.js",
      "patterns": [{ "include": "source.js" }]
    }
  }
}
