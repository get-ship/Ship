{
  "name": "ship-set",
  "displayName": "ship-set (.set)",
  "description": "Syntax highlighting and language server support for ship-set (.set) component files.",
  "version": "0.1.0",
  "publisher": "ship",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:set"
  ],
  "contributes": {
    "languages": [
      {
        "id": "set",
        "aliases": [
          "ship-set",
          "set"
        ],
        "extensions": [
          ".set",
          ".html.set"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "set",
        "scopeName": "source.set",
        "path": "./syntaxes/set.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ship-set",
      "properties": {
        "ship-set.serverPath": {
          "type": "string",
          "default": "ship-set-lsp",
          "description": "Path to the ship-set-lsp executable. Either an absolute path or a name resolved against PATH."
        },
        "ship-set.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication between VS Code and ship-set-lsp."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "~5.4.5"
  }
}
