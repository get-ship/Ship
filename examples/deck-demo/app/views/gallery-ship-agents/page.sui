<div class="gallery-ship-agents">
  <header class="section-header">
    <h1>ship/agents — Domain Stubs</h1>
    <p class="section-note">
      Pack <strong>ship/agents</strong>. Each card below renders the real custom
      element tag with static mock attribute values so the shell registers and
      paints. A visible badge on each card marks it as a domain stub — no
      <code>ship.*</code> calls, no live data.
    </p>
  </header>

  <!-- ship-agent-card -->
  <section class="stub-section">
    <h2 class="stub-heading">
      <code>ship-agent-card</code>
      <span class="stub-badge">domain-stub — awaits backend spec</span>
    </h2>
    <p class="stub-desc">
      Props: <code>id: string</code>. Slot: <code>trailing</code> (action buttons).
      In production the controller calls <code>ship.agents.detail(&#123; id &#125;)</code>
      via <code>live()</code>; this stub passes a static mock id.
    </p>
    <div class="stub-preview">
      <ship-agent-card id="agent-mock-001">
        <button slot="trailing" class="stub-action">Edit</button>
      </ship-agent-card>
    </div>
  </section>

  <!-- ship-agent-thread -->
  <section class="stub-section">
    <h2 class="stub-heading">
      <code>ship-agent-thread</code>
      <span class="stub-badge">domain-stub — awaits backend spec</span>
    </h2>
    <p class="stub-desc">
      Props: <code>session-id: string</code>. No slots.
      Composes <code>sui-message-list</code> + <code>sui-composer</code>;
      the Ship wrapper owns the session binding and submit handler.
    </p>
    <div class="stub-preview stub-preview--thread">
      <ship-agent-thread session-id="sess-mock-001"></ship-agent-thread>
    </div>
  </section>

  <!-- ship-agents-table -->
  <section class="stub-section">
    <h2 class="stub-heading">
      <code>ship-agents-table</code>
      <span class="stub-badge">domain-stub — awaits backend spec</span>
    </h2>
    <p class="stub-desc">
      No props — data is fetched internally via <code>live()</code> from
      <code>ship.agents.summaries()</code>. Renders a sortable
      <code>sui-table</code> with columns: name, description, source, skills, mcp.
    </p>
    <div class="stub-preview">
      <ship-agents-table></ship-agents-table>
    </div>
  </section>

  <!-- sui-harness-blob — all enum combinations sampled -->
  <section class="stub-section">
    <h2 class="stub-heading">
      <code>sui-harness-blob</code>
      <span class="stub-badge">domain-stub — awaits backend spec</span>
    </h2>
    <p class="stub-desc">
      Props: <code>harness: claude|codex|cursor|gemini|opencode</code>,
      <code>size: sm|md|lg</code>, <code>variant: tile|glyph</code>.
      Slot: default (label text). Inlines brand SVG — no network fetch.
    </p>

    <div class="stub-preview stub-preview--blobs">
      <div class="blob-group">
        <span class="blob-label">tile / md</span>
        <sui-harness-blob harness="claude" size="md" variant="tile">Claude</sui-harness-blob>
        <sui-harness-blob harness="codex" size="md" variant="tile">Codex</sui-harness-blob>
        <sui-harness-blob harness="cursor" size="md" variant="tile">Cursor</sui-harness-blob>
        <sui-harness-blob harness="gemini" size="md" variant="tile">Gemini</sui-harness-blob>
        <sui-harness-blob harness="opencode" size="md" variant="tile">OpenCode</sui-harness-blob>
      </div>

      <div class="blob-group">
        <span class="blob-label">tile / sm</span>
        <sui-harness-blob harness="claude" size="sm" variant="tile">Claude</sui-harness-blob>
        <sui-harness-blob harness="codex" size="sm" variant="tile">Codex</sui-harness-blob>
        <sui-harness-blob harness="cursor" size="sm" variant="tile">Cursor</sui-harness-blob>
        <sui-harness-blob harness="gemini" size="sm" variant="tile">Gemini</sui-harness-blob>
        <sui-harness-blob harness="opencode" size="sm" variant="tile">OpenCode</sui-harness-blob>
      </div>

      <div class="blob-group">
        <span class="blob-label">tile / lg</span>
        <sui-harness-blob harness="claude" size="lg" variant="tile">Claude</sui-harness-blob>
        <sui-harness-blob harness="codex" size="lg" variant="tile">Codex</sui-harness-blob>
        <sui-harness-blob harness="cursor" size="lg" variant="tile">Cursor</sui-harness-blob>
        <sui-harness-blob harness="gemini" size="lg" variant="tile">Gemini</sui-harness-blob>
        <sui-harness-blob harness="opencode" size="lg" variant="tile">OpenCode</sui-harness-blob>
      </div>

      <div class="blob-group">
        <span class="blob-label">glyph / md</span>
        <sui-harness-blob harness="claude" size="md" variant="glyph">Claude</sui-harness-blob>
        <sui-harness-blob harness="codex" size="md" variant="glyph">Codex</sui-harness-blob>
        <sui-harness-blob harness="cursor" size="md" variant="glyph">Cursor</sui-harness-blob>
        <sui-harness-blob harness="gemini" size="md" variant="glyph">Gemini</sui-harness-blob>
        <sui-harness-blob harness="opencode" size="md" variant="glyph">OpenCode</sui-harness-blob>
      </div>
    </div>
  </section>
</div>
