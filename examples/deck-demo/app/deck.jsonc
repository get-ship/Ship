{
  // deck.jsonc for the deck-demo example app.
  // Declares the space scaffold so serve_space finds it and injects DECK_APP_ID.
  "scaffolds": [
    {
      "name": "space",
      "route": "/space/{id}",
      "source": "space-scaffold",
      "assetPrefix": "/space/_assets/",
      "injectGlobals": { "DECK_APP_ID": "$id" }
    }
  ]
}
