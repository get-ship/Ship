    "--shadow-md":      { "layer": "elevation", "intent": "Medium shadow",      "type": "shadow", "default": "0 4px 8px -2px oklch(0 0 0 / 10%), 0 2px 4px -2px oklch(0 0 0 / 6%)", "themable": true },
    "--shadow-lg":      { "layer": "elevation", "intent": "Large shadow",       "type": "shadow", "default": "0 12px 24px -4px oklch(0 0 0 / 10%), 0 4px 8px -4px oklch(0 0 0 / 6%)", "themable": true },
    "--shadow-xl":      { "layer": "elevation", "intent": "Extra-large shadow", "type": "shadow", "default": "0 20px 40px -8px oklch(0 0 0 / 12%)", "themable": true },
    "--shadow-hover":   { "layer": "elevation", "intent": "Hover shadow",       "type": "shadow", "default": "0 2px 6px -1px oklch(0 0 0 / 8%), 0 1px 3px -1px oklch(0 0 0 / 5%)", "themable": true },
