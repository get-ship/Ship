    "--leading-relaxed": { "layer": "primitive", "intent": "Relaxed line-height", "type": "number", "default": "1.7", "themable": false },

    "--font-weight-normal":   { "layer": "primitive", "intent": "Regular weight",   "type": "font-weight", "default": "400", "themable": false },
    "--font-weight-medium":   { "layer": "primitive", "intent": "Medium weight",    "type": "font-weight", "default": "500", "themable": false },
    "--font-weight-semibold": { "layer": "primitive", "intent": "Semibold weight",  "type": "font-weight", "default": "600", "themable": false },
    "--font-weight-bold":     { "layer": "primitive", "intent": "Bold weight",      "type": "font-weight", "default": "700", "themable": false },

    "--tracking-tight":  { "layer": "primitive", "intent": "Tight tracking",  "type": "letter-spacing", "default": "-0.01em", "themable": false },
    "--tracking-normal": { "layer": "primitive", "intent": "Normal tracking", "type": "letter-spacing", "default": "0",       "themable": false },
    "--tracking-wide":   { "layer": "primitive", "intent": "Wide tracking",   "type": "letter-spacing", "default": "0.04em",  "themable": false },
    "--tracking-wider":  { "layer": "primitive", "intent": "Wider tracking",  "type": "letter-spacing", "default": "0.1em",   "themable": false },

    "--ease-out":      { "layer": "motion", "intent": "Expressive default ease",       "type": "easing", "default": "cubic-bezier(0.16, 1, 0.3, 1)",     "themable": true },
    "--ease-out-soft": { "layer": "motion", "intent": "Soft ease for surface fades",   "type": "easing", "default": "cubic-bezier(0.33, 1, 0.68, 1)",    "themable": true },
    "--ease-in":       { "layer": "motion", "intent": "Dismiss/remove ease",           "type": "easing", "default": "cubic-bezier(0.7, 0, 0.84, 0)",     "themable": false },
    "--ease-in-out":   { "layer": "motion", "intent": "Symmetric utility ease",        "type": "easing", "default": "cubic-bezier(0.65, 0, 0.35, 1)",    "themable": false },
    "--ease-spring":   { "layer": "motion", "intent": "Tactile spring feedback",       "type": "easing", "default": "cubic-bezier(0.34, 1.56, 0.64, 1)", "themable": false },

    "--duration-instant":    { "layer": "motion", "intent": "Instant duration",    "type": "duration", "default": "60ms",  "themable": false },
    "--duration-fast":       { "layer": "motion", "intent": "Fast duration",       "type": "duration", "default": "120ms", "themable": true },
    "--duration-medium":     { "layer": "motion", "intent": "Medium duration",     "type": "duration", "default": "180ms", "themable": true },
    "--duration-slow":       { "layer": "motion", "intent": "Slow duration",       "type": "duration", "default": "280ms", "themable": true },
    "--duration-deliberate": { "layer": "motion", "intent": "Deliberate duration", "type": "duration", "default": "420ms", "themable": true },

    "--ring-width":   { "layer": "primitive", "intent": "Focus ring width",   "type": "size",    "default": "3px", "themable": false },
    "--ring-offset":  { "layer": "primitive", "intent": "Focus ring offset",  "type": "size",    "default": "2px", "themable": false },
    "--ring-opacity": { "layer": "primitive", "intent": "Focus ring opacity", "type": "percent", "default": "25%", "themable": false },

    "--hover-strength":    { "layer": "primitive", "intent": "Hover tint strength",    "type": "percent", "default": "6%",  "themable": true },
