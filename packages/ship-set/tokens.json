    "--font-body-app":    { "layer": "typography", "intent": "Body font stack (app)",     "type": "font", "default": "\"DM Sans Variable\", \"DM Sans\", \"Inter\", sans-serif", "themable": false },
    "--font-mono-app":    { "layer": "typography", "intent": "Mono font stack (app)",     "type": "font", "default": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace", "themable": false },
    "--font-display":     { "layer": "typography", "intent": "Display font alias",        "type": "font", "default": "var(--font-display-app)", "themable": true },
    "--font-body":        { "layer": "typography", "intent": "Body font alias",           "type": "font", "default": "var(--font-body-app)",    "themable": true },
