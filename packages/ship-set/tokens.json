    "--z-toast":    { "layer": "primitive", "intent": "Toast z",      "type": "z-index", "default": "50",  "themable": false },
    "--z-max":      { "layer": "primitive", "intent": "Max z",        "type": "z-index", "default": "100", "themable": false },

    "--text-xs":   { "layer": "primitive", "intent": "10.5px",   "type": "size", "default": "10.5px", "themable": false },
    "--text-sm":   { "layer": "primitive", "intent": "12px",     "type": "size", "default": "12px",   "themable": false },
    "--text-base": { "layer": "primitive", "intent": "13px",     "type": "size", "default": "13px",   "themable": false },
    "--text-md":   { "layer": "primitive", "intent": "14px",     "type": "size", "default": "14px",   "themable": false },
