    "--density-row-gap": { "layer": "density", "intent": "Row gap",                "type": "space", "default": "var(--space-2)",  "themable": true },
    "--density-text":    { "layer": "density", "intent": "Row text size",          "type": "size",  "default": "var(--text-base)","themable": true },
    "--density-icon":    { "layer": "density", "intent": "Row icon size",          "type": "size",  "default": "16px",            "themable": true },

