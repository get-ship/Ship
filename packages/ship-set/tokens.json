    "--text-3xl":  { "layer": "primitive", "intent": "28px",     "type": "size", "default": "28px",   "themable": false },
    "--text-4xl":  { "layer": "primitive", "intent": "36px",     "type": "size", "default": "36px",   "themable": false },

    "--leading-tight":   { "layer": "primitive", "intent": "Tight line-height",   "type": "number", "default": "1.2", "themable": false },
