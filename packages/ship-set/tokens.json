{
  "$schema": "https://ship.design/schemas/tokens.schema.json",
  "version": "0.1.0",
  "description": "Canonical machine-readable spec for Ship's design tokens. Mirrors packages/ship-set/src/tokens.css. Use this as the source of truth for generating design assets (Figma tokens, IDE autocomplete), linting component CSS, and authoring themes.",
  "layers": {
    "primitive": { "description": "Raw scale: spacing, radii, z-index, typography scale, motion curves, durations. Rarely the right override point.", "order": 1 },
    "palette": { "description": "Canonical brand palette: --background, --foreground, --card, --primary, --accent, etc. Themes almost always override this layer.", "order": 2 },
    "surface": { "description": "Semantic surfaces and intents: --surface-0..3, --backdrop, --hover-bg, --selected-bg, --divider.", "order": 3 },
    "tone": { "description": "Tone ramps built from palette bases: --tone-{name}-{fg|bg|bg-solid|border|ring}.", "order": 4 },
    "typography": { "description": "Role tokens for headings, body, labels, mono: --heading-font, --label-tracking, etc.", "order": 5 },
    "motion": { "description": "Motion role tokens: --ease-*, --duration-*.", "order": 6 },
    "density": { "description": "Density channel: --density-row-py, --density-icon, etc. Row-shaped components read these.", "order": 7 },
    "elevation": { "description": "Shadow vocabulary: --shadow-xs..xl, --shadow-hover, --shadow-sticky, --shadow-accent.", "order": 8 },
    "sidebar": { "description": "Legacy Studio sidebar palette. Predates --surface-*; retained for compat.", "order": 9 },
    "status": { "description": "Chart/data-viz colors. Independent from feedback tones.", "order": 10 }
  },
  "tokens": {
    "--radius":        { "layer": "primitive", "intent": "Legacy base radius",            "type": "radius", "default": "0.625rem", "themable": false },
    "--radius-sm":     { "layer": "primitive", "intent": "Small radius",                   "type": "radius", "default": "4px",      "themable": true },
    "--radius-md":     { "layer": "primitive", "intent": "Medium radius",                  "type": "radius", "default": "6px",      "themable": true },
    "--radius-lg":     { "layer": "primitive", "intent": "Large radius",                   "type": "radius", "default": "10px",     "themable": true },
    "--radius-xl":     { "layer": "primitive", "intent": "Extra-large radius",             "type": "radius", "default": "14px",     "themable": true },
    "--radius-full":   { "layer": "primitive", "intent": "Pill/circle radius",             "type": "radius", "default": "9999px",   "themable": false },

    "--space-1": { "layer": "primitive", "intent": "Spacing 4px",  "type": "space", "default": "4px",  "themable": false },
    "--space-2": { "layer": "primitive", "intent": "Spacing 8px",  "type": "space", "default": "8px",  "themable": false },
    "--space-3": { "layer": "primitive", "intent": "Spacing 12px", "type": "space", "default": "12px", "themable": false },
    "--space-4": { "layer": "primitive", "intent": "Spacing 16px", "type": "space", "default": "16px", "themable": false },
    "--space-5": { "layer": "primitive", "intent": "Spacing 20px", "type": "space", "default": "20px", "themable": false },
    "--space-6": { "layer": "primitive", "intent": "Spacing 24px", "type": "space", "default": "24px", "themable": false },
    "--space-7": { "layer": "primitive", "intent": "Spacing 32px", "type": "space", "default": "32px", "themable": false },
    "--space-8": { "layer": "primitive", "intent": "Spacing 40px", "type": "space", "default": "40px", "themable": false },

    "--z-base":     { "layer": "primitive", "intent": "Base z",       "type": "z-index", "default": "0",   "themable": false },
    "--z-elevated": { "layer": "primitive", "intent": "Elevated z",   "type": "z-index", "default": "1",   "themable": false },
    "--z-dropdown": { "layer": "primitive", "intent": "Dropdown z",   "type": "z-index", "default": "10",  "themable": false },
    "--z-sticky":   { "layer": "primitive", "intent": "Sticky z",     "type": "z-index", "default": "20",  "themable": false },
    "--z-popover":  { "layer": "primitive", "intent": "Popover z",    "type": "z-index", "default": "30",  "themable": false },
