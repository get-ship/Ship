{
  "name": "@ship/sui-runtime",
  "version": "0.1.0",
  "description": "SUI runtime — fine-grained signals, custom-element wrapper, patch protocol applicator. The reactive engine that templates and components share.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./template-hooks": "./src/template-hooks/index.ts",
    "./dev": "./src/dev.ts",
    "./route": "./src/route/index.ts",
    "./patch": "./src/patch.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "bun build src/index.ts --target=browser --format=esm --outfile=../../../crates/ship/ship-sui-server/assets/sui-runtime.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.5",
    "axe-core": "^4.11.4",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
