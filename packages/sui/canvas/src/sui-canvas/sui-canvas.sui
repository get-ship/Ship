<!--
  <sui-canvas> — Excalidraw drawing surface as a Tier-B SUI primitive.

  Wraps @excalidraw/excalidraw (pinned in package.json) behind a thin
  custom-element → React bridge (see excalidraw-bridge.ts). Excalidraw
  owns the surface entirely — there are no slots. The controller mounts a
  React root into the `.surface` container inside this component's shadow
  root and disposes it on disconnect.

  Props
  ─────────────────────────────────────────────────────────────────────
  value     (string, '')      Excalidraw scene JSON. Parsed as initialData.
  readonly  (bool,  false)    Maps to Excalidraw `viewModeEnabled`.
  theme     ('light'|'dark')  Excalidraw theme; defaults to light. Consumers
                              sync via host theme tokens.
  ─────────────────────────────────────────────────────────────────────
  Event: sui-canvas-change { value: string, sceneVersion: number }
         — debounced 200ms, fired on every scene edit.
  ─────────────────────────────────────────────────────────────────────
  Bundle note: importing this tag pulls in Excalidraw + a React 19 tree
  (~1 MB minified). Consumers only pay that cost when they mount it.
-->

<prop name="value" type="string" default="" />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="theme" values="light|dark" default="light" reflect />

<style>
  :host {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    /* Pass SUI tokens through to Excalidraw so the surface matches the
       surrounding view. Excalidraw reads its own CSS vars; we map ours. */
    --color-primary: var(--foreground);
    background: var(--background);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  :host([hidden]) { display: none; }

  .surface {
    position: absolute;
    inset: 0;
  }
</style>

<div class="surface" part="surface" bind:this={surfaceEl}></div>
