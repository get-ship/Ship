<script>
// <ship-pagination> — pagination bar with prev/next buttons + info.
//
// Attributes:
//   page      — current page (1-based, default 1).
//   total     — total number of items.
//   per-page  — items per page (default 25).
//   tone      — default | info | success | warning | destructive | accent.
//
// Events:
//   ship-change — CustomEvent { page: number }.

prop page: number = 1
prop total: number = 0
prop perPage: number = 25
prop tone: string = ''

derived totalPages = total() > 0 ? Math.ceil(total() / perPage()) : 1
derived startIdx = (page() - 1) * perPage() + 1
derived endIdx = Math.min(page() * perPage(), total())
derived prevDisabled = page() <= 1
derived nextDisabled = page() >= totalPages()
derived effectiveTone = tone() && tone() !== 'default' ? tone() : ''
derived hasTotal = total() > 0

function emitChange(p) {
  page.set(p)
  el.setAttribute('page', String(p))
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { page: p },
    bubbles: true,
    composed: true,
  }))
}

function onPrev() {
  if (page() > 1) emitChange(page() - 1)
}
function onNext() {
  if (page() < totalPages()) emitChange(page() + 1)
}
</script>

<template>
<nav class="bar" aria-label="Pagination" part="nav">
  <ship-button
    variant="outline"
    size="sm"
    tone={effectiveTone}
    disabled={prevDisabled}
    onclick={onPrev}
    aria-label="Previous page"
  >Prev</ship-button>
  <span class="info">
    Page {page()} of {totalPages()}{#if hasTotal} <span>({startIdx()}–{endIdx()} of {total()})</span>{/if}
  </span>
  <span class="spacer"></span>
  <ship-button
    variant="outline"
    size="sm"
    tone={effectiveTone}
    disabled={nextDisabled}
    onclick={onNext}
    aria-label="Next page"
  >Next</ship-button>
</nav>
</template>

<style>
:host { display: block; }
.bar {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.8125rem;
  font-family: var(--font-body);
}
.info {
  color: var(--muted-foreground);
  user-select: none;
  white-space: nowrap;
}
.spacer { flex: 1; }
</style>
