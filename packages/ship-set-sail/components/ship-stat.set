<script>
prop accent: 'default' | 'primary' | 'info' | 'success' | 'destructive' | 'warning' | 'accent' = 'default'
prop interactive: boolean = false

function onKey(e) {
  if (!interactive()) return
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault()
    el.click()
  }
}

effect on interactive {
  if (interactive()) {
    if (!el.hasAttribute('role')) el.setAttribute('role', 'button')
    if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0')
    el.addEventListener('keydown', onKey)
  } else {
    if (el.getAttribute('role') === 'button') el.removeAttribute('role')
    if (el.getAttribute('tabindex') === '0') el.removeAttribute('tabindex')
    el.removeEventListener('keydown', onKey)
  }
}
</script>

<template>
<span class="label"><slot name="label"></slot></span>
<span class="value-row">
  <span class="value"><slot></slot></span>
  <span class="trend"><slot name="trend"></slot></span>
</span>
<span class="hint"><slot name="hint"></slot></span>
</template>

<style>
:host {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
  transition:
    border-color var(--duration-medium) var(--ease-out),
    transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}
:host([interactive]) { cursor: pointer; }
:host([interactive]:hover) {
  border-color: color-mix(in oklch, var(--border) 180%, transparent);
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}
.label {
  font-size: var(--text-xs);
  font-family: var(--label-font);
  font-weight: var(--label-weight);
  letter-spacing: var(--label-tracking);
  text-transform: uppercase;
  color: var(--muted-foreground);
}
.value-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}
.value {
  font-family: var(--heading-font);
  font-size: var(--text-3xl);
  font-weight: var(--heading-weight);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
  color: var(--foreground);
}
.trend { display: inline-flex; align-items: center; }
:host([accent='primary']) .value { color: var(--primary); }
:host([accent='info']) .value { color: var(--info); }
:host([accent='success']) .value { color: var(--success); }
:host([accent='destructive']) .value { color: var(--destructive); }
:host([accent='warning']) .value { color: var(--warning); }
:host([accent='accent']) .value { color: var(--accent); }
.hint { font-size: 11px; color: var(--muted-foreground); }
@media (prefers-reduced-motion: reduce) {
  :host([interactive]:hover) { transform: none; }
}
</style>
