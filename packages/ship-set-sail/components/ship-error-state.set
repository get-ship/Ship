<script>
// <ship-error-state> — sibling of <ship-empty-state> for the
// "something broke" path. Routes every view's error branch through
// one component so failures read deliberately (destructive halo,
// clear title, actionable body, optional collapsible technical
// details, primary retry).
//
// Attributes:
//   title, body, size (sm|md|lg), variant (default|inline), icon
//
// Slots:
//   title, default (body), details, action

prop title: string = ''
prop body: string = ''
prop size: 'sm' | 'md' | 'lg' = 'md'
prop variant: 'default' | 'inline' = 'default'
prop icon: string = 'alert-circle'

state open = false

derived hasIcon = !!icon()
derived hasDetails = slotFilled(el, 'details')
derived toggleLabel = open() ? 'Hide details' : 'Show details'
derived titleText = title() || 'Something went wrong'

function onToggle() {
  open.set(!open())
}

mount {
  // Auto-focus the first slotted [slot=retry] action so keyboard
  // users can press Enter to recover. Wait one frame so the slot
  // anchor has resolved its assignments.
  requestAnimationFrame(() => {
    const retry = el.querySelector(':scope > [slot="retry"]')
    if (retry && typeof retry.focus === 'function') retry.focus()
  })
}
</script>

<template>
<div class="box" part="box" role="alert" tone="destructive">
  <div class="icon" part="icon" aria-hidden="true">
    {#if hasIcon}<ship-icon class="glyph" name={icon}></ship-icon>{/if}
  </div>

  <div class="copy">
    <div class="title" part="title">
      <slot name="title">{titleText()}</slot>
    </div>
    <div class="desc" part="desc">
      <slot>{body()}</slot>
    </div>
    {#if hasDetails}
      <button class="details-toggle" type="button"
              aria-expanded={open() ? 'true' : 'false'}
              onclick={onToggle}>{toggleLabel()}</button>
      <div class="details" hidden={!open}>
        <slot name="details"></slot>
      </div>
    {/if}
  </div>

  <div class="actions" part="actions">
    <slot name="action"></slot>
  </div>
</div>
</template>

<style src="./ship-error-state.css"></style>
