<script>
// <ship-dropdown-menu> — popover with a vertical list of actionable
// items. Light-DOM children with `role="menuitem"` and a `data-value`
// attr become selectable rows. `<button data-value="…">` works best.
//
// Attributes:
//   open — boolean; reflected.
//
// Slots:
//   trigger — the triggering button.
//   (default) — menuitem children.
//
// Events:
//   ship-select — CustomEvent { detail: { value } } when an item is
//   clicked or activated with Enter/Space.
//
// Typeahead is inlined (Listbox APG buffer + cycling) — the Lit
// reference imports a sibling helper but `.set` files don't take
// top-level imports yet, and the surface is small enough to host.

prop open: boolean = false

state typeBuf = ''
state typeLastAt = 0

function emitSelect(value) {
  el.dispatchEvent(new CustomEvent('ship-select', {
    detail: { value },
    bubbles: true,
    composed: true,
  }))
}

function items() {
  return Array.from(
    el.querySelectorAll('[role="menuitem"], button[data-value], [data-value]'),
  ).filter((it) => !it.hasAttribute('disabled'))
}

function focusItem(index) {
  const list = items()
  if (!list.length) return
  const i = ((index % list.length) + list.length) % list.length
  for (const it of list) it.setAttribute('tabindex', '-1')
  list[i].setAttribute('tabindex', '0')
  list[i].focus()
}

function currentIndex() {
  const list = items()
  return list.indexOf(document.activeElement)
}

function triggerEl() {
  const wrap = el.querySelector(':scope > .trigger-wrap')
  if (!wrap) return null
  for (const t of wrap.children) return t
  return null
}

function setOpen(next) {
  if (next === open()) return
  open.set(next)
  if (next) el.setAttribute('open', '')
  else el.removeAttribute('open')
}

function close() {
  setOpen(false)
  const t = triggerEl()
  if (t && typeof t.focus === 'function') t.focus()
}

function setupTrigger() {
  const t = triggerEl()
  if (!t) return
  t.setAttribute('aria-haspopup', 'menu')
  t.setAttribute('aria-expanded', open() ? 'true' : 'false')
}

function setupItems() {
  const list = items()
  list.forEach((it, idx) => {
    if (!it.hasAttribute('role')) it.setAttribute('role', 'menuitem')
    if (!it.hasAttribute('tabindex')) {
      it.setAttribute('tabindex', idx === 0 ? '0' : '-1')
    }
  })
}

function onTriggerClick() {
  setOpen(!open())
  if (open()) queueMicrotask(() => focusItem(0))
}

function onItemClick(e) {
  const target = e.target.closest('[data-value]')
  if (!target) return
  const value = target.dataset.value || ''
  emitSelect(value)
  close()
}

function isTypeaheadKey(e) {
  if (e.ctrlKey || e.altKey || e.metaKey) return false
  return e.key.length === 1 && /\S/.test(e.key)
}

function typeaheadPush(key) {
  const now = Date.now()
  if (now - typeLastAt() > 500) typeBuf.set('')
  typeLastAt.set(now)
  const k = key.toLowerCase()
  if (typeBuf() === k) return typeBuf()
  typeBuf.set(typeBuf() + k)
  return typeBuf()
}

function typeaheadMatch(labels, fromIndex) {
  const buf = typeBuf()
  const n = labels.length
  if (!buf || n === 0) return -1
  const cycling = buf.length === 1
  const start = cycling ? fromIndex + 1 : 0
  for (let i = 0; i < n; i++) {
    const idx = (start + i) % n
    const label = (labels[idx] ?? '').toLowerCase()
    if (label.startsWith(buf)) return idx
  }
  return -1
}

function onKeydown(e) {
  if (!open()) return
  const list = items()
  if (!list.length) return
  const i = currentIndex()
  if (e.key === 'ArrowDown') { e.preventDefault(); focusItem(i + 1) }
  else if (e.key === 'ArrowUp') { e.preventDefault(); focusItem(i - 1) }
  else if (e.key === 'Home') { e.preventDefault(); focusItem(0) }
  else if (e.key === 'End') { e.preventDefault(); focusItem(list.length - 1) }
  else if (e.key === 'Escape') { e.preventDefault(); close() }
  else if (e.key === 'Tab') { setOpen(false) }
  else if ((e.key === 'Enter' || e.key === ' ') && i >= 0) {
    e.preventDefault()
    list[i].click()
  } else if (isTypeaheadKey(e)) {
    typeaheadPush(e.key)
    const labels = list.map((it) => (it.textContent ?? '').trim())
    const next = typeaheadMatch(labels, i)
    if (next >= 0) { e.preventDefault(); focusItem(next) }
  }
}

function onDocClick(e) {
  if (!open()) return
  const path = e.composedPath()
  if (path.includes(el)) return
  setOpen(false)
}

mount {
  setupTrigger()
  setupItems()
  el.addEventListener('keydown', onKeydown)
  document.addEventListener('click', onDocClick)
  cleanups.push(() => el.removeEventListener('keydown', onKeydown))
  cleanups.push(() => document.removeEventListener('click', onDocClick))
}

effect {
  el.setAttribute('data-state', open() ? 'open' : 'closed')
  setupTrigger()
}
</script>

<template>
<span class="trigger-wrap" onclick={onTriggerClick}><slot name="trigger"></slot></span>
<div class="menu" role="menu" onclick={onItemClick}>
  <slot></slot>
</div>
</template>

<style>
:host { position: relative; display: inline-flex; }
:host([hidden]) { display: none; }

.menu {
  position: absolute;
  z-index: var(--z-dropdown);
  top: calc(100% + 4px);
  left: 0;
  min-width: 160px;
  padding: 4px;
  background: var(--popover);
  color: var(--popover-foreground);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  font-family: var(--font-body);
  font-size: var(--text-base);
  opacity: 0;
  transform: translateY(-4px);
  pointer-events: none;
  transition:
    opacity var(--duration-medium) var(--ease-out),
    transform var(--duration-medium) var(--ease-out);
}
:host([open]) .menu {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.menu ::slotted(button),
.menu ::slotted([role='menuitem']) {
  text-align: left;
  background: transparent;
  border: 0;
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  color: inherit;
  font: inherit;
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-out);
}
.menu ::slotted(button:hover),
.menu ::slotted([role='menuitem']:hover) {
  background: var(--muted);
}

@media (prefers-reduced-motion: reduce) {
  .menu { transition: none; }
}
</style>
