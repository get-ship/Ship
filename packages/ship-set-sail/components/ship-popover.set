<script>
// <ship-popover> — trigger-anchored floating panel. The trigger slot
// receives ARIA wiring (aria-haspopup, aria-expanded, aria-controls);
// clicking the trigger toggles `open`. A document-level click listener
// closes on outside-click; ESC closes and returns focus to the trigger.
// Positioning is CSS-only via :host([placement=…]).
//
// Attributes:
//   open      — boolean; whether the panel is visible.
//   placement — top | bottom | top-end | bottom-end | left | right
//               (default bottom).
//
// Slots:
//   trigger   — the anchoring element (button, etc.).
//   (default) — popover body.
//
// Events:
//   ship-open, ship-close — bubbling, composed CustomEvents emitted
//   from the imperative show()/hide()/toggle() methods.

prop open: boolean = false
prop placement: 'top' | 'bottom' | 'top-end' | 'bottom-end' | 'left' | 'right' = 'bottom'

state panelId = ''

derived ariaHidden = open() ? 'false' : 'true'

function emit(name) {
  el.dispatchEvent(new CustomEvent(name, { bubbles: true, composed: true }))
}

function show() {
  if (open()) return
  open.set(true)
  el.setAttribute('open', '')
  emit('ship-open')
}

function hide() {
  if (!open()) return
  open.set(false)
  el.removeAttribute('open')
  emit('ship-close')
}

function toggle() {
  if (open()) hide()
  else show()
}

function triggerEl() {
  // Slot fills are reparented during slot resolution into the
  // .trigger-wrap container; the first non-bubble child there is the
  // canonical trigger.
  const wrap = el.querySelector(':scope > .trigger-wrap')
  if (!wrap) return null
  for (const t of wrap.children) return t
  return null
}

function setupTrigger() {
  const t = triggerEl()
  if (!t) return
  t.setAttribute('aria-haspopup', 'dialog')
  t.setAttribute('aria-expanded', open() ? 'true' : 'false')
  t.setAttribute('aria-controls', panelId())
}

function onTriggerClick() {
  toggle()
}

function onDocClick(e) {
  if (!open()) return
  // composedPath crosses shadow boundaries — matches the Lit reference
  // and stays correct when the trigger is itself a custom element.
  if (!e.composedPath().includes(el)) hide()
}

function onKeydown(e) {
  if (open() && e.key === 'Escape') {
    e.preventDefault()
    hide()
    const t = triggerEl()
    if (t && typeof t.focus === 'function') t.focus()
  }
}

mount {
  // Per-instance unique id (module-level counters aren't emitted yet).
  panelId.set(`ship-popover-panel-${Math.random().toString(36).slice(2, 9)}`)
  setupTrigger()
  el.addEventListener('keydown', onKeydown)
  document.addEventListener('click', onDocClick)
  cleanups.push(() => el.removeEventListener('keydown', onKeydown))
  cleanups.push(() => document.removeEventListener('click', onDocClick))
  // Imperative API matching the Lit reference.
  el.show = show
  el.hide = hide
  el.toggle = toggle
}

effect {
  el.setAttribute('data-state', open() ? 'open' : 'closed')
  setupTrigger()
}
</script>

<template>
<span class="trigger-wrap" onclick={onTriggerClick}><slot name="trigger"></slot></span>
<div
  id={panelId}
  class="panel"
  role="dialog"
  aria-modal="false"
  aria-hidden={ariaHidden}
><slot></slot></div>
</template>

<style>
:host { position: relative; display: inline-flex; }
:host([hidden]) { display: none; }

.panel {
  position: absolute;
  z-index: var(--z-popover);
  min-width: 180px;
  padding: 6px;
  background: var(--popover);
  color: var(--popover-foreground);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-md);
  backdrop-filter: var(--card-backdrop-filter);
  -webkit-backdrop-filter: var(--card-backdrop-filter);
  font-family: var(--font-body);
  font-size: var(--text-base);
  opacity: 0;
  transform: translateY(-4px);
  pointer-events: none;
  transition:
    opacity var(--duration-medium) var(--ease-out),
    transform var(--duration-medium) var(--ease-out);
}
:host([open]) .panel {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

:host([placement='bottom']) .panel,
:host(:not([placement])) .panel { top: calc(100% + 6px); left: 0; }
:host([placement='bottom-end']) .panel { top: calc(100% + 6px); right: 0; }
:host([placement='top']) .panel { bottom: calc(100% + 6px); left: 0; }
:host([placement='top-end']) .panel { bottom: calc(100% + 6px); right: 0; }
:host([placement='right']) .panel { left: calc(100% + 6px); top: 0; }
:host([placement='left']) .panel { right: calc(100% + 6px); top: 0; }

@media (prefers-reduced-motion: reduce) {
  .panel { transition: none; }
}
</style>
