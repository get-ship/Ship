<script>
prop accept: string = ''
prop multiple: boolean = false
prop maxSize: number = 10485760
prop disabled: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'

state files: File[] = []
state over: boolean = false
state error: string = ''

derived hasFiles = files().length > 0
derived hasError = !!error()
derived ariaLabel = accept() ? `Upload files (${accept()})` : 'Upload files'
derived dzClass = over() ? 'dropzone over' : 'dropzone'
derived dzTabIndex = disabled() ? '-1' : '0'

function fmtSize(bytes) {
  if (bytes < 1024) return `${bytes} B`
  if (bytes < 1048576) return `${(bytes / 1024).toFixed(1)} KB`
  return `${(bytes / 1048576).toFixed(1)} MB`
}

function matchesAccept(file) {
  const tokens = accept().split(',').map(t => t.trim().toLowerCase())
  const ext = '.' + file.name.split('.').pop()?.toLowerCase()
  return tokens.some(t => {
    if (t.startsWith('.')) return ext === t
    if (t.endsWith('/*')) return file.type.startsWith(t.replace('/*', '/'))
    return file.type === t
  })
}

function addFiles(incoming) {
  error.set('')
  const valid = []
  for (const f of incoming) {
    if (f.size > maxSize()) {
      error.set(`"${f.name}" exceeds max size (${fmtSize(maxSize())}).`)
      continue
    }
    if (accept() && !matchesAccept(f)) {
      error.set(`"${f.name}" is not an accepted file type.`)
      continue
    }
    valid.push(f)
  }
  files.set(multiple() ? [...files(), ...valid] : valid.slice(0, 1))
  emitChange()
}

function removeFile(idx) {
  files.set(files().filter((_, i) => i !== idx))
  error.set('')
  emitChange()
}

function emitChange() {
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { files: [...files()] },
    bubbles: true,
    composed: true,
  }))
}

function openPicker() {
  if (disabled()) return
  el.querySelector('input[type="file"]')?.click()
}

function onKey(e) {
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault()
    openPicker()
  }
}

function onDragOver(e) {
  e.preventDefault()
  over.set(true)
}

function onDragLeave() {
  over.set(false)
}

function onDrop(e) {
  e.preventDefault()
  over.set(false)
  if (e.dataTransfer?.files) addFiles(Array.from(e.dataTransfer.files))
}

function onInputChange(e) {
  const input = e.target
  if (input.files) addFiles(Array.from(input.files))
  input.value = ''
}

mount {
  const dz = el.querySelector('.dropzone')
  if (dz) {
    dz.addEventListener('keydown', onKey)
    dz.addEventListener('dragover', onDragOver)
    dz.addEventListener('dragleave', onDragLeave)
    dz.addEventListener('drop', onDrop)
    cleanups.push(() => dz.removeEventListener('keydown', onKey))
    cleanups.push(() => dz.removeEventListener('dragover', onDragOver))
    cleanups.push(() => dz.removeEventListener('dragleave', onDragLeave))
    cleanups.push(() => dz.removeEventListener('drop', onDrop))
  }
}
</script>

<template>
<div
  class={dzClass}
  role="button"
  tabindex={dzTabIndex}
  aria-label={ariaLabel}
  onclick={openPicker}
>
  <span class="icon" aria-hidden="true">📄</span>
  <span>Drop files here or click to browse</span>
</div>
<input
  type="file"
  accept={accept}
  multiple={multiple}
  onchange={onInputChange}
/>
{#if hasError}
  <div class="error" role="alert">{error()}</div>
{/if}
{#if hasFiles}
  <div class="file-list" aria-live="polite">
    {#for f, i of files key={i}}
      <div class="file-item">
        <span class="file-name">{f.name}</span>
        <span class="file-size">{fmtSize(f.size)}</span>
        <button
          class="remove"
          type="button"
          aria-label={"Remove " + f.name}
          onclick={() => removeFile(i)}
        >×</button>
      </div>
    {/for}
  </div>
{/if}
</template>

<style>
:host { display: block; }
:host([hidden]) { display: none; }
:host([disabled]) { opacity: 0.5; pointer-events: none; }

:host(:not([tone])), :host([tone='default']) {
  --tone-border: var(--border);
  --tone-bg: var(--muted);
}
:host([tone='info'])        { --tone-border: var(--info);        --tone-bg: color-mix(in oklch, var(--info)        10%, transparent); }
:host([tone='success'])     { --tone-border: var(--success);     --tone-bg: color-mix(in oklch, var(--success)     10%, transparent); }
:host([tone='warning'])     { --tone-border: var(--warning);     --tone-bg: color-mix(in oklch, var(--warning)     10%, transparent); }
:host([tone='destructive']) { --tone-border: var(--destructive); --tone-bg: color-mix(in oklch, var(--destructive) 10%, transparent); }
:host([tone='accent'])      { --tone-border: var(--accent);      --tone-bg: color-mix(in oklch, var(--accent)      10%, transparent); }
:host([tone='muted'])       { --tone-border: var(--muted-foreground); --tone-bg: color-mix(in oklch, var(--muted-foreground) 10%, transparent); }

.dropzone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 24px 16px;
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  background: transparent;
  cursor: pointer;
  transition: border-color .15s, background .15s;
  color: var(--muted-foreground);
  font-size: .875rem;
  font-family: var(--font-body);
}
.dropzone:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
.dropzone.over { border-style: solid; border-color: var(--tone-border); background: var(--tone-bg); }

.icon { font-size: 1.5rem; line-height: 1; }

input[type="file"] { display: none; }

.file-list { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }

.file-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  background: var(--muted);
  font-size: .8125rem;
  color: var(--foreground);
  font-family: var(--font-body);
}

.file-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.file-size { color: var(--muted-foreground); flex-shrink: 0; }

.remove {
  appearance: none;
  border: none;
  background: none;
  cursor: pointer;
  color: var(--muted-foreground);
  padding: 2px;
  line-height: 1;
  border-radius: var(--radius-sm);
  font-size: 1rem;
}
.remove:hover { color: var(--foreground); background: var(--border); }

.error { font-size: .75rem; color: var(--destructive); margin-top: 4px; padding: 0 2px; }

@media (prefers-reduced-motion: reduce) {
  .dropzone { transition: none; }
}
@media (forced-colors: active) {
  .dropzone { border-color: CanvasText; }
  .dropzone:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
}
</style>
