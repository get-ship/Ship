<script>
component formAssociated

prop value: number = 0
prop min: number = 0
prop max: number = 100
prop step: number = 1
prop disabled: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop label: string = ''
prop name: string = ''

state defaultValue = 0

derived range = max() - min()
derived pct = range() > 0
  ? Math.max(0, Math.min(100, ((value() - min()) / range()) * 100))
  : 0
derived fillStyle = `width: ${pct()}%`
derived thumbStyle = `left: ${pct()}%`
derived ariaLabel = label() || 'slider'
derived ariaDisabled = disabled() ? 'true' : 'false'

function syncFormValue() {
  if (internals && typeof internals.setFormValue === 'function') {
    internals.setFormValue(String(value()))
  }
}

function syncNativeInput() {
  const input = el.querySelector('input[type="range"]')
  if (input && Number(input.value) !== value()) {
    input.value = String(value())
  }
}

function onInput(e) {
  const v = Number(e.target.value)
  if (Number.isNaN(v)) return
  if (v === value()) return
  value.set(v)
  syncFormValue()
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { value: v },
    bubbles: true,
    composed: true,
  }))
}

mount {
  defaultValue.set(value())
  syncFormValue()
}

on form_reset {
  value.set(defaultValue())
  syncNativeInput()
  syncFormValue()
}
on form_restore(state) {
  const v = state == null ? defaultValue() : Number(state)
  value.set(Number.isNaN(v) ? defaultValue() : v)
  syncNativeInput()
  syncFormValue()
}

effect {
  syncNativeInput()
  syncFormValue()
}
</script>

<template>
<div class="container" part="container">
  <div class="track" part="track">
    <div class="fill" part="fill" style={fillStyle}></div>
  </div>
  <div class="thumb" part="thumb" aria-hidden="true" style={thumbStyle}></div>
  <input
    class="native"
    part="input"
    type="range"
    min={min}
    max={max}
    step={step}
    value={value}
    name={name}
    disabled={disabled}
    aria-label={ariaLabel}
    aria-disabled={ariaDisabled}
    oninput={onInput}
  />
</div>
</template>

<style>
:host {
  display: block;
  font-family: var(--font-body);
  color: var(--foreground);
  -webkit-tap-highlight-color: transparent;
  --tone: var(--primary);
}
:host([hidden]) { display: none; }

:host(:not([tone])),
:host([tone='default']) { --tone: var(--primary); }
:host([tone='info'])        { --tone: var(--info); }
:host([tone='success'])     { --tone: var(--success); }
:host([tone='warning'])     { --tone: var(--warning); }
:host([tone='destructive']) { --tone: var(--destructive); }
:host([tone='accent'])      { --tone: var(--accent); }
:host([tone='muted'])       { --tone: var(--muted-foreground); }

:host(:not([size])),
:host([size='md']) { --sl-h: 6px; --sl-thumb: 16px; }
:host([size='sm']) { --sl-h: 4px; --sl-thumb: 12px; }
:host([size='lg']) { --sl-h: 8px; --sl-thumb: 20px; }

.container {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: var(--sl-thumb);
  cursor: pointer;
  touch-action: none;
}
:host([disabled]) .container {
  cursor: not-allowed;
  opacity: 0.5;
}

.track {
  position: relative;
  width: 100%;
  height: var(--sl-h);
  background: var(--muted);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: var(--tone);
  border-radius: inherit;
  transition: width 0ms;
}

.thumb {
  position: absolute;
  top: 50%;
  width: var(--sl-thumb);
  height: var(--sl-thumb);
  background: var(--background);
  border: 2px solid var(--tone);
  border-radius: 50%;
  box-shadow: var(--shadow-sm);
  transform: translate(-50%, -50%);
  transition:
    box-shadow var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
  box-sizing: border-box;
  pointer-events: none;
}
:host(:not([disabled])) .container:hover .thumb {
  box-shadow: var(--shadow-md);
  transform: translate(-50%, -50%) scale(1.05);
}
:host(:not([disabled])) .container:active .thumb {
  transform: translate(-50%, -50%) scale(0.95);
}

/* The native range sits invisibly above the chrome to provide pointer
 * + keyboard interaction (Arrow keys, Home/End, PageUp/PageDown, click
 * on track). Browser default chrome is hidden via appearance:none and
 * opacity:0; events still fire. */
.native {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
  cursor: inherit;
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  border: 0;
  outline: 0;
}
.native::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: var(--sl-thumb);
  height: var(--sl-thumb);
  background: transparent;
  border: 0;
}
.native::-moz-range-thumb {
  width: var(--sl-thumb);
  height: var(--sl-thumb);
  background: transparent;
  border: 0;
}

:host(:not([disabled])) .container:has(input:focus-visible) .thumb {
  outline: none;
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--tone) var(--ring-opacity), transparent);
}

@media (prefers-reduced-motion: reduce) {
  .thumb { transition: none; }
}
@media (forced-colors: active) {
  .container:has(input:focus-visible) .thumb {
    outline: 2px solid CanvasText;
    outline-offset: 2px;
  }
  .thumb { border-color: CanvasText; }
  .fill { background: Highlight; }
}
</style>
