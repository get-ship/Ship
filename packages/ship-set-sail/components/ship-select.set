<script>
component formAssociated

prop value: string = ''
prop name: string = ''
prop required: boolean = false
prop disabled: boolean = false
prop invalid: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop label: string = ''
prop describedBy: string = ''

state defaultValue = ''
state displayLabel = ''


function syncFormValue() {
  if (internals && typeof internals.setFormValue === 'function') {
    internals.setFormValue(value())
  }
}

// After slot resolution the original <option>/<optgroup> children live
// inside <select> in light DOM (resolveSlots moves them at the slot
// anchor). Read from there so the chrome label and placeholder state
// always reflect what the native popup will show.
function pickOption() {
  const sel = el.querySelector('select')
  if (!sel) return null
  const opts = Array.from(sel.querySelectorAll(':scope > option, :scope > optgroup > option'))
  if (opts.length === 0) return null
  const v = value()
  return (
    opts.find((o) => o.value === v) ||
    opts.find((o) => o.hasAttribute('selected')) ||
    opts[0]
  )
}

function computeLabel() {
  const match = pickOption()
  if (!match) return value()
  const text = (match.textContent || '').trim()
  return text || match.value || value()
}

function updatePlaceholderState() {
  const match = pickOption()
  const isPlaceholder = !match || match.value === ''
  if (isPlaceholder) el.setAttribute('data-placeholder', '')
  else el.removeAttribute('data-placeholder')
}

function syncSelect() {
  const sel = el.querySelector('select')
  if (!sel) return
  if (sel.value !== value()) sel.value = value()
}

function refresh() {
  syncSelect()
  displayLabel.set(computeLabel())
  updatePlaceholderState()
  syncFormValue()
}

function onChange(e) {
  const v = e.target.value
  value.set(v)
  refresh()
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { value: v }, bubbles: true, composed: true,
  }))
}

mount {
  defaultValue.set(value())
  // The bind:value effect on <select> can't take during the initial
  // template pass — options haven't been re-parented yet — so defer
  // the first sync to a microtask, after resolveSlots has run.
  queueMicrotask(refresh)
}

on form_reset {
  value.set(defaultValue())
  refresh()
}
on form_restore(state) {
  value.set(state ?? '')
  refresh()
}

effect {
  refresh()
}
</script>

<template>
<div class="field" part="field">
  <span class="value" aria-hidden="true">{displayLabel()}</span>
  <svg class="chevron" part="chevron" viewBox="0 0 16 16"
    aria-hidden="true" focusable="false" fill="none"
    stroke="currentColor" stroke-width="1.75"
    stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 6l4 4 4-4"></path>
  </svg>
  <select part="select"
    name={name}
    required={required}
    disabled={disabled}
    aria-invalid={invalid() ? 'true' : 'false'}
    aria-label={label}
    aria-describedby={describedBy}
    onchange={onChange}
  ><slot></slot></select>
</div>
</template>

<style>
:host {
  display: inline-flex;
  vertical-align: middle;
  --tone: var(--foreground);
  --tone-fg: var(--foreground);
}
:host([hidden]) { display: none; }

:host([tone='info'])        { --tone: var(--info);             --tone-fg: var(--info); }
:host([tone='success'])     { --tone: var(--success);          --tone-fg: var(--success); }
:host([tone='warning'])     { --tone: var(--warning);          --tone-fg: var(--warning); }
:host([tone='destructive']) { --tone: var(--destructive);      --tone-fg: var(--destructive); }
:host([tone='accent'])      { --tone: var(--accent);           --tone-fg: var(--accent); }
:host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); }

:host(:not([size])), :host([size='md']) {
  --sel-h: 34px; --sel-px: 12px; --sel-fs: 13px; --sel-gap: 8px; --sel-chev: 14px;
}
:host([size='sm']) {
  --sel-h: 28px; --sel-px: 10px; --sel-fs: 12px; --sel-gap: 6px; --sel-chev: 12px;
}
:host([size='lg']) {
  --sel-h: 40px; --sel-px: 16px; --sel-fs: 14px; --sel-gap: 8px; --sel-chev: 16px;
}

.field {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: var(--sel-gap);
  min-height: var(--sel-h);
  padding-inline: var(--sel-px);
  padding-inline-end: calc(var(--sel-px) + var(--sel-chev) + 6px);
  background: var(--background);
  color: var(--foreground);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-xs);
  font-family: var(--font-body);
  font-size: var(--sel-fs);
  font-weight: var(--font-weight-medium);
  line-height: 1;
  letter-spacing: -0.005em;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out);
}

:host(:not([disabled])) .field:hover {
  background: color-mix(in oklch, var(--muted) 70%, var(--background));
  border-color: color-mix(in oklch, var(--border) 160%, transparent);
  box-shadow: var(--shadow-sm);
}

:host([tone]:not([tone='default'])) .field {
  border-color: color-mix(in oklch, var(--tone) 38%, var(--border));
}
:host([tone]:not([tone='default']):not([disabled])) .field:hover {
  background: color-mix(in oklch, var(--tone) 8%, var(--background));
  border-color: color-mix(in oklch, var(--tone) 55%, var(--border));
}

select {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding-inline: var(--sel-px);
  padding-inline-end: calc(var(--sel-px) + var(--sel-chev) + 6px);
  font: inherit;
  color: transparent;
  background: transparent;
  border: 0;
  outline: 0;
  appearance: none;
  -webkit-appearance: none;
  cursor: inherit;
}
select option { color: var(--foreground); background: var(--background); }

.value {
  display: inline-block;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
}
:host([data-placeholder]) .value { color: var(--muted-foreground); }

.chevron {
  position: absolute;
  inset-block: 0;
  inset-inline-end: var(--sel-px);
  margin-block: auto;
  width: var(--sel-chev);
  height: var(--sel-chev);
  color: var(--muted-foreground);
  pointer-events: none;
  transition:
    color var(--duration-fast) var(--ease-out),
    transform var(--duration-medium) var(--ease-out);
}
:host(:not([disabled])) .field:hover .chevron { color: var(--foreground); }
:host([tone]:not([tone='default'])) .chevron {
  color: color-mix(in oklch, var(--tone-fg) 75%, var(--muted-foreground));
}

:host(:focus-within) .field {
  outline: none;
  border-color: color-mix(in oklch, var(--tone) 60%, var(--border));
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--tone) 55%, transparent);
}
:host(:not([tone]):focus-within) .field,
:host([tone='default']:focus-within) .field {
  border-color: color-mix(in oklch, var(--ring-color) 55%, var(--border));
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--ring-color) var(--ring-opacity), transparent);
}

:host([invalid]) .field { border-color: var(--destructive); }
:host([invalid]:focus-within) .field {
  border-color: var(--destructive);
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--destructive) var(--ring-opacity), transparent);
}

:host([disabled]) { opacity: 0.6; cursor: not-allowed; }
:host([disabled]) .field {
  background: var(--muted);
  border-color: color-mix(in oklch, var(--border) 80%, transparent);
  box-shadow: none;
  cursor: not-allowed;
  filter: saturate(0.6);
}
:host([disabled]) select { cursor: not-allowed; }

@media (prefers-reduced-motion: reduce) {
  .field, .chevron { transition: none; }
}
@media (forced-colors: active) {
  :host(:focus-within) .field { outline: 2px solid CanvasText; outline-offset: 2px; }
}
</style>
