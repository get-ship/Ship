<script>
// <ship-context-menu> — right-click triggered overlay menu with keyboard nav.
// Parity port of packages/ship-set/src/web-components/core/ship-context-menu.ts.
//
// Light-DOM children with [data-value] or role="menuitem" become the rows;
// click / Enter / Space dispatches ship-select. Typeahead (Listbox APG cycle
// pattern) jumps to items by initial characters. Outside-click and Escape
// close; Tab also closes (release focus to the page).

prop open: boolean = false

state menuX = 0
state menuY = 0
state typeBuf = ''
state typeAt = 0

derived menuStyle = `position:fixed;left:${menuX()}px;top:${menuY()}px`

function items() {
  const list = Array.from(el.querySelectorAll('[role="menuitem"], button[data-value], [data-value]'))
  return list.filter(it => !it.hasAttribute('disabled'))
}

function focusItem(index) {
  const its = items()
  if (its.length === 0) return
  const i = ((index % its.length) + its.length) % its.length
  for (const it of its) it.setAttribute('tabindex', '-1')
  its[i].setAttribute('tabindex', '0')
  its[i].focus()
}

function currentIndex() {
  return items().indexOf(document.activeElement)
}

function setupItems() {
  const its = items()
  its.forEach((it, idx) => {
    if (!it.hasAttribute('role')) it.setAttribute('role', 'menuitem')
    if (!it.hasAttribute('tabindex')) it.setAttribute('tabindex', idx === 0 ? '0' : '-1')
  })
}

function emit(name) {
  el.dispatchEvent(new CustomEvent(name, { bubbles: true, composed: true }))
}

function show(x, y) {
  menuX.set(x)
  menuY.set(y)
  open.set(true)
  emit('ship-open')
  queueMicrotask(() => {
    setupItems()
    focusItem(0)
  })
}

function close() {
  open.set(false)
  emit('ship-close')
}

function onContextMenu(e) {
  e.preventDefault()
  show(e.clientX, e.clientY)
}

function onItemClick(e) {
  const target = e.target.closest('[data-value]')
  if (!target) return
  el.dispatchEvent(new CustomEvent('ship-select', {
    detail: { value: target.dataset.value || '' },
    bubbles: true,
    composed: true,
  }))
  close()
}

function isTypeKey(e) {
  if (e.ctrlKey || e.altKey || e.metaKey) return false
  return e.key.length === 1 && /\S/.test(e.key)
}

function pushType(key) {
  const now = Date.now()
  if (now - typeAt() > 500) typeBuf.set('')
  typeAt.set(now)
  const k = key.toLowerCase()
  if (typeBuf() === k) return typeBuf()
  typeBuf.set(typeBuf() + k)
  return typeBuf()
}

function matchType(labels, fromIndex) {
  const buf = typeBuf()
  const n = labels.length
  if (!buf || n === 0) return -1
  const cycling = buf.length === 1
  const start = cycling ? fromIndex + 1 : 0
  for (let i = 0; i < n; i++) {
    const idx = (start + i) % n
    const label = (labels[idx] || '').toLowerCase()
    if (label.startsWith(buf)) return idx
  }
  return -1
}

function onKeydown(e) {
  if (!open()) return
  const its = items()
  if (its.length === 0) return
  const i = currentIndex()
  if (e.key === 'ArrowDown') { e.preventDefault(); focusItem(i + 1) }
  else if (e.key === 'ArrowUp') { e.preventDefault(); focusItem(i - 1) }
  else if (e.key === 'Home') { e.preventDefault(); focusItem(0) }
  else if (e.key === 'End') { e.preventDefault(); focusItem(its.length - 1) }
  else if (e.key === 'Escape') { e.preventDefault(); close() }
  else if (e.key === 'Tab') { close() }
  else if ((e.key === 'Enter' || e.key === ' ') && i >= 0) {
    e.preventDefault()
    its[i].click()
  } else if (isTypeKey(e)) {
    pushType(e.key)
    const labels = its.map(it => (it.textContent || '').trim())
    const next = matchType(labels, i)
    if (next >= 0) { e.preventDefault(); focusItem(next) }
  }
}

function onDocClick(e) {
  if (!open()) return
  const target = e.composedPath()[0]
  if (!el.contains(target) && target !== el) close()
}

mount {
  el.show = show
  el.close = close
  document.addEventListener('click', onDocClick)
  el.addEventListener('keydown', onKeydown)
  cleanups.push(() => document.removeEventListener('click', onDocClick))
  cleanups.push(() => el.removeEventListener('keydown', onKeydown))
  queueMicrotask(setupItems)
}

effect {
  el.setAttribute('data-state', open() ? 'open' : 'closed')
  if (open()) el.setAttribute('open', '')
  else el.removeAttribute('open')
  setupItems()
}
</script>

<template>
<span class="trigger-wrap" oncontextmenu={onContextMenu}><slot name="trigger"></slot></span>
<div class="menu" part="menu" role="menu" aria-label="Context menu"
  style={menuStyle} onclick={onItemClick}><slot></slot></div>
</template>

<style>
@media (prefers-reduced-motion: reduce) {
  :host, :host *, :host > * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
:host { display: contents; }
.menu {
  position: fixed;
  z-index: var(--z-dropdown);
  min-width: 160px;
  padding: 4px;
  background: var(--popover);
  color: var(--popover-foreground);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  display: flex; flex-direction: column;
  font-family: var(--font-body);
  font-size: var(--text-base);
  opacity: 0;
  transform: scale(0.95);
  pointer-events: none;
  transition:
    opacity var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}
:host([open]) .menu {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}
/* Light-DOM equivalent of Lit's `::slotted(button)` — items are
 * reparented as direct children of `.menu` after slot resolution. */
.menu > button, .menu > [role='menuitem'] {
  text-align: left;
  background: transparent; border: 0;
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  color: inherit; font: inherit;
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-out);
}
.menu > button:hover, .menu > [role='menuitem']:hover {
  background: var(--muted);
}
@media (forced-colors: active) {
  .menu { border: 1px solid CanvasText; }
}
</style>
