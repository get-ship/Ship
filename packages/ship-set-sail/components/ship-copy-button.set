<script>
// <ship-copy-button> — copies `value` to the clipboard on click.
// Shows a checkmark flash for 1.2s after a successful copy.
//
// Attributes:
//   value  — string to copy.
//   label  — accessible label (default "Copy").
//
// Events:
//   ship-copy { value: string } — fired after a successful copy.
//
// Slots:
//   (default) — button label content (falls back to icon + label text).

prop value: string = ''
prop label: string = 'Copy'

state copied = false
state resetTimer: any = null

derived btnText = copied() ? 'Copied' : label()

function copy() {
  const v = value()
  const after = () => {
    copied.set(true)
    if (!el.hasAttribute('copied')) el.setAttribute('copied', '')
    el.dispatchEvent(new CustomEvent('ship-copy', {
      detail: { value: v },
      bubbles: true,
      composed: true,
    }))
    // Clear any pending reset from a previous copy so a stale timer
    // can't flip `copied` back off in the middle of a fresh flash.
    const t = resetTimer(); if (t) clearTimeout(t)
    resetTimer.set(setTimeout(() => {
      copied.set(false)
      el.removeAttribute('copied')
      resetTimer.set(null)
    }, 1200))
  }
  try {
    const p = navigator.clipboard && navigator.clipboard.writeText
      ? navigator.clipboard.writeText(v)
      : Promise.reject(new Error('no clipboard api'))
    Promise.resolve(p).then(after, () => {
      const ta = document.createElement('textarea')
      ta.value = v
      document.body.appendChild(ta)
      ta.select()
      try { document.execCommand('copy') } catch { /* ignore */ }
      ta.remove()
      after()
    })
  } catch {
    after()
  }
}

mount {
  // Cancel any pending reset timer on disconnect so a stale callback
  // can't write to the (still-alive) signal after the element is gone.
  cleanups.push(() => {
    const t = resetTimer(); if (t) clearTimeout(t)
  })
}
</script>

<template>
<button
  type="button"
  part="button"
  aria-label={label}
  onclick={copy}
>
  {#if copied}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 8 7 12 13 4"></polyline></svg>
  {:else}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1"></rect><path d="M11 4V3a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h1"></path></svg>
  {/if}
  <slot>{btnText()}</slot>
</button>
</template>

<style>
:host { display: inline-flex; }
button {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-medium);
  padding: 4px 8px;
  color: var(--muted-foreground);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition:
    color var(--duration-fast) var(--ease-out),
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out);
}
button:hover { color: var(--foreground); background: var(--muted); }
button:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--ring-color) var(--ring-opacity), transparent);
}
@media (forced-colors: active) {
  button:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
}
:host([copied]) button { color: var(--success); border-color: var(--success); }
svg { width: 12px; height: 12px; }
</style>
