<script>
// <ship-field> — vertical stack for a label + control + hint/error.
// Presentational wrapper; the slotted control owns the form value, so
// this component is NOT formAssociated.
//
// Attributes:
//   invalid — boolean. When set, the error slot is revealed and the
//             hint slot is hidden via CSS. Also flips the wired
//             control's `invalid` prop (or aria-invalid, on plain
//             native elements) and points its aria-describedby at
//             the error region instead of the hint.
//
// Slots:
//   label     — label element (e.g. <ship-label>).
//   (default) — the control. Wired via querySelector at mount and
//               re-wired on light-DOM mutations + when `invalid`
//               flips. The first non-named child is the canonical
//               control.
//   hint      — muted helper text under the control.
//   error     — destructive-toned error text. Replaces hint when
//               invalid is set.

prop invalid: boolean = false

state hintId = ''
state errorId = ''

function wireControl() {
  const hid = hintId()
  const eid = errorId()
  if (!hid || !eid) return
  const first = el.querySelector(':scope > :not(.label):not(.hint):not(.error)')
  if (!first) return
  const id = invalid() ? eid : hid
  const prior = (first.getAttribute('aria-describedby') || '')
    .split(/\s+/)
    .filter(t => t && t !== hid && t !== eid)
  const next = [...prior, id].join(' ').trim()
  if (next) first.setAttribute('aria-describedby', next)
  if ('invalid' in first) first.invalid = invalid()
  else first.setAttribute('aria-invalid', invalid() ? 'true' : 'false')
}

mount {
  // Per-instance unique IDs. A module-level counter would be simpler
  // but the compiler doesn't emit `let X = 0` at module scope yet
  // (see gaps.md "module-level mutable bindings"); a random suffix
  // is stable across the component's lifetime because we only set
  // it once at mount.
  hintId.set(`ship-field-hint-${Math.random().toString(36).slice(2, 9)}`)
  errorId.set(`ship-field-error-${Math.random().toString(36).slice(2, 9)}`)
  wireControl()
  // Re-wire when the slotted control is swapped or appended late.
  // resolveSlots already ran, so subsequent childList mutations are
  // author-driven and want re-wiring.
  const obs = new MutationObserver(() => wireControl())
  obs.observe(el, { childList: true })
  cleanups.push(() => obs.disconnect())
}

effect {
  // Reactively re-runs when `invalid` flips, mirroring the Lit
  // version's `updated()` lifecycle. Reading invalid() inside
  // wireControl tracks it; reading hintId/errorId here makes the
  // effect re-fire after mount sets the IDs.
  hintId(); errorId(); invalid()
  wireControl()
}
</script>

<template>
<div class="label" part="label"><slot name="label"></slot></div>
<slot></slot>
<div id={hintId} class="hint" part="hint"><slot name="hint"></slot></div>
<div id={errorId} class="error" part="error" role="alert" aria-live="polite"><slot name="error"></slot></div>
</template>

<style>
:host { display: flex; flex-direction: column; gap: 6px; font-family: var(--font-body); }
:host([hidden]) { display: none; }
.label:empty { display: none; }
.hint, .error { font-size: 11px; line-height: 1.4; }
.hint { color: var(--muted-foreground); }
.error { color: var(--destructive); }
:host(:not([invalid])) .error { display: none; }
:host([invalid]) .hint { display: none; }
</style>
