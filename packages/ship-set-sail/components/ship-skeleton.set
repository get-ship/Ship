<script>
prop variant: 'text' | 'circle' | 'rect' = 'text'
prop width: string = ''
prop height: string = ''
prop lines: number = 1
prop animated: boolean = true

// Module-level constants would be cleaner but the compiler doesn't
// emit top-level user `const` declarations yet. Inlined into the
// helper function below so they survive the verbatim function emit.
function buildBars() {
  const HEIGHTS = { text: '16px', circle: '40px', rect: '100px' }
  const LINE_WIDTHS = ['100%', '80%', '60%']
  const v = variant()
  const count = v === 'text' ? Math.max(1, lines() || 1) : 1
  return Array.from({ length: count }, (_, i) => ({
    index: i,
    width: width() || (v === 'text' && count > 1
      ? LINE_WIDTHS[Math.min(i, LINE_WIDTHS.length - 1)]
      : '100%'),
    height: height() || HEIGHTS[v],
  }))
}

derived bars = buildBars()

mount {
  if (!el.hasAttribute('role')) el.setAttribute('role', 'status')
  if (!el.hasAttribute('aria-live')) el.setAttribute('aria-live', 'polite')
  if (!el.hasAttribute('aria-busy')) el.setAttribute('aria-busy', 'true')
  if (!el.hasAttribute('aria-label')) el.setAttribute('aria-label', 'Loading')
}
</script>

<template>
{#for bar of bars() key={bar.index}}
  <span
    class="bar"
    part="bar"
    style={`width:${bar.width};height:${bar.height}`}
  ></span>
{/for}
</template>

<style>
:host { display: block; }
.bar {
  display: block;
  background: linear-gradient(
    90deg,
    var(--muted) 0%,
    color-mix(in oklch, var(--muted-foreground) 14%, var(--muted)) 50%,
    var(--muted) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.8s ease-in-out infinite;
  border-radius: 9999px;
}
:host([animate='false']) .bar,
:host(:not([animate])) .bar { animation: none; }
:host([variant='circle']) .bar { border-radius: var(--radius-full); }
:host([variant='rect']) .bar { border-radius: var(--radius-md); }
:host([variant='text']) .bar + .bar { margin-top: 6px; }
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
@media (prefers-reduced-motion: reduce) {
  .bar { animation: none; }
}
</style>
