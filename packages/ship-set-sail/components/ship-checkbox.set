<script>
component formAssociated

prop checked: boolean = false
prop indeterminate: boolean = false
prop disabled: boolean = false
prop required: boolean = false
prop invalid: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop name: string = ''
prop value: string = 'on'
prop label: string = ''

state defaultChecked = false
state input = null

derived ariaChecked = indeterminate() ? 'mixed' : (checked() ? 'true' : 'false')
derived ariaInvalid = invalid() ? 'true' : 'false'
derived ariaLabel = label() || name() || 'checkbox'

function syncFormValue() {
  if (internals && typeof internals.setFormValue === 'function') {
    internals.setFormValue(checked() ? value() : null)
  }
}

function onChange(e) {
  const c = e.target.checked
  checked.set(c)
  indeterminate.set(false)
  // Reflect to host attribute so external observers (CSS selectors,
  // querySelector('[checked]'), etc.) see the new state.
  if (c) el.setAttribute('checked', '')
  else el.removeAttribute('checked')
  el.removeAttribute('indeterminate')
  syncFormValue()
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { checked: c },
    bubbles: true,
    composed: true,
  }))
}

mount {
  defaultChecked.set(el.hasAttribute('checked'))
  // Wait for the template to render before grabbing the native input.
  queueMicrotask(() => {
    const native = el.querySelector('input')
    if (native) {
      input.set(native)
      native.indeterminate = indeterminate()
    }
    syncFormValue()
  })
  // Form lifecycle: reset to default-checked when the parent <form>
  // resets; restore from saved state if the browser rehydrates a form.
  el.addEventListener('sail:form-reset', () => {
    checked.set(defaultChecked())
    indeterminate.set(false)
    if (defaultChecked()) el.setAttribute('checked', '')
    else el.removeAttribute('checked')
    syncFormValue()
  })
  el.addEventListener('sail:form-restore', (e) => {
    const state = e.detail?.state
    checked.set(state === value())
    if (state === value()) el.setAttribute('checked', '')
    else el.removeAttribute('checked')
    syncFormValue()
  })
}

effect on indeterminate {
  if (input()) input().indeterminate = indeterminate()
}
effect on checked {
  syncFormValue()
}
</script>

<template>
<label part="label">
  <span class="box" part="box">
    <input
      part="input"
      type="checkbox"
      aria-checked={ariaChecked}
      aria-invalid={ariaInvalid}
      aria-label={ariaLabel}
      bind:checked={checked}
      on:change={onChange}
    />
    <span class="glyph check" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none">
        <path d="M3.5 8.5 L6.75 11.75 L12.5 4.75"></path>
      </svg>
    </span>
    <span class="glyph mixed" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none">
        <line x1="4" y1="8" x2="12" y2="8"></line>
      </svg>
    </span>
  </span>
  <slot></slot>
</label>
</template>

<style>
:host {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  vertical-align: middle;
  font-family: var(--font-body);
  font-size: var(--text-base);
  color: var(--foreground);
  -webkit-tap-highlight-color: transparent;
  --tone: var(--primary);
  --tone-on-fg: var(--primary-foreground);
}
:host([hidden]) { display: none; }

:host(:not([tone])), :host([tone='default']) {
  --tone: var(--primary);
  --tone-on-fg: var(--primary-foreground);
}
:host([tone='info']) { --tone: var(--info); --tone-on-fg: var(--info-foreground); }
:host([tone='success']) { --tone: var(--success); --tone-on-fg: var(--success-foreground); }
:host([tone='warning']) { --tone: var(--warning); --tone-on-fg: var(--warning-foreground); }
:host([tone='destructive']) { --tone: var(--destructive); --tone-on-fg: var(--destructive-foreground); }
:host([tone='accent']) { --tone: var(--accent); --tone-on-fg: var(--accent-foreground); }
:host([tone='muted']) { --tone: var(--muted-foreground); --tone-on-fg: var(--background); }

:host(:not([size])), :host([size='md']) {
  --cb-size: 16px; --cb-radius: var(--radius-sm); --cb-stroke: 2px;
}
:host([size='sm']) { --cb-size: 14px; --cb-radius: 3px; --cb-stroke: 1.75px; }
:host([size='lg']) { --cb-size: 18px; --cb-radius: var(--radius-sm); --cb-stroke: 2.25px; }

label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}
:host([disabled]) label { cursor: not-allowed; }

.box {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--cb-size);
  height: var(--cb-size);
  background: var(--background);
  border: 1px solid color-mix(in oklch, var(--border) 160%, transparent);
  border-radius: var(--cb-radius);
  box-sizing: border-box;
  box-shadow: var(--shadow-xs);
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

:host(:not([disabled]):not([checked]):not([indeterminate])) label:hover .box {
  border-color: color-mix(in oklch, var(--border) 220%, transparent);
  box-shadow: var(--shadow-sm);
}

:host([invalid]) .box {
  border-color: color-mix(in oklch, var(--destructive) 70%, var(--border));
}

:host([checked]) .box, :host([indeterminate]) .box {
  background: var(--tone);
  border-color: color-mix(in oklch, var(--tone) 100%, black 8%);
  box-shadow: inset 0 1px 0 0 color-mix(in oklch, white 20%, transparent), var(--shadow-xs);
}
:host([checked]:not([disabled])) label:hover .box,
:host([indeterminate]:not([disabled])) label:hover .box {
  background: color-mix(in oklch, var(--tone) 92%, white 8%);
  box-shadow: inset 0 1px 0 0 color-mix(in oklch, white 24%, transparent), var(--shadow-sm);
}

.glyph {
  position: absolute;
  inset: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--tone-on-fg);
  opacity: 0;
  transform: scale(0.6);
  transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  pointer-events: none;
}
:host([checked]:not([indeterminate])) .glyph.check,
:host([indeterminate]) .glyph.mixed {
  opacity: 1;
  transform: scale(1);
}
.glyph svg { width: 100%; height: 100%; display: block; }
.glyph svg path, .glyph svg line {
  stroke: currentColor;
  stroke-width: var(--cb-stroke);
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
}

input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
  cursor: inherit;
  appearance: none;
  -webkit-appearance: none;
}

:host(:not([disabled])) label:has(input:focus-visible) .box {
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--tone) var(--ring-opacity), transparent);
}
:host([invalid]:not([disabled])) label:has(input:focus-visible) .box {
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--destructive) var(--ring-opacity), transparent);
}

@media (forced-colors: active) {
  .box { border-color: CanvasText; }
  :host([checked]) .box, :host([indeterminate]) .box { background: Highlight; }
  .glyph { color: HighlightText; }
  :host(:not([disabled])) label:has(input:focus-visible) .box {
    outline: 2px solid CanvasText;
    outline-offset: 2px;
  }
}

:host([disabled]) { color: var(--muted-foreground); }
:host([disabled]) .box {
  background: var(--muted);
  border-color: color-mix(in oklch, var(--border) 70%, transparent);
  filter: saturate(0.6);
  box-shadow: none;
}
:host([disabled][checked]) .box, :host([disabled][indeterminate]) .box {
  background: color-mix(in oklch, var(--tone) 55%, var(--muted));
  border-color: color-mix(in oklch, var(--tone) 40%, var(--border));
}
</style>
