<script>
// <ship-json-view> — collapsible JSON tree renderer.
// Parity port of packages/ship-set/src/web-components/core/ship-json-view.ts.
//
// Attributes:
//   data     — JSON string (parsed at render).
//   expanded — boolean; force-expand all levels.
//   depth    — number; initial expansion depth (default 1).
//
// Note: role="tree" and aria-label="JSON tree" are always set on the host
// (the Lit original sets them only if absent; static host attrs in .set are
// always applied, which is equivalent for the standard use case).

prop data: string = ''
prop expanded: boolean = false
prop depth: number = 1

function escHtml(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
}

function buildTree(v, key, level, exp, dep) {
  const keyHtml = key !== null ? `<span class="key">"${escHtml(key)}"</span>: ` : ''
  if (v === null) return `${keyHtml}<span class="null">null</span>`
  if (typeof v === 'string') return `${keyHtml}<span class="s">"${escHtml(v)}"</span>`
  if (typeof v === 'number') return `${keyHtml}<span class="n">${escHtml(String(v))}</span>`
  if (typeof v === 'boolean') return `${keyHtml}<span class="b">${v ? 'true' : 'false'}</span>`
  const isArray = Array.isArray(v)
  const entries = isArray ? v.map((x, i) => [String(i), x]) : Object.entries(v)
  const open1 = isArray ? '[' : '{'
  const close1 = isArray ? ']' : '}'
  const count = entries.length
  if (count === 0) return `${keyHtml}${open1}${close1}`
  const shouldOpen = exp || level < dep
  const children = entries.map(([k, val]) =>
    `<div class="node">${buildTree(val, isArray ? null : k, level + 1, exp, dep)}</div>`
  ).join('')
  return `<details${shouldOpen ? ' open' : ''}><summary><span class="caret">▶</span>${keyHtml}${open1}<span class="meta">${count} ${isArray ? 'items' : 'keys'}</span></summary><div class="branch">${children}</div>${close1}</details>`
}

function renderTree(d, exp, dep) {
  if (!d) return ''
  try {
    const parsed = JSON.parse(d)
    return `<div part="root">${buildTree(parsed, null, 0, exp, dep)}</div>`
  } catch (e) {
    return `<span class="error" part="error" role="alert">Invalid JSON: ${escHtml(e.message)}</span>`
  }
}

derived treeHtml = renderTree(data(), expanded(), depth())
</script>

<template>
<:host role="tree" aria-label="JSON tree" />
{@html treeHtml()}
</template>

<style>
:host {
  display: block;
  font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  color: var(--foreground);
}
:host([hidden]) { display: none; }
.node { display: block; }
.branch { margin-left: 12px; border-left: 1px dashed var(--border); padding-left: 10px; }
details > summary {
  list-style: none;
  cursor: pointer;
  user-select: none;
  display: inline-flex;
  align-items: baseline;
  gap: 4px;
}
details > summary::-webkit-details-marker { display: none; }
.caret {
  display: inline-block;
  width: 10px;
  color: var(--muted-foreground);
  transition: transform var(--duration-fast) var(--ease-out);
}
details[open] > summary .caret { transform: rotate(90deg); }
.key { color: var(--primary); font-weight: var(--font-weight-medium); }
.s { color: var(--success); }
.n { color: var(--info); }
.b { color: var(--accent); font-weight: var(--font-weight-medium); }
.null { color: var(--muted-foreground); font-style: italic; }
.meta { color: var(--muted-foreground); font-size: var(--text-xs); margin-left: 4px; }
.error { color: var(--destructive); }
@media (prefers-reduced-motion: reduce) {
  .caret { transition: none; }
}
</style>
