<script>
prop variant: 'default' | 'inline' | 'placeholder' | 'connecting' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop icon: string = ''

derived role = variant() === 'connecting' ? 'status' : 'note'
derived live = variant() === 'connecting' ? 'polite' : 'off'
// Fallback <ship-icon> renders iff: caller provided no slot fill AND
// supplied a non-empty `icon` attr. Slot always wins.
derived showFallback = !slotFilled(el, 'icon') && !!icon()
</script>

<template>
<div class="box" part="box" role={role} aria-live={live}>
  <div class="icon" part="icon" aria-hidden="true">
    <slot name="icon"></slot>
    {#if showFallback}<ship-icon class="glyph" name={icon} aria-hidden="true"></ship-icon>{/if}
  </div>

  <div class="copy">
    <div class="title" part="title">
      <slot name="title"></slot>
    </div>
    <div class="desc" part="desc">
      <slot></slot>
    </div>
  </div>

  <div class="actions" part="actions">
    <slot name="action"></slot>
  </div>
</div>
</template>

<style>
:host {
  display: block;
  font-family: var(--font-body);
  color: var(--muted-foreground);

  /* Tone channel — neutral default; tone variants below override fg/bg
   * so the icon tile picks up the chosen tint. */
  --tone-fg: var(--muted-foreground);

  /* Size channel — md matches the pre-polish 64/16 card so existing
   * callers keep their visual weight. --es-icon sizes the inner glyph;
   * --es-tile sizes the circular wrapper. */
  --es-pad-y: 64px;
  --es-pad-x: 16px;
  --es-gap: var(--space-3);
  --es-icon: 22px;
  --es-tile: 48px;
  --es-title-fs: var(--text-md);
  --es-desc-fs: var(--text-sm);
  --es-title-weight: var(--font-weight-semibold);

  /* Variant channel — default is dashed card; inline/placeholder/
   * connecting override below. */
  --es-radius: var(--radius-lg);
  --es-border: 1px dashed var(--border);
  --es-bg: var(--card);
}
:host([hidden]) { display: none; }

/* ----- Tone channel — drives the icon tile tint -------------------- */
:host(:not([tone])), :host([tone='default']) {
  --tone-fg: var(--muted-foreground);
}
:host([tone='info'])        { --tone-fg: var(--info); }
:host([tone='success'])     { --tone-fg: var(--success); }
:host([tone='warning'])     { --tone-fg: var(--warning); }
:host([tone='destructive']) { --tone-fg: var(--destructive); }
:host([tone='accent'])      { --tone-fg: var(--accent); }
:host([tone='muted'])       { --tone-fg: var(--muted-foreground); }

/* ----- Size channel ------------------------------------------------- */
:host([size='sm']) {
  --es-pad-y: var(--space-7);
  --es-pad-x: var(--space-4);
  --es-gap: var(--space-2);
  --es-icon: 16px;
  --es-tile: 36px;
  --es-title-fs: var(--text-base);
  --es-desc-fs: var(--text-sm);
}
:host([size='lg']) {
  --es-pad-y: 96px;
  --es-pad-x: var(--space-6);
  --es-gap: var(--space-4);
  --es-icon: 28px;
  --es-tile: 64px;
  --es-title-fs: var(--text-lg);
  --es-desc-fs: var(--text-base);
}

/* ----- Variant channel --------------------------------------------- */
:host([variant='placeholder']),
:host([variant='connecting']) {
  --es-border: 0;
  --es-bg: transparent;
  --es-radius: 0;
  --es-pad-y: var(--space-6);
}
:host([variant='placeholder'][size='sm']),
:host([variant='connecting'][size='sm']) {
  --es-pad-y: var(--space-4);
}
:host([variant='placeholder'][size='lg']),
:host([variant='connecting'][size='lg']) {
  --es-pad-y: var(--space-8);
}

:host([variant='inline']) {
  --es-border: 1px dashed var(--border);
  --es-bg: color-mix(in oklch, var(--muted) 55%, transparent);
  --es-radius: var(--radius-md);
  --es-pad-y: var(--space-3);
  --es-pad-x: var(--space-4);
  --es-gap: var(--space-3);
}

/* ----- Box: outer chrome ------------------------------------------- */
.box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--es-gap);
  padding: var(--es-pad-y) var(--es-pad-x);
  text-align: center;
  background: var(--es-bg);
  border: var(--es-border);
  border-radius: var(--es-radius);
  animation: es-in var(--duration-medium) var(--ease-out) both;
}
:host([variant='inline']) .box {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
  gap: var(--space-3);
}

@keyframes es-in {
  from { opacity: 0; transform: translateY(4px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ----- Icon tile: muted circle wrapping the glyph ------------------ */
.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--es-tile);
  height: var(--es-tile);
  border-radius: var(--radius-full);
  background: color-mix(in oklch, var(--tone-fg) 18%, var(--muted));
  color: var(--tone-fg);
  line-height: 1;
}
:host(:not([tone])) .icon,
:host([tone='default']) .icon {
  background: var(--muted);
  color: var(--muted-foreground);
}
.icon:empty { display: none; }
/* Inline variant drops the tile — icon sits bare at icon-channel size. */
:host([variant='inline']) .icon {
  width: var(--es-icon);
  height: var(--es-icon);
  background: transparent;
}
/* Built-in glyph rendered when `icon` attr resolves and slot is empty.
 * Sized off the icon channel so it scales with size=[sm|md|lg]. */
.glyph {
  width: var(--es-icon);
  height: var(--es-icon);
  display: block;
}
/* Slotted glyphs get a display + color nudge. Slotted <ship-icon>'s
 * internal SVG is pinned to its own size attr; raw <svg slot="icon">
 * scales to the icon channel via the direct selector below. */
.icon > [slot='icon'],
.icon > * {
  color: currentColor;
}
.icon > svg {
  width: var(--es-icon);
  height: var(--es-icon);
}

/* ----- Typography -------------------------------------------------- */
.copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
  align-items: center;
  min-width: 0;
}
:host([variant='inline']) .copy {
  align-items: flex-start;
}
.title {
  font-family: var(--heading-font);
  font-size: var(--es-title-fs);
  font-weight: var(--heading-weight, var(--es-title-weight));
  letter-spacing: var(--heading-tracking);
  color: var(--foreground);
  line-height: var(--leading-tight);
}
.title:empty { display: none; }

.desc {
  font-size: var(--es-desc-fs);
  line-height: var(--leading-normal);
  max-width: 40ch;
  color: var(--muted-foreground);
}
:host([variant='inline']) .desc {
  max-width: 60ch;
}
.desc:empty { display: none; }

/* Quieter title weight for connecting/placeholder so they don't compete
 * with real content headers. */
:host([variant='connecting']) .title,
:host([variant='placeholder']) .title {
  font-weight: var(--font-weight-medium);
  color: var(--muted-foreground);
}

/* ----- Actions row ------------------------------------------------- */
.actions {
  display: flex;
  gap: var(--space-2);
  justify-content: center;
  margin-top: 4px;
  flex-wrap: wrap;
}
.actions:empty { display: none; }
:host([variant='inline']) .actions {
  margin-top: 0;
  margin-left: auto;
  justify-content: flex-end;
}

/* Forced-colors — keep dashed border visible in high-contrast modes
 * where color-mix'd tokens collapse. */
@media (forced-colors: active) {
  .box { border-color: CanvasText; }
  .icon { background: Canvas; color: CanvasText; }
}

@media (prefers-reduced-motion: reduce) {
  .box { animation: none; }
}
</style>
