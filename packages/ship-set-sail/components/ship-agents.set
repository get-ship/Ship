<script>
// Agents index page. Server-truth via the sail data resolver wired in
// `apps/shipd/src/views/sail_data_resolvers/agents.rs`. The signal
// updates whenever the kernel emits a `config.*` event (agent file
// create / edit / delete in either project or global scope), so the
// page reflects the registry without a refresh.

data live agents = ship.agents.summaries()

derived items = (agents() && agents().items) ? agents().items : []
derived total = items().length
derived hasItems = total() > 0
derived totalLabel = `${total()} agent${total() === 1 ? '' : 's'}`
</script>

<template>
<div class="agents-wrap">
  <header class="agents-head">
    <div class="agents-head-titles">
      <h1 class="agents-title">Agents</h1>
      <p class="agents-sub">{totalLabel}</p>
    </div>
    <a href="/agents/create" class="agents-cta-link">
      <ship-button tone="primary" variant="solid">
        <ship-icon slot="leading" name="plus"></ship-icon>
        New agent
      </ship-button>
    </a>
  </header>

  {#if hasItems}
    <div class="agents-grid">
      {#for a of items()}
        <a class="agents-card-link" href={`/agents/${a.id}`}>
          <ship-list-tile variant="card" density="normal" interactive>
            <ship-avatar slot="leading" tone="primary" shape="square" size="lg" letter={a.letter}></ship-avatar>
            <div class="agents-card-body">
              <div class="agents-card-head">
                <div class="agents-card-title">{a.name}</div>
                <p class="agents-card-desc">{a.description || 'No description'}</p>
              </div>
              <div class="agents-card-stats">
                <span>{a.skills_count} skill{a.skills_count === 1 ? '' : 's'}</span>
                <span class="agents-card-sep">·</span>
                <span>{a.mcp_count} MCP</span>
                <span class="agents-card-sep">·</span>
                <span>{a.rules_count} rule{a.rules_count === 1 ? '' : 's'}</span>
              </div>
              {#if a.providers && a.providers.length > 0}
                <div class="agents-card-providers" aria-label="Compiles to">
                  {#for p of a.providers.slice(0, 4)}
                    <ship-provider-blob provider={p} size="sm" variant="glyph" title={p}></ship-provider-blob>
                  {/for}
                  {#if a.providers.length > 4}
                    <ship-chip tone="muted" variant="outline" size="sm">+{a.providers.length - 4}</ship-chip>
                  {/if}
                </div>
              {/if}
              <div class="agents-card-badges">
                <ship-badge tone="muted" variant="outline" size="sm">{a.source}</ship-badge>
                {#if a.active}
                  <ship-chip tone="primary" variant="soft" size="sm">
                    <ship-status-dot slot="leading" tone="primary" size="sm" pulse></ship-status-dot>
                    active session
                  </ship-chip>
                {/if}
              </div>
            </div>
          </ship-list-tile>
        </a>
      {/for}
    </div>
  {:else}
    <ship-empty-state icon="sparkles" variant="default" size="lg">
      <span slot="title">No agents yet</span>
      Drop a JSONC file under
      <code class="agents-code">.ship/agents/</code>
      or create one from the Studio.
      <a slot="action" href="/agents/create" class="agents-cta-link">
        <ship-button tone="primary" variant="solid">
          <ship-icon slot="leading" name="plus"></ship-icon>
          New agent
        </ship-button>
      </a>
    </ship-empty-state>
  {/if}
</div>
</template>

<style>
:host {
  display: block;
  color: var(--foreground);
  font-family: var(--font-body);
}

.agents-wrap {
  max-width: 1024px;
  margin: 0 auto;
  padding: 32px var(--space-6);
}

.agents-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.agents-head-titles { position: relative; }
.agents-head-titles::after {
  content: '';
  display: block;
  width: 60px;
  height: 4px;
  margin-top: var(--space-2);
  border-radius: 2px;
  background: linear-gradient(90deg, var(--primary), transparent);
}

.agents-title {
  font-family: var(--heading-font);
  font-size: var(--text-2xl);
  font-weight: var(--heading-weight);
  line-height: 32px;
  letter-spacing: var(--heading-tracking);
  margin: 0 0 var(--space-1);
  color: var(--foreground);
}
.agents-sub {
  font-size: 14px;
  color: var(--muted-foreground);
  margin: 0;
}

.agents-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-3);
  align-items: stretch;
  grid-auto-rows: 1fr;
}
@media (min-width: 768px) {
  .agents-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .agents-grid { grid-template-columns: repeat(3, 1fr); }
}

/* Anchors that wrap cards drop their default link styling — the tile
 * is the visual surface. The anchor still gives cmd-click, middle-click,
 * prefetch, view-transitions, and the right ARIA role for free. */
.agents-card-link,
.agents-cta-link {
  text-decoration: none;
  color: inherit;
  display: contents;
}

.agents-card-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-width: 0;
  flex: 1;
}

.agents-card-head {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.agents-card-title {
  font-size: 14px;
  font-weight: var(--font-weight-semibold);
  color: var(--foreground);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.agents-card-desc {
  font-size: var(--text-xs);
  color: var(--muted-foreground);
  margin: 0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.agents-card-stats {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 10px;
  color: var(--muted-foreground);
}
.agents-card-sep { color: var(--border); }

.agents-card-providers {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 2px;
}

.agents-card-badges {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
  min-height: 22px;
  margin-top: auto;
}

.agents-code {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  padding: 2px var(--radius-md);
  border-radius: var(--radius-sm);
  background: var(--muted);
  color: var(--foreground);
}
</style>
