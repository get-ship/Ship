<script>
component formAssociated

prop value: string = ''
prop placeholder: string = ''
prop name: string = ''
prop rows: number = 4
prop required: boolean = false
prop disabled: boolean = false
prop readonly: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop variant: 'default' | 'code' = 'default'
prop size: 'sm' | 'md' = 'md'
prop resize: 'none' | 'vertical' | 'horizontal' | 'both' = 'vertical'
prop invalid: boolean = false
prop label: string = ''
prop describedBy: string = ''

state defaultValue = ''

derived ariaInvalid = invalid() ? 'true' : 'false'
derived ariaRequired = required() ? 'true' : 'false'
derived resizeStyle = `resize: ${resize()}`

function syncFormValue() {
  if (internals && typeof internals.setFormValue === 'function') {
    internals.setFormValue(value())
  }
}

function notify(v) {
  syncFormValue()
  el.dispatchEvent(new CustomEvent('ship-input', {
    detail: { value: v },
    bubbles: true,
    composed: true,
  }))
}

mount {
  defaultValue.set(value())
  syncFormValue()
}

on form_reset {
  value.set(defaultValue())
  syncFormValue()
}
on form_restore(state) {
  value.set(state ?? '')
  syncFormValue()
}

effect {
  syncFormValue()
}
</script>

<template>
<textarea
  part="textarea"
  placeholder={placeholder}
  name={name}
  rows={rows}
  required={required}
  disabled={disabled}
  readonly={readonly}
  aria-invalid={ariaInvalid}
  aria-required={ariaRequired}
  aria-label={label}
  aria-describedby={describedBy}
  style={resizeStyle}
  bind:value={value}
  on:bind={notify}
></textarea>
</template>

<style>
:host {
  display: block;
  width: 100%;
  --tone: var(--ring-color);
  --tone-fg: var(--foreground);
}
:host([hidden]) { display: none; }

:host(:not([tone])), :host([tone='default']) {
  --tone: var(--ring-color);
  --tone-fg: var(--foreground);
}
:host([tone='info'])        { --tone: var(--info);        --tone-fg: var(--info); }
:host([tone='success'])     { --tone: var(--success);     --tone-fg: var(--success); }
:host([tone='warning'])     { --tone: var(--warning);     --tone-fg: var(--warning); }
:host([tone='destructive']) { --tone: var(--destructive); --tone-fg: var(--destructive); }
:host([tone='accent'])      { --tone: var(--accent);      --tone-fg: var(--accent); }
:host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); }

:host(:not([size])), :host([size='md']) {
  --ta-px: 12px;
  --ta-py: 10px;
  --ta-fs: var(--text-base);
  --ta-lh: 1.5;
  --ta-radius: var(--radius-md);
}
:host([size='sm']) {
  --ta-px: 10px;
  --ta-py: 8px;
  --ta-fs: var(--text-sm);
  --ta-lh: 1.45;
  --ta-radius: var(--radius-sm);
}

textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: var(--ta-radius);
  padding: var(--ta-py) var(--ta-px);
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-body);
  font-size: var(--ta-fs);
  line-height: var(--ta-lh);
  letter-spacing: -0.005em;
  box-shadow: var(--shadow-xs);
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

:host(:not([disabled])) textarea:hover {
  border-color: color-mix(in oklch, var(--border) 160%, transparent);
  box-shadow: var(--shadow-sm);
}

textarea:focus-visible,
textarea:focus {
  outline: none;
  border-color: color-mix(in oklch, var(--tone) 70%, var(--border));
  box-shadow:
    0 0 0 var(--ring-width)
      color-mix(in oklch, var(--tone) var(--ring-opacity), transparent);
}

:host([invalid]) textarea {
  border-color: color-mix(in oklch, var(--destructive) 65%, var(--border));
}
:host([invalid]) textarea:hover {
  border-color: color-mix(in oklch, var(--destructive) 80%, var(--border));
}
:host([invalid]) textarea:focus-visible,
:host([invalid]) textarea:focus {
  border-color: var(--destructive);
  box-shadow:
    0 0 0 var(--ring-width)
      color-mix(in oklch, var(--destructive) var(--ring-opacity), transparent);
}

textarea::placeholder {
  color: var(--muted-foreground);
  opacity: 1;
}
textarea:disabled {
  cursor: not-allowed;
  background: var(--muted);
  border-color: color-mix(in oklch, var(--border) 70%, transparent);
  color: var(--muted-foreground);
  box-shadow: none;
  opacity: 0.6;
}
textarea:read-only { cursor: default; }

:host([variant='code']) textarea {
  font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
  font-size: var(--text-base);
  line-height: 1.55;
  letter-spacing: 0;
  tab-size: 2;
}

@media (forced-colors: active) {
  textarea:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
}
</style>
