<script>
// <ship-scroll-area> — custom-scrollbar viewport with auto-hiding
// scrollbar overlays. Native scrolling drives the viewport; the
// overlay tracks + thumbs are mirrored from `.viewport` metrics.
//
// Attributes:
//   orientation — vertical | horizontal | both (default vertical).
//   size        — sm | md | lg (default md). Width of the thumb channel.
//
// Slots:
//   (default) — scrollable content.
//
// Parts:
//   viewport, scrollbar-v, scrollbar-h.

prop orientation: 'vertical' | 'horizontal' | 'both' = 'vertical'
prop size: 'sm' | 'md' | 'lg' = 'md'

state scrollTimer: any = null

derived showV = orientation() === 'vertical' || orientation() === 'both'
derived showH = orientation() === 'horizontal' || orientation() === 'both'

function updateThumbs() {
  const vp = el.querySelector(':scope > .viewport')
  if (!vp) return
  const vThumb = el.querySelector(':scope > .scrollbar-v > .thumb')
  const hThumb = el.querySelector(':scope > .scrollbar-h > .thumb')
  if (showV() && vThumb) {
    const ratio = vp.clientHeight / vp.scrollHeight
    if (ratio < 1) {
      const thumbH = Math.max(24, ratio * vp.clientHeight)
      const scrollRatio = vp.scrollTop / (vp.scrollHeight - vp.clientHeight)
      const thumbTop = scrollRatio * (vp.clientHeight - thumbH)
      vThumb.style.height = `${thumbH}px`
      vThumb.style.top = `${thumbTop}px`
      vThumb.style.display = ''
    } else {
      vThumb.style.display = 'none'
    }
  }
  if (showH() && hThumb) {
    const ratio = vp.clientWidth / vp.scrollWidth
    if (ratio < 1) {
      const thumbW = Math.max(24, ratio * vp.clientWidth)
      const scrollRatio = vp.scrollLeft / (vp.scrollWidth - vp.clientWidth)
      const thumbLeft = scrollRatio * (vp.clientWidth - thumbW)
      hThumb.style.width = `${thumbW}px`
      hThumb.style.left = `${thumbLeft}px`
      hThumb.style.display = ''
    } else {
      hThumb.style.display = 'none'
    }
  }
}

function onScroll() {
  updateThumbs()
  const vBar = el.querySelector(':scope > .scrollbar-v')
  const hBar = el.querySelector(':scope > .scrollbar-h')
  if (vBar) vBar.classList.add('active')
  if (hBar) hBar.classList.add('active')
  const t = scrollTimer(); if (t) clearTimeout(t)
  scrollTimer.set(setTimeout(() => {
    if (vBar) vBar.classList.remove('active')
    if (hBar) hBar.classList.remove('active')
    scrollTimer.set(null)
  }, 1200))
}

mount {
  const vp = el.querySelector(':scope > .viewport')
  if (vp) {
    vp.addEventListener('scroll', onScroll, { passive: true })
    cleanups.push(() => vp.removeEventListener('scroll', onScroll))
  }
  cleanups.push(() => {
    const t = scrollTimer(); if (t) clearTimeout(t)
  })
  updateThumbs()
}
</script>

<template>
<div class="viewport" part="viewport" tabindex="0">
  <slot></slot>
</div>
{#if showV}
  <div class="scrollbar scrollbar-v" part="scrollbar-v" aria-hidden="true">
    <div class="thumb"></div>
  </div>
{/if}
{#if showH}
  <div class="scrollbar scrollbar-h" part="scrollbar-h" aria-hidden="true">
    <div class="thumb"></div>
  </div>
{/if}
</template>

<style>
:host {
  display: block;
  position: relative;
  overflow: hidden;
}
:host([hidden]) { display: none; }

:host(:not([size])), :host([size='md']) { --sb-size: 8px; }
:host([size='sm']) { --sb-size: 6px; }
:host([size='lg']) { --sb-size: 10px; }

.viewport {
  width: 100%;
  height: 100%;
  overflow: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.viewport::-webkit-scrollbar { display: none; }

:host([orientation='vertical']) .viewport,
:host(:not([orientation])) .viewport { overflow-y: auto; }
:host([orientation='horizontal']) .viewport { overflow-x: auto; }
:host([orientation='both']) .viewport { overflow: auto; }

.scrollbar {
  position: absolute;
  opacity: 0;
  transition: opacity var(--duration-medium) var(--ease-out);
  z-index: 1;
}
:host(:hover) .scrollbar,
:host(:focus-within) .scrollbar,
.scrollbar.active {
  opacity: 1;
}

.scrollbar-v {
  top: 0; right: 2px; bottom: 0;
  width: var(--sb-size);
}
.scrollbar-h {
  left: 0; right: 0; bottom: 2px;
  height: var(--sb-size);
}

.thumb {
  position: absolute;
  border-radius: var(--radius-full);
  background: color-mix(in oklch, var(--foreground) 30%, transparent);
  transition: background-color var(--duration-fast) var(--ease-out);
}
.thumb:hover {
  background: color-mix(in oklch, var(--foreground) 50%, transparent);
}
.scrollbar-v .thumb {
  width: 100%;
  min-height: 24px;
}
.scrollbar-h .thumb {
  height: 100%;
  min-width: 24px;
}

@media (forced-colors: active) {
  .thumb { background: CanvasText; }
}

@media (prefers-reduced-motion: reduce) {
  :host, :host * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
</style>
