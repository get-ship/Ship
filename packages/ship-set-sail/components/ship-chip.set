<script>
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'muted'
prop variant: 'solid' | 'soft' | 'outline' = 'soft'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop selected: boolean = false
prop removable: boolean = false
prop disabled: boolean = false

function onKeydown(e) {
  if (disabled()) return
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault()
    el.click()
    return
  }
  if (removable() && (e.key === 'Backspace' || e.key === 'Delete')) {
    e.preventDefault()
    dispatchRemove()
  }
}

function onRemoveClick(e) {
  e.stopPropagation()
  if (disabled()) return
  dispatchRemove()
}

function dispatchRemove() {
  el.dispatchEvent(new CustomEvent('ship-remove', {
    detail: {},
    bubbles: true,
    composed: true,
  }))
}

derived chipTabIndex = disabled() ? '-1' : '0'
derived ariaDisabled = disabled() ? 'true' : ''
derived ariaPressed = selected() ? 'true' : 'false'

mount {
  el.addEventListener('keydown', onKeydown)
}
</script>

<template>
<:host
  role="button"
  tabindex={chipTabIndex}
  aria-disabled={ariaDisabled}
  aria-pressed={ariaPressed}
/>
<span class="chip" part="chip">
  <span class="leading" part="leading"><slot name="leading"></slot></span>
  <slot></slot>
  {#if removable}
    <button
      class="remove"
      part="remove"
      type="button"
      aria-label="Remove"
      tabindex="-1"
      disabled={disabled}
      onclick={onRemoveClick}
    >
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path d="M2 2 L8 8 M8 2 L2 8" />
      </svg>
    </button>
  {/if}
</span>
</template>

<style>
:host {
  display: inline-flex;
  vertical-align: middle;
  --tone: var(--muted-foreground);
  --tone-fg: var(--muted-foreground);
  --tone-contrast: var(--background);
}
:host([hidden]) { display: none; }

:host(:not([tone])), :host([tone='muted']) {
  --tone: var(--muted-foreground);
  --tone-fg: var(--muted-foreground);
  --tone-contrast: var(--background);
}
:host([tone='default']) { --tone: var(--foreground); --tone-fg: var(--foreground); --tone-contrast: var(--background); }
:host([tone='info']) { --tone: var(--info); --tone-fg: var(--info); --tone-contrast: var(--info-foreground); }
:host([tone='success']) { --tone: var(--success); --tone-fg: var(--success); --tone-contrast: var(--success-foreground); }
:host([tone='warning']) { --tone: var(--warning); --tone-fg: var(--warning); --tone-contrast: var(--warning-foreground); }
:host([tone='destructive']) { --tone: var(--destructive); --tone-fg: var(--destructive); --tone-contrast: var(--destructive-foreground); }
:host([tone='accent']) { --tone: var(--accent); --tone-fg: var(--accent); --tone-contrast: var(--accent-foreground); }

:host(:not([size])), :host([size='md']) {
  --chp-h: 24px; --chp-px: 8px; --chp-fs: var(--text-sm); --chp-gap: 5px;
}
:host([size='sm']) { --chp-h: 20px; --chp-px: 6px; --chp-fs: 11.5px; --chp-gap: 4px; }
:host([size='lg']) { --chp-h: 28px; --chp-px: 10px; --chp-fs: var(--text-base); --chp-gap: 6px; }

.chip {
  display: inline-flex;
  align-items: center;
  gap: var(--chp-gap);
  min-height: var(--chp-h);
  padding: 0 var(--chp-px);
  font-family: var(--font-body);
  font-size: var(--chp-fs);
  font-weight: var(--font-weight-medium);
  line-height: 1;
  border-radius: var(--radius-full);
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  white-space: nowrap;
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
  background: color-mix(in oklch, var(--tone) 14%, transparent);
  border: 1px solid color-mix(in oklch, var(--tone) 22%, transparent);
  color: var(--tone-fg);
}

:host([variant='solid']) .chip {
  background: var(--tone);
  border-color: color-mix(in oklch, var(--tone) 100%, black 6%);
  color: var(--tone-contrast);
}
:host([variant='outline']) .chip {
  background: transparent;
  border-color: color-mix(in oklch, var(--tone) 50%, transparent);
  color: var(--tone-fg);
}

:host(:not([disabled])) .chip:hover {
  background: color-mix(in oklch, var(--tone) 22%, transparent);
}
:host(:not([disabled])[variant='solid']) .chip:hover {
  background: color-mix(in oklch, var(--tone) 92%, white 8%);
}
:host(:not([disabled])[variant='outline']) .chip:hover {
  background: color-mix(in oklch, var(--tone) 10%, transparent);
}

:host([selected]) .chip {
  background: var(--tone);
  border-color: color-mix(in oklch, var(--tone) 100%, black 6%);
  color: var(--tone-contrast);
  box-shadow: inset 0 1px 0 0 color-mix(in oklch, white 18%, transparent);
}

:host(:focus-visible) {
  outline: none;
}
:host(:focus-visible) .chip {
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--tone) 55%, transparent);
}

:host([disabled]) .chip {
  cursor: not-allowed;
  opacity: 0.55;
  filter: saturate(0.6);
}

.remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 14px; height: 14px;
  padding: 0;
  margin-inline-start: 2px;
  background: transparent;
  border: 0;
  color: inherit;
  cursor: pointer;
  border-radius: 50%;
  flex-shrink: 0;
}
.remove:hover { background: color-mix(in oklch, currentColor 18%, transparent); }
.remove svg { width: 8px; height: 8px; stroke: currentColor; stroke-width: 1.4; fill: none; }
</style>
