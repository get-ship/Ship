<script>
prop tone: 'info' | 'success' | 'warning' | 'destructive' | 'muted' = 'info'
prop dismissible: boolean = false

derived assertive = tone() === 'destructive' || tone() === 'warning'
derived role = assertive() ? 'alert' : 'status'
derived live = assertive() ? 'assertive' : 'polite'

function onDismiss() {
  el.dispatchEvent(new CustomEvent('ship-dismiss', {
    bubbles: true,
    composed: true,
  }))
  el.remove()
}
</script>

<template>
<div class="box" role={role} aria-live={live} aria-atomic="true">
  <span><slot name="icon"></slot></span>
  <div class="content">
    <div class="title"><slot name="title"></slot></div>
    <div class="body"><slot></slot></div>
    <div class="actions"><slot name="actions"></slot></div>
  </div>
  {#if dismissible}
    <button class="close" aria-label="Dismiss" on:click={onDismiss}>×</button>
  {:else}
    <span></span>
  {/if}
</div>
</template>

<style>
:host { display: block; --tone-bg: var(--info-bg); --tone-fg: var(--info); --tone-border: var(--info); }
:host(:not([tone])), :host([tone='info']) {
  --tone-bg: color-mix(in oklch, var(--info) 8%, var(--background));
  --tone-fg: var(--info);
  --tone-border: color-mix(in oklch, var(--info) 30%, transparent);
}
:host([tone='success']) {
  --tone-bg: color-mix(in oklch, var(--success) 8%, var(--background));
  --tone-fg: var(--success);
  --tone-border: color-mix(in oklch, var(--success) 30%, transparent);
}
:host([tone='warning']) {
  --tone-bg: color-mix(in oklch, var(--warning) 8%, var(--background));
  --tone-fg: var(--warning);
  --tone-border: color-mix(in oklch, var(--warning) 30%, transparent);
}
:host([tone='destructive']) {
  --tone-bg: color-mix(in oklch, var(--destructive) 8%, var(--background));
  --tone-fg: var(--destructive);
  --tone-border: color-mix(in oklch, var(--destructive) 30%, transparent);
}
:host([tone='muted']) {
  --tone-bg: var(--muted);
  --tone-fg: var(--muted-foreground);
  --tone-border: var(--border);
}

.box {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: start;
  gap: 10px;
  padding: 12px 14px;
  border-radius: var(--radius);
  border: 1px solid var(--tone-border);
  background: var(--tone-bg);
  color: var(--tone-fg);
  font-family: var(--font-body);
  font-size: 13px;
  line-height: 1.5;
}
.content { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.title { font-weight: 600; }
.body { color: var(--foreground); }
.close {
  background: transparent; border: 0; color: inherit;
  cursor: pointer; font-size: 14px; padding: 2px 6px;
  border-radius: 4px;
}
.close:hover { background: color-mix(in oklch, var(--tone-fg) 12%, transparent); }
.actions { display: flex; gap: 6px; margin-top: 6px; }
</style>
