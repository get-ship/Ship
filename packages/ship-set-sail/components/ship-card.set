<script>
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop variant: 'default' | 'outline' = 'default'
prop padding: 'none' | 'sm' | 'md' | 'lg' = 'md'
prop interactive: boolean = false
prop accentBar: boolean = false
prop statusRail: boolean = false
prop fill: boolean = false

derived hostRole = interactive() ? 'button' : ''
derived hostTabIndex = interactive() ? '0' : ''

function onKey(e) {
  if (!interactive()) return
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault()
    el.click()
  }
}

mount {
  el.addEventListener('keydown', onKey)
}
</script>

<template>
<:host role={hostRole} tabindex={hostTabIndex} />
<div class="header" part="header">
  <slot name="header"></slot>
</div>
<div class="content" part="content">
  <slot></slot>
</div>
<div class="footer" part="footer">
  <slot name="footer"></slot>
</div>
</template>

<style>
:host {
  display: block;
  position: relative;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);
  color: var(--card-foreground);
  font-family: var(--font-body);
  --card-tone: var(--border);
  --card-tone-fg: var(--foreground);
}
:host([hidden]) { display: none; }

:host(:not([tone])), :host([tone='default']) { --card-tone: var(--border); --card-tone-fg: var(--foreground); }
:host([tone='info']) { --card-tone: var(--info); --card-tone-fg: var(--info); }
:host([tone='success']) { --card-tone: var(--success); --card-tone-fg: var(--success); }
:host([tone='warning']) { --card-tone: var(--warning); --card-tone-fg: var(--warning); }
:host([tone='destructive']) { --card-tone: var(--destructive); --card-tone-fg: var(--destructive); }
:host([tone='accent']) { --card-tone: var(--accent); --card-tone-fg: var(--accent); }
:host([tone='muted']) { --card-tone: var(--muted-foreground); --card-tone-fg: var(--muted-foreground); }

:host([variant='outline']) {
  background: transparent;
  box-shadow: none;
}

:host([fill]) {
  background: color-mix(in oklch, var(--card-tone) 8%, var(--card));
}

:host([status-rail]) {
  border-left: 0;
  padding-left: 3px;
  background:
    linear-gradient(to right, var(--card-tone) 0, var(--card-tone) 3px, transparent 3px) no-repeat,
    var(--card);
}
:host([status-rail][fill]) {
  background:
    linear-gradient(to right, var(--card-tone) 0, var(--card-tone) 3px, transparent 3px) no-repeat,
    color-mix(in oklch, var(--card-tone) 8%, var(--card));
}

:host([accent-bar])::before {
  content: '';
  position: absolute;
  inset-inline: 0;
  block-size: 2px;
  inset-block-start: -1px;
  background: linear-gradient(90deg,
    color-mix(in oklch, var(--card-tone) 100%, transparent) 0,
    color-mix(in oklch, var(--card-tone) 30%, transparent) 100%);
  opacity: 0;
  transition: opacity var(--duration-fast) var(--ease-out);
  border-top-left-radius: var(--radius-lg);
  border-top-right-radius: var(--radius-lg);
}
:host([accent-bar]:hover)::before { opacity: 1; }

:host(:not([padding])), :host([padding='md']) {
  --card-pad-x: 20px; --card-pad-y: 16px;
}
:host([padding='none']) { --card-pad-x: 0; --card-pad-y: 0; }
:host([padding='sm']) { --card-pad-x: 12px; --card-pad-y: 10px; }
:host([padding='lg']) { --card-pad-x: 24px; --card-pad-y: 20px; }

.header, .content, .footer {
  padding: var(--card-pad-y) var(--card-pad-x);
}
.header { padding-block-end: 0; }
.footer { padding-block-start: 0; }

.header:has(slot[name='header']:not(:empty)),
.header:has(::slotted(*)) {
  border-block-end: 1px solid var(--border);
  padding-block-end: var(--card-pad-y);
}
.footer:has(slot[name='footer']:not(:empty)),
.footer:has(::slotted(*)) {
  border-block-start: 1px solid var(--border);
  padding-block-start: var(--card-pad-y);
}

/* When the header/footer slots are empty (no fill), collapse them
 * so the card doesn't display empty padding wells. The `:has()`
 * checks above only fire with content; this handles the empty case. */
.header:not(:has(*)), .footer:not(:has(*)) {
  display: none;
}

:host([interactive]) {
  cursor: pointer;
  transition:
    box-shadow var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out);
}
:host([interactive]:hover) {
  box-shadow: var(--shadow-sm);
  transform: translateY(-1px);
  border-color: color-mix(in oklch, var(--card-tone) 40%, var(--border));
}
:host([interactive]:active) {
  transform: translateY(0);
  box-shadow: var(--shadow-xs);
}
:host([interactive]:focus-visible) {
  outline: none;
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--card-tone) var(--ring-opacity), transparent);
}

@media (prefers-reduced-motion: reduce) {
  :host([interactive]:hover) { transform: none; }
}
</style>
