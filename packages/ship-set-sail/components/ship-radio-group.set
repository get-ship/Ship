<script>
component formAssociated

prop value: string = ''
prop disabled: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop name: string = ''
prop label: string = ''

state defaultValue = ''

function radios() {
  return Array.from(el.querySelectorAll('ship-radio'))
}

function enabledRadios() {
  if (disabled()) return []
  return radios().filter(r => !r.hasAttribute('disabled'))
}

function syncFormValue() {
  if (internals && typeof internals.setFormValue === 'function') {
    internals.setFormValue(value())
  }
}

function syncRadios() {
  const v = value()
  const dis = disabled()
  const groupHasTone = el.hasAttribute('tone')
  const groupHasSize = el.hasAttribute('size')
  const groupTone = el.getAttribute('tone') || ''
  const groupSize = el.getAttribute('size') || ''
  for (const r of radios()) {
    if (r.getAttribute('value') === v) r.setAttribute('checked', '')
    else r.removeAttribute('checked')
    if (groupHasTone && !r.hasAttribute('tone')) r.setAttribute('tone', groupTone)
    if (groupHasSize && !r.hasAttribute('size')) r.setAttribute('size', groupSize)
    if (dis) r.setAttribute('disabled', '')
  }
}

function onRadioSelect(e) {
  e.stopPropagation()
  const newValue = e.detail.value
  if (newValue === value()) return
  value.set(newValue)
  el.setAttribute('value', newValue)
  syncRadios()
  syncFormValue()
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { value: newValue },
    bubbles: true,
    composed: true,
  }))
}

function onRadioNav(e) {
  e.stopPropagation()
  const enabled = enabledRadios()
  if (!enabled.length) return
  const target = e.target
  const current = target && target.closest ? target.closest('ship-radio') : null
  const idx = current ? enabled.indexOf(current) : -1
  let next
  if (e.detail.direction === 'next') {
    next = enabled[(idx + 1) % enabled.length]
  } else {
    next = enabled[(idx - 1 + enabled.length) % enabled.length]
  }
  const v = next.getAttribute('value') || ''
  value.set(v)
  el.setAttribute('value', v)
  syncRadios()
  syncFormValue()
  const input = next.querySelector('input')
  if (input) input.focus()
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { value: v },
    bubbles: true,
    composed: true,
  }))
}

mount {
  if (!el.hasAttribute('role')) el.setAttribute('role', 'radiogroup')
  if (label()) el.setAttribute('aria-label', label())
  defaultValue.set(value())
  el.addEventListener('ship-radio-select', onRadioSelect)
  el.addEventListener('ship-radio-nav', onRadioNav)
  // Defer the first sync so child <ship-radio> elements are upgraded
  // before we read their attributes and write checked/tone/size back.
  queueMicrotask(() => {
    syncRadios()
    syncFormValue()
  })
}

on form_reset {
  const v = defaultValue()
  value.set(v)
  el.setAttribute('value', v)
  syncRadios()
  syncFormValue()
}

on form_restore(state) {
  const v = state == null ? '' : String(state)
  value.set(v)
  el.setAttribute('value', v)
  syncRadios()
  syncFormValue()
}

effect {
  syncRadios()
  syncFormValue()
}
</script>

<template>
<slot></slot>
</template>

<style>
:host {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  font-family: var(--font-body);
  color: var(--foreground);
}
:host([hidden]) { display: none; }

@media (prefers-reduced-motion: reduce) {
  :host { /* honor reduced motion in nested radios via their own rules */ }
}
</style>
