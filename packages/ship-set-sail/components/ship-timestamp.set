<script>
prop value: string = ''
prop format: 'relative' | 'absolute' | 'both' = 'relative'

state tick = 0  // bumps once per minute to refresh relative labels

function formatRelative(iso, now) {
  const MINUTE = 60_000
  const HOUR = 3_600_000
  const DAY = 86_400_000
  const t = Date.parse(iso)
  if (Number.isNaN(t)) return iso
  const diff = now - t
  const abs = Math.abs(diff)
  const suffix = diff >= 0 ? 'ago' : 'from now'
  if (abs < MINUTE) return 'just now'
  if (abs < HOUR) return `${Math.floor(abs / MINUTE)}m ${suffix}`
  if (abs < DAY) return `${Math.floor(abs / HOUR)}h ${suffix}`
  const days = Math.floor(abs / DAY)
  if (days < 30) return `${days}d ${suffix}`
  if (days < 365) return `${Math.floor(days / 30)}mo ${suffix}`
  return `${Math.floor(days / 365)}y ${suffix}`
}

derived rel = (() => {
  tick()  // dep on the per-minute tick
  return value() ? formatRelative(value(), Date.now()) : ''
})()
derived absText = value()
  ? (Number.isNaN(Date.parse(value())) ? value() : new Date(Date.parse(value())).toISOString())
  : ''

mount {
  const id = setInterval(() => tick.set(tick() + 1), 60_000)
  el.addEventListener('sail:cleanup', () => clearInterval(id))
}

effect {
  el.title = absText()
}

unmount {
  // setInterval cleanup happens via the cleanup return; mount sets it up.
}
</script>

<template>
{#if value}
  {#if format === 'absolute'}
    <time datetime={value}>{absText()}</time>
  {:else if format === 'both'}
    <time datetime={value}>{rel()}</time><span class="abs">({absText()})</span>
  {:else}
    <time datetime={value}>{rel()}</time>
  {/if}
{:else}
  <span></span>
{/if}
</template>

<style>
:host {
  display: inline;
  font-family: var(--font-body);
  font-size: inherit;
  color: inherit;
}
.abs { color: var(--muted-foreground); margin-left: 4px; }
</style>
