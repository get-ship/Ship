<script>
// ship-list-tile — generic row/card tile primitive. Visual rhythm,
// density, and tone live here; navigation does NOT. Wrap in <a href>
// when you want a link — the platform already knows how to do that
// and gives cmd-click, middle-click, prefetch, view-transitions, etc.
// for free.
//
// Slots: leading, default (primary), meta (secondary), trailing.
// Event: ship-select — bubbles, composed, cancelable. Dispatched when
//   `interactive` and the user clicks or presses Enter/Space.

prop variant: 'row' | 'card' = 'row'
prop interactive: boolean = false
prop selected: boolean = false
prop disabled: boolean = false
prop density: 'compact' | 'normal' | 'relaxed' = 'normal'
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' | 'primary' = 'default'

derived tabIndexAttr = (interactive() && !disabled()) ? '0' : ''

function dispatchSelect() {
  if (disabled() || !interactive()) return false
  const ev = new CustomEvent('ship-select', {
    detail: {},
    bubbles: true,
    composed: true,
    cancelable: true,
  })
  el.dispatchEvent(ev)
  return ev.defaultPrevented
}

function onClick() {
  if (!interactive()) return
  dispatchSelect()
}

function onKeyDown(e) {
  if (!interactive() || disabled()) return
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault()
    dispatchSelect()
  }
}

function installDividers() {
  // Document-level sibling rule for adjacent row-variant tiles. Light
  // DOM custom elements can't style sibling hosts from their own scoped
  // sheet, so register on the owning document. Idempotent across many
  // tile instances via a marker attribute on document.head.
  const doc = el.ownerDocument || document
  if (doc.head.querySelector('style[data-ship-list-tile-dividers]')) return
  const style = doc.createElement('style')
  style.setAttribute('data-ship-list-tile-dividers', '')
  style.textContent =
    "ship-list-tile[variant='row'] + ship-list-tile[variant='row'] { border-top: 1px solid var(--border-subtle); }" +
    "ship-list-tile[variant='row'][selected] + ship-list-tile[variant='row']," +
    "ship-list-tile[variant='row'] + ship-list-tile[variant='row'][selected] { border-top: none; }"
  doc.head.appendChild(style)
}

mount {
  installDividers()
}
</script>

<template>
<:host
  role={interactive ? 'button' : 'listitem'}
  aria-selected={selected ? 'true' : 'false'}
  aria-disabled={disabled ? 'true' : 'false'}
/>
<div
  class="tile"
  part="button"
  tabindex={tabIndexAttr}
  onclick={onClick}
  onkeydown={onKeyDown}
>
  <div class="row" part="row">
    <slot name="leading"></slot>
    <span class="primary" part="primary"><slot></slot></span>
    <span part="trailing"><slot name="trailing"></slot></span>
  </div>
  <div class="secondary" part="secondary"><slot name="meta"></slot></div>
</div>
</template>

<style>
:host {
  display: block;
  --pad-y: 10px;
  --pad-x: 10px;
  --tone-fg: var(--foreground);
}
:host([hidden]) { display: none; }
:host([density='compact']) { --pad-y: 6px;  --pad-x: 8px; }
:host([density='relaxed']) { --pad-y: 16px; --pad-x: 14px; }

:host(:not([tone])), :host([tone='default']) { --tone-fg: var(--foreground); }
:host([tone='info'])        { --tone-fg: var(--info); }
:host([tone='success'])     { --tone-fg: var(--success); }
:host([tone='warning'])     { --tone-fg: var(--warning); }
:host([tone='destructive']) { --tone-fg: var(--destructive); }
:host([tone='accent'])      { --tone-fg: var(--accent); }
:host([tone='muted'])       { --tone-fg: var(--muted-foreground); }
:host([tone='primary'])     { --tone-fg: var(--primary); }

.tile {
  width: 100%;
  text-align: left;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  padding: var(--pad-y) var(--pad-x);
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: inherit;
  font: inherit;
  box-sizing: border-box;
  transition:
    background-color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}

/* card variant fills allocated track height for grids of equal cards */
:host([variant='card']) { height: 100%; box-sizing: border-box; }
:host([variant='card']) .tile { min-height: 100%; }
:host([variant='card']) .row { flex: 1; align-items: stretch; }
:host([variant='card']) ::slotted([slot='leading']) { align-self: flex-start; }
:host([variant='card']) .primary {
  display: flex;
  flex-direction: column;
  align-self: stretch;
}

:host([variant='row']) .tile:hover,
:host(:not([variant])) .tile:hover {
  background: var(--muted);
  border-color: var(--border);
}

:host([variant='card']) .tile {
  background: var(--card);
  border-color: var(--border-subtle);
  box-shadow: var(--shadow-card-rest);
  backdrop-filter: var(--card-backdrop-filter);
  -webkit-backdrop-filter: var(--card-backdrop-filter);
  position: relative;
}
:host([variant='card']) .tile::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: var(--card-texture);
  mix-blend-mode: var(--card-texture-blend);
  opacity: var(--card-texture-opacity);
  border-radius: inherit;
  z-index: 0;
}
:host([variant='card']) .tile > * { position: relative; z-index: 1; }
:host([variant='card']) .tile:hover {
  border-color: var(--tone-primary-border);
  box-shadow: var(--shadow-hover);
  transform: translateY(-1px);
}
:host([variant='card'][interactive]) .tile:active {
  transform: translateY(0);
  box-shadow: var(--shadow-card-rest);
  transition-duration: 60ms;
}

.tile:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--ring-color) var(--ring-opacity), transparent);
}

:host([selected]) .tile {
  background: var(--muted);
  border-color: var(--primary);
}

:host([disabled]) .tile {
  opacity: 0.6;
  cursor: not-allowed;
  pointer-events: none;
}

:host([interactive]) .tile { cursor: pointer; }

:host([tone]:not([tone='default'])) .tile {
  border-left: 3px solid var(--tone-fg);
  padding-left: calc(var(--pad-x) - 2px);
}

.row { display: flex; align-items: center; gap: 8px; }
.primary {
  flex: 1;
  min-width: 0;
  font-weight: var(--font-weight-medium);
  font-size: var(--text-base);
}
.secondary {
  display: flex;
  gap: 6px;
  align-items: center;
  font-size: 10px;
  color: var(--muted-foreground);
}
.secondary:empty { display: none; }

::slotted([slot='leading']),
::slotted([slot='trailing']) {
  display: inline-flex;
  align-items: center;
}

@media (prefers-reduced-motion: reduce) {
  :host([variant='card']) .tile::after { background: none; }
  :host([variant='card']) .tile:hover { transform: none; }
}
@media (forced-colors: active) {
  .tile:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
}
</style>
