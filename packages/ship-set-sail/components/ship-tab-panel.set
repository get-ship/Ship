<script>
prop name: string = ''
prop active: boolean = false

derived panelId = name() ? `ship-tabpanel-${name()}` : ''
derived labelledBy = name() ? `ship-tab-${name()}` : ''

mount {
  if (panelId() && !el.id) el.id = panelId()
}
</script>

<template>
<:host role="tabpanel" tabindex="0" aria-labelledby={labelledBy} />
<slot></slot>
</template>

<style>
:host { display: none; }
:host([active]) { display: block; }
</style>
