<script>
component formAssociated

prop checked: boolean = false
prop disabled: boolean = false
prop tone: 'default' | 'info' | 'success' | 'warning' | 'destructive' | 'accent' | 'muted' = 'default'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop name: string = ''
prop value: string = 'on'
prop label: string = ''

state defaultChecked = false

derived ariaLabel = label() || name() || 'toggle'

function syncFormValue() {
  if (internals && typeof internals.setFormValue === 'function') {
    internals.setFormValue(checked() ? value() : null)
  }
}

function onChange(e) {
  const c = e.target.checked
  checked.set(c)
  if (c) el.setAttribute('checked', '')
  else el.removeAttribute('checked')
  syncFormValue()
  el.dispatchEvent(new CustomEvent('ship-change', {
    detail: { checked: c },
    bubbles: true,
    composed: true,
  }))
}

mount {
  defaultChecked.set(el.hasAttribute('checked'))
  syncFormValue()
}

on form_reset {
  checked.set(defaultChecked())
  if (defaultChecked()) el.setAttribute('checked', '')
  else el.removeAttribute('checked')
  syncFormValue()
}
on form_restore(state) {
  const c = state === value()
  checked.set(c)
  if (c) el.setAttribute('checked', '')
  else el.removeAttribute('checked')
  syncFormValue()
}

effect {
  syncFormValue()
}
</script>

<template>
<label>
  <span class="track" part="track">
    <input
      part="input"
      type="checkbox"
      role="switch"
      disabled={disabled}
      aria-checked={checked() ? 'true' : 'false'}
      aria-label={ariaLabel}
      bind:checked={checked}
      onchange={onChange}
    />
    <span class="thumb" part="thumb"></span>
  </span>
  <slot></slot>
</label>
</template>

<style>
:host {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  vertical-align: middle;
  font-family: var(--font-body);
  font-size: var(--text-base);
  color: var(--foreground);
  --tone: var(--primary);
}
:host([hidden]) { display: none; }

:host(:not([tone])), :host([tone='default']) { --tone: var(--primary); }
:host([tone='info']) { --tone: var(--info); }
:host([tone='success']) { --tone: var(--success); }
:host([tone='warning']) { --tone: var(--warning); }
:host([tone='destructive']) { --tone: var(--destructive); }
:host([tone='accent']) { --tone: var(--accent); }
:host([tone='muted']) { --tone: var(--muted-foreground); }

:host(:not([size])), :host([size='md']) {
  --sw-w: 28px; --sw-h: 16px; --sw-thumb: 12px;
}
:host([size='sm']) { --sw-w: 24px; --sw-h: 14px; --sw-thumb: 10px; }
:host([size='lg']) { --sw-w: 32px; --sw-h: 18px; --sw-thumb: 14px; }

label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}
:host([disabled]) label { cursor: not-allowed; }

.track {
  position: relative;
  display: inline-flex;
  align-items: center;
  width: var(--sw-w);
  height: var(--sw-h);
  background: color-mix(in oklch, var(--border) 200%, transparent);
  border-radius: 999px;
  flex-shrink: 0;
  transition:
    background-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
  box-shadow: inset 0 1px 2px 0 color-mix(in oklch, black 10%, transparent);
}
:host([checked]) .track {
  background: var(--tone);
  box-shadow: inset 0 1px 2px 0 color-mix(in oklch, black 12%, transparent);
}
:host(:not([disabled]):not([checked])) label:hover .track {
  background: color-mix(in oklch, var(--border) 240%, transparent);
}
:host([checked]:not([disabled])) label:hover .track {
  background: color-mix(in oklch, var(--tone) 92%, white 8%);
}

.thumb {
  position: absolute;
  inset-block: 50%;
  inset-inline-start: calc((var(--sw-h) - var(--sw-thumb)) / 2);
  width: var(--sw-thumb);
  height: var(--sw-thumb);
  background: var(--background);
  border-radius: 50%;
  transform: translateY(-50%);
  box-shadow: 0 1px 2px 0 color-mix(in oklch, black 18%, transparent);
  transition: transform var(--duration-fast) var(--ease-spring, cubic-bezier(0.5, 0, 0.2, 1.4));
  pointer-events: none;
}
:host([checked]) .thumb {
  transform: translate(calc(var(--sw-w) - var(--sw-h)), -50%);
}

input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
  cursor: inherit;
  appearance: none;
  -webkit-appearance: none;
}

:host(:not([disabled])) label:has(input:focus-visible) .track {
  box-shadow:
    inset 0 1px 2px 0 color-mix(in oklch, black 10%, transparent),
    0 0 0 var(--ring-offset) var(--background),
    0 0 0 calc(var(--ring-offset) + var(--ring-width))
      color-mix(in oklch, var(--tone) var(--ring-opacity), transparent);
}

:host([disabled]) {
  color: var(--muted-foreground);
}
:host([disabled]) .track {
  background: var(--muted);
  filter: saturate(0.6);
}
:host([disabled][checked]) .track {
  background: color-mix(in oklch, var(--tone) 55%, var(--muted));
}

@media (prefers-reduced-motion: reduce) {
  .thumb { transition: none; }
}
@media (forced-colors: active) {
  .track { border: 1px solid CanvasText; }
  :host([checked]) .track { background: Highlight; }
  .thumb { background: HighlightText; }
}
</style>
