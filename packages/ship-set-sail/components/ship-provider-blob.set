<script>
prop provider: 'claude' | 'codex' | 'cursor' | 'gemini' | 'opencode' = 'claude'
prop size: 'sm' | 'md' | 'lg' = 'md'
prop variant: 'tile' | 'glyph' = 'tile'

// Brand SVG markup is inlined inside `svgFor`. Module-level `const`
// declarations in script blocks are not currently emitted by the compiler
// (see .artifacts/set/gaps.md), so the strings live inside a function body.
// `currentColor` is preserved where the upstream SVG used it (Cursor); brand
// fills are kept verbatim.
