{
  "name": "@ship/ui-dom",
  "version": "0.1.0",
  "description": "SUI DOM interpreter — parses .sui files and hydrates them against @ship/ui-runtime.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --format=esm --target=es2020 --external:@ship/ui-runtime --outfile=../../apps/shipd/assets/sui-dom.js --log-level=warning",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/ui-runtime": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
