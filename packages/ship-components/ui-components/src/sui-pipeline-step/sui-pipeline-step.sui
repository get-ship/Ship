<!--
  <sui-pipeline-step> — SUI port of <ship-pipeline-step>.

  A single step node inside a <sui-pipeline-dag>. Attribute-driven —
  matches the pipelines view `.step` element exactly: status-tinted
  background, absolute-positioned status icon top-right.

  Prop / event / method parity vs <ship-pipeline-step>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  name (string, '')            name (string, '')        ✓ reflects
  step-type (enum, 'agent')    step-type (enum,         ✓ reflects
                                  'agent')
  state (enum, 'pending')      state (enum, 'pending')  ✓ reflects, drives
                                                         host tone via CSS
  agent (string, '')           agent (string, '')       ✓ reflects
  ─────────────────────────────────────────────────────────────────────────────
  composes ship-spinner        composes sui-spinner     ✓ shown in running
                                                         state
  role=listitem on host        controller sets on mount ✓
  aria-label = "{type} step    controller effect        ✓ recomputed when
    {name} ({agent}): {state}"   on prop change           any prop changes
  ─────────────────────────────────────────────────────────────────────────────
  slots: none                  slots: none              ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" reflect />
<prop name="step-type" values="agent|gate|merge|run|human" default="agent" reflect />
<prop name="state" values="pending|running|completed|failed" default="pending" reflect />
<prop name="agent" type="string" default="" reflect />

<style>
  :host {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    min-width: 130px;
    background: var(--background);
    position: relative;
    font-family: var(--font-body);
  }
  :host([hidden]) { display: none; }
  .icon {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 10px;
    color: var(--muted-foreground);
    line-height: 1;
  }
  :host([state='completed']) {
    border-color: var(--tone-success-border);
    background: var(--tone-success-bg);
  }
  :host([state='completed']) .icon { color: var(--success); }
  :host([state='running']) {
    border-color: var(--tone-info-border);
    background: var(--tone-info-bg);
    box-shadow: 0 0 0 3px var(--tone-info-ring);
  }
  :host([state='running']) .icon { color: var(--info); }
  :host([state='failed']) {
    border-color: var(--tone-destructive-border);
    background: var(--tone-destructive-bg);
  }
  :host([state='failed']) .icon { color: var(--destructive); }

  .name {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    padding-right: 16px;
    color: var(--foreground);
  }
  .type {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted-foreground);
  }
  .status {
    font-size: 10px;
    color: var(--muted-foreground);
  }
  sui-spinner {
    position: absolute;
    top: 10px;
    right: 12px;
  }
</style>

{#if state() === 'running'}
  <sui-spinner size="sm" tone="info" label="Running"></sui-spinner>
{:else}
  <span class="icon" aria-hidden="true">{
    state() === 'completed' ? '✓' :
    state() === 'failed'    ? '✗' : '○'
  }</span>
{/if}
<span class="name">{name()}</span>
<span class="type">{stepType()}{#if agent()} · {agent()}{/if}</span>
<span class="status">{state()}</span>
