<!--
  <sui-stepper> — SUI port of <ship-stepper>.
  Linear progress indicator: N dots, active one widened to a pill.
  Dots are rendered dynamically by the controller on total/current changes.

  Prop parity vs <ship-stepper>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  total (number, 4)            total (number, 4,        ✓
                                 reflect)
  current (number, 1)          current (number, 1,      ✓
                                 reflect)
  tone (Tone, undefined)       tone (string, '',        ✓ tints active dot
                                 reflect)
  size ('sm'|'md'|'lg', 'md') size (sm|md|lg, 'md',    ✓
                                 reflect)
  label (string, '')           label (string, '')       ✓ → aria-label on host
  ─────────────────────────────────────────────────────────────────────────────
  parts: dot                   part="dot"               ✓
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: role=progressbar,      controller sets same     ✓
    aria-valuemin/max/now,       on host element
    aria-label
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="total" type="number" default="4" reflect />
<prop name="current" type="number" default="1" reflect />
<prop name="tone" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2, 8px);
    --dot-w: 7px;
    --dot-h: 7px;
    --dot-active-w: 22px;
    --tone-fg: var(--primary);
  }
  :host([hidden]) { display: none; }

  :host([size='sm']) { --dot-w: 6px; --dot-h: 6px; --dot-active-w: 18px; }
  :host([size='lg']) { --dot-w: 9px; --dot-h: 9px; --dot-active-w: 28px; }

  /* Tone overrides */
  :host([tone='primary'])     { --tone-fg: var(--primary); }
  :host([tone='info'])        { --tone-fg: var(--info); }
  :host([tone='success'])     { --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone-fg: var(--destructive); }
  :host([tone='accent'])      { --tone-fg: var(--accent-foreground); }
  :host([tone='muted'])       { --tone-fg: var(--muted-foreground); }

  .dot {
    width: var(--dot-w);
    height: var(--dot-h);
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--muted-foreground) 35%, transparent);
    transition: all var(--duration-medium) var(--ease-out);
    flex-shrink: 0;
  }

  .dot[data-state='active'] {
    width: var(--dot-active-w);
    background: var(--primary);
  }
  :host([tone]) .dot[data-state='active'] {
    background: var(--tone-fg);
  }

  .dot[data-state='done'] {
    background: color-mix(in oklch, var(--primary) 55%, transparent);
  }
  :host([tone]) .dot[data-state='done'] {
    background: color-mix(in oklch, var(--tone-fg) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .dot { transition: none; }
  }
</style>

<div class="dots" bind:this={dotsEl}></div>
