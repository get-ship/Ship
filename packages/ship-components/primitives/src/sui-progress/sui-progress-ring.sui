<!--
  <sui-progress-ring> — SUI port of <ship-progress-ring>.
  SVG-based circular progress ring. Determinate (value/max) or indeterminate.

  Prop parity vs <ship-progress-ring>
  ─────────────────────────────────────────────────────────────────────────────
  Lit               SUI               Notes
  ─────────────────────────────────────────────────────────────────────────────
  value (0..100)    value (0..max)    ✓ SUI adds explicit max prop
  size (px, 48)     size (px, 48)     ✓
  thickness (px,4)  track-width (px)  renamed for clarity
  tone              tone              ✓ vocabulary extended to match sui-progress
  label             label             ✓ maps to aria-label on SVG
                    max (100)         SUI externalizes max for flexibility
                    indeterminate     SUI adds explicit indeterminate bool
  ─────────────────────────────────────────────────────────────────────────────
  parts: track (background circle), ring (progress arc)
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="value" type="number" default="0" />
<prop name="max" type="number" default="100" />
<prop name="size" type="number" default="48" />
<prop name="track-width" type="number" default="4" />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent" default="primary" reflect />
<prop name="indeterminate" type="bool" default="false" reflect />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: inline-block;
    --tone: var(--primary);
  }
  :host([hidden]) { display: none; }

  .ring {
    position: relative;
  }

  .ring-svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  :host([indeterminate]) .ring-svg {
    animation: sui-ring-spin 1.4s linear infinite;
  }
  @keyframes sui-ring-spin {
    from { transform: rotate(-90deg); }
    to   { transform: rotate(270deg); }
  }

  .track { stroke: var(--muted); }

  .bar {
    stroke: var(--tone);
    transition: stroke-dashoffset var(--duration-medium, 220ms) var(--ease-out, ease-out);
  }

  .label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    font-family: var(--font-body);
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :host([indeterminate]) .ring-svg { animation-duration: 3s; }
    .bar { transition: none; }
  }
</style>

<div class="ring" style={'width:' + size() + 'px;height:' + size() + 'px'}>
  <svg
    class="ring-svg"
    viewBox={'0 0 ' + size() + ' ' + size()}
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax={max()}
    aria-valuenow={indeterminate() ? null : (value() < 0 ? 0 : value() > max() ? max() : value())}
    aria-label={label() || null}
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle
      class="track"
      part="track"
      cx={size() / 2}
      cy={size() / 2}
      r={(size() - trackWidth()) / 2}
      fill="none"
      stroke-width={trackWidth()}
    />
    <circle
      class="bar"
      part="ring"
      cx={size() / 2}
      cy={size() / 2}
      r={(size() - trackWidth()) / 2}
      fill="none"
      stroke-width={trackWidth()}
      stroke-linecap="round"
      stroke-dasharray={3.141592653589793 * (size() - trackWidth())}
      stroke-dashoffset={indeterminate() ? 3.141592653589793 * (size() - trackWidth()) * 0.25 : 3.141592653589793 * (size() - trackWidth()) * (1 - (value() < 0 ? 0 : value() > (max() || 1) ? 1 : value() / (max() || 1)))}
    />
  </svg>
  <div class="label" aria-hidden="true"><slot></slot></div>
</div>
