<!--
  <sui-toolbar> — SUI port of <ship-toolbar>.
  Horizontal flex row of actions with optional spacer and keyboard navigation.

  Prop / event parity vs <ship-toolbar>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                           SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  justify (start|…, 'start')   justify (union, 'start', ✓
                                  reflect)
  align (center|…, 'center')   align (union, 'center',  ✓
                                  reflect)
  gap (sm|md|lg, 'md')         gap (union, 'md',        ✓
                                  reflect)
  variant (default|bordered,   variant (union,           ✓
    'default')                   'default', reflect)
  ─────────────────────────────────────────────────────────────────────────────
  role=toolbar +                controller sets on       ✓
    aria-orientation=horizontal   host mount
  ArrowLeft/Right cycles focus  ✓ controller handles     ✓
  ─────────────────────────────────────────────────────────────────────────────
  Slots: spacer, (default)      spacer, (default)        ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="justify" values="start|center|end|between" default="start" reflect />
<prop name="align" values="center|start|end|baseline" default="center" reflect />
<prop name="gap" values="sm|md|lg" default="md" reflect />
<prop name="variant" values="default|bordered" default="default" reflect />

<style>
  :host {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  :host([hidden]) { display: none; }
  :host([gap='sm']) { gap: 4px; }
  :host([gap='lg']) { gap: 12px; }
  :host([justify='center']) { justify-content: center; }
  :host([justify='end']) { justify-content: flex-end; }
  :host([justify='between']) { justify-content: space-between; }
  :host([align='start']) { align-items: flex-start; }
  :host([align='end']) { align-items: flex-end; }
  :host([align='baseline']) { align-items: baseline; }
  :host([variant='bordered']) {
    padding: 12px 20px;
    border-top: 1px solid var(--border);
  }
  ::slotted([slot='spacer']) { flex: 1; }
</style>

<slot name="spacer"></slot>
<slot bind:this={defaultSlot}></slot>
