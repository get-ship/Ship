{
  "name": "@ship/vite-plugin-sui",
  "version": "0.1.0",
  "description": "Vite plugin that compiles .sui files to JS via the sui-compiler binary. Replaces scripts/build-bundles.mjs and crates/ship-ui-framework/src/dev_assets.rs.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "../../apps/spike-bun-vite/.local/bun test",
    "test:watch": "../../apps/spike-bun-vite/.local/bun test --watch"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.1"
  }
}
