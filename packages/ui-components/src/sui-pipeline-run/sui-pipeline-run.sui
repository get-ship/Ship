<!--
  <sui-pipeline-run> — SUI port of <ship-pipeline-run>.

  Pipeline run row. Composes <sui-card status-rail tone=…> + a header
  with the run slug + agent code on the left and a tone-tinted
  <sui-badge> on the right. Same state→tone mapping as the lit version.

  Prop / event / slot parity vs <ship-pipeline-run>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  state (RunState, 'pending')  state (enum, 'pending',  ✓ reflects
                                  reflect)
  slug (string, '')            slug (string, '')        ✓ reflects
  agent (string, '')           agent (string, '')       ✓ reflects
  ─────────────────────────────────────────────────────────────────────────────
  STATE_TO_TONE map            derived tone() in        ✓ same table
                                 controller scope
  ─────────────────────────────────────────────────────────────────────────────
  role=article + aria-label    controller effect        ✓ recomputed when
    on host                                                slug/agent/state
                                                           change
  ─────────────────────────────────────────────────────────────────────────────
  slots: default (DAG),        slots: default,          ✓
    actions (header right),      actions, footer
    footer
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="state" values="dispatched|gatepending|running|completed|failed|merged|pending" default="pending" reflect />
<prop name="slug" type="string" default="" reflect />
<prop name="agent" type="string" default="" reflect />

<style>
  :host { display: block; }
  :host([hidden]) { display: none; }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .slug {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--foreground);
  }
  .agent { font-size: 11px; color: var(--muted-foreground); }
  .agent code {
    background: var(--muted);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 10.5px;
    font-family: var(--font-mono);
  }
</style>

<sui-card status-rail tone={tone()}>
  <div slot="header">
    <header>
      <div class="left">
        <span class="slug">{slug()}</span>
        {#if agent()}
          <span class="agent"><code>{agent()}</code></span>
        {/if}
        <slot name="actions"></slot>
      </div>
      <sui-badge tone={tone()}>{state()}</sui-badge>
    </header>
  </div>
  <slot></slot>
  <div slot="footer"><slot name="footer"></slot></div>
</sui-card>
