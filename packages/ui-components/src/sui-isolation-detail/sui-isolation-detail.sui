<!--
  <sui-isolation-detail> — full isolation decision card.

  Read-only counterpart to <sui-isolation-badge>: shows the resolved
  tier + strategy, the reason the recommender chose them, and whether
  the choice was downgraded from a preferred option. Designed for
  /settings/isolation, the wizard's "current state" panel, and any
  actor/agent detail view that wants the full picture.

  Auto-fetches /api/v1/isolation/status when no props supplied; views
  that already hold a decision pass it via attributes and skip the
  round-trip.

  Props
  ─────────────────────────────────────────────────────────────────────
  tier (none|process|container|vm|cloud|unknown, 'unknown')
    The resolved isolation tier.
  strategy (string, '')
    Resolved strategy id (noop, harness_native, srt, docker, ...).
  reason (string, '')
    Human-readable reason — what drove the choice. Mirrors the
    server-side ResolutionReason::* variants.
  downgraded (boolean, false)
    Recommender's preferred tier was unavailable.
  preferred-tier (string, '')
    Optional: the tier we wanted but couldn't get. Only meaningful
    when downgraded=true.
-->

<prop name="tier" values="none|process|container|vm|cloud|unknown" default="unknown" reflect />
<prop name="strategy" type="string" default="" reflect />
<prop name="reason" type="string" default="" />
<prop name="downgraded" values="false|true" default="false" reflect />
<prop name="preferred-tier" type="string" default="" />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--foreground);
    border: 1px solid var(--border);
    background: var(--background);
    border-radius: 8px;
    padding: 12px 14px;
    line-height: 1.4;
  }
  :host([downgraded="true"]) {
    border-color: var(--tone-warning-border);
    background: var(--tone-warning-bg);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }
  .row:last-child { margin-bottom: 0; }
  .key {
    color: var(--muted-foreground);
    font-size: 11px;
    min-width: 72px;
    flex-shrink: 0;
  }
  .value {
    color: var(--foreground);
    font-weight: 500;
  }
  .pill {
    display: none;
    align-items: center;
    gap: 4px;
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 10.5px;
    border-width: 1px;
    border-style: solid;
    border-color: var(--tone-warning-border);
    background: var(--tone-warning-bg);
    color: var(--warning);
  }
  :host([downgraded="true"]) .pill {
    display: inline-flex;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .reason {
    color: var(--muted-foreground);
    font-size: 11px;
  }
</style>

<div class="row">
  <span class="key">Tier</span>
  <span class="value">{
    tier() === 'none'      ? 'No sandbox' :
    tier() === 'process'   ? 'Process' :
    tier() === 'container' ? 'Container' :
    tier() === 'vm'        ? 'Virtual machine' :
    tier() === 'cloud'     ? 'Cloud' :
                             '…'
  }</span>
  <span class="pill"><span class="dot" aria-hidden="true"></span>{preferredTier() ? `downgraded from ${preferredTier()}` : 'downgraded'}</span>
</div>

<div class="row">
  <span class="key">Strategy</span>
  <span class="value">{strategy() || '—'}</span>
</div>

<div class="reason-row" style="display: none;">
  <span class="key">Reason</span>
  <span class="reason">{reason()}</span>
</div>
