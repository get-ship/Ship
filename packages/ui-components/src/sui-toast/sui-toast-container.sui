<!--
  <sui-toast-container> — SUI port of <ship-toast-container>.
  Fixed-position stacking host for <sui-toast> children.

  Prop / event / method parity vs <ship-toast-container>
  ────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                      Notes
  ────────────────────────────────────────────────────────────────────────────
  position (ToastPosition,        position (union,         ✓ reflects; six positions
    'top-right')                    'bottom-right',          default changed to
                                    reflect)                 bottom-right per spec
  maxVisible (number, 5)          max-visible (number,     ✓ reflects; 0=unlimited
                                    5, reflect)
  ────────────────────────────────────────────────────────────────────────────
  show(opts) → ShipToast          show(opts) → SuiToast    ✓ programmatic API
  ────────────────────────────────────────────────────────────────────────────
  Slots: (default) sui-toast      (default)                ✓
  ────────────────────────────────────────────────────────────────────────────
  ARIA: role=region,              controller sets on       ✓
    aria-label=Notifications,       connect
    aria-live=polite
  ────────────────────────────────────────────────────────────────────────────
-->

<prop name="position" values="top-left|top-center|top-right|bottom-left|bottom-center|bottom-right" default="bottom-right" reflect />
<prop name="max-visible" type="number" default="5" reflect />

<style>
  :host {
    position: fixed;
    z-index: var(--z-toast, 9999);
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 8px);
    pointer-events: none;
    max-width: min(440px, calc(100vw - 32px));
    --toast-edge: 16px;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
  }
  :host([hidden]) { display: none; }

  :host(:not([position])),
  :host([position='bottom-right']) {
    bottom: var(--toast-edge);
    right: var(--toast-edge);
    top: auto;
    left: auto;
    flex-direction: column-reverse;
    align-items: flex-end;
  }
  :host([position='bottom-left']) {
    bottom: var(--toast-edge);
    left: var(--toast-edge);
    top: auto;
    right: auto;
    flex-direction: column-reverse;
    align-items: flex-start;
  }
  :host([position='bottom-center']) {
    bottom: var(--toast-edge);
    left: 50%;
    transform: translateX(-50%);
    top: auto;
    right: auto;
    flex-direction: column-reverse;
    align-items: center;
  }
  :host([position='top-right']) {
    top: var(--toast-edge);
    right: var(--toast-edge);
    bottom: auto;
    left: auto;
    flex-direction: column;
    align-items: flex-end;
  }
  :host([position='top-left']) {
    top: var(--toast-edge);
    left: var(--toast-edge);
    bottom: auto;
    right: auto;
    flex-direction: column;
    align-items: flex-start;
  }
  :host([position='top-center']) {
    top: var(--toast-edge);
    left: 50%;
    transform: translateX(-50%);
    bottom: auto;
    right: auto;
    flex-direction: column;
    align-items: center;
  }

  ::slotted(sui-toast) {
    pointer-events: auto;
    width: auto;
  }
</style>

<slot bind:this={defaultSlotEl}></slot>
