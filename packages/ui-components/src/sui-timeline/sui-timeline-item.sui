<!--
  <sui-timeline-item> — co-located child element for <sui-timeline>.
  Single timeline entry with gutter dot, connector line, title, and body.

  Prop parity vs <ship-timeline-item>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, 'default')       tone (string, 'default', ✓
                                 reflect)
  at (string, undefined)       at (string, '', reflect) ✓ ISO or relative label
  interactive (bool, false)    interactive (bool,       ✓
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-select → {}             sui-select → {}          event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: title, (default)      title, (default)         ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: dot, body, at         dot, body, at            ✓
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: role=listitem → button controller manages       ✓
    when interactive; tabindex
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" type="string" default="default" reflect />
<prop name="at" type="string" default="" reflect />
<prop name="interactive" type="bool" default="false" reflect />

<style>
  :host {
    display: grid;
    grid-template-columns: 20px 1fr;
    column-gap: 10px;
    padding: 6px 0;
    position: relative;
    --tone-fg: var(--muted-foreground);
  }
  :host([hidden]) { display: none; }

  /* Tone color mapping */
  :host([tone='default'])     { --tone-fg: var(--foreground); }
  :host([tone='primary'])     { --tone-fg: var(--primary); }
  :host([tone='info'])        { --tone-fg: var(--info); }
  :host([tone='success'])     { --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone-fg: var(--destructive); }
  :host([tone='accent'])      { --tone-fg: var(--accent-foreground); }
  :host([tone='muted'])       { --tone-fg: var(--muted-foreground); }

  .gutter {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .gutter::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }
  :host(:first-of-type) .gutter::before { top: 10px; }
  :host(:last-of-type) .gutter::before { bottom: calc(100% - 10px); }

  .dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--tone-fg);
    border: 2px solid var(--background);
    margin-top: 4px;
    box-shadow: var(--shadow-xs);
    flex-shrink: 0;
  }

  .body { min-width: 0; }

  .head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .at {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    margin-left: auto;
  }

  .content {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    line-height: var(--leading-normal);
    margin-top: 2px;
  }

  :host([interactive]) {
    cursor: pointer;
    border-radius: var(--radius-sm);
    outline: none;
  }
  :host([interactive]:hover) { background: var(--muted); }
  :host([interactive]:focus-visible) {
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      0 0 0 calc(var(--ring-offset) + var(--ring-width))
        color-mix(in oklch, var(--ring-color) var(--ring-opacity), transparent);
  }
  @media (forced-colors: active) {
    :host([interactive]:focus-visible) { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>

<div class="gutter"><span class="dot" part="dot"></span></div>
<div class="body" part="body">
  <div class="head">
    <slot name="title"></slot>
    {#if at()}
      <span class="at" part="at">{at()}</span>
    {/if}
  </div>
  <div class="content"><slot></slot></div>
</div>
