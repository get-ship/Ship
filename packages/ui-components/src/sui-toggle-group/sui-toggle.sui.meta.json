{
  "bindings": [
    {
      "key": "b0",
      "kind": "attr:aria-pressed",
      "expr": "pressed() ? 'true' : 'false'",
      "deps": [
        "pressed"
      ]
    },
    {
      "key": "b1",
      "kind": "attr:disabled",
      "expr": "disabled()",
      "deps": [
        "disabled"
      ]
    },
    {
      "key": "b2",
      "kind": "bind:this",
      "expr": "buttonEl",
      "deps": [
        "buttonEl"
      ]
    }
  ]
}