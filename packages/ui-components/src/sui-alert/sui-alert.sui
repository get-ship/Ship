<!--
  <sui-alert> — SUI port of <ship-alert>.
  Inline status banner. Tone-driven surface.

  Prop parity vs <ship-alert>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone ('info'|'success'|      tone (union, reflect)    ✓ same values
    'warning'|'destructive'|
    'muted', 'info')
  dismissible (bool, false)    dismissible (bool,       ✓
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-dismiss                 sui-dismiss               event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: icon, title,          icon, title, (default),  ✓
    (default), actions           actions
  ─────────────────────────────────────────────────────────────────────────────
  role="alert" for             same, reactive           ✓
    warning/destructive;
    role="status" otherwise
  aria-live="assertive" for    same, reactive           ✓
    warning/destructive;
    "polite" otherwise
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                box, close               SUI adds parts
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="info|success|warning|destructive|muted" default="info" reflect />
<prop name="dismissible" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    --tone: var(--info);
    --tone-fg: var(--info);
    --alert-bg: color-mix(in oklch, var(--tone) 12%, var(--background));
    --alert-border: color-mix(in oklch, var(--tone) 30%, transparent);
  }
  :host([hidden]) { display: none; }

  :host([tone='success'])     { --tone: var(--success);          --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning);          --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive);      --tone-fg: var(--destructive); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); }

  .box {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--alert-border);
    background: var(--alert-bg);
    color: var(--tone-fg);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .title { font-weight: 600; }

  .body { color: var(--foreground); }

  .actions {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }

  .close {
    display: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-size: 14px;
    padding: 2px 6px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  :host([dismissible]) .close {
    display: inline-flex;
  }
  .close:hover {
    background: color-mix(in oklch, var(--tone-fg) 12%, transparent);
  }

  ::slotted([slot='icon']) { display: inline-flex; }
</style>

<div class="box"
     part="box"
     role={tone() === 'destructive' || tone() === 'warning' ? 'alert' : 'status'}
     aria-live={tone() === 'destructive' || tone() === 'warning' ? 'assertive' : 'polite'}
     aria-atomic="true">
  <span><slot name="icon"></slot></span>
  <div class="content">
    <div class="title"><slot name="title"></slot></div>
    <div class="body"><slot></slot></div>
    <div class="actions"><slot name="actions"></slot></div>
  </div>
  <button class="close" part="close" aria-label="Dismiss" bind:this={closeBtn}>&#215;</button>
</div>
