{
  "bindings": [
    {
      "key": "b0",
      "kind": "attr:role",
      "expr": "tone() === 'destructive' || tone() === 'warning' ? 'alert' : 'status'",
      "deps": [
        "tone"
      ]
    },
    {
      "key": "b1",
      "kind": "attr:aria-live",
      "expr": "tone() === 'destructive' || tone() === 'warning' ? 'assertive' : 'polite'",
      "deps": [
        "tone"
      ]
    },
    {
      "key": "b2",
      "kind": "bind:this",
      "expr": "closeBtn",
      "deps": [
        "closeBtn"
      ]
    }
  ]
}