<!--
  <sui-nav-top> — SUI port of <ship-nav-top>.
  Top bar: brand link, breadcrumb trail, per-view action slot, command-bar
  slot, rail toggle, UI Studio shortcut, embedded theme picker, dock toggle,
  fullscreen, and chat-drawer toggle.

  Prop / event surface
  ─────────────────────────────────────────────────────────────────────────────
  Props:
    path (string, '')  current navigation path — auto-updated on sui:navigate
  ─────────────────────────────────────────────────────────────────────────────
  Events dispatched (bubbling, composed):
    sui:rail:toggle   {}  — request to toggle the left rail
    sui:dock:toggle   {}  — request to toggle the panel dock
    sui:chat:toggle   {}  — request to open the chat drawer
    sui:nav-top:ready {}  — fired once after first mount
  ─────────────────────────────────────────────────────────────────────────────
  Listens on document:
    sui:navigate  { detail: { to: string } }  — updates path + crumbs
  ─────────────────────────────────────────────────────────────────────────────
  Slots:
    actions      per-view action buttons injected by the mounted view
    command-bar  command palette placeholder (accept <sui-command-bar> when ported)
  ─────────────────────────────────────────────────────────────────────────────
  Parts: brand, crumbs, rail-toggle, studio, theme-picker, dock-toggle,
         fullscreen, chat-toggle
  ─────────────────────────────────────────────────────────────────────────────
  CSS custom properties:
    --ship-top-bar-h (default 40px)  host height; matches layout grid row
  ─────────────────────────────────────────────────────────────────────────────
  Parity vs Lit ship-nav-top:
    #topbar-brand          → part="brand"              ✓
    #breadcrumbs           → part="crumbs" + controller render ✓
    #view-topbar-actions   → slot name="actions"       ✓
    ship-command-bar       → slot name="command-bar"   (deferred, not ported)
    #toggle-rail           → part="rail-toggle"        ✓
    #open-ui-studio        → part="studio"             ✓
    ship-popover#theme-picker → <sui-theme-picker>     ✓ (no ID handshake)
    #toggle-dock           → part="dock-toggle"        ✓
    #toggle-fullscreen     → part="fullscreen"         ✓
    #toggle-drawer         → part="chat-toggle"        ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="path" type="string" default="" />

<style>
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    height: var(--ship-top-bar-h, 40px);
    padding: 0 var(--space-3, 12px);
    border-bottom: 1px solid var(--border, #e5e5e5);
    background: var(--muted, #f6f6f6);
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: var(--text-sm, 13px);
    color: var(--foreground, #111);
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
    box-sizing: border-box;
    flex-shrink: 0;
  }
  :host([hidden]) { display: none; }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm, 4px);
    color: var(--foreground, #111);
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color var(--duration-fast, 100ms) var(--ease-out, ease-out);
  }
  .brand:hover { background: color-mix(in oklch, var(--foreground) 8%, transparent); }
  .brand:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary, #3b82f6) 50%, transparent);
  }

  .sep {
    width: 1px;
    height: 16px;
    background: var(--border, #e5e5e5);
    flex-shrink: 0;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow: hidden;
    flex: 0 0 auto;
    max-width: 300px;
    font-size: var(--text-sm, 13px);
  }
  .crumbs a {
    color: var(--muted-foreground, #888);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
    display: block;
  }
  .crumbs a:hover { color: var(--foreground, #111); text-decoration: underline; }
  .crumbs .chevron { color: var(--muted-foreground, #888); flex-shrink: 0; }
  .crumbs .current {
    color: var(--foreground, #111);
    font-weight: var(--font-weight-medium, 500);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
    display: block;
  }

  .view-actions {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
  }

  .spacer { flex: 1; min-width: 0; }

  .cmd-slot {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
</style>

<a class="brand" part="brand" href="/" bind:this={brandLink} aria-label="Ship home" title="Ship home">
  <sui-icon name="anchor" size="sm" aria-hidden="true"></sui-icon>
</a>
<span class="sep" aria-hidden="true"></span>
<nav class="crumbs" part="crumbs" aria-label="Breadcrumbs" bind:this={breadcrumbsEl}></nav>
<span class="view-actions"><slot name="actions"></slot></span>
<span class="spacer"></span>
<span class="cmd-slot"><slot name="command-bar"></slot></span>
<span class="spacer"></span>
<sui-button variant="ghost" size="sm" part="rail-toggle" bind:this={railToggleBtn}
  title="Toggle navigation (⌘B)" aria-label="Toggle navigation">
  <sui-icon slot="leading" name="menu"></sui-icon>
</sui-button>
<sui-button variant="ghost" size="sm" part="studio" bind:this={studioBtn}
  title="Open UI Studio" aria-label="Open UI Studio">
  <sui-icon slot="leading" name="columns"></sui-icon>
</sui-button>
<sui-theme-picker placement="bottom-end" part="theme-picker"></sui-theme-picker>
<sui-button variant="ghost" size="sm" part="dock-toggle" bind:this={dockToggleBtn}
  title="Toggle panel dock (⌘J)" aria-label="Toggle panel dock">
  <sui-icon slot="leading" name="terminal"></sui-icon>
</sui-button>
<sui-button variant="ghost" size="sm" part="fullscreen" bind:this={fullscreenBtn}
  title="Fullscreen (F11)" aria-label="Toggle fullscreen">
  <sui-icon slot="leading" name="maximize"></sui-icon>
</sui-button>
<sui-button variant="ghost" size="sm" part="chat-toggle" bind:this={chatToggleBtn}
  title="Chat (⌘/)" aria-label="Toggle chat drawer">
  <sui-icon slot="leading" name="message-square-plus"></sui-icon>
</sui-button>
