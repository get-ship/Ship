<bundle separate />
<!--
  <sui-nav-top> — SUI port of <ship-nav-top>.
  Top bar: brand link, breadcrumb trail, per-view action slot, command-bar
  slot, rail toggle, embedded theme picker, dock toggle, and fullscreen
  toggle.

  Prop / event surface
  ─────────────────────────────────────────────────────────────────────────────
  Props:
    path    (string, '')  current navigation path — auto-updated on sui:navigate
    project (string, '')  optional project label — when set, prepends a leading
                          home-linked breadcrumb segment (e.g. "Ship")
    view    (string, '')  optional explicit view name — when set, overrides the
                          path-derived root segment (humanized + label lookup
                          still apply). Lets the bar render correctly in
                          standalone harnesses where location.pathname is "/"
  ─────────────────────────────────────────────────────────────────────────────
  Events dispatched (bubbling, composed):
    sui:rail:toggle   {}  — request to toggle the left rail
    sui:dock:toggle   {}  — request to toggle the panel dock
    sui:nav-top:ready {}  — fired once after first mount
  ─────────────────────────────────────────────────────────────────────────────
  Listens on document:
    sui:navigate  { detail: { to: string } }  — updates path + crumbs
  ─────────────────────────────────────────────────────────────────────────────
  Slots:
    actions      per-view action buttons injected by the mounted view
    command-bar  command palette host — shell2 slots <sui-command-bar> here
  ─────────────────────────────────────────────────────────────────────────────
  Parts: brand, crumbs, rail-toggle, theme-picker, dock-toggle, fullscreen
  ─────────────────────────────────────────────────────────────────────────────
  CSS custom properties:
    --ship-top-bar-h (default 40px)  host height; matches layout grid row
  ─────────────────────────────────────────────────────────────────────────────
  Parity vs Lit ship-nav-top:
    #topbar-brand              → part="brand"               ✓
    #breadcrumbs               → part="crumbs" + {#for} crumbs()  ✓
    #view-topbar-actions       → slot name="actions"        ✓
    <ship-command-bar>         → slot name="command-bar"    ✓ (filled by shell2)
    #toggle-rail               → part="rail-toggle"         ✓
    #open-ui-studio            → removed (shell2 dropped the UI Studio button)
    <ship-popover#theme-picker>→ <sui-theme-picker>         ✓ (runtime-exceed:
                                                              sui-popover uses
                                                              sui-portal + a
                                                              transition:scale
                                                              for open/close
                                                              animation, no
                                                              hand-rolled CSS
                                                              keyframes)
    #toggle-dock               → part="dock-toggle"         ✓
    #toggle-fullscreen         → part="fullscreen"          ✓
  ─────────────────────────────────────────────────────────────────────────────
  Runtime-exceed moves over Lit ship-nav-top:
    1. Theme picker: <sui-theme-picker> wraps <sui-popover> which portals out
       of shadow-DOM into <body> and animates with transition:scale; Lit
       used a pure-CSS ship-popover + manual grid fill.
    2. Crumb transitions: each {#for} crumb gets transition:fade so route
       changes animate cleanly without a manual state machine; Lit just
       re-renders.
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="path" type="string" default="" />
<prop name="project" type="string" default="" />
<prop name="view" type="string" default="" />

<style>
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    height: var(--ship-top-bar-h, 40px);
    padding: 0 var(--space-3, 12px);
    border-bottom: 1px solid var(--border, #e5e5e5);
    background: var(--muted, #f6f6f6);
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: var(--text-sm, 13px);
    color: var(--foreground, #111);
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
    box-sizing: border-box;
    flex-shrink: 0;
  }
  :host([hidden]) { display: none; }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm, 4px);
    color: var(--foreground, #111);
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color var(--duration-fast, 100ms) var(--ease-out, ease-out);
  }
  .brand-mark {
    width: 18px;
    height: 18px;
    display: block;
  }
  .brand:hover { background: color-mix(in oklch, var(--foreground) 8%, transparent); }
  .brand:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary, #3b82f6) 50%, transparent);
  }

  .sep {
    width: 1px;
    height: 16px;
    background: var(--border, #e5e5e5);
    flex-shrink: 0;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow: hidden;
    flex: 0 0 auto;
    max-width: 300px;
    font-size: var(--text-sm, 13px);
  }
  .crumbs a {
    color: var(--muted-foreground, #888);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
    display: block;
  }
  .crumbs a:hover { color: var(--foreground, #111); text-decoration: underline; }
  .crumbs .chevron { color: var(--muted-foreground, #888); flex-shrink: 0; }
  .crumbs .current {
    color: var(--foreground, #111);
    font-weight: var(--font-weight-medium, 500);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
    display: block;
  }

  .view-actions {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    flex-shrink: 0;
  }

  .spacer { flex: 1; min-width: 0; }

  .cmd-slot {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
</style>

<a class="brand" part="brand" href="/" aria-label="Ship home" title="Ship home" on:click={onBrand}>
  <img class="brand-mark" src="/ship-logo.svg" alt="" aria-hidden="true" />
</a>
<span class="sep" aria-hidden="true"></span>
<nav class="crumbs" part="crumbs" aria-label="Breadcrumbs">
  {#for c of crumbs() key={c.href}}
    {#if c.isLast}
      <span class="current" id="breadcrumbs-title" transition:fade={{ duration: 120 }}>{c.label}</span>
    {:else}
      <a href={c.href} on:click={(e) => onCrumbClick(e, c.href)} transition:fade={{ duration: 120 }}>{c.label}</a>
      <span class="chevron" aria-hidden="true">›</span>
    {/if}
  {/for}
</nav>
<span class="view-actions"><slot name="actions"></slot></span>
<span class="spacer"></span>
<span class="cmd-slot"><slot name="command-bar"></slot></span>
<span class="spacer"></span>
<sui-button variant="ghost" size="sm" part="rail-toggle"
  title="Toggle navigation (⌘B)" aria-label="Toggle navigation" on:click={onRailToggle}>
  <sui-icon slot="leading" name="menu"></sui-icon>
</sui-button>
<sui-theme-picker placement="bottom-end" part="theme-picker"></sui-theme-picker>
<sui-button variant="ghost" size="sm" part="dock-toggle"
  title="Toggle CLI / debug panel (⌘J)" aria-label="Toggle CLI / debug panel"
  aria-pressed={dockOpen() ? 'true' : 'false'} on:click={onDockToggle}>
  <sui-icon slot="leading" name="terminal"></sui-icon>
</sui-button>
<sui-button variant="ghost" size="sm" part="fullscreen"
  title="Fullscreen (F11)" aria-label="Toggle fullscreen" on:click={onFullscreen}>
  <sui-icon slot="leading" name="maximize"></sui-icon>
</sui-button>
