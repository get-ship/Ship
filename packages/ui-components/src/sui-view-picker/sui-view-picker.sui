<!--
  <sui-view-picker> — chrome-level rail customizer + view browser +
  install entry point. Anchored to a rail trigger, opens a popover with
  (1) project name + path, (2) a fuzzy filter, (3) the "pinned to rail"
  list (drag-to-reorder, drag in/out to (un)pin), (4) the "all views"
  list, (5) an "+ Install view" footer link.

  Composes <sui-popover> for the surface — the native popover API drives
  open/close, light-dismiss, Escape, focus return, top-layer.

  Surface
  ──────────────────────────────────────────────────────────────────────
  Props
    open          (bool, false, reflect)        — popover visible
    placement     (passthrough to sui-popover)  — default 'right'
    install-href  (string, '/ship-ui-studio')   — "Install view" target
    views-url     (string, '/api/v1/views')     — view catalogue
    projects-url  (string, '/api/v1/projects')  — active project lookup
    settings-url  (string, '/api/v1/settings')  — pin persistence
    pins-key      (string, 'shell.rail.pinned') — settings key for pins
  Slots
    trigger       — the rail tile/button that opens the picker
  Methods
    open(), close(), toggle(), refresh()
  Events (bubble, composed)
    sui:view-picker:navigate     { name }   row clicked → navigated
    sui:view-picker:pin-changed  { pins }   pinned set mutated
    sui:view-picker:install              "+ Install view" clicked
  Parts
    popover, header, project-name, project-path, filter,
    body, section-pinned, section-all, footer, install-link
  ──────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="placement" type="string" default="right" />
<prop name="install-href" type="string" default="/ship-ui-studio" />
<prop name="views-url" type="string" default="/api/v1/views" />
<prop name="projects-url" type="string" default="/api/v1/projects" />
<prop name="settings-url" type="string" default="/api/v1/settings" />
<prop name="pins-key" type="string" default="shell.rail.pinned" />

<style>
  :host { display: inline-flex; }
  :host([hidden]) { display: none; }

  /* Defeat sui-popover's default 6px padding + 180px min-width — our
     header/filter/sections paint edge-to-edge with their own padding. */
  sui-popover::part(surface) {
    padding: 0;
    min-width: 360px;
    width: min(420px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 96px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* vp-root needs to fill the surface for the flex chain (header +
     filter + scrolling body + footer) to clamp. Without min-height:0
     the body's flex:1 can't shrink and the popover grows past the
     surface's max-height instead of scrolling — flagged by user QA. */
  .vp-root {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ── header ─────────────────────────────────────────────────────── */
  .vp-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px 8px;
    border-bottom: 1px solid var(--border, #e5e5e5);
    flex-shrink: 0;
  }
  .vp-project-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--foreground, #111);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vp-project-path {
    font-size: 11px;
    color: var(--muted-foreground, #888);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── filter ─────────────────────────────────────────────────────── */
  .vp-filter {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--border, #e5e5e5);
    flex-shrink: 0;
  }
  .vp-filter sui-icon { color: var(--muted-foreground, #888); flex-shrink: 0; }
  .vp-filter input {
    flex: 1;
    appearance: none;
    border: none;
    background: transparent;
    color: var(--foreground, #111);
    font: inherit;
    font-size: var(--text-sm, 13px);
    outline: none;
    min-width: 0;
  }
  .vp-filter input::placeholder { color: var(--muted-foreground, #888); }
  .vp-count {
    font-size: 11px;
    color: var(--muted-foreground, #888);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  /* ── body ───────────────────────────────────────────────────────── */
  .vp-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--foreground) 15%, transparent) transparent;
  }
  .vp-section-h {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 10px 12px 4px;
    font-size: 10px;
    font-weight: 600;
    color: var(--muted-foreground, #888);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .vp-section-h sui-icon { width: 12px; height: 12px; }
  .vp-section-h .vp-hint {
    margin-left: auto;
    font-weight: 400;
    font-size: 10px;
    color: var(--muted-foreground, #888);
    text-transform: none;
    letter-spacing: normal;
  }
  .vp-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    cursor: pointer;
    transition: background-color var(--duration-fast, 100ms) var(--ease-out, ease-out);
    user-select: none;
  }
  .vp-row:hover,
  .vp-row.is-cursor {
    background: color-mix(in oklch, var(--primary, #f97316) 12%, transparent);
  }
  .vp-row.is-active {
    color: var(--primary, #f97316);
  }
  .vp-row.is-drag-over {
    outline: 2px solid var(--primary, #f97316);
    outline-offset: -2px;
  }
  .vp-row.is-dragging { opacity: 0.5; }

  /* Project rows — the unified picker shows projects above views. */
  .vp-row-project {
    padding: 8px 12px;
  }
  .vp-project-swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    flex-shrink: 0;
    background: color-mix(in oklch, var(--foreground) 18%, transparent);
    border: 1px solid var(--border, transparent);
  }
  .vp-project-swatch.is-active {
    background: var(--primary, #f97316);
    border-color: color-mix(in oklch, var(--primary, #f97316) 70%, transparent);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary, #f97316) 22%, transparent);
  }
  .vp-row-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .vp-row-label {
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vp-row-sub {
    font-size: 11px;
    color: var(--muted-foreground, #888);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vp-drop-zone {
    min-height: 6px;
  }
  .vp-drop-zone.is-drag-over {
    background: color-mix(in oklch, var(--primary, #f97316) 18%, transparent);
    min-height: 12px;
  }
  .vp-empty {
    padding: 18px;
    text-align: center;
    color: var(--muted-foreground, #888);
    font-size: 12px;
  }

  /* ── footer ─────────────────────────────────────────────────────── */
  .vp-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-top: 1px solid var(--border, #e5e5e5);
    flex-shrink: 0;
  }
  .vp-install {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--primary, #f97316);
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
  }
  .vp-install:hover { text-decoration: underline; }
  .vp-foot-spacer { flex: 1; }

  @media (prefers-reduced-motion: reduce) {
    .vp-row { transition: none; }
  }
</style>

<sui-popover placement={placement()} bind:this={popoverEl}>
  <slot name="trigger" slot="trigger"></slot>
  <div class="vp-root" part="popover" role="dialog" aria-label="View picker" bind:this={rootEl}>
    <div class="vp-header" part="header">
      <span class="vp-project-name" part="project-name" bind:this={projectNameEl}></span>
      <span class="vp-project-path" part="project-path" bind:this={projectPathEl}></span>
    </div>
    <div class="vp-filter" part="filter">
      <sui-icon name="search" size="sm" aria-hidden="true"></sui-icon>
      <input
        type="search"
        placeholder="Filter views…"
        aria-label="Filter views"
        bind:this={filterInput}
      />
      <span class="vp-count" bind:this={countEl}>0</span>
    </div>
    <div class="vp-body" part="body" bind:this={bodyEl}></div>
    <div class="vp-footer" part="footer">
      <a class="vp-install" part="install-link" href={installHref()} bind:this={installLink}>
        <sui-icon name="plus" size="sm"></sui-icon>
        <span>Install view</span>
      </a>
      <span class="vp-foot-spacer"></span>
      <span class="vp-count" bind:this={pagerEl}></span>
    </div>
  </div>
</sui-popover>
