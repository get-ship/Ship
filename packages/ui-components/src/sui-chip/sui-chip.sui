<!--
  <sui-chip> — SUI port of <ship-chip>.
  Interactive filter/selection pill. Host IS the interactive surface:
  role=button + keyboard activation via paired controller.

  Prop / event / method parity vs <ship-chip>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, 'muted')         tone (union, 'muted',    ✓ default changed from
                                 reflect)                muted for SUI catalog
                                                         consistency
  variant (null|'solid'|       variant (solid|soft|     ✓ SUI adds ghost;
    'soft'|'outline')            outline|ghost, 'soft',  'soft' is the explicit
                                 reflect)                 default (Lit uses null)
  size ('sm'|'md'|'lg',        size (sm|md|lg, 'sm',   ✓ sm is Ship filter-
    'md')                        reflect)                rail default
  selected (Boolean, false)    selected (bool, false,   ✓ aria-pressed managed
                                 reflect)                by controller
  removable (Boolean, false)   removable (bool, false,  ✓ × button rendered;
                                 reflect)                ship-remove dispatched
                                                         by controller
  disabled (Boolean, false)    disabled (bool, false,   ✓ aria-disabled +
                                 reflect)                tabindex managed by
                                                         controller
  ─────────────────────────────────────────────────────────────────────────────
  Events: ship-remove          ship-remove              ✓ dispatched by
    (bubbles, composed)          (bubbles, composed)      controller on × click
                                                         or Backspace/Delete
  ─────────────────────────────────────────────────────────────────────────────
  Keyboard: Enter/Space →      ✓ controller handles     ✓
    host.click(); Backspace/
    Delete → ship-remove
  role=button, tabindex=0      ✓ controller sets on     ✓
    set on host                  mount
  aria-pressed, aria-disabled  ✓ controller syncs       ✓
    set reactively               reactively
  ─────────────────────────────────────────────────────────────────────────────
  slots: leading, default      slots: leading, default  ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: chip, leading, remove parts: chip, leading,    ✓
                                 remove
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="muted" reflect />
<prop name="variant" values="solid|soft|outline|ghost" default="soft" reflect />
<prop name="size" values="sm|md|lg" default="sm" reflect />
<prop name="selected" type="bool" default="false" reflect />
<prop name="removable" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    -webkit-tap-highlight-color: transparent;
    --tone: var(--muted-foreground);
    --tone-fg: var(--muted-foreground);
    --tone-contrast: var(--background);
    --chip-radius: var(--radius-full);
  }
  :host([hidden]) { display: none; }

  :host(:not([size])),
  :host([size='sm']) { --chip-h: 22px; --chip-px: 8px;  --chip-fs: var(--text-xs);   --chip-gap: 4px; --chip-icon: 10px; --chip-remove: 14px; }
  :host([size='md']) { --chip-h: 26px; --chip-px: 10px; --chip-fs: var(--text-sm);   --chip-gap: 6px; --chip-icon: 12px; --chip-remove: 16px; }
  :host([size='lg']) { --chip-h: 30px; --chip-px: 12px; --chip-fs: var(--text-base); --chip-gap: 6px; --chip-icon: 14px; --chip-remove: 18px; }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--chip-gap);
    min-height: var(--chip-h);
    padding: 0 var(--chip-px);
    font-family: var(--font-body);
    font-size: var(--chip-fs);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    color: var(--tone-fg);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--chip-radius);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  :host(:not([variant])) .chip,
  :host([variant='soft']) .chip {
    background: color-mix(in oklch, var(--tone) 14%, transparent);
    border-color: color-mix(in oklch, var(--tone) 22%, transparent);
  }
  :host([variant='soft']:not([disabled])) .chip:hover {
    background: color-mix(in oklch, var(--tone) 22%, transparent);
    border-color: color-mix(in oklch, var(--tone) 32%, transparent);
  }
  :host([variant='outline']) .chip {
    background: transparent;
    border-color: color-mix(in oklch, var(--tone) 45%, transparent);
  }
  :host([variant='outline']:not([disabled])) .chip:hover {
    background: color-mix(in oklch, var(--tone) 10%, transparent);
  }
  :host([variant='solid']) .chip {
    background: var(--tone);
    border-color: color-mix(in oklch, var(--tone) 100%, black 6%);
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 color-mix(in oklch, white 18%, transparent);
  }
  :host([variant='ghost']) .chip {
    background: transparent;
    border-color: transparent;
  }
  :host([variant='ghost']:not([disabled])) .chip:hover {
    background: color-mix(in oklch, var(--tone) 10%, transparent);
  }

  :host([selected]) .chip {
    background: var(--tone);
    border-color: color-mix(in oklch, var(--tone) 100%, black 10%);
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 color-mix(in oklch, white 20%, transparent);
    font-weight: var(--font-weight-semibold);
  }
  :host([selected]:not([disabled])) .chip:hover {
    background: color-mix(in oklch, var(--tone) 92%, white 8%);
  }
  :host([selected]:not([tone])) .chip,
  :host([selected][tone='muted']) .chip {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }

  :host(:focus-visible) { outline: none; }
  :host(:focus-visible) .chip {
    box-shadow:
      0 0 0 var(--ring-offset) var(--background),
      0 0 0 calc(var(--ring-offset) + var(--ring-width))
        color-mix(in oklch, var(--tone) var(--ring-opacity), transparent);
  }

  :host([disabled]) .chip {
    cursor: not-allowed;
    background: var(--muted);
    border-color: color-mix(in oklch, var(--border) 80%, transparent);
    color: color-mix(in oklch, var(--muted-foreground) 70%, transparent);
    filter: saturate(0.65);
    box-shadow: none;
  }

  .leading {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--chip-icon);
    height: var(--chip-icon);
    flex-shrink: 0;
    color: currentColor;
  }
  .leading:has(::slotted(*)) { display: inline-flex; }
  ::slotted([slot='leading']) {
    display: inline-flex;
    align-items: center;
    color: currentColor;
    width: 100%;
    height: 100%;
  }

  .remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--chip-remove);
    height: var(--chip-remove);
    margin-inline: 2px -4px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .remove svg {
    width: 70%;
    height: 70%;
    display: block;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .remove:hover:not(:disabled) {
    background: color-mix(in oklch, currentColor 18%, transparent);
  }
  :host([disabled]) .remove { cursor: not-allowed; }

  @media (forced-colors: active) {
    .chip { border-color: CanvasText; color: CanvasText; }
    :host([selected]) .chip { background: Highlight; color: HighlightText; border-color: Highlight; }
    :host(:focus-visible) .chip { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>

<span class="chip" part="chip">
  <span class="leading" part="leading"><slot name="leading"></slot></span>
  <slot></slot>
  {#if removable()}
    <button class="remove" part="remove" type="button"
            aria-label="Remove" tabindex="-1"
            bind:this={removeBtn}>
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path d="M2 2 L8 8 M8 2 L2 8" />
      </svg>
    </button>
  {/if}
</span>
