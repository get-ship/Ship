<!--
  <sui-segmented-option> — option descriptor for <sui-segmented>.
  Invisible data holder; the parent reads its attributes to render buttons
  in its shadow DOM. Mirrors <ship-segmented-option> exactly.

  Props: value (required), icon (optional ship-icon name), disabled
-->

<prop name="value" type="string" default="" reflect />
<prop name="icon" type="string" default="" reflect />
<prop name="disabled" type="bool" default="false" reflect />

<style>
  :host { display: none; }
</style>
