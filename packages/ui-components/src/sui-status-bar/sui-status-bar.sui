<!--
  <sui-status-bar> — SUI extraction of the shell status bar.
  Hairline bottom strip with connection indicator, branch, agents, and theme.
  Extracted from apps/shell/index.html's .ship-statusbar div and
  apps/shell/src/main.ts's updateStatus() function into a proper component.

  Prop surface
  ─────────────────────────────────────────────────────────────────────────────
  branch   (string, '')         workspace name / branch
  theme    (string, '')         current theme ID
  online   (bool, false, reflect)  daemon connection state; dot is green/red
  agents   (string, '')         active agent indicator text
  mode     (string, '')         daemon operating mode ('development' | 'production');
                                renders a DEV badge when value === 'development'
  ─────────────────────────────────────────────────────────────────────────────
  Slots:
    start  — view-injected status content between branch and spacer
    end    — view-injected status content between spacer and theme
  ─────────────────────────────────────────────────────────────────────────────
  Parts: dot, branch, agents, theme
  ─────────────────────────────────────────────────────────────────────────────
  Parity vs inline markup in apps/shell/index.html:
    #status-dot          → :host .dot (tone via [online] attr)
    #status-branch       → branch prop → .branch span
    #status-ab           → (omitted — git a/b not in daemon data yet)
    #view-status-start   → slot name="start"
    #view-status-end     → slot name="end"
    #status-theme        → theme prop → .theme span
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="branch" type="string" default="" />
<prop name="theme" type="string" default="" />
<prop name="online" type="bool" default="false" reflect />
<prop name="agents" type="string" default="" />
<prop name="mode" type="string" default="" />

<style>
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-3, 12px);
    height: 24px;
    padding: 0 var(--space-3, 12px);
    border-top: 1px solid var(--border);
    background: var(--sidebar, var(--muted));
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--muted-foreground);
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
  }
  :host([hidden]) { display: none; }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full, 9999px);
    background: var(--destructive);
    flex-shrink: 0;
    transition: background-color var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  :host([online]) .dot {
    background: var(--success);
  }

  .text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .text:empty { display: none; }

  .slot-wrap {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  .spacer { flex: 1; }

  /* DEV badge. Rendered when [mode="development"]; mirrors apps/shell
     parity where shipd-served HTML rewrites the meta to "production"
     and the badge disappears. The mode attribute is set on this host
     by apps/shell2/src/main.ts at boot; without this rule the
     attribute was inert. */
  .mode {
    display: none;
    font-family: var(--mono-font, var(--font-mono));
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 1px 5px;
    border-radius: var(--radius-sm, 4px);
    background: color-mix(in oklab, var(--warning, #d97706) 18%, transparent);
    color: var(--warning, #d97706);
    border: 1px solid color-mix(in oklab, var(--warning, #d97706) 36%, transparent);
    text-transform: uppercase;
    line-height: 1.2;
    flex-shrink: 0;
  }
  :host([mode="development"]) .mode { display: inline-flex; }
</style>

<span class="dot" part="dot" aria-hidden="true"></span>
<span class="text" part="branch">{branch()}</span>
<span class="text" part="agents">{agents()}</span>
<span class="slot-wrap"><slot name="start"></slot></span>
<span class="spacer"></span>
<span class="slot-wrap"><slot name="end"></slot></span>
<span class="mode" part="mode" aria-label="Daemon mode">dev</span>
<span class="text" part="theme">{theme()}</span>
