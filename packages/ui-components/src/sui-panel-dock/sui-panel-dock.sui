<bundle separate />
<!--
  <sui-panel-dock> — SUI port of <ship-panel-dock>.
  Bottom chrome panel with a tab strip.

  Prop / event / method parity vs <ship-panel-dock>
  ─────────────────────────────────────────────────────────────────────────────
  active-tab     (string, 'terminal', reflect) — active tab id
  storage-key    (string, 'ship-dock')         — localStorage prefix
  resizing       (bool, false, reflect)        — set during resize drag
  edit-mode-pill (bool, false, reflect)        — show edit-mode toggle pill
  edit-mode-on   (bool, false, reflect)        — pill ON visual state
  tabs           (JS property only)            — DockTabDef[]; overrides defaults
  ─────────────────────────────────────────────────────────────────────────────
  Events: sui:dock:activate {tab}, sui:dock:close, sui:dock:clear {tab},
          sui:dock:popout {tab}, sui:dock:resize {height},
          sui:dock:edit-mode-toggle {on}                     (bubbles, composed)
  ─────────────────────────────────────────────────────────────────────────────
  Methods: show(), hide(), toggle(), activate(tab)
  ─────────────────────────────────────────────────────────────────────────────
  Slots: <id> — body for tab id (terminal, source, signals, schema, components)
         toolbar:<id> — slim toolbar row for tab id (optional)

  Runtime-exceed notes
  ─────────────────────────────────────────────────────────────────────────────
  Tabstrip, toolbars, and body slots all render from a single `{#for}` over
  the `tabs()` signal — the j2 Lit version only iterates the tabstrip and
  hard-codes the toolbar/body slot ids, so a custom `tabs` array silently
  drops projection. Here, setting `host.tabs` rebuilds the whole strip.

  Drag-height pill: while a resize drag is in progress, a small floating
  badge teleports to <body> via <sui-portal> and fades in via
  `transition:fade`. Lit had no comparable affordance — height changed
  silently during drag.
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="active-tab" type="string" default="terminal" reflect />
<prop name="storage-key" type="string" default="ship-dock" />
<prop name="resizing" type="bool" default="false" reflect />
<prop name="edit-mode-pill" type="bool" default="false" reflect />
<prop name="edit-mode-on" type="bool" default="false" reflect />

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    position: relative;
    background: var(--card);
    box-shadow: var(--shadow-edge-top);
  }
  :host([hidden]) { display: none; }

  .resize {
    position: absolute;
    top: -3px;
    left: 0;
    right: 0;
    height: 6px;
    cursor: ns-resize;
    z-index: 2;
    touch-action: none;
  }
  .resize::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 2px;
    transform: translateX(-50%);
    width: 28px;
    height: 2px;
    border-radius: 2px;
    background: var(--muted-foreground);
    opacity: 0.45;
    transition: opacity var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .resize:hover::before,
  :host([resizing]) .resize::before { opacity: 0.95; background: var(--foreground); }

  .tabstrip {
    display: flex;
    align-items: stretch;
    padding-left: var(--space-2);
    border-bottom: 1px solid var(--border-subtle, var(--border));
    background: var(--card);
    font-size: var(--text-xs);
    user-select: none;
    height: 30px;
    flex: none;
  }

  .tab {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--muted-foreground);
    font: inherit;
    font-size: 11.5px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    position: relative;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .tab:hover { color: var(--foreground); }
  .tab[aria-selected="true"] {
    color: var(--foreground);
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    border-bottom-color: var(--primary);
    font-weight: var(--font-weight-medium, 500);
  }
  .tab:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--ring);
    border-radius: var(--radius-sm);
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success, #22c55e);
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--success, #22c55e) 25%, transparent);
  }
  .count {
    font-family: var(--mono-font, var(--font-mono));
    font-size: 9.5px;
    background: var(--muted);
    color: var(--muted-foreground);
    border-radius: var(--radius-sm);
    padding: 1px 5px;
    min-width: 18px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .tab[aria-selected="true"] .count {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--foreground);
  }
  .badge {
    font-family: var(--mono-font, var(--font-mono));
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: color-mix(in oklab, var(--accent, var(--primary)) 18%, transparent);
    color: var(--foreground);
    border-radius: var(--radius-sm);
    padding: 1px 5px;
    font-weight: var(--font-weight-medium, 500);
  }

  .edit-pill {
    appearance: none;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    border-radius: var(--radius-full, 999px);
    font: inherit;
    font-size: 10.5px;
    padding: 1px 9px 1px 7px;
    margin-right: 6px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .edit-pill:hover {
    color: var(--foreground);
    border-color: color-mix(in oklab, var(--accent, var(--primary)) 60%, var(--border));
  }
  .edit-pill[aria-checked="true"] {
    background: color-mix(in oklab, var(--accent, var(--primary)) 18%, transparent);
    border-color: color-mix(in oklab, var(--accent, var(--primary)) 70%, var(--border));
    color: var(--foreground);
    font-weight: var(--font-weight-medium, 500);
  }
  .edit-pill:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--ring);
  }

  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    padding-right: 4px;
  }
  .tool {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--muted-foreground);
    cursor: pointer;
    width: 24px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .tool:hover { background: var(--hover-bg, var(--sidebar-accent)); color: var(--foreground); }
  .tool:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--ring); }

  .toolbar {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--border-subtle, var(--border));
    background: color-mix(in oklab, var(--background) 50%, var(--card));
    flex: none;
    min-height: 30px;
  }
  .toolbar.has-content { display: flex; }
  .toolbar[hidden] { display: none !important; }

  .bodies { flex: 1; min-height: 0; position: relative; overflow: hidden; background: var(--background); }
  /*
   * Tab body sizing — every body element (sui-terminal, sui-devtools-*,
   * sui-va-*) defines its own :host { display: flex; flex-direction: column;
   * height: 100%; min-height: 0 } so the inner flex chain (header + body
   * editor + footer diagnostics) stretches correctly. The ::slotted rule
   * MUST match — `display: block` collapses the inner flex layout and
   * editors render at one-line height. Surfaced by web-qa report F-001 at
   * .artifacts/web-qa/chrome/dev-panel/edit-mode/2026-05-16T17-57/.
   */
  ::slotted(*) { display: none; height: 100%; min-height: 0; overflow: auto; }
  slot[data-active]::slotted(*) { display: flex; flex-direction: column; }

  @media (prefers-reduced-motion: reduce) {
    .tab, .tool, .resize::before { transition: none; }
  }
</style>

<div class="resize" role="separator" aria-orientation="horizontal" aria-label="Resize panel" bind:this={resizeHandle}></div>
<div class="tabstrip" role="tablist">
  {#for t of tabs() key={t.id}}
    <button
      class="tab"
      role="tab"
      type="button"
      aria-selected={t.id === activeTab() ? 'true' : 'false'}
      tabindex={t.id === activeTab() ? '0' : '-1'}
      data-tab={t.id}
      on:click={() => activate(t.id)}>
      <sui-icon prop:name={t.icon} size="sm"></sui-icon>
      <span>{t.label}</span>
      {#if t.live && t.id === activeTab()}
        <span class="live-dot" aria-hidden="true"></span>
      {/if}
      {#if t.count != null}
        <span class="count">{t.count.toLocaleString()}</span>
      {/if}
      {#if t.badge}
        <span class="badge">{t.badge}</span>
      {/if}
    </button>
  {/for}
  <span class="tools">
    {#if editModePill()}
      <button
        class="edit-pill"
        type="button"
        role="switch"
        aria-checked={editModeOn() ? 'true' : 'false'}
        data-action="edit-mode-toggle"
        title={editModeOn() ? 'Exit edit mode' : 'Enter edit mode'}
        on:click={onEditModeToggle}>
        <sui-icon name={editModeOn() ? 'pen-line' : 'pen'} size="sm"></sui-icon>
        <span>{editModeOn() ? 'Editing' : 'Edit'}</span>
      </button>
    {/if}
    <button class="tool" type="button" aria-label="Pop out" title="Pop out" data-action="popout" on:click={onPopout}><sui-icon name="maximize" size="sm"></sui-icon></button>
    <button class="tool" type="button" aria-label="Close panel" title="Close (⌘J)" data-action="close" on:click={onClose}><sui-icon name="x" size="sm"></sui-icon></button>
  </span>
</div>
{#for t of tabs() key={t.id}}
  <div class="toolbar" data-toolbar={t.id} hidden={t.id !== activeTab()}>
    <slot name={'toolbar:' + t.id}></slot>
  </div>
{/for}
<div class="bodies">
  {#for t of tabs() key={t.id}}
    <slot name={t.id} data-active={t.id === activeTab()}></slot>
  {/for}
</div>

<!--
  Drag-height pill: teleported to <body> so it escapes the dock's own
  stacking context and lives above any view content. Mounts only while
  the user is actively dragging the resize handle; `transition:fade`
  drives entry/exit.
-->
<sui-portal target="body">
  {#if resizing()}
    <div class="sui-dock-resize-pill" part="resize-pill" transition:fade={{ duration: 120 }}>
      {dragHeight()}px
    </div>
  {/if}
</sui-portal>
