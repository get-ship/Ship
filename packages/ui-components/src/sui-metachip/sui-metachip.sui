<!--
  <sui-metachip> — SUI port of <ship-metachip>.
  Compact "key: value" chip for metadata rows.

  Prop parity vs <ship-metachip>
  ──────────────────────────────────────────────────────────────
  Lit              SUI               Notes
  ──────────────────────────────────────────────────────────────
  label (String)   label (string,'') ✓ key text, reflect
  value (String)   value (string,'') ✓ value text, reflect
  ──────────────────────────────────────────────────────────────
  slots: label     label             ✓ named slot overrides attr
         (default) (default)         ✓ default slot overrides attr
  ──────────────────────────────────────────────────────────────
  parts: label     label             ✓
         value     value             ✓
  ──────────────────────────────────────────────────────────────
-->

<prop name="label" type="string" default="" reflect />
<prop name="value" type="string" default="" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 4px 14px;
    border-right: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
  }
  :host(:last-of-type) { border-right: 0; padding-right: 0; }
  :host(:first-of-type) { padding-left: 0; }
  .k {
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .v {
    font-family: var(--font-mono);
    color: var(--foreground);
    font-size: var(--text-xs);
  }
  ::slotted(*) { color: inherit; }
</style>

<span class="k" part="label"><slot name="label">{label()}</slot></span>
<span class="v" part="value"><slot>{value()}</slot></span>
