{
  "bindings": [
    {
      "key": "b0",
      "kind": "bind:this",
      "expr": "prevBtn",
      "deps": [
        "prevBtn"
      ]
    },
    {
      "key": "b1",
      "kind": "attr:disabled",
      "expr": "page() <= 1",
      "deps": [
        "page"
      ]
    },
    {
      "key": "b2",
      "kind": "attr:aria-disabled",
      "expr": "page() <= 1 ? 'true' : 'false'",
      "deps": [
        "page"
      ]
    },
    {
      "key": "b3",
      "kind": "text",
      "expr": "info()",
      "deps": [
        "info"
      ]
    },
    {
      "key": "b4",
      "kind": "bind:this",
      "expr": "nextBtn",
      "deps": [
        "nextBtn"
      ]
    },
    {
      "key": "b5",
      "kind": "attr:disabled",
      "expr": "page() >= totalPages()",
      "deps": [
        "page",
        "totalPages"
      ]
    },
    {
      "key": "b6",
      "kind": "attr:aria-disabled",
      "expr": "page() >= totalPages() ? 'true' : 'false'",
      "deps": [
        "page",
        "totalPages"
      ]
    }
  ]
}