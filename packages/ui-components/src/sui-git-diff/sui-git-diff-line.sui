<!--
  <sui-git-diff-line> — SUI port of <ship-git-diff-line>.

  Single diff line with old/new gutters, +/-/space signature, the line
  content via the default slot, and a hover-revealed comment button.

  Prop / event / slot parity vs <ship-git-diff-line>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  type (add|del|context,       type (enum, 'context',   ✓ drives bg tones
    'context')                    reflect)                 via host selectors
  old (string, '')             old (string, '',         ✓ left gutter
                                  reflect)
  new (string, '')             new (string, '',         ✓ right gutter
                                  reflect)
  comment-count (number, 0)    comment-count (number,   ✓ reveals accent
                                  0, reflect)              border + button
                                                           opacity
  ─────────────────────────────────────────────────────────────────────────────
  ship-comment                 sui-comment              renamed per
                                                          convention
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="type" values="add|del|context" default="context" reflect />
<prop name="old" type="string" default="" reflect />
<prop name="new" type="string" default="" reflect />
<prop name="comment-count" type="number" default="0" reflect />

<style>
  :host {
    display: flex;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.45;
    position: relative;
  }
  :host([type='add']) { background: var(--tone-success-bg); }
  :host([type='del']) { background: var(--tone-destructive-bg); }
  :host([comment-count]) { border-left: 2px solid var(--accent); }
  .num {
    width: 42px;
    flex-shrink: 0;
    padding-right: 8px;
    text-align: right;
    color: color-mix(in oklch, var(--muted-foreground) 60%, transparent);
    user-select: none;
    border-right: 1px solid color-mix(in oklch, var(--border) 20%, transparent);
  }
  .sig {
    width: 16px;
    flex-shrink: 0;
    text-align: center;
    user-select: none;
    color: var(--muted-foreground);
  }
  .content {
    flex: 1;
    padding-right: 28px;
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--muted-foreground);
  }
  :host([type='add']) .sig,
  :host([type='add']) .content { color: var(--success); }
  :host([type='del']) .sig,
  :host([type='del']) .content { color: var(--destructive); }

  .comment-btn {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-foreground);
    border: 0;
    display: grid;
    place-items: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
    font-size: 13px;
    line-height: 1;
    font-family: var(--font-body);
  }
  :host(:hover) .comment-btn { opacity: 1; }
  :host([comment-count]) .comment-btn { opacity: 0.7; }
  :host([comment-count]:hover) .comment-btn { opacity: 1; }
  .comment-btn:focus-visible {
    outline: 2px solid var(--ring-color, var(--ring));
    outline-offset: 1px;
  }
</style>

<span class="num">{oldCol()}</span>
<span class="num">{newCol()}</span>
<span class="sig">{sigChar()}</span>
<span class="content"><slot></slot></span>
<button
  class="comment-btn"
  type="button"
  aria-label="Comment on this line"
  title="Comment on this line"
  on:click={emitComment}
>+</button>
