<!--
  <sui-code> — SUI port of <ship-code>.
  Inline or block code. Monospace font; no syntax highlighting.

  Prop parity vs <ship-code>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  lang (String, '')            lang (string, reflect)   ✓ shown in block header
  block (Boolean, false)       block (bool, reflect)    ✓ switches to block mode
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                  (no events)              ✓
  ─────────────────────────────────────────────────────────────────────────────
  slots: (default) code text   (default) code text      ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: block, label, pre     block, label, pre        ✓
         inline                inline                   ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="lang" type="string" default="" reflect />
<prop name="block" type="bool" default="false" reflect />

<style>
  :host {
    display: inline;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  :host([block]) { display: block; }
  :host([hidden]) { display: none; }

  .inline {
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background: var(--muted);
    color: var(--foreground);
    border: 1px solid var(--border);
    font-size: 0.92em;
  }
  .block {
    display: block;
    background: var(--muted);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .block header {
    display: flex;
    justify-content: space-between;
    padding: 4px 10px;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    background: color-mix(in oklch, var(--muted) 60%, var(--background));
    border-bottom: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-weight-medium);
  }
  pre {
    margin: 0;
    padding: 10px 12px;
    overflow-x: auto;
    line-height: var(--leading-normal);
    font-family: inherit;
  }
</style>

{#if block()}
<div class="block" part="block" role="region" aria-label={lang() ? lang() + ' code block' : 'code block'}>
  {#if lang()}
  <header part="label">{lang()}</header>
  {/if}
  <pre part="pre"><slot></slot></pre>
</div>
{:else}
<code class="inline" part="inline"><slot></slot></code>
{/if}
