<!--
  <sui-provider-blob> — SUI port of <ship-provider-blob>.

  Small branded indicator for an AI provider (claude / codex / cursor /
  gemini / opencode). Inlines the canonical brand SVG so the blob is
  always pixel-accurate and offline-safe.

  Prop / event / slot parity vs <ship-provider-blob>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  provider (enum, 'claude')    provider (enum,          ✓ reflects
                                  'claude', reflect)
  size (sm|md|lg, 'md')        size (enum, 'md',        ✓ reflects
                                  reflect)
  variant (tile|glyph, 'tile') variant (enum, 'tile',   ✓ reflects
                                  reflect)
  ─────────────────────────────────────────────────────────────────────────────
  slot: default (label)        slot: default            ✓ wrapper hides on
                                                         empty via :empty
  ─────────────────────────────────────────────────────────────────────────────
  unsafeHTML(svg)              bindHtml on tile el      ✓ SUI's analogue
  setProperty('--blob-hue')    controller effect        ✓ same behavior
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="provider" values="claude|codex|cursor|gemini|opencode" default="claude" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="variant" values="tile|glyph" default="tile" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    vertical-align: middle;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    --blob-size: 20px;
    --blob-hue: var(--muted);
  }
  :host([hidden]) { display: none; }
  :host([size='sm']) { --blob-size: 14px; font-size: 11px; }
  :host([size='md']) { --blob-size: 20px; }
  :host([size='lg']) { --blob-size: 28px; font-size: var(--text-sm); }
  .tile {
    width: var(--blob-size);
    height: var(--blob-size);
    flex-shrink: 0;
    border-radius: calc(var(--blob-size) * 0.22);
    display: grid;
    place-items: center;
    background: color-mix(in oklch, var(--blob-hue) 14%, var(--surface-1));
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--blob-hue) 20%, transparent);
    overflow: hidden;
  }
  :host([variant='glyph']) .tile {
    background: transparent;
    box-shadow: none;
  }
  .tile-inner {
    display: contents;
  }
  .tile svg {
    width: 72%;
    height: 72%;
    display: block;
  }
  :host([variant='glyph']) .tile svg {
    width: 100%;
    height: 100%;
  }
  .label {
    white-space: nowrap;
    text-transform: capitalize;
  }
  .label:empty { display: none; }
</style>

<span class="tile" role="img" aria-label={tileLabel()}>
  <span class="tile-inner" bind:this={tileEl}></span>
</span>
<span class="label"><slot></slot></span>
