<!--
  <sui-table> — SUI port of <ship-table>.
  Data-table primitive: sort, select, sticky-header, native or slot pattern.

  Prop / event parity vs <ship-table>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  variant (slot|native, 'slot')   variant (union, 'slot', ✓
                                    reflect)
  density (compact|default|       density (union,         ✓
    comfortable, 'default')         'default', reflect)
  dense (bool, false)             dense (bool, reflect)   ✓ alias for compact
  hoverable (bool, true)          hoverable (bool,        ✓ default=true
                                    reflect)
  striped (bool, false)           striped (bool, reflect) ✓
  sticky-header (bool, false)     sticky-header (bool,    ✓
                                    reflect)
  sticky-first-col (bool, false)  sticky-first-col (bool, ✓
                                    reflect)
  gutter (bool, false)            gutter (bool, reflect)  ✓
  label (string, '')              label (string, '')      ✓ → table aria-label
  ─────────────────────────────────────────────────────────────────────────────
  ship-sort → {key, direction}    sui-sort → {key, dir}   event renamed
  ship-row-click → {id, index}    sui-row-click → same    event renamed
  ─────────────────────────────────────────────────────────────────────────────
  Light-DOM CSS adopted on host   controller installs     ✓
    document (scoped to tag)        once per document
  sort headers enhanced via       controller handles      ✓
    MutationObserver                same
  ─────────────────────────────────────────────────────────────────────────────
  Slots: head, (default), empty   head, (default), empty  ✓
  ─────────────────────────────────────────────────────────────────────────────
  Parts: wrap, table, thead,      wrap, table, thead,     ✓
    tbody, empty                    tbody, empty
  ─────────────────────────────────────────────────────────────────────────────
  Gutter class: ship-table-gutter-cell → sui-table-gutter-cell
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="variant" values="slot|native" default="slot" reflect />
<prop name="density" values="compact|default|comfortable" default="default" reflect />
<prop name="dense" type="bool" default="false" reflect />
<prop name="hoverable" type="bool" default="true" reflect />
<prop name="striped" type="bool" default="false" reflect />
<prop name="sticky-header" type="bool" default="false" reflect />
<prop name="sticky-first-col" type="bool" default="false" reflect />
<prop name="gutter" type="bool" default="false" reflect />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: block;
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--foreground);

    --row-py: 10px;
    --row-px: var(--space-3);
    --th-py: 10px;
    --th-fs: var(--text-xs);
    --table-radius: var(--radius-lg);
    --row-hover-mix: 45%;
  }
  :host([hidden]) { display: none; }

  :host([density='compact']),
  :host([dense]) {
    --row-py: 6px;
    --row-px: var(--space-2);
    --th-py: 6px;
  }
  :host([density='comfortable']) {
    --row-py: 14px;
    --row-px: var(--space-4);
    --th-py: 14px;
  }

  .wrap {
    position: relative;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--table-radius);
    background: var(--card);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    overflow-x: auto;
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }

  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: auto;
    font-variant-numeric: tabular-nums;
  }

  :host([sticky-header]) { display: block; }
  :host([sticky-header]) .wrap {
    overflow-y: auto;
    max-height: inherit;
  }

  .empty {
    display: none;
    padding: var(--space-7) var(--space-5);
    text-align: center;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    background: var(--card);
  }
  :host([data-empty]) .empty { display: block; }
  :host([data-empty]) table { display: none; }

  @media (forced-colors: active) {
    .wrap { border-color: CanvasText; }
  }
</style>

{#if variant() !== 'native'}
<div class="wrap" part="wrap">
  <table part="table" aria-label={label() || null}>
    <thead part="thead"><slot name="head"></slot></thead>
    <tbody part="tbody"><slot></slot></tbody>
  </table>
  <div class="empty" part="empty" role="status">
    <slot name="empty"></slot>
  </div>
</div>
{:else}
<div class="wrap" part="wrap">
  <slot></slot>
  <div class="empty" part="empty" role="status">
    <slot name="empty"></slot>
  </div>
</div>
{/if}
