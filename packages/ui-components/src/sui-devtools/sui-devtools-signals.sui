<!--
  <sui-devtools-signals> — SUI port of <ship-devtools-signals>.
  Live Datastar signal inspector. Polls every 500ms while the tab is active.
  Read-only: inspects page state via window._ds / document.querySelectorAll.
-->

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-size: var(--text-xs);
  }
  :host([hidden]) { display: none; }
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: 4px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    background: var(--sidebar);
    flex-shrink: 0;
  }
  .toolbar input {
    appearance: none;
    background: var(--background);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    padding: 2px 8px;
    font: inherit;
    flex: 1;
    max-width: 320px;
  }
  .body {
    flex: 1;
    overflow: auto;
    font-family: var(--font-mono);
  }
  .row {
    display: flex;
    gap: 12px;
    padding: 4px var(--space-3, 12px);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    align-items: baseline;
  }
  .row:last-child { border-bottom: none; }
  .k { color: var(--primary); white-space: nowrap; flex-shrink: 0; font-weight: var(--font-weight-medium, 500); }
  .v { color: var(--muted-foreground); overflow-wrap: anywhere; }
</style>

<div class="toolbar">
  <input type="text" placeholder="Filter signals…" bind:this={filterInput} />
  <span bind:this={countEl}></span>
</div>
<div class="body" bind:this={bodyEl}></div>
