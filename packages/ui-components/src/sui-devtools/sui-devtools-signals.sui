<bundle separate />
<!--
  <sui-devtools-signals> — Live tree of the mounted view's scope.
  Polls window.__suiCurrentScope every 500ms while the tab is active and
  re-samples on `sui:scope:change`. apps/shell/src/main.ts publishes the
  current MountHandle's scope after each successful mountRoute. Framework
  helpers (`ship`, `route`, `navigate`) are hidden; signal getters are
  read via `__peek()` so the readout stays out of any ambient observer.
-->

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-size: var(--text-xs);
  }
  :host([hidden]) { display: none; }
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    padding: 4px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    background: var(--sidebar);
    flex-shrink: 0;
  }
  .toolbar input {
    appearance: none;
    background: var(--background);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    padding: 2px 8px;
    font: inherit;
    flex: 1;
    max-width: 320px;
  }
  .body {
    flex: 1;
    overflow: auto;
    font-family: var(--font-mono);
  }
  .row {
    display: flex;
    gap: 12px;
    padding: 4px var(--space-3, 12px);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    align-items: baseline;
  }
  .row:last-child { border-bottom: none; }
  .k { color: var(--primary); white-space: nowrap; flex-shrink: 0; font-weight: var(--font-weight-medium, 500); }
  .v { color: var(--muted-foreground); overflow-wrap: anywhere; }
</style>

<div class="toolbar">
  <input type="text" placeholder="Filter signals…" bind:value={filter} />
  <span>{shownEntries().length} / {allCount()}</span>
</div>
<div class="body">
  {#if shownEntries().length === 0}
    <sui-empty-state>
      <sui-icon slot="icon" name={filter() ? 'search' : 'radio'}></sui-icon>
      <span slot="title">{filter() ? 'No matches' : 'No signals'}</span>
      {filter() ? 'No signals match the current filter.' : 'Mount a view — its scope appears here. SUI publishes window.__suiCurrentScope on every navigation.'}
    </sui-empty-state>
  {:else}
    {#for entry of shownEntries() key={entry.key}}
      <div class="row">
        <span class="k">{entry.key}</span>
        <span class="v">{entry.value}</span>
      </div>
    {/for}
  {/if}
</div>
