<bundle separate />
<!--
  <sui-devtools-lint> — SUI port of <ship-devtools-lint>.
  Runs POST /api/v1/lint/view for the mounted view and renders findings.
  Read-only. Refreshes on tab activation and navigation.
-->

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-size: var(--text-sm);
  }
  :host([hidden]) { display: none; }
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3, 12px);
    padding: 4px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    background: var(--sidebar);
    flex-shrink: 0;
    font-size: var(--text-xs);
  }
  .body {
    flex: 1;
    overflow: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .row {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 12px;
    padding: 4px var(--space-3, 12px);
    align-items: baseline;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 30%, transparent);
  }
  .sev { width: 52px; text-transform: uppercase; font-size: 10px; letter-spacing: 0.06em; }
  .sev.err { color: var(--destructive); }
  .sev.warn { color: var(--warning, var(--muted-foreground)); }
  .loc { color: var(--muted-foreground); white-space: nowrap; }
  .rule { color: var(--primary); margin-right: 8px; }
  .count {
    padding: 1px 6px;
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .count.err { color: var(--destructive); border: 1px solid var(--destructive); }
  .count.warn { color: var(--warning, var(--muted-foreground)); border: 1px solid color-mix(in oklch, var(--warning, var(--muted-foreground)) 60%, transparent); }
</style>

<div class="toolbar">
  {#if viewName()}
    <span style="color:var(--foreground);font-weight:var(--font-weight-medium,500)">{viewName()}</span>
  {:else}
    <span>No view</span>
  {/if}
  <span style="flex:1"></span>
  {#if errCount() > 0}
    <span class="count err">{errCount()} error</span>
  {/if}
  {#if warnCount() > 0}
    <span class="count warn">{warnCount()} warn</span>
  {/if}
  {#if loading()}
    <span>Linting…</span>
  {/if}
</div>
<div class="body">
  {#if errorMsg()}
    <div style="padding:20px;color:var(--muted-foreground)">{errorMsg()}</div>
  {:else if !viewName() && !loading()}
    <sui-empty-state>
      <sui-icon slot="icon" name="check-circle"></sui-icon>
      <span slot="title">No view</span>
      Navigate to a view to lint it.
    </sui-empty-state>
  {:else if filteredFindings().length === 0 && !loading()}
    <sui-empty-state>
      <sui-icon slot="icon" name="check-circle"></sui-icon>
      <span slot="title">Clean</span>
      No lint errors in current view.
    </sui-empty-state>
  {:else}
    {#for f of filteredFindings() key={f.rule + f.line + f.col}}
      <div class="row">
        <span class="sev" class:err={f.severity === 'error'} class:warn={f.severity !== 'error'}>{f.severity}</span>
        <span class="loc">{f.file}:{f.line}:{f.col}</span>
        <span><span class="rule">[{f.rule}]</span>{f.message}</span>
      </div>
    {/for}
  {/if}
</div>
