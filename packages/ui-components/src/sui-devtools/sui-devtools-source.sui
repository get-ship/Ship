<bundle separate />
<!--
  <sui-devtools-source> — view source explorer + single editor.

  Two-column layout: file explorer (200px) on the left, one
  sui-code-editor on the right. Explorer lists every textual file
  under the active view's directory plus any `[id]/`-shaped subroute,
  fetched from /api/v1/views/{name}/files. Selecting a file loads its
  contents into the editor.

  Replaces the prior stacked page.sui + manifest.jsonc layout which
  cramped each editor to ~3-4 lines of source.

  Save: Cmd/Ctrl+S writes the currently-selected file via the
  /api/v1/views/{name}/template endpoint (which accepts any of the
  ALLOWED_EXT extensions post j2 → SUI cutover).
-->

<style>
  :host {
    /* The dock's slotted-active rule forces flex-direction: column on
     * every body element so the standard header + body + footer chain
     * works. We're a two-COLUMN layout (file explorer + editor) so
     * wrap our actual content in an inner row container below. */
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-size: var(--text-sm);
  }
  :host([hidden]) { display: none; }

  .row {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
  }

  .explorer {
    flex: 0 0 220px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    background: var(--sidebar, var(--card));
  }
  .explorer-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
  .explorer-head .name {
    color: var(--foreground);
    font-weight: var(--font-weight-medium, 500);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .file-list {
    list-style: none;
    margin: 0;
    padding: 4px 0;
    overflow: auto;
    flex: 1;
    min-height: 0;
  }
  .file-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px var(--space-3, 12px);
    cursor: pointer;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    color: var(--foreground);
    border-left: 2px solid transparent;
  }
  .file-row:hover { background: color-mix(in oklch, var(--foreground) 6%, transparent); }
  .file-row[aria-current="true"] {
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    border-left-color: var(--primary);
    color: var(--primary);
  }
  .file-row .kind {
    font-size: 9px;
    padding: 1px 4px;
    border-radius: var(--radius-sm, 3px);
    background: color-mix(in oklch, var(--foreground) 10%, transparent);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .file-row .subroute {
    font-size: 9.5px;
    color: var(--muted-foreground);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
    padding: 1px 4px;
    border-radius: var(--radius-sm, 3px);
  }
  .file-row .name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .editor-col {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .editor-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
  .editor-head .path {
    font-family: var(--font-mono);
    color: var(--foreground);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .editor-head .dirty-dot {
    width: 6px; height: 6px; border-radius: 999px;
    background: var(--primary); flex-shrink: 0;
  }
  .editor-head .state {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--muted);
    color: var(--muted-foreground);
  }
  .editor-head .state[data-saved="true"] {
    background: color-mix(in oklab, var(--success, #16a34a) 22%, var(--muted));
    color: var(--foreground);
  }
  .save-btn {
    appearance: none;
    font: inherit;
    font-size: var(--text-xs);
    padding: 2px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--primary);
    background: var(--primary);
    color: var(--primary-foreground, #fff);
    cursor: pointer;
  }
  .save-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .editor-pane {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .editor-pane sui-code-editor { flex: 1; min-height: 0; }

  .empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    padding: 12px;
    text-align: center;
  }

  .diagnostics {
    padding: 4px var(--space-3, 12px);
    background: color-mix(in oklch, var(--destructive) 10%, transparent);
    color: var(--destructive);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    border-top: 1px solid var(--destructive);
    max-height: 120px;
    overflow: auto;
    flex-shrink: 0;
  }
</style>

<div class="row">
<aside class="explorer" part="explorer">
  <div class="explorer-head">
    <sui-icon name="folder" size="sm"></sui-icon>
    {#if viewName()}
      <span class="name">{viewName()}</span>
    {:else}
      <span>no view</span>
    {/if}
  </div>
  {#if files().length === 0}
    <div class="empty">
      {#if loading()}Loading…{:else}{loadError() ?? 'No files.'}{/if}
    </div>
  {:else}
    <ul class="file-list" role="listbox" aria-label="View files">
      {#for f of files() key={f.path}}
        <li
          class="file-row"
          role="option"
          aria-current={f.path === selectedPath() ? 'true' : 'false'}
          data-path={f.path}
          on:click={(e) => onPickFile(e)}>
          {#if f.subroute}<span class="subroute">{f.subroute}</span>{/if}
          <span class="name">{f.name}</span>
          <span class="kind">{f.kind}</span>
        </li>
      {/for}
    </ul>
  {/if}
</aside>

<div class="editor-col" part="editor-col">
  {#if selectedPath()}
    <div class="editor-head">
      <span class="path">{selectedPath()}</span>
      {#if isDirty()}<span class="dirty-dot" title="Unsaved changes"></span>{/if}
      <span class="state" data-saved={saved() ? 'true' : 'false'}>
        {isDirty() ? 'unsaved' : (saved() ? 'saved' : 'clean')}
      </span>
      <button class="save-btn" type="button"
        on:click={onSave}
        disabled={saving() || !isDirty()}
        title="Save (⌘/Ctrl+S)">{saving() ? 'Saving…' : 'Save'}</button>
    </div>
    <div class="editor-pane">
      <sui-code-editor
        bind:this={editorEl}
        language={editorLang()}
        on:sui-change={onChange}
        on:sui-save={onSave}>
      </sui-code-editor>
    </div>
    {#if errorMsg()}
      <div class="diagnostics" transition:slide={{ duration: 180 }}>{errorMsg()}</div>
    {/if}
  {:else}
    <div class="empty">
      {#if loading()}Loading view files…{:else if files().length > 0}Select a file to edit.{:else}No view active.{/if}
    </div>
  {/if}
</div>
</div>
