<!--
  <sui-edit-mode-pill> — persistent top-right corner indicator + control
  for view edit mode + annotation sub-mode.

  Layout (when on):
    [● dot] Editing [<view>] [⌖ annotate] [N queued · Send] [×]

  Buttons:
    × (close)      — exits edit mode entirely (dispatches sui:edit-mode:exit)
    ⌖ (annotate)   — toggles annotation mode (sui:annotation-mode:toggle)
    Send           — appears when queue has items; opens cmdk AI with
                     annotations bundled as prefill (sui:annotations:send)

  Prop surface
  ─────────────────────────────────────────────────────────────────────
  on          (bool, false, reflect)  edit mode on
  annotating  (bool, false, reflect)  annotation mode on (only valid when on)
  view        (string, '')            view name
  count       (int, 0, reflect)       captured annotations queued
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="on" type="bool" default="false" reflect />
<prop name="annotating" type="bool" default="false" reflect />
<prop name="view" type="string" default="" />
<prop name="count" type="number" default="0" reflect />

<style>
  :host {
    display: none;
    position: fixed;
    top: calc(var(--ship-top-bar-h, 40px) + 8px);
    right: 8px;
    z-index: var(--z-toast, 1100);
    pointer-events: none;
  }
  :host([on]) { display: block; }

  .pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 4px 0 10px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--warning, #d97706) 14%, var(--card, #fff));
    color: var(--warning, #d97706);
    border: 1px solid color-mix(in oklch, var(--warning, #d97706) 36%, transparent);
    font-family: var(--font-body, system-ui);
    font-size: 11px;
    line-height: 1;
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.18));
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--warning, #d97706);
    flex-shrink: 0;
    animation: edit-pulse 1.6s var(--ease-in-out, ease-in-out) infinite;
  }
  @keyframes edit-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(0.78); }
  }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }

  .label {
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .label .view {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    padding: 1px 5px;
    margin-left: 4px;
    background: color-mix(in oklch, var(--warning, #d97706) 22%, transparent);
    border-radius: var(--radius-sm, 4px);
  }

  .sep {
    width: 1px;
    align-self: stretch;
    background: color-mix(in oklch, var(--warning, #d97706) 28%, transparent);
    margin: 4px 2px;
  }

  .btn {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    line-height: 1;
    padding: 0 6px;
    height: 22px;
    border-radius: 999px;
    opacity: 0.85;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition:
      background-color var(--duration-fast, 120ms) var(--ease-out, ease-out),
      opacity var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  .btn:hover {
    opacity: 1;
    background: color-mix(in oklch, var(--foreground) 10%, transparent);
  }
  .btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--warning, #d97706) 50%, transparent);
  }
  .btn[aria-pressed="true"] {
    background: var(--warning, #d97706);
    color: var(--warning-foreground, var(--card, #fff));
    opacity: 1;
  }

  .send {
    background: var(--primary, #3b82f6);
    color: var(--primary-foreground, #fff);
    opacity: 1;
    padding: 0 10px;
    height: 22px;
    font-weight: 500;
  }
  .send:hover { background: color-mix(in oklch, var(--primary) 80%, white); }

  .qcount {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    background: color-mix(in oklch, var(--primary) 22%, transparent);
    color: var(--primary);
    border-radius: var(--radius-sm, 4px);
  }

  .close-btn {
    padding: 0 8px;
    font-size: 14px;
    line-height: 1;
  }
</style>

<div class="pill" part="pill" role="status" aria-live="polite">
  <span class="dot" part="dot" aria-hidden="true"></span>
  <span class="label" part="label">
    Editing<span class="view" part="view">{view() || 'view'}</span>
  </span>
  <span class="sep" aria-hidden="true"></span>
  <button class="btn" part="annotate" type="button"
    aria-pressed={annotating() ? 'true' : 'false'}
    title={annotating() ? 'Stop annotating (Shift+Alt+E)' : 'Start annotating (Shift+Alt+E)'}
    aria-label={annotating() ? 'Stop annotating' : 'Start annotating'}
    on:click={onAnnotateToggle}>
    <sui-icon name="crosshair" size="sm"></sui-icon>
  </button>
  {#if count() > 0}
    <button class="btn send" part="send" type="button"
      title="Send {count()} annotation{count() === 1 ? '' : 's'} to active chat"
      aria-label="Send annotations to agent"
      on:click={onSend}>
      <span class="qcount" style="background:rgba(255,255,255,0.18);color:inherit">{count()}</span>
      <span>Send</span>
    </button>
  {/if}
  <button class="btn close-btn" part="close" type="button"
    title="Exit edit mode (Alt+E)"
    aria-label="Exit edit mode"
    on:click={onExit}>×</button>
</div>
