{
  "bindings": [
    {
      "key": "b0",
      "kind": "attr:aria-label",
      "expr": "name() || initials() || 'avatar'",
      "deps": [
        "name",
        "initials"
      ]
    },
    {
      "key": "b1",
      "kind": "if",
      "expr": "iconSlug() || src()",
      "deps": [
        "iconSlug",
        "src"
      ]
    },
    {
      "key": "b2",
      "kind": "attr:src",
      "expr": "iconSlug() ? 'https://cdn.simpleicons.org/' + iconSlug() : src()",
      "deps": [
        "iconSlug",
        "src"
      ]
    },
    {
      "key": "b3",
      "kind": "attr:alt",
      "expr": "name()",
      "deps": [
        "name"
      ]
    },
    {
      "key": "b4",
      "kind": "text",
      "expr": "initials() ? initials().slice(0, 2).toUpperCase() : (name().trim().slice(0, 1).toUpperCase() || '?')",
      "deps": [
        "initials",
        "name"
      ]
    }
  ]
}