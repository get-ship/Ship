<!--
  <sui-command-bar> — SUI port of <ship-command-bar>.
  cmdk-style command palette with modes: ai / command / find / mention / create.
  Mounts as a singleton in shell2's body; exposes imperative show/hide/toggle/setMode.

  Prop / event / method parity vs <ship-command-bar>
  ─────────────────────────────────────────────────────────────────────────────
  open (bool, false, reflect)   — modal visible (reflects to [open] attr)
  mode (string, 'ai', reflect)  — current bar mode
  ─────────────────────────────────────────────────────────────────────────────
  Methods: show(mode?, query?), hide(), toggle(mode?), setMode(mode)
  ─────────────────────────────────────────────────────────────────────────────
  Events:
    sui-command:select  { detail: { mode, item } }  bubbles, composed
    sui-command:cancel  { detail: { mode } }         bubbles, composed
  ─────────────────────────────────────────────────────────────────────────────
  Modes: ai, command, find, mention, create
  ─────────────────────────────────────────────────────────────────────────────
  Keyboard: ⌘K open-find, space+space open-ai, ↑/↓ navigate, Enter activate, Esc close
  ─────────────────────────────────────────────────────────────────────────────
  Composes: <sui-dialog> backdrop · native <input> · <sui-icon> · <sui-kbd>
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="mode" type="string" default="ai" reflect />

<style>
  :host { display: contents; }

  /* ── Trigger pill ─────────────────────────────────────────────── */
  .cb-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--background);
    color: var(--muted-foreground);
    font: inherit;
    font-size: var(--text-xs, 12px);
    cursor: pointer;
    min-width: 200px;
    max-width: 320px;
    text-align: left;
    transition: border-color var(--duration-fast, 120ms) var(--ease-out, ease);
  }
  .cb-trigger:hover {
    border-color: color-mix(in oklch, var(--foreground) 30%, var(--border));
  }
  .cb-label { flex: 1; }
  .cb-trigger kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }

  /* ── Status dot (trigger + chip) ─────────────────────────────── */
  .cb-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--muted-foreground);
    flex-shrink: 0;
    display: inline-block;
  }

  /* ── Dialog host override ─────────────────────────────────────── */
  .cb-dialog::part(body) {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* ── Wrap (inside dialog body slot) ──────────────────────────── */
  .cb-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Palette input row ────────────────────────────────────────── */
  .cb-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .cb-mode-glyph {
    color: var(--muted-foreground);
    width: 20px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    flex-shrink: 0;
    user-select: none;
  }
  .cb-mode-glyph.ai { color: var(--primary); }
  .cb-search {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    flex: 1;
    padding: 4px 0;
    font: inherit;
    font-size: var(--text-sm, 13px);
    min-width: 0;
  }
  .cb-search::placeholder { color: var(--muted-foreground); }
  .cb-search:focus { outline: none; }
  .cb-esc {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
    flex-shrink: 0;
    user-select: none;
  }
  .cb-chip-wrap { position: relative; flex-shrink: 0; }
  .cb-session-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-left: 1px solid var(--border);
    color: var(--foreground);
    font-size: var(--text-xs, 12px);
    cursor: pointer;
    user-select: none;
  }

  /* ── Scrollable results body ──────────────────────────────────── */
  .cb-body {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px;
    min-height: 0;
    overscroll-behavior: contain;
  }

  /* ── List (find / command / mention) ─────────────────────────── */
  .cb-list { display: grid; gap: 2px; }
  .cb-item {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 6px 10px;
    border-radius: var(--radius-sm, 4px);
    font-size: var(--text-sm, 13px);
    cursor: pointer;
    color: var(--foreground);
    user-select: none;
  }
  .cb-item:hover,
  .cb-item[aria-selected="true"] { background: var(--muted); }
  .cb-item .hint {
    color: var(--muted-foreground);
    font-size: var(--text-xs, 12px);
  }
  .cb-mode-hint {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    margin-bottom: 8px;
    user-select: none;
  }
  .cb-empty {
    padding: 16px;
    color: var(--muted-foreground);
    font-size: var(--text-sm, 13px);
    text-align: center;
  }

  /* ── Session popover ──────────────────────────────────────────── */
  .cb-session-popover {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 6px;
    min-width: 280px;
    background: var(--card, var(--background));
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.18);
    z-index: 1;
    padding: 6px;
    font-size: var(--text-sm, 13px);
  }
  .cb-session-row {
    display: grid;
    grid-template-columns: 10px 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 6px 10px;
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
  }
  .cb-session-row:hover { background: var(--muted); }
  .cb-session-row.current { color: var(--primary); }
  .cb-session-row .meta {
    font-size: var(--text-xs, 12px);
    color: var(--muted-foreground);
  }
  .cb-session-end {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--muted-foreground);
    cursor: pointer;
    font: inherit;
    font-size: var(--text-xs, 12px);
    padding: 2px 6px;
  }
  .cb-session-end:hover { color: var(--destructive); }
  .cb-session-sep { height: 1px; background: var(--border); margin: 4px 0; }
  .cb-session-action {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--radius-sm, 4px);
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .cb-session-action:hover { background: var(--muted); color: var(--foreground); }

  /* ── Create form ──────────────────────────────────────────────── */
  .cb-create-surfaces {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 12px;
  }
  .cb-surface-btn {
    appearance: none;
    background: var(--background);
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    padding: 10px 4px;
    cursor: pointer;
    display: grid;
    justify-items: center;
    gap: 4px;
    font: inherit;
    font-size: var(--text-xs, 12px);
  }
  .cb-surface-btn[aria-pressed="true"] {
    border-color: var(--primary);
    background: color-mix(in oklch, var(--primary) 10%, transparent);
    color: var(--primary);
  }
  .cb-create-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 12px;
    margin-bottom: 12px;
  }
  .cb-create-grid label {
    display: grid;
    gap: 4px;
    font-size: var(--text-xs, 12px);
    color: var(--muted-foreground);
  }
  .cb-create-grid label.span-2 { grid-column: 1 / -1; }
  .cb-create-grid input,
  .cb-create-grid select {
    font: inherit;
    font-size: var(--text-sm, 13px);
    color: var(--foreground);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    padding: 6px 10px;
  }
  .cb-create-error {
    color: var(--destructive);
    font-size: var(--text-xs, 12px);
    margin-bottom: 8px;
  }
  .cb-create-actions { display: flex; justify-content: flex-end; }
  .cb-create-submit {
    appearance: none;
    font: inherit;
    font-size: var(--text-sm, 13px);
    padding: 6px 14px;
    border-radius: var(--radius-sm, 4px);
    background: var(--primary);
    color: var(--primary-foreground, #fff);
    border: 1px solid var(--primary);
    cursor: pointer;
  }
  .cb-create-submit:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Spawn card (AI, no session) ──────────────────────────────── */
  .cb-spawn-card { display: grid; gap: 8px; }
  .cb-spawn-title {
    font-weight: var(--font-weight-medium, 500);
    font-size: var(--text-sm, 13px);
  }
  .cb-spawn-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 8px;
    align-items: center;
  }
  .cb-spawn-row label { font-size: var(--text-xs, 12px); color: var(--muted-foreground); }
  .cb-spawn-row select {
    font: inherit;
    font-size: var(--text-sm, 13px);
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    border-radius: var(--radius-sm, 4px);
    padding: 4px 8px;
  }
  .cb-spawn-error { color: var(--destructive); font-size: var(--text-xs, 12px); }
  .cb-spawn-start {
    appearance: none;
    font: inherit;
    font-size: var(--text-sm, 13px);
    padding: 6px 12px;
    border-radius: var(--radius-sm, 4px);
    background: var(--primary);
    color: var(--primary-foreground, #fff);
    border: 1px solid var(--primary);
    cursor: pointer;
    justify-self: end;
  }
  .cb-spawn-start:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Thread (AI, palette layout, with session) ────────────────── */
  .cb-thread { display: grid; gap: 8px; font-size: var(--text-sm, 13px); }
  .cb-thread-empty { color: var(--muted-foreground); font-size: var(--text-xs, 12px); }
  .cb-turn { display: grid; grid-template-columns: 60px 1fr; gap: 8px; }
  .cb-turn .sender {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-foreground);
    padding-top: 2px;
  }
  .cb-turn[data-sender="user"] .sender { color: var(--primary); }
  .cb-turn[data-sender="agent"] .sender { color: var(--success, #16a34a); }
  .cb-turn .text {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: var(--text-xs, 12px);
  }

  /* ── Chat layout (AI + session, full chat UI) ─────────────────── */
  .cb-chat-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm, 13px);
    background: var(--sidebar);
    flex-shrink: 0;
  }
  .cb-chat-header .title { font-weight: var(--font-weight-medium, 500); }
  .cb-chat-header .sub { color: var(--muted-foreground); font-size: var(--text-xs, 12px); }
  .cb-chat-messages {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    min-height: 0;
    overscroll-behavior: contain;
  }
  .cb-chat-empty {
    padding: 48px 20px;
    text-align: center;
    color: var(--muted-foreground);
    font-size: var(--text-sm, 13px);
  }
  .cb-chat-turn {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .cb-chat-turn[data-sender="user"] { flex-direction: row-reverse; }
  .cb-chat-bubble {
    max-width: 78%;
    padding: 8px 12px;
    border-radius: var(--radius-md, 6px);
    font-size: var(--text-sm, 13px);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .cb-chat-turn[data-sender="user"] .cb-chat-bubble {
    background: color-mix(in oklch, var(--primary) 15%, transparent);
    color: var(--foreground);
  }
  .cb-chat-turn[data-sender="agent"] .cb-chat-bubble {
    background: var(--muted);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs, 12px);
  }
  .cb-chat-turn[data-sender="system"] { justify-content: center; }
  .cb-chat-turn[data-sender="system"] .cb-chat-bubble {
    background: transparent;
    color: var(--muted-foreground);
    font-size: var(--text-xs, 12px);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    width: 100%;
    text-align: center;
    max-width: none;
  }
  .cb-chat-composer {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }
  .cb-chat-composer textarea {
    flex: 1;
    min-height: 36px;
    max-height: 160px;
    font: inherit;
    font-size: var(--text-sm, 13px);
    color: var(--foreground);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    padding: 6px 10px;
    resize: vertical;
  }
  .cb-chat-composer textarea:focus {
    outline: none;
    border-color: color-mix(in oklch, var(--primary) 50%, var(--border));
  }
  .cb-chat-composer button {
    appearance: none;
    font: inherit;
    font-size: var(--text-sm, 13px);
    padding: 8px 16px;
    border-radius: var(--radius-md, 6px);
    background: var(--primary);
    color: var(--primary-foreground, #fff);
    border: 1px solid var(--primary);
    cursor: pointer;
  }
  .cb-chat-composer button:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<button class="cb-trigger" type="button" aria-label="Open command bar" bind:this={triggerBtn}>
  <sui-icon name="search" size="sm"></sui-icon>
  <span class="cb-label" bind:this={triggerLabel}>Ask Ship or jump to…</span>
  <span class="cb-dot" bind:this={triggerDot}></span>
  <kbd>⌘K</kbd>
</button>

<sui-dialog
  class="cb-dialog"
  no-header
  no-footer
  no-close-button
  backdrop="blur"
  size="full"
  style="--dlg-max-w: min(840px, 94vw)"
  bind:this={dialogRef}
>
  <div class="cb-wrap" bind:this={wrapEl}></div>
</sui-dialog>
