<bundle separate />
<!--
  <sui-command-chat> — inner chat panel for an active AI session.
  Consumed inside <sui-command-bar> when mode=ai and session exists.
  Accesses provider state via useShared.
-->

<style>
  :host { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }

  /* ── Header ───────────────────────────────────────────────────── */
  .cb-chat-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-dot {
    width: 8px; height: 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .cb-chat-header .title { font-size: 13px; font-weight: 600; }
  .cb-chat-header .sub { font-size: 11px; color: var(--muted-foreground); }
  .cb-chip-wrap { position: relative; flex-shrink: 0; }
  .cb-session-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 11px;
    color: var(--muted-foreground);
    cursor: pointer;
    user-select: none;
  }
  .cb-session-chip:hover { background: var(--muted); }
  .cb-esc {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }

  /* ── Session picker ───────────────────────────────────────────── */
  .cb-session-popover {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 280px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    box-shadow: var(--shadow-lg);
    z-index: 10;
    padding: 4px 0;
  }
  .cb-session-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    cursor: pointer;
    font-size: 12px;
  }
  .cb-session-row:hover { background: var(--muted); }
  .cb-session-row.current { background: color-mix(in oklch, var(--primary) 8%, transparent); }
  .cb-session-row .meta { color: var(--muted-foreground); font-size: 11px; }
  .cb-session-end {
    background: transparent; border: none; cursor: pointer;
    color: var(--muted-foreground); font-size: 14px; padding: 0 2px;
  }
  .cb-session-end:hover { color: var(--destructive, red); }
  .cb-session-sep { height: 1px; background: var(--border); margin: 4px 0; }
  .cb-session-action {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 12px; cursor: pointer; font-size: 12px;
    color: var(--muted-foreground);
  }
  .cb-session-action:hover { background: var(--muted); color: var(--foreground); }

  /* ── Messages ─────────────────────────────────────────────────── */
  .cb-chat-messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cb-chat-empty { color: var(--muted-foreground); font-size: 13px; text-align: center; margin-top: 24px; }
  .cb-chat-turn { display: flex; flex-direction: column; }
  .cb-chat-turn[data-sender='user'] { align-items: flex-end; }
  .cb-chat-turn[data-sender='agent'] { align-items: flex-start; }
  .cb-chat-turn[data-sender='system'] { align-items: center; }
  .cb-chat-bubble {
    max-width: 80%;
    padding: 7px 10px;
    border-radius: var(--radius-md, 6px);
    font-size: 13px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .cb-chat-turn[data-sender='user'] .cb-chat-bubble {
    background: var(--primary);
    color: var(--primary-foreground, #fff);
  }
  .cb-chat-turn[data-sender='agent'] .cb-chat-bubble {
    background: var(--muted);
    color: var(--foreground);
  }
  .cb-chat-turn[data-sender='system'] .cb-chat-bubble {
    background: transparent;
    color: var(--muted-foreground);
    font-size: 11px;
    font-family: var(--font-mono);
  }

  /* ── Composer ─────────────────────────────────────────────────── */
  .cb-chat-composer {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    padding: 10px 14px;
    border-top: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-chat-input {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: 13px;
    padding: 6px 8px;
    resize: none;
    line-height: 1.4;
  }
  .cb-chat-input:focus { outline: none; border-color: var(--primary); }
  .cb-chat-send {
    height: 32px;
    padding: 0 14px;
    border: none;
    border-radius: var(--radius-sm, 4px);
    background: var(--primary);
    color: var(--primary-foreground, #fff);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    flex-shrink: 0;
    align-self: flex-end;
  }
  .cb-chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<!-- Header -->
<div class="cb-chat-header">
  <span class="cb-dot" style:background={headerDotBg()} aria-hidden="true"></span>
  <div style="display:grid;line-height:1.25">
    <span class="title">{bar.session()?.agent_id ?? ''}</span>
    <span class="sub">{bar.session()?.provider ?? '—'} · {bar.session()?.workspace_id ?? ''}</span>
  </div>
  <span style="flex:1"></span>
  <div class="cb-chip-wrap">
    <span class="cb-session-chip" role="button" aria-haspopup="listbox" on:click={toggleSessionPicker}>Switch</span>
    {#if bar.sessionPickerOpen()}
      <div class="cb-session-popover" role="listbox" aria-label="Sessions">
        {#for s of activeSessions() key={s.id}}
          <div
            class="cb-session-row"
            class:current={bar.session()?.id === s.id}
            role="option"
            on:click={() => selectSession(s.id)}
          >
            <span class="cb-dot" style:background={s.status === 'thinking' ? 'var(--warning,#d97706)' : 'var(--success,#16a34a)'}></span>
            <span><strong>{s.agent_id ?? ''}</strong><span class="meta"> · {s.provider ?? ''} · {s.workspace_id}</span></span>
            <button class="cb-session-end" type="button" aria-label="End session" on:click={(e) => { e.stopPropagation(); endSession(s.id) }}>×</button>
          </div>
        {/for}
        {#if activeSessions().length === 0}
          <div class="cb-session-row"><span></span><span class="meta">No active sessions</span><span></span></div>
        {/if}
        <div class="cb-session-sep" role="separator"></div>
        <div class="cb-session-action" on:click={startNewSession}>
          <sui-icon name="plus" size="sm" aria-hidden="true"></sui-icon>
          <span>Start new session</span>
        </div>
        <div class="cb-session-action" on:click={viewChats}>
          <sui-icon name="columns" size="sm" aria-hidden="true"></sui-icon>
          <span>View all chats</span>
        </div>
      </div>
    {/if}
  </div>
  <kbd class="cb-esc" aria-label="Escape to close">esc</kbd>
</div>

<!-- Messages -->
<div class="cb-chat-messages">
  {#if bar.thread().length === 0}
    <div class="cb-chat-empty">Type below and press Enter. The agent's replies land here.</div>
  {:else}
    {#for msg of bar.thread() key={msg.id}}
      <div class="cb-chat-turn" data-sender={msg.sender}>
        <div class="cb-chat-bubble">{msg.text}</div>
      </div>
    {/for}
  {/if}
</div>

<!-- Composer -->
<div class="cb-chat-composer">
  <textarea
    class="cb-chat-input"
    rows="2"
    placeholder="Message the agent…"
    bind:value={bar.value}
    on:keydown={onComposerKeydown}
  ></textarea>
  <button
    class="cb-chat-send"
    type="button"
    disabled={!bar.value().trim()}
    on:click={sendMessage}
  >Send</button>
</div>
