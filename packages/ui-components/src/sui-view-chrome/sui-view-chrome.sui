<!--
  <sui-view-chrome> — SUI port of <ship-view-chrome>.

  A view's declarative contribution to the shell's topbar + statusbar.
  Views never render their own breadcrumb or status bar — they emit a
  single <sui-view-chrome> and the shell paints the chrome on their
  behalf. Keeps first-party and third-party views symmetric.

  Prop / event parity vs <ship-view-chrome>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ─────────────────────────────────────────────────────────────────────────────
  title  (string, '')          title  (string, '', reflect) breadcrumb leaf
  branch (string, '')          branch (string, '', reflect) status branch name
  ahead  (number, 0)           ahead  (number, 0,  reflect) ↑N commits
  behind (number, 0)           behind (number, 0,  reflect) ↓N commits
  tone   (union, 'default')    tone   (union, reflect)      status dot tint
  busy   (bool, false)         busy   (bool, false, reflect) pulse dot
  ─────────────────────────────────────────────────────────────────────────────
  Slots (light DOM, contributed to shell containers on connect):
    actions       → #view-topbar-actions
    status-start  → #view-status-start
    status-end    → #view-status-end
  ─────────────────────────────────────────────────────────────────────────────
  Mechanism: controller moves slot children into shell-owned containers via
  appendChild on connect; withdraws them on disconnect. Attribute-driven
  fields are written to #breadcrumbs-title, #status-branch, #status-ab,
  #status-dot. No-shell fallback: when containers are absent, the element
  is invisible and no-ops — safe in standalone previews and tests.
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="title" type="string" default="" reflect />
<prop name="branch" type="string" default="" reflect />
<prop name="ahead" type="number" default="0" reflect />
<prop name="behind" type="number" default="0" reflect />
<prop name="tone" values="default|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="busy" type="bool" default="false" reflect />

<style>
  :host { display: none; }
</style>
