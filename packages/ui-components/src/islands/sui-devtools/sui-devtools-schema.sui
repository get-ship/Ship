<!--
  <sui-devtools-schema> — SUI port of <ship-devtools-schema>.
  Lists ship.* ops referenced by the mounted view's template/manifest,
  cross-linked to /api/v1/ship/schema. Read-only.
-->

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    font-size: var(--text-sm);
  }
  :host([hidden]) { display: none; }
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3, 12px);
    padding: 4px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    background: var(--sidebar);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
  .body { flex: 1; overflow: auto; }
  details { border-bottom: 1px solid color-mix(in oklch, var(--border) 40%, transparent); }
  details > summary {
    list-style: none;
    cursor: pointer;
    padding: 6px var(--space-3, 12px);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3, 12px);
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  details > summary::-webkit-details-marker { display: none; }
  .op { color: var(--primary); }
  .op.soft::before { content: 'try · '; color: var(--muted-foreground); }
  .op.unknown { color: var(--destructive); }
  .perm { color: var(--muted-foreground); }
  .desc { color: var(--muted-foreground); }
  .detail {
    padding: 4px var(--space-3, 12px) 10px calc(var(--space-3, 12px) + 14px);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    display: grid;
    gap: 4px;
    font-family: var(--font-mono);
  }
  .detail code { color: var(--foreground); }
</style>

<div class="toolbar">
  {#if refs().length > 0}
    <span>{refs().length} ops referenced</span>
    <span style="flex:1"></span>
    <span>{knownCount()} known · {refs().length - knownCount()} unknown</span>
  {:else}
    <span></span>
  {/if}
</div>
<div class="body">
  {#if errorMsg()}
    <div style="padding:20px;color:var(--muted-foreground)">{errorMsg()}</div>
  {:else if refs().length === 0}
    <sui-empty-state>
      <sui-icon slot="icon" name="network"></sui-icon>
      <span slot="title">No schema references</span>
      No ship.* calls detected in this view.
    </sui-empty-state>
  {:else}
    {#for r of refs() key={r.op + (r.soft ? '-soft' : '')}}
      <details>
        <summary>
          <span class="op" class:soft={r.soft} class:unknown={!r.known}>{r.op}</span>
          <span class="desc">{r.description}</span>
          <span class="perm">{r.permission}</span>
        </summary>
        <div class="detail">
          {#if r.args !== null}
            {#if r.args.length > 0}
              <div>args: {r.argsSummary}</div>
            {:else}
              <div>args: <em>none</em></div>
            {/if}
            <div>returns: <code>{r.returns}</code></div>
            {#if r.sensitive}
              <div><strong>sensitive</strong></div>
            {/if}
          {:else}
            <div>Not registered in <code>/api/ship/schema</code>.</div>
          {/if}
        </div>
      </details>
    {/for}
  {/if}
</div>
