<!--
  <sui-va-annotation-pins> — Renders absolute-positioned numbered pins
  over the main view preview. Subscribes to per-view SSE events
  (`sui:view:annotation`). Each pin auto-clears after the next agent
  turn commits, or 30s timeout, whichever comes first. Clicking a pin
  fires `sui:dock:activate va-activity` so the relevant log entry
  scrolls into view.

  The host is fixed-positioned to overlay the viewport; pins compute
  their (x, y) from `selector` querySelector under #ship-content.
-->

<style>
  :host {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 7500;
  }
  :host([hidden]) { display: none; }

  .pin {
    position: absolute;
    transform: translate(-50%, -100%);
    background: var(--accent, #f97316);
    color: #fff;
    font: 600 11px/1 var(--font-body, system-ui);
    border-radius: 999px;
    min-width: 18px;
    height: 18px;
    padding: 0 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px hsl(0 0% 0% / 0.25);
    cursor: pointer;
    pointer-events: auto;
    animation: pin-in 320ms var(--ease-out, ease-out) both;
  }
  .pin[data-fading="true"] {
    animation: pin-out 240ms var(--ease-in, ease-in) both;
  }
  .pin::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 6px; height: 6px;
    background: inherit;
  }
  @keyframes pin-in {
    0%   { opacity: 0; transform: translate(-50%, -90%) scale(0.6); }
    60%  { opacity: 1; transform: translate(-50%, -104%) scale(1.06); }
    100% { opacity: 1; transform: translate(-50%, -100%) scale(1); }
  }
  @keyframes pin-out {
    to { opacity: 0; transform: translate(-50%, -90%) scale(0.85); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pin, .pin[data-fading="true"] { animation: none; }
  }
</style>

{#for pin of pins() key={pin.id}}
  <button
    class="pin"
    type="button"
    data-pin-id={pin.id}
    data-selector={pin.selector}
    data-fading={pin.fading ? 'true' : 'false'}
    style={'left:' + pin.x + 'px;top:' + pin.y + 'px'}
    title={pin.label}
    on:click={() => onPinClick(pin)}>
    {pin.number}
  </button>
{/for}
