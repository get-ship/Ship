<!--
  <sui-markdown-editor> — SUI island wrapping TipTap v3.
  Form-associated markdown editor with inline toolbar, selection bubble,
  and comment composer. Lazy-loads TipTap on mount.
-->

<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="tone" type="string" default="" reflect />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="invalid" type="bool" default="false" reflect />
<prop name="rows" type="number" default="12" />
<prop name="full-height" type="bool" default="false" reflect />
<prop name="name" type="string" default="" reflect />
<prop name="label" type="string" default="" />
<prop name="show-selection-toolbar" type="bool" default="true" />
<prop name="allow-comment" type="bool" default="true" />
<prop name="allow-generate" type="bool" default="false" />

<style>
  /* Structural chrome — ProseMirror content, bubble, and composer CSS
     are injected by the controller via adoptedStyleSheets. */
  :host {
    display: block;
    width: 100%;
    --tone: var(--ring-color);
    --ed-min-h: 320px;
  }
  :host([hidden]) { display: none; }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); }
  :host(:not([size])), :host([size='md']) {
    --ed-fs: 0.95rem; --ed-lh: 1.7;
    --ed-pad-y: var(--space-4); --ed-pad-x: var(--space-5);
    --ed-tb-h: 36px; --ed-tb-btn: 28px;
  }
  :host([size='sm']) {
    --ed-fs: var(--text-sm); --ed-lh: 1.6;
    --ed-pad-y: var(--space-3); --ed-pad-x: var(--space-4);
    --ed-tb-h: 32px; --ed-tb-btn: 24px;
  }
  :host([size='lg']) {
    --ed-fs: 1rem; --ed-lh: 1.75;
    --ed-pad-y: var(--space-5); --ed-pad-x: var(--space-6);
    --ed-tb-h: 40px; --ed-tb-btn: 32px;
  }
  :host([full-height]) .shell { height: 100%; min-height: 0; }
  .shell {
    position: relative;
    display: flex; flex-direction: column;
    background: var(--card); color: var(--foreground);
    border: 1px solid var(--border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs); overflow: hidden;
    min-height: var(--ed-min-h, 320px);
    transition: border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled])) .shell:hover {
    border-color: color-mix(in oklch, var(--border) 160%, transparent);
    box-shadow: var(--shadow-sm);
  }
  .shell:focus-within {
    outline: none;
    border-color: color-mix(in oklch, var(--tone) 70%, var(--border));
    box-shadow: 0 0 0 var(--ring-width) color-mix(in oklch, var(--tone) var(--ring-opacity), transparent);
  }
  :host([invalid]) .shell { border-color: color-mix(in oklch, var(--destructive) 65%, var(--border)); }
  :host([invalid]) .shell:focus-within {
    border-color: var(--destructive);
    box-shadow: 0 0 0 var(--ring-width) color-mix(in oklch, var(--destructive) var(--ring-opacity), transparent);
  }
  :host([disabled]) .shell { background: var(--muted); opacity: 0.6; cursor: not-allowed; }
  .toolbar {
    display: flex; align-items: center; flex-wrap: wrap; gap: 2px;
    padding: 4px 6px; min-height: var(--ed-tb-h);
    background: color-mix(in oklch, var(--muted) 40%, var(--card));
    border-bottom: 1px solid var(--border);
  }
  .toolbar button {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--ed-tb-btn); height: var(--ed-tb-btn);
    padding: 0; border: 0; background: transparent;
    color: var(--muted-foreground); border-radius: var(--radius-sm);
    cursor: pointer; font-family: var(--font-body); font-size: var(--text-sm);
    transition: background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .toolbar button:hover:not(:disabled) { background: color-mix(in oklch, var(--muted) 80%, transparent); color: var(--foreground); }
  .toolbar button:focus-visible { outline: none; box-shadow: 0 0 0 var(--ring-width) color-mix(in oklch, var(--tone) var(--ring-opacity), transparent); color: var(--foreground); }
  .toolbar button[aria-pressed='true'], .toolbar button.is-active { background: color-mix(in oklch, var(--primary) 18%, var(--muted)); color: var(--foreground); }
  .toolbar button:disabled { opacity: 0.4; cursor: not-allowed; }
  .toolbar svg { width: 14px; height: 14px; }
  .toolbar .divider { width: 1px; height: 18px; background: var(--border); margin: 0 4px; flex-shrink: 0; }
  .surface { flex: 1; min-height: 0; overflow: auto; }
  @media (forced-colors: active) {
    .shell:focus-within { outline: 2px solid CanvasText; outline-offset: 2px; }
    .toolbar button:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>

<div class="shell" part="shell" bind:this={shellEl}
  aria-invalid={invalid() ? 'true' : null}
  aria-disabled={disabled() ? 'true' : null}>
  <div class="toolbar" part="toolbar" role="toolbar"
    aria-label={label() || 'Editor toolbar'}
    on:mousedown={(e) => e.preventDefault()}>
    <button type="button" part="tb-bold" class:is-active={marks().bold} disabled={disabled()} data-action="bold" aria-label="Bold" aria-pressed={marks().bold ? 'true' : 'false'} title="Bold (Ctrl+B)" on:click={onToolbarClick}><span aria-hidden="true" style="font-weight:800;font-size:13px">B</span></button>
    <button type="button" part="tb-italic" class:is-active={marks().italic} disabled={disabled()} data-action="italic" aria-label="Italic" aria-pressed={marks().italic ? 'true' : 'false'} title="Italic (Ctrl+I)" on:click={onToolbarClick}><span aria-hidden="true" style="font-style:italic;font-weight:600;font-size:13px">I</span></button>
    <button type="button" part="tb-code" class:is-active={marks().code} disabled={disabled()} data-action="code" aria-label="Inline code" aria-pressed={marks().code ? 'true' : 'false'} on:click={onToolbarClick}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 18l6-6-6-6"></path><path d="M8 6l-6 6 6 6"></path></svg></button>
    <span class="divider" aria-hidden="true"></span>
    <button type="button" part="tb-h1" class:is-active={marks().h1} disabled={disabled()} data-action="h1" aria-label="Heading 1" aria-pressed={marks().h1 ? 'true' : 'false'} on:click={onToolbarClick}><span aria-hidden="true" style="font-weight:600;font-size:12px">H1</span></button>
    <button type="button" part="tb-h2" class:is-active={marks().h2} disabled={disabled()} data-action="h2" aria-label="Heading 2" aria-pressed={marks().h2 ? 'true' : 'false'} on:click={onToolbarClick}><span aria-hidden="true" style="font-weight:600;font-size:12px">H2</span></button>
    <button type="button" part="tb-h3" class:is-active={marks().h3} disabled={disabled()} data-action="h3" aria-label="Heading 3" aria-pressed={marks().h3 ? 'true' : 'false'} on:click={onToolbarClick}><span aria-hidden="true" style="font-weight:600;font-size:12px">H3</span></button>
    <span class="divider" aria-hidden="true"></span>
    <button type="button" part="tb-bullet" class:is-active={marks().bullet} disabled={disabled()} data-action="bullet" aria-label="Bullet list" aria-pressed={marks().bullet ? 'true' : 'false'} on:click={onToolbarClick}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"></path><path d="M8 12h13"></path><path d="M8 18h13"></path><path d="M3 6h.01"></path><path d="M3 12h.01"></path><path d="M3 18h.01"></path></svg></button>
    <button type="button" part="tb-ordered" class:is-active={marks().ordered} disabled={disabled()} data-action="ordered" aria-label="Ordered list" aria-pressed={marks().ordered ? 'true' : 'false'} on:click={onToolbarClick}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6h11"></path><path d="M10 12h11"></path><path d="M10 18h11"></path><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg></button>
    <button type="button" part="tb-task" class:is-active={marks().task} disabled={disabled()} data-action="task" aria-label="Task list" aria-pressed={marks().task ? 'true' : 'false'} on:click={onToolbarClick}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path></svg></button>
    <span class="divider" aria-hidden="true"></span>
    <button type="button" part="tb-link" class:is-active={marks().link} disabled={disabled()} data-action="link" aria-label="Link" aria-pressed={marks().link ? 'true' : 'false'} title="Link (Ctrl+K)" on:click={onLinkClick}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"></path></svg></button>
  </div>
  <div class="surface" part="surface">
    <div part="editor" bind:this={editorHost}></div>
  </div>
  {#if showSelectionToolbar()}
    <div class="bubble" part="bubble" role="toolbar" aria-label="Selection actions"
      data-open={bubblePos() !== null && pending() === null ? 'true' : 'false'}
      aria-hidden={bubblePos() !== null && pending() === null ? 'false' : 'true'}
      style:top={bubblePos() ? (bubblePos().top + 'px') : '-9999px'}
      style:left={bubblePos() ? (bubblePos().left + 'px') : '-9999px'}
      on:mousedown={(e) => e.preventDefault()}>
      <button type="button" part="bubble-bold" class:is-active={marks().bold} aria-label="Bold" aria-pressed={marks().bold ? 'true' : 'false'} data-action="bold" on:click={onBubbleFmt}><span class="glyph-bold" aria-hidden="true">B</span></button>
      <button type="button" part="bubble-italic" class:is-active={marks().italic} aria-label="Italic" aria-pressed={marks().italic ? 'true' : 'false'} data-action="italic" on:click={onBubbleFmt}><span class="glyph-italic" aria-hidden="true">I</span></button>
      <button type="button" part="bubble-strike" class:is-active={marks().strike} aria-label="Strike" aria-pressed={marks().strike ? 'true' : 'false'} data-action="strike" on:click={onBubbleFmt}><span class="glyph-strike" aria-hidden="true">S</span></button>
      <button type="button" part="bubble-code" class:is-active={marks().code} aria-label="Code" aria-pressed={marks().code ? 'true' : 'false'} data-action="code" on:click={onBubbleFmt}><span class="glyph-code" aria-hidden="true">&lt;/&gt;</span></button>
      {#if allowComment() || allowGenerate()}
        <span class="sep" aria-hidden="true"></span>
      {/if}
      {#if allowComment()}
        <button type="button" part="bubble-comment" aria-label="Comment" on:click={onOpenComposer}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path></svg></button>
      {/if}
      {#if allowGenerate()}
        <button type="button" part="bubble-generate" aria-label="Generate" on:click={onGenerate}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9.5 14 12l-.5 5L12 13l-4 2 1.5-4.5L5.5 8l5-.4z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path></svg></button>
      {/if}
    </div>
    {#if pending()}
      <div class="composer" part="composer" role="dialog" aria-label="Add comment"
        style:top={composerTop()}
        style:left={composerLeft()}
        on:mousedown={(e) => e.stopPropagation()}>
        <div class="composer-quote">"{pendingQuote()}"</div>
        <textarea rows="2" placeholder="Add your comment…" data-composer-input
          bind:this={composerInputEl}
          bind:value={composerValue}
          on:keydown={onComposerKey}></textarea>
        <div class="composer-actions">
          <button type="button" class="cancel" on:click={onCancel}>Cancel</button>
          <button type="button" class="submit" disabled={!composerValue().trim()} on:click={onSubmit}>Add comment <kbd>⌘↵</kbd></button>
        </div>
      </div>
    {/if}
  {/if}
</div>
