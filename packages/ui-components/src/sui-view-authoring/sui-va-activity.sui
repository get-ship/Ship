<bundle separate />
<!--
  <sui-va-activity> — Activity tab in the view-authoring dev panel.
  Renders an agent-turn log derived from per-view SSE events:
    sui:view:annotation  → ann entry
    sui:view:compiled    → "compiled" entry
    sui:view:errored     → "compile failed" entry
  Reverse-chronological. Each entry is expandable for detail.
-->

<prop name="view" type="string" default="" reflect />

<style>
  :host { display: block; height: 100%; overflow: auto; }
  :host([hidden]) { display: none; }
  .wrap { display: flex; flex-direction: column; padding: 6px 0; }
  details {
    border-bottom: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
    font-size: 12px;
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 6px 14px;
    display: grid;
    grid-template-columns: 20px 1fr auto;
    align-items: center;
    gap: 8px;
    color: var(--foreground);
  }
  summary::-webkit-details-marker { display: none; }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--muted-foreground);
    justify-self: center;
  }
  .dot[data-kind="annotation"] { background: var(--accent, #f97316); }
  .dot[data-kind="compiled"]   { background: var(--success, #22c55e); }
  .dot[data-kind="errored"]    { background: var(--destructive, #ef4444); }
  .label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ts {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
  }
  .detail {
    padding: 4px 16px 10px 42px;
    font-size: 11px;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    white-space: pre-wrap;
  }
  .empty {
    padding: 18px;
    text-align: center;
    color: var(--muted-foreground);
    font-size: 11.5px;
  }
</style>

<div class="wrap" data-entry-count={entries().length}>
  {#if entries().length === 0}
    <div class="empty">No activity yet. Agent turns will appear here.</div>
  {:else}
    {#for entry of entries() key={entry.id}}
      <details data-entry-id={entry.id} data-kind={entry.kind}>
        <summary>
          <span class="dot" data-kind={entry.kind}></span>
          <span class="label">{entry.label}</span>
          <span class="ts">{entry.tsFmt}</span>
        </summary>
        <div class="detail">{entry.detail}</div>
      </details>
    {/for}
  {/if}
</div>
