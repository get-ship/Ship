<bundle separate />
<!--
  <sui-va-components> — Components tab in the view-authoring dev panel.
  Two sections:
    1. In-this-view  — components parsed out of the current view's source
                       (rendered with a tiny live preview tile).
    2. Add-a-component — embeds <sui-component-picker mode="inline">.
                         Picks fire `chrome.bar.open('ai', prefill: …)`
                         to send the request to the active agent.
-->

<prop name="view" type="string" default="" reflect />

<style>
  :host { display: block; height: 100%; overflow: auto; }
  :host([hidden]) { display: none; }
  .wrap { display: flex; flex-direction: column; gap: 14px; padding: 12px; }
  h3 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 6px 0;
    color: var(--muted-foreground);
    font-weight: var(--font-weight-medium, 500);
  }
  .in-view {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 8px;
  }
  .chip {
    appearance: none;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 6px 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    color: var(--foreground);
    text-align: left;
  }
  .chip:hover {
    border-color: color-mix(in oklab, var(--primary) 60%, var(--border));
  }
  .chip[data-active="true"] {
    background: color-mix(in oklab, var(--primary) 14%, var(--background));
    border-color: var(--primary);
  }
  .chip .tag {
    font-family: var(--font-mono);
    color: var(--primary);
    flex: 1;
  }
  .chip .count {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--muted);
    color: var(--muted-foreground);
    border-radius: var(--radius-sm);
    padding: 0 5px;
    font-variant-numeric: tabular-nums;
  }
  .empty {
    font-size: 11px;
    color: var(--muted-foreground);
    padding: 8px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .picker-host {
    height: 320px;
    display: flex;
  }
  sui-component-picker { flex: 1; }
</style>

<div class="wrap">
  <section>
    <h3>In this view</h3>
    {#if inView().length === 0}
      <div class="empty">No SUI components detected. Open Source and add one, or pick from below.</div>
    {:else}
      <div class="in-view">
        {#for entry of inView() key={entry.tag}}
          <button
            class="chip"
            type="button"
            data-tag={entry.tag}
            data-active={highlighted() === entry.tag ? 'true' : 'false'}
            on:click={() => onChipClick(entry.tag)}>
            <sui-icon name="package" size="sm"></sui-icon>
            <span class="tag">&lt;{entry.tag}&gt;</span>
            <span class="count">{entry.count}</span>
          </button>
        {/for}
      </div>
    {/if}
  </section>
  <section>
    <h3>Add a component</h3>
    <div class="picker-host">
      <sui-component-picker
        mode="inline"
        select-mode="single"
        on:sui:component:picked={onPicked}>
      </sui-component-picker>
    </div>
  </section>
</div>
