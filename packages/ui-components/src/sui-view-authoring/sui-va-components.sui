<bundle separate />
<!--
  <sui-va-components> — Components tab in the view-authoring dev panel.

  Side-by-side layout: in-view chip list on the LEFT (260px), picker on
  the RIGHT (rest). Replaces the prior vertically-stacked layout that
  collapsed each section to a strip + caused the picker to fight for
  vertical space with the dev panel's already-short body.

  Wrap inside a `.row` to neutralize the dock's
  `slot[data-active]::slotted(*) { display: flex; flex-direction: column }`
  rule (same pattern as sui-devtools-source).
-->

<prop name="view" type="string" default="" reflect />

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }
  :host([hidden]) { display: none; }

  .row {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: row;
  }

  .col-left {
    flex: 0 0 260px;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    background: var(--sidebar, var(--card));
  }
  .col-right {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .col-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: var(--font-weight-medium, 500);
    flex-shrink: 0;
  }
  .col-head .count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .in-view {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .chip {
    appearance: none;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    padding: 4px 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    color: var(--foreground);
    text-align: left;
  }
  .chip:hover { border-color: color-mix(in oklab, var(--primary) 60%, var(--border)); }
  .chip[data-active="true"] {
    background: color-mix(in oklab, var(--primary) 14%, var(--background));
    border-color: var(--primary);
  }
  .chip .tag {
    font-family: var(--font-mono);
    color: var(--primary);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .chip .count {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--muted);
    color: var(--muted-foreground);
    border-radius: var(--radius-sm);
    padding: 0 5px;
    font-variant-numeric: tabular-nums;
  }
  .empty {
    font-size: 11px;
    color: var(--muted-foreground);
    padding: 12px;
    text-align: center;
  }

  .picker-host {
    flex: 1;
    min-height: 0;
    display: flex;
  }
  sui-component-picker { flex: 1; min-height: 0; }
</style>

<div class="row">
  <aside class="col-left" part="in-view">
    <div class="col-head">
      <sui-icon name="package" size="sm"></sui-icon>
      <span>In this view</span>
      <span class="count">{inView().length}</span>
    </div>
    {#if inView().length === 0}
      <div class="empty">No SUI components detected.<br/>Pick one from the catalog →</div>
    {:else}
      <div class="in-view">
        {#for entry of inView() key={entry.tag}}
          <button
            class="chip"
            type="button"
            data-tag={entry.tag}
            data-active={highlighted() === entry.tag ? 'true' : 'false'}
            on:click={() => onChipClick(entry.tag)}>
            <span class="tag">&lt;{entry.tag}&gt;</span>
            <span class="count">{entry.count}</span>
          </button>
        {/for}
      </div>
    {/if}
  </aside>

  <section class="col-right" part="catalog">
    <div class="col-head">
      <sui-icon name="search" size="sm"></sui-icon>
      <span>Add a component</span>
    </div>
    <div class="picker-host">
      <sui-component-picker
        mode="inline"
        select-mode="single"
        on:sui:component:picked={onPicked}>
      </sui-component-picker>
    </div>
  </section>
</div>
