<!--
  <sui-stat> — SUI port of <ship-stat>.
  KPI tile: label above + large numeric value + optional trend badge +
  optional hint line below. Background card with border.

  Prop / event / method parity vs <ship-stat>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  accent ('default'|...,       tone (union, 'default',  ✓ SUI uses 'tone' as
    'default')                   reflect)                the palette key per
                                                         convention. Maps to
                                                         the same color tokens.
  interactive (Boolean,        interactive (bool,       ✓ CSS hover lift +
    false)                       false, reflect)          cursor: pointer. No
                                                         role=button or
                                                         tabindex — template-
                                                         only port; callers add
                                                         those when needed.
  ─────────────────────────────────────────────────────────────────────────────
  Keyboard: Enter/Space click  OMITTED                  Requires controller;
    on host when interactive                             template-only port.
  role=button / tabindex=0     OMITTED                  Callers set on host
    set via connectedCallback                            manually when using
                                                         interactive mode.
  ─────────────────────────────────────────────────────────────────────────────
  slots: label, default        slots: label, default,   ✓
    (value), trend, hint         trend, hint
  ─────────────────────────────────────────────────────────────────────────────
  SUI additions: size          size (sm|md|lg, 'md')    New; controls value
                                                         typography scale.
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|primary|info|success|warning|destructive|accent" default="default" reflect />
<prop name="interactive" type="bool" default="false" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    font-family: var(--font-body);
    transition:
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
    --tone-fg: var(--foreground);
  }
  :host([hidden]) { display: none; }

  :host([tone='primary'])     { --tone-fg: var(--primary); }
  :host([tone='info'])        { --tone-fg: var(--info); }
  :host([tone='success'])     { --tone-fg: var(--success); }
  :host([tone='destructive']) { --tone-fg: var(--destructive); }
  :host([tone='warning'])     { --tone-fg: var(--warning); }
  :host([tone='accent'])      { --tone-fg: var(--accent); }

  :host([interactive]) { cursor: pointer; }
  :host([interactive]:hover) {
    border-color: color-mix(in oklch, var(--border) 180%, transparent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    :host([interactive]:hover) { transform: none; }
  }

  .label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .value-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .value {
    font-family: var(--heading-font, var(--font-body));
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--tone-fg);
  }
  :host([size='sm']) .value { font-size: var(--text-xl, 20px); }
  :host([size='md']) .value { font-size: var(--text-3xl, 30px); }
  :host([size='lg']) .value { font-size: var(--text-4xl, 36px); }

  .trend {
    display: inline-flex;
    align-items: center;
  }
  .hint {
    font-size: 11px;
    color: var(--muted-foreground);
  }
  ::slotted([slot='trend']) { font-size: var(--text-sm); }
</style>

<span class="label" part="label"><slot name="label"></slot></span>
<span class="value-row" part="value-row">
  <span class="value" part="value"><slot></slot></span>
  <span class="trend" part="trend"><slot name="trend"></slot></span>
</span>
<span class="hint" part="hint"><slot name="hint"></slot></span>
