<!--
  <sui-bar-chart> — SUI port of <ship-bar-chart>.
  Vertical or horizontal categorical bar chart, SVG-rendered.

  Prop parity vs <ship-bar-chart>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                   SUI                   Notes
  ─────────────────────────────────────────────────────────────────────────────
  data (string)         data (string,         ✓ comma-separated numbers
                          reflect)
  labels (string)       labels (string)       ✓ used as <title> per bar
  tone (string)         tone (union,          ✓ renamed to use values=
                          reflect)
  orientation (string)  orientation (union,   ✓
                          reflect)
  width (number)        width (number)        ✓ default 300
  height (number)       height (number)       ✓ default 200
  max (number|null)     max (number, 0)       0 = auto (inferred from data)
  label (string)        label (string)        ✓ aria-label on SVG
  ─────────────────────────────────────────────────────────────────────────────
  Slots: none
  Parts: none
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="data" type="string" default="" reflect />
<prop name="labels" type="string" default="" />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="primary" reflect />
<prop name="orientation" values="vertical|horizontal" default="vertical" reflect />
<prop name="width" type="number" default="300" />
<prop name="height" type="number" default="200" />
<prop name="max" type="number" default="0" />
<prop name="label" type="string" default="bar chart" />

<style>
  :host {
    display: block;
    width: 100%;
    height: 200px;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }
  svg { display: block; width: 100%; height: 100%; overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    :host { transition: none; }
  }
</style>

{#if isEmpty()}
  <svg viewBox={'0 0 ' + width() + ' ' + height()} aria-hidden="true"></svg>
{:else}
  <svg
    viewBox={'0 0 ' + width() + ' ' + height()}
    preserveAspectRatio="none"
    role="img"
    aria-label={label()}>
    {#for b of bars() key={b.id}}
      <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={b.rx} ry={b.ry} fill={b.color}>
        <title>{b.title}</title>
      </rect>
    {/for}
  </svg>
{/if}
