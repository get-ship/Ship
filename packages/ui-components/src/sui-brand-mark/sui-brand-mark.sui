<bundle separate />
<!--
  <sui-brand-mark> — Ship logo, themed via --primary token.

  Inline SVG with solid theme-mixed fills. Recolors per active theme via
  CSS custom properties (`--primary`, `--background`). Same boat/sail
  silhouette as apps/shell/public/ship-logo.svg.
-->

<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    flex: none;
    --ship-mark-size: 28px;
    width: var(--ship-mark-size);
    height: var(--ship-mark-size);
  }
  :host([hidden]) { display: none; }
  :host([size='sm']) { --ship-mark-size: 22px; }
  :host([size='md']) { --ship-mark-size: 28px; }
  :host([size='lg']) { --ship-mark-size: 48px; }

  svg { width: 100%; height: 100%; display: block; }

  .c-base            { fill: color-mix(in oklab, var(--primary, #f59e0b) 10%, var(--background, #fff)); }
  .c-primary         { fill: var(--primary, #f59e0b); }
  .c-primary-dark    { fill: color-mix(in oklab, var(--primary, #f59e0b) 60%, black); }
  .c-primary-darker  { fill: color-mix(in oklab, var(--primary, #f59e0b) 45%, black); }
  .c-primary-deep    { fill: color-mix(in oklab, var(--primary, #f59e0b) 75%, black); }
</style>

