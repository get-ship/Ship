<bundle separate />
<!--
  <sui-brand-mark> — Ship logo, themed via --primary token.

  Renders a primary-tinted rounded square with a white "S" wordmark.
  Same shape as apps/shell/public/favicon.svg so the in-app mark stays
  consistent with the favicon + dock icon.

  Sizes (via size attribute): sm (22px), md (28px, default), lg (48px).
  Color tracks `--primary` from the active theme — no per-instance prop.
-->

<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    flex: none;
    --ship-mark-size: 28px;
    width: var(--ship-mark-size);
    height: var(--ship-mark-size);
  }
  :host([hidden]) { display: none; }
  :host([size='sm']) { --ship-mark-size: 22px; }
  :host([size='md']) { --ship-mark-size: 28px; }
  :host([size='lg']) { --ship-mark-size: 48px; }

  svg { width: 100%; height: 100%; display: block; }
  .bg { fill: var(--primary, #f59e0b); }
  .fg { fill: var(--primary-foreground, #fff); font: 700 18px/1 system-ui, sans-serif; }
  :host([size='sm']) .fg { font-size: 14px; }
  :host([size='lg']) .fg { font-size: 30px; }
</style>

<svg part="svg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect class="bg" width="32" height="32" rx="6" />
  <text class="fg" x="16" y="22" text-anchor="middle">S</text>
</svg>
