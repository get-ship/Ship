<bundle separate />
<!--
  <sui-brand-mark> — Ship logo.

  Loads /ship-logo.svg as an <img>. The simpler `<svg>` inline route runs
  into a sui-compiler bug — element creation defaults to the xhtml
  namespace, so inline <svg>/<path> in templates aren't recognized as
  SVG and don't render. Using <img> sidesteps the compiler entirely.

  TODO: when sui-compiler learns SVG-namespace handling for inline svg
  blocks, switch back to theme-token-fillable inline paths so the logo
  can recolor per active theme.
-->

<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: inline-flex;
    vertical-align: middle;
    flex: none;
    --ship-mark-size: 28px;
    width: var(--ship-mark-size);
    height: var(--ship-mark-size);
  }
  :host([hidden]) { display: none; }
  :host([size='sm']) { --ship-mark-size: 22px; }
  :host([size='md']) { --ship-mark-size: 28px; }
  :host([size='lg']) { --ship-mark-size: 48px; }

  img { width: 100%; height: 100%; display: block; }
</style>

<img part="logo" src="/ship-logo.svg" alt={label()} aria-hidden={label() ? null : 'true'} />
