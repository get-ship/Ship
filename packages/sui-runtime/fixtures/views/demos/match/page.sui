<div class="demo">
  <p class="demo-back"><a href="/demos">← demos</a></p>
  <h1>match</h1>
  <p class="caption">
    Block <code>match expr / case "x" / default</code>. Like a switch
    statement, but only the active branch is mounted.
  </p>

  <!-- NOTE: tried `role="tab"` on these buttons (parent has role="tablist")
       to fix the axe `aria-required-children` violation but the compiler
       silently drops static `role` attrs on elements that also have
       bindings (class:, on:, etc.). Tracked as F-C4. -->
  <div class="demo-tones">
    <button data-test="tone-info"        class:active={tone() === 'info'}        on:click={() => tone.set('info')}>info</button>
    <button data-test="tone-success"     class:active={tone() === 'success'}     on:click={() => tone.set('success')}>success</button>
    <button data-test="tone-warning"     class:active={tone() === 'warning'}     on:click={() => tone.set('warning')}>warning</button>
    <button data-test="tone-destructive" class:active={tone() === 'destructive'} on:click={() => tone.set('destructive')}>destructive</button>
  </div>

  <section class="demo-alert" data-test="alert" data-tone={tone()}>
    {#match tone()}
      {:case 'info'}
        <strong>Heads up.</strong> Just a friendly note.
      {:case 'success'}
        <strong>All good.</strong> The thing finished without errors.
      {:case 'warning'}
        <strong>Careful.</strong> This action may have side-effects.
      {:case 'destructive'}
        <strong>Stop.</strong> This will permanently delete data.
      {:default}
        <em>Pick a tone.</em>
    {/match}
  </section>
</div>
