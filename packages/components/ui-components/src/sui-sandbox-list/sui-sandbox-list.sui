<!--
  <sui-sandbox-list> — surface the daemon's SandboxRegistry state.

  Calls GET /api/v1/sandboxes on mount and renders per-project
  groups: which sandboxes exist, what state each is in, which
  actors are inside, whether backend teardown is wired.

  Props
  ─────────────────────────────────────────────────────────────────────
  auto-fetch (true|false, 'true')
    Default fetches on mount. Set to false for views that pre-load
    via slot/children and just want the layout shell.
  count (number, '0')
    Reflected count of sandboxes loaded. Lets parent views render
    "N sandboxes" badges without re-querying.
-->

<prop name="auto-fetch" values="true|false" default="true" />
<prop name="count" type="string" default="0" reflect />

<style>
  :host {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--foreground);
    border: 1px solid var(--border);
    background: var(--background);
    border-radius: 8px;
    overflow: hidden;
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--muted);
    font-size: 11px;
    color: var(--muted-foreground);
  }
  .summary {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .empty, .loading, .error {
    padding: 16px 12px;
    text-align: center;
    color: var(--muted-foreground);
    font-style: italic;
  }
  .error {
    color: var(--warning);
  }
  .project {
    border-bottom: 1px solid var(--border);
  }
  .project:last-child {
    border-bottom: 0;
  }
  .project-name {
    padding: 8px 12px;
    background: var(--background);
    font-weight: 500;
    font-size: 11px;
    color: var(--muted-foreground);
    border-bottom: 1px solid var(--border);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 8px;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }
  li:last-child {
    border-bottom: 0;
  }
  .name {
    font-weight: 500;
    color: var(--foreground);
  }
  .name .id {
    color: var(--muted-foreground);
    font-size: 10.5px;
    font-family: var(--font-mono);
    margin-left: 6px;
  }
  .tier {
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--muted);
    color: var(--muted-foreground);
  }
  .state {
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .state[data-state="running"] {
    background: var(--tone-success-bg);
    color: var(--success);
    border-color: var(--tone-success-border);
  }
  .state[data-state="idle"] {
    background: var(--tone-warning-bg);
    color: var(--warning);
    border-color: var(--tone-warning-border);
  }
  .state[data-state="reaping"],
  .state[data-state="stopped"] {
    background: var(--muted);
    color: var(--muted-foreground);
  }
  .actors {
    font-size: 10.5px;
    color: var(--muted-foreground);
    text-align: right;
  }
</style>

<div class="header">
  <span class="summary">Sandboxes</span>
  <span data-testid="count">{count() === '0' ? 'none registered' : `${count()} total`}</span>
</div>
<div id="body" data-testid="body"></div>
