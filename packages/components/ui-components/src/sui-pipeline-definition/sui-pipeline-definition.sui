<!--
  <sui-pipeline-definition> — SUI port of <ship-pipeline-definition>.

  Tile for a pipeline YAML definition. Composes <sui-card> interactive +
  accent-bar with a header row (name + step count + optional actions
  slot) and a description body that falls back to a muted "No
  description" line.

  Prop / event / slot parity vs <ship-pipeline-definition>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  name (string, '')            name (string, '',        ✓ reflects
                                  reflect)
  steps (number, 0)            steps (number, 0,        ✓ reflects
                                  reflect)
  description (string, '')     description (string,     ✓ reflects
                                  '', reflect)
  ─────────────────────────────────────────────────────────────────────────────
  role=article + aria-label    controller effect        ✓ recomputed when
    on host                                                name/steps/
                                                           description change
  ─────────────────────────────────────────────────────────────────────────────
  slot: actions                slot: actions            ✓ trailing header
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" reflect />
<prop name="steps" type="number" default="0" reflect />
<prop name="description" type="string" default="" reflect />

<style>
  :host { display: block; }
  :host([hidden]) { display: none; }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .name {
    font-family: var(--heading-font);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .steps {
    font-size: 10.5px;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .desc {
    font-size: 12.5px;
    color: var(--muted-foreground);
    line-height: 1.5;
    min-height: 1.5em;
    margin: 6px 0 0;
  }
  .no-desc { opacity: 0.5; }
  sui-card { display: block; }
</style>

<sui-card interactive accent-bar padding="md">
  <div slot="header">
    <header>
      <span class="name">{name()}</span>
      <span class="steps">{stepsLabel()}</span>
      <slot name="actions"></slot>
    </header>
  </div>
  {#if description()}
    <p class="desc">{description()}</p>
  {:else}
    <p class="desc no-desc">No description</p>
  {/if}
</sui-card>
