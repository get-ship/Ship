<!--
  <sui-theme-toggle> — SUI port of <ship-theme-toggle>.

  Binary toggle between light and dark by flipping the `.dark` class on
  documentElement. Persists the choice in localStorage under
  `ship-theme`. Distinct from <sui-theme-picker>, which exposes the
  full brand palette.

  Prop / event / slot parity vs <ship-theme-toggle>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  theme (light|dark|auto,      theme (enum, 'auto',     ✓ reflects; `auto`
    'auto')                       reflect)                resolves on mount
                                                            to the persisted
                                                            value or
                                                            prefers-color-
                                                            scheme
  ─────────────────────────────────────────────────────────────────────────────
  ship-theme-change            sui-theme-change         renamed per
                                                          convention
  ─────────────────────────────────────────────────────────────────────────────
  default slot label            default slot label      ✓ falls back to
                                                          "Dark" / "Light"
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="theme" values="light|dark|auto" default="auto" reflect />

<style>
  :host { display: inline-flex; }
  :host([hidden]) { display: none; }
</style>

<sui-button
  variant="default"
  size="sm"
  aria-label="Toggle theme"
  attr:aria-pressed={isDark() ? 'true' : 'false'}
  title="Toggle theme"
  on:click={toggle}
>
  <sui-icon slot="leading" name={isDark() ? 'moon' : 'sun'} size="sm"></sui-icon>
  <slot>{isDark() ? 'Dark' : 'Light'}</slot>
</sui-button>
