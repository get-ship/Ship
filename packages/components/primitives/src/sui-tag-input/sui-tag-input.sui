<!--
  <sui-tag-input> — chip-composition input. Type → Enter adds a tag,
  Backspace on an empty input removes the last tag. Pre-existing tags
  arrive via the `value` attribute as a comma-separated string; the
  controller parses on mount + on attribute change.

  Composes <sui-chip removable> for each tag. The chip's built-in
  `ship-remove` event drives the controller's remove handler — we
  don't reimplement chip chrome here.

  Props
  ─────────────────────────────────────────────────────────────────────
  name            (string)  Form field name (form-aware).
  value           (string)  Comma-separated initial value. The
                            controller mirrors the current tag array
                            back into this prop on every change so
                            form-value writes the canonical CSV.
  placeholder     (string)  Native input placeholder.
  disabled        (bool)    Disables input + remove buttons.
  max-tags        (number)  Hard cap; further Enter presses are ignored.
                            `0` disables the cap (default).
  tone            (union)   Tones the focus ring + chip tone.
  size            (union)   sm | md | lg — sizes the input row.
  ─────────────────────────────────────────────────────────────────────
  Events
    sui-change   { detail: { tags: string[] } }
  ─────────────────────────────────────────────────────────────────────
-->

<prop name="name" type="string" default="" />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="max-tags" type="number" default="0" />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    display: inline-flex;
    flex-direction: column;
    width: 100%;
    vertical-align: middle;
    --tone-border: var(--border);
    --tone-ring: var(--primary);
    --h: 34px;
    --fs: 13px;
    --px: 8px;
    --gap: 4px;
  }
  :host([tone='primary'])     { --tone-border: var(--primary);          --tone-ring: var(--primary); }
  :host([tone='info'])        { --tone-border: var(--info);              --tone-ring: var(--info); }
  :host([tone='success'])     { --tone-border: var(--success);           --tone-ring: var(--success); }
  :host([tone='warning'])     { --tone-border: var(--warning);           --tone-ring: var(--warning); }
  :host([tone='destructive']) { --tone-border: var(--destructive);       --tone-ring: var(--destructive); }
  :host([tone='accent'])      { --tone-border: var(--accent);            --tone-ring: var(--accent); }
  :host([tone='muted'])       { --tone-border: var(--muted-foreground);  --tone-ring: var(--muted-foreground); }

  :host([size='sm']) { --h: 28px; --fs: 12px; --px: 6px; }
  :host([size='md']) { --h: 34px; --fs: 13px; --px: 8px; }
  :host([size='lg']) { --h: 40px; --fs: 14px; --px: 10px; }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap);
    min-height: var(--h);
    width: 100%;
    padding: 4px var(--px);
    background: var(--background);
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--tone-ring) 25%, transparent);
  }
  :host([disabled]) .wrap {
    background: var(--muted);
    cursor: not-allowed;
    opacity: 0.65;
  }

  input.entry {
    flex: 1 0 80px;
    min-width: 80px;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0 2px;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
  }
  input.entry::placeholder { color: var(--muted-foreground); }
  input.entry:disabled { cursor: not-allowed; }
</style>

<div class="wrap" part="wrap">
  {#for t of tags() key={t.key}}
    <sui-chip
      data-idx={t.idx}
      tone={tone() === 'default' ? 'muted' : tone()}
      size={size() === 'lg' ? 'md' : 'sm'}
      removable
      disabled={disabled()}
    >{t.label}</sui-chip>
  {/for}
  <input
    class="entry"
    part="input"
    type="text"
    name={name()}
    placeholder={placeholder()}
    disabled={disabled()}
    autocomplete="off"
    bind:value={entryValue}
    bind:this={inputEl}
  />
</div>
