<!--
  <sui-step-segments> — SUI port of <ship-step-segments>.
  Compact row of colored rectangles showing per-step outcome for a
  pipeline run. Used in history rows to summarize N steps at a glance.

  Prop parity vs <ship-step-segments>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                     SUI                         Notes
  ─────────────────────────────────────────────────────────────────────────────
  values (string, '')     values (string, '',          ✓ comma-separated tokens:
                            reflect)                     done|failed|pending|
                                                         running; unknown → pending
  size ('sm'|'md', 'sm')  size (sm|md, 'sm',           ✓
                            reflect)
  ─────────────────────────────────────────────────────────────────────────────
  (no events)             (no events)                  ✓
  ─────────────────────────────────────────────────────────────────────────────
  parts: row, seg         part="row" / part="seg"      ✓
  ─────────────────────────────────────────────────────────────────────────────
  ARIA: role=img +        bound on .row via signals     ✓
    aria-label on .row
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="values" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host { display: inline-flex; vertical-align: middle; }
  :host([hidden]) { display: none; }

  .row { display: inline-flex; gap: 3px; align-items: center; }
  .row:empty { display: none; }

  .seg {
    display: inline-block;
    width: 18px;
    height: 6px;
    border-radius: 2px;
    background: color-mix(in oklch, var(--muted-foreground) 28%, transparent);
  }

  :host([size='sm']) .seg { width: 18px; height: 6px; border-radius: 2px; }
  :host(:not([size])) .seg,
  :host([size='md']) .seg { width: 24px; height: 8px; border-radius: 3px; }
  :host([size='lg']) .seg { width: 32px; height: 10px; border-radius: 4px; }

  .seg[data-state='done']    { background: var(--success); }
  .seg[data-state='failed']  { background: var(--destructive); }
  .seg[data-state='running'] {
    background: var(--warning);
    animation: sui-step-segments-pulse var(--duration-slow, 1200ms) ease-in-out infinite;
  }

  @keyframes sui-step-segments-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.55; }
  }

  @media (prefers-reduced-motion: reduce) {
    .seg[data-state='running'] { animation: none; }
  }
</style>

<span class="row" part="row" role={segments().length > 0 ? 'img' : null} aria-label={ariaLabel()}>
  {#for seg of segments() key={seg.id}}
    <span class="seg" part="seg" data-state={seg.state}></span>
  {/for}
</span>
