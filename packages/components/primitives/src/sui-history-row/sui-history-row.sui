<!--
  <sui-history-row> — SUI port of <ship-history-row>.

  A single row in the git commit history list. Renders a graph-lane SVG
  on the left, an author avatar, the commit subject (split into
  `scope(pkg):` prefix + rest), and +/- stat counters on the right.

  Prop / event / slot parity vs <ship-history-row>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  sha (string, '')             sha (string, '',         ✓ reflects
                                  reflect)
  subject (string, '')         subject (string, '',     ✓ reflects
                                  reflect)
  author (string, '')          author (string, '',      ✓ reflects
                                  reflect)
  timestamp (string, '')       timestamp (string, '',   ✓ reflects
                                  reflect)
  additions (number, 0)        additions (number, 0,    ✓ reflects
                                  reflect)
  deletions (number, 0)        deletions (number, 0,    ✓ reflects
                                  reflect)
  active (bool, false)         active (bool, false,     ✓ reflects
                                  reflect)
  human (bool, false)          human (bool, false,      ✓ reflects
                                  reflect)
  ─────────────────────────────────────────────────────────────────────────────
  role=button + tabindex=0     controller mount         ✓
  keydown (Enter/Space)        controller mount         ✓
  ship-select                  sui-select               renamed per
                                                          convention
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="sha" type="string" default="" reflect />
<prop name="subject" type="string" default="" reflect />
<prop name="author" type="string" default="" reflect />
<prop name="timestamp" type="string" default="" reflect />
<prop name="additions" type="number" default="0" reflect />
<prop name="deletions" type="number" default="0" reflect />
<prop name="active" type="bool" default="false" reflect />
<prop name="human" type="bool" default="false" reflect />

<style>
  :host {
    display: flex;
    align-items: center;
    gap: 0;
    cursor: pointer;
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--duration-fast) ease;
    font-family: var(--font-body);
  }
  :host([hidden]) { display: none; }
  :host(:hover) { background: color-mix(in oklch, var(--muted) 50%, transparent); }
  :host([active]) { background: color-mix(in oklch, var(--primary) 8%, transparent); }

  .lane {
    width: 44px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
  }
  .lane svg { display: block; }

  .avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--primary-foreground);
    background: color-mix(in oklch, var(--primary) 70%, var(--muted));
    text-transform: uppercase;
  }
  :host([human]) .avatar {
    background: conic-gradient(from 40deg, var(--status-blue), var(--accent));
  }

  .msg {
    flex: 1;
    min-width: 0;
    padding: 8px 6px 8px 10px;
  }
  .title {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.35;
  }
  :host([active]) .title { color: var(--primary); }
  .scope { color: var(--primary); opacity: 0.85; }
  .meta {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-foreground);
  }

  .stats {
    display: flex;
    gap: 6px;
    padding-right: 14px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
  }
  .add { color: var(--success); }
  .del { color: var(--destructive); }
</style>

<div class="lane" on:click={emitSelect}>
  <svg width="44" height="46" aria-hidden="true">
    <line x1="22" y1="0" x2="22" y2="46"
      stroke="var(--primary)" stroke-width="1.5" opacity="0.45"></line>
    <circle cx="22" cy="23" r={dotR()}
      fill={active() ? 'var(--primary)' : 'var(--background)'}
      stroke="var(--primary)" stroke-width="2"></circle>
  </svg>
</div>

<div class="avatar">{initial()}</div>

<div class="msg" on:click={emitSelect}>
  <div class="title">
    {#if scopePrefix()}<span class="scope">{scopePrefix()}</span> {/if}{subjectRest()}
  </div>
  <div class="meta">
    <span>{sha()}</span>
    <span>{timestamp()}</span>
  </div>
</div>

<div class="stats">
  {#if additions() > 0}<span class="add">+{additions()}</span>{/if}
  {#if deletions() > 0}<span class="del">−{deletions()}</span>{/if}
</div>
