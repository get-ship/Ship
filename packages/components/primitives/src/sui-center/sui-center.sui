<!--
  <sui-center> — horizontally-centered content column with a capped
  measure.

  Used for reading surfaces (long-form prose, narrow forms, modal
  bodies) where line length must stay readable regardless of the
  viewport. `max` selects one of a small vocabulary of canonical
  measures so views can't accidentally pick a 1640px-wide column.

  Vocabulary:
    prose → 65ch  (long-form reading)
    form  → 28rem (narrow forms, settings pages)
    wide  → 80ch  (looser reading, marketing copy)
    full  → 100%  (escape hatch — pin centering on but disable cap)

  Prop / event / slot
  ─────────────────────────────────────────────────────────────────────
  max     (enum, 'prose')  prose|form|wide|full
  padded  (bool, false)    add var(--space-4) horizontal padding so the
                           content doesn't touch the viewport edges on
                           narrow widths.
  ─────────────────────────────────────────────────────────────────────
  (no events)
  ─────────────────────────────────────────────────────────────────────
  slots: (default)
  parts: (none)
-->

<prop name="max" values="prose|form|wide|full" default="prose" reflect />
<prop name="padded" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    --center-max: 65ch;
    --center-pad: 0;
  }
  :host([hidden]) { display: none; }

  :host([max='prose']) { --center-max: 65ch; }
  :host([max='form'])  { --center-max: 28rem; }
  :host([max='wide'])  { --center-max: 80ch; }
  :host([max='full'])  { --center-max: 100%; }

  :host([padded]) { --center-pad: var(--space-4); }

  .center {
    box-sizing: content-box;
    max-width: var(--center-max);
    margin-inline: auto;
    padding-inline: var(--center-pad);
  }
</style>

<div class="center"><slot></slot></div>
