<!--
  <sui-separator> — SUI port of <ship-separator>.
  Horizontal or vertical visual separator.

  Prop parity vs <ship-separator>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  orientation                  orientation (reflect)    ✓ horizontal|vertical
    'horizontal'|'vertical'
  variant                      variant (reflect)        ✓ solid|dashed
    'solid'|'dashed'
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                  (no events)              ✓
  ─────────────────────────────────────────────────────────────────────────────
  role="separator" set via JS  role="separator" on      ✓ static attr on inner
    on host in render()          inner <hr>               <hr>; host is block
  aria-orientation set on host aria-orientation on hr   ✓
  (none)                       decorative (bool, false) Radix-parity addition —
                                                        when true, role=none and
                                                        aria-orientation dropped
                                                        (purely visual divider,
                                                        invisible to AT).
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                part="sep"               SUI adds part for
                                                        targeted styling
  ─────────────────────────────────────────────────────────────────────────────
  (none)                       tone (union, reflect)    SUI extension — tints
                                                        border color with
                                                        semantic tone; default
                                                        is baseline border
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="orientation" values="horizontal|vertical" default="horizontal" reflect />
<prop name="variant" values="solid|dashed" default="solid" reflect />
<prop name="decorative" type="bool" default="false" reflect />
<prop name="tone" values="default|muted|primary|info|success|warning|destructive|accent" default="default" reflect />

<style>
  :host {
    display: block;
    --tone-bg: var(--border);
  }
  :host([hidden]) { display: none; }
  :host([tone='muted'])       { --tone-bg: color-mix(in oklch, var(--border) 50%, transparent); }
  :host([tone='primary'])     { --tone-bg: color-mix(in oklch, var(--primary) 50%, var(--border)); }
  :host([tone='destructive']) { --tone-bg: color-mix(in oklch, var(--destructive) 50%, var(--border)); }

  .sep {
    border: 0;
    margin: 0;
    padding: 0;
    flex: 0 0 auto;
  }

  /* Horizontal (default) */
  :host(:not([orientation='vertical'])) .sep {
    display: block;
    width: 100%;
    height: 1px;
    margin: 8px 0;
    background: var(--tone-bg);
  }
  :host(:not([orientation='vertical'])[variant='dashed']) .sep {
    background: transparent;
    border-top: 1px dashed var(--tone-bg);
    height: 0;
  }

  /* Vertical */
  :host([orientation='vertical']) {
    display: inline-block;
    align-self: stretch;
  }
  :host([orientation='vertical']) .sep {
    display: inline-block;
    width: 1px;
    min-height: 100%;
    margin: 0 8px;
    background: var(--tone-bg);
  }
  :host([orientation='vertical'][variant='dashed']) .sep {
    background: transparent;
    border-left: 1px dashed var(--tone-bg);
    width: 0;
  }
</style>

<hr class="sep" part="sep"
    role={decorative() ? 'none' : 'separator'}
    aria-orientation={decorative() ? null : orientation()} />
