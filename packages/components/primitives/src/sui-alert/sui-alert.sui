<!--
  <sui-alert> — SUI port of <ship-alert>.
  Inline status banner. Tone-driven surface.

  Prop parity vs <ship-alert>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone ('info'|'success'|      tone (union, reflect)    ✓ same values
    'warning'|'destructive'|
    'muted', 'info')
  dismissible (bool, false)    dismissible (bool,       ✓
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-dismiss                 sui-dismiss               event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: icon, title,          icon, title, (default),  ✓
    (default), actions           actions
  ─────────────────────────────────────────────────────────────────────────────
  role="alert" for             same, reactive           ✓
    warning/destructive;
    role="status" otherwise
  aria-live="assertive" for    same, reactive           ✓
    warning/destructive;
    "polite" otherwise
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                box, close               SUI adds parts
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|info|success|warning|destructive|muted" default="default" reflect />
<prop name="dismissible" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    /* Default tone — neutral "heads-up" banner. The runtime's adopted
     * tones.css sets --tone / --tone-fg per [tone=...] selector; these
     * fallbacks fire when no tone attr is present (the catalog's
     * `default` value). */
    --tone: var(--foreground);
    --tone-fg: var(--foreground);
    --alert-bg: color-mix(in oklch, var(--tone) 8%, var(--background));
    --alert-border: color-mix(in oklch, var(--tone) 25%, transparent);
  }
  :host([hidden]) { display: none; }

  :host([tone='info'])        { --tone: var(--info);             --tone-fg: var(--info); }
  :host([tone='success'])     { --tone: var(--success);          --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning);          --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive);      --tone-fg: var(--destructive); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); }

  .box {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--alert-border);
    background: var(--alert-bg);
    color: var(--tone-fg);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  /* Title + body both speak in tone — the surface carries one voice,
   * not two. Prior split (title=tone-fg, body=foreground) read as
   * mixed signal. Tone-fg defaults to foreground for the default tone,
   * so the unset-tone case still looks neutral. */
  .title { font-weight: 600; color: var(--tone-fg); }
  .body { color: var(--tone-fg); }

  .actions {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }

  .close {
    display: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: 4px;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
    line-height: 1;
    flex-shrink: 0;
  }
  .close svg { width: 100%; height: 100%; display: block; }
  :host([dismissible]) .close {
    display: inline-flex;
  }
  .close:hover {
    background: color-mix(in oklch, var(--tone-fg) 12%, transparent);
  }
  .close:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  ::slotted([slot='icon']) { display: inline-flex; }
</style>

<div class="box"
     part="box"
     role={tone() === 'destructive' || tone() === 'warning' ? 'alert' : 'status'}
     aria-live={tone() === 'destructive' || tone() === 'warning' ? 'assertive' : 'polite'}
     aria-atomic="true">
  <span><slot name="icon"></slot></span>
  <div class="content">
    <div class="title"><slot name="title"></slot></div>
    <div class="body"><slot></slot></div>
    <div class="actions"><slot name="actions"></slot></div>
  </div>
  <button class="close" part="close" type="button" aria-label="Dismiss" bind:this={closeBtn}>
    <svg viewBox="0 0 10 10" aria-hidden="true">
      <path d="M2 2 L8 8 M8 2 L2 8" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" fill="none"/>
    </svg>
  </button>
</div>
