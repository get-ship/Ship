<!--
  <sui-grid> — responsive auto-fit grid.

  Children flow into a CSS grid whose columns auto-fit to a declared
  minimum width. Add more items and the grid grows columns until the
  viewport narrows, then collapses gracefully to fewer columns. The
  classic Every Layout grid pattern.

  `min` is a CSS length (e.g. `220px`, `16rem`). It's not enum-typed
  because real layouts use a wide range of minimums and forcing a
  vocabulary here is more friction than benefit. Authors who need
  token-derived widths can still reference them: `min="var(--width-card)"`.

  Prop / event / slot
  ─────────────────────────────────────────────────────────────────────
  gap (enum, '4')   1..8 → var(--space-N).
  min (string, '14rem') CSS length per column min.
  ─────────────────────────────────────────────────────────────────────
  (no events)
  ─────────────────────────────────────────────────────────────────────
  slots: (default)
  parts: (none)
-->

<prop name="gap" values="0|1|2|3|4|5|6|7|8" default="4" reflect />
<prop name="min" type="string" default="14rem" reflect />

<style>
  :host {
    display: block;
    --grid-gap: var(--space-4);
    --grid-min: 14rem;
  }
  :host([hidden]) { display: none; }

  :host([gap='0']) { --grid-gap: 0; }
  :host([gap='1']) { --grid-gap: var(--space-1); }
  :host([gap='2']) { --grid-gap: var(--space-2); }
  :host([gap='3']) { --grid-gap: var(--space-3); }
  :host([gap='4']) { --grid-gap: var(--space-4); }
  :host([gap='5']) { --grid-gap: var(--space-5); }
  :host([gap='6']) { --grid-gap: var(--space-6); }
  :host([gap='7']) { --grid-gap: var(--space-7); }
  :host([gap='8']) { --grid-gap: var(--space-8); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-min)), 1fr));
    gap: var(--grid-gap);
  }
</style>

<div class="grid" style:--grid-min={min()}><slot></slot></div>
