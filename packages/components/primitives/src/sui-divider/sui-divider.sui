<!--
  <sui-divider> — SUI port of <ship-separator>.
  Horizontal or vertical visual separator. Named "divider" in SUI per the
  component catalog convention; Lit uses "separator" (from ARIA role).

  Prop / event / method parity vs <ship-separator>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                               SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  orientation ('horizontal',        orientation (union,      ✓
    'horizontal'|'vertical')          reflect)
  variant ('solid'|'dashed',        variant (union, reflect) ✓
    'solid')
  ─────────────────────────────────────────────────────────────────────────────
  (no events)                       (no events)             ✓
  ─────────────────────────────────────────────────────────────────────────────
  role="separator" set via JS       role="separator" on      ✓ static attr on
    on host in render()             inner <hr>               inner element;
                                                             host is block
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                     part="line"             SUI adds part for
                                                            targeted styling
  ─────────────────────────────────────────────────────────────────────────────
  tone prop                         ADDED                   SUI extension —
                                                            tints border color
                                                            with semantic tone;
                                                            not in Lit original
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="orientation" values="horizontal|vertical" default="horizontal" reflect />
<prop name="variant" values="solid|dashed" default="solid" reflect />
<prop name="tone" values="default|muted|primary|info|success|warning|destructive|accent" default="default" reflect />

<style>
  :host {
    display: block;
    --tone-bg: var(--border);
  }
  :host([tone='muted'])       { --tone-bg: color-mix(in oklch, var(--border) 50%, transparent); }
  :host([tone='primary'])     { --tone-bg: color-mix(in oklch, var(--primary) 50%, var(--border)); }
  :host([tone='destructive']) { --tone-bg: color-mix(in oklch, var(--destructive) 50%, var(--border)); }

  .line {
    border: 0;
  }

  /* Horizontal — full-width 1px line. */
  :host(:not([orientation='vertical'])) .line {
    width: 100%;
    height: 1px;
    margin: var(--space-2) 0;
    background: var(--tone-bg);
  }
  :host(:not([orientation='vertical'])[variant='dashed']) .line {
    background: transparent;
    border-top: 1px dashed var(--tone-bg);
    height: 0;
  }

  /* Vertical — inline 1px line that stretches to parent height. */
  :host([orientation='vertical']) {
    display: inline-block;
    vertical-align: middle;
    align-self: stretch;
  }
  :host([orientation='vertical']) .line {
    width: 1px;
    height: 1em;
    margin: 0 var(--space-2);
    display: inline-block;
    background: var(--tone-bg);
  }
  :host([orientation='vertical'][variant='dashed']) .line {
    background: transparent;
    border-left: 1px dashed var(--tone-bg);
    width: 0;
  }
</style>

<hr class="line" part="line" role="separator" aria-orientation={orientation()}></hr>
