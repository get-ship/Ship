<!--
  <sui-dropdown-menu> — SUI port of <ship-dropdown-menu>.
  Trigger-anchored menu using the native popover API for top-layer rendering,
  light-dismiss, and ESC. Adds ARIA role=menu/menuitem and roving tabindex.

  Prop / event / method parity vs <ship-dropdown-menu>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-select          sui-select { detail:{value}} ✓ renamed
  Slots: trigger, (default)    trigger, (default)           ✓
  Parts: (none)                panel                        ✓
  ARIA: role=menu on panel,    controller sets role,        ✓
    role=menuitem + tabindex     menuitem + roving tabindex
  Keyboard: ↑↓ Home/End        ✓                           ✓
    Enter/Space activate        ✓                           ✓
    Typeahead (first char)      ✓                           ✓
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />

<style>
  :host { position: relative; display: inline-flex; }
  :host([hidden]) { display: none; }

  .panel {
    inset: auto;
    margin: 0;
    min-width: 160px;
    padding: 4px;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius, var(--radius-md, 6px));
    box-shadow: var(--shadow-lg, 0 8px 24px color-mix(in oklch, var(--foreground) 12%, transparent));
    display: flex; flex-direction: column;
    font-family: var(--font-body, system-ui);
    font-size: var(--text-base, 14px);
    opacity: 0;
    transform: translateY(-4px) scale(0.97);
    transition:
      opacity var(--duration-medium, 200ms) var(--ease-out, ease-out),
      transform var(--duration-medium, 200ms) var(--ease-out, ease-out);
  }
  .panel:popover-open {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .panel::backdrop { background: transparent; }

  ::slotted(button), ::slotted([role='menuitem']) {
    text-align: left;
    background: transparent; border: 0;
    padding: 6px 10px;
    border-radius: var(--radius-sm, 4px);
    color: inherit; font: inherit;
    cursor: pointer; width: 100%;
    transition: background-color var(--duration-fast, 120ms) var(--ease-out, ease-out);
  }
  ::slotted(button:hover), ::slotted([role='menuitem']:hover),
  ::slotted(button:focus-visible), ::slotted([role='menuitem']:focus-visible) {
    background: var(--accent);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel { transition: none; transform: none !important; }
  }
  @media (forced-colors: active) {
    .panel { border: 1px solid CanvasText; }
  }
</style>

<span class="trigger-wrap" bind:this={triggerWrap}>
  <slot name="trigger" bind:this={triggerSlot}></slot>
</span>
<div class="panel" part="panel" popover="auto" role="menu" bind:this={panelEl}>
  <slot bind:this={itemSlot}></slot>
</div>
