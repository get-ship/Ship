<!--
  <sui-kbd> — SUI port of <ship-kbd>.
  Keyboard shortcut display. Renders a single styled <kbd> element.

  Prop / event / method parity vs <ship-kbd>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  keys (String, '')               keys (string, '')       ✓ drives role=group +
                                                          aria-label on host;
                                                          auto-split rendering
                                                          (Cmd+K) deferred —
                                                          caller places content
                                                          via slot
  ─────────────────────────────────────────────────────────────────────────────
  size prop (not in Lit)          size ('sm'|'md',        SUI addition for
                                    reflect)               size-channel control
  ─────────────────────────────────────────────────────────────────────────────
  role="group" aria-label set     ✓ controller sets       ✓ matches Lit:
    via updated() on host          on host                "Keyboard shortcut: X"
  ─────────────────────────────────────────────────────────────────────────────
  parts: key (per <kbd>)          part="kbd"              single element
  ─────────────────────────────────────────────────────────────────────────────
  Lit MONO font stack (hardcoded) var(--font-mono)        uses design token
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="keys" type="string" default="" />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    vertical-align: baseline;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    padding: 2px 5px;
    font-family: var(--font-mono);
    font-weight: var(--font-weight-medium, 500);
    font-size: var(--text-xs);
    line-height: 1.2;
    color: var(--foreground);
    background: var(--muted);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-xs);
    white-space: nowrap;
  }

  :host([size='sm']) kbd { font-size: var(--text-xs); padding: 1px 4px; min-width: 16px; }
  :host([size='md']) kbd { font-size: var(--text-xs); padding: 2px 5px; min-width: 18px; }
  :host([size='lg']) kbd { font-size: var(--text-sm); padding: 3px 7px; min-width: 22px; }
</style>

<kbd part="kbd"><slot></slot></kbd>
