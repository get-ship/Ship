<!--
  <sui-viewer> — the content-renderer DISPATCHER (Backbone #1).

  Reads a resolved source (via `prop:src` identity OR the `content-type` /
  `filename` / `text` SSR fallback props), resolves the renderer through the
  pure `createMimeRegistry()` engine, and renders the matching child via
  `{#match kind()}`. Adding a content type is ONE registry entry — never an
  edit here. The dispatcher is thin: state (the resolved descriptor + which
  renderer wins) lives in the engine; the controller is glue.

  Read-only, source-in-never-fetch: no `fetch`/`EventSource`/`ship.*`. The host
  resolves the bytes/text; the dispatcher only inspects + routes.

  Props (build-spec §Props):
    content-type  string  reflect  — SSR/declarative type hint (prop:src.contentType supersedes)
    filename      string  reflect  — extension fallback for detection
    text          string           — text-content fallback (prop:src.text supersedes)
    src           prop:src identity only — NOT a <prop> (the live ViewerSource/Blob/url)

  Events (re-emitted from the active child, ViewerRenderer contract):
    sui-viewer-load            — first successful render
    sui-viewer-error {message} — parse/decode failure (one host listener catches any renderer)

  Slots: toolbar (above the renderer), download (forwarded into the unsupported
  empty-state's action slot), empty (override the default empty-state).
  A11y: host carries role=region; [data-viewer-loading] reflects active load.
-->

<prop name="content-type" type="string" default="" reflect />
<prop name="filename" type="string" default="" reflect />
<prop name="text" type="string" default="" />

<style>
  :host {
    display: block;
    width: 100%;
    color: var(--foreground);
  }
  :host([hidden]) { display: none; }

  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .toolbar:empty { display: none; }
</style>

<div class="toolbar" part="toolbar"><slot name="toolbar"></slot></div>

{#match kind()}
  {:case 'pdf'}      <sui-viewer-pdf prop:src={source()}></sui-viewer-pdf>
  {:case 'image'}    <sui-viewer-image prop:src={source()}></sui-viewer-image>
  {:case 'media'}    <sui-viewer-media prop:src={source()}></sui-viewer-media>
  {:case 'tabular'}  <sui-viewer-csv prop:src={source()}></sui-viewer-csv>
  {:case 'markdown'} <sui-markdown prop:value={textValue()}></sui-markdown>
  {:case 'code'}     <sui-code block prop:lang={lang()}>{textValue()}</sui-code>
  {:case 'json'}     <sui-json-view prop:data={textValue()}></sui-json-view>
  {:case 'diff'}     <sui-diff prop:value={textValue()} prop:from={from()} prop:to={to()}></sui-diff>
  {:default}
    <sui-empty-state variant="placeholder" part="empty">
      <span slot="title">No preview</span>
      {unsupportedMsg()}
      <slot name="download" slot="action"></slot>
    </sui-empty-state>
{/match}
