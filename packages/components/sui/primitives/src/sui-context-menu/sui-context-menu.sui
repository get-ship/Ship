<!--
  <sui-context-menu> — SUI port of <ship-context-menu>.
  Right-click triggered overlay menu. Uses the native popover API
  (popover="auto") for top-layer rendering and light-dismiss.
  The panel is positioned at the cursor coordinates, not anchored.

  Prop / event / method parity vs <ship-context-menu>
  ────────────────────────────────────────────────────────────────────────
  Lit                          SUI                          Notes
  ────────────────────────────────────────────────────────────────────────
  open (bool, false)           open (bool, false, reflect)  ✓
  ────────────────────────────────────────────────────────────────────────
  Events: ship-select          sui-select { detail:{value}} ✓ renamed
          ship-open/close      sui-open/close               ✓ renamed
  Methods: show(x,y), close()  show(x,y), close()          ✓
  Slots: trigger, (default)    trigger, (default)           ✓
  Parts: menu                  panel                        ✓
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="open" type="bool" default="false" reflect />

<style>
  :host { display: contents; }
  :host([hidden]) { display: none; }

  .panel {
    inset: auto;
    margin: 0;
    min-width: 210px;
    padding: 5px;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg), inset 0 1px 0 color-mix(in oklch, var(--background) 40%, transparent);
    display: flex; flex-direction: column;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity var(--duration-fast) var(--ease-out, ease-out),
      transform var(--duration-fast) var(--ease-out, ease-out);
  }
  .panel:popover-open {
    opacity: 1;
    transform: scale(1);
  }
  .panel::backdrop { background: transparent; }

  ::slotted(button), ::slotted([role='menuitem']) {
    display: flex; align-items: center; gap: 10px;
    text-align: start;
    background: transparent; border: 0;
    padding: 7px 9px;
    border-radius: var(--radius-sm);
    color: inherit; font: inherit;
    cursor: pointer; width: 100%;
    transition: background-color var(--duration-fast) var(--ease-out, ease-out), color var(--duration-fast) var(--ease-out, ease-out);
  }
  ::slotted(button:hover), ::slotted([role='menuitem']:hover),
  ::slotted(button:focus-visible), ::slotted([role='menuitem']:focus-visible) {
    background: var(--muted);
    outline: none;
  }
  ::slotted(button[data-tone='destructive']) { color: var(--destructive); }
  ::slotted(button[data-tone='destructive']:hover) { background: var(--tone-destructive-bg); }
  ::slotted(hr) { height: 1px; border: 0; background: var(--border-subtle); margin: 5px 4px; }
  ::slotted([data-section]) { font-size: var(--text-xs); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted-foreground); padding: 6px 9px 3px; }

  @media (prefers-reduced-motion: reduce) {
    .panel { transition: none; transform: none !important; }
  }
  @media (forced-colors: active) {
    .panel { border: 1px solid CanvasText; }
  }
</style>

<slot name="trigger" bind:this={triggerSlot}></slot>
<div class="panel" part="panel" popover="auto" role="menu" aria-label="Context menu" bind:this={panelEl}>
  <slot bind:this={itemSlot}></slot>
</div>
