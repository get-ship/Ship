<!--
  <sui-toggle> — child element of <sui-toggle-group> or standalone.
  Pressed/unpressed button that participates in single or multiple selection.

  Prop parity vs <ship-toggle>
  ────────────────────────────────────────────────────────────────────────
  pressed (bool, false)             ✓ reflect
  disabled (bool, false)            ✓ reflect
  value (string, '')                ✓ reflect — identifier for group selection
  size (sm|md|lg, 'md')             ✓ reflect
  variant (outline|ghost, 'outline') ✓ reflect
  ────────────────────────────────────────────────────────────────────────
  Events: ship-toggle → sui-toggle { detail: { pressed, value } }
  ────────────────────────────────────────────────────────────────────────
  Slots: (default) — button content
  Parts: button
-->

<prop name="pressed" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="value" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="variant" values="outline|ghost|segmented" default="outline" reflect />

<style>
  :host { display: inline-flex; }
  :host([hidden]) { display: none; }

  :host(:not([size])), :host([size='md']) {
    --tgl-h: 36px; --tgl-px: 12px; --tgl-fs: var(--text-base, 14px);
  }
  :host([size='sm']) {
    --tgl-h: 28px; --tgl-px: 8px; --tgl-fs: var(--text-sm, 13px);
  }
  :host([size='lg']) {
    --tgl-h: 42px; --tgl-px: 16px; --tgl-fs: var(--text-base, 14px);
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: var(--tgl-h);
    padding: 0 var(--tgl-px);
    font-family: var(--font-body);
    font-size: var(--tgl-fs);
    font-weight: var(--font-weight-medium, 500);
    line-height: 1;
    color: var(--muted-foreground);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius, 6px);
    cursor: pointer;
    transition:
      background-color var(--duration-fast, 150ms) var(--ease-out, ease-out),
      color var(--duration-fast, 150ms) var(--ease-out, ease-out),
      border-color var(--duration-fast, 150ms) var(--ease-out, ease-out);
  }
  :host([variant='ghost']) button { border-color: transparent; }
  button:hover { background: var(--muted); color: var(--foreground); }
  :host([pressed]) button {
    background: var(--muted);
    color: var(--foreground);
    border-color: var(--border);
  }
  :host([disabled]) button {
    cursor: not-allowed;
    color: var(--muted-foreground);
    filter: saturate(0.4);
    pointer-events: none;
  }

  button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  :host([variant='segmented']) button {
    border: 0;
    border-radius: var(--radius-sm, 4px);
    color: var(--muted-foreground);
  }
  :host([variant='segmented']:not([size])) button,
  :host([variant='segmented'][size='md']) button {
    height: auto;
    padding: 5px var(--space-3, 12px);
    font-size: var(--text-sm, 13px);
  }
  :host([variant='segmented'][size='sm']) button {
    height: auto;
    padding: 4px var(--space-2, 8px);
    font-size: var(--text-xs, 11px);
  }
  :host([variant='segmented'][size='lg']) button {
    height: auto;
    padding: 8px var(--space-4, 16px);
    font-size: var(--text-md, 14px);
  }
  :host([variant='segmented']) button:hover {
    background: color-mix(in oklch, var(--card) 50%, transparent);
    color: var(--foreground);
  }
  :host([variant='segmented'][pressed]) button {
    background: var(--card);
    color: var(--foreground);
    box-shadow: var(--shadow-xs);
    border: 0;
  }

  @media (forced-colors: active) {
    button:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
    :host([pressed]) button { outline: 2px solid CanvasText; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<button
  part="button"
  type="button"
  aria-pressed={pressed() ? 'true' : 'false'}
  disabled={disabled()}
  bind:this={buttonEl}
>
  <slot></slot>
</button>
