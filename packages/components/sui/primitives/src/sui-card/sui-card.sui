<!--
  <sui-card> — SUI port of <ship-card>.
  Generic container surface with header/content/footer slots, interactive
  hover lift, tone-tinted borders, status rail, and accent bar.

  Prop / event / method parity vs <ship-card>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone (Tone, undefined)       tone (union, reflect)    ✓ tints border,
                                                         status-rail, fill wash
  variant ('default'|         variant (default|         ✓ SUI aligns to Lit
    'outline', 'default')       outline, 'default',      values; drops ghost
                                reflect)                 (use outline instead)
  padding ('none'|'sm'|'md'|  padding (none|sm|md|lg,  ✓
    'lg', 'md')                 'md', reflect)
  interactive (Boolean, false) interactive (bool,       ✓ CSS hover lift +
                                false, reflect)          cursor, role=button,
                                                         tabindex=0, Enter/Space
                                                         → click via controller.
  accent-bar (Boolean, false)  accent-bar (bool,        ✓ gradient top-bar
                                false, reflect)          that fades in on hover
  status-rail (Boolean, false) status-rail (bool,       ✓ 3px left border
                                false, reflect)          tinted by tone
  fill (Boolean, false)        fill (bool, false,       ✓ tone-tinted bg wash
                                reflect)
  ─────────────────────────────────────────────────────────────────────────────
  Keyboard: Enter/Space click  ✓ controller handles     ✓
    on host when interactive
  role=button / tabindex=0     ✓ controller sets on     ✓
    set on host                  mount / effect
  ─────────────────────────────────────────────────────────────────────────────
  syncFilled (slotchange →     reflect-empty=           ✓ SUI reflect-empty
    data-filled on wrapper)     "data-no-header",        sets host attr when
                                "data-no-footer"         slot is empty; CSS
                                                         hides separator +
                                                         wrapper accordingly.
  ─────────────────────────────────────────────────────────────────────────────
  slots: header, default,      slots: header, default,  ✓
    footer                       footer
  ─────────────────────────────────────────────────────────────────────────────
  parts: header, content,      parts: header, content,  ✓
    footer                       footer
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="default|outline" default="default" reflect />
<prop name="padding" values="none|sm|md|lg" default="md" reflect />
<prop name="interactive" type="bool" default="false" reflect />
<prop name="accent-bar" values="off|hover|static" default="off" reflect />
<prop name="status-rail" type="bool" default="false" reflect />
<prop name="fill" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    position: relative;
    background: var(--card);
    color: var(--card-foreground);
    border: 1px solid var(--border);
    --card-radius: var(--radius-lg);
    border-radius: var(--card-radius);
    overflow: clip;
    box-shadow: var(--shadow-card-rest);
    --card-px: 20px;
    --card-py: 16px;
    --card-gap: var(--space-3, 12px);
    --tone-fg: var(--foreground);
    --tone-border: var(--border);
    --tone-bg: transparent;
    padding: var(--card-py) var(--card-px);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }

  :host([tone='primary'])     { --tone-fg: var(--primary);     --tone-border: color-mix(in oklch, var(--primary) 40%, var(--border));     --tone-bg: color-mix(in oklch, var(--primary) 8%, var(--card)); }
  :host([tone='info'])        { --tone-fg: var(--info);        --tone-border: color-mix(in oklch, var(--info) 40%, var(--border));        --tone-bg: color-mix(in oklch, var(--info) 8%, var(--card)); }
  :host([tone='success'])     { --tone-fg: var(--success);     --tone-border: color-mix(in oklch, var(--success) 40%, var(--border));     --tone-bg: color-mix(in oklch, var(--success) 8%, var(--card)); }
  :host([tone='warning'])     { --tone-fg: var(--warning);     --tone-border: color-mix(in oklch, var(--warning) 40%, var(--border));     --tone-bg: color-mix(in oklch, var(--warning) 8%, var(--card)); }
  :host([tone='destructive']) { --tone-fg: var(--destructive); --tone-border: color-mix(in oklch, var(--destructive) 40%, var(--border)); --tone-bg: color-mix(in oklch, var(--destructive) 8%, var(--card)); }
  :host([tone='accent'])      { --tone-fg: var(--accent);      --tone-border: color-mix(in oklch, var(--accent) 40%, var(--border));      --tone-bg: color-mix(in oklch, var(--accent) 8%, var(--card)); }
  :host([tone='muted'])       { --tone-border: var(--border); --tone-bg: var(--muted); }

  :host([tone]:not([tone='default'])) { border-color: var(--tone-border); }
  :host([fill]) { background: var(--tone-bg); border-color: var(--tone-border); }

  :host([padding='none']) { --card-px: 0px; --card-py: 0px; --card-gap: 0px; padding: 0; }
  :host([padding='sm'])   { --card-px: 12px; --card-py: 10px; --card-gap: 8px; padding: 10px 12px; }
  :host([padding='md'])   { --card-px: 20px; --card-py: 16px; padding: 16px 20px; }
  :host([padding='lg'])   { --card-px: 28px; --card-py: 24px; --card-gap: 16px; padding: 24px 28px; }

  :host([variant='outline']) { background: transparent; box-shadow: none; }

  /* Tone-rail. The rail is only meaningful when a tone is explicitly set
   * — otherwise --tone-fg resolves to --foreground and we'd draw a
   * 3-px body-text-coloured stripe (meaningless decoration with the
   * weight of an emphasis cue). Default tone hides the rail. */
  :host([status-rail]) {
    border-left: 3px solid var(--tone-fg);
    padding-inline-start: calc(var(--card-px) - 3px);
  }
  :host([status-rail]:not([tone])),
  :host([status-rail][tone='default']) {
    border-left-color: var(--border-strong);
  }

  /* Accent bar. Two modes:
   *   hover  — fades in on hover (the default, preserves prior behaviour
   *            on interactive cards).
   *   static — always-visible at full opacity (right for hero cards,
   *            print exports, touch contexts where hover never fires).
   * Bar clips to the card's border-radius via inherit/match — when
   * `padding="none"` flattens the card, the bar still respects the
   * top-corner radius via the same token. */
  :host([accent-bar='hover'])::before,
  :host([accent-bar='static'])::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    opacity: 0;
    border-radius: var(--card-radius) var(--card-radius) 0 0;
    transition: opacity var(--duration-medium) var(--ease-out);
    pointer-events: none;
  }
  :host([accent-bar='hover']:hover)::before { opacity: 1; }
  :host([accent-bar='static'])::before { opacity: 1; }

  :host([interactive]) { cursor: pointer; -webkit-tap-highlight-color: transparent; }
  :host([interactive]:hover) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-hover);
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    :host([interactive]:hover) { transform: none; }
  }
  :host([interactive]:active) {
    box-shadow: var(--shadow-card-rest);
    transform: translateY(0);
    transition-duration: 60ms;
  }
  :host([interactive]:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .header, .footer { display: block; }

  /* Separator — show only when slot has projected content */
  :host(:not([data-no-header])) .header {
    margin: calc(var(--card-py) * -1) calc(var(--card-px) * -1) var(--card-gap);
    padding: var(--card-py) var(--card-px);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--heading-font);
    font-weight: var(--heading-weight, 600);
  }
  :host(:not([data-no-footer])) .footer {
    margin: var(--card-gap) calc(var(--card-px) * -1) calc(var(--card-py) * -1);
    padding: var(--card-py) var(--card-px);
    border-top: 1px solid var(--border-subtle);
  }
  :host([padding='none']:not([data-no-header])) .header {
    margin: 0 0 var(--space-3, 12px);
    padding: 0 0 var(--space-3, 12px);
  }
  :host([padding='none']:not([data-no-footer])) .footer {
    margin: var(--space-3, 12px) 0 0;
    padding: var(--space-3, 12px) 0 0;
  }

  @media (forced-colors: active) {
    :host([interactive]:focus-visible) { outline: 2px solid CanvasText; outline-offset: 2px; }
  }
</style>

<div class="header" part="header">
  <slot name="header" reflect-empty="data-no-header"></slot>
</div>
<div class="content" part="content">
  <slot></slot>
</div>
<div class="footer" part="footer">
  <slot name="footer" reflect-empty="data-no-footer"></slot>
</div>
