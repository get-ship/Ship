<!--
  <sui-alert> — SUI port of <ship-alert>.
  Inline status banner. Tone-driven surface.

  Prop parity vs <ship-alert>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  tone ('info'|'success'|      tone (union, reflect)    ✓ same values
    'warning'|'destructive'|
    'muted', 'info')
  dismissible (bool, false)    dismissible (bool,       ✓
                                 reflect)
  ─────────────────────────────────────────────────────────────────────────────
  ship-dismiss                 sui-dismiss               event renamed
  ─────────────────────────────────────────────────────────────────────────────
  slots: icon, title,          icon, title, (default),  ✓
    (default), actions           actions
  ─────────────────────────────────────────────────────────────────────────────
  role="alert" for             same, reactive           ✓
    warning/destructive;
    role="status" otherwise
  aria-live="assertive" for    same, reactive           ✓
    warning/destructive;
    "polite" otherwise
  ─────────────────────────────────────────────────────────────────────────────
  parts: (none)                box, close               SUI adds parts
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="tone" values="default|info|success|warning|destructive|muted" default="default" reflect />
<prop name="dismissible" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    --tone: var(--foreground);
    --tone-fg: var(--foreground);
    --tone-bg: color-mix(in oklch, var(--foreground) 10%, transparent);
  }
  :host([hidden]) { display: none; }

  :host([tone='info'])        { --tone: var(--info);             --tone-fg: var(--info);             --tone-bg: var(--tone-info-bg); }
  :host([tone='success'])     { --tone: var(--success);          --tone-fg: var(--tone-success-fg);  --tone-bg: var(--tone-success-bg); }
  :host([tone='warning'])     { --tone: var(--warning);          --tone-fg: var(--tone-warning-fg);  --tone-bg: var(--tone-warning-bg); }
  :host([tone='destructive']) { --tone: var(--destructive);      --tone-fg: var(--destructive);      --tone-bg: var(--tone-destructive-bg); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); --tone-bg: var(--muted); }
  :host([tone='default'])     { --tone: var(--foreground);       --tone-fg: var(--foreground);       --tone-bg: color-mix(in oklch, var(--foreground) 10%, transparent); }

  .box {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 11px;
    padding: 12px 14px 12px 18px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--card);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    box-shadow: var(--shadow-xs);
  }
  .box::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--tone);
  }

  .ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--tone-bg);
    color: var(--tone-fg);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .title { font-weight: 600; color: var(--foreground); }
  .body { color: var(--muted-foreground); }

  .actions {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .close {
    display: none;
    background: transparent;
    border: 0;
    color: var(--muted-foreground);
    cursor: pointer;
    font-size: 15px;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  :host([dismissible]) .close {
    display: inline-flex;
  }
  .close:hover {
    background: var(--tone-bg);
    color: var(--tone-fg);
  }
  .close:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  ::slotted([slot='icon']) { display: inline-flex; width: 15px; height: 15px; }
</style>

<div class="box"
     part="box"
     role={tone() === 'destructive' || tone() === 'warning' ? 'alert' : 'status'}
     aria-live={tone() === 'destructive' || tone() === 'warning' ? 'assertive' : 'polite'}
     aria-atomic="true">
  <span class="ico"><slot name="icon"></slot></span>
  <div class="content">
    <div class="title"><slot name="title"></slot></div>
    <div class="body"><slot></slot></div>
    <div class="actions"><slot name="actions"></slot></div>
  </div>
  <button class="close" part="close" type="button" aria-label="Dismiss" bind:this={closeBtn}>
    <svg viewBox="0 0 10 10" aria-hidden="true">
      <path d="M2 2 L8 8 M8 2 L2 8" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" fill="none"/>
    </svg>
  </button>
</div>
