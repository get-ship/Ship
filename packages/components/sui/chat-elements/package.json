{
  "name": "@ship/sui-chat-elements",
  "version": "0.1.0",
  "description": "SUI Chat Elements — unbound multi-modal chat-shape primitives (message · message-list · composer · thinking-dots · tool-call · citation). Pure framework tier: no Ship runtime, no SDK reads. Consumers bind their own data.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts",
    "./bundle": "./dist/sui-chat-elements.js"
  },
  "scripts": {
    "build": "sui-build",
    "pretest": "sui-build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sui-runtime": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/sui-build": "workspace:*",
    "@ship/primitives": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
