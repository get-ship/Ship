<!--
  <sui-pipeline-step> — one pipeline step, standalone. Embeddable inline or
  inside a DAG/run. Type-coloured accent + kind label, optional state chip,
  sub line, and consume→produce artifact chips.

  Props:  type (agent|gate|merge|human) · state (ok|running|awaiting|err|none) · compact
  Slots:  default = step id/title · sub = sub line · arts = artifact chips
  Parts:  step · accent · kind · chip
-->
<prop name="type" values="agent|gate|merge|human" default="agent" reflect />
<prop name="state" values="ok|running|awaiting|err|none" default="none" reflect />
<prop name="compact" type="bool" default="false" reflect />

<style>
  /* Locked pack taxonomy — step-type hues, shared across every @ship/pipelines
     primitive. Pack-scoped channels (not general design tokens). */
  :host {
    display: block;
    --type-agent: oklch(0.6 0.18 35);
    --type-gate:  oklch(0.6 0.16 260);
    --type-merge: oklch(0.55 0.13 145);
    --type-human: oklch(0.6 0.18 305);
    --type: var(--foreground);
    --state: var(--muted-foreground);
  }
  :host([hidden]) { display: none; }

  :host([type='agent']) { --type: var(--type-agent); }
  :host([type='gate'])  { --type: var(--type-gate); }
  :host([type='merge']) { --type: var(--type-merge); }
  :host([type='human']) { --type: var(--type-human); }

  /* State maps to existing design tokens. */
  :host([state='ok'])       { --state: var(--success); }
  :host([state='running'])  { --state: var(--info); }
  :host([state='awaiting']) { --state: var(--warning); }
  :host([state='err'])      { --state: var(--destructive); }

  .step {
    background: var(--background); border: 1px solid var(--border);
    border-radius: var(--radius-md); padding: 10px 12px;
  }
  :host([state='awaiting']) .step {
    background: color-mix(in oklch, var(--warning) 6%, var(--background));
    border-color: color-mix(in oklch, var(--warning) 35%, var(--border));
  }
  .row { display: flex; align-items: flex-start; gap: 10px; }
  :host([compact]) .row { align-items: center; }

  .accent { width: 3px; height: 38px; border-radius: 2px; background: var(--type); flex-shrink: 0; }
  :host([compact]) .accent { height: 24px; }

  .content { flex: 1; min-width: 0; }
  .meta { display: flex; align-items: baseline; gap: 8px; }

  .kind {
    font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--type);
  }
  :host([type='agent']) .kind::before { content: 'agent'; }
  :host([type='gate'])  .kind::before { content: 'gate'; }
  :host([type='merge']) .kind::before { content: 'merge'; }
  :host([type='human']) .kind::before { content: 'human'; }

  .id { font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; color: var(--foreground); }

  .chip {
    display: none; align-items: center; gap: 5px; margin-left: auto;
    font-family: var(--font-mono); font-size: 10px; padding: 1px 7px;
    border-radius: var(--radius-full); border: 1px solid;
    text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;
    color: var(--state); border-color: color-mix(in oklch, var(--state) 35%, transparent);
  }
  :host(:not([state='none'])) .chip { display: inline-flex; }
  .chip::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  :host([state='ok'])       .chip::after { content: 'ok'; }
  :host([state='running'])  .chip::after { content: 'running'; }
  :host([state='awaiting']) .chip::after { content: 'review'; }
  :host([state='err'])      .chip::after { content: 'err'; }
  :host([state='running']) .chip::before,
  :host([state='awaiting']) .chip::before { animation: pl-pulse 1.6s ease-in-out infinite; }
  @keyframes pl-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .sub { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); margin-top: 3px; }
  .sub:not(:has(::slotted(*))) { display: none; }

  .arts { display: flex; gap: 6px; margin-top: 10px; font-family: var(--font-mono); font-size: 9.5px; align-items: center; }
  .arts:not(:has(::slotted(*))) { display: none; }
</style>

<div class="step" part="step">
  <div class="row">
    <span class="accent" part="accent"></span>
    <div class="content">
      <div class="meta">
        <span class="kind" part="kind"></span>
        <span class="id"><slot></slot></span>
        <span class="chip" part="chip"></span>
      </div>
      <div class="sub"><slot name="sub"></slot></div>
      <div class="arts"><slot name="arts"></slot></div>
    </div>
  </div>
</div>
