<!--
  <sui-pipeline-history> — past-runs strip. A summary line over a horizontal
  strip of run pills (tone-coded per state, click any to open). Run pills are
  slotted so the host owns the layout + the consumer owns the data.

  Slots:  summary = the summary line · default = the run pills
  Parts:  history · summary · strip
-->
<style>
  :host { display: block; }
  :host([hidden]) { display: none; }

  .summary {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground);
    margin-bottom: 8px;
  }
  .summary:not(:has(::slotted(*))) { display: none; }

  .strip { display: flex; gap: 6px; align-items: stretch; }
</style>

<div class="history" part="history">
  <div class="summary" part="summary"><slot name="summary"></slot></div>
  <div class="strip" part="strip"><slot></slot></div>
</div>
