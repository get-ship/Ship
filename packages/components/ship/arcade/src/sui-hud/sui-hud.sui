<!--
  <sui-hud> — DOM overlay on top of the stage's canvas.

  Hosts regular SUI primitives (sui-stat, sui-meter, sui-card, etc.) above
  the canvas. Descendants with `data-bind="<key>"` subscribe to the stage's
  scope signal of the same key — the stage controller wires the binding;
  the HUD is otherwise inert.

  `align` picks one of nine grid placements; `pointer-events="auto"` opts
  the overlay back into pointer interaction (default is `none` so the
  game still receives clicks behind the HUD).
-->

<prop name="align" values="top|bottom|left|right|center|corner-tl|corner-tr|corner-bl|corner-br" default="top" reflect />
<prop name="z-layer" type="number" default="1" />
<prop name="pointer-events" values="auto|none" default="none" reflect />

<style>
  :host {
    position: absolute;
    inset: 0;
    display: grid;
    pointer-events: none;
    color: var(--foreground);
    font-family: var(--font-body, system-ui, sans-serif);
  }
  :host([pointer-events="auto"]) { pointer-events: auto; }
  :host([hidden]) { display: none; }

  :host([align="top"])    { align-items: start;  justify-items: center; padding: var(--space-3, 12px); }
  :host([align="bottom"]) { align-items: end;    justify-items: center; padding: var(--space-3, 12px); }
  :host([align="left"])   { align-items: center; justify-items: start;  padding: var(--space-3, 12px); }
  :host([align="right"])  { align-items: center; justify-items: end;    padding: var(--space-3, 12px); }
  :host([align="center"]) { align-items: center; justify-items: center; }
  :host([align="corner-tl"]) { align-items: start; justify-items: start; padding: var(--space-3, 12px); }
  :host([align="corner-tr"]) { align-items: start; justify-items: end;   padding: var(--space-3, 12px); }
  :host([align="corner-bl"]) { align-items: end;   justify-items: start; padding: var(--space-3, 12px); }
  :host([align="corner-br"]) { align-items: end;   justify-items: end;   padding: var(--space-3, 12px); }
</style>

<slot></slot>
