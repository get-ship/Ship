<!--
  <ship-game-frame> — the in-game SURFACE chrome every arcade game mounts into.
  A title bar (back · name · pause/restart/close), a HUD strip (score · lives ·
  level), the game canvas (default slot — drop a <sui-stage> here), and a
  controls-hint footer. Game colors map to ship tone tokens so themes re-skin.
  Chrome only — it never touches the PixiJS engine. Prop-driven + slotted.

  Props:  name · score · lives · level · controls (hint text)
  Slots:  default = the game canvas (e.g. <sui-stage>)
  Events: ship-action { action: back|pause|restart|close }
  Parts:  surface · titlebar · hud · canvas · controls
-->
<prop name="name" type="string" default="Game" />
<prop name="score" type="string" default="" />
<prop name="lives" type="string" default="" />
<prop name="level" type="string" default="" />
<prop name="controls" type="string" default="" />

<style>
  :host { display: block; font-family: var(--font-body); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); box-shadow: var(--shadow-xs); width: 380px; max-width: 100%; }
  :host([hidden]) { display: none; }

  .bar { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 50%, var(--card)); }
  .bar .nm { font-weight: var(--font-weight-semibold, 600); font-size: var(--text-sm); color: var(--foreground); }
  .bar button { width: 26px; height: 26px; border: 0; background: transparent; color: var(--muted-foreground); border-radius: var(--radius-sm); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .bar button:hover { background: var(--muted); color: var(--foreground); }
  .bar button:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .bar svg { width: 15px; height: 15px; }
  .bar .right { margin-left: auto; display: inline-flex; gap: 2px; }

  .hud { display: flex; align-items: center; gap: 18px; padding: 8px 12px; border-bottom: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: 11px; }
  .hud:not(:has(.v:not(:empty))) { display: none; }
  .hud .k { color: var(--muted-foreground); letter-spacing: .06em; text-transform: uppercase; }
  .hud .v { color: var(--foreground); font-variant-numeric: tabular-nums; margin-left: 5px; }
  .hud .cell:has(.v:empty) { display: none; }
  .hud .hearts { color: var(--destructive); letter-spacing: 1px; }
  .hud .lvl { margin-left: auto; }
  .hud .lvl .v { color: var(--primary); }

  .canvas { aspect-ratio: 16 / 11; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); background-color: color-mix(in oklch, var(--foreground) 6%, var(--card)); background-image: linear-gradient(var(--border-subtle) 1px, transparent 1px), linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px); background-size: 20px 20px; }
  .canvas ::slotted(*) { width: 100%; height: 100%; }

  .foot { display: flex; gap: 10px; align-items: center; padding: 6px 12px; border-top: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 50%, var(--card)); font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .foot:has(.hint:empty) { display: none; }
  .foot .hint { color: var(--muted-foreground); }
</style>

<div class="surface" part="surface">
  <div class="bar" part="titlebar">
    <button type="button" aria-label="Back" on:click={onBack}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
    <span class="nm">{name()}</span>
    <span class="right">
      <button type="button" aria-label="Pause" on:click={onPause}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5v14M16 5v14"/></svg></button>
      <button type="button" aria-label="Restart" on:click={onRestart}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5"/></svg></button>
      <button type="button" aria-label="Close" on:click={onClose}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </span>
  </div>
  <div class="hud" part="hud">
    <span class="cell"><span class="k">Score</span><span class="v">{score()}</span></span>
    <span class="cell"><span class="k">Lives</span><span class="v hearts">{lives()}</span></span>
    <span class="cell lvl"><span class="k">Lv</span><span class="v">{level()}</span></span>
  </div>
  <div class="canvas" part="canvas"><slot></slot></div>
  <div class="foot" part="controls"><span class="hint">{controls()}</span></div>
</div>
