<!--
  <ship-spaces-hero> — @ship/home · the spaces grid on the hub `/`.

  The home dashboard surfaces the user's spaces (a Ship `space` is an
  independent workspace — its own daemon-backed directory). Today the
  Connect SDK exposes only `ship.spaces.config({ id })` (per-space
  runtime config) — there is no list-all-spaces method. This is a
  known `BACKEND-GAP` recorded in .artifacts/hub-buildout-flags.md.

  Until the gap closes, the host passes the spaces list via the
  `spaces` attribute as a JSON-encoded array of `{ id, name, path }`
  rows (the host's controller may source it from a future SDK call or
  from shell-scoped discovery; today's controller passes `[]`). When
  the attribute is empty / unparseable, the component renders the
  empty-state with a "register a space" affordance.

  When the SDK ships a list method, the controller switches to
  `live(() => ship.spaces.list())` and pipes the result into the
  attribute; this controller stays stable.

  Prop / event
  ─────────────────────────────────────────────────────────────────────
  spaces  (json string, '[]')   JSON-encoded list of {id,name,path}
  limit   (number, 8)           max cards rendered
  ─────────────────────────────────────────────────────────────────────

  Emits (bubbling, composed):
    ship-space-open  { detail: { id: string } }   click on a card
    ship-space-add   {}                          click on the empty-state CTA
-->

<prop name="spaces" type="string" default="[]" />
<prop name="limit" type="number" default="8" />

<style>
  :host { display: block; }

  .head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .head h2 {
    font-family: var(--heading-font, var(--font-display));
    font-size: var(--text-lg);
    font-weight: var(--heading-weight, var(--font-weight-semibold));
    letter-spacing: var(--heading-tracking);
    margin: 0;
    color: var(--foreground);
  }
  .head .sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .head .act {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--primary);
    text-decoration: none;
    cursor: pointer;
    background: transparent;
    border: 0;
    padding: 0;
  }
  .head .act:hover { text-decoration: underline; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  /* Each card is a styled surface; the inner content is a <sui-stack>
     so the author uses the layout primitive instead of a hand-rolled
     vertical flex rule (the design-system lint). */
  .card {
    display: block;
    padding: var(--space-4);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--foreground);
    text-decoration: none;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }
  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
    box-shadow: var(--shadow-hover);
  }
  .card:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  .card-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card-path {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<section class="head" data-test="home-spaces">
  <h2>Spaces</h2>
  <span class="sub">{countLabel()}</span>
  <button class="act" type="button" data-action="add" on:click={onAdd} title="Register a space">+ register</button>
</section>

{#if rows().length === 0}
  <sui-empty-state variant="inline" size="md" tone="muted" data-test="home-spaces-empty">
    <sui-icon slot="icon" name="layout-grid"></sui-icon>
    <span slot="title">No spaces yet</span>
    A Ship <b>space</b> is an independent workspace with its own daemon-backed directory. Register one to get started.
    <button slot="action" type="button" on:click={onAdd}>
      Register a space
    </button>
  </sui-empty-state>
{:else}
  <div class="grid" data-test="home-spaces-grid">
    {#for s of rows() key={s.id}}
      <a class="card" href={'/spaces/' + s.id}
         on:click={(e) => onOpen(e, s.id)}
         aria-label={'Open space ' + s.name}>
        <sui-stack gap="2">
          <span class="card-name" title={s.name}>{s.name}</span>
          <span class="card-path" title={s.path}>{s.path}</span>
          <sui-cluster class="card-meta" gap="2" align="center">
            <sui-status-dot tone="success" size="sm" label="ready"></sui-status-dot>
            <sui-badge tone="muted" size="sm">space</sui-badge>
          </sui-cluster>
        </sui-stack>
      </a>
    {/for}
  </div>
{/if}
