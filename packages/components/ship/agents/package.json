{
  "name": "@ship/agents",
  "version": "0.1.0",
  "description": "Ship Agents pack \u2014 <ship-agent-list>, <ship-agent-detail>, <ship-agent-card>, <ship-agents-table>, and the rest of the ship-agent-* domain. Pre-bound to ship.agents.* via the lazy `ship` Proxy; the host must call setShipClient() at startup.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "deck": {
    "bundles": [
      {
        "name": "ship-agents",
        "entry": "src/index.ts",
        "externals": [
          "@ship/sail-runtime",
          "@ship/sail-dom",
          "@ship/sdk-client",
          "@ship/sail-primitives",
          "@ship/sail-chat-elements",
          "@ship/code"
        ],
        "lazy": true
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/code": "workspace:*",
    "@ship/sdk-client": "^0.1.0",
    "@ship/sail-dom": "*",
    "@ship/sail-runtime": "*",
    "@ship/sail-primitives": "*",
    "@ship/sail-chat-elements": "*"
  },
  "devDependencies": {
    "@ship/test-setup": "^0.1.0",
    "vitest": "^4.1.5"
  }
}
