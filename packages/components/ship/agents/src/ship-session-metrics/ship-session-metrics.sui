<!--
  ship-session-metrics.sui — @ship/agents (analytics) · the session rollup strip.
  Duration · turns · tool calls (+errors) · cost, with the outcome as a toned pill.
  The errors stat reads destructive only when non-zero (data-zero neutralises it).
  Compact for a SessionRow; full for a SessionDetail / dashboard. Attribute-driven,
  tokens only.  Props: duration · turns · tools · errors · cost · outcome.
-->
<prop name="duration" type="string" default="—" />
<prop name="turns" type="string" default="0" />
<prop name="tools" type="string" default="0" />
<prop name="errors" type="string" default="0" />
<prop name="cost" type="string" default="—" />
<prop name="outcome" values="completed|failed|cancelled" default="completed" reflect />

<style>
  :host { display: block; font-family: var(--font-body); --oc: var(--success); }
  :host([outcome='failed'])    { --oc: var(--destructive); }
  :host([outcome='cancelled']) { --oc: var(--muted-foreground); }

  .metrics { display: flex; align-items: stretch; gap: 0; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }
  .stat { display: flex; flex-direction: column; gap: 2px; padding: 10px 16px; border-right: 1px solid var(--divider); min-width: 0; }
  .n { font-family: var(--font-mono); font-weight: 700; font-size: var(--text-lg); color: var(--foreground); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .k { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted-foreground); }
  .stat.err .n { color: var(--destructive); }
  .stat.err[data-zero] .n { color: var(--foreground); }
  .outcome { display: inline-flex; align-items: center; gap: 7px; margin-left: auto; padding: 0 16px; }
  .odot { width: 8px; height: 8px; border-radius: 50%; background: var(--oc); }
  .olbl { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--oc); }
</style>

<div class="metrics" part="metrics">
  <div class="stat"><span class="n" data-test="m-duration">{duration()}</span><span class="k">duration</span></div>
  <div class="stat"><span class="n" data-test="m-turns">{turns()}</span><span class="k">turns</span></div>
  <div class="stat"><span class="n" data-test="m-tools">{tools()}</span><span class="k">tool calls</span></div>
  <div class="stat err" data-zero={errors() === '0' ? 'true' : null}><span class="n" data-test="m-errors">{errors()}</span><span class="k">errors</span></div>
  <div class="stat"><span class="n" data-test="m-cost">{cost()}</span><span class="k">cost</span></div>
  <div class="outcome"><span class="odot"></span><span class="olbl" data-test="m-outcome">{outcome()}</span></div>
</div>
