<!--
  ship-session-list.sui — @ship/agents · the sessions in a Space (or cross-space
  in shell). One row per session: status dot (folded state) · harness badge · agent ·
  the input · turn count · time · outcome/reason. Covers the full five-status fold —
  active · suspended · completed · failed · cancelled. Rows arrive as data through the
  `rows` prop (JSON); the status-filter header derives its counts from them and emits
  ship-filter on click. No hardcoded fixtures — production passes the live `sessions`
  projection straight through. Tokens only.  Props: rows · scope.
-->
<prop name="rows" type="string" default="[]" />
<prop name="scope" type="string" default="" />

<style>
  :host { display: block; font-family: var(--font-body); }
  .panel { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); overflow: hidden; box-shadow: var(--shadow-xs); }
  .head { display: flex; align-items: baseline; gap: 10px; padding: 13px 16px; border-bottom: 1px solid var(--divider); }
  .title { font-family: var(--heading-font); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); font-size: var(--text-lg); }
  .count { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }
  .scope { margin-left: auto; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }

  .filters { display: flex; align-items: center; gap: 6px; padding: 9px 16px; border-bottom: 1px solid var(--divider); flex-wrap: wrap; }
  .fpill { font-family: var(--font-mono); font-size: 11px; padding: 3px 10px; border-radius: var(--radius-full); border: 1px solid var(--border-subtle); background: var(--card); color: var(--muted-foreground); cursor: pointer; }
  .fpill:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .fpill .c { color: var(--foreground); font-weight: 700; margin-left: 4px; }
  .fpill.on { background: var(--selected-bg); border-color: var(--border-strong); color: var(--foreground); }

  .row { display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--divider); transition: background var(--duration-fast) var(--ease-out); }
  .row:last-child { border-bottom: 0; }
  .row:hover { background: var(--hover-bg); }
  .empty { padding: 28px 16px; text-align: center; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted-foreground); }

  .st { display: inline-flex; align-items: center; gap: 7px; min-width: 96px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .stlabel { font-family: var(--font-mono); font-size: 11px; font-weight: 600; }
  .d-active    { background: var(--primary); }
  .d-suspended { background: var(--warning); }
  .d-completed { background: var(--success); }
  .d-failed    { background: var(--destructive); }
  .d-cancelled { background: var(--muted-foreground); }
  .l-active    { color: var(--primary); }
  .l-suspended { color: var(--warning); }
  .l-completed { color: var(--success); }
  .l-failed    { color: var(--destructive); }
  .l-cancelled { color: var(--muted-foreground); }
  .pulse { position: relative; }
  .pulse::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--primary); opacity: .5; animation: sl-pulse 1.8s ease-out infinite; }
  @keyframes sl-pulse { to { transform: scale(1.9); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pulse::after { animation: none; } }

  .harness { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .03em; padding: 2px 7px; border-radius: var(--radius-sm); text-transform: lowercase; color: var(--muted-foreground); background: var(--muted); }
  .h-floki  { color: var(--primary); background: var(--tone-primary-bg); }
  .h-claude { color: var(--accent);  background: var(--tone-accent-bg); }
  .h-codex  { color: var(--info);    background: var(--tone-info-bg); }

  .mid { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .who { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .agent { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--foreground); white-space: nowrap; }
  .child { font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1px 6px; }
  .input { font-size: var(--text-sm); color: var(--muted-foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .reason { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); margin-top: 1px; }
  .reason svg { width: 12px; height: 12px; flex-shrink: 0; display: none; }
  .r-warn { color: var(--warning); } .r-warn .i-warn { display: inline; }
  .r-fail { color: var(--destructive); } .r-fail .i-fail { display: inline; }
  .r-mute { color: var(--muted-foreground); } .r-mute .i-mute { display: inline; }

  .end { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; flex-shrink: 0; }
  .turns { font-family: var(--font-mono); font-size: 11px; color: var(--foreground); }
  .turns span { color: var(--muted-foreground); }
  .time { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); }
  .cost { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
</style>

<div class="panel" part="list">
  <div class="head">
    <span class="title">Sessions</span>
    <span class="count" data-test="list-count">{total()} sessions</span>
    <span class="scope">{scopeLabel()}</span>
  </div>

  <div class="filters" part="filters">
    {#for pill of pills() key={pill.key}}
    <button class={pill.cls} type="button" data-test="filter-pill" on:click={pill.select}>{pill.label}<span class="c">{pill.count}</span></button>
    {/for}
  </div>

  {#if visible().length === 0}
  <div class="empty" data-test="list-empty">No sessions.</div>
  {/if}
  {#for row of visible() key={row.id}}
  <div class="row" part="row" data-test="session-row">
    <span class="st"><span class={row.dotClass}></span><span class={row.labelClass}>{row.status}</span></span>
    <span class={row.harnessClass}>{row.harness}</span>
    <span class="mid">
      <span class="who"><span class="agent">{row.agent}</span>{#if row.child}<span class="child">{row.child}</span>{/if}</span>
      <span class="input">{row.input}</span>
      {#if row.reason}
      <span class={row.reasonClass}>
        <svg class="i-warn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
        <svg class="i-fail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M15 9l-6 6M9 9l6 6"></path></svg>
        <svg class="i-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12h8"></path></svg>
        {row.reason}
      </span>
      {/if}
    </span>
    <span class="end"><span class="turns">{row.turns} <span>{row.turnsLabel}</span></span><span class="time">{row.model} · {row.time}</span>{#if row.cost}<span class="cost">{row.cost}</span>{/if}</span>
  </div>
  {/for}
</div>
