<!--
  <ship-agent-card> — pre-bound single-agent summary card.

  Subscribes to ship.agents.detail({ id }) via live() inside the
  controller; the consumer just drops
    <ship-agent-card prop:id={agentId}></ship-agent-card>
  with no SDK call of its own.

  Tag prefix `ship-*` (vs `sui-*`) marks this component as depending on
  the Ship runtime: mounting it without a host that has called
  setShipClient() will throw on the first SDK access.

  Composition: <sui-card> surface; <sui-skeleton> while loading;
  <sui-error-state> on error; <sui-chip> for the source label, tags,
  harness badge + capability tier chips; <sui-button> for the Start verb.
  A `trailing` slot lets callers inject action buttons (edit, delete,
  dispatch, …) into the card's header.

  Elevated from the original live-bound summary: KEEPS the id → ship.agents.detail()
  binding (the repo's source of truth) and ADDS the design's identity surface —
  harness badge, status dot + label, capability tier chips, and a Start button that
  emits `ship-start {id}`. The tier chips replicate @ship/authority's ship-blast-tag
  with a toned sui-chip; cross-pack component composition is not yet an established
  pattern (see controller note).
-->

<prop name="id" type="string" default="" />

<style>
  :host { display: block; }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3, 12px);
  }
  .name {
    margin: 0;
    font-size: var(--text-lg, 1.125rem);
    font-weight: var(--font-weight-semibold, 600);
    line-height: var(--leading-tight, 1.2);
    color: var(--card-foreground, var(--foreground));
  }
  .trailing { display: flex; align-items: center; gap: var(--space-2, 8px); }

  .meta { margin-top: var(--space-2, 8px); }

  .desc {
    margin: var(--space-3, 12px) 0 0;
    font-size: var(--text-sm, 0.875rem);
    line-height: var(--leading-normal, 1.5);
    color: var(--muted-foreground, var(--foreground));
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 8px);
    margin-top: var(--space-3, 12px);
  }
  .caps { margin-top: var(--space-3, 12px); }

  .ident { display: inline-flex; align-items: center; gap: var(--space-2, 8px); margin-top: var(--space-1, 4px); }
  .model { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }

  .status { display: inline-flex; align-items: center; gap: var(--space-1, 4px); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }
  .sdot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .sdot.on { background: var(--success); }
  .sdot.busy { background: var(--primary); }

  .foot { display: flex; align-items: center; gap: var(--space-3, 12px); margin-top: var(--space-3, 12px); padding-top: var(--space-3, 12px); border-top: 1px solid var(--divider); }
  .foot .start { margin-left: auto; }

  .sk-lines { display: flex; flex-direction: column; gap: var(--space-2, 8px); }
</style>

<sui-card variant="default" padding="md">
{#while-loading of agent}
  <div class="head">
    <sui-skeleton shape="line" size="lg"></sui-skeleton>
  </div>
  <div class="sk-lines meta">
    <sui-skeleton shape="line" size="sm"></sui-skeleton>
    <sui-skeleton shape="line" size="sm"></sui-skeleton>
  </div>
{/while-loading}
{#while-error err of agent}
  <sui-error-state title="Couldn't load agent" variant="inline">{err.message}</sui-error-state>
{/while-error}
{#if agent().kind === 'ok'}
  <div class="head">
    <h3 class="name" data-test="agent-name">{name()}</h3>
    <div class="trailing">
      {#if status()}
        <span class="status" data-test="agent-status"><span class={statusDotClass()}></span>{status()}</span>
      {/if}
      <slot name="trailing"></slot>
    </div>
  </div>
  {#if harness()}
    <div class="ident">
      <sui-chip tone={harnessTone()} variant="soft" size="sm" data-test="agent-harness">{harness()}</sui-chip>
      {#if model()}<span class="model" data-test="agent-model">{model()}</span>{/if}
    </div>
  {/if}
  {#if source()}
    <div class="meta">
      <sui-chip tone="muted" variant="soft" size="sm" data-test="agent-source">{source()}</sui-chip>
    </div>
  {/if}
  {#if description()}
    <p class="desc" data-test="agent-description">{description()}</p>
  {/if}
  {#if capabilities().length > 0}
    <div class="caps tags" data-test="agent-caps">
      {#for cap of capabilities() key={cap.label}}
        <sui-chip tone={cap.tone} variant="soft" size="sm">{cap.label} {cap.tier}</sui-chip>
      {/for}
    </div>
  {/if}
  {#if tags().length > 0}
    <div class="tags" data-test="agent-tags">
      {#for tag of tags() key={tag}}
        <sui-chip tone="default" variant="outline" size="sm">{tag}</sui-chip>
      {/for}
    </div>
  {/if}
  <div class="foot">
    <sui-button class="start" variant="solid" tone="primary" size="sm" data-test="agent-start" on:click={start}>Start</sui-button>
  </div>
{/if}
</sui-card>
