<!--
  <ship-agent-detail> — @ship/agents · the hub `/studio/agents/:id` page.

  Page-level detail composite. Reads ship.agents.detail({ id }) via the
  controller (no SDK call in the host route) and renders the agent's
  identity + description + tags + capabilities + source path, with a
  Start action + Back link.

  Composes <sui-card>, <sui-stack>, <sui-cluster>, <sui-chip>,
  <sui-badge>, <sui-status-dot>, <sui-button>, <sui-icon>, <sui-skeleton>,
  <sui-empty-state>, <sui-error-state> from @ship/sui-primitives. No new
  primitives introduced.

  The hue swatch reuses the `--tile-color` setProperty pattern from
  <sui-harness-blob> — the controller binds `style="--tile-color:
  var(--hue-{name})"` on the keystone tile so the design-system
  palette is the source of truth (no literal oklch in component CSS).

  Prop / event
  ─────────────────────────────────────────────────────────────────────
  id  (string, '')   agent slug (the route's [id] param)
  ─────────────────────────────────────────────────────────────────────

  Emits:
    ship-agent-back        { detail: {} }                          back link
    ship-agent-start       { detail: { id } }                       Start click
-->

<prop name="id" type="string" default="" />

<style>
  :host {
    display: block;
    --tile-color: var(--muted);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted-foreground);
    text-decoration: none;
    font: inherit;
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }
  .back:hover { color: var(--foreground); background: var(--hover-bg); }
  .back:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  /* Per-agent hue swatch — same data-binding contract as the list
     tile (the controller sets the `--tile-color` CSS custom property
     from the data-driven hue name, so the design-system --hue-*
     palette is the source of truth). */
  .hue {
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    color: var(--primary-foreground, var(--background));
    font-family: var(--font-mono);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-2xl);
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, var(--tile-color, var(--muted)) 40%, transparent),
      var(--shadow-card-rest);
  }

  .head-body { min-width: 0; flex: 1; }
  .head-name {
    font-family: var(--heading-font, var(--font-display));
    font-size: var(--text-2xl);
    font-weight: var(--heading-weight, var(--font-weight-semibold));
    letter-spacing: var(--heading-tracking);
    line-height: 1.1;
    margin: 0 0 var(--space-1);
    color: var(--foreground);
  }
  .head-id {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .head-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .head-meta .sep { color: var(--border-strong); }
  .head-rule {
    width: 96px;
    height: var(--space-1);
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--primary), transparent);
    margin-top: var(--space-2);
  }

  .head-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .prose {
    margin: var(--space-4) 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--foreground);
  }

  .tags {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .caps {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .section {
    margin-top: var(--space-5);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .section-h {
    font-family: var(--heading-font, var(--font-display));
    font-size: var(--text-md);
    font-weight: var(--heading-weight, var(--font-weight-semibold));
    letter-spacing: var(--heading-tracking);
    margin: 0;
    color: var(--foreground);
  }
  .section-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .source-path {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background: var(--muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .sk-head {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .sk-hue {
    width: 88px;
    height: 88px;
    border-radius: var(--radius-lg);
    background: var(--muted);
  }
</style>

<a class="back" href="/studio/agents" on:click={onBack} data-test="agents-detail-back">
  <sui-icon name="chevron-left" size="xs"></sui-icon>
  Back to agents
</a>

{#if detail().kind === 'loading'}
  <div class="sk-head" role="status" aria-live="polite" aria-busy="true" aria-label="Loading agent" data-test="agents-detail-loading">
    <div class="sk-hue" aria-hidden="true"></div>
    <div>
      <sui-skeleton shape="line" size="lg" style="width: 280px"></sui-skeleton>
      <sui-skeleton shape="line" size="sm" style="width: 180px; margin-top: var(--space-2)"></sui-skeleton>
    </div>
  </div>
{:else if detail().kind === 'error'}
  <sui-error-state
    title="Couldn't load agent"
    variant="inline"
    data-test="agents-detail-error"
    role="alert"
    aria-live="assertive"
  >
    {detail().error.message}
  </sui-error-state>
{:else if data().id === ''}
  <sui-empty-state
    icon="search-x"
    variant="default"
    size="md"
    tone="muted"
    data-test="agents-detail-not-found"
    role="status"
  >
    <span slot="title">No such agent</span>
    <span>{'No agent with id "' + (id() || '(unknown)') + '" exists in this workspace or your library.'}</span>
    <sui-button slot="action" tone="primary" variant="solid" on:click={onBack} data-test="agents-detail-back-action">
      <sui-icon slot="leading" name="chevron-left" size="xs"></sui-icon>
      Back to agents
    </sui-button>
  </sui-empty-state>
{:else}
  <article data-test="agents-detail">
    <header class="head">
      <span
        class="hue"
        attr:style={'--tile-color: var(--hue-' + hue() + ')'}
        aria-hidden="true"
        data-test="agents-detail-hue"
      >{initials()}</span>
      <div class="head-body">
        <h1 class="head-name" data-test="agents-detail-name">{name()}</h1>
        <div class="head-id" data-test="agents-detail-id">{data().id}</div>
        <div class="head-meta">
          {#if harness()}
            <sui-chip tone="muted" variant="soft" size="sm" data-test="agents-detail-harness">{harness()}</sui-chip>
            <span class="sep" aria-hidden="true">·</span>
          {/if}
          {#if model()}
            <span data-test="agents-detail-model">{model()}</span>
            <span class="sep" aria-hidden="true">·</span>
          {/if}
          <sui-status-dot
            tone={isActive() ? 'primary' : 'success'}
            size="sm"
            pulse={isActive()}
            label={statusLabel()}
            data-test="agents-detail-status"
          ></sui-status-dot>
          <span data-test="agents-detail-status-label">{statusLabel()}</span>
        </div>
        <div class="head-rule" aria-hidden="true"></div>
      </div>
      <div class="head-actions">
        <sui-button
          tone="primary"
          variant="solid"
          size="sm"
          on:click={onStart}
          data-test="agents-detail-start"
        >
          <sui-icon slot="leading" name="zap" size="xs"></sui-icon>
          Start
        </sui-button>
      </div>
    </header>

    <p class="prose" data-test="agents-detail-description">{description()}</p>

    {#if tags().length > 0}
      <sui-cluster class="tags" gap="1" data-test="agents-detail-tags">
        {#for t of tags() key={t}}
          <sui-chip tone="muted" variant="soft" size="sm">{t}</sui-chip>
        {/for}
      </sui-cluster>
    {/if}

    {#if capabilities().length > 0}
      <section class="section" data-test="agents-detail-capabilities">
        <div class="section-head">
          <h2 class="section-h">Capabilities</h2>
          <span class="section-count">· {capabilities().length}</span>
        </div>
        <sui-cluster class="caps" gap="1">
          {#for cap of capabilities() key={cap.label}}
            <sui-chip tone="default" variant="soft" size="sm">
              {cap.label} {cap.tier}
            </sui-chip>
          {/for}
        </sui-cluster>
      </section>
    {/if}

    <section class="section" data-test="agents-detail-source">
      <div class="section-head">
        <h2 class="section-h">Source</h2>
      </div>
      <span class="source-path" data-test="agents-detail-source-path">{sourcePath()}</span>
    </section>
  </article>
{/if}
