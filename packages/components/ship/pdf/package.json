{
  "name": "@ship/pdf",
  "version": "0.1.0",
  "description": "Ship PDF pack — ship-pdf-* components wrapping a vendored pdf.js (pdfjs-dist) engine. SHIP-tier vendored engine; the engine ships in src/vendor/pdfjs, not as an npm dependency.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts",
    "./pdfjs": "./src/vendor/pdfjs/pdfjs.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sui-runtime": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/sui-primitives": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
