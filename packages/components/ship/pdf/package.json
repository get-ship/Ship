{
  "name": "@ship/pdf",
  "version": "0.1.0",
  "description": "Ship PDF pack — ship-pdf-* components wrapping the pdf.js (pdfjs-dist) engine. The bundler inlines the engine at build; the published pack carries no committed engine source.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "deck": {
    "bundles": [
      {
        "name": "sui-pdf",
        "entry": "src/index.ts",
        "externals": ["@ship/sui-runtime", "@ship/sui-dom"],
        "lazy": true
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sui-runtime": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/sui-primitives": "workspace:*",
    "pdfjs-dist": "^6.0.227"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
