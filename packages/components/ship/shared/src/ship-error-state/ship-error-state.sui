<!--
  <ship-error-state> — @ship/primitives · the canonical hub-level error and
  not-found surface.

  A tidy card composing <sui-error-state> from @ship/sui-primitives with
  ship-flavoured defaults: a token-themed wrapper that centers inside
  the available space, a built-in "Go back" affordance (history.back()
  by default, or an SPA link when `href` is set), and an optional
  secondary action button surfaced through the `action` slot.

  The hub routes its 404 fallback and its route-level boundary through
  this one component — one SSOT, one chrome, one way for the user to
  recover. Token-themed: every paint is driven by design-system tokens
  (var(--space-*), var(--foreground), var(--muted-foreground),
  var(--destructive), var(--border), var(--shadow-*), var(--radius-*)).

  Prop surface
  ─────────────────────────────────────────────────────────────────────
  title  (string, '')        Reflected. Defaults to "Not found" or
                             "Something went wrong" by variant.
  body   (string, '')        Default-slot fallback when no body slot
                             content is projected.
  variant  ('not-found' | 'error', 'not-found', reflect)
                             - 'not-found'  → icon "map-pin-off", blue
                               chrome is muted
                             - 'error'      → icon "alert-octagon",
                               destructive halo
  href   (string, '')        Reflected. When set, the primary action is
                             an SPA link to that path; otherwise it
                             calls history.back() on click.
  action-label (string, 'Go back')
                             Reflected. Override the primary button copy.

  Slots
  ─────────────────────────────────────────────────────────────────────
  title         Replaces the default title.
  (default)     Replaces the default body.
  action        Adds a SECONDARY button (the primary "Go back" is
                always rendered unless `action` slot is occupied AND
                `href` is empty — call sites that need only a custom
                action can hide the default by passing `action-label=""`).

  Parts: card, icon, title, body, primary-action, actions
  Events:
    ship-error-state:retry — fires when the user clicks the default
                              back/retry button. Hosts may listen to
                              run a custom recovery path (e.g. reload,
                              refetch). The default behaviour still
                              runs (history.back / navigation).
-->
<prop name="title" type="string" default="" reflect />
<prop name="body" type="string" default="" />
<prop name="variant" values="not-found|error" default="not-found" reflect />
<prop name="href" type="string" default="" reflect />
<prop name="action-label" type="string" default="Go back" reflect />

<style>
  :host {
    display: block;
    box-sizing: border-box;
    font-family: var(--font-body);
    color: var(--foreground);
    /* Wrapper takes the available width/height; the card centers. */
    container-type: inline-size;
  }
  :host([hidden]) { display: none; }

  /* The wrapping card — the actual painted surface. Token-themed. */
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    max-width: 56ch;
    margin: var(--space-8) auto;
    padding: var(--space-8) var(--space-7);
    text-align: center;
    background: var(--surface-1, var(--background));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* Tile holds the lucide icon. Tints drive the variant mood. */
  .tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--tone-muted-bg);
    color: var(--muted-foreground);
    box-shadow: inset 0 0 0 1px var(--border-subtle, var(--border));
  }
  :host([variant='error']) .tile {
    background: var(--tone-destructive-bg);
    color: var(--destructive);
    box-shadow: inset 0 0 0 1px var(--tone-destructive-ring);
  }

  .title {
    font-family: var(--heading-font);
    font-size: var(--text-xl);
    font-weight: var(--heading-weight);
    line-height: var(--leading-tight);
    color: var(--foreground);
    margin: 0;
  }

  .body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed, 1.6);
    color: var(--muted-foreground);
    max-width: 48ch;
    margin: 0;
  }

  .actions {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  /* Default back/retry button — used unless the action slot overrides it. */
  .primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 34px;
    padding: 0 var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-xs);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .primary-action:hover {
    background: var(--muted);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .primary-action:active {
    transform: translateY(1px);
  }
  .primary-action:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  :host([variant='error']) .primary-action {
    background: var(--primary);
    color: var(--primary-foreground, var(--background));
    border-color: var(--primary);
  }
  :host([variant='error']) .primary-action:hover {
    background: var(--tone-primary-ring, var(--primary));
    border-color: var(--tone-primary-ring, var(--primary));
  }

  /* When the host hands an action via slot and there's no href or
   * action-label, we render the slot's first button as the primary
   * instead of our default back button. The host opts out by passing
   * an empty `action-label` AND a populated `action` slot. */
  :host([data-action-from-slot]) .primary-action { display: none; }

  ::slotted([slot='title']) {
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
    margin: 0;
  }
  ::slotted([slot='action']) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-action { transition: none; }
    .primary-action:hover,
    .primary-action:active { transform: none; }
  }

  @media (forced-colors: active) {
    .card { border-color: CanvasText; }
    .primary-action {
      background: Canvas;
      color: CanvasText;
      border-color: CanvasText;
    }
  }

  @container (max-width: 480px) {
    .card {
      margin: var(--space-4) auto;
      padding: var(--space-6) var(--space-5);
      gap: var(--space-3);
    }
    .tile { width: 44px; height: 44px; }
    .title { font-size: var(--text-lg); }
  }
</style>

<div class="card" part="card" role="alert" aria-live="polite">
  <div class="tile" part="icon" aria-hidden="true">
    <sui-icon
      name={variant() === 'error' ? 'alert-octagon' : 'map-pin-off'}
      size="md"
    ></sui-icon>
  </div>

  <h1 class="title" part="title">
    <slot name="title">{title() || (variant() === 'error' ? 'Something went wrong' : 'Not found')}</slot>
  </h1>

  <p class="body" part="body">
    <slot>{body() || (variant() === 'not-found'
      ? "We couldn't find that page. Check the URL or head back to a known surface."
      : 'The page failed to load. Try again, or head back.')}</slot>
  </p>

  <div class="actions" part="actions">
    {#if href()}
      <a class="primary-action" part="primary-action"
         href={href()}
         data-test="primary-action">{actionLabel()}</a>
    {:else}
      <button class="primary-action" part="primary-action" type="button"
              data-test="primary-action"
              on:click={goBack}>{actionLabel()}</button>
    {/if}

    <slot name="action"></slot>
  </div>
</div>
