<!--
  <ship-collection-list> — @ship/collections · sidebar / picker of the
  space's collections. Calls ship.collections.list() via the controller
  and emits ship-collection-select { id, system } on row click. System
  collections (feedback, annotations) are flagged in the title slot
  so the row reads at a glance.

  Tag prefix `ship-*` (vs `sui-*`) marks this component as depending
  on the Ship runtime: mounting without a host that has called
  setShipClient() will throw on the first SDK access.
-->
<prop name="active" type="string" default="" />

<style>
  :host { display: block; font-family: var(--font-body); color: var(--foreground); }
  :host([hidden]) { display: none; }

  .list {
    padding: var(--space-1);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .row {
    appearance: none; cursor: pointer; width: 100%; text-align: left;
    display: flex; align-items: center; gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 0; background: transparent; color: var(--foreground);
    border-radius: var(--radius-sm);
    font-family: inherit; font-size: var(--text-sm);
  }
  .row:hover { background: var(--hover-bg); }
  .row:focus-visible {
    outline: var(--focus-ring); outline-offset: var(--focus-ring-offset);
    background: var(--hover-bg);
  }
  .row[aria-selected='true'] { background: var(--selected-bg); }

  .name {
    flex: 1; min-width: 0;
    font-weight: var(--font-weight-medium);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .sys {
    font-size: var(--text-xs); font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    padding: var(--space-1) var(--space-1);
    border-radius: var(--radius-sm);
    color: var(--info); background: var(--tone-info-bg);
  }
</style>

{#while-loading of list}
  <sui-stack gap="1" class="list" data-test="skeleton">
    <sui-skeleton shape="line" size="sm"></sui-skeleton>
    <sui-skeleton shape="line" size="sm"></sui-skeleton>
    <sui-skeleton shape="line" size="sm"></sui-skeleton>
  </sui-stack>
{/while-loading}
{#while-error err of list}
  <sui-error-state title="Couldn't load collections">{err.message}</sui-error-state>
{/while-error}
{#if list().kind === 'ok'}
  <sui-stack gap="1" class="list" part="list" role="listbox">
    {#for c of rows() key={c.id}}
      <button
        class="row"
        type="button"
        part="row"
        data-id={c.id}
        data-test="row"
        role="option"
        aria-selected={c.id === active() ? 'true' : 'false'}
        on:click={() => select(c.id, c.system)}
      >
        <span class="name">{c.name}</span>
        {#if c.system}
          <span class="sys" data-test="system">system</span>
        {/if}
        <span class="count">{c.item_count}</span>
      </button>
    {/for}
  </sui-stack>
{/if}
