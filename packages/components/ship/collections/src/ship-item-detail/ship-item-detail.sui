<!--
  <ship-item-detail> — @ship/collections · one item rendered by its
  typed fields, with a raw-JSON fallback. Calls
  ship.collections.get_item({collection, item_id}) via the controller
  and emits ship-item-edit { collection, id } on Edit click.

  The typed view projects each schema field to a row (label · value).
  The raw view is a <sui-json-view> over the full data envelope — the
  fallback when the type doesn't render cleanly (or the user wants
  to see what shipped).

  Tag prefix `ship-*` marks this component as depending on the Ship
  runtime: mounting without a host that has called setShipClient()
  will throw on the first SDK access.
-->
<prop name="collection" type="string" default="" />
<prop name="id" type="string" default="" />
<prop name="view" values="typed|raw" default="typed" reflect />

<style>
  :host { display: block; font-family: var(--font-body); color: var(--foreground); }
  :host([hidden]) { display: none; }

  .head {
    display: flex; align-items: center; gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .id { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }
  .toggle { margin-left: auto; display: inline-flex; gap: var(--space-1); padding: var(--space-1); background: var(--muted); border-radius: var(--radius-sm); }
  .toggle button {
    appearance: none; cursor: pointer; border: 0; background: transparent;
    font: inherit; font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm);
    color: var(--muted-foreground);
  }
  .toggle button[aria-pressed='true'] { background: var(--surface-1); color: var(--foreground); box-shadow: var(--shadow-xs); }
  .edit {
    appearance: none; cursor: pointer; font: inherit;
    font-size: var(--text-sm); font-weight: var(--font-weight-semibold);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--surface-1); color: var(--foreground);
  }
  .edit:hover { background: var(--hover-bg); }

  .rows {
    display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-3);
    padding: var(--space-3);
    background: var(--surface-1);
    border: 1px solid var(--border); border-radius: var(--radius-md);
  }
  .rows dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    padding-top: var(--space-1);
  }
  .rows dd { margin: 0; font-size: var(--text-sm); word-break: break-word; }
  .empty { color: var(--muted-foreground); font-style: italic; }
  .json-wrap { padding: var(--space-2); background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--radius-md); }
</style>

{#while-loading of item}
  <sui-skeleton shape="line" size="lg"></sui-skeleton>
  <div style="height: var(--space-3)"></div>
  <sui-skeleton shape="line" size="md"></sui-skeleton>
{/while-loading}
{#while-error err of item}
  <sui-error-state title="Couldn't load item" variant="inline">{err.message}</sui-error-state>
{/while-error}
{#if item().kind === 'ok' && item().value}
  <div class="head">
    <span class="id" data-test="item-id">{id()}</span>
    <div class="toggle" role="tablist">
      <button type="button" role="tab" data-test="view-typed" aria-pressed={view() === 'typed' ? 'true' : 'false'} on:click={() => setView('typed')}>typed</button>
      <button type="button" role="tab" data-test="view-raw" aria-pressed={view() === 'raw' ? 'true' : 'false'} on:click={() => setView('raw')}>raw</button>
    </div>
    <button class="edit" type="button" data-test="edit" on:click={edit}>Edit</button>
  </div>
  {#if view() === 'raw'}
    <div class="json-wrap" data-test="raw">
      <sui-json-view prop:data={rawJson()}></sui-json-view>
    </div>
  {:else}
    <dl class="rows" data-test="rows">
      {#if fieldRows().length === 0}
        <dd class="empty">No fields in this schema.</dd>
      {/if}
      {#for f of fieldRows() key={f.name}}
        <dt>{f.name} <span style="color: var(--muted-foreground)">· {f.type}</span></dt>
        <dd data-test={f.name}>{f.value}</dd>
      {/for}
    </dl>
  {/if}
{/if}
