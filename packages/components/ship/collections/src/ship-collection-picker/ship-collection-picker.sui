<!--
  <ship-collection-picker> — @ship/collections · compact collection
  selector. Calls ship.collections.list() via the controller and
  emits ship-collection-pick { id } on selection. Pure composition
  over a native <select>-style list (no <sui-select> primitive in
  the framework, so we render a labelled <button> list — the same
  shape the spaces pack's switcher uses, kept minimal for compact
  pickers embedded in other surfaces).

  Tag prefix `ship-*` marks this component as depending on the
  Ship runtime: mounting without a host that has called
  setShipClient() will throw on the first SDK access.
-->
<prop name="active" type="string" default="" />
<prop name="placeholder" type="string" default="Pick a collection" />

<style>
  :host {
    display: inline-block; position: relative;
    font-family: var(--font-body); color: var(--foreground);
    min-width: 220px;
  }
  :host([hidden]) { display: none; }

  .trigger {
    appearance: none; cursor: pointer; width: 100%;
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    font-family: inherit; font-size: var(--text-sm);
    color: var(--foreground);
    background: var(--surface-1);
    border: 1px solid var(--border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }
  .trigger:hover { background: var(--hover-bg); }
  .trigger:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .t-label {
    flex: 1; text-align: left;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    font-weight: var(--font-weight-medium);
  }
  .t-label[data-empty='true'] { color: var(--muted-foreground); font-weight: var(--font-weight-normal); }
  .chev { color: var(--muted-foreground); }

  .menu {
    position: absolute; top: calc(100% + 4px); left: 0; min-width: 100%; width: max-content;
    max-height: 280px; overflow-y: auto;
    z-index: var(--z-dropdown);
    background: var(--popover); color: var(--popover-foreground);
    border: 1px solid var(--border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-1);
  }

  .row {
    appearance: none; cursor: pointer; width: 100%; text-align: left;
    display: flex; align-items: center; gap: var(--space-2);
    padding: var(--space-1) var(--space-2); border: 0; background: transparent; color: var(--foreground);
    border-radius: var(--radius-sm);
    font-family: inherit; font-size: var(--text-sm);
  }
  .row:hover { background: var(--hover-bg); }
  .row:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); background: var(--hover-bg); }
  .row.active { background: var(--selected-bg); }
  .r-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .r-count { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }
  .sys { font-size: var(--text-xs); font-weight: var(--font-weight-bold); text-transform: uppercase; padding: var(--space-1) var(--space-1); border-radius: var(--radius-sm); color: var(--info); background: var(--tone-info-bg); }
</style>

{#while-loading of list}
  <div class="trigger" data-test="skeleton"><sui-skeleton shape="line" size="sm"></sui-skeleton></div>
{/while-loading}
{#if list().kind === 'ok'}
  <button
    class="trigger" type="button" part="trigger" data-test="trigger"
    data-action="toggle" aria-haspopup="listbox" aria-expanded={open() ? 'true' : 'false'}
  >
    <span class="t-label" data-empty={activeLabel() ? 'false' : 'true'} data-test="label">
      {activeLabel() ? activeLabel() : placeholder()}
    </span>
    <span class="chev" aria-hidden="true">▾</span>
  </button>
  {#if open()}
    <div class="menu" part="menu" role="listbox" data-test="menu">
      {#for c of rows() key={c.id}}
        <button
          class="row" type="button" role="option" part="row" data-test="row"
          class:active={c.id === active()}
          aria-selected={c.id === active() ? 'true' : 'false'}
          data-id={c.id}
        >
          <span class="r-name">{c.name}</span>
          {#if c.system}<span class="sys">system</span>{/if}
          <span class="r-count">{c.item_count}</span>
        </button>
      {/for}
    </div>
  {/if}
{/if}
