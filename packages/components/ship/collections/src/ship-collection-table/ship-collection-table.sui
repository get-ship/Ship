<!--
  <ship-collection-table> — @ship/collections · the data explorer.
  Reads ship.collections.state({collection}) for the schema (columns)
  and ship.collections.items({collection}) for paginated rows. Emits
  ship-collection-row-select { collection, id } on row click.

  Column derivation is schema-driven: each field in the schema becomes
  a column on the underlying <sui-table>. The `id` column is added by
  default (the substrate envelope) so rows are selectable.

  Live updates are gated by the daemon's Watch; until the SDK exposes
  ship.collections.watch, this surface re-queries on each data call.
  See KNOWN_GAPS.md.

  Tag prefix `ship-*` marks this component as depending on the Ship
  runtime: mounting without a host that has called setShipClient()
  will throw on the first SDK access.
-->
<prop name="collection" type="string" default="" />

<style>
  :host { display: block; font-family: var(--font-body); }
  :host([hidden]) { display: none; }

  .empty {
    padding: var(--space-6);
    text-align: center;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
  .footer {
    display: flex; align-items: center; gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--divider);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }
  .footer .count { font-family: var(--font-mono); }
  .footer .more { margin-left: auto; }
</style>

{#while-loading of state}
  <sui-skeleton shape="line" size="lg"></sui-skeleton>
{/while-loading}
{#while-error err of state}
  <sui-error-state title="Couldn't load collection">{err.message}</sui-error-state>
{/while-error}
{#if state().kind === 'ok' && state().value}
  {#while-loading of items}
    <sui-skeleton shape="line" size="md"></sui-skeleton>
  {/while-loading}
  {#while-error err of items}
    <sui-error-state title="Couldn't load items" variant="inline">{err.message}</sui-error-state>
  {/while-error}
  {#if items().kind === 'ok'}
    {#if rows().length === 0}
      <div class="empty" data-test="empty">No items in {state().value.schema.name}.</div>
    {:else}
      <sui-table
        variant="data"
        prop:rows={rows()}
        prop:columns={columnDefs()}
        hoverable
        striped
        data-test="grid"
      ></sui-table>
    {/if}
    <div class="footer" data-test="footer">
      <span class="count">{rows().length} / {state().value.total_items}</span>
      <span class="more">{collection()}</span>
    </div>
  {/if}
{/if}
