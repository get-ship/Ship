<!--
  <ship-schema-editor> — @ship/collections · author/edit a
  collection's schema. Both a guided field-list and a raw editor
  surface (toggle). Calls ship.collections.create or
  ship.collections.update_schema via the controller; surfaces the
  reproject warning when an UpdateSchema change rebuilds the
  projection from the event log (data preserved, column dropped).

  Emits ship-schema-save { id, fields } on confirm. The reproject
  warning is part of the spec's hard requirement — see spec.md
  §"sui-schema-editor" and the errors fixture `reproject_warning`.

  Tag prefix `ship-*` marks this component as depending on the Ship
  runtime: mounting without a host that has called setShipClient()
  will throw on the first SDK access.

  Interactions route through a single delegated listener on the
  host (see controller). Each row carries data-uid and each
  interactive control carries data-test="..." so the listener
  routes by name — the template stays free of `$event`-style
  handler args.
-->
<prop name="id" type="string" default="" />
<prop name="view" values="guided|raw" default="guided" reflect />

<style>
  :host { display: block; font-family: var(--font-body); color: var(--foreground); }
  :host([hidden]) { display: none; }

  .head {
    display: flex; align-items: center; gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .head h3 { margin: 0; font-size: var(--text-md); font-weight: var(--font-weight-semibold); }
  .toggle { margin-left: auto; display: inline-flex; gap: var(--space-1); padding: var(--space-1); background: var(--muted); border-radius: var(--radius-sm); }
  .toggle button {
    font: inherit; font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm);
    color: var(--muted-foreground);
  }
  .toggle button[aria-pressed='true'] { background: var(--surface-1); color: var(--foreground); box-shadow: var(--shadow-xs); }

  .body { padding: var(--space-4); background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--radius-md); }

  .field-row {
    display: grid; grid-template-columns: 2fr 1fr repeat(3, auto) auto;
    gap: var(--space-2);
    align-items: center;
  }
  .field-row input, .field-row select {
    font: inherit; font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--background); color: var(--foreground);
  }
  .field-row .checks { display: flex; gap: var(--space-2); }
  .field-row .remove {
    appearance: none; cursor: pointer; border: 0; background: transparent;
    color: var(--destructive);
    font-size: var(--text-sm);
    padding: 0 var(--space-2);
  }
  .add-row { margin-top: var(--space-2); }

  .warning {
    padding: var(--space-3);
    background: var(--tone-warning-bg);
    border: 1px solid var(--tone-warning-border);
    border-radius: var(--radius-sm);
    color: var(--warning);
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  .warning strong { display: block; margin-bottom: var(--space-1); color: var(--foreground); }

  .actions { display: flex; gap: var(--space-2); margin-top: var(--space-3); justify-content: flex-end; }
</style>

{#while-loading of detail}
  <sui-skeleton shape="line" size="lg"></sui-skeleton>
{/while-loading}
{#while-error err of detail}
  <sui-error-state title="Couldn't load schema" variant="inline">{err.message}</sui-error-state>
{/while-error}
{#if detail().kind === 'ok'}
  <div class="head">
    <h3 data-test="editor-title">{id() || 'New collection'}</h3>
    <div class="toggle" role="tablist">
      <button type="button" role="tab" data-test="view-guided" aria-pressed={view() === 'guided' ? 'true' : 'false'}>guided</button>
      <button type="button" role="tab" data-test="view-raw" aria-pressed={view() === 'raw' ? 'true' : 'false'}>raw</button>
    </div>
  </div>
  <div class="body">
    {#if view() === 'raw'}
      <sui-textarea
        prop:value={rawJson()}
        prop:variant={'code'}
        prop:rows={14}
        data-test="raw"
      ></sui-textarea>
    {:else}
      <sui-stack gap="2" data-test="fields">
        {#for f of fields() key={f.name || f.uid}}
          <div class="field-row" data-test="field" data-uid={f.uid}>
            <input
              type="text"
              placeholder="name"
              value={f.name}
              data-test="name"
            />
            <select
              value={f.type}
              data-test="type"
            >
              <option value="text">text</option>
              <option value="integer">integer</option>
              <option value="real">real</option>
              <option value="bool">bool</option>
              <option value="timestamp">timestamp</option>
              <option value="json">json</option>
            </select>
            <label class="checks" data-test="required"><input type="checkbox" checked={f.required} /> req</label>
            <label class="checks" data-test="indexed"><input type="checkbox" checked={f.indexed} /> idx</label>
            <label class="checks" data-test="unique"><input type="checkbox" checked={f.unique} /> uniq</label>
            <button class="remove" type="button" data-test="remove" aria-label="Remove field">×</button>
          </div>
        {/for}
      </sui-stack>
       <div class="add-row">
        <sui-button variant="ghost" size="sm" type="button" data-test="add">+ Add field</sui-button>
      </div>
    {/if}
    {#if reprojectWarning()}
      <div class="warning" data-test="reproject-warning" role="alert">
        <strong>Reproject</strong>
        Removing or renaming a field rebuilds the projection from the
        event log. Existing item data is preserved; the column is
        dropped from the table. Continue?
      </div>
    {/if}
    <div class="actions">
      <sui-button variant="solid" tone="primary" type="button" data-test="save" loading={saving() ? true : false}>{id() ? 'Save schema' : 'Create collection'}</sui-button>
    </div>
  </div>
{/if}
