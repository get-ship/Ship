<!--
  <ship-git-diff-file> — SUI port of <ship-git-diff-file>.

  Per-file collapsible header with the path + +/- counts. Slots the
  file's <ship-git-diff-hunk> + <ship-git-diff-line> children below.

  Prop / event / slot parity vs <ship-git-diff-file>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                          SUI                      Notes
  ─────────────────────────────────────────────────────────────────────────────
  path (string, '')            path (string, '',        ✓ reflects
                                  reflect)
  additions (number, 0)        additions (number, 0,    ✓ reflects
                                  reflect)
  deletions (number, 0)        deletions (number, 0,    ✓ reflects
                                  reflect)
  collapsed (bool, false)      collapsed (bool, false,  ✓ reflects, hides
                                  reflect)                  body via CSS
  ─────────────────────────────────────────────────────────────────────────────
  role=group + aria-label      controller effect        ✓
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="path" type="string" default="" reflect />
<prop name="additions" type="number" default="0" reflect />
<prop name="deletions" type="number" default="0" reflect />
<prop name="collapsed" type="bool" default="false" reflect />

<style>
  :host {
    display: block;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 35%, transparent);
  }
  :host([hidden]) { display: none; }
  .header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: 6px var(--space-3);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--border-subtle);
    text-align: left;
    cursor: pointer;
    color: var(--foreground);
    transition: background var(--duration-fast) ease;
    font-family: inherit;
  }
  .header:hover { background: color-mix(in oklch, var(--muted) 40%, transparent); }
  .chev { color: var(--muted-foreground); flex-shrink: 0; }
  .fileicon { color: var(--muted-foreground); flex-shrink: 0; }
  .path {
    flex: 1;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .stats { display: inline-flex; align-items: center; gap: var(--space-2); flex-shrink: 0; }
  .adds, .dels {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 10px;
    font-family: var(--font-mono);
  }
  .adds { color: var(--success); }
  .dels { color: var(--destructive); }
  .body { display: block; }
  :host([collapsed]) .body { display: none; }
</style>

<button class="header" type="button" on:click={toggle} aria-expanded={expandedLabel()}>
  <sui-icon class="chev" size="sm" name={chevIcon()}></sui-icon>
  <sui-icon class="fileicon" size="sm" name="file-code"></sui-icon>
  <span class="path">{path()}</span>
  <span class="stats">
    {#if additions() > 0}
      <span class="adds"><sui-icon size="sm" name="plus"></sui-icon>{additions()}</span>
    {/if}
    {#if deletions() > 0}
      <span class="dels"><sui-icon size="sm" name="minus"></sui-icon>{deletions()}</span>
    {/if}
  </span>
</button>
<div class="body"><slot></slot></div>
