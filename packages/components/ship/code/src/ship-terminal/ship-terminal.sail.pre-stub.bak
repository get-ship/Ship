<controller>
/**
 * Paired controller for <ship-terminal>.
 *
 * Pattern established here for all future imperative-engine SUI ports
 * (markdown-editor, code-editor, etc.):
 *
 *   1. bind:this={ref} in the template → Signal<El|null> in Scope.
 *   2. controller(def).mount runs AFTER template renders; access the ref via
 *      `state.$signals.ref()` — $signals exposes the underlying Signals
 *      (callable) even though MutableState<Scope> unwraps them to value types.
 *   3. Wire engine events → host.dispatchEvent (Option A bridge).
 *   4. Return the cleanup function from mount; the compiler wires it into
 *      __cleanups so disconnect tears everything down.
 *   5. Use effect() inside mount for reactive prop changes (theme, fontSize).
 *
 * Search overlay is DEFERRED: it needs controller.on handlers to mutate the
 * searchOpen/searchQuery state signals, which requires the on-handler writable
 * proxy to see $scope's signals at call time. The wiring is in place (ctx.scope
 * is passed before setup runs) but search requires the SearchAddon to survive
 * across multiple handler invocations — a WeakMap on host could bridge that.
 * Filed as a follow-up for the next imperative-engine port.
 */

import { controller, effect } from '@ship/sail-runtime'
import type { Signal } from '@ship/sail-runtime'

// Import Scope from the compiler-emitted .d.ts (produced alongside the .sail).
// This module resolves after the deck bundler compiles the template; typecheck
// fails before first build — that is expected.
import type { Scope } from './ship-terminal.sail'

// xterm.js is bundled eagerly into sui-components.js by esbuild. Dynamic
// imports are used in the Lit original to keep ship-terminal.js lazy; here
// the component is part of the components bundle so eager import is fine.
import { Terminal } from '@xterm/xterm'
import { FitAddon } from '@xterm/addon-fit'
import { WebLinksAddon } from '@xterm/addon-web-links'
import { WebglAddon } from '@xterm/addon-webgl'

const MONO_STACK =
  "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"

// Minimal xterm-internal CSS needed for canvas layer positioning inside a
// shadow root. xterm.js injects its own sheet into `document.head` which
// is unreachable from a closed shadow tree; we adopt an equivalent sheet.
const XTERM_SHADOW_CSS = `
.xterm { position: relative; user-select: none; }
.xterm.focus, .xterm:focus { outline: none; }
.xterm .xterm-helpers { position: absolute; top: 0; z-index: 5; }
.xterm .xterm-helper-textarea {
  padding: 0; border: 0; margin: 0;
  position: absolute; opacity: 0; left: -9999em; top: 0;
  width: 0; height: 0; z-index: -5;
  white-space: nowrap; overflow: hidden; resize: none;
}
.xterm .composition-view { display: none; position: absolute; white-space: nowrap; z-index: 1; }
.xterm .xterm-viewport {
  background-color: transparent !important;
  overflow-y: scroll; cursor: default;
  position: absolute; right: 0; left: 0; top: 0; bottom: 0;
}
.xterm .xterm-screen { position: relative; }
.xterm .xterm-screen canvas { position: absolute; left: 0; top: 0; }
.xterm .xterm-decoration-container { position: absolute; top: 0; left: 0; right: 0; }
`

/** Fallback palette when CSS custom properties are unavailable (JSDOM). */
const THEME_FALLBACKS: Record<string, string> = {
  background: '#fafaf9',
  foreground: '#1c1917',
  cursor: '#c2410c',
  cursorAccent: '#fafaf9',
  black: '#78716c',
  red: '#dc2626',
  green: '#16a34a',
  yellow: '#ca8a04',
  blue: '#2563eb',
  magenta: '#9333ea',
  cyan: '#0891b2',
  white: '#1c1917',
  brightBlack: '#a8a29e',
  brightRed: '#ef4444',
  brightGreen: '#22c55e',
  brightYellow: '#eab308',
  brightBlue: '#3b82f6',
  brightMagenta: '#a855f7',
  brightCyan: '#06b6d4',
  brightWhite: '#fafaf9',
}

const TOKEN_MAP: Record<string, string> = {
  background: '--background',
  foreground: '--foreground',
  cursor: '--primary',
  cursorAccent: '--background',
  black: '--muted-foreground',
  red: '--destructive',
  green: '--success',
  yellow: '--warning',
  blue: '--info',
  magenta: '--accent',
  cyan: '--info',
  white: '--foreground',
}

/// xterm.js's WebGL renderer can't parse modern color syntaxes (oklch,
/// color-mix, lab). All Ship design tokens are oklch, so passing them
/// through unresolved makes WebGL fall back to white — the terminal
/// looks light-on-light in every dark theme.
///
/// Convert via the browser's actual color parser: set the value as a
/// real `color` on a probe element, then read the computed value, which
/// browsers always normalize to `rgb()` / `rgba()`. Cheap (one DOM
/// append per token per refresh) and works for every CSS color syntax.
// Canvas reused across normalizeColor calls — creating a fresh canvas
// every paint is expensive enough to show up under profiling.
let __colorCanvas: HTMLCanvasElement | null = null
let __colorCtx: CanvasRenderingContext2D | null = null

function normalizeColor(_host: HTMLElement, value: string): string {
  if (!value) return value
  // Pure rgb/hex values don't need normalization. Allow `hsl` through —
  // xterm's WebGL parser handles it natively.
  if (/^#|^rgb|^hsl/i.test(value)) return value
  // CSS Color 4 syntaxes (oklch, color-mix, lab, …) crash xterm's WebGL
  // renderer — it parses with a legacy rgb()/hex parser. Convert via the
  // 2d canvas, which is the only browser API that always returns
  // `rgba(r, g, b, a)` regardless of input color syntax. getComputedStyle
  // alone is not enough: recent Chromium versions return oklch() verbatim
  // from CSS Color 4 inputs.
  try {
    if (!__colorCtx) {
      __colorCanvas = document.createElement('canvas')
      __colorCanvas.width = 1
      __colorCanvas.height = 1
      __colorCtx = __colorCanvas.getContext('2d')
    }
    if (!__colorCtx) return value
    __colorCtx.fillStyle = '#000'
    __colorCtx.fillStyle = value
    // After assignment, fillStyle is always a string in #rrggbb or
    // rgba(r,g,b,a) form — never the original input syntax.
    return __colorCtx.fillStyle as string
  } catch {
    return value
  }
}

function buildTheme(host: HTMLElement): Record<string, string> {
  const theme: Record<string, string> = { ...THEME_FALLBACKS }
  const cs = getComputedStyle(host)
  for (const [key, cssVar] of Object.entries(TOKEN_MAP)) {
    const val = cs.getPropertyValue(cssVar).trim()
    if (val) theme[key] = normalizeColor(host, val)
  }
  const primary = theme.cursor || THEME_FALLBACKS.cursor!
  // selectionBackground needs alpha; compute via color-mix and normalize.
  theme.selectionBackground = normalizeColor(
    host,
    `color-mix(in oklch, ${primary} 30%, transparent)`,
  )
  theme.brightBlack = theme.white!
  theme.brightRed = theme.red!
  theme.brightGreen = theme.green!
  theme.brightYellow = theme.yellow!
  theme.brightBlue = theme.blue!
  theme.brightMagenta = theme.magenta!
  theme.brightCyan = theme.cyan!
  theme.brightWhite = theme.background!
  return theme
}

function injectXtermCSS(shadow: ShadowRoot): void {
  try {
    const sheet = new CSSStyleSheet()
    sheet.replaceSync(XTERM_SHADOW_CSS)
    shadow.adoptedStyleSheets = [...shadow.adoptedStyleSheets, sheet]
  } catch {
    // CSSStyleSheet constructor or adoptedStyleSheets may not be available
  }
}

// No scope factory → legacy form (curried needs a scope return to infer SC).
export default controller<Scope>({
  mount(state, host) {
    // `state.$signals` exposes the raw Signal objects (callable / .set()).
    const s = state.$signals

    const hostEl = (s.termHost as Signal<HTMLDivElement | null>)()
    if (!hostEl) {
      console.warn('[ship-terminal] bind:this ref is null — xterm.js not initialized')
      return
    }

    const shadow = host.shadowRoot
    if (shadow) injectXtermCSS(shadow)

    const readonly = (s.readonly as Signal<boolean>)()
    const rows = (s.rows as Signal<number>)()
    const cols = (s.cols as Signal<number>)()
    const rawSize = (s.fontSize as Signal<number>)()
    const fontSize = rawSize > 0 ? rawSize : resolveTokenFontSize(host)

    const term = new Terminal({
      rows,
      cols,
      fontSize,
      fontFamily: MONO_STACK,
      theme: buildTheme(host),
      cursorBlink: !readonly,
      disableStdin: readonly,
      allowProposedApi: true,
      convertEol: true,
    })

    const fit = new FitAddon()
    term.loadAddon(fit)
    term.loadAddon(new WebLinksAddon())

    // Prefer WebGL renderer to avoid canvas first-row corruption in shadow DOM.
    // Guard with an explicit WebGL2 probe first — the addon activation error
    // propagates asynchronously through xterm's event bus (can't be caught with
    // try/catch after the fact) so we must skip the addon entirely in headless /
    // no-WebGL environments.
    const __testCanvas = document.createElement('canvas')
    if (__testCanvas.getContext('webgl2')) {
      try {
        const webgl = new WebglAddon()
        webgl.onContextLoss(() => { webgl.dispose() })
        term.loadAddon(webgl)
      } catch {
        // WebGL init failed — canvas fallback
      }
    }

    // Delay open() until the container has layout to avoid garbled glyphs.
    requestAnimationFrame(() => {
      if (!host.isConnected) return
      term.open(hostEl)
      if ((s.fit as Signal<boolean>)()) fit.fit()
    })

    // Bridge engine events → host CustomEvents (Option A pattern).
    const dataDisposer = term.onData((data) =>
      host.dispatchEvent(
        new CustomEvent('ship-terminal-data', { detail: { data }, bubbles: true, composed: true }),
      ),
    )
    const keyDisposer = term.onKey(({ key, domEvent }) =>
      host.dispatchEvent(
        new CustomEvent('ship-terminal-key', { detail: { key, domEvent }, bubbles: true, composed: true }),
      ),
    )
    // PTY rows/cols must mirror the rendered grid or `tput cols` and
    // any TUI (vim, less, htop) draws to the wrong dimensions. The
    // FitAddon fires onResize each time the container changes size;
    // bridge it as a host CustomEvent so terminal-bridge.ts can POST
    // the new geometry to the daemon's /resize endpoint.
    const resizeDisposer = term.onResize(({ cols, rows }) =>
      host.dispatchEvent(
        new CustomEvent('ship-terminal-resize', { detail: { cols, rows }, bubbles: true, composed: true }),
      ),
    )

    // Expose imperative API on the host element.
    const el = host as HTMLElement & {
      write?: ((s: string | Uint8Array) => void) | undefined
      writeln?: ((s: string) => void) | undefined
      clear?: (() => void) | undefined
      focus?: () => void
      fit?: (() => void) | undefined
      terminal?: Terminal | null
    }
    // PTY transports deliver bytes; accept Uint8Array so the bridge can
    // write base64-decoded chunks verbatim without an intermediate
    // (lossy) UTF-8 decode round-trip.
    el.write = (data: string | Uint8Array) => term.write(data)
    el.writeln = (str: string) => term.writeln(str)
    el.clear = () => term.clear()
    el.focus = () => term.focus()
    // Exposed for hosts whose layout settles AFTER the initial fit.fit()
    // call inside the rAF in this controller — e.g. a parent component
    // that wraps <ship-terminal> in a flex container. Without this, the
    // first fit measures a 0-height container and xterm sticks at a
    // handful of rows until the user manually triggers a resize.
    // Define directly on the instance to shadow the prototype accessor,
    // preventing the signal-based setter from being invoked.
    Object.defineProperty(el, 'fit', {
      value: () => { try { fit.fit() } catch { /* mid-teardown */ } },
      writable: false,
      enumerable: false,
      configurable: true,
    })
    el.terminal = term

    // Reactive prop updates via effect() — re-runs when signals change.
    const disposers: Array<() => void> = []

    if (!readonly) {
      const ro = new ResizeObserver(() => fit.fit())
      const fitSig = s.fit as Signal<boolean>
      disposers.push(effect(() => {
        if (fitSig()) {
          ro.observe(host)
        } else {
          ro.disconnect()
        }
      }))
      disposers.push(() => ro.disconnect())
    }

    disposers.push(effect(() => {
      term.options.theme = buildTheme(host)
      // Reading theme signal subscribes to changes.
      void (s.theme as Signal<string>)()
    }))

    disposers.push(effect(() => {
      const size = (s.fontSize as Signal<number>)()
      if (size > 0) {
        term.options.fontSize = size
        fit.fit()
      }
    }))

    host.dispatchEvent(
      new CustomEvent('ship-terminal-ready', { bubbles: true, composed: true }),
    )

    return () => {
      for (const d of disposers) d()
      dataDisposer.dispose()
      keyDisposer.dispose()
      resizeDisposer.dispose()
      el.write = undefined
      el.writeln = undefined
      el.clear = undefined
      // Leave el.focus alone — it shadows the native HTMLElement.focus and
      // nulling it would break focus() if the element outlives teardown.
      el.fit = undefined
      el.terminal = null
      try { term.dispose() } catch { /* teardown race */ }
    }
  },
})

function resolveTokenFontSize(host: HTMLElement): number {
  const raw = getComputedStyle(host).getPropertyValue('--text-sm').trim()
  const parsed = parseFloat(raw)
  return parsed > 0 ? parsed : 12
}
</controller>

<!--
  <ship-terminal> — SUI port of <ship-terminal>. First SUI component wrapping a
  third-party imperative engine (xterm.js). Establishes the canonical pattern:
    bind:this={ref} + controller(def).mount() + host.dispatchEvent bridge.

  Prop / event / method parity vs <ship-terminal>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                       SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  rows (Number, 24)         rows (number, 24)        ✓
  cols (Number, 80)         cols (number, 80)        ✓
  font-size (Number, 0)     font-size (number, 0)    ✓
  readonly (Boolean, false) readonly (bool, reflect) ✓
  theme (String, auto)      theme (union, reflect)   ✓
  fit (Boolean, false)      fit (bool, reflect)      ✓
  ─────────────────────────────────────────────────────────────────────────────
  write(data)               host.write(data)         ✓ imperative API on host
  writeln(data)             host.writeln(data)       ✓
  clear()                   host.clear()             ✓
  focus()                   host.focus()             ✓
  terminal (getter)         host.terminal            ✓ raw xterm.js instance
  ─────────────────────────────────────────────────────────────────────────────
  ship-data event           ship-terminal-data        ✓ renamed per SUI naming
  ship-ready event          ship-terminal-ready       ✓
  ship-key event            ship-terminal-key         ✓ (new; Lit omits key evt)
  ─────────────────────────────────────────────────────────────────────────────
  Search overlay            DEFERRED                 controller.on state
                                                     mutation requires broader
                                                     framework work; annotated
                                                     in ship-terminal.ts.
  SearchAddon               DEFERRED                 same reason
  ─────────────────────────────────────────────────────────────────────────────
  parts: wrap              ✓
  ─────────────────────────────────────────────────────────────────────────────
  canvas-fallback class     omitted                  WebGL is preferred; canvas
                                                     row-clip workaround not
                                                     ported until needed.
  ─────────────────────────────────────────────────────────────────────────────
-->

<!-- <prop name="rows" type="number" default="24" /> -->
<!-- <prop name="cols" type="number" default="80" /> -->
<!-- <prop name="font-size" type="number" default="0" /> -->
<!-- <prop name="readonly" type="bool" default="false" reflect /> -->
<!-- <prop name="theme" values="light|dark|auto" default="auto" reflect /> -->
<!-- <prop name="fit" type="bool" default="false" reflect /> -->

<!-- style block removed: use sx / external CSS -->

<div
  bind:this={termHost}
  role={readonly() ? 'log' : 'terminal'}
  aria-label={readonly() ? 'Log output' : 'Terminal'}
  aria-readonly={readonly() ? 'true' : null}
></div>
