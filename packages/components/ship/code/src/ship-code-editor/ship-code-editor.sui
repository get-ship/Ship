<!--
  <ship-code-editor> — SUI island: CodeMirror 6 wrapped as a lazy-loaded
  web-component. Language extensions are dynamic-imported when `language`
  is set, keeping the base bundle light.

  Prop / event / method parity vs <ship-code-editor>
  ──────────────────────────────────────────────────────────────────────────
  Lit                            SUI                     Notes
  ──────────────────────────────────────────────────────────────────────────
  value (String, '')             value (string, '',      ✓ form-associated
                                   form-value)
  language (SupportedLang)       language (string, '')   ✓ dynamic import
  placeholder (String, '')       placeholder (string)    ✓
  readonly (Boolean, false)      readonly (bool,         ✓
                                   reflect)
  line-numbers (Boolean, true)   line-numbers (bool,     ✓ default true
                                   reflect)
  size (sm|md|lg, md)            size (union, md,        ✓
                                   reflect)
  tone (Tone, default)           tone (union, default,   ✓ focus ring
                                   reflect)
  theme (light|dark|auto, auto)  theme (union, auto,     ✓
                                   reflect)
  ──────────────────────────────────────────────────────────────────────────
  ship-change                    sui-change              ✓ debounced 150ms
  ship-save                      sui-save                ✓ Mod-s
  ship-cancel                    sui-cancel              ✓ Escape
  input                          input                   ✓ native bubbling
  ──────────────────────────────────────────────────────────────────────────
  setDiagnostics(diags)          host.setDiagnostics     ✓ imperative API
  focus()                        host.focus()            ✓
  ──────────────────────────────────────────────────────────────────────────
-->

<prop name="value" type="string" default="" form-value />
<prop name="language" type="string" default="" />
<prop name="placeholder" type="string" default="" />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="line-numbers" type="bool" default="true" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="tone" values="default|info|success|warning|destructive" default="default" reflect />
<prop name="theme" values="light|dark|auto" default="auto" reflect />

<style>
  :host {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--card);
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: var(--text-sm, 13px);
    line-height: 1.6;
  }
  :host([hidden]) { display: none; }
  :host([size="sm"]) { font-size: var(--text-xs, 11px); line-height: 1.5; }
  :host([size="lg"]) { font-size: var(--text-base, 14px); line-height: 1.7; }

  :host([tone="info"])        { --_focus-ring: var(--tone-info-border); }
  :host([tone="success"])     { --_focus-ring: var(--tone-success-border); }
  :host([tone="warning"])     { --_focus-ring: var(--tone-warning-border); }
  :host([tone="destructive"]) { --_focus-ring: var(--tone-destructive-border); }

  :host(:focus-within) {
    outline: 2px solid var(--_focus-ring, var(--ring));
    outline-offset: 1px;
  }

  .editor-root {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .editor-root .cm-editor { height: 100%; }
  .editor-root .cm-scroller { overflow: auto; }

  @media (forced-colors: active) {
    :host { outline: 1px solid CanvasText; }
  }
</style>

<div
  class="editor-root"
  part="editor"
  bind:this={editorHost}
></div>
