<!--
  <ship-code-editor> — editable code surface backed by vendored CodeMirror 6.

  The historical Lit <ship-code> renderer became <sui-code> (read-only display);
  the editable tag is <ship-code-editor>. CM6's EditorView mounts into the
  bind:this div below — that DOM is the engine's, not controller innerHTML
  (the canvas / sui-terminal precedent). The controller wires props ↔ engine via
  a MutationObserver on the reflected attrs and bridges the engine's onChange /
  onSave callbacks to host events.

  Props / events
  ──────────────────────────────────────────────────────────────────────────
  value         string             initial document (seeds the doc)
  language      string  reflect    CM language id (typescript|json|… ; see languages.ts)
  readonly      bool    reflect    blocks edits (EditorState.readOnly)
  theme         light|dark reflect token theme (light/dark)
  line-numbers  bool               gutter (default true)
  line-wrap     bool    reflect    soft-wrap long lines
  tab-size      number             indent width in spaces (default 2)
  placeholder   string  reflect    empty-doc hint (CM placeholder extension)
  label         string             aria-label for the textbox region
  ──────────────────────────────────────────────────────────────────────────
  ship-code-change { value }  debounced 200ms on doc edit
  ship-code-save   { value }  on Mod-s
-->

<prop name="value" type="string" default="" />
<prop name="language" type="string" default="" reflect />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="theme" values="light|dark" default="light" reflect />
<prop name="line-numbers" type="bool" default="true" />
<prop name="line-wrap" type="bool" default="false" reflect />
<prop name="tab-size" type="number" default="2" />
<prop name="placeholder" type="string" default="" reflect />
<prop name="label" type="string" default="" />

<style>
  :host {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
    overflow: hidden;
  }
  :host([hidden]) { display: none; }

  .editor {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .editor .cm-editor {
    height: 100%;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .editor .cm-editor.cm-focused {
    outline: none;
  }

  .editor .cm-scroller {
    line-height: var(--leading-normal);
  }

  @media (forced-colors: active) {
    :host { outline: 1px solid CanvasText; }
  }
</style>

<div
  class="editor"
  part="editor"
  role="textbox"
  aria-multiline="true"
  aria-label={label()}
  aria-readonly={readonly() ? 'true' : null}
  bind:this={hostEl}
></div>
