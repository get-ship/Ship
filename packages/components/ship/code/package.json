{
  "name": "@ship/code",
  "version": "0.1.0",
  "description": "Ship Code pack — ship-* components for code surfaces: <ship-code-editor> (CodeMirror 6), <ship-terminal> (xterm.js PTY), and the <ship-git-diff> unified-diff tree. Presentational wrappers over third-party engines; no Ship SDK dep.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "deck": {
    "bundles": [
      {
        "name": "ship-code-editor",
        "entry": "src/index.ts",
        "externals": ["@ship/sui-runtime", "@ship/sui-dom"],
        "lazy": true
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sui-runtime": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/sui-primitives": "workspace:*",
    "@ship/sui-lsp-browser": "workspace:*",
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
