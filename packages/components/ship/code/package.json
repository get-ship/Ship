{
  "name": "@ship/code",
  "version": "0.1.0",
  "description": "Ship Code pack — <ship-code-editor> editable code surface backed by a vendored CodeMirror 6. Pure renderers stay sui-*; this pack carries the heavyweight (vendored) editor engine.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sui-dom": "workspace:*",
    "@ship/sui-runtime": "workspace:*",
    "@ship/sui-primitives": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
