<!--
  <ship-pipeline-graph> — the run-graph surface. Renders a JSON DAG as a
  bespoke, hand-rolled horizontal stage flow: each step is a node with a
  status dot + progress bar, joined by completion-tinted connectors. Status
  and gate visuals map to ship tone tokens (success · info · warning ·
  destructive · muted); optional blast tiers C0–C3 escalate through the
  same ramp. Prop-driven only — no SDK calls.

  Props:  steps  — JSON array of { id, label?, state?, sub?, after?, progress?, blast? }
          name   — pipeline name (header)
          status — passing|failing|running|none (header badge)
          run    — run-meta string (header, right-aligned)
  Events: ship-select { node } — a node was activated (click / Enter / Space)
  Parts:  graph · header · flow
-->
<prop name="steps" type="string" default="[]" reflect />
<prop name="name" type="string" default="" />
<prop name="status" values="passing|failing|running|none" default="none" reflect />
<prop name="run" type="string" default="" />

<style>
  :host { display: block; --status: var(--muted-foreground); }
  :host([hidden]) { display: none; }
  :host([status='passing']) { --status: var(--success); }
  :host([status='failing']) { --status: var(--destructive); }
  :host([status='running']) { --status: var(--info); }

  .pl { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }

  .hd { display: flex; align-items: center; gap: 10px; padding: 14px var(--space-5); border-bottom: 1px solid var(--border-subtle); }
  .nm { font-family: var(--font-mono); font-weight: 600; font-size: var(--text-md); color: var(--foreground); }
  .nm:empty { display: none; }
  .badge { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: var(--radius-full); background: color-mix(in oklch, var(--status) 16%, transparent); color: color-mix(in oklch, var(--status) 80%, var(--foreground)); }
  :host([status='none']) .badge { display: none; }
  .runmeta { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .runmeta:empty { display: none; }

  .flow { display: flex; align-items: stretch; padding: var(--space-5); overflow-x: auto; }

  /* Hand-rolled nodes (rendered by the controller via bindHtml). */
  .node { flex: 0 0 auto; min-width: 158px; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-xs); cursor: pointer; transition: border-color var(--duration-fast) var(--ease-out, ease); }
  .node:hover { border-color: var(--border-strong); }
  .node:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .node .row { display: flex; align-items: center; gap: 8px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; background: var(--muted-foreground); }
  .lbl { font-size: var(--text-sm); font-weight: 600; color: var(--foreground); }
  .sub { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .sub:empty { display: none; }

  /* State → tone ramp. */
  .node.st-done .dot { background: var(--success); }
  .node.st-failed .dot { background: var(--destructive); }
  .node.st-queued .dot { background: var(--muted-foreground); }
  .node.st-awaiting { border-color: color-mix(in oklch, var(--warning) 45%, transparent); }
  .node.st-awaiting .dot { background: var(--warning); }
  .node.st-running { border-color: color-mix(in oklch, var(--info) 45%, transparent); }
  .node.st-running .dot { background: var(--info); }
  @media (prefers-reduced-motion: no-preference) {
    .node.st-running .dot { animation: pl-pulse 1.5s var(--ease-out, ease) infinite; }
  }
  @keyframes pl-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in oklch, var(--info) 55%, transparent); }
    70%  { box-shadow: 0 0 0 7px color-mix(in oklch, var(--info) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .bar { height: 3px; border-radius: 2px; background: var(--muted); overflow: hidden; }
  .bar > i { display: block; height: 100%; border-radius: 2px; width: 0; background: var(--muted-foreground); }
  .node.st-done .bar > i { width: 100%; background: var(--success); }
  .node.st-running .bar > i { width: 62%; background: var(--info); }
  .node.st-awaiting .bar > i { background: var(--warning); }
  .node.st-failed .bar > i { background: var(--destructive); }

  /* Blast tiers C0–C3 — escalating tone ramp (gate/blast-radius badge). */
  .blast { margin-left: auto; font-family: var(--font-mono); font-size: 9px; font-weight: 700; letter-spacing: .04em; padding: 1px 5px; border-radius: var(--radius-sm); border: 1px solid; }
  .blast.bl-C0 { color: var(--muted-foreground); border-color: color-mix(in oklch, var(--muted-foreground) 40%, transparent); }
  .blast.bl-C1 { color: var(--info); border-color: color-mix(in oklch, var(--info) 45%, transparent); }
  .blast.bl-C2 { color: var(--warning); border-color: color-mix(in oklch, var(--warning) 50%, transparent); }
  .blast.bl-C3 { color: var(--destructive); border-color: color-mix(in oklch, var(--destructive) 55%, transparent); }

  .conn { flex: 0 0 26px; align-self: center; height: 2px; background: var(--border); }
  .conn.done { background: color-mix(in oklch, var(--success) 55%, transparent); }

  .empty { padding: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); text-align: center; }
</style>

<div class="pl" part="graph">
  <div class="hd" part="header">
    <span class="nm">{name()}</span>
    <span class="badge">{status()}</span>
    <span class="runmeta">{run()}</span>
  </div>
  <div class="flow" part="flow" bind:this={flowEl}></div>
</div>
