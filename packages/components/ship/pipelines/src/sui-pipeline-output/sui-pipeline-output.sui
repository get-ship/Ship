<!--
  <sui-pipeline-output> — per-step streaming output. Header (step + elapsed +
  live indicator) over a mono log body. Log lines are slotted; each line uses
  `.t` (timestamp) / `.tag` (channel) / `.text` structure with a line-state
  class (start|in|out|log|pending) the host styles via ::slotted.

  Props:  streaming
  Slots:  step = step name · meta = elapsed/meta · default = log lines
  Parts:  output · header · body
-->
<prop name="streaming" type="bool" default="false" reflect />

<style>
  :host { display: block; }
  :host([hidden]) { display: none; }

  .output {
    background: color-mix(in oklch, var(--muted) 70%, var(--card));
    border: 1px solid var(--border); border-radius: var(--radius-md);
    padding: 10px 12px; font-family: var(--font-mono); font-size: 10.5px; line-height: 1.55;
    display: flex; flex-direction: column; gap: 2px; min-height: 0; overflow: hidden;
  }
  .header { display: flex; gap: 8px; align-items: baseline; padding-bottom: 4px; margin-bottom: 4px; border-bottom: 1px solid var(--border); color: var(--muted-foreground); }
  .step { color: var(--muted-foreground); }
  .meta { color: var(--muted-foreground); }
  .meta:not(:has(::slotted(*))) { display: none; }
  .streaming {
    display: none; margin-left: auto; align-items: center; gap: 5px; color: var(--info);
    animation: pl-pulse 1.6s ease-in-out infinite;
  }
  :host([streaming]) .streaming { display: inline-flex; }
  .streaming::before { content: '●'; }

  .body { display: flex; flex-direction: column; gap: 2px; min-height: 0; }
</style>

<div class="output" part="output">
  <div class="header" part="header">
    <span class="step"><slot name="step"></slot></span>
    <span class="meta"><slot name="meta"></slot></span>
    <span class="streaming">streaming</span>
  </div>
  <div class="body" part="body"><slot></slot></div>
</div>
