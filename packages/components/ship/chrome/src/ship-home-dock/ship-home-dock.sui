<!--
  ship-home-dock.sui — @ship/chrome · the desktop launcher dock.

  A centered, glassmorphic tray that composes <ship-dock-app> tiles — one per
  app in the `apps` identity array (each `{ label, icon, href }`). The tile
  owns the lift; this tray owns the glass surface, the hover scale, and the
  tooltip pill. Launch flows through <ship-dock-app>'s bubbling, composed
  `ship-launch { label }` event; the host maps label → href and navigates
  (the dock stays route-agnostic so any desktop can reuse it).

  `apps` is a JS-property (identity) binding — `prop:apps={…}` — not a
  serialized attribute, mirroring <sui-tree-view>'s `nodes`. The controller
  owns the signal and reflects the host property onto it.

  Tokens only: glass surface from --card + color-mix translucency, --border,
  --shadow-md, --radius-*; pill from --foreground/--background + --font-mono.
-->

<style>
  :host { display: inline-block; }

  .tray {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--surface-1) 65%, transparent);
    backdrop-filter: blur(20px) saturate(1.3);
    border: 1px solid color-mix(in oklch, var(--border) 80%, transparent);
    box-shadow: var(--shadow-md);
  }

  .slot { position: relative; display: inline-flex; }

  /* The tile (<ship-dock-app>) carries its own translateY lift; the tray
     adds a scale on hover so tiles "scale + lift" together (macOS dock). */
  ship-dock-app { transition: transform var(--duration-fast) var(--ease-out); }
  .slot:hover ship-dock-app { transform: scale(1.12); }

  .tip {
    position: absolute;
    bottom: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    background: var(--foreground);
    color: var(--background);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .slot:hover .tip { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .slot:hover ship-dock-app { transform: none; }
  }
</style>

<nav class="tray" part="tray" aria-label="App launcher">
  {#for app of apps() key={app.href}}
    <span class="slot">
      <ship-dock-app label={app.label}>
        <sui-icon name={app.icon} aria-hidden="true"></sui-icon>
      </ship-dock-app>
      <span class="tip" role="tooltip">{app.label}</span>
    </span>
  {/for}
</nav>
