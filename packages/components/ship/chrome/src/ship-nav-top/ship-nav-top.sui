<!--
  <ship-nav-top> — @ship/chrome · the filled top bar.
  Top strip: brand mark, project switcher, breadcrumb trail, per-view action
  slot, command-bar slot, theme picker, account menu, fullscreen toggle.

  Ported from apps/shell/src/components/sui-nav-top (the SUI port of the
  Lit <ship-nav-top>). The chrome-pack tag is `ship-nav-top`; the
  three-slot layout primitive stays under <sui-nav-top> in
  @ship/sui-primitives — these are distinct components and serve
  distinct roles (the primitive is a generic 3-slot bar; this is the
  filled shell bar).

  Prop / event surface
  ─────────────────────────────────────────────────────────────────────────────
  Props:
    path    (string, '')  current navigation path — auto-updated on sui:navigate
    project (string, '')  optional project label — when set, prepends a leading
                          home-linked breadcrumb segment (e.g. "Ship")
    view    (string, '')  optional explicit view name — when set, overrides the
                          path-derived root segment (humanized + label lookup
                          still apply). Lets the bar render correctly in
                          standalone harnesses where location.pathname is "/"
  ─────────────────────────────────────────────────────────────────────────────
  Events dispatched (bubbling, composed):
    sui:nav-top:ready {}  — fired once after first mount
  ─────────────────────────────────────────────────────────────────────────────
  Listens on document:
    sui:navigate  { detail: { to: string } }  — updates path + crumbs
  ─────────────────────────────────────────────────────────────────────────────
  Slots:
    actions      per-view action buttons injected by the mounted view
    command-bar  command palette host — shell slots <sui-command-bar> here
  ─────────────────────────────────────────────────────────────────────────────
  Parts: brand, project-switcher, crumbs, theme-picker, account-menu,
         fullscreen
  ─────────────────────────────────────────────────────────────────────────────
  CSS custom properties:
    --ship-top-bar-h (default 40px)  host height; matches layout grid row
  ─────────────────────────────────────────────────────────────────────────────
  Navigation: refactored from `chrome.navigate` (shell) to
  `navigate()` from @ship/deck/route — the chrome pack has no chrome
  import. The single source of navigation lives in the route module.

  Dock affordance: the shell previously polled `body.dock-open` via a
  MutationObserver to mirror the panel dock state. The dock itself is
  not ported to a chrome-pack component yet, and there is no
  `ship.dock.state()` SDK surface to source from, so the
  MutationObserver is dropped for v1. When the dock lands, reintroduce
  detection as `<data name="dockOpen" source="ship.dock.state()" live />`.
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="path" type="string" default="" />
<prop name="project" type="string" default="" />
<prop name="view" type="string" default="" />

<style>
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    height: var(--ship-top-bar-h, 40px);
    padding: 0 var(--space-3, 12px);
    border-bottom: 1px solid var(--border);
    background: var(--muted);
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: var(--text-sm, 13px);
    color: var(--foreground);
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
    box-sizing: border-box;
    flex-shrink: 0;
  }
  :host([hidden]) { display: none; }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm, 4px);
    color: var(--foreground);
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color var(--duration-fast, 100ms) var(--ease-out, ease-out);
  }
  .brand-mark {
    --ship-mark-size: 28px;
    display: block;
  }
  .brand:hover { background: color-mix(in oklch, var(--foreground) 8%, transparent); }
  .brand:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 50%, transparent);
  }

  .sep {
    width: 1px;
    height: 16px;
    background: var(--border);
    flex-shrink: 0;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    overflow: hidden;
    flex: 0 0 auto;
    max-width: 300px;
    font-size: var(--text-sm, 13px);
  }
  .crumbs a {
    color: var(--muted-foreground);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
    display: block;
  }
  .crumbs a:hover { color: var(--foreground); text-decoration: underline; }
  .crumbs .chevron { color: var(--muted-foreground); flex-shrink: 0; }
  .crumbs .current {
    color: var(--foreground);
    font-weight: var(--font-weight-medium, 500);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
    display: block;
  }

  .view-actions {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    flex-shrink: 0;
  }

  .spacer { flex: 1; min-width: 0; }

  .cmd-slot {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
</style>

<a class="brand" part="brand" href="/" aria-label="Ship home" title="Ship home" on:click={onBrand}>
  <sui-brand-mark class="brand-mark"></sui-brand-mark>
</a>
<span class="sep" aria-hidden="true"></span>
<sui-project-switcher part="project-switcher"></sui-project-switcher>
<span class="sep" aria-hidden="true"></span>
<nav class="crumbs" part="crumbs" aria-label="Breadcrumbs">
  {#for c of crumbs() key={c.key}}
    {#if c.isLast}
      <span class="current" id="breadcrumbs-title" transition:fade={{ duration: 120 }}>{c.label}</span>
    {:else}
      <a href={c.href} on:click={(e) => onCrumbClick(e, c.href)} transition:fade={{ duration: 120 }}>{c.label}</a>
      <span class="chevron" aria-hidden="true">›</span>
    {/if}
  {/for}
</nav>
<span class="view-actions"><slot name="actions"></slot></span>
<span class="spacer"></span>
<span class="cmd-slot"><slot name="command-bar"></slot></span>
<span class="spacer"></span>
<sui-theme-picker placement="bottom-end" part="theme-picker"></sui-theme-picker>
<sui-account-menu placement="bottom-end" part="account-menu"></sui-account-menu>
<sui-button variant="ghost" size="sm" part="fullscreen"
  title="Fullscreen (F11)" aria-label="Toggle fullscreen" on:click={onFullscreen}>
  <sui-icon slot="leading" name="maximize"></sui-icon>
</sui-button>
