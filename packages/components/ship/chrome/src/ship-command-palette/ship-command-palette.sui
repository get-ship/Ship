<!--
  <ship-command-palette> — @ship/chrome · harness shell for the command
  palette (the ⌘K experience). Renders the trigger pill + sui-dialog and
  wraps state in shared() so <ship-command-panel> and <ship-command-chat>
  consume it via useShared.

  Props   : open (bool, reflect), mode (string, reflect)
  Methods : show(mode?, query?), hide(), toggle(mode?), setMode(mode)
  Events  : sui-command:select  { detail: { mode, item } }  bubbles+composed
            sui-command:cancel  { detail: { mode } }         bubbles+composed
  Modes   : ai, command, find, mention, create
  Keyboard: ⌘K toggle, space+space open-ai, ↑/↓ navigate, Enter activate, Esc close
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="mode" type="string" default="ai" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    min-width: 200px;
    max-width: 320px;
  }

  /* ── Trigger pill ─────────────────────────────────────────────── */
  .cb-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--background);
    color: var(--muted-foreground);
    font: inherit;
    font-size: var(--text-xs, 12px);
    cursor: pointer;
    min-width: 200px;
    max-width: 320px;
    width: 100%;
    text-align: left;
    transition: border-color var(--duration-fast, 120ms) var(--ease-out, ease);
  }
  .cb-trigger:hover {
    border-color: color-mix(in oklch, var(--foreground) 30%, var(--border));
  }
  .cb-label { flex: 1; }
  .cb-trigger kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }

  /* ── Status dot ───────────────────────────────────────────────── */
  .cb-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--muted-foreground);
    flex-shrink: 0;
    display: inline-block;
  }

  /* ── Dialog host override ─────────────────────────────────────── */
  .cb-dialog::part(body) {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* ── Wrap (inside dialog body slot) ──────────────────────────── */
  .cb-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Footer hints (design delta from ship-command-bar.sui) ────── */
  .cb-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) 14px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted-foreground);
    flex: 0 0 auto;
    gap: var(--space-4);
  }
  .cb-footer b { color: var(--foreground); font-weight: 600; }
  .cb-foot-sep { opacity: 0.5; }
</style>

<button
  class="cb-trigger"
  type="button"
  aria-label="Open command bar"
  aria-haspopup="dialog"
  aria-controls="cb-dialog-root"
  aria-expanded={open() ? 'true' : 'false'}
  on:click={openFind}
>
  <sui-icon name="search" size="sm"></sui-icon>
  <span class="cb-label">{triggerLabel()}</span>
  <span class="cb-dot" style:background={dotBg()}></span>
  <kbd>⌘K</kbd>
</button>

<sui-dialog
  class="cb-dialog"
  id="cb-dialog-root"
  no-header
  no-footer
  no-close-button
  backdrop="blur"
  size="full"
  style="--dlg-max-w: min(840px, 94vw)"
  bind:this={dialogRef}
>
  <div class="cb-wrap">
    {#if isChat()}
      <ship-command-chat></ship-command-chat>
    {:else}
      <ship-command-panel></ship-command-panel>
    {/if}
    <div class="cb-footer" aria-hidden="true">
      <span>Type <b>/</b> for actions<span class="cb-foot-sep"> · </span><b>></b> to find<span class="cb-foot-sep"> · </span><b>@</b> to mention<span class="cb-foot-sep"> · </span><b>+</b> to create</span>
      <span><b>↵</b> confirm<span class="cb-foot-sep"> · </span><b>esc</b> dismiss<span class="cb-foot-sep"> · </span><b>⌘K</b> toggle</span>
    </div>
  </div>
</sui-dialog>
