<!--
  ship-command-bar.sui — @ship/chrome · the cmdk keystone. ★ the one chrome locus.

  Migrated from apps/shell/src/components/sui-command-bar/{sui-command-bar,
  sui-command-palette, sui-command-chat}.sui. The shell version was a
  three-component tree sharing state via `useShared`; the pack consolidates
  them into a single shadow root so the 4-mode keystone surface ships as
  one tag. Slotted custom children can still consume the shared scope
  through `useShared<CommandBarScope>(host, 'ship-command-bar')` — the
  host provisions it via `shared(...)` wrappers.

  Surface (4-mode keystone, preserved from the launch pack):
    Modes      : find · search · create · ai (reflected `mode` attribute)
    Props      : open (bool, reflect), mode (string, reflect)
    Methods    : show(mode?, query?) · hide() · toggle(mode?) · setMode(mode)
    Events     : ship-open / ship-close (⌘K · esc) · ship-mode-change {mode} ·
                 ship-submit {query, mode} (↵) · ship-select {id, kind, path}
    Document   : ship:bar:open {mode?, prefill?} · ship:create:open

  The shell's chrome.* refactor lands here: the audit drops
  `chrome.navigate` and `window.ship?.navigate`; the pack uses
  `navigate()` from `@ship/deck/router` instead.
-->

<prop name="open" type="bool" default="false" reflect />
<prop name="mode" type="string" default="ai" reflect />

<style>
  /* ── Host + trigger ─────────────────────────────────────────── */
  :host {
    display: inline-flex;
    align-items: center;
    min-width: 200px;
    max-width: 320px;
  }
  .cb-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--background);
    color: var(--muted-foreground);
    font: inherit;
    font-size: var(--text-xs, 12px);
    cursor: pointer;
    min-width: 200px;
    max-width: 320px;
    width: 100%;
    text-align: left;
    transition: border-color var(--duration-fast, 120ms) var(--ease-out, ease);
  }
  .cb-trigger:hover { border-color: color-mix(in oklch, var(--foreground) 30%, var(--border)); }
  .cb-label { flex: 1; }
  .cb-trigger kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
  }
  .cb-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--muted-foreground);
    flex-shrink: 0;
    display: inline-block;
  }

  /* ── Dialog host override ──────────────────────────────────── */
  .cb-dialog::part(body) {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .cb-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Panel (palette + chat) ────────────────────────────────── */
  .cb-panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Input row ─────────────────────────────────────────────── */
  .cb-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-mode-glyph {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--muted-foreground);
    flex-shrink: 0;
    min-width: 16px;
    text-align: center;
  }
  .cb-mode-glyph.ai {
    font-size: 10px;
    padding: 1px var(--space-1);
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
  }
  .cb-search {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font: inherit;
    font-size: var(--text-md);
    color: var(--foreground);
    caret-color: var(--foreground);
  }
  .cb-search::placeholder { color: var(--muted-foreground); }
  .cb-esc {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--muted);
    color: var(--muted-foreground);
    flex-shrink: 0;
  }

  /* ── Session chip + popover ────────────────────────────────── */
  .cb-chip-wrap { position: relative; flex-shrink: 0; }
  .cb-session-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 11px;
    color: var(--muted-foreground);
    cursor: pointer;
    user-select: none;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cb-session-chip:hover { background: var(--muted); }
  .cb-session-popover {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 280px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    box-shadow: var(--shadow-lg);
    z-index: var(--z-dropdown);
    padding: var(--space-1) 0;
    overflow: hidden;
  }
  .cb-session-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 7px var(--space-3);
    cursor: pointer;
    font-size: var(--text-sm);
  }
  .cb-session-row:hover { background: var(--muted); }
  .cb-session-row.current { background: color-mix(in oklch, var(--primary) 8%, transparent); }
  .cb-session-row .meta { color: var(--muted-foreground); font-size: 11px; }
  .cb-session-end {
    background: transparent; border: none; cursor: pointer;
    color: var(--muted-foreground); font-size: var(--text-md); padding: 0 2px;
  }
  .cb-session-end:hover { color: var(--destructive); }
  .cb-session-sep { height: 1px; background: var(--border); margin: var(--space-1) 0; }
  .cb-session-action {
    display: flex; align-items: center; gap: var(--space-2);
    padding: 7px var(--space-3); cursor: pointer; font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .cb-session-action:hover { background: var(--muted); color: var(--foreground); }

  /* ── Body ──────────────────────────────────────────────────── */
  .cb-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 6px 0;
  }
  .cb-mode-hint {
    padding: var(--space-1) 14px 2px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cb-list { padding: 2px 6px; }
  .cb-item {
    display: grid;
    grid-template-columns: 16px 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding: 7px var(--space-2);
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
    font-size: var(--text-base);
  }
  .cb-item:hover, .cb-item[aria-selected='true'] { background: var(--muted); }
  .cb-item .hint {
    color: var(--muted-foreground);
    font-size: 11px;
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cb-empty {
    padding: var(--space-6) var(--space-4);
    text-align: center;
    color: var(--muted-foreground);
    font-size: var(--text-base);
  }

  /* ── Create form ───────────────────────────────────────────── */
  .cb-create-surfaces {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding: var(--space-2) 14px;
  }
  .cb-surface-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: var(--space-1) 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    font: inherit; font-size: var(--text-sm);
    color: var(--muted-foreground); cursor: pointer;
  }
  .cb-surface-btn[aria-pressed='true'] {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
  .cb-surface-btn:hover:not([aria-pressed='true']):not([disabled]) { background: var(--muted); }
  .cb-surface-btn[disabled] { opacity: 0.55; cursor: not-allowed; }
  .cb-surface-hint {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--muted-foreground);
    padding-left: var(--space-1);
    border-left: 1px solid var(--border);
    margin-left: 2px;
  }
  .cb-create-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0 14px 10px;
  }
  .cb-create-grid label {
    display: flex; flex-direction: column; gap: var(--space-1);
    font-size: var(--text-sm); color: var(--muted-foreground);
  }
  .cb-create-grid input,
  .cb-create-grid select {
    height: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: var(--text-base);
    padding: 0 var(--space-2);
  }
  .span-2 { grid-column: span 2; }
  .cb-create-error { padding: 0 14px 6px; font-size: var(--text-sm); color: var(--destructive); }
  .cb-create-actions { padding: 0 14px 14px; display: flex; justify-content: flex-end; }
  .cb-create-submit {
    height: 32px; padding: 0 var(--space-4);
    border: none; border-radius: var(--radius-sm, 4px);
    background: var(--primary); color: var(--primary-foreground);
    font: inherit; font-size: var(--text-base); cursor: pointer;
  }
  .cb-create-submit:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Chat (ai mode) ────────────────────────────────────────── */
  .cb-chat-header {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-chat-header .title { font-size: var(--text-base); font-weight: 600; }
  .cb-chat-header .sub { font-size: 11px; color: var(--muted-foreground); }
  .cb-chat-body {
    flex: 1; min-height: 0;
    overflow-y: auto; overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: var(--space-3) 14px;
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  .cb-chat-empty {
    color: var(--muted-foreground);
    font-size: var(--text-base);
    text-align: center;
    margin-top: var(--space-6);
    padding: 0 var(--space-4);
    line-height: 1.5;
  }
  .cb-chat-empty .title { color: var(--foreground); font-weight: 600; margin-bottom: 6px; }
  .cb-chat-empty a, .cb-chat-empty button.link {
    color: var(--primary); background: transparent; border: none;
    padding: 0; font: inherit; text-decoration: underline; cursor: pointer;
  }
  .cb-chat-turn { display: flex; flex-direction: column; }
  .cb-chat-turn[data-sender='user'] { align-items: flex-end; }
  .cb-chat-turn[data-sender='agent'] { align-items: flex-start; }
  .cb-chat-turn[data-sender='system'] { align-items: center; }
  .cb-chat-bubble {
    max-width: 80%;
    padding: 7px 10px;
    border-radius: var(--radius-md, 6px);
    font-size: var(--text-base);
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .cb-chat-turn[data-sender='user'] .cb-chat-bubble {
    background: var(--primary); color: var(--primary-foreground);
  }
  .cb-chat-turn[data-sender='agent'] .cb-chat-bubble {
    background: var(--muted); color: var(--foreground);
  }
  .cb-chat-turn[data-sender='system'] .cb-chat-bubble {
    background: transparent; color: var(--muted-foreground);
    font-size: 11px; font-family: var(--font-mono);
  }
  .cb-spawn-card {
    margin: var(--space-2) 0;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 6px);
    background: var(--muted);
  }
  .cb-spawn-title { font-weight: 600; font-size: var(--text-base); margin-bottom: var(--space-3); }
  .cb-spawn-row {
    display: grid; grid-template-columns: 72px 1fr;
    align-items: center; gap: var(--space-2); margin-bottom: var(--space-2);
  }
  .cb-spawn-row label { font-size: var(--text-sm); color: var(--muted-foreground); }
  .cb-spawn-row select {
    height: 30px; border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    background: var(--background); color: var(--foreground);
    font: inherit; font-size: var(--text-base); padding: 0 6px;
  }
  .cb-spawn-error { font-size: var(--text-sm); color: var(--destructive); margin-bottom: var(--space-2); }
  .cb-spawn-start {
    margin-top: var(--space-1); height: 32px; width: 100%;
    border: none; border-radius: var(--radius-sm, 4px);
    background: var(--primary); color: var(--primary-foreground);
    font: inherit; font-size: var(--text-base); cursor: pointer;
  }
  .cb-spawn-start:disabled { opacity: 0.5; cursor: not-allowed; }
  .cb-banner {
    display: flex; align-items: center; gap: var(--space-2);
    padding: 6px 14px;
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-banner.warn {
    background: color-mix(in oklch, var(--warning) 12%, var(--background));
    color: var(--warning);
  }
  .cb-banner.error {
    background: color-mix(in oklch, var(--destructive) 12%, var(--background));
    color: var(--destructive);
  }
  .cb-banner button.dismiss {
    background: transparent; border: none; cursor: pointer;
    color: inherit; font: inherit; padding: 0 var(--space-1); margin-left: auto;
  }
  .cb-chat-composer {
    display: flex; gap: var(--space-2); align-items: flex-end;
    padding: 10px 14px;
    border-top: 1px solid var(--border);
    flex: 0 0 auto;
  }
  .cb-chat-input {
    flex: 1; border: 1px solid var(--border);
    border-radius: var(--radius-sm, 4px);
    background: var(--background); color: var(--foreground);
    font: inherit; font-size: var(--text-base);
    padding: 6px var(--space-2);
    resize: none; line-height: 1.4;
    min-height: 56px; max-height: 200px;
  }
  .cb-chat-input:focus { outline: none; border-color: var(--primary); }
  .cb-chat-send {
    height: 32px; padding: 0 14px;
    border: none; border-radius: var(--radius-sm, 4px);
    background: var(--primary); color: var(--primary-foreground);
    font: inherit; font-size: var(--text-base); cursor: pointer;
    flex-shrink: 0; align-self: flex-end;
  }
  .cb-chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<!-- Trigger pill -->
<button
  class="cb-trigger"
  type="button"
  aria-label="Open command bar"
  aria-haspopup="dialog"
  aria-controls="cb-dialog-root"
  aria-expanded={open() ? 'true' : 'false'}
  on:click={openFind}
>
  <sui-icon name="search" size="sm"></sui-icon>
  <span class="cb-label">{triggerLabel()}</span>
  <span class="cb-dot" style:background={dotBg()}></span>
  <kbd>⌘K</kbd>
</button>

<sui-dialog
  class="cb-dialog"
  id="cb-dialog-root"
  no-header
  no-footer
  no-close-button
  backdrop="blur"
  size="full"
  style="--dlg-max-w: min(840px, 94vw)"
  bind:this={dialogRef}
>
  <div class="cb-wrap">
    <!-- ── Input row (shared) ────────────────────────────────── -->
    <div class="cb-input-row">
      <span class="cb-mode-glyph" class:ai={isChat()}>{modeGlyph()}</span>
      <input
        class="cb-search"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={searchPlaceholder()}
        bind:value={value}
        aria-label="Command bar search"
        aria-autocomplete="list"
        aria-activedescendant={activeDescendantId()}
        on:input={onInput}
        on:keydown={onInputKeydown}
      />
      <kbd class="cb-esc" aria-label="Escape to close">esc</kbd>
      <div class="cb-chip-wrap">
        <span class="cb-session-chip" role="button" aria-haspopup="listbox" on:click={toggleSessionPicker}>
          <span class="cb-dot" style:background={chipDotBg()}></span>
          <span>{chipLabel()}</span>
        </span>
        {#if sessionPickerOpen()}
          <div class="cb-session-popover" role="listbox" aria-label="Sessions">
            {#for s of activeSessions() key={s.id}}
              <div
                class="cb-session-row"
                class:current={session()?.id === s.id}
                role="option"
                on:click={() => selectSession(s.id)}
              >
                <span class="cb-dot" style:background={s.status === 'thinking' ? 'var(--warning)' : 'var(--success)'}></span>
                <span><strong>{s.agent_id ?? ''}</strong><span class="meta"> · {s.harness ?? ''} · {s.workspace_id}</span></span>
                <button class="cb-session-end" type="button" aria-label="End session" on:click={(e) => { e.stopPropagation(); endSession(s.id) }}>×</button>
              </div>
            {/for}
            {#if activeSessions().length === 0}
              <div class="cb-session-row"><span></span><span class="meta">No active sessions</span><span></span></div>
            {/if}
            <div class="cb-session-sep" role="separator"></div>
            <div class="cb-session-action" on:click={startNewSession}>
              <sui-icon name="plus" size="sm" aria-hidden="true"></sui-icon>
              <span>Start new session</span>
            </div>
            <div class="cb-session-action" on:click={viewChats}>
              <sui-icon name="columns" size="sm" aria-hidden="true"></sui-icon>
              <span>View all chats</span>
            </div>
          </div>
        {/if}
      </div>
    </div>

    <!-- ── Body: mode-switched content ──────────────────────── -->
    {#if isChat()}
      <!-- ai mode: chat panel -->
      <div class="cb-panel">
        {#if daemonOffline()}
          <div class="cb-banner warn" role="status">
            <sui-icon name="alert-triangle" size="sm" aria-hidden="true"></sui-icon>
            <span>Daemon unreachable. Reconnect to send messages.</span>
          </div>
        {/if}
        {#if sendError()}
          <div class="cb-banner error" role="alert">
            <sui-icon name="alert-circle" size="sm" aria-hidden="true"></sui-icon>
            <span>{sendError()}</span>
            <button class="dismiss" type="button" aria-label="Dismiss" on:click={dismissSendError}>×</button>
          </div>
        {/if}
        <div class="cb-chat-body">
          {#if hasSession()}
            {#if thread().length === 0}
              <div class="cb-chat-empty">
                <div class="title">Connected to {session()?.agent_id ?? 'agent'}</div>
                <div>Type below and press Enter. ArrowUp recalls recent messages.</div>
              </div>
            {:else}
              {#for msg of thread() key={msg.id}}
                <div class="cb-chat-turn" data-sender={msg.sender}>
                  <div class="cb-chat-bubble">{msg.text}</div>
                </div>
              {/for}
            {/if}
          {:else if !hasAgents()}
            <div class="cb-chat-empty">
              <div class="title">No agents configured</div>
              <div>Open <button class="link" type="button" on:click={goToAgents}>/studio/agents</button> to add one, then start a session.</div>
            </div>
          {:else}
            <div class="cb-spawn-card">
              <div class="cb-spawn-title">Start a session</div>
              <div class="cb-spawn-row">
                <label>Agent</label>
                <select class="cb-spawn-agent" bind:value={spawnAgent}>
                  {#for a of agents() key={a.id}}
                    <option value={a.id}>{a.name ?? a.label ?? a.id}</option>
                  {/for}
                </select>
              </div>
              <div class="cb-spawn-row">
                <label>Harness</label>
                {#if hasProviders()}
                  <select class="cb-spawn-harness" bind:value={spawnHarness}>
                    {#for p of harnesses() key={p}}
                      <option value={p}>{p}</option>
                    {/for}
                  </select>
                {:else}
                  <span style="font-size:12px;color:var(--muted-foreground)">No harnesses installed</span>
                {/if}
              </div>
              {#if spawnError()}
                <div class="cb-spawn-error">{spawnError()}</div>
              {/if}
              <button
                class="cb-spawn-start"
                type="button"
                disabled={spawning() || !spawnAgent() || !spawnHarness()}
                on:click={spawnSession}
              >{spawning() ? 'Starting…' : 'Start session'}</button>
            </div>
          {/if}
        </div>
        <div class="cb-chat-composer">
          <textarea
            class="cb-chat-input"
            rows="2"
            placeholder={hasSession() ? 'Message the agent…' : 'Draft a message — start a session above to send'}
            bind:value={value}
            on:keydown={onComposerKeydown}
          ></textarea>
          <button
            class="cb-chat-send"
            type="button"
            disabled={!value().trim() || !hasSession()}
            on:click={sendMessage}
          >Send</button>
        </div>
      </div>
    {:else}
      <!-- find / command / mention / create mode: palette body -->
      <div class="cb-body">
        {#match mode()}
          {:case 'find'}
            {#for group of searchGroups() key={group.kind}}
              <div class="cb-mode-hint">{group.label}</div>
              <div class="cb-list" role="listbox" aria-label={group.label}>
                {#for item of group.items key={item.kind + ':' + item.id}}
                  <div
                    class="cb-item"
                    role="option"
                    id={'cb-item-' + item.idx}
                    aria-selected={selectedIdx() === item.idx ? 'true' : 'false'}
                    data-id={item.id}
                    data-kind={item.kind}
                    data-path={item.path}
                    on:click={() => activateNavItem(item.path)}
                  >
                    <sui-icon name={item.icon ?? 'app-window'} size="sm" aria-hidden="true"></sui-icon>
                    <span>{item.label}</span>
                    <span class="hint">{group.label}</span>
                  </div>
                {/for}
              </div>
            {/for}
            {#if !findHasResults() && findSearching()}
              <div class="cb-empty">Searching…</div>
            {/if}
            {#if !findHasResults() && !findSearching()}
              <div class="cb-empty">No matches.</div>
            {/if}

          {:case 'command'}
            {#if cmdItems().length > 0}
              <div class="cb-mode-hint">Actions</div>
              <div class="cb-list" role="listbox">
                {#for item of cmdItems() key={item.key}}
                  <div
                    class="cb-item"
                    role="option"
                    id={'cb-item-' + item.idx}
                    aria-selected={selectedIdx() === item.idx ? 'true' : 'false'}
                    data-id={item.key}
                    data-cmd={item.key}
                    on:click={() => activateCmd(item.key)}
                  >
                    <span style="font-family:var(--font-mono)">{item.label}</span>
                    <span></span>
                    <span class="hint">{item.hint}</span>
                  </div>
                {/for}
              </div>
            {:else}
              <div class="cb-empty">No commands match.</div>
            {/if}

          {:case 'mention'}
            {#if mentionItems().length > 0}
              <div class="cb-mode-hint">Reference</div>
              <div class="cb-list" role="listbox">
                {#for item of mentionItems() key={item.id + item.kind}}
                  <div
                    class="cb-item"
                    role="option"
                    id={'cb-item-' + item.idx}
                    aria-selected={selectedIdx() === item.idx ? 'true' : 'false'}
                    data-id={item.kind + ':' + item.id}
                    data-mention-kind={item.kind}
                    data-mention-id={item.id}
                    on:click={() => activateMention(item)}
                  >
                    <sui-icon name={item.icon} size="sm" aria-hidden="true"></sui-icon>
                    <span>{item.label}</span>
                    <span class="hint">{item.kind}</span>
                  </div>
                {/for}
              </div>
            {:else}
              <div class="cb-empty">No matching views or agents.</div>
            {/if}

          {:case 'create'}
            <div class="cb-mode-hint">Create</div>
            <div class="cb-create-surfaces" role="group" aria-label="Surface type">
              {#for surf of createSurfaces() key={surf.id}}
                <button
                  class="cb-surface-btn"
                  type="button"
                  data-surface={surf.id}
                  aria-pressed={createSurface() === surf.id ? 'true' : 'false'}
                  aria-disabled={surf.disabled ? 'true' : 'false'}
                  disabled={surf.disabled}
                  title={surf.disabled ? 'post-launch' : surf.label}
                  on:click={() => selectSurface(surf.id)}
                >
                  <sui-icon name={surf.icon} aria-hidden="true"></sui-icon>
                  <span>{surf.label}</span>
                  {#if surf.disabled}
                    <span class="cb-surface-hint">post-launch</span>
                  {/if}
                </button>
              {/for}
            </div>
            <div class="cb-create-grid">
              <label>
                <span>Name (kebab-case)</span>
                <input type="text" placeholder={'my-' + createSurface()} bind:value={createName} autocomplete="off" />
              </label>
              <label>
                <span>{currentSurfaceDef().shapeLabel}</span>
                <select bind:value={createShape}>
                  {#for sh of currentSurfaceDef().shapes key={sh}}
                    <option value={sh}>{sh}</option>
                  {/for}
                </select>
              </label>
              <label class="span-2">
                <span>Purpose (optional)</span>
                <input type="text" placeholder="One-line description" bind:value={createPurpose} autocomplete="off" />
              </label>
            </div>
            {#if createError()}
              <div class="cb-create-error">{createError()}</div>
            {/if}
            <div class="cb-create-actions">
              <button
                class="cb-create-submit"
                type="button"
                disabled={createSubmitting() || !createNameValid()}
                on:click={submitCreate}
              >{createSubmitting() ? 'Creating…' : 'Create ' + currentSurfaceDef().label}</button>
            </div>

          {:default}
            <div class="cb-empty">…</div>
        {/match}
      </div>
    {/if}
  </div>
</sui-dialog>
