<!--
  <sui-account-menu> — Ship Cloud account affordance for the chrome strip.
  Trigger button shows the signed-in identity (avatar + name) or "Sign in";
  clicking opens a native-popover panel with plan info + actions (Open
  Account Settings, Open Billing, Sign in / Sign out).

  Mirrors the popover-anchor pattern used by <sui-theme-picker>: the
  trigger toggles a `popover="auto"` panel, the controller anchors it
  with getBoundingClientRect() on open, and a `toggle` event listener
  drives aria-expanded.

  Account state subscription lives in the <data> element below, per
  SUI hard rule #2 — never call ship.* outside <data> or <form mutation>.
  The compiler auto-generates `account` as a Signal<LiveState<AccountState>>
  in scope; the controller derives `identity` / labels / actions from it.

  Lives in @ship/chrome alongside <ship-nav-top>, which composes it. The
  controller navigates via `navigate()` from `@ship/deck/route` (the
  runtime's RouterPort, wired by the bundler entry) — host-agnostic, no
  `chrome` indirection.

  Styles are inline in the <style> block below (compiled with the template,
  like every other component) — no sibling .css to drift out of the bundle.

  Prop / event surface
  ────────────────────────────────────────────────────────────────────────
  Props:
    placement (union, 'bottom-end', reflect)  panel placement
    label-style (union, 'text'|'compact', 'text', reflect)
                                              compact = avatar + caret only
  ────────────────────────────────────────────────────────────────────────
  Events dispatched (bubbling, composed):
    sui:account:menu-ready {}  fired once after first mount
  ────────────────────────────────────────────────────────────────────────
  Slots: (none — fully self-contained)
  Parts: trigger, avatar, name, panel
  ────────────────────────────────────────────────────────────────────────
-->

<prop name="placement" values="top|top-end|bottom|bottom-end|left|left-end|right|right-end" default="bottom-end" reflect />
<prop name="label-style" values="text|compact" default="text" reflect />

<data name="account" source="ship.account.state()" live />

<style>
/* <sui-account-menu> styles — extracted from .sui to stay under the
 * 300-line file cap. Auto-linked by the compiler via the matching
 * stem-name (see ship-sui skill: "<tag>.sui + optional <tag>.controller.ts
 * + optional <tag>.css"). */

:host {
  position: relative;
  display: inline-flex;
}
:host([hidden]) { display: none; }

.trigger {
  appearance: none;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-sm, 4px);
  padding: 3px 6px 3px 3px;
  font: inherit;
  font-size: var(--text-sm, 13px);
  color: var(--foreground);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  max-width: 220px;
  transition:
    background-color var(--duration-fast, 100ms) var(--ease-out, ease-out),
    border-color var(--duration-fast, 100ms) var(--ease-out, ease-out);
}
.trigger:hover {
  background: var(--hover-bg, var(--muted, color-mix(in oklch, currentColor 6%, transparent)));
}
.trigger:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 50%, transparent);
}

.avatar, .avatar-fallback {
  width: 22px;
  height: 22px;
  border-radius: var(--radius-full);
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 0 0 1px color-mix(in oklch, var(--foreground) 15%, transparent);
}
.avatar { object-fit: cover; }
.avatar-fallback {
  background: color-mix(in oklch, var(--primary) 18%, var(--muted));
  color: var(--primary);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.avatar-fallback.signed-out {
  background: color-mix(in oklch, currentColor 8%, transparent);
  color: var(--muted-foreground);
}

.name {
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 14ch;
  line-height: 1;
}
.muted { color: var(--muted-foreground); }
.err { color: var(--destructive); }

:host([label-style='compact']) .name { display: none; }

.caret {
  width: 10px; height: 6px;
  flex: 0 0 auto;
  color: var(--muted-foreground);
}

/* Popover panel — fixed-positioned by the controller after open. */
.panel {
  position: fixed;
  inset: auto;
  margin: 0;
  border: 0;
  padding: 0;
  width: 280px;
  background: var(--popover, var(--card));
  color: var(--popover-foreground, var(--card-foreground));
  border: 1px solid var(--border);
  border-radius: var(--radius-md, 6px);
  box-shadow: var(--shadow-lg);
  opacity: 0;
  transform: translateY(-4px) scale(0.97);
  transition:
    opacity var(--duration-medium, 200ms) var(--ease-out, ease-out),
    transform var(--duration-medium, 200ms) var(--ease-out, ease-out);
}
.panel:popover-open {
  opacity: 1;
  transform: translateY(0) scale(1);
}
.panel::backdrop { background: transparent; }
@media (prefers-reduced-motion: reduce) {
  .panel { transition: none; transform: none !important; }
}

.id-block {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: var(--space-3) 14px;
  border-bottom: 1px solid var(--border);
}
.id-block .avatar,
.id-block .avatar-fallback {
  width: 36px;
  height: 36px;
  font-size: var(--text-base);
}
.id-stack {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.id-name {
  font-weight: 600;
  font-size: var(--text-base);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.id-email {
  color: var(--muted-foreground);
  font-size: 11.5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.plan {
  margin-left: auto;
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted-foreground);
  padding: 2px 6px;
  border-radius: var(--radius-full);
  background: color-mix(in oklch, currentColor 8%, transparent);
  flex: 0 0 auto;
}

.actions { display: flex; flex-direction: column; padding: var(--space-1); }
.action {
  appearance: none;
  background: transparent;
  border: 0;
  border-radius: var(--radius-sm, 4px);
  padding: var(--space-2) 10px;
  cursor: pointer;
  text-align: left;
  font: inherit;
  font-size: 12.5px;
  color: var(--foreground);
  display: flex;
  align-items: center;
  gap: 10px;
  transition: background var(--duration-fast, 100ms) var(--ease-out, ease-out);
}
.action:hover {
  background: var(--hover-bg, color-mix(in oklch, currentColor 6%, transparent));
}
.action:focus-visible {
  outline: none;
  background: var(--hover-bg, color-mix(in oklch, currentColor 6%, transparent));
  box-shadow: inset 0 0 0 2px color-mix(in oklch, var(--primary) 50%, transparent);
}
.action.danger { color: var(--destructive); }
.action[disabled] { opacity: 0.5; cursor: default; }
.action .meta { margin-left: auto; color: var(--muted-foreground); font-size: 11px; }
.divider {
  height: 1px;
  margin: var(--space-1) 0;
  background: var(--border);
}
.status-line {
  padding: var(--space-2) 14px var(--space-3);
  font-size: 11.5px;
  color: var(--muted-foreground);
}
.status-line.err { color: var(--destructive); }
</style>

<button class="trigger" part="trigger" type="button" bind:this={triggerBtn}
  aria-haspopup="dialog"
  aria-expanded={panelOpen() ? 'true' : 'false'}
  aria-label={triggerAria()}
  title={triggerAria()}
  on:click={() => togglePanel()}>
  {#if identity().status === 'logged_in' && identity().me?.image}
    <img class="avatar" part="avatar" src={identity().me?.image ?? ''} alt="" />
  {:else if identity().status === 'logged_in'}
    <span class="avatar-fallback" part="avatar" aria-hidden="true">{initials()}</span>
  {:else}
    <span class="avatar-fallback signed-out" part="avatar" aria-hidden="true">
      <sui-icon name="user" size="sm"></sui-icon>
    </span>
  {/if}
  {#while-loading of account}
    <span class="name muted" part="name">…</span>
  {/while-loading}
  {#while-error err of account}
    <span class="name err" part="name">Offline</span>
  {/while-error}
  {#if account().kind === 'ok'}
    <span class="name" part="name">{triggerLabel()}</span>
  {/if}
  <svg class="caret" viewBox="0 0 10 6" aria-hidden="true">
    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<div class="panel" part="panel" popover="auto" bind:this={panelEl} role="menu" aria-label="Account">
  {#if identity().status === 'logged_in'}
    <div class="id-block">
      {#if identity().me?.image}
        <img class="avatar" src={identity().me?.image ?? ''} alt="" />
      {:else}
        <span class="avatar-fallback" aria-hidden="true">{initials()}</span>
      {/if}
      <div class="id-stack">
        <span class="id-name">{displayName()}</span>
        {#if identity().me?.email}
          <span class="id-email">{identity().me?.email}</span>
        {/if}
      </div>
      {#if planLabel()}
        <span class="plan">{planLabel()}</span>
      {/if}
    </div>
  {:else}
    <div class="id-block">
      <span class="avatar-fallback signed-out" aria-hidden="true">
        <sui-icon name="user" size="sm"></sui-icon>
      </span>
      <div class="id-stack">
        <span class="id-name">Not signed in</span>
        <span class="id-email">Connect this workspace to Ship Cloud</span>
      </div>
    </div>
  {/if}

  <div class="actions" role="none">
    {#if identity().status === 'logged_in'}
      <button class="action" type="button" role="menuitem" on:click={openSettings}>
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </button>
      <button class="action" type="button" role="menuitem" on:click={openBillingAction}>
        <sui-icon name="credit-card" size="sm"></sui-icon>
        <span>Billing</span>
        <sui-icon class="meta" name="external-link" size="sm"></sui-icon>
      </button>
      <div class="divider" role="separator"></div>
      <button class="action danger" type="button" role="menuitem"
        disabled={busy()}
        on:click={() => onSignOut()}>
        <sui-icon name="log-out" size="sm"></sui-icon>
        <span>Sign out</span>
      </button>
    {:else if identity().status === 'pending'}
      <button class="action" type="button" role="menuitem" disabled>
        <sui-icon name="loader" size="sm"></sui-icon>
        <span>Completing sign-in in browser…</span>
      </button>
      <div class="status-line">
        Finish OAuth in the browser tab that opened. Until the daemon's
        local callback completes, you may need to run <code>ship login</code>
        in a terminal to finalize.
      </div>
      <button class="action" type="button" role="menuitem" on:click={openSettings}>
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </button>
    {:else}
      <button class="action" type="button" role="menuitem"
        disabled={busy()}
        on:click={() => onSignIn()}>
        <sui-icon name="log-in" size="sm"></sui-icon>
        <span>Sign in with Ship Cloud</span>
      </button>
      <button class="action" type="button" role="menuitem" on:click={openSettings}>
        <sui-icon name="settings" size="sm"></sui-icon>
        <span>Account settings</span>
      </button>
    {/if}
  </div>

  {#if errorMessage()}
    <div class="status-line err" role="status">{errorMessage()}</div>
  {/if}
</div>
