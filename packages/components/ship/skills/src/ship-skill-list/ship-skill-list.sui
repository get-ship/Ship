<!--
  <ship-skill-list> — @ship/skills · the hub `/studio/skills` index.

  Reads `ship.skills.list()` (Connect SDK LiveSource) and renders the
  registered skills, grouped by SkillScopeTag (project/user/library).
  Empty/loading/error states are first-class; this is the live hub
  surface (no BACKEND-GAP — `ship.skills.list()` exists in the SDK,
  see packages/deck/sdk-client/src/ship-sdk.ts:211).

  Composes
    <sui-stack>        section stack
    <sui-cluster>      meta row
    <sui-card>         per-skill card
    <sui-icon>         affordance glyphs
    <sui-badge>        scope pill
    <sui-empty-state>  no-skills / error fallback
    <sui-spinner>      loading indicator

  Prop / event
  ─────────────────────────────────────────────────────────────────────
  (no props — the pack reads the SDK directly)

  Emits:
    ship-skill-open   { detail: { id: string } }   click on a skill card
-->

<style>
  :host { display: block; }

  .head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .head h1 {
    font-family: var(--heading-font, var(--font-display));
    font-size: var(--text-xl);
    font-weight: var(--heading-weight, var(--font-weight-semibold));
    letter-spacing: var(--heading-tracking);
    margin: 0;
    color: var(--foreground);
  }
  .head .sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .head .rule {
    margin-left: auto;
    width: 64px;
    height: var(--space-1);
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--primary), transparent);
  }

  .group-h {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    margin-bottom: var(--space-2);
  }
  .group-count {
    font-family: var(--font-mono);
    font-weight: normal;
    letter-spacing: 0;
  }

  .card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--foreground);
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .card:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  .card-main {
    flex: 1;
    min-width: 0;
  }
  .card-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
  }
  .card-desc {
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    line-height: 1.4;
    margin-top: var(--space-1);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .card-chev {
    flex: none;
    color: var(--muted-foreground);
  }
</style>

<section class="head" data-test="skills-head">
  <h1>Skills</h1>
  <span class="sub">{sub()}</span>
  <span class="rule" aria-hidden="true"></span>
</section>

{#if state() === 'loading'}
  <div class="skills-loading" data-test="skills-loading">
    <sui-spinner size="md" centered></sui-spinner>
  </div>
{:else if state() === 'error'}
  <sui-empty-state variant="default" size="md" tone="muted" data-test="skills-error">
    <sui-icon slot="icon" name="alert-triangle"></sui-icon>
    <span slot="title">Couldn't load skills</span>
    The skill list couldn't be read right now. Reload to try again.
  </sui-empty-state>
{:else if state() === 'empty'}
  <sui-empty-state variant="default" size="md" tone="muted" data-test="skills-empty">
    <sui-icon slot="icon" name="sparkles"></sui-icon>
    <span slot="title">No skills registered</span>
    Skills are folders with a <code>SKILL.md</code> file. Create one in
    your project or user skills directory to see it here.
  </sui-empty-state>
{:else}
  <sui-stack class="groups" data-test="skills-groups" gap="5">
    {#for g of groups() key={g.id}}
      <section class="group" data-test="skills-group" attr:data-scope={g.id}>
        <header class="group-h">
          {g.label} <span class="group-count">· {g.skills.length}</span>
        </header>
        <sui-stack class="group-list" data-test="skills-group-list" gap="2">
          {#for s of g.skills key={s.id}}
            <a class="card" data-test="skill-card" attr:data-id={s.id}
              attr:href={'/studio/skills/' + s.id}
              on:click={(e) => onOpen(e, s.id)}>
              <sui-stack class="card-main" gap="1">
                <sui-cluster class="card-head" gap="2">
                  <span class="card-name">{s.name}</span>
                  <sui-badge tone="muted" variant="outline" size="sm">{g.label}</sui-badge>
                </sui-cluster>
                {#if s.description}
                  <p class="card-desc">{s.description}</p>
                {/if}
              </sui-stack>
              <sui-icon class="card-chev" name="chevron-right" size="sm" tone="muted"></sui-icon>
            </a>
          {/for}
        </sui-stack>
      </section>
    {/for}
  </sui-stack>
{/if}
