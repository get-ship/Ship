<!--
  <ship-artifact-actions> — @ship/artifacts · the three action verbs for a
  single artifact row. Promote (primary) · Rename (ghost) · Delete
  (destructive, confirm via sui-dialog).

  Pure presentational. No SDK. The host owns the SDK call:
    - `ship-artifact-promote { id }`
    - `ship-artifact-rename  { id, name }`
    - `ship-artifact-delete  { id }`

  Props:
    record    JSON of { id, name, ... }      default '{}'
-->
<prop name="record" type="string" default="{}" />

<style>
  :host { display: inline-flex; align-items: center; gap: var(--space-2); font-family: var(--font-body); }
  .row { display: inline-flex; align-items: center; gap: var(--space-1); }
  .name { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted-foreground); margin-right: var(--space-1); max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rename { display: inline-flex; align-items: center; gap: var(--space-1); }
  .rename input { font: inherit; font-size: var(--text-sm); padding: var(--space-1) var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--background); color: var(--foreground); width: 180px; }
  .rename input:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
</style>

<div class="row" part="actions">
  <span class="name" data-test="actions-name">{displayName()}</span>

  <sui-button tone="primary" variant="solid" size="sm"
    prop:disabled={!recordId()}
    on:click={onPromote}
    data-test="action-promote">Promote</sui-button>

  <sui-button variant="ghost" size="sm"
    prop:disabled={!recordId()}
    on:click={onRenameStart}
    data-test="action-rename">Rename</sui-button>

  <sui-button tone="destructive" variant="solid" size="sm"
    prop:disabled={!recordId()}
    on:click={openDelete}
    data-test="action-delete">Delete</sui-button>

  {#if renaming()}
    <span class="rename" data-test="rename-form">
      <input
        type="text"
        bind:value={renameDraft}
        placeholder="New name"
        aria-label="New artifact name"
        on:keydown={onRenameKey} />
      <sui-button size="sm" on:click={onRenameSubmit} data-test="rename-submit">Save</sui-button>
      <sui-button size="sm" variant="ghost" on:click={onRenameCancel} data-test="rename-cancel">Cancel</sui-button>
    </span>
  {/if}
</div>

<sui-dialog
  prop:open={deleteOpen()}
  size="sm"
  on:sui-close={closeDelete}
  data-test="delete-dialog">
  <span slot="header">Delete artifact?</span>
  <p>This permanently removes <strong>{displayName()}</strong>. This action cannot be undone.</p>
  <div slot="footer">
    <sui-button variant="ghost" on:click={closeDelete} data-test="delete-cancel">Cancel</sui-button>
    <sui-button tone="destructive" variant="solid" on:click={confirmDelete} data-test="delete-confirm">Delete</sui-button>
  </div>
</sui-dialog>
