<!--
  <ship-artifact-upload> — @ship/artifacts · drop / select an artifact
  to upload. The host owns the ship.artifacts.upload({ file,
  collection_id }) call (the only SDK mutation in the pack; the rest
  of the verbs are NOT in the SDK yet — see KNOWN_GAPS.md).

  Emits `ship-artifact-upload { files, collection_id }` on submit. No
  SDK here — the host reads the event and calls the SDK.

  Props:
    collection-id   string (current collection)   default ''
    disabled        reflect                       default false
-->
<prop name="collection-id" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect />

<style>
  :host { display: block; font-family: var(--font-body); }
  .stage { padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-1); }
  .label { font-size: var(--text-sm); font-weight: var(--font-weight-semibold); color: var(--foreground); }
  .id { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }
  .err { color: var(--destructive); font-size: var(--text-sm); }
</style>

<sui-stack gap="3" class="stage" part="stage">
  <div class="label">Upload artifact</div>
  <sui-file-upload
    prop:disabled={disabled()}
    data-test="upload-files"
    on:sui-change={onFiles}></sui-file-upload>

  <sui-cluster gap="2">
    <label class="label" for="upload-collection">Collection</label>
    <sui-input id="upload-collection" size="sm"
      prop:disabled={disabled()}
      attr:value={collectionId()}
      on:sui-input={onCollection}
      data-test="upload-collection-input"></sui-input>
    <span class="id">id: {collectionId() || '—'}</span>
  </sui-cluster>

  {#if errorMsg()}
    <div class="err" role="alert" data-test="upload-error">{errorMsg()}</div>
  {/if}

  <sui-cluster gap="2">
    <sui-button tone="primary" variant="solid" size="sm"
      prop:disabled={disabled() || files().length === 0}
      on:click={submit}
      data-test="upload-submit">Upload</sui-button>
    <sui-button size="sm" variant="ghost"
      prop:disabled={files().length === 0}
      on:click={reset}
      data-test="upload-reset">Clear</sui-button>
  </sui-cluster>
</sui-stack>
