<!--
  ship-space-registry.sui — the @ship/spaces REGISTRY surface (SHELL side).
  Renders SpaceService.List (spaces[] + active_id) as a selectable list:
  each row is a registered space (name · path · last-seen), the active one
  marked. Row click → `ship-activate` {id} (consumer re-points the daemon-global
  default pointer via Activate). The register affordance → `ship-add` (consumer
  opens the add flow).

  Presentational + token-pure. The rows + relative last-seen are fed by the
  controller from the `spaces` attribute (JSON) and `active` (the active id);
  no daemon, RPC, or Watch machinery is visible in the surface itself — those
  live in the integration layer that owns this element. Compiled as
  <ship-space-registry>. Parts: container · header · add · rows · row · empty.
-->
<prop name="active" type="string" default="" />
<prop name="heading" type="string" default="Spaces" />

<style>
  :host { display: block; font-family: var(--font-body); color: var(--foreground); }
  :host([hidden]) { display: none; }

  .reg {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }

  .head {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--muted) 45%, var(--card));
  }
  .title {
    font-family: var(--heading-font);
    font-weight: var(--heading-weight);
    letter-spacing: var(--heading-tracking);
    font-size: var(--text-lg);
    display: inline-flex; align-items: baseline; gap: var(--space-2);
  }
  .count {
    font-family: var(--font-mono); font-size: var(--text-xs);
    color: var(--muted-foreground);
    background: var(--muted); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full); padding: 1px 8px;
  }
  .spacer { flex: 1; }
  .add {
    appearance: none; cursor: pointer;
    font-family: var(--font-body); font-size: var(--text-sm); font-weight: var(--font-weight-medium);
    color: var(--primary-foreground); background: var(--primary);
    border: 1px solid var(--primary); border-radius: var(--radius-md);
    padding: 5px 11px;
    transition: filter var(--duration-fast) var(--ease-out);
  }
  .add:hover { filter: brightness(1.05); }
  .add:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .add.ghost { color: var(--foreground); background: transparent; border-color: var(--border); }

  .rows { display: flex; flex-direction: column; }

  .row {
    appearance: none; cursor: pointer; text-align: left; width: 100%;
    display: grid; grid-template-columns: 14px minmax(120px, 1.1fr) minmax(0, 1.6fr) auto auto;
    align-items: center; gap: var(--space-3);
    padding: var(--density-row-py, 10px) var(--space-4);
    background: transparent; border: 0;
    border-top: 1px solid var(--border-subtle);
    color: var(--foreground);
    transition: background var(--duration-fast) var(--ease-out);
  }
  .rows .row:first-child { border-top: 0; }
  .row:hover { background: var(--hover-bg); }
  .row:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); background: var(--hover-bg); }
  .row.active { background: var(--selected-bg); }

  .dot { width: 8px; height: 8px; border-radius: 50%; background: color-mix(in oklch, var(--foreground) 22%, transparent); }
  .dot[data-active='true'] { background: var(--success); box-shadow: 0 0 0 3px color-mix(in oklch, var(--success) 22%, transparent); }

  .name { font-size: var(--text-md); font-weight: var(--font-weight-medium); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .path { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .seen { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); justify-self: end; white-space: nowrap; }
  .state {
    font-family: var(--font-mono); font-size: var(--text-xs); justify-self: end;
    color: var(--muted-foreground); min-width: 48px; text-align: right;
  }
  .row.active .state { color: var(--success); }

  .empty { padding: var(--space-7) var(--space-4); text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-2); }
  .empty-title { font-family: var(--heading-font); font-weight: var(--heading-weight); font-size: var(--text-lg); }
  .empty-body { font-size: var(--text-sm); color: var(--muted-foreground); max-width: 42ch; line-height: var(--leading-relaxed); }
  .empty .add { margin-top: var(--space-2); }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

<div class="reg" part="container">
  <header class="head" part="header">
    <span class="title">{heading()} <span class="count">{rows().length}</span></span>
    <span class="spacer"></span>
    {#if rows().length > 0}
      <button class="add" type="button" part="add" data-action="add">Register a space</button>
    {/if}
  </header>

  {#if rows().length === 0}
    <div class="empty" part="empty">
      <span class="empty-title">No spaces registered</span>
      <span class="empty-body">Register a directory to get started. Each space is an independent Ship context.</span>
      <button class="add" type="button" data-action="add">Register a space</button>
    </div>
  {:else}
    <div class="rows" part="rows" role="list">
      {#for s of rows() key={s.id}}
        <button
          class="row"
          type="button"
          role="listitem"
          data-id={s.id}
          class:active={s.id === active()}
          aria-current={s.id === active() ? 'true' : 'false'}>
          <span class="dot" data-active={s.id === active() ? 'true' : 'false'}></span>
          <span class="name">{s.name}</span>
          <span class="path">{s.path}</span>
          <span class="seen">{s.lastSeen}</span>
          <span class="state">{s.id === active() ? 'active' : 'open'}</span>
        </button>
      {/for}
    </div>
  {/if}
</div>
