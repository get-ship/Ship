<!--
  <ship-approval-card> — one pending authority request, rendered for a decision.

  Presentational + event-out: it takes a `request` object and emits the
  operator's choice. The host (views/authority) owns the
  ship.authority.pending() subscription and the ship.authority.decide()
  mutation — the card never touches the SDK, so it stays trivially testable
  and reusable.

  Request shape (narrowed to what the card renders):
    { id, agent, space, kind: 'capability' | 'command',
      scope?, path?, command?, why, risk: 'low' | 'medium' | 'high', ageLabel? }

  Events (bubble + composed):
    ship-decide  { detail: { id, decision: 'deny' | 'allow_once' | 'allow_session' } }
    ship-inspect { detail: { id } }   — fired when a capability agent is clicked,
                                         so the host can open <ship-capability-request>

  Composition: <sui-badge> for the risk tag, <sui-button> for the actions.
-->

<!-- `request` is a JSON string (SUI props carry no object type); the
     controller parses it. Hosts pass it via prop:request={obj} (the runtime
     JSON-encodes) or a literal request='{…}' attribute. -->
<prop name="request" type="string" default="" />

<style>
  :host { display: block; }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 10px);
    padding: var(--space-4, 16px);
    background: var(--card, var(--background));
    color: var(--card-foreground, var(--foreground));
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 12px);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    flex-wrap: wrap;
  }

  .agent {
    font-weight: var(--font-weight-semibold, 600);
    color: var(--foreground);
  }
  .agent-btn {
    appearance: none;
    border: none;
    background: none;
    padding: 0;
    font: inherit;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--primary, var(--foreground));
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sep { color: var(--muted-foreground); }
  .space { color: var(--muted-foreground); }
  .risk { margin-inline-start: auto; }

  .kind {
    font-size: var(--text-xs, 0.6875rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .command {
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: var(--text-sm, 0.875rem);
    background: var(--muted);
    color: var(--foreground);
    padding: var(--space-2, 8px) var(--space-3, 12px);
    border-radius: var(--radius, 6px);
    overflow-x: auto;
  }
  .scope {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--foreground);
  }
  .why { font-size: var(--text-sm, 0.875rem); color: var(--muted-foreground); }

  .actions {
    display: flex;
    gap: var(--space-2, 8px);
    justify-content: flex-end;
  }
</style>

<article class="card" data-test="approval-card">
  <div class="row">
    {#if isCapability()}
      <button class="agent-btn" type="button" data-test="inspect" on:click={inspect}>{agent()}</button>
    {:else}
      <span class="agent">{agent()}</span>
    {/if}
    <span class="sep" aria-hidden="true">·</span>
    <span class="space">{space()}</span>
    <span class="risk"><sui-badge tone={riskTone()} variant="soft" size="sm" data-test="risk">{risk()}</sui-badge></span>
  </div>

  <div class="kind">{kindLabel()}</div>

  {#if isCapability()}
    <div class="scope" data-test="scope">{scopeLine()}</div>
  {:else}
    <pre class="command" data-test="command">$ {command()}</pre>
  {/if}

  <div class="why">Why · {why()}</div>

  <div class="actions">
    <sui-button variant="outline" tone="destructive" on:click={deny}>Deny</sui-button>
    <sui-button variant="outline" on:click={allowOnce}>Allow once</sui-button>
    <sui-button variant="solid" tone="primary" on:click={allowSession}>Allow this session</sui-button>
  </div>
</article>
