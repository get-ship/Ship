<!--
  <ship-approvals-queue> — @ship/authority · the cross-space "inbox" for the gate.
  A header (N pending) + batch verbs (Deny all · Approve all) over a stack of
  slotted approval checkpoints. Suspends span sessions; the operator decides them
  in a batch.

  Presentational + event-out: the host slots the pending checkpoints and owns the
  batch mutation. The queue only emits the operator's batch intent.

  Prop:   count   string — "{count} pending"
  Slot:   default → the per-op approval checkpoints
  Parts:  queue · body
  Events (bubble + composed):
    ship-approve-all { detail: {} }
    ship-deny-all    { detail: {} }
-->
<prop name="count" type="string" default="0" />

<style>
  :host { display: block; font-family: var(--font-body); }
  .q {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }
  .qh {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--divider);
    background: var(--surface-2);
  }
  .qh svg.s { width: 16px; height: 16px; color: var(--warning); }
  .qh .t { font-family: var(--heading-font); font-weight: 600; font-size: var(--text-md); }
  .qh .ct {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--warning);
    background: var(--tone-warning-bg);
    border: 1px solid var(--tone-warning-border);
    border-radius: var(--radius-full);
    padding: 1px 8px;
  }
  .qh .acts { margin-left: auto; display: inline-flex; gap: 8px; }
  .btn {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
  }
  .btn:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .btn.deny { color: var(--destructive); border-color: var(--tone-destructive-border); }
  .btn.approve { background: var(--primary); color: var(--primary-foreground); border-color: var(--primary); }
  .qbody { padding: 12px; display: flex; flex-direction: column; gap: 10px; }
  .qbody ::slotted(*) { display: block; }
</style>

<div class="q" part="queue">
  <div class="qh">
    <svg class="s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    <span class="t">Approvals</span>
    <span class="ct">{count()} pending</span>
    <span class="acts">
      <button class="btn deny" type="button" on:click={denyAll}>Deny all</button>
      <button class="btn approve" type="button" on:click={approveAll}>Approve all</button>
    </span>
  </div>
  <div class="qbody" part="body"><slot></slot></div>
</div>
