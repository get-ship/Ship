<!--
  <ship-capability-bar> — @ship/authority · an agent's authority made legible: the
  GRANTS (what it CAN do — domain × max blast tier) and, explicitly, what it CAN'T
  (denied domains carry the reason). The standing-grant companion to op-card's
  per-op gate verdict.

  COMPOSES <ship-blast-tag> for every tier chip so the tier vocabulary reads
  identically across the pack (correction: no inlined blast-tier CSS).

  Data-driven: the design's fixture chips become the `can` / `cant` props (JSON
  arrays); the host binds them to ▸read agent.capabilities. Read-only summary —
  the agent-editor owns the bespoke editable tier-picker (SPEC open item resolved:
  bar stays read-only, no `editable` variant).

  Props:  can   JSON string — [{ domain, tier }]            (granted)
          cant  JSON string — [{ domain, tier, why }]       (denied)
  Part:   capabilities
-->
<prop name="can" type="string" default="[]" />
<prop name="cant" type="string" default="[]" />

<style>
  :host { display: block; font-family: var(--font-body); }
  .cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding: 11px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    box-shadow: var(--shadow-xs);
  }
  .grp { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .glabel {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .glabel.no { color: var(--destructive); }
  .sep { width: 1px; align-self: stretch; background: var(--divider); margin: 2px 0; }

  .chip { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11px; }
  .chip .dom { color: var(--foreground); }
  .chip.locked .dom { color: var(--muted-foreground); }
  .chip.locked svg { width: 11px; height: 11px; color: var(--muted-foreground); }
  .why { color: var(--muted-foreground); font-size: 10.5px; }
</style>

<div class="cap" part="capabilities">
  <div class="grp">
    <span class="glabel">can</span>
    {#for c of canList() key={c.domain}}
      <span class="chip"><span class="dom">{c.domain}</span><ship-blast-tag tier={c.tier}></ship-blast-tag></span>
    {/for}
  </div>
  {#if hasDenied()}
    <span class="sep"></span>
    <div class="grp">
      <span class="glabel no">can't</span>
      {#for d of cantList() key={d.domain}}
        <span class="chip locked">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
          <span class="dom">{d.domain}</span><ship-blast-tag tier={d.tier}></ship-blast-tag>
          {#if d.why}<span class="why">{d.why}</span>{/if}
        </span>
      {/for}
    </div>
  {/if}
</div>
