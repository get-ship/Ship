<!--
  <ship-policy-matrix> — @ship/authority · the capability × blast grid. For each
  domain: the max granted blast tier (a check at every tier ≤ the grant) and a lock
  beyond it. The "what's allowed" companion to capability-bar's at-a-glance summary.

  Data-driven: the design's fixture rows become the `rows` prop (a JSON array); the
  host binds it to ▸read policy. This is the teaching grid where the C0–C3 columns
  are LABELLED (Read/Write/Elevated/Critical mapping) — the per-column tone is the
  axis itself, not a tag, so it is the one authority surface that does NOT compose
  <ship-blast-tag> (the atom renders a chip, not a grid cell).

  Props:  rows  JSON string — [{ domain, granted: 'C0'|'C1'|'C2'|'C3'|'', note }]
                granted = highest allowed tier ('' = operator-only, all locked)
  Part:   matrix
-->
<prop name="rows" type="string" default="[]" />

<style>
  :host { display: block; font-family: var(--font-body); }
  .m {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 9px 12px; text-align: center; border-bottom: 1px solid var(--divider); }
  tr:last-child td { border-bottom: 0; }
  thead th {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    background: var(--surface-2);
  }
  th.dom, td.dom { text-align: left; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--foreground); }
  .c0 { color: var(--muted-foreground); } .c1 { color: var(--info); } .c2 { color: var(--warning); } .c3 { color: var(--destructive); }
  .cell { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: var(--radius-sm); }
  .grant { background: color-mix(in oklch, currentColor 14%, transparent); }
  .grant svg { width: 12px; height: 12px; }
  .lock { color: var(--muted-foreground); opacity: 0.45; }
  .lock svg { width: 11px; height: 11px; }
  .note { font-size: 10px; color: var(--muted-foreground); }
</style>

<div class="m" part="matrix">
  <table>
    <thead><tr><th class="dom">domain</th><th class="c0">C0</th><th class="c1">C1</th><th class="c2">C2</th><th class="c3">C3</th><th>scope</th></tr></thead>
    <tbody>
      {#for r of grid() key={r.domain}}
        <tr>
          <td class="dom">{r.domain}</td>
          {#for cell of r.cells key={cell.tone}}
            <td>
              {#if cell.granted}
                <span class={cell.cls}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
              {:else}
                <span class={cell.cls}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></span>
              {/if}
            </td>
          {/for}
          <td class="note">{r.note}</td>
        </tr>
      {/for}
    </tbody>
  </table>
</div>
