<!--
  <ship-blast-tag> — @ship/authority atom · an op's blast tier (C0–C3): its
  inherent authority weight, escalating tone (C0 muted → C1 info → C2 warning →
  C3 destructive). Extracted from op-card so op-card, capability-bar, gate-log and
  the rest of the pack share ONE atom for the tier vocabulary.

  Presentational: no controller, no events. The tier reflects to the host
  attribute (CSS picks the tone) and the matching C# label shows via CSS — so the
  atom renders correctly from markup alone, with no scope.

  Prop:  tier  C0 | C1 | C2 | C3   (reflect)
  Part:  tag
-->
<prop name="tier" values="C0|C1|C2|C3" default="C0" reflect />

<style>
  :host { display: inline-block; font-family: var(--font-mono); }
  .t {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
  }
  :host([tier='C0']) .t { color: var(--muted-foreground); background: var(--muted); }
  :host([tier='C1']) .t { color: var(--info);        background: var(--tone-info-bg); }
  :host([tier='C2']) .t { color: var(--warning);     background: var(--tone-warning-bg); }
  :host([tier='C3']) .t { color: var(--destructive); background: var(--tone-destructive-bg); }

  /* Label reflects the tier without a controller: show the matching token. */
  .l { display: none; }
  :host([tier='C0']) .l0 { display: inline; }
  :host([tier='C1']) .l1 { display: inline; }
  :host([tier='C2']) .l2 { display: inline; }
  :host([tier='C3']) .l3 { display: inline; }
</style>

<span class="t" part="tag"><span class="l l0">C0</span><span class="l l1">C1</span><span class="l l2">C2</span><span class="l l3">C3</span></span>
