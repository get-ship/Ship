<!--
  <ship-capability-request> — the capability-request modal body.

  Shown when the operator inspects a capability request from the queue. Lays
  out SCOPE / WHY / FOR-HOW-LONG and emits the decision. Presentational +
  event-out, like <ship-approval-card>: the host owns ship.authority.decide().

  `request` is a JSON string (SUI props carry no object type); the controller
  parses it. Same shape as <ship-approval-card>'s request.

  Props:
    request   JSON string — the capability request
    duration  'once' | 'session' | 'always'  (default 'session')
    open      bool — drives the inner <sui-dialog>

  Events (bubble + composed):
    ship-decide  { detail: { id, decision: 'deny' | 'allow', duration } }
    ship-dismiss { detail: {} }   — backdrop / ESC closed the dialog

  Composition: <sui-dialog> chrome, <sui-button> footer actions. The duration
  picker is a component-internal aria-pressed button group (no published
  single-select primitive ships a child element today).
-->

<prop name="request" type="string" default="" />
<prop name="duration" values="once|session|always" default="session" reflect />
<prop name="open" type="bool" default="false" reflect />

<style>
  :host { display: contents; }

  .title {
    margin: 0;
    font-size: var(--text-xs, 0.6875rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .sub {
    margin: var(--space-1, 4px) 0 var(--space-4, 16px);
    font-size: var(--text-sm, 0.875rem);
    color: var(--foreground);
  }

  .section { margin-bottom: var(--space-4, 16px); }
  .label {
    margin: 0 0 var(--space-1, 4px);
    font-size: var(--text-xs, 0.6875rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .value {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--foreground);
  }
  .value-prose { font-family: var(--font-body); }

  .durations {
    display: flex;
    gap: var(--space-2, 8px);
  }
  .duration {
    appearance: none;
    flex: 1;
    padding: var(--space-2, 8px);
    border: 1px solid var(--border);
    border-radius: var(--radius, 6px);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    cursor: pointer;
  }
  .duration[aria-pressed='true'] {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-foreground, var(--background));
  }
</style>

<sui-dialog
  size="sm"
  role-override="alertdialog"
  no-close-button
  bind:this={dialogRef}
>
  <span slot="header">
    <p class="title">Capability request</p>
  </span>

  <p class="sub" data-test="sub">{agent()} · {space()}</p>

  <div class="section">
    <p class="label">Scope</p>
    <div class="value" data-test="scope">{scopeLine()}</div>
  </div>

  <div class="section">
    <p class="label">Why</p>
    <div class="value value-prose" data-test="why">{why()}</div>
  </div>

  <div class="section">
    <p class="label">For how long</p>
    <div class="durations" role="group" aria-label="Duration">
      {#for d of options() key={d.id}}
        <button
          class="duration"
          type="button"
          attr:aria-pressed={duration() === d.id ? 'true' : 'false'}
          on:click={() => pickDuration(d.id)}>
          {d.label}
        </button>
      {/for}
    </div>
  </div>

  <span slot="footer">
    <sui-button variant="outline" tone="destructive" on:click={deny}>Deny</sui-button>
    <sui-button variant="solid" tone="primary" on:click={allow}>Allow</sui-button>
  </span>
</sui-dialog>
