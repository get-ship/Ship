<!--
  <sui-donut> — SUI port of <ship-donut>.
  Distribution donut. Segments drawn as stroked arcs via arcPath().

  Prop parity vs <ship-donut>
  ─────────────────────────────────────────────────────────────────────────────
  Lit              SUI              Notes
  ─────────────────────────────────────────────────────────────────────────────
  data (string)    data (string,    ✓ JSON [{label, value, tone?}]
                     reflect)
  size (number)    size (number)    ✓ default 120
  thickness        thickness        ✓ default 16
  label (string)   label (string)   ✓ aria-label on SVG
  ─────────────────────────────────────────────────────────────────────────────
  Slots: (default) — center content
  Parts: track, segment
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="data" type="string" default="" reflect />
<prop name="size" type="number" default="120" />
<prop name="thickness" type="number" default="16" />
<prop name="label" type="string" default="donut chart" />

<style>
  :host {
    display: inline-block;
    position: relative;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }
  svg { display: block; }
  .track { stroke: var(--muted); }
  .center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--heading-font);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-lg);
    color: var(--foreground);
    line-height: var(--leading-tight);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :host { transition: none; }
  }
</style>

<svg
  viewBox={'0 0 ' + size() + ' ' + size()}
  role="img"
  aria-label={label()}
  style={'width:' + size() + 'px;height:' + size() + 'px'}>
  <circle
    class="track"
    part="track"
    cx={size() / 2}
    cy={size() / 2}
    r={(size() - thickness()) / 2}
    fill="none"
    stroke-width={thickness()}>
  </circle>
  {#for seg of segments() key={seg.id}}
    <path
      part="segment"
      d={seg.d}
      fill="none"
      stroke={seg.color}
      stroke-width={thickness()}
      stroke-linecap="butt">
      <title>{seg.title}</title>
    </path>
  {/for}
</svg>
<div class="center"><slot></slot></div>
