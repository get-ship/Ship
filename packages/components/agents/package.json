{
  "name": "@ship/agents",
  "version": "0.1.0",
  "description": "Ship Agents pack — ship-* components pre-bound to the agents SDK domain (table, card, etc.). Requires a host that has called setShipClient at startup.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/index.ts",
    "./bundle": "./dist/ship-agents.js"
  },
  "scripts": {
    "build": "sui-build",
    "pretest": "sui-build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sdk-client": "workspace:*",
    "@ship/sui-build": "workspace:*",
    "@ship/sui-dom": "workspace:*",
    "@ship/sui-runtime": "workspace:*",
    "@ship/primitives": "workspace:*",
    "@sui/chat-elements": "workspace:*"
  },
  "devDependencies": {
    "@ship/test-setup": "workspace:*",
    "vitest": "^4.1.5"
  }
}
