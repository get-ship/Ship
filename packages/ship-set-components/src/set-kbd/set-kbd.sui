<!--
  <set-kbd> — SUI port of <ship-kbd>.
  Keyboard shortcut display. Renders a single styled <kbd> element.

  Prop / event / method parity vs <ship-kbd>
  ─────────────────────────────────────────────────────────────────────────────
  Lit                             SUI                     Notes
  ─────────────────────────────────────────────────────────────────────────────
  keys (String, '')               OMITTED                 template-only
                                                          constraint — no JS
                                                          to split on '+' and
                                                          render multiple <kbd>
                                                          elements; caller
                                                          places content via
                                                          slot instead
  ─────────────────────────────────────────────────────────────────────────────
  size prop (not in Lit)          size ('sm'|'md',        SUI addition for
                                    reflect)               size-channel control
  ─────────────────────────────────────────────────────────────────────────────
  role="group" aria-label set     OMITTED                 no keys prop means no
    via updated() on host          on host                generated aria-label;
                                                          caller should supply
                                                          aria-label on host if
                                                          used standalone
  ─────────────────────────────────────────────────────────────────────────────
  parts: key (per <kbd>)          part="kbd"              single element
  ─────────────────────────────────────────────────────────────────────────────
  Lit MONO font stack (hardcoded) var(--font-mono)        uses design token
  ─────────────────────────────────────────────────────────────────────────────
-->

<prop name="size" values="sm|md" default="md" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    vertical-align: baseline;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    padding: 2px 5px;
    font-family: var(--font-mono);
    font-weight: var(--font-weight-medium, 500);
    font-size: 11px;
    line-height: 1.2;
    color: var(--foreground);
    background: var(--muted);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-xs);
    white-space: nowrap;
  }

  :host([size='sm']) kbd { font-size: 10px; padding: 1px 4px; min-width: 16px; }
  :host([size='md']) kbd { font-size: 11px; padding: 2px 5px; min-width: 18px; }
</style>

<kbd part="kbd"><slot></slot></kbd>
