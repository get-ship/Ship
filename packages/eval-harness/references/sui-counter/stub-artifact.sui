<!--
  sui-counter — bounded numeric counter with +/− buttons.

  Structural reference artifact used by the stub agent backend (a "perfect-
  agent" emission for harness-CI). Real-agent backends write their own
  artifact; the scorer grades it against expected.json.
-->

<prop name="value" type="number" default="0" reflect />
<prop name="min" type="number" default="-Infinity" />
<prop name="max" type="number" default="Infinity" />
<prop name="step" type="number" default="1" />
<prop name="tone" values="default|primary|accent" default="default" reflect />

<style>
  :host {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    --tone-fg: var(--foreground);
    color: var(--tone-fg);
  }
  :host([tone='primary']) { --tone-fg: var(--primary); }
  :host([tone='accent'])  { --tone-fg: var(--accent); }
  button {
    background: transparent;
    border: 1px solid var(--border, currentColor);
    border-radius: 4px;
    color: inherit;
    cursor: pointer;
    padding: 4px 8px;
  }
  button[disabled] { opacity: 0.4; cursor: not-allowed; }
</style>

<button type="button" on:click={decrement} disabled={value() <= min()}>−</button>
<slot>{value()}</slot>
<button type="button" on:click={increment} disabled={value() >= max()}>+</button>
