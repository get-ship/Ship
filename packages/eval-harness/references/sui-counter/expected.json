{
  "kind": "component",
  "tag": "sui-counter",
  "props": [
    { "name": "value",  "type": "number", "default": 0,                          "reflect": true  },
    { "name": "min",    "type": "number", "default": "Number.NEGATIVE_INFINITY", "reflect": false },
    { "name": "max",    "type": "number", "default": "Number.POSITIVE_INFINITY", "reflect": false },
    { "name": "step",   "type": "number", "default": 1,                          "reflect": false },
    { "name": "tone",   "values": ["default", "primary", "accent"], "default": "default", "reflect": true }
  ],
  "events": [
    { "name": "change", "payloadShape": { "value": "number", "previous": "number" } }
  ],
  "slots": [
    { "name": "default" }
  ],
  "stateKeys": [],
  "forbiddenInController": [
    "innerHTML",
    "outerHTML",
    "insertAdjacentHTML",
    "fetch(",
    "state.value.set(",
    "state.min.set(",
    "state.max.set(",
    "state.step.set(",
    "setAttribute('value'"
  ],
  "requiredInTemplate": [
    "<prop name=\"value\"",
    "<prop name=\"min\"",
    "<prop name=\"max\"",
    "<prop name=\"step\"",
    "on:click=",
    "{value()}"
  ],
  "notes": "Structural reference — not a verbatim file to copy. The evaluator checks PRESENCE of these shapes in the produced artifact + ABSENCE of the forbidden patterns."
}
