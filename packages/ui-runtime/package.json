{
  "name": "@ship/ui-runtime",
  "version": "0.1.0",
  "description": "SUI runtime — fine-grained signals, custom-element wrapper, patch protocol applicator. The reactive engine that templates and components share.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=../../apps/shipd/assets/sui-runtime.js --log-level=warning",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
