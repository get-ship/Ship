{
  "name": "@ship/sdk",
  "version": "0.2.0",
  "description": "Client SDK for Ship daemon — framework-agnostic bridge for views and extensions",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./connect": "./src/connect.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "proto:generate": "cd ../../.. && rm -rf packages/deck/sdk/src/gen && apps/gateway/node_modules/.bin/buf generate --template buf.gen.sdk.yaml"
  },
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.2",
    "@connectrpc/connect": "^2.0.3",
    "@connectrpc/connect-web": "^2.0.3"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.96.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  }
}
