{
  "name": "@ship/sdk-client",
  "version": "0.1.0",
  "description": "Browser-side Ship SDK shim — HTTP fetches and SSE/patch live sources for SUI views.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "bun build src/index.ts --target=browser --format=esm --external=@ship/sui-runtime --outfile=../../../crates/deck/deck-core/assets/sui-sdk-client.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ship/sdk": "workspace:*",
    "@ship/sui-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
