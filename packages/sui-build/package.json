{
  "name": "@ship/sui-build",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "SUI bundling pipeline — compiler runner + Bun/esbuild adapters",
  "bin": {
    "sui-build": "./bin/sui-build.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "esbuild": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  }
}
