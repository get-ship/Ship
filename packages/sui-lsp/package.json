{
  "name": "@ship/sui-lsp",
  "version": "0.1.0",
  "description": "Language Server Protocol implementation for SUI .sui template files.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/server.js",
  "bin": {
    "sui-lsp": "bin/sui-lsp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "bun src/cli.ts"
  },
  "files": [
    "src",
    "dist",
    "bin"
  ],
  "dependencies": {
    "typescript": "~5.4.5",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "vitest": "^4.1.5"
  }
}
