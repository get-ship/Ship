{
  "name": "@ship/ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./elements": "./src/web-components/index.ts",
    "./web-components": "./src/web-components/index.ts",
    "./web-components/*": "./src/web-components/*.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm manifest && pnpm catalog",
    "manifest": "custom-elements-manifest analyze --config custom-elements-manifest.config.mjs",
    "catalog": "node scripts/generate-catalog.mjs",
    "bundle:elements": "esbuild src/web-components/index.ts --bundle --format=esm --target=es2020 --outfile=../../apps/shipd/assets/ship-elements.js --log-level=warning",
    "bundle:code-editor": "esbuild src/web-components/ship-code-editor.ts --bundle --format=esm --target=es2020 --outfile=../../apps/shipd/assets/ship-code-editor.js --log-level=warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-rust": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lit": "^3.2.0",
    "lucide-react": "^0.575.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.27.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "customElements": "custom-elements.json"
}
