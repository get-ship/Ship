{
  "id": "code-reviewer",
  "name": "Code Reviewer",
  "description": "Reviews diffs for security, correctness, and architecture drift.",
  "letter": "C",
  "icon": "shield-check",
  "version": "1.0.0",
  "tags": [
    "review",
    "workflow"
  ],
  "skills": [
    "diff-review",
    "a11y-audit"
  ],
  "mcp_servers": [
    "ship"
  ],
  "rules": [
    "no-placeholders"
  ],
  "inline_rules": "Prefer minimal diffs.",
  "permissions_tier": "standard",
  "permissions": {
    "preset": "ship-standard",
    "tools_allow": [
      "Read",
      "Edit",
      "Bash(git *)"
    ],
    "tools_ask": [
      "Bash(rm -rf *)"
    ],
    "tools_deny": []
  },
  "source": "PROJECT AGENTS"
}
