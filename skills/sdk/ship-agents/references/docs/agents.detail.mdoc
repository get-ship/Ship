    "ship"
  ],
  "rules": [
    "no-placeholders",
    "test-first",
    "commit-style"
  ],
  "inline_rules": "Prefer minimal diffs. Test first.",
  "permissions_tier": "standard",
  "permissions": {
    "preset": "standard",
    "tools_allow": [
      "Bash(cargo *)",
      "Bash(just *)"
    ],
    "tools_ask": [
      "Bash(git push*)"
    ],
    "tools_deny": [
      "Bash(rm -rf *)"
    ]
  },
  "source": "project"
}
