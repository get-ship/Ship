{
  "name": "ship-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/docs",
      "packages/*",
      "apps/workers/*"
    ],
    "catalog": {
      "drizzle-orm": "0.45.1",
      "hono": "4.10.8",
      "zod": "4.3.6"
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@ship/sui-runtime": "file:/home/madvib/dev/sui/packages/sui/runtime",

    "@ship/sui-dom": "file:/home/madvib/dev/sui/packages/sui/dom",
    "@ship/sui-primitives": "file:/home/madvib/dev/sui/packages/components/sui/primitives",
    "@ship/sui-compiler-wasm": "file:/home/madvib/dev/sui/packages/sui/compiler-wasm",
    "@ship/sui-lsp-browser": "file:/home/madvib/dev/sui/packages/deck/lsp-browser",
    "@ship/sui-eval": "file:/home/madvib/dev/sui/packages/deck/eval",
    "@ship/tokens": "file:/home/madvib/dev/sui/packages/sui/tokens"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "lightningcss",
    "sharp",
    "tree-sitter-cli",
    "workerd"
  ],
  "scripts": {
    "build:bundles": "cargo run --manifest-path /home/madvib/dev/sui/Cargo.toml -p deck-cli --quiet -- build-assets",
    "build:apps": "bun run --filter hub build && bun run --filter spaces build",
    "build": "bun run build:bundles && bun run build:apps",
    "wasm": "echo 'sui-wasm moved to the external sui repo — run `cd /home/madvib/dev/sui && wasm-pack build crates/sui/compiler --target web --out-dir packages/sui/compiler-wasm/pkg --out-name sui_compiler -- --features wasm` (or the `just sui-wasm` recipe here for the same call)'",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:visual": "node node_modules/@playwright/test/cli.js test --config tests/e2e/visual/playwright.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.1",
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@playwright/test": "^1.58.2",
    "drizzle-kit": "^0.31.8",
    "lucide-static": "1.14.0",
    "playwright": "^1.59.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vite-plus": "^0.1.11",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.66.0"
  }
}
