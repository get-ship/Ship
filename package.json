{
  "name": "ship-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/docs",
      "apps/shell",
      "apps/site",
      "apps/gateway",
      "packages/*",
      "apps/workers/*"
    ],
    "catalog": {
      "drizzle-orm": "0.45.1",
      "hono": "4.10.8",
      "zod": "4.3.6"
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "lightningcss",
    "sharp",
    "tree-sitter-cli",
    "workerd"
  ],
  "scripts": {
    "build:bundles": "bun run runtime-assets/bundler.ts --all",
    "build:jinja-docs": "node scripts/build-jinja-docs.mjs",
    "test:rust": "cargo test",
    "wasm": "wasm-pack build crates/core/compiler --target web --out-dir ../../../packages/compiler --out-name compiler -- --features wasm",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:visual": "node node_modules/@playwright/test/cli.js test --config tests/e2e/visual/playwright.config.ts",
    "test:parity": "node packages/sui-runtime/fixtures/e2e/parity.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.1",
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@playwright/test": "^1.58.2",
    "drizzle-kit": "^0.31.8",
    "playwright": "^1.59.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vite-plus": "^0.1.11",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.66.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-bubble-menu": "^3.21.0",
    "@tiptap/extension-code-block-lowlight": "^3.21.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/extension-table": "^3.21.0",
    "@tiptap/extension-task-item": "^3.21.0",
    "@tiptap/extension-task-list": "^3.21.0",
    "@tiptap/extension-typography": "^3.21.0",
    "@tiptap/react": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "lowlight": "^3.3.0",
    "tiptap-markdown": "^0.9.0"
  }
}
