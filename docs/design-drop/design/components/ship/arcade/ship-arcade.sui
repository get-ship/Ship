<!--
  ship-arcade.sui — the @ship/arcade LAUNCHER surface. A grid of game tiles (the 8
  arcade tags). Each tile's art is a tone-tinted block + initial (placeholder for
  the PixiJS preview), with title + a meta line. Tone per tile via a modifier class
  (real tokens — the compiler rejects ad-hoc custom props). Compiled as <ship-arcade>.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; }
  .head h3 { margin: 0; font-family: var(--heading-font); font-weight: var(--heading-weight); font-size: var(--text-2xl); color: var(--foreground); }
  .head .sub { font-size: var(--text-sm); color: var(--muted-foreground); }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .tile { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; cursor: pointer; transition: border-color var(--duration-fast), box-shadow var(--duration-fast), transform var(--duration-fast); }
  .tile:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .art { aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 28px; }
  .t-success .art { color: var(--success); background: color-mix(in oklch, var(--success) 16%, var(--card)); }
  .t-info .art { color: var(--info); background: color-mix(in oklch, var(--info) 16%, var(--card)); }
  .t-warning .art { color: var(--warning); background: color-mix(in oklch, var(--warning) 16%, var(--card)); }
  .t-destructive .art { color: var(--destructive); background: color-mix(in oklch, var(--destructive) 16%, var(--card)); }
  .t-accent .art { color: var(--accent); background: color-mix(in oklch, var(--accent) 16%, var(--card)); }
  .t-primary .art { color: var(--primary); background: color-mix(in oklch, var(--primary) 16%, var(--card)); }
  .meta { padding: 8px 10px; }
  .meta .t { font-size: var(--text-sm); font-weight: var(--font-weight-medium, 500); color: var(--foreground); }
  .meta .s { font-size: 11px; color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
</style>
<div class="surface" part="surface">
  <div class="head"><h3>Arcade</h3><span class="sub">8 games · PixiJS</span></div>
  <div class="grid" part="grid">
    <div class="tile t-success"><div class="art">S</div><div class="meta"><div class="t">Snake</div><div class="s">hi 1,240</div></div></div>
    <div class="tile t-info"><div class="art">T</div><div class="meta"><div class="t">Tetris</div><div class="s">hi 18,900</div></div></div>
    <div class="tile t-warning"><div class="art">B</div><div class="meta"><div class="t">Breakout</div><div class="s">hi 4,310</div></div></div>
    <div class="tile t-destructive"><div class="art">P</div><div class="meta"><div class="t">Pong</div><div class="s">2-player</div></div></div>
    <div class="tile t-accent"><div class="art">A</div><div class="meta"><div class="t">Asteroids</div><div class="s">hi 9,650</div></div></div>
    <div class="tile t-primary"><div class="art">2</div><div class="meta"><div class="t">2048</div><div class="s">best 4,096</div></div></div>
    <div class="tile t-info"><div class="art">M</div><div class="meta"><div class="t">Minesweeper</div><div class="s">12 boards</div></div></div>
    <div class="tile t-success"><div class="art">F</div><div class="meta"><div class="t">Flappy</div><div class="s">hi 87</div></div></div>
  </div>
</div>
