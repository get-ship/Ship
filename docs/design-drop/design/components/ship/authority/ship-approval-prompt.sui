<!--
  ship-approval-prompt.sui — @ship/authority · the Ask-stance checkpoint. ★ human-in-the-loop.
  A suspended op held at the gate; Approve(request_id) resolves it. The op NEVER runs
  before approval. APPROACHABLE BY DEFAULT: collapsed shows just the ask + the verbs;
  `open` discloses the call / standing-grant gap / request id. Inline in a transcript or
  a focused modal. Attribute-driven (production wires the toggle + verbs). Tokens only.
  Props: op · args · req · grant · blast(C0|C1|C2|C3) · state(pending|approved|denied|expired) · open.
-->
<prop name="op" type="string" default="op" />
<prop name="args" type="string" default="" />
<prop name="req" type="string" default="" />
<prop name="grant" type="string" default="" />
<prop name="blast" values="C0|C1|C2|C3" default="C2" reflect />
<prop name="state" values="pending|approved|denied|expired" default="pending" reflect />
<prop name="open" type="bool" default="false" reflect />

<style>
  :host { display: block; font-family: var(--font-body); max-width: 100%;
    --accentc: var(--warning); --accent-bg: var(--tone-warning-bg); --accent-bd: var(--tone-warning-border); }
  :host([hidden]) { display: none; }
  :host([state='approved']) { --accentc: var(--success);     --accent-bg: var(--tone-success-bg);     --accent-bd: var(--tone-success-border); }
  :host([state='denied'])   { --accentc: var(--destructive); --accent-bg: var(--tone-destructive-bg); --accent-bd: var(--tone-destructive-border); }
  :host([state='expired'])  { --accentc: var(--muted-foreground); --accent-bg: var(--muted); --accent-bd: var(--border-subtle); }

  .card { position: relative; border: 1px solid var(--accent-bd); border-radius: var(--radius-md); background: var(--card); overflow: hidden; box-shadow: var(--shadow-xs); }
  .card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accentc); }

  /* ── clean header row (the whole calm default) ───────────────── */
  .hd { display: flex; align-items: center; gap: 9px; padding: 11px 13px; }
  .shield { width: 16px; height: 16px; color: var(--accentc); flex-shrink: 0; }
  .htxt { font-weight: var(--font-weight-semibold); font-size: var(--text-sm); color: var(--foreground); white-space: nowrap; }
  .htxt .sub { display: none; }
  :host([state='pending']) .htxt .sub.p { display: inline; }
  :host([state='approved']) .htxt .sub.a { display: inline; }
  :host([state='denied']) .htxt .sub.d { display: inline; }
  :host([state='expired']) .htxt .sub.e { display: inline; }
  .opname { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--accentc); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .blast { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .03em; padding: 2px 7px; border-radius: var(--radius-sm); flex-shrink: 0; }
  :host([blast='C0']) .blast { color: var(--muted-foreground); background: var(--muted); }
  :host([blast='C1']) .blast { color: var(--info);        background: var(--tone-info-bg); }
  :host([blast='C2']) .blast { color: var(--warning);     background: var(--tone-warning-bg); }
  :host([blast='C3']) .blast { color: var(--destructive); background: var(--tone-destructive-bg); }
  .disc { flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px; margin-left: auto; padding: 3px 7px; border: 0; background: transparent; color: var(--muted-foreground); cursor: pointer; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 10px; }
  .disc:hover { background: var(--hover-bg); }
  .disc svg { width: 12px; height: 12px; transition: transform var(--duration-fast) var(--ease-out); }
  :host([open]) .disc svg { transform: rotate(180deg); }

  /* ── disclosed detail ────────────────────────────────────────── */
  .detail { display: none; padding: 0 13px 12px; }
  :host([open]) .detail { display: block; }
  .call { font-family: var(--font-mono); font-size: 12px; line-height: 1.5; color: var(--foreground); background: var(--muted); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 9px 11px; word-break: break-word; }
  .call .fn { font-weight: 600; color: var(--accentc); }
  .req { display: block; margin-top: 7px; font-size: 10.5px; color: var(--muted-foreground); }
  .grant { display: inline-flex; align-items: center; gap: 6px; margin-top: 9px; font-size: var(--text-xs); color: var(--accentc); }
  .grant svg { width: 12px; height: 12px; flex-shrink: 0; }
  .grant b { font-family: var(--font-mono); font-weight: 700; }

  /* ── foot: verbs (pending) or resolved chip ──────────────────── */
  .foot { display: flex; align-items: center; gap: 10px; padding: 10px 13px; border-top: 1px solid var(--divider); }
  .resolved { display: none; align-items: center; gap: 7px; font-size: var(--text-sm); font-weight: var(--font-weight-semibold); color: var(--accentc); }
  .resolved svg { width: 15px; height: 15px; }
  :host([state='approved']) .resolved.a { display: inline-flex; }
  :host([state='denied']) .resolved.d { display: inline-flex; }
  :host([state='expired']) .resolved.e { display: inline-flex; }
  :host(:not([state='pending'])) .actions { display: none; }
  .hint { font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); }
  .actions { display: flex; gap: 8px; margin-left: auto; }
  .btn { font: inherit; font-size: var(--text-sm); font-weight: var(--font-weight-semibold); padding: 6px 15px; border-radius: var(--radius-sm); cursor: pointer; border: 1px solid var(--border); background: var(--card); color: var(--foreground); transition: background var(--duration-fast) var(--ease-out); }
  .btn:hover { background: var(--hover-bg); }
  .deny { border-color: var(--tone-destructive-border); color: var(--destructive); }
  .deny:hover { background: var(--tone-destructive-bg); }
  .approve { background: var(--primary); color: var(--primary-foreground); border-color: var(--primary); }
  .approve:hover { background: color-mix(in oklch, var(--primary) 88%, black); }
</style>

<div class="card" part="card">
  <div class="hd">
    <svg class="shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    <span class="htxt">
      <span class="sub p">Approve</span>
      <span class="sub a">Approved</span>
      <span class="sub d">Denied</span>
      <span class="sub e">Expired</span>
    </span>
    <span class="opname">{op()}</span>
    <span class="blast">{blast()}</span>
    <button class="disc" type="button" aria-label="Details">details<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></button>
  </div>
  <div class="detail" part="detail">
    <div class="call"><span class="fn">{op()}</span>({args()})<span class="req">{req()}</span></div>
    <div class="grant"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7v6c0 5 4 8 10 9 6-1 10-4 10-9V7z"></path></svg>exceeds standing grant <b>{grant()}</b></div>
  </div>
  <div class="foot">
    <span class="resolved a"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>op dispatched</span>
    <span class="resolved d"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>op never ran</span>
    <span class="resolved e"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>released unrun</span>
    <span class="hint">op held at the gate</span>
    <span class="actions">
      <button class="btn deny" type="button">Deny</button>
      <button class="btn approve" type="button">Approve</button>
    </span>
  </div>
</div>
