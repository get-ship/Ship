<!--
  ship-capability-bar.sui — @ship/authority · an agent's authority made legible.
  The canonical successor to the old "wire" sketch: not a tangle of connectors but
  the GRANTS — what the agent can do (domain × max blast tier) and, explicitly, what
  it can't (denied domains carry the reason). Pairs with op-card's live gate verdicts:
  this is the standing grant, the op-card is the per-op decision. Binds (production)
  ▸read agent.capabilities. Static realistic content; tokens only.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .cap { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding: 11px 14px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-xs); }
  .grp { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .glabel { font-family: var(--font-mono); font-size: 9.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-foreground); }
  .glabel.no { color: var(--destructive); }
  .sep { width: 1px; align-self: stretch; background: var(--divider); margin: 2px 0; }

  .chip { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11px; padding: 3px 9px; border-radius: var(--radius-full); border: 1px solid transparent; }
  .chip b { font-weight: 700; }
  .c1 { color: var(--info);    background: var(--tone-info-bg);    border-color: var(--tone-info-border); }
  .c2 { color: var(--warning); background: var(--tone-warning-bg); border-color: var(--tone-warning-border); }
  .c3 { color: var(--destructive); background: var(--tone-destructive-bg); border-color: var(--tone-destructive-border); }
  .locked { color: var(--muted-foreground); background: var(--muted); border-color: var(--border-subtle); }
  .locked svg { width: 11px; height: 11px; }
  .why { color: var(--muted-foreground); font-size: 10.5px; }
</style>

<div class="cap" part="capabilities">
  <div class="grp">
    <span class="glabel">can</span>
    <span class="chip c2">collections <b>C2</b></span>
    <span class="chip c2">runtime <b>C2</b></span>
    <span class="chip c1">mcp <b>C1</b></span>
    <span class="chip c1">sui <b>C1</b></span>
  </div>
  <span class="sep"></span>
  <div class="grp">
    <span class="glabel no">can't</span>
    <span class="chip locked">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
      account <b>C3</b>
    </span>
    <span class="why">operator-only</span>
  </div>
</div>
