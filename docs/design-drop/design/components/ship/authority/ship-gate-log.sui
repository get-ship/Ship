<!--
  ship-gate-log.sui — @ship/authority · the live stream of gate verdicts (audit /
  observability). Row = time · session · op · blast-tag · gate-badge. The honest record
  beneath the rendered UI: every effect, every decision. ▸stream gate verdicts.
  Composes ship-blast-tag + ship-gate-badge. Static realistic content; tokens only.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .log { border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }
  .lh { display: flex; align-items: center; gap: 8px; padding: 9px 13px; border-bottom: 1px solid var(--divider); background: var(--surface-2); font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .lh .live { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); }
  .lh .live .d { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: gl 1.1s ease-in-out infinite; }
  @keyframes gl { 50% { opacity: .3; } }
  .row { display: grid; grid-template-columns: 60px auto 1fr auto auto; align-items: center; gap: 10px; padding: 8px 13px; border-bottom: 1px solid var(--divider); }
  .row:last-child { border-bottom: 0; }
  .tm { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); }
  .ses { font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); }
  .op { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .lh .live .d { animation: none; } }
</style>
<div class="log" part="log">
  <div class="lh"><span class="live"><span class="d"></span>live</span><span>· gate verdicts · space-acme</span></div>
  <div class="row"><span class="tm">12:00:32</span><span class="ses">·0001</span><span class="op">mcp.create</span><ship-blast-tag tier="C2"></ship-blast-tag><ship-gate-badge decision="approved"></ship-gate-badge></div>
  <div class="row"><span class="tm">12:00:06</span><span class="ses">·0001</span><span class="op">mcp.create</span><ship-blast-tag tier="C2"></ship-blast-tag><ship-gate-badge decision="needs-approval"></ship-gate-badge></div>
  <div class="row"><span class="tm">12:00:03</span><span class="ses">·0001</span><span class="op">sui.render</span><ship-blast-tag tier="C1"></ship-blast-tag><ship-gate-badge decision="allowed"></ship-gate-badge></div>
  <div class="row"><span class="tm">12:00:02</span><span class="ses">·0001</span><span class="op">collections.read</span><ship-blast-tag tier="C0"></ship-blast-tag><ship-gate-badge decision="allowed"></ship-gate-badge></div>
  <div class="row"><span class="tm">11:50:09</span><span class="ses">·0004</span><span class="op">runtime.dispatch</span><ship-blast-tag tier="C2"></ship-blast-tag><ship-gate-badge decision="denied"></ship-gate-badge></div>
</div>
