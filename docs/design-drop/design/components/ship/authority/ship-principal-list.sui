<!--
  ship-principal-list.sui — @ship/authority · the principals (agents / roles) and what
  each is granted — the "who" of authority. Row = principal · harness · max-grant chips ·
  edit. Click → policy-matrix for that principal. ▸read principals + policy. Static
  realistic content; tokens only.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .p { border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }
  .row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 11px 14px; border-bottom: 1px solid var(--divider); }
  .row:last-child { border-bottom: 0; }
  .who { display: inline-flex; align-items: center; gap: 9px; }
  .tile { width: 28px; height: 28px; border-radius: var(--radius-sm); display: grid; place-items: center; font-family: var(--font-mono); font-weight: 700; font-size: 11px; }
  .who .nm { font-family: var(--font-mono); font-weight: 600; font-size: var(--text-sm); }
  .who .h { font-family: var(--font-mono); font-size: 10px; padding: 1px 6px; border-radius: var(--radius-sm); }
  .h-floki { color: var(--primary); background: var(--tone-primary-bg); }
  .h-claude { color: var(--accent); background: var(--tone-accent-bg); }
  .grants { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .cap { font-family: var(--font-mono); font-size: 10px; padding: 2px 8px; border-radius: var(--radius-full); border: 1px solid transparent; }
  .cap.c2 { color: var(--warning); background: var(--tone-warning-bg); border-color: var(--tone-warning-border); }
  .cap.c1 { color: var(--info); background: var(--tone-info-bg); border-color: var(--tone-info-border); }
  .cap.lock { color: var(--muted-foreground); background: var(--muted); }
  .edit { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 11px; font-weight: 600; padding: 4px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card); color: var(--muted-foreground); cursor: pointer; }
  .edit:hover { background: var(--hover-bg); color: var(--foreground); }
  .edit svg { width: 11px; height: 11px; }
</style>
<div class="p" part="list">
  <div class="row">
    <span class="who"><span class="tile" style="background:color-mix(in oklch,var(--primary) 16%,var(--card));color:color-mix(in oklch,var(--primary) 88%,var(--foreground))">LT</span><span class="nm">lead-tracker</span><span class="h h-floki">floki</span></span>
    <span class="grants"><span class="cap c2">collections C2</span><span class="cap c2">runtime C2</span><span class="cap c1">mcp C1</span><span class="cap lock">account ✕</span></span>
    <button class="edit" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>Edit grants</button>
  </div>
  <div class="row">
    <span class="who"><span class="tile" style="background:color-mix(in oklch,var(--accent) 16%,var(--card));color:color-mix(in oklch,var(--accent) 88%,var(--foreground))">CR</span><span class="nm">code-reviewer</span><span class="h h-claude">claude</span></span>
    <span class="grants"><span class="cap c2">runtime C2</span><span class="cap c1">code C1</span><span class="cap lock">account ✕</span></span>
    <button class="edit" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>Edit grants</button>
  </div>
  <div class="row">
    <span class="who"><span class="tile" style="background:color-mix(in oklch,var(--info) 16%,var(--card));color:color-mix(in oklch,var(--info) 88%,var(--foreground))">SP</span><span class="nm">spawner</span><span class="h h-floki">floki</span></span>
    <span class="grants"><span class="cap c1">runtime C1</span><span class="cap c1">collections C1</span><span class="cap lock">runtime C2 ✕</span></span>
    <button class="edit" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>Edit grants</button>
  </div>
</div>
