<!--
  ship-space-active-badge.sui — the @ship/spaces ACTIVE BADGE.
  A read-only "currently in X" chip reflecting SpaceService.Active. When no
  space is active (global-only mode: ActiveSpace.active = null), it renders the
  empty state instead. Purely presentational — `name` / `path` are fed by the
  integration layer (Active + Watch(registry)); no controller, no daemon.
  Compiled as <ship-space-active-badge>. Parts: badge · dot · label.
-->
<prop name="name" type="string" default="" />
<prop name="path" type="string" default="" />

<style>
  :host { display: inline-block; font-family: var(--font-body); }
  :host([hidden]) { display: none; }

  .badge {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: 4px 11px 4px 9px;
    border: 1px solid var(--border); border-radius: var(--radius-full);
    background: var(--card); color: var(--foreground);
    font-size: var(--text-sm); line-height: 1;
    max-width: 320px;
  }
  .badge.cold { color: var(--muted-foreground); }

  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); flex-shrink: 0; }
  .badge.cold .dot { background: color-mix(in oklch, var(--foreground) 28%, transparent); }

  .pre { color: var(--muted-foreground); }
  .name { font-weight: var(--font-weight-semibold); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .path { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>

{#if name()}
  <span class="badge" part="badge">
    <span class="dot" part="dot"></span>
    <span class="pre">in</span>
    <span class="name" part="label">{name()}</span>
    {#if path()}<span class="path">{path()}</span>{/if}
  </span>
{:else}
  <span class="badge cold" part="badge">
    <span class="dot" part="dot"></span>
    <span class="name" part="label">No active space</span>
  </span>
{/if}
