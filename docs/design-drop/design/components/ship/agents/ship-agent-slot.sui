<!--
  ship-agent-slot.sui — @ship/agents · a region an agent can inject into. ★ the primitive.
  The general building block behind Agent Canvas — a bounded area the agent renders
  (morphs) UI into. NOT coupled to the canvas feature: drop one in a view, a card, a
  drawer — anywhere an agent should be able to place output. Content is slotted.
  States: empty (awaiting) · rendering (agent injecting) · filled (interactive) · saved.
  Save graduates the injected content into a durable artifact. Attribute-driven, tokens
  only.  ▸stream the agent's render/morph ops · ▸verb Save.  Props: state · label.
-->
<prop name="state" values="empty|rendering|filled|saved" default="filled" reflect />
<prop name="label" type="string" default="" />

<style>
  :host { display: block; font-family: var(--font-body); }
  .slot { position: relative; border-radius: var(--radius-md); min-height: 60px; }

  /* empty — awaiting the agent */
  :host([state='empty']) .slot { border: 1.5px dashed var(--border-strong); background: var(--surface-2); display: grid; place-items: center; padding: 22px; }
  .empty-ui { display: none; flex-direction: column; align-items: center; gap: 7px; color: var(--muted-foreground); text-align: center; }
  :host([state='empty']) .empty-ui { display: flex; }
  .empty-ui svg { width: 20px; height: 20px; }
  .empty-ui .lab { font-family: var(--font-mono); font-size: 11px; }

  /* rendering — agent morphing into the slot */
  .render-ui { display: none; padding: 14px; }
  :host([state='rendering']) .slot { border: 1px solid var(--tone-accent-border); background: var(--card); overflow: hidden; }
  :host([state='rendering']) .render-ui { display: block; }
  .render-tag { position: absolute; top: 8px; right: 8px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); background: var(--tone-accent-bg); border: 1px solid var(--tone-accent-border); border-radius: var(--radius-full); padding: 2px 8px; }
  .render-tag .d { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); animation: slot-blink 1s ease-in-out infinite; }
  .skel { height: 12px; border-radius: var(--radius-sm); background: linear-gradient(90deg, var(--muted) 25%, var(--surface-2) 50%, var(--muted) 75%); background-size: 200% 100%; animation: slot-shim 1.2s linear infinite; margin-bottom: 9px; }
  .skel.w1 { width: 58%; } .skel.w2 { width: 92%; } .skel.w3 { width: 44%; margin-bottom: 0; }
  @keyframes slot-shim { to { background-position: -200% 0; } }
  @keyframes slot-blink { 50% { opacity: .3; } }

  /* filled / saved — injected content (slotted) */
  .content { display: none; }
  :host([state='filled']) .content, :host([state='saved']) .content { display: block; }
  :host([state='filled']) .slot, :host([state='saved']) .slot { border: 1px solid var(--border); background: var(--card); box-shadow: var(--shadow-xs); }
  :host([state='saved']) .slot { border-color: var(--tone-accent-border); }

  /* toolbar — Save on hover (filled); a saved badge once kept */
  .bar { position: absolute; top: 8px; right: 8px; display: none; gap: 5px; z-index: 2; }
  :host([state='filled']) .slot:hover .bar, :host([state='saved']) .bar { display: inline-flex; }
  .btn { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 10.5px; font-weight: 600; padding: 3px 9px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card); color: var(--foreground); cursor: pointer; box-shadow: var(--shadow-xs); }
  .btn svg { width: 11px; height: 11px; }
  .btn.save { color: var(--accent); border-color: var(--tone-accent-border); }
  .btn.save:hover { background: var(--tone-accent-bg); }
  :host([state='saved']) .btn.save { display: none; }
  .saved-badge { display: none; align-items: center; gap: 5px; color: var(--accent); background: var(--tone-accent-bg); border-color: var(--tone-accent-border); }
  :host([state='saved']) .saved-badge { display: inline-flex; }
</style>

<div class="slot" part="slot">
  <div class="empty-ui">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="3 3"></rect><path d="M12 8v8M8 12h8"></path></svg>
    <span class="lab">{label()}</span>
  </div>
  <div class="render-ui">
    <span class="render-tag"><span class="d"></span>rendering</span>
    <div class="skel w1"></div><div class="skel w2"></div><div class="skel w3"></div>
  </div>
  <div class="bar">
    <button class="btn save" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><path d="M17 21v-8H7v8M7 3v5h8"></path></svg>Save</button>
    <span class="btn saved-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>saved</span>
  </div>
  <div class="content" part="content"><slot></slot></div>
</div>
