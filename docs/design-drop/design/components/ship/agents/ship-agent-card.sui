<!--
  ship-agent-card.sui — @ship/agents · browse / launch an agent definition. The
  canonical successor to the old "roster" sketch: identity + harness + a capability
  summary + skills/MCP counts + a Start action + live status. Binds (production)
  ▸read AgentDefs (the unified Agent: identity, harness, disposition, capabilities,
  skills, mcp); ▸verb Start. Composes into the launcher / space "agents" gallery.
  Static realistic content; tokens only.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .card { display: flex; flex-direction: column; gap: 11px; padding: 15px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); transition: box-shadow var(--duration-fast) var(--ease-out); }
  .card:hover { box-shadow: var(--shadow-md); }

  .top { display: flex; align-items: center; gap: 11px; }
  .tile { width: 40px; height: 40px; flex: 0 0 auto; border-radius: var(--radius-md); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 15px; }
  .t-a { background: color-mix(in oklch, var(--primary) 16%, var(--card)); color: color-mix(in oklch, var(--primary) 88%, var(--foreground)); }
  .t-b { background: color-mix(in oklch, var(--accent) 16%, var(--card)); color: color-mix(in oklch, var(--accent) 88%, var(--foreground)); }
  .t-c { background: color-mix(in oklch, var(--info) 16%, var(--card)); color: color-mix(in oklch, var(--info) 88%, var(--foreground)); }
  .who { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .nm { font-weight: 600; font-size: var(--text-md); }
  .sub { display: inline-flex; align-items: center; gap: 7px; }
  .harness { font-family: var(--font-mono); font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: var(--radius-sm); }
  .h-floki  { color: var(--primary); background: var(--tone-primary-bg); }
  .h-claude { color: var(--accent);  background: var(--tone-accent-bg); }
  .model { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); }
  .status { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); }
  .sdot { width: 7px; height: 7px; border-radius: 50%; }
  .on { background: var(--success); } .busy { background: var(--primary); }

  .desc { font-size: var(--text-sm); color: var(--muted-foreground); line-height: 1.5; margin: 0; }
  .caps { display: flex; flex-wrap: wrap; gap: 6px; }
  .cap { font-family: var(--font-mono); font-size: 10px; padding: 2px 8px; border-radius: var(--radius-full); border: 1px solid transparent; }
  .cap.c2 { color: var(--warning); background: var(--tone-warning-bg); border-color: var(--tone-warning-border); }
  .cap.c1 { color: var(--info); background: var(--tone-info-bg); border-color: var(--tone-info-border); }

  .foot { display: flex; align-items: center; gap: 10px; margin-top: 2px; padding-top: 11px; border-top: 1px solid var(--divider); }
  .meta { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); }
  .start { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: var(--text-sm); font-weight: var(--font-weight-semibold); padding: 6px 14px; border-radius: var(--radius-sm); cursor: pointer; border: 1px solid var(--primary); background: var(--primary); color: var(--primary-foreground); }
  .start:hover { background: color-mix(in oklch, var(--primary) 88%, black); }
  .start svg { width: 12px; height: 12px; }
</style>

<div class="cards" part="gallery">
  <div class="card">
    <div class="top">
      <span class="tile t-a">LT</span>
      <div class="who"><span class="nm">lead-tracker</span>
        <span class="sub"><span class="harness h-floki">floki</span><span class="model">opus-4-8</span></span></div>
      <span class="status"><span class="sdot on"></span>idle</span>
    </div>
    <p class="desc">Tracks inbound leads, drafts summaries, files results to collections.</p>
    <div class="caps"><span class="cap c2">collections C2</span><span class="cap c1">mcp C1</span></div>
    <div class="foot"><span class="meta">3 skills · 2 MCP · 4 rules</span>
      <button class="start" type="button"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>Start</button></div>
  </div>

  <div class="card">
    <div class="top">
      <span class="tile t-b">CR</span>
      <div class="who"><span class="nm">code-reviewer</span>
        <span class="sub"><span class="harness h-claude">claude</span><span class="model">sonnet-4-6</span></span></div>
      <span class="status"><span class="sdot busy"></span>active</span>
    </div>
    <p class="desc">Reviews open PRs, runs the test suite, posts inline findings.</p>
    <div class="caps"><span class="cap c2">runtime C2</span><span class="cap c1">code C1</span></div>
    <div class="foot"><span class="meta">5 skills · 1 MCP · 6 rules</span>
      <button class="start" type="button"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>Start</button></div>
  </div>

  <div class="card">
    <div class="top">
      <span class="tile t-c">SP</span>
      <div class="who"><span class="nm">spawner</span>
        <span class="sub"><span class="harness h-floki">floki</span><span class="model">opus-4-8</span></span></div>
      <span class="status"><span class="sdot on"></span>idle</span>
    </div>
    <p class="desc">Decomposes a goal and spawns child sessions to execute in parallel.</p>
    <div class="caps"><span class="cap c2">runtime C2</span><span class="cap c1">collections C1</span></div>
    <div class="foot"><span class="meta">2 skills · 0 MCP · 3 rules</span>
      <button class="start" type="button"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>Start</button></div>
  </div>
</div>
