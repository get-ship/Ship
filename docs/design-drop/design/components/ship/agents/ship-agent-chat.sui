<!--
  ship-agent-chat.sui — @ship/agents · the conversation thread, presentation-agnostic.
  The shell for one session's chat: identity header (agent · session + Switch), a
  scrollable body the turns slot into (sui-message + ship-op-card + ship-approval-prompt),
  and a composer. `surface` = cmdk (centered palette) | drawer (edge sheet) — a user
  SETTING; both toggle/hide to reveal a full canvas. Reconciles with the chrome's
  sui-command-chat (ai mode). Body is slotted.  ▸stream session events · ▸verb Steer.
  Props: surface · agent · session · state.
-->
<prop name="surface" values="cmdk|drawer" default="cmdk" reflect />
<prop name="agent" type="string" default="agent" />
<prop name="session" type="string" default="" />
<prop name="state" values="idle|streaming|awaiting" default="idle" reflect />

<style>
  :host { display: flex; flex-direction: column; min-height: 0; font-family: var(--font-body); background: var(--surface-1); border: 1px solid var(--border-strong); overflow: hidden; --sc: var(--muted-foreground); }
  :host([surface='cmdk']) { border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); }
  :host([surface='drawer']) { border-radius: 0; height: 100%; }
  :host([state='streaming']) { --sc: var(--accent); }
  :host([state='awaiting']) { --sc: var(--warning); }

  .h { display: flex; align-items: center; gap: 9px; padding: 10px 13px; border-bottom: 1px solid var(--divider); background: var(--surface-2); flex: 0 0 auto; }
  .h .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sc); flex-shrink: 0; }
  :host([state='streaming']) .h .dot { animation: ac-blink 1s ease-in-out infinite; }
  @keyframes ac-blink { 50% { opacity: .3; } }
  .h .id { display: grid; line-height: 1.25; min-width: 0; }
  .h .agent { font-weight: 600; font-size: var(--text-sm); }
  .h .sub { font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); }
  .h .switch { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: 10.5px; padding: 3px 9px; border: 1px solid var(--border); border-radius: var(--radius-full); color: var(--muted-foreground); cursor: pointer; }
  .h .switch:hover { background: var(--hover-bg); }
  .h .esc { font-family: var(--font-mono); font-size: 10px; padding: 1px 5px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--muted); color: var(--muted-foreground); }

  .body { flex: 1; min-height: 0; overflow-y: auto; padding: 13px; display: flex; flex-direction: column; gap: 11px; scrollbar-width: thin; }

  .dock { border-top: 1px solid var(--divider); padding: 10px 12px 12px; background: var(--surface-2); flex: 0 0 auto; }
  .composer { display: flex; align-items: center; gap: 8px; padding: 7px 7px 7px 13px; border: 1px solid var(--border); border-radius: var(--radius-full); background: var(--card); }
  .composer input { flex: 1; border: 0; outline: 0; background: transparent; font: inherit; font-size: var(--text-sm); color: var(--foreground); }
  .composer input::placeholder { color: var(--muted-foreground); }
  .send { width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--primary); color: var(--primary-foreground); cursor: pointer; display: grid; place-items: center; flex-shrink: 0; }
  .send svg { width: 14px; height: 14px; }
</style>

<div class="h" part="header">
  <span class="dot"></span>
  <span class="id"><span class="agent">{agent()}</span><span class="sub">{session()}</span></span>
  <span class="switch"><sui-icon name="chevrons-up-down" size="xs"></sui-icon>Switch</span>
  <span class="esc">esc</span>
</div>
<div class="body" part="body"><slot></slot></div>
<div class="dock">
  <div class="composer">
    <input placeholder="Message the agent…" />
    <button class="send" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path></svg></button>
  </div>
</div>
