<!--
  ship-op-card.sui — @ship/agents · the gated op. ★ authority made visible.
  One op event (tool call / code-mode op) rendered with its name + args + result,
  PLUS the two authority signals the Floki model makes first-class:
    • blast tier  — C0..C3, the op's inherent authority weight (escalating tone)
    • gate decision — allowed · approved · needs-approval · denied (+ running)
  A denial renders as DATA (the reason), never a crash. The blast-tag + gate-badge
  vocabulary is @ship/authority's, shown inline here. Same visual family as the
  chat-elements tool-call (state rail + structured body). Attribute-driven, no
  controller. Tokens only.
  Props: op · args · result · reason · ms · blast(C0|C1|C2|C3) · decision.
-->
<prop name="op" type="string" default="op" />
<prop name="args" type="string" default="" />
<prop name="result" type="string" default="" />
<prop name="reason" type="string" default="" />
<prop name="ms" type="string" default="" />
<prop name="blast" values="C0|C1|C2|C3" default="C0" reflect />
<prop name="decision" values="allowed|approved|needs-approval|denied|running" default="allowed" reflect />
<prop name="open" type="bool" default="false" reflect />

<style>
  :host { display: block; font-family: var(--font-body); max-width: 100%;
    --gate: var(--border-strong); --gate-fg: var(--muted-foreground); --gate-bg: var(--muted); }
  :host([hidden]) { display: none; }
  :host([decision='allowed'])        { --gate: var(--border-strong); --gate-fg: var(--muted-foreground); --gate-bg: var(--muted); }
  :host([decision='approved'])       { --gate: var(--success);     --gate-fg: var(--success);     --gate-bg: var(--tone-success-bg); }
  :host([decision='needs-approval']) { --gate: var(--warning);     --gate-fg: var(--warning);     --gate-bg: var(--tone-warning-bg); }
  :host([decision='denied'])         { --gate: var(--destructive); --gate-fg: var(--destructive); --gate-bg: var(--tone-destructive-bg); }
  :host([decision='running'])        { --gate: var(--info);        --gate-fg: var(--info);        --gate-bg: var(--tone-info-bg); }

  .op { position: relative; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); overflow: hidden; box-shadow: var(--shadow-xs); padding-left: 4px; }
  .op::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--gate); }
  :host([decision='running']) .op::before { animation: op-rail 1.1s ease-in-out infinite; }
  @keyframes op-rail { 50% { opacity: .4; } }

  .hd { display: flex; align-items: center; gap: 8px; padding: 9px 12px 9px 11px; flex-wrap: wrap; }
  .fn { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--foreground); min-width: 0; }
  .fn svg { width: 14px; height: 14px; color: var(--gate-fg); flex-shrink: 0; }
  .fn .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fn .paren { color: var(--muted-foreground); font-weight: 400; }

  .blast { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .03em; padding: 2px 7px; border-radius: var(--radius-sm); flex-shrink: 0; }
  :host([blast='C0']) .blast { color: var(--muted-foreground); background: var(--muted); }
  :host([blast='C1']) .blast { color: var(--info);        background: var(--tone-info-bg); }
  :host([blast='C2']) .blast { color: var(--warning);     background: var(--tone-warning-bg); }
  :host([blast='C3']) .blast { color: var(--destructive); background: var(--tone-destructive-bg); }

  .gate { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0;
    font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    padding: 3px 9px; border-radius: var(--radius-full); background: var(--gate-bg); color: var(--gate-fg); }
  .gdot { width: 6px; height: 6px; border-radius: 50%; background: var(--gate-fg); flex-shrink: 0; }
  :host([decision='running']) .gdot { animation: op-rail 1s ease-in-out infinite; }
  .lbl { display: none; }
  :host([decision='allowed']) .lbl.al { display: inline; }
  :host([decision='approved']) .lbl.ap { display: inline; }
  :host([decision='needs-approval']) .lbl.na { display: inline; }
  :host([decision='denied']) .lbl.dn { display: inline; }
  :host([decision='running']) .lbl.rn { display: inline; }
  .gate .ms { display: none; font-variant-numeric: tabular-nums; opacity: .75; }
  :host([decision='allowed']) .gate .ms, :host([decision='approved']) .gate .ms { display: inline; }

  .disc { flex-shrink: 0; width: 22px; height: 22px; display: grid; place-items: center; border: 0; background: transparent; color: var(--muted-foreground); cursor: pointer; border-radius: var(--radius-sm); }
  .disc:hover { background: var(--hover-bg); }
  .disc svg { width: 13px; height: 13px; transition: transform var(--duration-fast) var(--ease-out); }
  :host([open]) .disc svg { transform: rotate(180deg); }

  .row { display: none; align-items: flex-start; gap: 8px; padding: 0 12px 9px 11px; font-family: var(--font-mono); font-size: 11px; line-height: 1.5; }
  :host([open]) .row { display: flex; }
  .tag { flex-shrink: 0; font-size: 8.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--muted-foreground); background: var(--muted); border-radius: var(--radius-sm); padding: 2px 5px; margin-top: 1px; }
  .args { color: var(--muted-foreground); white-space: pre-wrap; word-break: break-word; min-width: 0; }

  .out { display: none; align-items: flex-start; gap: 8px; margin: 0 12px 10px 11px; padding: 8px 10px; border-radius: var(--radius-sm); background: var(--tone-success-bg); border: 1px solid var(--tone-success-border); font-family: var(--font-mono); font-size: 11px; line-height: 1.5; color: var(--foreground); }
  :host([decision='allowed']) .out, :host([decision='approved']) .out { display: flex; }
  .out svg { width: 13px; height: 13px; color: var(--success); flex-shrink: 0; margin-top: 1px; }
  .out .val { color: var(--foreground); white-space: pre-wrap; word-break: break-word; min-width: 0; }

  .reason { display: none; align-items: center; gap: 9px; padding: 9px 12px; border-top: 1px solid var(--gate-bg); background: var(--gate-bg); color: var(--gate-fg); font-size: var(--text-sm); line-height: 1.45; }
  :host([decision='denied']) .reason, :host([decision='needs-approval']) .reason { display: flex; }
  .reason svg { width: 15px; height: 15px; flex-shrink: 0; }
</style>

<div class="op" part="op">
  <div class="hd">
    <span class="fn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"></path></svg>
      <span class="nm">{op()}</span><span class="paren">( )</span>
    </span>
    <span class="blast" part="blast">{blast()}</span>
    <span class="gate" part="gate">
      <span class="gdot"></span>
      <span class="lbl al">allowed</span>
      <span class="lbl ap">approved</span>
      <span class="lbl na">needs approval</span>
      <span class="lbl dn">denied</span>
      <span class="lbl rn">running</span>
      <span class="ms">{ms()}</span>
    </span>
    <button class="disc" type="button" aria-label="Toggle args"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></button>
  </div>
  <div class="row"><span class="tag">args</span><span class="args">{args()}</span></div>
  <div class="out" part="result">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
    <span class="val">{result()}</span>
  </div>
  <div class="reason" part="reason">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>
    <span>{reason()}</span>
  </div>
</div>
