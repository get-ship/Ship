<!--
  ship-session-list.sui — @ship/agents · the sessions in a Space (or cross-space
  in shell). Binds to the canonical `sessions` projection; one row per session:
  status dot (folded state) · harness badge · agent · the input · turn count ·
  time · outcome/reason. Covers the full status fold — active · suspended ·
  completed · failed · cancelled — incl. a denied-grant failure and a spawned
  child (parent). Static realistic content from the sessions fixture; production
  swaps in the live projection behind the same row template. Tokens only.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .panel { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); overflow: hidden; box-shadow: var(--shadow-xs); }
  .head { display: flex; align-items: baseline; gap: 10px; padding: 13px 16px; border-bottom: 1px solid var(--divider); }
  .title { font-family: var(--heading-font); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); font-size: var(--text-lg); }
  .count { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }
  .scope { margin-left: auto; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted-foreground); }

  .filters { display: flex; align-items: center; gap: 6px; padding: 9px 16px; border-bottom: 1px solid var(--divider); flex-wrap: wrap; }
  .fpill { font-family: var(--font-mono); font-size: 11px; padding: 3px 10px; border-radius: var(--radius-full); border: 1px solid var(--border-subtle); background: var(--card); color: var(--muted-foreground); cursor: pointer; }
  .fpill .c { color: var(--foreground); font-weight: 700; margin-left: 4px; }
  .fpill.on { background: var(--selected-bg); border-color: var(--border-strong); color: var(--foreground); }

  .row { display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--divider); cursor: pointer; transition: background var(--duration-fast) var(--ease-out); }
  .row:last-child { border-bottom: 0; }
  .row:hover { background: var(--hover-bg); }

  .st { display: inline-flex; align-items: center; gap: 7px; min-width: 96px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .stlabel { font-family: var(--font-mono); font-size: 11px; font-weight: 600; }
  .d-active    { background: var(--primary); }
  .d-suspended { background: var(--warning); }
  .d-completed { background: var(--success); }
  .d-failed    { background: var(--destructive); }
  .d-cancelled { background: var(--muted-foreground); }
  .l-active    { color: var(--primary); }
  .l-suspended { color: var(--warning); }
  .l-completed { color: var(--success); }
  .l-failed    { color: var(--destructive); }
  .l-cancelled { color: var(--muted-foreground); }
  .pulse { position: relative; }
  .pulse::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--primary); opacity: .5; animation: sl-pulse 1.8s ease-out infinite; }
  @keyframes sl-pulse { to { transform: scale(1.9); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pulse::after { animation: none; } }

  .harness { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .03em; padding: 2px 7px; border-radius: var(--radius-sm); text-transform: lowercase; }
  .h-floki  { color: var(--primary); background: var(--tone-primary-bg); }
  .h-claude { color: var(--accent);  background: var(--tone-accent-bg); }
  .h-codex  { color: var(--info);    background: var(--tone-info-bg); }

  .mid { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .who { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .agent { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--foreground); white-space: nowrap; }
  .child { font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1px 6px; }
  .input { font-size: var(--text-sm); color: var(--muted-foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .reason { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); margin-top: 1px; }
  .reason svg { width: 12px; height: 12px; flex-shrink: 0; }
  .r-warn { color: var(--warning); }
  .r-fail { color: var(--destructive); }
  .r-mute { color: var(--muted-foreground); }

  .end { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; flex-shrink: 0; }
  .turns { font-family: var(--font-mono); font-size: 11px; color: var(--foreground); }
  .turns span { color: var(--muted-foreground); }
  .time { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); }
  .cost { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
</style>

<div class="panel" part="list">
  <div class="head">
    <span class="title">Sessions</span>
    <span class="count">5 sessions</span>
    <span class="scope">space-acme</span>
  </div>

  <div class="filters" part="filters">
    <span class="fpill on">all<span class="c">5</span></span>
    <span class="fpill">active<span class="c">1</span></span>
    <span class="fpill">suspended<span class="c">1</span></span>
    <span class="fpill">completed<span class="c">1</span></span>
    <span class="fpill">failed<span class="c">1</span></span>
    <span class="fpill">cancelled<span class="c">1</span></span>
  </div>

  <!-- active -->
  <div class="row" part="row">
    <span class="st"><span class="dot d-active pulse"></span><span class="stlabel l-active">active</span></span>
    <span class="harness h-claude">claude</span>
    <span class="mid">
      <span class="who"><span class="agent">code-reviewer</span></span>
      <span class="input">Review the open PR for auth.</span>
    </span>
    <span class="end"><span class="turns">5 <span>turns</span></span><span class="time">opus-4-6 · now</span><span class="cost">$0.21</span></span>
  </div>

  <!-- suspended -->
  <div class="row" part="row">
    <span class="st"><span class="dot d-suspended"></span><span class="stlabel l-suspended">suspended</span></span>
    <span class="harness h-floki">floki</span>
    <span class="mid">
      <span class="who"><span class="agent">lead-tracker</span></span>
      <span class="input">Email the Q2 leads.</span>
      <span class="reason r-warn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
        awaiting approval · mcp.create (gmail)
      </span>
    </span>
    <span class="end"><span class="turns">1 <span>turn</span></span><span class="time">opus-4-8 · 2m</span><span class="cost">$0.03</span></span>
  </div>

  <!-- completed -->
  <div class="row" part="row">
    <span class="st"><span class="dot d-completed"></span><span class="stlabel l-completed">completed</span></span>
    <span class="harness h-floki">floki</span>
    <span class="mid">
      <span class="who"><span class="agent">lead-tracker</span></span>
      <span class="input">How many leads this week, and draft a summary email.</span>
    </span>
    <span class="end"><span class="turns">2 <span>turns</span></span><span class="time">opus-4-8 · 12:00</span><span class="cost">$0.04</span></span>
  </div>

  <!-- failed (denied grant) -->
  <div class="row" part="row">
    <span class="st"><span class="dot d-failed"></span><span class="stlabel l-failed">failed</span></span>
    <span class="harness h-floki">floki</span>
    <span class="mid">
      <span class="who"><span class="agent">spawner</span></span>
      <span class="input">Spawn a child to refactor X.</span>
      <span class="reason r-fail">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M15 9l-6 6M9 9l6 6"></path></svg>
        denied · op runtime.dispatch needs the runtime grant (C2)
      </span>
    </span>
    <span class="end"><span class="turns">1 <span>turn</span></span><span class="time">opus-4-8 · 11:50</span><span class="cost">$0.00</span></span>
  </div>

  <!-- cancelled (spawned child) -->
  <div class="row" part="row">
    <span class="st"><span class="dot d-cancelled"></span><span class="stlabel l-cancelled">cancelled</span></span>
    <span class="harness h-floki">floki</span>
    <span class="mid">
      <span class="who"><span class="agent">note-taker</span><span class="child">child of code-reviewer</span></span>
      <span class="input">Summarize standup.</span>
      <span class="reason r-mute">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8 12h8"></path></svg>
        user-requested
      </span>
    </span>
    <span class="end"><span class="turns">0 <span>turns</span></span><span class="time">haiku-4-5 · 12:06</span><span class="cost">$0.00</span></span>
  </div>
</div>
