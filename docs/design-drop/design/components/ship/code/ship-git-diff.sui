<!--
  ship-git-diff.sui — the @ship/code diff SURFACE. Side-by-side diff chrome: a
  file header (path + add/del stat badge + a Split/Unified segmented toggle), a
  hunk header, and a two-pane grid where removed cells tint --tone-destructive-bg
  and added cells tint --tone-success-bg, with per-side line numbers. Token-pure,
  theme-reactive. Compiled as <ship-git-diff>.
-->
<style>
  :host { display: block; font-family: var(--font-body); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); box-shadow: var(--shadow-xs); }
  .hd { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 50%, var(--card)); }
  .path { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--foreground); }
  .stat { display: inline-flex; gap: 6px; font-family: var(--font-mono); font-size: 11px; }
  .stat .add { color: var(--success); } .stat .del { color: var(--destructive); }
  .toggle { margin-left: auto; display: inline-flex; background: var(--muted); border-radius: var(--radius-sm); padding: 2px; }
  .toggle span { font-size: 11px; padding: 3px 9px; border-radius: var(--radius-sm); color: var(--muted-foreground); cursor: pointer; }
  .toggle span.on { background: var(--card); color: var(--foreground); box-shadow: var(--shadow-xs); }
  .hunk { padding: 4px 12px; font-family: var(--font-mono); font-size: 11px; color: var(--info); background: color-mix(in oklch, var(--info) 8%, var(--card)); border-bottom: 1px solid var(--border-subtle); }
  .diff { display: grid; grid-template-columns: 34px 1fr 1px 34px 1fr; font-family: var(--font-mono); font-size: 12px; line-height: 1.65; }
  .gl { text-align: right; padding: 0 8px; color: var(--muted-foreground); background: color-mix(in oklch, var(--muted) 22%, var(--card)); user-select: none; font-variant-numeric: tabular-nums; }
  .cl { padding: 0 10px; white-space: pre; color: var(--foreground); overflow: hidden; }
  .sep { background: var(--border-subtle); }
  .del { background: var(--tone-destructive-bg); }
  .add { background: var(--tone-success-bg); }
  .empty { background: color-mix(in oklch, var(--muted) 16%, var(--card)); }
  .pn { color: var(--muted-foreground); } .tag { color: var(--primary); } .fn { color: var(--accent); }
</style>
<div class="surface" part="surface">
  <div class="hd" part="header">
    <span class="path">components/sui/button.sui</span>
    <span class="stat"><span class="add">+3</span><span class="del">&#8722;1</span></span>
    <span class="toggle"><span class="on">Split</span><span>Unified</span></span>
  </div>
  <div class="hunk">@@ -2,4 +2,6 @@ .btn tone fill</div>
  <div class="diff" part="diff">
    <!-- row 1 ctx -->
    <span class="gl">2</span><span class="cl"><span class="tag">&lt;style&gt;</span></span><span class="sep"></span><span class="gl">2</span><span class="cl"><span class="tag">&lt;style&gt;</span></span>
    <!-- row 2 ctx -->
    <span class="gl">3</span><span class="cl">  <span class="fn">.btn</span> <span class="pn">{</span></span><span class="sep"></span><span class="gl">3</span><span class="cl">  <span class="fn">.btn</span> <span class="pn">{</span></span>
    <!-- row 3 del / add -->
    <span class="gl del">4</span><span class="cl del">    background: <span class="fn">var</span>(--primary)<span class="pn">;</span></span><span class="sep"></span><span class="gl add">4</span><span class="cl add">    background: <span class="fn">var</span>(--tone-bg)<span class="pn">;</span></span>
    <!-- row 4 empty / add -->
    <span class="gl empty"></span><span class="cl empty"></span><span class="sep"></span><span class="gl add">5</span><span class="cl add">    color: <span class="fn">var</span>(--tone-fg)<span class="pn">;</span></span>
    <!-- row 5 ctx -->
    <span class="gl">5</span><span class="cl">  <span class="pn">}</span></span><span class="sep"></span><span class="gl">6</span><span class="cl">  <span class="pn">}</span></span>
    <!-- row 6 ctx -->
    <span class="gl">6</span><span class="cl"><span class="tag">&lt;/style&gt;</span></span><span class="sep"></span><span class="gl">7</span><span class="cl"><span class="tag">&lt;/style&gt;</span></span>
  </div>
</div>
