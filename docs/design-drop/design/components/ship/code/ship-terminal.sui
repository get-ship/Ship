<!--
  ship-terminal.sui — the @ship/code terminal SURFACE (chrome around xterm). The
  xterm canvas is represented by a realistic static session; the title bar (tabs +
  split/new), the framed scrollback, and the status line are the SHIP chrome.
  ANSI-ish colors map to ship tone tokens (theme-reactive, no hex). Compiled as
  <ship-terminal>.
-->
<style>
  :host { display: block; font-family: var(--font-mono); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); box-shadow: var(--shadow-xs); }
  .bar { display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: color-mix(in oklch, var(--muted) 50%, var(--card)); border-bottom: 1px solid var(--border-subtle); font-family: var(--font-body); }
  .ttab { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px; font-size: var(--text-sm); color: var(--foreground); background: var(--card); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); }
  .ttab .glyph { color: var(--success); }
  .bar .acts { margin-left: auto; display: inline-flex; gap: 2px; }
  .bar .acts button { width: 24px; height: 24px; border: 0; background: transparent; color: var(--muted-foreground); border-radius: var(--radius-sm); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .bar .acts button:hover { background: var(--muted); color: var(--foreground); }
  .bar .acts svg { width: 14px; height: 14px; }
  .scroll { padding: 12px 14px; font-size: 12.5px; line-height: 1.65; background: var(--card); white-space: pre-wrap; }
  .l { display: block; }
  .pr { color: var(--primary); }
  .ok { color: var(--success); }
  .warn { color: var(--warning); }
  .err { color: var(--destructive); }
  .path { color: var(--info); }
  .dim { color: var(--muted-foreground); }
  .fg { color: var(--foreground); }
  .cur { display: inline-block; width: 8px; height: 1.05em; background: var(--foreground); vertical-align: text-bottom; }
  .status { display: flex; gap: 14px; padding: 5px 12px; border-top: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 50%, var(--card)); font-size: 11px; color: var(--muted-foreground); }
  .status .sp { margin-left: auto; }
</style>
<div class="surface" part="surface">
  <div class="bar" part="bar">
    <span class="ttab"><span class="glyph">&#9679;</span>zsh — ship</span>
    <span class="acts">
      <button type="button" aria-label="Split"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18"/></svg></button>
      <button type="button" aria-label="New tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg></button>
    </span>
  </div>
  <div class="scroll" part="scrollback">
    <span class="l"><span class="pr">$</span> <span class="fg">ship build --watch</span></span>
    <span class="l"><span class="ok">&#10003;</span> <span class="dim">compiled</span> <span class="fg">24 components</span> <span class="dim">in 312ms</span></span>
    <span class="l"><span class="warn">&#9888;</span> <span class="path">sui-board</span><span class="dim">: edge stroke below contrast on 'console'</span></span>
    <span class="l">&nbsp;</span>
    <span class="l"><span class="pr">$</span> <span class="fg">ship test components/sui</span></span>
    <span class="l">  <span class="ok">PASS</span> <span class="path">button.spec</span> <span class="dim">(12)</span></span>
    <span class="l">  <span class="ok">PASS</span> <span class="path">card.spec</span> <span class="dim">(8)</span></span>
    <span class="l">  <span class="err">FAIL</span> <span class="path">sheet.spec</span> <span class="dim">(1)</span></span>
    <span class="l">    <span class="err">&#10007; selection ring token mismatch</span></span>
    <span class="l"><span class="pr">$</span> <span class="cur"></span></span>
  </div>
  <div class="status" part="status">
    <span>~/ship</span>
    <span class="dim">zsh</span>
    <span class="sp">80&#215;24</span>
    <span>UTF-8</span>
  </div>
</div>
