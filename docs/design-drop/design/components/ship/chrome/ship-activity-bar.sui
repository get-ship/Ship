<!--
  ship-activity-bar.sui — @ship/chrome · the context switcher (vertical). Each item IS a
  context — Agents · Views · Components · Pipelines · Themes — the configurable domains of a
  space. NOT a generic "Explorer", and Library is NOT here (it's a separate surface).
  Selecting a context drives what the navigator panel shows (tree or list). A settings cog
  sits at the foot. Prior art: reference sui-rail (collapsed). Items slotted as buttons, or
  use the baked set. Props: active(agents|views|components|pipelines|themes|settings).
-->
<prop name="active" values="agents|views|components|pipelines|themes|collections|artifacts|settings" default="views" reflect />

<style>
  :host { display: flex; flex-direction: column; align-items: center; padding: 8px 0; gap: 3px; background: var(--surface-2); border-right: 1px solid var(--border-subtle); font-family: var(--font-body); }
  .act { width: 38px; height: 38px; border: 0; background: transparent; border-radius: var(--radius-md); display: grid; place-items: center; color: var(--muted-foreground); cursor: pointer; position: relative; }
  .act:hover { color: var(--foreground); background: var(--hover-bg); }
  .act svg { width: 19px; height: 19px; }
  .act .bar { position: absolute; left: -8px; top: 8px; bottom: 8px; width: 2.5px; border-radius: 2px; background: var(--primary); opacity: 0; }
  :host([active='agents']) .a-agents, :host([active='views']) .a-views, :host([active='components']) .a-components, :host([active='pipelines']) .a-pipelines, :host([active='themes']) .a-themes, :host([active='collections']) .a-collections, :host([active='artifacts']) .a-artifacts, :host([active='settings']) .a-settings { color: var(--primary); }
  :host([active='agents']) .a-agents .bar, :host([active='views']) .a-views .bar, :host([active='components']) .a-components .bar, :host([active='pipelines']) .a-pipelines .bar, :host([active='themes']) .a-themes .bar, :host([active='collections']) .a-collections .bar, :host([active='artifacts']) .a-artifacts .bar, :host([active='settings']) .a-settings .bar { opacity: 1; }
  .spacer { flex: 1; }
</style>

<button class="act a-agents" type="button" title="Agents"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path></svg></button>
<button class="act a-views" type="button" title="Views"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path></svg></button>
<button class="act a-components" type="button" title="Components"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg></button>
<button class="act a-pipelines" type="button" title="Pipelines"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 0 0 9 9"></path></svg></button>
<button class="act a-themes" type="button" title="Themes"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".9"></circle><circle cx="6.5" cy="12.5" r=".9"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.6-.7 1.6-1.5 0-.4-.2-.8-.4-1.1-.3-.4-.4-.7-.4-1.1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-4.4-4.5-8-10-8z"></path></svg></button>
<button class="act a-collections" type="button" title="Collections"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14a9 3 0 0 0 18 0V5"></path><path d="M3 12a9 3 0 0 0 18 0"></path></svg></button>
<button class="act a-artifacts" type="button" title="Artifacts"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><path d="M3.3 7 12 12l8.7-5M12 22V12"></path></svg></button>
<span class="spacer"></span>
<button class="act a-settings" type="button" title="Space settings"><span class="bar"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg></button>
