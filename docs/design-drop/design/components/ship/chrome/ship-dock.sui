<!--
  ship-dock.sui — @ship/chrome · the desktop dock. Floating, blurred tray of apps + a
  divider + Ship surfaces (Studio · Library · Settings). Composes ship-dock-app. The shell
  desktop's launcher. Apps slotted. Tokens only.
-->
<style>
  :host { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 20px; font-family: var(--font-body);
    background: color-mix(in oklch, var(--card) 72%, transparent); backdrop-filter: blur(20px) saturate(1.3); border: 1px solid color-mix(in oklch, var(--border) 80%, transparent); box-shadow: var(--shadow-lg); }
  ::slotted(.div), .div { width: 1px; height: 26px; background: var(--border); margin: 0 5px; }
</style>
<slot></slot>
