<!--
  ship-tree-item.sui — @ship/chrome · one row of a file-tree navigator. Folder (toggles)
  or file (with a filetype tag). Composes into ship-file-tree. The tree only appears when
  a context needs files (views/components) — agents/themes use a list instead.
  Props: name · kind(folder|file) · filetype(sui|ts|css|json|md) · open · selected · depth · status(none|dirty|run).
-->
<prop name="name" type="string" default="" />
<prop name="kind" values="folder|file" default="file" reflect />
<prop name="filetype" values="sui|ts|css|json|md|none" default="none" reflect />
<prop name="open" type="bool" default="false" reflect />
<prop name="selected" type="bool" default="false" reflect />
<prop name="depth" type="number" default="0" />
<prop name="status" values="none|dirty|run" default="none" reflect />

<style>
  :host { display: block; font-family: var(--font-mono); }
  .row { display: flex; align-items: center; gap: 6px; padding: 4px 8px; border-radius: var(--radius-sm); cursor: pointer; color: var(--foreground); white-space: nowrap; }
  .row:hover { background: var(--hover-bg); }
  :host([selected]) .row { background: color-mix(in oklch, var(--primary) 13%, transparent); }
  .pad { display: inline-block; }
  .tw { display: inline-flex; color: var(--muted-foreground); transition: transform var(--duration-fast); }
  :host([open]) .tw { transform: rotate(90deg); }
  :host([kind='file']) .tw { visibility: hidden; }
  .tw svg { width: 13px; height: 13px; }
  .glyph { display: inline-flex; color: var(--primary); } .glyph svg { width: 14px; height: 14px; }
  :host([kind='file']) .glyph { display: none; }
  .nm { flex: 1; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; }
  :host([selected]) .nm { font-weight: 600; }
  .tag { font-size: 8.5px; font-weight: 700; padding: 1px 5px; border-radius: var(--radius-sm); letter-spacing: .03em; }
  :host([filetype='none']) .tag { display: none; }
  :host([filetype='sui']) .tag { color: var(--primary); background: color-mix(in oklch, var(--primary) 13%, transparent); }
  :host([filetype='ts']) .tag { color: var(--info); background: var(--tone-info-bg); }
  :host([filetype='css']) .tag { color: var(--accent); background: var(--tone-accent-bg); }
  :host([filetype='json']) .tag { color: var(--muted-foreground); background: var(--muted); }
  :host([filetype='md']) .tag { color: var(--success); background: var(--tone-success-bg); }
  .dot { width: 6px; height: 6px; border-radius: 50%; }
  :host([status='none']) .dot { display: none; }
  :host([status='dirty']) .dot { background: var(--warning); }
  :host([status='run']) .dot { background: var(--success); }
</style>

<div class="row" part="row" style="padding-left: calc(8px + {depth()} * 14px)">
  <span class="tw"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
  <span class="glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path></svg></span>
  <span class="nm">{name()}</span>
  <span class="tag">{filetype()}</span>
  <span class="dot"></span>
</div>
