<!--
  ship-pipeline-graph.sui — @ship/pipelines surface. NET-NEW feature mock (ship
  pack source was not imported); authored token-pure to the /pipelines domain
  (run graph). A horizontal stage flow: each step is a node with a status dot +
  progress bar, connected by completion-tinted links; the running step pulses
  (reduced-motion gated). Static realistic content. Compiled <ship-pipeline-graph>.
-->
<style>
  :host { display: block; }
  .pl { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }
  .hd { display: flex; align-items: center; gap: 10px; padding: 14px var(--space-5); border-bottom: 1px solid var(--border-subtle); }
  .nm { font-family: var(--font-mono); font-weight: 600; font-size: var(--text-md); }
  .badge { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: var(--radius-full); background: color-mix(in oklch, var(--success) 16%, transparent); color: color-mix(in oklch, var(--success) 80%, var(--foreground)); }
  .runmeta { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }

  .flow { display: flex; align-items: stretch; padding: var(--space-5); overflow-x: auto; }
  .node { flex: 0 0 auto; min-width: 158px; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-xs); }
  .node .row { display: flex; align-items: center; gap: 8px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
  .lbl { font-size: var(--text-sm); font-weight: 600; }
  .sub { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .node.done .dot { background: var(--success); }
  .node.failed .dot { background: var(--destructive); }
  .node.queued .dot { background: var(--muted-foreground); }
  .node.running { border-color: color-mix(in oklch, var(--info) 45%, transparent); }
  .node.running .dot { background: var(--info); }
  @media (prefers-reduced-motion: no-preference) {
    .node.running .dot { animation: pl-pulse 1.5s var(--ease-out) infinite; }
  }
  @keyframes pl-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in oklch, var(--info) 55%, transparent); }
    70%  { box-shadow: 0 0 0 7px color-mix(in oklch, var(--info) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .bar { height: 3px; border-radius: 2px; background: var(--muted); overflow: hidden; }
  .bar > i { display: block; height: 100%; border-radius: 2px; }
  .node.done .bar > i { width: 100%; background: var(--success); }
  .node.running .bar > i { width: 62%; background: var(--info); }
  .node.queued .bar > i { width: 0; }
  .conn { flex: 0 0 26px; align-self: center; height: 2px; background: var(--border); }
  .conn.done { background: color-mix(in oklch, var(--success) 55%, transparent); }
</style>

<div class="pl" part="graph">
  <div class="hd">
    <span class="nm">nightly-reindex</span>
    <span class="badge">passing</span>
    <span class="runmeta">run #8842 · started 11:20 · 18s elapsed</span>
  </div>
  <div class="flow">
    <div class="node done"><div class="row"><span class="dot"></span><span class="lbl">Source pull</span></div><div class="bar"><i></i></div><span class="sub">1.2s · 12,840 rows</span></div>
    <div class="conn done"></div>
    <div class="node done"><div class="row"><span class="dot"></span><span class="lbl">Transform</span></div><div class="bar"><i></i></div><span class="sub">4.8s</span></div>
    <div class="conn done"></div>
    <div class="node running"><div class="row"><span class="dot"></span><span class="lbl">Index</span></div><div class="bar"><i></i></div><span class="sub">12s · running…</span></div>
    <div class="conn"></div>
    <div class="node queued"><div class="row"><span class="dot"></span><span class="lbl">Notify</span></div><div class="bar"><i></i></div><span class="sub">queued</span></div>
  </div>
</div>
