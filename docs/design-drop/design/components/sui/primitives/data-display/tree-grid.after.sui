<!-- sui-tree-grid.after.sui — FIXED (review: changes). Real treegrid semantics +
  visual hierarchy: role="treegrid" on the grid, each row role="row" with
  aria-level + aria-expanded (rows) / aria-selected, cells role="gridcell",
  expand carets that rotate on [aria-expanded], indent guide rails per level, a
  --selected-bg selected row with a --primary rail, hover, --border-subtle rules.
  (Keyboard: →/← expand-collapse, ↑/↓ skipping collapsed subtrees = controller.)
  Static expanded snapshot. Compiled as <x-tree-grid-after>. -->
<style>
  :host { display: block; font-family: var(--font-body); font-size: 13px; width: 460px; max-width: 100%; }
  .tg { border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; background: var(--card); }
  .hr, .row { display: grid; grid-template-columns: 1fr 84px 116px; }
  .hr { background: color-mix(in oklch, var(--muted) 60%, var(--card)); }
  .hr [role='columnheader'] { padding: 7px 10px; font-weight: var(--font-weight-semibold, 600); color: var(--foreground); border-bottom: 1px solid var(--border-subtle); font-size: 11px; letter-spacing: .03em; text-transform: uppercase; }
  .row { position: relative; cursor: pointer; }
  .row [role='gridcell'] { padding: 7px 10px; border-bottom: 1px solid var(--border-subtle); color: var(--foreground); }
  .row:hover { background: var(--hover-bg); }
  .row[aria-selected='true'] { background: var(--selected-bg); }
  .row[aria-selected='true']::before { content: ''; position: absolute; left: 0; top: 4px; bottom: 4px; width: 3px; border-radius: var(--radius-full); background: var(--primary); }
  .nm { display: flex; align-items: center; gap: 6px; }
  .gers { display: inline-flex; }
  .guide { width: 18px; flex: none; align-self: stretch; border-left: 1px solid var(--border-subtle); margin-left: 8px; }
  .caret { width: 14px; height: 14px; flex: none; color: var(--muted-foreground); transition: transform var(--duration-fast); }
  .row[aria-expanded='true'] .caret { transform: rotate(90deg); }
  .spacer { width: 14px; flex: none; }
  .sub { color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
</style>
<div class="tg" role="treegrid" aria-label="Files" part="grid">
  <div class="hr" role="row"><span role="columnheader">Name</span><span role="columnheader">Size</span><span role="columnheader">Modified</span></div>

  <div class="row" role="row" aria-level="1" aria-expanded="true">
    <span role="gridcell"><span class="nm"><svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>src</span></span>
    <span role="gridcell" class="sub">—</span><span role="gridcell" class="sub">2d ago</span>
  </div>
  <div class="row" role="row" aria-level="2">
    <span role="gridcell"><span class="nm"><span class="guide"></span><span class="spacer"></span>app.sui</span></span>
    <span role="gridcell" class="sub">4.1 kB</span><span role="gridcell" class="sub">2d ago</span>
  </div>
  <div class="row" role="row" aria-level="2" aria-expanded="true">
    <span role="gridcell"><span class="nm"><span class="guide"></span><svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>components</span></span>
    <span role="gridcell" class="sub">—</span><span role="gridcell" class="sub">5h ago</span>
  </div>
  <div class="row" role="row" aria-level="3" aria-selected="true">
    <span role="gridcell"><span class="nm"><span class="guide"></span><span class="guide"></span><span class="spacer"></span>button.sui</span></span>
    <span role="gridcell" class="sub">2.3 kB</span><span role="gridcell" class="sub">5h ago</span>
  </div>
  <div class="row" role="row" aria-level="3">
    <span role="gridcell"><span class="nm"><span class="guide"></span><span class="guide"></span><span class="spacer"></span>card.sui</span></span>
    <span role="gridcell" class="sub">1.8 kB</span><span role="gridcell" class="sub">1d ago</span>
  </div>
  <div class="row" role="row" aria-level="1">
    <span role="gridcell"><span class="nm"><span class="spacer"></span>README.md</span></span>
    <span role="gridcell" class="sub">900 B</span><span role="gridcell" class="sub">1w ago</span>
  </div>
</div>
