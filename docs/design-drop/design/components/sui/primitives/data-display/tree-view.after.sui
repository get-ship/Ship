<!--
  sui-tree-view.after.sui — ELEVATED, self-contained static. Diffs vs before:
    • vertical guide lines on nested branches (border-left) so depth + sibling
      grouping read at a glance
    • chevron svg carets (rotate-open) + folder/file icons replace bare glyph carets
    • a selected row gets a --primary tint; hover is a softer wash
  Compiled as <x-tree-after>.
-->
<style>
  :host { display: block; font-family: var(--font-body); font-size: var(--text-sm); color: var(--foreground); }
  :host([hidden]) { display: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  .branch { margin-left: 9px; padding-left: 12px; border-left: 1px solid var(--border-subtle); }
  .row { display: flex; align-items: center; gap: 6px; padding: 4px 7px; border-radius: var(--radius-sm); cursor: pointer; transition: background-color var(--duration-fast) var(--ease-out); }
  .row:hover { background: color-mix(in oklch, var(--foreground) 5%, transparent); }
  .row.sel { background: color-mix(in oklch, var(--primary) 10%, transparent); color: var(--foreground); }
  .caret { width: 12px; height: 12px; flex-shrink: 0; color: var(--muted-foreground); }
  .caret svg { width: 12px; height: 12px; display: block; }
  .caret.open svg { transform: rotate(90deg); }
  .caret.leaf { visibility: hidden; }
  .ic { width: 14px; height: 14px; flex-shrink: 0; color: var(--muted-foreground); }
  .row.sel .ic { color: var(--primary); }
  .ic svg { width: 14px; height: 14px; display: block; }
  .nm { white-space: nowrap; }
</style>

<ul role="tree">
  <li role="treeitem"><div class="row"><span class="caret open"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span><span class="nm">pipelines/</span></div>
    <ul class="branch">
      <li role="treeitem"><div class="row"><span class="caret open"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span><span class="nm">nightly-reindex/</span></div>
        <ul class="branch">
          <li role="treeitem"><div class="row sel"><span class="caret leaf"></span><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5M7 3h8l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg></span><span class="nm">config.yaml</span></div></li>
          <li role="treeitem"><div class="row"><span class="caret leaf"></span><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5M7 3h8l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg></span><span class="nm">run.log</span></div></li>
        </ul>
      </li>
      <li role="treeitem"><div class="row"><span class="caret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span><span class="nm">auth-sync/</span></div></li>
    </ul>
  </li>
  <li role="treeitem"><div class="row"><span class="caret open"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span><span class="nm">fixtures/</span></div>
    <ul class="branch">
      <li role="treeitem"><div class="row"><span class="caret leaf"></span><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5M7 3h8l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg></span><span class="nm">demo-data.json</span></div></li>
    </ul>
  </li>
</ul>
