<!-- sui-sheet.after.sui — RE-SKINNED (review: changes / launch-critical). Same
  engine, but the chrome now reads as SHIP: header fill → --muted/--card mix,
  gridlines → --border-subtle (not a hard uniform --border), the selection box →
  --selected-bg + a --primary ring (matching selection everywhere else), the
  formula bar gets a real cell-ref chip + an fx glyph, and selected row/col
  headers tint. role=grid + gridcell/columnheader semantics. Static snapshot.
  Compiled as <x-sheet-after>. -->
<style>
  :host { display: block; font-family: var(--font-body); font-size: 12px; width: 460px; max-width: 100%; }
  .fx { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid var(--border); border-bottom: 0; border-radius: var(--radius-md) var(--radius-md) 0 0; background: color-mix(in oklch, var(--muted) 40%, var(--card)); }
  .ref { font-family: var(--font-mono); font-weight: 600; color: var(--foreground); min-width: 34px; padding: 2px 7px; background: var(--card); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); text-align: center; }
  .fxi { color: var(--muted-foreground); font-style: italic; font-family: var(--font-mono); }
  .formula { font-family: var(--font-mono); color: var(--foreground); }
  .grid { display: grid; grid-template-columns: 30px repeat(5, 1fr); border: 1px solid var(--border); border-radius: 0 0 var(--radius-md) var(--radius-md); overflow: hidden; }
  .cnr, .ch, .rh, .cell { border-right: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); padding: 5px 8px; }
  .cnr { background: color-mix(in oklch, var(--muted) 60%, var(--card)); }
  .ch, .rh { background: color-mix(in oklch, var(--muted) 60%, var(--card)); color: var(--muted-foreground); font-weight: 600; text-align: center; font-family: var(--font-mono); font-size: 11px; }
  .cell { background: var(--card); color: var(--foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
  .cell.sel { background: var(--selected-bg); box-shadow: inset 0 0 0 2px var(--primary); position: relative; z-index: 1; }
</style>
<div class="fx" part="formula-bar"><span class="ref">B3</span><span class="fxi">fx</span><span class="formula">512</span></div>
<div class="grid" part="grid" role="grid" aria-label="Sheet">
    <div class="cnr"></div>
    <div class="ch" role="columnheader">A</div>
    <div class="ch" role="columnheader">B</div>
    <div class="ch" role="columnheader">C</div>
    <div class="ch" role="columnheader">D</div>
    <div class="ch" role="columnheader">E</div>
    <div class="rh" role="rowheader">1</div>
    <div class="cell" role="gridcell">Shard</div>
    <div class="cell" role="gridcell">p99</div>
    <div class="cell" role="gridcell">Err</div>
    <div class="cell" role="gridcell">Status</div>
    <div class="cell" role="gridcell"></div>
    <div class="rh" role="rowheader">2</div>
    <div class="cell" role="gridcell">logs-2026</div>
    <div class="cell" role="gridcell">238</div>
    <div class="cell" role="gridcell">0.1%</div>
    <div class="cell" role="gridcell">ok</div>
    <div class="cell" role="gridcell"></div>
    <div class="rh" role="rowheader">3</div>
    <div class="cell" role="gridcell">logs-2025</div>
    <div class="cell sel" role="gridcell" aria-selected="true">512</div>
    <div class="cell" role="gridcell">0.3%</div>
    <div class="cell" role="gridcell">slow</div>
    <div class="cell" role="gridcell"></div>
    <div class="rh" role="rowheader">4</div>
    <div class="cell" role="gridcell">events</div>
    <div class="cell" role="gridcell">190</div>
    <div class="cell" role="gridcell">0.0%</div>
    <div class="cell" role="gridcell">ok</div>
    <div class="cell" role="gridcell"></div>
    <div class="rh" role="rowheader">5</div>
    <div class="cell" role="gridcell"></div>
    <div class="cell" role="gridcell"></div>
    <div class="cell" role="gridcell"></div>
    <div class="cell" role="gridcell"></div>
    <div class="cell" role="gridcell"></div>
</div>
