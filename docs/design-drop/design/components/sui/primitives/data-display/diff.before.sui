<!--
  diff.before.sui — the "Existing" baseline for the compare page. Same real
  controller (diff.controller.js) and the same ground-truth row structure;
  this is the FLAT rendering a view gets with no design pass: signs + colored
  text only — no row tints, no accent gutter, no hunk band, tight radius.
  diff.sui is the "New" elevated counterpart. Compiled as <sui-diff-before>.
-->
<prop name="value" type="string" default="" />
<prop name="from" type="string" default="" />
<prop name="to" type="string" default="" />

<style>
  :host { display: block; }
  :host([hidden]) { display: none; }

  .diff {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: auto;
    padding: 8px 0;
  }

  .line {
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 6px;
    padding: 0 12px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .sign { text-align: center; color: var(--muted-foreground); }

  .line.add .sign,
  .line.add .txt { color: var(--success); }
  .line.del .sign,
  .line.del .txt { color: var(--destructive); }
  .line.hunk { color: var(--muted-foreground); }
</style>

<div class="diff" part="content" role="list">
  {#for ln of lines() key={ln.idx}}
    <div class={ln.cls} part="line" role="listitem" aria-label={ln.label}>
      <span class="sign" aria-hidden="true">{ln.sign}</span>
      <span class="txt">{ln.text}</span>
    </div>
  {/for}
</div>
