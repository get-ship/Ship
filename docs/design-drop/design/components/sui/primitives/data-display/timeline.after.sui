<!--
  sui-timeline.after.sui — ELEVATED, self-contained static. Diffs vs before:
    • dots are tone-coded to the event (queued=muted, started=info, retry=warning,
      done=success) with a soft halo ring, so status reads down the gutter at a
      glance instead of a uniform grey column
    • the final/active event dot is enlarged
    • each event gains a one-line description under the title; time in mono
    • connector lightened to --border-subtle for a calmer spine
  Compiled as <x-timeline-after>.
-->
<style>
  :host { display: block; }
  :host([hidden]) { display: none; }
  .list { display: flex; flex-direction: column; }
  .item { display: flex; gap: 13px; }
  .gutter { position: relative; width: 14px; display: flex; justify-content: center; flex-shrink: 0; }
  .gutter::before { content: ''; position: absolute; top: 0; bottom: 0; width: 2px; background: var(--border-subtle); }
  .item:first-child .gutter::before { top: 7px; }
  .item:last-child .gutter::before { bottom: calc(100% - 13px); }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--dotc, var(--muted-foreground)); margin-top: 5px; position: relative; z-index: 1; box-shadow: 0 0 0 3px var(--card), 0 0 0 5px color-mix(in oklch, var(--dotc, var(--muted-foreground)) 18%, transparent); }
  .item.info { --dotc: var(--info); } .item.warn { --dotc: var(--warning); } .item.ok { --dotc: var(--success); }
  .item.ok .dot { width: 11px; height: 11px; margin-top: 4px; }
  .c { padding-bottom: 18px; }
  .time { font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); letter-spacing: .02em; }
  .title { font-size: var(--text-sm); font-weight: var(--font-weight-medium, 500); color: var(--foreground); margin-top: 1px; }
  .desc { font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px; }
</style>

<div class="list" part="list" role="list">
  <div class="item"><div class="gutter"><span class="dot"></span></div><div class="c"><div class="time">09:12:04</div><div class="title">Run queued</div><div class="desc">Triggered by the nightly schedule.</div></div></div>
  <div class="item info"><div class="gutter"><span class="dot"></span></div><div class="c"><div class="time">09:13:01</div><div class="title">Reindex started</div><div class="desc">10 shards dispatched to the off-peak pool.</div></div></div>
  <div class="item warn"><div class="gutter"><span class="dot"></span></div><div class="c"><div class="time">09:17:22</div><div class="title">Shard 1 retried</div><div class="desc">Lock contention; re-queued off-peak.</div></div></div>
  <div class="item ok"><div class="gutter"><span class="dot"></span></div><div class="c"><div class="time">09:21:48</div><div class="title">Completed</div><div class="desc">p99 held at 91ms, within the 120ms budget.</div></div></div>
</div>
