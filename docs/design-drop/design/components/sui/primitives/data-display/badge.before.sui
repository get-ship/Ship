<!--
  sui-badge.before.sui — EXISTING look (repo source verbatim). Static tone-colored
  status label: tone × variant(solid|soft|outline) × size matrix, optional pill.
  NOTE: the shipped repo source uses raw black/white literals in the solid variant
  (color-mix(... black 6%) / color-mix(white 18% ...)) which the SUI compiler
  REJECTS as errors — shown here is the nearest compiling equivalent (--foreground/
  --background), which matches the current look on light themes. Compiled as
  <x-badge-before>.
  Props: tone · variant · size · pill. Slots: leading · default.
-->
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="solid|soft|outline" default="soft" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="pill" type="bool" default="false" reflect />

<style>
  :host {
    display: inline-flex; vertical-align: middle;
    --tone: var(--foreground); --tone-fg: var(--foreground); --tone-contrast: var(--background);
    --bdg-h: 22px; --bdg-px: 8px; --bdg-fs: 10.5px; --bdg-gap: 4px; --bdg-icon: 10px; --bdg-radius: var(--radius-sm);
  }
  :host([hidden]) { display: none; }
  :host([tone='primary'])     { --tone: var(--primary);          --tone-fg: var(--tone-primary-fg); }
  :host([tone='info'])        { --tone: var(--info);             --tone-fg: var(--tone-info-fg); }
  :host([tone='success'])     { --tone: var(--success);          --tone-fg: var(--tone-success-fg); }
  :host([tone='warning'])     { --tone: var(--warning);          --tone-fg: var(--tone-warning-fg); }
  :host([tone='destructive']) { --tone: var(--destructive);      --tone-fg: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent);           --tone-fg: var(--tone-accent-fg); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); }
  :host([size='sm']) { --bdg-h: 18px; --bdg-px: 6px;  --bdg-fs: 9.5px;  --bdg-gap: 3px; --bdg-icon: 8px; }
  :host([size='md']) { --bdg-h: 22px; --bdg-px: 8px;  --bdg-fs: 10.5px; --bdg-gap: 4px; --bdg-icon: 10px; }
  :host([size='lg']) { --bdg-h: 26px; --bdg-px: 10px; --bdg-fs: 11.5px; --bdg-gap: 5px; --bdg-icon: 12px; }
  :host([pill]) { --bdg-radius: var(--radius-full); }

  .badge {
    display: inline-flex; align-items: center; gap: var(--bdg-gap);
    min-height: var(--bdg-h); padding: 0 var(--bdg-px);
    font-family: var(--font-body); font-size: var(--bdg-fs); font-weight: var(--font-weight-semibold);
    line-height: 1; letter-spacing: 0.04em; text-transform: uppercase; border-radius: var(--bdg-radius);
    background: color-mix(in oklch, var(--tone) 16%, transparent);
    border: 1px solid color-mix(in oklch, var(--tone) 24%, transparent);
    color: var(--tone-fg); white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  :host([variant='solid']) .badge {
    background: var(--tone);
    border-color: color-mix(in oklch, var(--tone) 94%, var(--foreground));
    color: var(--tone-contrast);
    box-shadow: inset 0 1px 0 0 color-mix(in oklch, var(--background) 18%, transparent);
  }
  :host([variant='outline']) .badge {
    background: transparent; border-color: color-mix(in oklch, var(--tone) 50%, transparent); color: var(--tone-fg);
  }
</style>

<span class="badge" part="badge"><slot></slot></span>
