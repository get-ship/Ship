<!--
  sui-status-dot.after.sui — ELEVATED. Same contract; the single flat halo becomes
  a two-stop ring — a crisp inner edge (45%) + a soft outer glow (16%) — so the dot
  stays legible on busy/tinted surfaces instead of washing out, and the pulse eases
  the glow rather than just the opacity. Tone mappings as before. Compiled as
  <x-statusdot-after>. Props: tone · pulse · size · label.
-->
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="success" reflect />
<prop name="pulse" type="bool" default="false" reflect />
<prop name="size" values="sm|md" default="md" reflect />
<prop name="label" type="string" default="" />

<style>
  :host { display: inline-flex; vertical-align: middle; --tone-fg: var(--success); }
  :host([tone='default'])     { --tone-fg: var(--foreground); }
  :host([tone='primary'])     { --tone-fg: var(--primary); }
  :host([tone='info'])        { --tone-fg: var(--info); }
  :host([tone='success'])     { --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone-fg: var(--destructive); }
  :host([tone='accent'])      { --tone-fg: var(--accent); }
  :host([tone='muted'])       { --tone-fg: var(--muted-foreground); }

  .dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--tone-fg);
    box-shadow: 0 0 0 1.5px color-mix(in oklch, var(--tone-fg) 45%, transparent), 0 0 0 4.5px color-mix(in oklch, var(--tone-fg) 16%, transparent);
  }
  :host([size='sm']) .dot { width: 6px; height: 6px; box-shadow: 0 0 0 1px color-mix(in oklch, var(--tone-fg) 45%, transparent), 0 0 0 3.5px color-mix(in oklch, var(--tone-fg) 16%, transparent); }

  :host([pulse]) .dot { animation: sui-status-dot-pulse 2.5s var(--ease-out) infinite; }
  @keyframes sui-status-dot-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.82; transform: scale(0.92); } }
  @media (prefers-reduced-motion: reduce) { :host([pulse]) .dot { animation: none; } }
</style>

<span class="dot" part="dot" role={label() ? 'img' : null} aria-label={label() || null} aria-hidden={label() ? null : 'true'}></span>
