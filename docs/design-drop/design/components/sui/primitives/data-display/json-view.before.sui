<!--
  sui-json-view.before.sui — EXISTING look, self-contained static (the real
  component renders controller-generated markup from a `data` JSON string via
  {@html}). Baked sample object with the repo's syntax colors + dashed branch +
  caret. Compiled as <x-json-before>. Props: data · expanded · depth (parity, inert).
-->
<prop name="data" type="string" default="" reflect />
<prop name="expanded" type="bool" default="false" reflect />
<prop name="depth" type="number" default="1" reflect />

<style>
  :host { display: block; font-family: var(--font-mono); font-size: var(--text-sm); line-height: var(--leading-normal); color: var(--foreground); }
  :host([hidden]) { display: none; }
  .node { display: block; }
  .branch { margin-left: 12px; border-left: 1px dashed var(--border); padding-left: 10px; }
  details > summary { list-style: none; cursor: pointer; user-select: none; display: inline-flex; align-items: baseline; gap: 4px; }
  details > summary::-webkit-details-marker { display: none; }
  .caret { display: inline-block; width: 10px; color: var(--muted-foreground); transition: transform var(--duration-fast) var(--ease-out); }
  details[open] > summary .caret { transform: rotate(90deg); }
  .key { color: var(--primary); font-weight: var(--font-weight-medium); }
  .s { color: var(--success); }
  .n { color: var(--info); }
  .b { color: var(--accent); font-weight: var(--font-weight-medium); }
  .null { color: var(--muted-foreground); font-style: italic; }
  .meta { color: var(--muted-foreground); font-size: var(--text-xs); margin-left: 4px; }
</style>

<div class="json-root" part="root">
  <details open>
    <summary><span class="caret">▸</span><span class="key">run</span><span class="meta">{ 7 }</span></summary>
    <div class="branch">
      <div class="node"><span class="key">"run"</span>: <span class="s">"nightly-reindex"</span></div>
      <div class="node"><span class="key">"status"</span>: <span class="s">"success"</span></div>
      <div class="node"><span class="key">"p99_ms"</span>: <span class="n">91</span></div>
      <div class="node"><span class="key">"shards"</span>: <span class="n">10</span></div>
      <details open class="node"><summary><span class="caret">▸</span><span class="key">"retried"</span><span class="meta">[ 1 ]</span></summary>
        <div class="branch"><div class="node"><span class="s">"shard-1"</span></div></div>
      </details>
      <div class="node"><span class="key">"ok"</span>: <span class="b">true</span></div>
      <div class="node"><span class="key">"error"</span>: <span class="null">null</span></div>
    </div>
  </details>
</div>
