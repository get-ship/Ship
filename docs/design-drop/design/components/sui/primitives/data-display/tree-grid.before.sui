<!-- sui-tree-grid.before.sui — EXISTING look (repo). Visually a treegrid (indented
  rows + carets + columns) but it's div soup: NO treegrid roles, no aria-level /
  aria-expanded, so assistive tech can't read the hierarchy. Static expanded
  snapshot. Compiled as <x-tree-grid-before>. -->
<style>
  :host { display: block; font-family: var(--font-body); font-size: 13px; width: 460px; max-width: 100%; }
  .tg { border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
  .hr, .row { display: grid; grid-template-columns: 1fr 84px 116px; }
  .hr { background: var(--muted); font-weight: 600; color: var(--foreground); }
  .hr div, .row div { padding: 6px 10px; border-bottom: 1px solid var(--border); color: var(--foreground); }
  .row:hover { background: var(--muted); }
  .row.sel { background: var(--muted); }
  .nm { display: flex; align-items: center; gap: 6px; }
  .chev { width: 12px; color: var(--muted-foreground); }
  .sub { color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
</style>
<div class="tg">
  <div class="hr"><div>Name</div><div>Size</div><div>Modified</div></div>
  <div class="row"><div class="nm"><span class="chev">&#9662;</span>src</div><div class="sub">—</div><div class="sub">2d ago</div></div>
  <div class="row"><div class="nm" style="padding-left:20px">app.sui</div><div class="sub">4.1 kB</div><div class="sub">2d ago</div></div>
  <div class="row"><div class="nm" style="padding-left:20px"><span class="chev">&#9662;</span>components</div><div class="sub">—</div><div class="sub">5h ago</div></div>
  <div class="row sel"><div class="nm" style="padding-left:40px">button.sui</div><div class="sub">2.3 kB</div><div class="sub">5h ago</div></div>
  <div class="row"><div class="nm" style="padding-left:40px">card.sui</div><div class="sub">1.8 kB</div><div class="sub">1d ago</div></div>
  <div class="row"><div class="nm">README.md</div><div class="sub">900 B</div><div class="sub">1w ago</div></div>
</div>
