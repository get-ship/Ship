<!--
  sui-json-view.after.sui — ELEVATED, self-contained static. Diffs vs before:
    • chevron svg carets (rotate-open) replace the bare glyph; solid --border-subtle
      guide lines instead of dashed for a cleaner spine
    • collapsible rows get a soft hover wash; punctuation is muted so keys/values pop
    • collapsed nodes show a clearer dimmed count chip ({n} / [n])
    • value syntax colors kept (string/number/bool/null), keys to --foreground for
      stronger key↔value contrast
  Compiled as <x-json-after>. Props: data · expanded · depth (parity, inert).
-->
<prop name="data" type="string" default="" reflect />
<prop name="expanded" type="bool" default="false" reflect />
<prop name="depth" type="number" default="1" reflect />

<style>
  :host { display: block; font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.65; color: var(--foreground); }
  :host([hidden]) { display: none; }
  .node { display: block; border-radius: var(--radius-sm); }
  .branch { margin-left: 9px; border-left: 1px solid var(--border-subtle); padding-left: 12px; }
  details > summary { list-style: none; cursor: pointer; user-select: none; display: inline-flex; align-items: center; gap: 5px; padding: 0 4px; border-radius: var(--radius-sm); }
  details > summary:hover { background: color-mix(in oklch, var(--foreground) 5%, transparent); }
  details > summary::-webkit-details-marker { display: none; }
  .leaf:hover { background: color-mix(in oklch, var(--foreground) 4%, transparent); }
  .caret { display: inline-flex; width: 11px; height: 11px; color: var(--muted-foreground); transition: transform var(--duration-fast) var(--ease-out); }
  .caret svg { width: 11px; height: 11px; display: block; }
  details[open] > summary .caret { transform: rotate(90deg); }
  .punc { color: var(--muted-foreground); }
  .key { color: var(--foreground); font-weight: var(--font-weight-medium); }
  .s { color: var(--success); }
  .n { color: var(--info); }
  .b { color: var(--accent); font-weight: var(--font-weight-medium); }
  .null { color: var(--muted-foreground); font-style: italic; }
  .meta { color: var(--muted-foreground); font-size: var(--text-xs); background: var(--muted); border-radius: var(--radius-full); padding: 0 7px; margin-left: 5px; }
</style>

<div class="json-root" part="root">
  <details open>
    <summary><span class="caret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><span class="key">run</span><span class="meta">7 keys</span></summary>
    <div class="branch">
      <div class="node leaf"><span class="key">"run"</span><span class="punc">: </span><span class="s">"nightly-reindex"</span></div>
      <div class="node leaf"><span class="key">"status"</span><span class="punc">: </span><span class="s">"success"</span></div>
      <div class="node leaf"><span class="key">"p99_ms"</span><span class="punc">: </span><span class="n">91</span></div>
      <div class="node leaf"><span class="key">"shards"</span><span class="punc">: </span><span class="n">10</span></div>
      <details open class="node"><summary><span class="caret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><span class="key">"retried"</span><span class="meta">1 item</span></summary>
        <div class="branch"><div class="node leaf"><span class="s">"shard-1"</span></div></div>
      </details>
      <div class="node leaf"><span class="key">"ok"</span><span class="punc">: </span><span class="b">true</span></div>
      <div class="node leaf"><span class="key">"error"</span><span class="punc">: </span><span class="null">null</span></div>
    </div>
  </details>
</div>
