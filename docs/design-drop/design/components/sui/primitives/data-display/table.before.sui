<!--
  sui-table.before.sui — EXISTING look, self-contained static (the real component
  styles slotted rows via a controller-installed document stylesheet + a `data`
  variant driven by columns()/sortedRows() signals). Fixed pipeline-runs table so
  the row/header chrome can be compared. Compiled as <x-table-before>.
  Props: density · striped · hoverable.
-->
<prop name="density" values="compact|default|comfortable" default="default" reflect />
<prop name="striped" type="bool" default="false" reflect />
<prop name="hoverable" type="bool" default="true" reflect />

<style>
  :host { display: block; width: 100%; font-family: var(--font-body); font-size: var(--text-base); color: var(--foreground); --row-py: 10px; --row-px: var(--space-3); --th-py: 10px; }
  :host([hidden]) { display: none; }
  :host([density='compact']) { --row-py: 6px; --th-py: 6px; }
  :host([density='comfortable']) { --row-py: 14px; --th-py: 14px; }
  .wrap { width: 100%; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; overflow-x: auto; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums; }
  th { text-align: left; font-size: var(--text-xs); font-weight: 600; letter-spacing: .02em; color: var(--muted-foreground); padding: var(--th-py) var(--row-px); border-bottom: 1px solid var(--border); white-space: nowrap; }
  td { padding: var(--row-py) var(--row-px); border-bottom: 1px solid var(--border-subtle); white-space: nowrap; }
  th.n, td.n { text-align: right; }
  tbody tr:last-child td { border-bottom: 0; }
  :host([hoverable]) tbody tr:hover td { background: color-mix(in oklch, var(--muted) 45%, transparent); }
  :host([striped]) tbody tr:nth-child(even) td { background: color-mix(in oklch, var(--muted) 30%, transparent); }
</style>

<div class="wrap" part="wrap">
  <table part="table" aria-label="Pipeline runs">
    <thead part="thead"><tr><th>Run</th><th>Status</th><th class="n">p99</th><th class="n">Duration</th><th>Started</th></tr></thead>
    <tbody part="tbody">
      <tr><td>nightly-reindex</td><td>success</td><td class="n">91ms</td><td class="n">4m 12s</td><td>2h ago</td></tr>
      <tr><td>auth-sync</td><td>success</td><td class="n">38ms</td><td class="n">1m 02s</td><td>5h ago</td></tr>
      <tr><td>shard-rebalance</td><td>warning</td><td class="n">120ms</td><td class="n">9m 48s</td><td>1d ago</td></tr>
      <tr><td>export-archive</td><td>error</td><td class="n">—</td><td class="n">0m 30s</td><td>2d ago</td></tr>
    </tbody>
  </table>
</div>
