<!--
  sui-tabs.after.sui — ELEVATED. Same self-contained static render; diffs:
    • inactive tabs get a soft rounded hover wash (discoverable), vs hover that
      only changed text color
    • underline: a thicker rounded 2.5px indicator + 600-weight active label
    • pill: active chip is --card + --shadow-xs + a hairline inset ring so it reads
      raised on muted/console themes (vs a flat --background swap)
    • count badge tightened + tone-tied when active
  Compiled as <x-tabs-after>. Props: active · variant · tone.
-->
<prop name="active" type="string" default="overview" reflect />
<prop name="variant" values="underline|pill|enclosed" default="underline" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent" default="default" reflect />

<style>
  :host { display: block; --tone: var(--primary); }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent); }
  .strip { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--border); }
  :host([variant='pill']) .strip { border-bottom: 0; padding: 4px; background: var(--muted); border-radius: var(--radius-md); }
  :host([variant='enclosed']) .strip { gap: 2px; }

  .tab { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; font: inherit; font-family: var(--font-body); font-size: 13px; font-weight: var(--font-weight-medium, 500); color: var(--muted-foreground); background: transparent; border: 0; border-bottom: 2.5px solid transparent; cursor: pointer; white-space: nowrap; border-radius: var(--radius-sm) var(--radius-sm) 0 0; transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out); }
  .tab:not(.active):hover { color: var(--foreground); background: color-mix(in oklch, var(--foreground) 5%, transparent); }
  .tab.active { color: var(--foreground); font-weight: var(--font-weight-semibold, 600); border-bottom-color: var(--tone); }
  .count { font-size: 11px; padding: 0 6px; border-radius: var(--radius-full); color: var(--muted-foreground); background: color-mix(in oklch, var(--muted) 80%, transparent); }
  .tab.active .count { color: var(--tone); background: color-mix(in oklch, var(--tone) 14%, transparent); }

  :host([variant='pill']) .tab { border-bottom: 0; border-radius: var(--radius-sm); padding: 6px 12px; }
  :host([variant='pill']) .tab.active { background: var(--card); box-shadow: var(--shadow-xs), inset 0 0 0 1px var(--border-subtle); color: var(--foreground); }
  :host([variant='enclosed']) .tab { border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0; border: 1px solid transparent; }
  :host([variant='enclosed']) .tab.active { background: var(--card); border-color: var(--border) var(--border) transparent; color: var(--foreground); position: relative; bottom: -1px; }
</style>

<div class="strip" part="strip" role="tablist">
  <button class={active() === 'overview' ? 'tab active' : 'tab'} role="tab" aria-selected={active() === 'overview' ? 'true' : 'false'}>Overview</button>
  <button class={active() === 'runs' ? 'tab active' : 'tab'} role="tab" aria-selected={active() === 'runs' ? 'true' : 'false'}>Runs<span class="count">12</span></button>
  <button class={active() === 'logs' ? 'tab active' : 'tab'} role="tab" aria-selected={active() === 'logs' ? 'true' : 'false'}>Logs</button>
  <button class={active() === 'settings' ? 'tab active' : 'tab'} role="tab" aria-selected={active() === 'settings' ? 'true' : 'false'}>Settings</button>
</div>
