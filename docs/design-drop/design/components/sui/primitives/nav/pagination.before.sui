<!--
  sui-pagination.before.sui — EXISTING look (repo styling), static. Minimal bar:
  Prev · info · Next (the real component derives info()/totalPages() + wires
  prev/next in its controller). Compiled as <x-pagination-before>.
  Props: page · total · per-page.
-->
<prop name="page" type="number" default="2" reflect />
<prop name="total" type="number" default="240" reflect />
<prop name="per-page" type="number" default="25" reflect />

<style>
  :host { display: block; }
  nav.bar { display: flex; align-items: center; gap: 12px; font-size: 0.8125rem; font-family: var(--font-body); }
  .info { color: var(--muted-foreground); user-select: none; white-space: nowrap; }
  .spacer { flex: 1; }
  .pg-btn { display: inline-flex; align-items: center; justify-content: center; height: 28px; padding: 0 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: transparent; color: var(--foreground); font-family: var(--font-body); font-size: 0.8125rem; cursor: pointer; transition: background-color var(--duration-fast); }
  .pg-btn:hover { background: var(--muted); border-color: color-mix(in oklch, var(--border) 160%, transparent); }
</style>

<nav class="bar" aria-label="Pagination">
  <button class="pg-btn" part="prev" aria-label="Previous page">Prev</button>
  <span class="info" part="info">26–50 of 240</span>
  <span class="spacer"></span>
  <button class="pg-btn" part="next" aria-label="Next page">Next</button>
</nav>
