<!--
  cluster.before.sui — the "Existing" baseline: the hand-rolled wrapping row
  a view writes inline today. Declares the same props so the compare page can
  pass them, but HARDCODES a single pixel gap and ignores align / justify —
  the rigidity sui-cluster replaces. Compiled as <sui-cluster-before>. The
  real token-driven primitive is cluster.sui.
-->
<prop name="gap" values="0|1|2|3|4|5|6|7|8" default="3" reflect />
<prop name="align" values="start|center|end|baseline" default="center" reflect />
<prop name="justify" values="start|center|end|between|around" default="start" reflect />

<style>
  :host { display: block; }
  :host([hidden]) { display: none; }
  /* one bespoke rule, one magic number — no token, no align/justify handling */
  .cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: flex-start;
  }
</style>

<div class="cluster"><slot></slot></div>
