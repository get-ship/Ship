<!--
  sui-error-state.before.sui — EXISTING look (repo). A centered failure state:
  icon + title + description + a retry action slot. Flat, no surface, no error
  code. Compiled as <x-error-state-before>. Props: title · body. Slots: icon · action.
-->
<prop name="title" type="string" default="" />
<prop name="body" type="string" default="" />
<style>
  :host { display: block; font-family: var(--font-body); }
  .box { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 48px 16px; text-align: center; }
  .ico { color: var(--destructive); display: inline-flex; }
  ::slotted([slot='icon']) { width: 26px; height: 26px; }
  .t { font-size: var(--text-md); color: var(--foreground); font-weight: 600; }
  .d { font-size: var(--text-sm); color: var(--muted-foreground); max-width: 40ch; line-height: 1.5; }
  .act { margin-top: 6px; }
</style>
<div class="box" part="box" role="alert">
  <span class="ico"><slot name="icon"></slot></span>
  <div class="t">{title()}</div>
  <div class="d">{body()}</div>
  <div class="act"><slot name="action"></slot></div>
</div>
