<!--
  sui-empty-state.after.sui — ELEVATED. Same slot contract; the default empty card
  goes from a flat dashed box to a composed, inviting state:
    • frame: dashed --border → a soft solid card (--border + faint --muted wash +
      --shadow-xs) — reads intentional, not unfinished
    • icon tile: full-circle flat tint → a rounded-square --tone tile with a hairline
      ring + the tone color, giving the state a clear visual anchor
    • type: title --foreground at a firmer weight, desc with tighter measure
  Variants (inline/placeholder) preserved. Compiled as <x-emptystate-after>.
  Props: variant · size · tone. Slots: icon · title · (default) · action.
-->
<prop name="variant" values="default|inline|placeholder|connecting" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="muted" reflect />

<style>
  :host {
    display: block; font-family: var(--font-body); color: var(--muted-foreground); --tone-fg: var(--muted-foreground); --tone-bg: var(--muted);
    --es-pad-y: 60px; --es-pad-x: 16px; --es-gap: var(--space-3); --es-icon: 22px; --es-tile: 50px;
    --es-title-fs: var(--text-md); --es-desc-fs: var(--text-sm); --es-radius: var(--radius-lg);
  }
  :host([hidden]) { display: none; }
  :host([tone='primary'])     { --tone-fg: var(--tone-primary-fg);     --tone-bg: var(--tone-primary-bg); }
  :host([tone='info'])        { --tone-fg: var(--tone-info-fg);        --tone-bg: var(--tone-info-bg); }
  :host([tone='success'])     { --tone-fg: var(--tone-success-fg);     --tone-bg: var(--tone-success-bg); }
  :host([tone='warning'])     { --tone-fg: var(--tone-warning-fg);     --tone-bg: var(--tone-warning-bg); }
  :host([tone='destructive']) { --tone-fg: var(--destructive);         --tone-bg: var(--tone-destructive-bg); }
  :host([size='sm']) { --es-pad-y: 28px; --es-gap: var(--space-2); --es-icon: 16px; --es-tile: 38px; --es-title-fs: var(--text-base); }
  :host([size='lg']) { --es-pad-y: 92px; --es-pad-x: var(--space-6); --es-gap: var(--space-4); --es-icon: 28px; --es-tile: 66px; --es-title-fs: var(--text-lg); --es-desc-fs: var(--text-base); }
  :host([variant='inline']) { --es-pad-y: var(--space-3); --es-pad-x: var(--space-4); }

  .box { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--es-gap); padding: var(--es-pad-y) var(--es-pad-x); text-align: center; background: color-mix(in oklch, var(--muted) 30%, var(--card)); border: 1px solid var(--border); border-radius: var(--es-radius); box-shadow: var(--shadow-xs); }
  :host([variant='inline']) .box { flex-direction: row; align-items: center; justify-content: flex-start; text-align: left; border-radius: var(--radius-md); }
  :host([variant='placeholder']) .box, :host([variant='connecting']) .box { background: transparent; border: 0; box-shadow: none; }

  .icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: var(--es-tile); height: var(--es-tile); border-radius: var(--radius-lg); background: var(--tone-bg); color: var(--tone-fg); line-height: 1; box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--tone-fg) 22%, transparent); }
  :host([variant='inline']) .icon { width: var(--es-icon); height: var(--es-icon); background: transparent; box-shadow: none; }
  ::slotted([slot='icon']) { display: inline-flex; align-items: center; justify-content: center; color: currentColor; }
  ::slotted(svg[slot='icon']) { width: var(--es-icon); height: var(--es-icon); }
  .copy { display: flex; flex-direction: column; gap: 5px; align-items: center; min-width: 0; }
  :host([variant='inline']) .copy { align-items: flex-start; }
  .title { font-family: var(--heading-font, var(--font-body)); font-size: var(--es-title-fs); font-weight: var(--heading-weight, 600); color: var(--foreground); line-height: var(--leading-tight, 1.25); }
  .desc { font-size: var(--es-desc-fs); max-width: 38ch; line-height: 1.55; color: var(--muted-foreground); }
  .actions { display: flex; gap: var(--space-2); justify-content: center; margin-top: 6px; flex-wrap: wrap; }
  :host([variant='inline']) .actions { margin-top: 0; margin-left: auto; justify-content: flex-end; }
</style>

<div class="box" part="box" role="note">
  <div class="icon" part="icon" aria-hidden="true"><slot name="icon"></slot></div>
  <div class="copy">
    <div class="title" part="title"><slot name="title"></slot></div>
    <div class="desc" part="desc"><slot></slot></div>
  </div>
  <div class="actions" part="actions"><slot name="action"></slot></div>
</div>
