<!--
  sui-empty-state.before.sui — EXISTING look (repo styling), controller-free
  (icon reflect-empty dropped; provide an icon slot in the demo). Centered
  placeholder: dashed card, tinted icon tile, title/desc/action. Compiled as
  <x-emptystate-before>. Props: variant · size · tone. Slots: icon · title · (default) · action.
-->
<prop name="variant" values="default|inline|placeholder|connecting" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="muted" reflect />

<style>
  :host {
    display: block; font-family: var(--font-body); color: var(--muted-foreground); --tone-fg: var(--muted-foreground);
    --es-pad-y: 64px; --es-pad-x: 16px; --es-gap: var(--space-3); --es-icon: 22px; --es-tile: 48px;
    --es-title-fs: var(--text-md); --es-desc-fs: var(--text-sm); --es-radius: var(--radius-lg);
    --es-border: 1px dashed var(--border); --es-bg: var(--card);
  }
  :host([hidden]) { display: none; }
  :host([tone='primary'])     { --tone-fg: var(--primary); }
  :host([tone='info'])        { --tone-fg: var(--info); }
  :host([tone='success'])     { --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone-fg: var(--destructive); }
  :host([size='sm']) { --es-pad-y: 28px; --es-gap: var(--space-2); --es-icon: 16px; --es-tile: 36px; --es-title-fs: var(--text-base); }
  :host([size='lg']) { --es-pad-y: 96px; --es-pad-x: var(--space-6); --es-gap: var(--space-4); --es-icon: 28px; --es-tile: 64px; --es-title-fs: var(--text-lg); --es-desc-fs: var(--text-base); }
  :host([variant='inline']) { --es-bg: color-mix(in oklch, var(--muted) 55%, transparent); --es-radius: var(--radius-md); --es-pad-y: var(--space-3); --es-pad-x: var(--space-4); }

  .box { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--es-gap); padding: var(--es-pad-y) var(--es-pad-x); text-align: center; background: var(--es-bg); border: var(--es-border); border-radius: var(--es-radius); }
  :host([variant='inline']) .box { flex-direction: row; align-items: center; justify-content: flex-start; text-align: left; }
  .icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: var(--es-tile); height: var(--es-tile); border-radius: var(--radius-full); background: color-mix(in oklch, var(--tone-fg) 18%, var(--muted)); color: var(--tone-fg); line-height: 1; }
  :host([tone='muted']) .icon, :host([tone='default']) .icon { background: var(--muted); color: var(--muted-foreground); }
  :host([variant='inline']) .icon { width: var(--es-icon); height: var(--es-icon); background: transparent; }
  ::slotted([slot='icon']) { display: inline-flex; align-items: center; justify-content: center; color: currentColor; }
  ::slotted(svg[slot='icon']) { width: var(--es-icon); height: var(--es-icon); }
  .copy { display: flex; flex-direction: column; gap: 4px; align-items: center; min-width: 0; }
  :host([variant='inline']) .copy { align-items: flex-start; }
  .title { font-family: var(--heading-font, var(--font-body)); font-size: var(--es-title-fs); font-weight: var(--heading-weight, 600); color: var(--foreground); line-height: var(--leading-tight, 1.25); }
  .desc { font-size: var(--es-desc-fs); max-width: 40ch; color: var(--muted-foreground); }
  .actions { display: flex; gap: var(--space-2); justify-content: center; margin-top: 4px; flex-wrap: wrap; }
  :host([variant='inline']) .actions { margin-top: 0; margin-left: auto; justify-content: flex-end; }
</style>

<div class="box" part="box" role="note">
  <div class="icon" part="icon" aria-hidden="true"><slot name="icon"></slot></div>
  <div class="copy">
    <div class="title" part="title"><slot name="title"></slot></div>
    <div class="desc" part="desc"><slot></slot></div>
  </div>
  <div class="actions" part="actions"><slot name="action"></slot></div>
</div>
