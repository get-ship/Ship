<!--
  sui-toast.after.sui — ELEVATED, on the alert language. The flat card gains the
  tone tile (icon seats in a --tone-bg rounded tile), title/body hierarchy
  (--foreground / --muted-foreground), an action slot, a quieter close that tints
  on hover, --shadow-lg float, and a thin auto-dismiss timer bar in the tone
  (the affordance a transient toast needs and the flat one lacks). role/aria kept.
  Token-pure. Compiled as <x-toast-after>. Props: tone · title · body. Slots: icon · action.
-->
<prop name="tone" values="info|success|warning|destructive" default="info" reflect />
<prop name="title" type="string" default="" />
<prop name="body" type="string" default="" />
<style>
  :host { display: block; font-family: var(--font-body); --tone: var(--info); --tone-fg: var(--info); --tone-bg: var(--tone-info-bg); }
  :host([tone='success'])     { --tone: var(--success);     --tone-fg: var(--tone-success-fg); --tone-bg: var(--tone-success-bg); }
  :host([tone='warning'])     { --tone: var(--warning);     --tone-fg: var(--tone-warning-fg); --tone-bg: var(--tone-warning-bg); }
  :host([tone='destructive']) { --tone: var(--destructive); --tone-fg: var(--destructive);      --tone-bg: var(--tone-destructive-bg); }
  .toast { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 11px; padding: 12px 14px; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); width: 340px; overflow: hidden; }
  .ico { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; flex: none; border-radius: var(--radius-md); background: var(--tone-bg); color: var(--tone-fg); }
  ::slotted([slot='icon']) { width: 15px; height: 15px; display: inline-flex; }
  .c { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .t { font-size: 13px; font-weight: 600; color: var(--foreground); }
  .b { font-size: 12px; color: var(--muted-foreground); line-height: 1.45; }
  .act { margin-top: 8px; display: flex; gap: 8px; }
  .act:empty { display: none; }
  .x { border: 0; background: transparent; color: var(--muted-foreground); cursor: pointer; font-size: 15px; line-height: 1; width: 22px; height: 22px; border-radius: var(--radius-sm); display: inline-flex; align-items: center; justify-content: center; }
  .x:hover { background: var(--tone-bg); color: var(--tone-fg); }
  .timer { position: absolute; left: 0; bottom: 0; height: 2px; width: 62%; background: var(--tone); border-top-right-radius: var(--radius-full); }
</style>
<div class="toast" part="toast" role={tone() === 'destructive' ? 'alert' : 'status'} aria-live={tone() === 'destructive' ? 'assertive' : 'polite'} aria-atomic="true">
  <span class="ico"><slot name="icon"></slot></span>
  <div class="c"><div class="t">{title()}</div><div class="b">{body()}</div><div class="act"><slot name="action"></slot></div></div>
  <button class="x" part="close" aria-label="Dismiss">&#215;</button>
  <span class="timer" part="timer" aria-hidden="true"></span>
</div>
