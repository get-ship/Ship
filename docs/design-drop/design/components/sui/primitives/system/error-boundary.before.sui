<!--
  error-boundary.before.sui — "Existing" baseline. The boundary renders its
  children normally and swaps to a fallback when a descendant throws (the
  catch/reset machinery is ground truth in sui-error-boundary.controller.ts;
  `data-error-message` is set on the host). Existing fallback = a bare line of
  red text — functional, unloved. Compiled as <sui-error-boundary-before>.
  `failed` here stands in for the caught-error branch so the state is visible.
-->
<prop name="failed" type="bool" default="false" reflect />
<prop name="message" type="string" default="Something went wrong." />

<style>
  :host { display: block; }
  :host([failed]) .ok { display: none; }
  :host(:not([failed])) .fallback { display: none; }
  .fallback {
    color: var(--destructive);
    font-size: var(--text-sm);
    padding: 6px 0;
  }
</style>

<div class="ok" part="content"><slot></slot></div>
<div class="fallback" part="fallback" role="alert">{message()}</div>
