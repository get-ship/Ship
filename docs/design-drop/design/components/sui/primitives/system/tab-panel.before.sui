<!--
  tab-panel.before.sui — "Existing" baseline. The content region a parent
  <sui-tabs> reveals. Behavior (role=tabpanel, tabindex, aria-labelledby id
  sync) is ground truth in sui-tab-panel.controller.ts; the VISUAL design is
  the gap. Existing = flush content, no padding, no focus treatment, no
  entrance. Compiled as <sui-tab-panel-before>. tab-panel.after.sui elevates.
-->
<prop name="active" type="bool" default="false" reflect />
<prop name="name" type="string" default="" reflect />

<style>
  :host { display: block; }
  :host(:not([active])) { display: none; }
  .panel { font-size: var(--text-sm); color: var(--foreground); line-height: 1.5; }
</style>

<div class="panel" part="panel"><slot></slot></div>
