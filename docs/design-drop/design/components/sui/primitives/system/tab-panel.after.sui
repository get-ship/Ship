<!--
  tab-panel.after.sui — "New" elevated. Same ground-truth contract (shown only
  when [active]; the controller keeps role/tabindex/aria in sync). Adds the
  design the source leaves to CSS: comfortable reading padding, a focusable
  region with a token focus ring, and a reduced-motion-gated entrance so the
  switch reads as a transition, not a jump. Compiled as <sui-tab-panel-after>.
-->
<prop name="active" type="bool" default="false" reflect />
<prop name="name" type="string" default="" reflect />

<style>
  :host { display: block; }
  :host(:not([active])) { display: none; }
  :host { outline: none; }
  :host(:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }
  .panel {
    padding: var(--space-5) var(--space-1);
    font-size: var(--text-sm);
    color: var(--foreground);
    line-height: 1.65;
  }
  @media (prefers-reduced-motion: no-preference) {
    :host([active]) .panel { animation: tabpanel-in var(--duration-medium) var(--ease-out); }
  }
  @keyframes tabpanel-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: none; }
  }
</style>

<div class="panel" part="panel"><slot></slot></div>
