<!-- sui-radio.after.sui — ELEVATED. Props + template identical to before; pure <style> diff. Compiled as <x-radio-after>.
  Unification only (radio was already strong):
    1. Circle surface --background → --card (matches field controls).
    2. Idle/hover border → --border-strong token (was color-mix 160/220%).
    3. Focus ring → shared recipe (0 0 0 1px --card, 0 0 0 3px color-mix(--tone 22%)) replacing the --ring-offset/--ring-width stack.
  Tokens only. -->
<prop name="value" type="string" default="" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="checked" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host { display: inline-flex; align-items: center; gap: var(--space-2, 8px); vertical-align: middle; font-family: var(--font-body); font-size: var(--text-base); color: var(--foreground); -webkit-tap-highlight-color: transparent; --tone: var(--primary); }
  :host([hidden]) { display: none; }
  :host(:not([tone])), :host([tone='default'])     { --tone: var(--primary); }
  :host([tone='primary'])     { --tone: var(--primary); }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); }

  :host(:not([size])), :host([size='md']) { --rd-size: 16px; --rd-dot: 8px; }
  :host([size='sm']) { --rd-size: 14px; --rd-dot: 6px; }
  :host([size='lg']) { --rd-size: 20px; --rd-dot: 10px; }

  label { display: inline-flex; align-items: center; gap: var(--space-2, 8px); cursor: pointer; user-select: none; -webkit-user-select: none; }
  :host([disabled]) label { cursor: not-allowed; }

  .circle { position: relative; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: var(--rd-size); height: var(--rd-size); background: var(--card); border: 1px solid var(--border-strong); border-radius: 50%; box-sizing: border-box; box-shadow: var(--shadow-xs); transition: border-color var(--duration-fast,150ms) var(--ease-out,ease-out), box-shadow var(--duration-fast,150ms) var(--ease-out,ease-out); }
  :host(:not([disabled]):not([checked])) label:hover .circle { border-color: color-mix(in oklch, var(--border-strong) 130%, transparent); box-shadow: var(--shadow-sm); }
  :host([checked]) .circle { border-color: var(--tone); }

  .dot { width: var(--rd-dot); height: var(--rd-dot); border-radius: 50%; background: var(--tone); opacity: 0; transform: scale(0); transition: opacity var(--duration-fast,150ms) var(--ease-out,ease-out), transform var(--duration-fast,150ms) var(--ease-out,ease-out); pointer-events: none; }
  :host([checked]) .dot { opacity: 1; transform: scale(1); }

  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; opacity: 0; cursor: inherit; appearance: none; -webkit-appearance: none; }
  :host(:not([disabled])) label:has(input:focus-visible) .circle { box-shadow: 0 0 0 1px var(--card), 0 0 0 3px color-mix(in oklch, var(--tone) 22%, transparent); }

  @media (forced-colors: active) { .circle { border-color: CanvasText; } :host([checked]) .dot { background: Highlight; } :host(:not([disabled])) label:has(input:focus-visible) .circle { outline: 2px solid CanvasText; outline-offset: 2px; } }
  :host([disabled]) { color: var(--muted-foreground); }
  :host([disabled]) .circle { background: var(--muted); border-color: color-mix(in oklch, var(--border) 80%, transparent); filter: saturate(0.6); box-shadow: none; }
  :host([disabled][checked]) .circle { border-color: color-mix(in oklch, var(--tone) 50%, var(--border)); }
  :host([disabled][checked]) .dot { background: color-mix(in oklch, var(--tone) 55%, var(--muted)); }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
  ::slotted(*) { font: inherit; color: inherit; line-height: var(--leading-tight, 1.25); }
</style>

<label part="label">
  <span class="circle" part="circle">
    <input part="input" type="radio" bind:checked={checked} disabled={disabled()} aria-checked={checked() ? 'true' : 'false'} tabindex={checked() ? '0' : '-1'} bind:this={inputEl} />
    <span class="dot" part="dot" aria-hidden="true"></span>
  </span>
  <slot></slot>
</label>
