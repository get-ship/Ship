<!--
  sui-toggle-group.after.sui — ELEVATED on the locked field language. Same
  template + props; style-only diff:
    • surface --background → --card (consistent raised field surface)
    • idle/hover border → --border-strong; hover surface tuned to a faint
      --foreground wash so unpressed buttons read as interactive
    • pressed: --selected-bg + --selected-border token (matches selection across
      the pack) + 600 weight, instead of a bespoke --primary edge
    • focus ring: token offset/width stack → shared recipe
      (0 0 0 1px --card, 0 0 0 3px color-mix(--primary 22%))
  Static visual, three fixed toggles (no controller). Compiled as
  <x-toggle-group-after>. Props: type · value · size.
-->
<prop name="type" values="single|multiple" default="multiple" reflect />
<prop name="value" type="string" default="" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host { display: inline-flex; gap: 0; font-family: var(--font-body); }
  :host([hidden]) { display: none; }
  .btn {
    appearance: none; border: 1px solid var(--border-strong); background: var(--card);
    color: var(--muted-foreground); cursor: pointer; line-height: 1; margin-left: -1px; font-weight: 500;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .btn:first-child { margin-left: 0; border-radius: var(--radius) 0 0 var(--radius); }
  .btn:last-child { border-radius: 0 var(--radius) var(--radius) 0; }
  :host(:not([size])) .btn, :host([size='md']) .btn { padding: 6px var(--space-3); font-size: var(--text-sm); }
  :host([size='sm']) .btn { padding: 4px var(--space-2); font-size: var(--text-xs); }
  .btn:not(.is-on):hover { background: color-mix(in oklch, var(--foreground) 6%, var(--card)); color: var(--foreground); }
  .btn.is-on { background: var(--selected-bg); border-color: var(--selected-border); color: var(--foreground); font-weight: 600; position: relative; z-index: 1; }
  .btn:focus-visible {
    outline: none; position: relative; z-index: 2;
    box-shadow: 0 0 0 1px var(--card), 0 0 0 3px color-mix(in oklch, var(--primary) 22%, transparent);
  }
</style>

<div class="group" part="container" role="group">
  <button class={value().includes('bold') ? 'btn is-on' : 'btn'} type="button" data-value="bold" aria-pressed={value().includes('bold') ? 'true' : 'false'}>Bold</button>
  <button class={value().includes('italic') ? 'btn is-on' : 'btn'} type="button" data-value="italic" aria-pressed={value().includes('italic') ? 'true' : 'false'}>Italic</button>
  <button class={value().includes('underline') ? 'btn is-on' : 'btn'} type="button" data-value="underline" aria-pressed={value().includes('underline') ? 'true' : 'false'}>Underline</button>
</div>
