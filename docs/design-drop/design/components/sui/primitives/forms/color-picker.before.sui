<!--
  sui-color-picker.before.sui — EXISTING look (repo). A swatch trigger + a grid of
  fixed HEX swatches; the stored value is a hex string (theme-blind — the same
  #d4502a on every theme). Popover shown open inline. Compiled as
  <x-color-picker-before>.
-->
<style>
  :host { display: block; font-family: var(--font-body); width: 240px; }
  .trigger { display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 10px; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13px; color: var(--foreground); }
  .sw { width: 18px; height: 18px; border-radius: 4px; border: 1px solid var(--border); flex: none; }
  .val { margin-left: auto; font-family: var(--font-mono); font-size: 12px; color: var(--muted-foreground); }
  .pop { margin-top: 6px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-md); padding: 10px; }
  .grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
  .chip { width: 26px; height: 26px; border-radius: 5px; border: 1px solid var(--border); cursor: pointer; }
  .chip.sel { outline: 2px solid var(--foreground); outline-offset: 1px; }
</style>
<div class="trigger" part="trigger">
  <span class="sw" style="background:#d4502a"></span><span>Accent</span><span class="val">#d4502a</span>
</div>
<div class="pop" part="popover">
  <div class="grid">
    <span class="chip sel" style="background:#d4502a"></span>
    <span class="chip" style="background:#2a6fdb"></span>
    <span class="chip" style="background:#1f8a5b"></span>
    <span class="chip" style="background:#c9a227"></span>
    <span class="chip" style="background:#8b46c4"></span>
    <span class="chip" style="background:#444444"></span>
  </div>
</div>
