<!--
  sui-date-picker.before.sui — EXISTING look (repo). A field + a month grid. Flat:
  no out-of-month distinction, no today marker, square cells, no typed-entry hint.
  Calendar shown open inline for the comparison. Compiled as <x-date-picker-before>.
  (June 2026, selected 12.)
-->
<style>
  :host { display: block; font-family: var(--font-body); width: 248px; }
  .field { display: flex; align-items: center; height: 34px; padding: 0 12px; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13px; color: var(--foreground); }
  .cal { margin-top: 6px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-md); padding: 10px; }
  .hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 13px; font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .wd { text-align: center; font-size: 11px; color: var(--muted-foreground); padding: 4px 0; }
  .d { text-align: center; font-size: 12px; padding: 6px 0; border-radius: var(--radius-sm); cursor: pointer; color: var(--foreground); }
  .d:hover { background: var(--muted); }
  .d.sel { background: var(--primary); color: var(--primary-foreground); }
</style>
<div class="field" part="field">2026-06-12</div>
<div class="cal" part="calendar">
  <div class="hd"><span>June 2026</span><span style="color:var(--muted-foreground)">‹ ›</span></div>
  <div class="grid">
    <span class="wd">S</span><span class="wd">M</span><span class="wd">T</span><span class="wd">W</span><span class="wd">T</span><span class="wd">F</span><span class="wd">S</span>
    <span class="d out">31</span><span class="d">1</span><span class="d">2</span><span class="d">3</span><span class="d">4</span><span class="d">5</span><span class="d">6</span>
    <span class="d">7</span><span class="d">8</span><span class="d">9</span><span class="d">10</span><span class="d">11</span><span class="d sel">12</span><span class="d">13</span>
    <span class="d">14</span><span class="d">15</span><span class="d">16</span><span class="d">17</span><span class="d today">18</span><span class="d">19</span><span class="d">20</span>
    <span class="d">21</span><span class="d">22</span><span class="d">23</span><span class="d">24</span><span class="d">25</span><span class="d">26</span><span class="d">27</span>
    <span class="d">28</span><span class="d">29</span><span class="d">30</span><span class="d out">1</span><span class="d out">2</span><span class="d out">3</span><span class="d out">4</span>
  </div>
</div>
