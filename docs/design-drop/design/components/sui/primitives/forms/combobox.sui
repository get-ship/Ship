<!--
  <sui-combobox> — filterable single-select. Direction B ("quiet + meta"):
  no leading icon; each option shows its value as a muted mono line; the
  selected row gets a 2px --primary left bar + trailing check. Keyboard/ARIA
  model lives in the paired controller (combobox.controller.ts).

  scope contract (from the controller): refs inputEl/listEl/optionsSlot;
  signals open/filterText/highlight/visibleOptions/activeId/listId; props
  value/options/disabled. Tokens only — no hardcoded color.
-->
<prop name="value" type="string" default="" />
<prop name="options" type="string" default="" />
<prop name="disabled" type="bool" default="false" reflect />

<style>
  :host { display: inline-flex; vertical-align: middle; width: 100%; max-width: 280px; position: relative; }
  :host([hidden]) { display: none; }

  .field {
    display: flex; align-items: center; gap: 8px; width: 100%; min-height: 34px; padding: 0 10px;
    background: var(--card); color: var(--foreground);
    border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-xs);
    font-family: var(--font-body); font-size: var(--text-sm); cursor: text;
    transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  .input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: inherit; font: inherit; padding: 7px 0; }
  .input::placeholder { color: var(--muted-foreground); }
  :host([data-open]) .field {
    border-color: color-mix(in oklch, var(--primary) 55%, var(--border));
    box-shadow: 0 0 0 3px var(--tone-primary-ring);
  }
  .chevron { width: 15px; height: 15px; color: var(--muted-foreground); flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out); }
  :host([data-open]) .chevron { transform: rotate(180deg); }
  :host([disabled]) .field { background: var(--muted); cursor: not-allowed; opacity: .6; }

  .listbox {
    position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 30;
    margin: 0; padding: 4px 0; list-style: none;
    background: var(--popover); color: var(--popover-foreground);
    border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-lg);
    max-height: 280px; overflow: auto;
  }
  .grp { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .07em; text-transform: uppercase;
    color: var(--muted-foreground); padding: 8px 12px 4px; }
  .opt { display: flex; align-items: center; gap: 9px; padding: 6px 12px 6px 0; cursor: pointer; }
  .opt:hover, .opt[data-active='true'] { background: var(--hover-bg); }
  .opt[aria-selected='true'] { background: var(--selected-bg); }
  .bar { width: 2px; align-self: stretch; border-radius: 1px; background: transparent; margin-right: 9px; flex-shrink: 0; }
  .opt[aria-selected='true'] .bar { background: var(--primary); }
  .main { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .main b { font-weight: 600; font-size: var(--text-sm); }
  .id { font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); }
  .chk { color: var(--primary); display: none; flex-shrink: 0; }
  .opt[aria-selected='true'] .chk { display: inline-flex; }
  .chk svg { width: 14px; height: 14px; }
</style>

<div class="field" part="field">
  <input class="input" part="input" type="text" role="combobox" autocomplete="off"
    aria-autocomplete="list"
    aria-expanded={open() ? 'true' : 'false'}
    aria-controls={listId()}
    aria-activedescendant={activeId()}
    disabled={disabled()}
    bind:value={filterText}
    bind:this={inputEl} />
  <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
</div>

{#if open()}
  <ul class="listbox" part="listbox" role="listbox" id={listId()} bind:this={listEl}>
    <li class="grp" role="presentation">Options</li>
    {#for opt of visibleOptions() key={opt.id}}
      <li class="opt" role="option" id={opt.id} data-value={opt.value}
        aria-selected={opt.value === value() ? 'true' : 'false'}
        data-active={opt.idx === highlight() ? 'true' : 'false'}>
        <span class="bar"></span>
        <span class="main"><b>{opt.label}</b><span class="id">{opt.value}</span></span>
        <span class="chk" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
      </li>
    {/for}
  </ul>
{/if}

<span hidden><slot bind:this={optionsSlot}></slot></span>
