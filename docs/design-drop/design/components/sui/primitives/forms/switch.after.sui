<!-- sui-switch.after.sui — ELEVATED. Props + template identical to before; pure <style> diff. Compiled as <x-switch-after>.
  Switch was already strong (track/thumb, tone fill, system disabled). Unification only:
    1. Focus ring → shared recipe (0 0 0 1px --card, 0 0 0 3px color-mix(--tone 22%)) replacing the --ring-offset/--ring-width/--ring-opacity stack, so all controls ring identically.
    2. Off-track border → --border-strong token (was color-mix 140/180%); checked edge → --selected-border token.
    3. Thumb uses --card (not --background) so it reads as a raised chip on every theme.
  Tokens only. -->
<prop name="checked" type="bool" default="false" reflect form-value />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="name" type="string" default="" />
<prop name="value" type="string" default="on" />
<prop name="label" type="string" default="" />

<style>
  :host { display: inline-flex; align-items: center; gap: var(--space-2, 8px); vertical-align: middle; font-family: var(--font-body); font-size: var(--text-base); color: var(--foreground); -webkit-tap-highlight-color: transparent; --tone: var(--primary); --tone-on-fg: var(--primary-foreground); }
  :host([hidden]) { display: none; }
  :host(:not([tone])), :host([tone='default']) { --tone: var(--primary); --tone-on-fg: var(--primary-foreground); }
  :host([tone='info'])        { --tone: var(--info);        --tone-on-fg: var(--info-foreground); }
  :host([tone='success'])     { --tone: var(--success);     --tone-on-fg: var(--success-foreground); }
  :host([tone='warning'])     { --tone: var(--warning);     --tone-on-fg: var(--warning-foreground); }
  :host([tone='destructive']) { --tone: var(--destructive); --tone-on-fg: var(--destructive-foreground); }
  :host([tone='accent'])      { --tone: var(--accent);      --tone-on-fg: var(--accent-foreground); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); --tone-on-fg: var(--background); }
  :host([tone='primary'])     { --tone: var(--primary);     --tone-on-fg: var(--primary-foreground); }

  :host(:not([size])), :host([size='md']) { --sw-w: 28px; --sw-h: 16px; --sw-thumb: 12px; }
  :host([size='sm']) { --sw-w: 24px; --sw-h: 14px; --sw-thumb: 10px; }
  :host([size='lg']) { --sw-w: 32px; --sw-h: 18px; --sw-thumb: 14px; }

  label { display: inline-flex; align-items: center; gap: var(--space-2, 8px); cursor: pointer; user-select: none; -webkit-user-select: none; }
  :host([disabled]) label { cursor: not-allowed; }

  .track { position: relative; display: inline-block; flex-shrink: 0; width: var(--sw-w); height: var(--sw-h); background: var(--muted); border: 1px solid var(--border-strong); border-radius: var(--radius-full, 9999px); box-sizing: border-box; transition: background-color var(--duration-fast,150ms) var(--ease-out,ease-out), border-color var(--duration-fast,150ms) var(--ease-out,ease-out), box-shadow var(--duration-fast,150ms) var(--ease-out,ease-out); }
  :host(:not([disabled]):not([checked])) label:hover .track { background: color-mix(in oklch, var(--muted) 70%, var(--foreground) 6%); border-color: color-mix(in oklch, var(--border-strong) 130%, transparent); }
  :host([checked]) .track { background: var(--tone); border-color: var(--selected-border); box-shadow: inset 0 1px 0 0 color-mix(in oklch, var(--background) 22%, transparent); }
  :host([checked]:not([disabled])) label:hover .track { background: color-mix(in oklch, var(--tone) 92%, var(--background) 8%); box-shadow: inset 0 1px 0 0 color-mix(in oklch, var(--background) 26%, transparent), var(--shadow-xs); }

  .thumb { position: absolute; top: 50%; left: 1px; width: var(--sw-thumb); height: var(--sw-thumb); background: var(--card); border-radius: 50%; box-shadow: var(--shadow-sm); transform: translateY(-50%); transition: left var(--duration-fast,150ms) var(--ease-out,ease-out), background-color var(--duration-fast,150ms) var(--ease-out,ease-out), box-shadow var(--duration-fast,150ms) var(--ease-out,ease-out); pointer-events: none; }
  :host([checked]) .thumb { left: calc(100% - var(--sw-thumb) - 3px); background: var(--tone-on-fg); }

  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; opacity: 0; cursor: inherit; appearance: none; -webkit-appearance: none; }
  :host(:not([disabled])) label:has(input:focus-visible) .track { box-shadow: 0 0 0 1px var(--card), 0 0 0 3px color-mix(in oklch, var(--tone) 22%, transparent); }
  :host([checked]:not([disabled])) label:has(input:focus-visible) .track { box-shadow: inset 0 1px 0 0 color-mix(in oklch, var(--background) 22%, transparent), 0 0 0 1px var(--card), 0 0 0 3px color-mix(in oklch, var(--tone) 22%, transparent); }

  @media (forced-colors: active) { :host(:not([disabled])) label:has(input:focus-visible) .track { outline: 2px solid CanvasText; outline-offset: 2px; } .track { border-color: CanvasText; } :host([checked]) .track { background: Highlight; } }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }

  :host([disabled]) { color: var(--muted-foreground); }
  :host([disabled]) .track { background: var(--muted); border-color: color-mix(in oklch, var(--border) 80%, transparent); filter: saturate(0.6); box-shadow: none; }
  :host([disabled][checked]) .track { background: color-mix(in oklch, var(--tone) 55%, var(--muted)); border-color: color-mix(in oklch, var(--tone) 40%, var(--border)); }
  :host([disabled]) .thumb { box-shadow: var(--shadow-xs); }
  ::slotted(*) { font: inherit; color: inherit; line-height: var(--leading-tight, 1.25); }
</style>

<label>
  <span class="track" part="track">
    <input part="input" type="checkbox" role="switch" bind:checked={checked} disabled={disabled()} name={name()} value={value()}
      aria-checked={checked() ? 'true' : 'false'} aria-label={label() || name() || 'toggle'} bind:this={inputEl} />
    <span class="thumb" part="thumb"></span>
  </span>
  <slot></slot>
</label>
