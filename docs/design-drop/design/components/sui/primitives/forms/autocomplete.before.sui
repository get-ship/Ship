<!--
  sui-autocomplete.before.sui — EXISTING look (repo). Free-text field + a plain
  suggestion list. Diverges from combobox/select: --background field surface, no
  active-option highlight, and the pending/empty states are ad-hoc (empty shows
  an empty box; pending shows a bare spinner). Open popover rendered inline for
  the comparison. Compiled as <x-autocomplete-before>. Props: state.
-->
<prop name="state" values="results|empty|pending" default="results" reflect />
<style>
  :host { display: block; font-family: var(--font-body); width: 280px; }
  .field { display: flex; align-items: center; height: 34px; padding: 0 12px; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 13px; color: var(--foreground); }
  .field .ph { color: var(--foreground); }
  .field .car { width: 1px; height: 15px; background: var(--foreground); margin-left: 1px; }
  .pop { margin-top: 4px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-md); overflow: hidden; min-height: 36px; }
  .row { padding: 8px 12px; font-size: 13px; color: var(--foreground); cursor: pointer; }
  .row:hover { background: var(--muted); }
  .list { display: block; }
  .empty, .pending { display: none; padding: 10px 12px; font-size: 13px; color: var(--muted-foreground); }
  .spin { width: 14px; height: 14px; border: 2px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: ac-spin .7s linear infinite; }
  @keyframes ac-spin { to { transform: rotate(360deg); } }
  :host([state='empty']) .list { display: none; }
  :host([state='empty']) .empty { display: block; }
  :host([state='pending']) .list { display: none; }
  :host([state='pending']) .pending { display: block; }
</style>
<div class="field" part="field"><span class="ph">rei</span><span class="car"></span></div>
<div class="pop" part="popover" role="listbox">
  <div class="list">
    <div class="row">Reindex</div>
    <div class="row">Rebalance shards</div>
    <div class="row">Retry failed</div>
  </div>
  <div class="empty"></div>
  <div class="pending"><span class="spin"></span></div>
</div>
