<!--
  sui-autocomplete.after.sui — ENHANCED + ALIGNED. Brought onto the combobox/
  select language so the forms pack reads as one system (the review's "align the
  pending/empty patterns" ask): locked field surface (--card) with a leading
  search glyph + the elevated focus look, an active-option highlight
  (--selected-bg + aria-selected) with a leading check on the chosen row, and
  ONE pending pattern (spinner + "Searching…") and ONE empty pattern ("No matches
  …" with a hint) — the same rows combobox uses. Open popover rendered inline.
  Token-pure. Compiled as <x-autocomplete-after>. Props: state.
-->
<prop name="state" values="results|empty|pending" default="results" reflect />
<style>
  :host { display: block; font-family: var(--font-body); width: 280px; }
  .field { display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-xs); font-size: 13px; color: var(--foreground); outline: none; }
  .field { border-color: color-mix(in oklch, var(--primary) 60%, var(--border)); box-shadow: 0 0 0 1px var(--card), 0 0 0 3px color-mix(in oklch, var(--primary) 22%, transparent); }
  .sicon { width: 15px; height: 15px; color: var(--muted-foreground); flex: none; }
  .car { width: 1px; height: 15px; background: var(--primary); margin-left: 1px; }
  .pop { margin-top: 6px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-md); overflow: hidden; padding: 4px; }
  .row { display: flex; align-items: center; gap: 8px; padding: 7px 9px; font-size: 13px; color: var(--foreground); cursor: pointer; border-radius: var(--radius-sm); }
  .row:hover { background: var(--hover-bg); }
  .row.active { background: var(--selected-bg); }
  .row .ck { margin-left: auto; width: 15px; height: 15px; color: var(--primary); opacity: 0; }
  .row.active .ck { opacity: 1; }
  .list { display: block; }
  .state-row { display: none; align-items: center; gap: 8px; padding: 9px; font-size: 13px; color: var(--muted-foreground); }
  .state-row .hint { margin-left: auto; font-family: var(--font-mono); font-size: 11px; opacity: .8; }
  .spin { width: 14px; height: 14px; flex: none; border: 2px solid var(--border); border-top-color: var(--primary); border-radius: 50%; }
  @media (prefers-reduced-motion: no-preference) { .spin { animation: ac-spin .7s linear infinite; } }
  @keyframes ac-spin { to { transform: rotate(360deg); } }
  :host([state='empty']) .list, :host([state='pending']) .list { display: none; }
  :host([state='empty']) .empty { display: flex; }
  :host([state='pending']) .pending { display: flex; }
</style>
<div class="field" part="field" tabindex="0">
  <svg class="sicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
  <span>rei</span><span class="car"></span>
</div>
<div class="pop" part="popover" role="listbox">
  <div class="list">
    <div class="row active" aria-selected="true">Reindex<svg class="ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div>
    <div class="row">Rebalance shards<span class="ck"></span></div>
    <div class="row">Retry failed<span class="ck"></span></div>
  </div>
  <div class="state-row empty">No matches for “rei”<span class="hint">Esc to dismiss</span></div>
  <div class="state-row pending"><span class="spin"></span>Searching…</div>
</div>
