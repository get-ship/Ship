<!--
  sui-textarea.after.sui — ELEVATED. Props + template identical to
  textarea.before.sui; pure <style> diff. Compiled live as <x-textarea-after>.
  Unifies textarea to the section's field language (the one sui-input now sets):
    1. Surface --background → --card (matches input/select).
    2. Focus ring → the shared recipe: 0 0 0 1px --card, 0 0 0 3px
       color-mix(--tone 22%) — replaces the --ring-width/--ring-opacity stack so
       all forms controls ring identically.
    3. Disabled → system pattern (muted bg + softened border + saturate(.6)),
       dropping the blunt opacity:.6.
    4. Hover border uses --border-strong token (was a 160% color-mix).
  Tokens only.
-->
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="name" type="string" default="" />
<prop name="rows" type="number" default="4" />
<prop name="required" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="invalid" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="default|code" default="default" reflect />
<prop name="size" values="sm|md" default="md" reflect />
<prop name="resize" values="none|vertical|horizontal|both" default="vertical" />
<prop name="label" type="string" default="" />
<prop name="described-by" type="string" default="" />

<style>
  :host { display: block; width: 100%; --tone: var(--primary); --tone-fg: var(--foreground); }
  :host([hidden]) { display: none; }
  :host(:not([tone])), :host([tone='default']) { --tone: var(--primary); --tone-fg: var(--foreground); }
  :host([tone='primary'])     { --tone: var(--primary);          --tone-fg: var(--primary); }
  :host([tone='info'])        { --tone: var(--info);             --tone-fg: var(--info); }
  :host([tone='success'])     { --tone: var(--success);          --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning);          --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive);      --tone-fg: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent);           --tone-fg: var(--accent); }
  :host([tone='muted'])       { --tone: var(--muted-foreground); --tone-fg: var(--muted-foreground); }

  :host(:not([size])), :host([size='md']) { --ta-px: 12px; --ta-py: 10px; --ta-fs: var(--text-base, 14px); --ta-lh: 1.5; --ta-radius: var(--radius-md, 6px); }
  :host([size='sm']) { --ta-px: 10px; --ta-py: 8px; --ta-fs: var(--text-sm, 13px); --ta-lh: 1.45; --ta-radius: var(--radius-sm, 4px); }

  textarea {
    display: block; width: 100%; box-sizing: border-box;
    border: 1px solid var(--border); border-radius: var(--ta-radius);
    padding: var(--ta-py) var(--ta-px);
    background: var(--card); color: var(--foreground);
    font-family: var(--font-body); font-size: var(--ta-fs); line-height: var(--ta-lh); letter-spacing: -0.005em;
    box-shadow: var(--shadow-xs);
    transition: background-color var(--duration-fast,150ms) var(--ease-out,ease-out), border-color var(--duration-fast,150ms) var(--ease-out,ease-out), box-shadow var(--duration-fast,150ms) var(--ease-out,ease-out);
  }
  :host(:not([disabled])) textarea:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
  textarea:focus-visible, textarea:focus {
    outline: none; border-color: var(--tone);
    box-shadow: 0 0 0 1px var(--card), 0 0 0 3px color-mix(in oklch, var(--tone) 22%, transparent);
  }
  :host([invalid]) textarea { border-color: color-mix(in oklch, var(--destructive) 65%, var(--border)); }
  :host([invalid]) textarea:hover { border-color: color-mix(in oklch, var(--destructive) 80%, var(--border)); }
  :host([invalid]) textarea:focus-visible, :host([invalid]) textarea:focus {
    border-color: var(--destructive);
    box-shadow: 0 0 0 1px var(--card), 0 0 0 3px color-mix(in oklch, var(--destructive) 22%, transparent);
  }
  textarea::placeholder { color: var(--muted-foreground); opacity: 1; }
  textarea:disabled { cursor: not-allowed; background: var(--muted); border-color: color-mix(in oklch, var(--border) 80%, transparent); color: var(--muted-foreground); box-shadow: none; filter: saturate(0.6); }
  textarea:read-only { cursor: default; }
  :host([variant='code']) textarea { font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--text-base, 14px); line-height: 1.55; letter-spacing: 0; tab-size: 2; }
  @media (forced-colors: active) { textarea:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; } }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>

<textarea
  part="textarea"
  placeholder={placeholder()}
  name={name()}
  rows={rows()}
  disabled={disabled()}
  required={required()}
  readonly={readonly()}
  aria-invalid={invalid() ? 'true' : 'false'}
  aria-required={required() ? 'true' : 'false'}
  aria-label={label()}
  aria-describedby={describedBy()}
  style:resize={resize()}
  bind:value={value}
  bind:this={textareaEl}
></textarea>
