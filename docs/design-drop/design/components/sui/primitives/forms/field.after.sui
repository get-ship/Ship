<!--
  sui-field.after.sui — ELEVATED structure on the same slot contract. Diffs:
    • rhythm: a tighter label→control gap (5px) and a touch more breathing room
      above the hint/error row (margin-top) so the message reads as a distinct
      tier, not crowding the control
    • error gains a leading alert glyph on the --destructive tone (instant
      scan of a failed field) instead of a bare red line
    • hint/error line-height + size nudged for legibility (11.5px / 1.45)
  Same template structure + the invalid swap. Compiled as <x-field-after>.
  Prop: invalid. Slots: label · (default) · hint · error.
-->
<prop name="invalid" type="bool" default="false" reflect />

<style>
  :host { display: flex; flex-direction: column; gap: 5px; }
  :host([hidden]) { display: none; }
  .msg { margin-top: 1px; }
  .hint, .error { font-family: var(--font-body); font-size: 11.5px; line-height: 1.45; }
  .hint { color: var(--muted-foreground); }
  .error { display: flex; align-items: flex-start; gap: 5px; color: var(--destructive); font-weight: 500; }
  .error svg { width: 13px; height: 13px; flex-shrink: 0; margin-top: 0.5px; }
  :host(:not([invalid])) .error { display: none; }
  :host([invalid]) .hint { display: none; }
</style>

<slot name="label"></slot>
<slot></slot>
<div class="hint msg"><slot name="hint"></slot></div>
<div class="error msg" role="alert" aria-live="polite">
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>
  <span><slot name="error"></slot></span>
</div>
