<!--
  sui-input.after.sui — ELEVATED proposal. Props + template are IDENTICAL to
  input.before.sui on purpose, so the handoff diff is a pure <style> change.
  Compiled live under tag <x-input-after>. Itemized changes vs before:
    1. Rest shadow var(--shadow-xs) on .wrap — matches sui-select/sui-combobox
       fields (input was the only field with no resting elevation).
    2. NEW hover state — border → --border-strong + --shadow-sm (before had no
       hover affordance at all).
    3. Focus ring aligned to the field language used by select/combobox:
       border → --tone-ring, ring → 3px color-mix(--tone-ring 22%) over a
       1px background gap; opacity matches the --tone-*-ring tokens.
    4. Disabled cleaned to the system pattern (muted bg, softened border,
       no shadow, saturate(.6)) instead of a blunt opacity:.65.
    5. Ghost variant gains a hover surface so it's discoverable before focus.
    6. Leading/trailing icons sized to a --icon channel for rhythm.
  Tokens only — no hex.
-->
<prop name="type" values="text|search|email|url|tel|password|number" default="text" reflect />
<prop name="value" type="string" default="" form-value />
<prop name="placeholder" type="string" default="" />
<prop name="name" type="string" default="" />
<prop name="autocomplete" type="string" default="" />
<prop name="required" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect form-disabled />
<prop name="readonly" type="bool" default="false" reflect />
<prop name="invalid" type="bool" default="false" reflect />
<prop name="loading" type="bool" default="false" reflect />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent|muted" default="default" reflect />
<prop name="variant" values="default|ghost" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="label" type="string" default="" />
<prop name="described-by" type="string" default="" />
<prop name="error-message" type="string" default="" />

<style>
  :host {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    vertical-align: middle;
    width: 100%;
    --tone-border: var(--border);
    --tone-ring: var(--primary);
    --h: 34px;
    --fs: 13px;
    --px: 11px;
    --icon: 15px;
  }

  :host([tone='primary'])     { --tone-border: var(--primary);     --tone-ring: var(--primary); }
  :host([tone='info'])        { --tone-border: var(--info);         --tone-ring: var(--info); }
  :host([tone='success'])     { --tone-border: var(--success);      --tone-ring: var(--success); }
  :host([tone='warning'])     { --tone-border: var(--warning);      --tone-ring: var(--warning); }
  :host([tone='destructive']),
  :host([invalid])            { --tone-border: var(--destructive);  --tone-ring: var(--destructive); }
  :host([tone='accent'])      { --tone-border: var(--accent);       --tone-ring: var(--accent); }
  :host([tone='muted'])       { --tone-border: var(--muted-foreground); --tone-ring: var(--muted-foreground); }

  :host([size='sm']) { --h: 28px; --fs: 12px; --px: 9px;  --icon: 13px; }
  :host([size='md']) { --h: 34px; --fs: 13px; --px: 11px; --icon: 15px; }
  :host([size='lg']) { --h: 40px; --fs: 14px; --px: 13px; --icon: 17px; }

  .wrap {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    min-height: var(--h);
    padding: 0 var(--px);
    background: var(--card);
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);                 /* (1) rest elevation, matches select/combobox */
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  :host([variant='ghost']) .wrap {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  /* (2) NEW hover — only when not focused / disabled */
  :host(:not([disabled])) .wrap:hover:not(:focus-within) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  :host([variant='ghost']:not([disabled])) .wrap:hover:not(:focus-within) {
    background: color-mix(in oklch, var(--muted) 60%, transparent);
    border-color: transparent;
    box-shadow: none;
  }

  /* (3) focus ring — field language shared with select/combobox */
  .wrap:focus-within {
    border-color: var(--tone-ring);
    box-shadow:
      0 0 0 1px var(--card),
      0 0 0 3px color-mix(in oklch, var(--tone-ring) 22%, transparent);
  }

  /* (4) disabled — system pattern, not blunt opacity */
  :host([disabled]) .wrap {
    background: var(--muted);
    border-color: color-mix(in oklch, var(--border) 80%, transparent);
    box-shadow: none;
    cursor: not-allowed;
    filter: saturate(0.6);
  }
  :host([disabled]) input { color: var(--muted-foreground); }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    font-family: var(--font-body);
    font-size: var(--fs);
    color: var(--foreground);
  }
  input::placeholder { color: var(--muted-foreground); }
  input:disabled { cursor: not-allowed; }

  input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  @media (forced-colors: active) {
    input:focus-visible { outline: 2px solid CanvasText; outline-offset: 2px; }
  }

  /* (6) icon rhythm */
  ::slotted([slot='leading']),
  ::slotted([slot='trailing']) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--icon);
    height: var(--icon);
    color: var(--muted-foreground);
  }

  .spinner {
    display: inline-block;
    flex: 0 0 auto;
    width: var(--icon);
    height: var(--icon);
    border: 2px solid color-mix(in oklch, var(--tone-ring) 30%, transparent);
    border-top-color: var(--tone-ring);
    border-radius: 50%;
    animation: sui-spin 0.6s linear infinite;
  }

  @keyframes sui-spin {
    to { transform: rotate(360deg); }
  }

  .error {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--destructive);
    line-height: 1.4;
  }
</style>

<div class="wrap" part="wrap">
  <slot name="leading" reflect-empty="data-no-leading"></slot>
  <input
    part="input"
    type={type()}
    placeholder={placeholder()}
    name={name()}
    autocomplete={autocomplete() || 'off'}
    disabled={disabled()}
    readonly={readonly()}
    required={required()}
    aria-label={label()}
    aria-invalid={invalid() ? 'true' : 'false'}
    aria-required={required() ? 'true' : 'false'}
    aria-busy={loading() ? 'true' : 'false'}
    bind:value={value}
    bind:this={inputEl}
  />
  {#if loading()}
    <span class="spinner" aria-hidden="true"></span>
  {:else}
    <slot name="trailing" reflect-empty="data-no-trailing"></slot>
  {/if}
</div>
{#if invalid() && errorMessage()}
  <span class="error" role="alert" bind:this={errorEl}>{errorMessage()}</span>
{/if}
