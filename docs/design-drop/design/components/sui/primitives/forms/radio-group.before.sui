<!--
  sui-radio-group.before.sui — EXISTING look (repo). A fieldset grouping native
  radios under a legend; plain stacked options. Interactive (native radios).
  Compiled as <x-radio-group-before>.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  fieldset { border: 0; margin: 0; padding: 0; }
  legend { font-size: var(--text-sm); color: var(--foreground); margin-bottom: 8px; padding: 0; }
  .opt { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: var(--text-md); color: var(--foreground); cursor: pointer; }
  input { width: 16px; height: 16px; accent-color: var(--primary); }
</style>
<fieldset part="group" role="radiogroup">
  <legend>Shipping tier</legend>
  <label class="opt"><input type="radio" name="rg-before" checked />Standard</label>
  <label class="opt"><input type="radio" name="rg-before" />Priority</label>
  <label class="opt"><input type="radio" name="rg-before" />Dedicated</label>
</fieldset>
