<!--
  sui-popover.after.sui — ELEVATED surface. Same static render; diffs:
    • deeper, softer lift (--shadow-lg) so the panel clearly floats above content
    • a hairline top highlight (inset) + slightly larger radius for a refined edge
    • roomier internal padding rhythm (8px) so packed content doesn't feel cramped
  Compiled as <x-popover-after>. Slots: trigger · (default) panel body.
-->
<prop name="open" type="bool" default="true" reflect />

<style>
  :host { position: relative; display: inline-flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  :host([hidden]) { display: none; }
  .surface {
    min-width: 200px; padding: 8px;
    background: var(--popover, var(--card)); color: var(--popover-foreground, var(--card-foreground));
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg), inset 0 1px 0 color-mix(in oklch, var(--background) 40%, transparent);
    font-family: var(--font-body); font-size: var(--text-base);
  }
</style>

<slot name="trigger"></slot>
<div class="surface" part="surface" role="dialog"><slot></slot></div>
