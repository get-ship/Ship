<!--
  sui-hover-card.after.sui — ELEVATED. Same static render; the panel gains a deeper
  softer lift + a hairline top highlight so the rich card clearly floats, a slightly
  larger radius, and roomier internal rhythm. Compiled as <x-hovercard-after>.
  Slots: trigger · (default) card body.
-->
<prop name="open" type="bool" default="true" reflect />
<prop name="placement" values="top|bottom|left|right" default="bottom" reflect />

<style>
  :host { display: inline-flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  :host([hidden]) { display: none; }
  .panel { min-width: 240px; max-width: 340px; padding: 16px; background: var(--popover, var(--card)); color: var(--popover-foreground, var(--card-foreground)); border: 1px solid var(--border); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg), inset 0 1px 0 color-mix(in oklch, var(--background) 40%, transparent); font-family: var(--font-body); font-size: var(--text-base); line-height: var(--leading-normal, 1.55); }
</style>

<slot name="trigger"></slot>
<div class="panel" part="panel"><slot></slot></div>
