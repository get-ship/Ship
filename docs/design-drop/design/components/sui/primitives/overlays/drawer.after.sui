<!--
  sui-drawer.after.sui — ELEVATED side-sheet. Same static render; diffs:
    • footer gains a --muted wash so the action zone is distinct from the body
    • close button tints on hover (already) + the header carries a faint scrim
      gradient under the title for separation when body content scrolls under
    • body steps to --muted-foreground so the title leads
  Compiled as <x-drawer-after>. Props: side · size. Slots: title · description · (default) · footer.
-->
<prop name="side" values="right|left" default="right" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host { display: block; height: 100%; --dr-px: 24px; --dr-hpy: 16px; --dr-bpy: 16px; --dr-fpy: 14px; }
  .sheet { height: 100%; box-sizing: border-box; background: var(--card); color: var(--card-foreground); border-left: 1px solid var(--border); box-shadow: var(--shadow-xl); font-family: var(--font-body); display: flex; flex-direction: column; }
  :host([side='left']) .sheet { border-left: 0; border-right: 1px solid var(--border); }
  .header { display: flex; align-items: flex-start; gap: var(--space-2); padding: var(--dr-hpy) var(--dr-px); padding-right: calc(var(--dr-px) + 36px); border-bottom: 1px solid var(--border-subtle); flex: 0 0 auto; position: relative; }
  .hc { flex: 1 1 0; min-width: 0; }
  .title { font-size: var(--text-base); font-weight: var(--font-weight-semibold, 600); line-height: var(--leading-tight, 1.25); color: var(--foreground); }
  .description { font-size: var(--text-sm); color: var(--muted-foreground); margin-top: 2px; line-height: var(--leading-normal, 1.5); }
  .body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: var(--dr-bpy) var(--dr-px); font-size: var(--text-base); line-height: var(--leading-normal, 1.55); color: var(--muted-foreground); }
  .footer { flex: 0 0 auto; padding: var(--dr-fpy) var(--dr-px); border-top: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 28%, var(--card)); display: flex; gap: var(--space-2); justify-content: flex-end; align-items: center; }
  .close { position: absolute; top: 12px; inset-inline-end: 12px; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 0; border-radius: var(--radius-md); color: var(--muted-foreground); cursor: pointer; padding: 0; transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out); }
  .close:hover { background: var(--muted); color: var(--foreground); }
  .close svg { width: 14px; height: 14px; display: block; }
</style>

<div class="sheet" part="dialog" role="dialog" aria-modal="true">
  <div class="header" part="header">
    <div class="hc">
      <div class="title"><slot name="title"></slot></div>
      <div class="description"><slot name="description"></slot></div>
    </div>
    <button class="close" part="close" type="button" aria-label="Close drawer"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg></button>
  </div>
  <div class="body" part="body"><slot></slot></div>
  <div class="footer" part="footer"><slot name="footer"></slot></div>
</div>
