<!--
  sui-popover.before.sui — EXISTING look (repo surface styling), rendered STATIC:
  the native popover="auto" + anchor-positioning + portal are stripped; the panel
  surface renders inline below the trigger so the open-state chrome can be compared.
  Compiled as <x-popover-before>. Slots: trigger · (default) panel body.
-->
<prop name="open" type="bool" default="true" reflect />

<style>
  :host { position: relative; display: inline-flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  :host([hidden]) { display: none; }
  .surface {
    min-width: 200px; padding: 6px;
    background: var(--popover, var(--card)); color: var(--popover-foreground, var(--card-foreground));
    border: 1px solid var(--border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-md); font-family: var(--font-body); font-size: var(--text-base);
  }
</style>

<slot name="trigger"></slot>
<div class="surface" part="surface" role="dialog"><slot></slot></div>
