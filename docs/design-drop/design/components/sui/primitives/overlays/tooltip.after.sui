<!--
  sui-tooltip.after.sui — ELEVATED. Same contract; the bare bubble gains a small
  caret pointing at the trigger (so the association is unambiguous when several
  tips share a row), a touch more padding, and a softer radius + shadow. Static
  (bubble forced visible). Compiled as <x-tooltip-after>.
  Props: placement. Slots: (default) trigger · content.
-->
<prop name="placement" values="top|bottom|left|right" default="top" reflect />

<style>
  :host { position: relative; display: inline-flex; }
  :host([hidden]) { display: none; }
  .bubble {
    position: absolute; z-index: var(--z-popover, 50); padding: 5px 9px;
    background: var(--foreground); color: var(--background);
    font-family: var(--font-body); font-size: 11px; font-weight: var(--font-weight-medium, 500);
    border-radius: var(--radius-md); white-space: nowrap; pointer-events: none;
    opacity: 1; box-shadow: var(--shadow-md);
  }
  .bubble::after { content: ''; position: absolute; width: 7px; height: 7px; background: var(--foreground); transform: rotate(45deg); }
  :host(:not([placement])) .bubble, :host([placement='top']) .bubble { bottom: calc(100% + 7px); left: 50%; transform: translateX(-50%); }
  :host(:not([placement])) .bubble::after, :host([placement='top']) .bubble::after { bottom: -3px; left: 50%; margin-left: -3.5px; }
  :host([placement='bottom']) .bubble { top: calc(100% + 7px); left: 50%; transform: translateX(-50%); }
  :host([placement='bottom']) .bubble::after { top: -3px; left: 50%; margin-left: -3.5px; }
  :host([placement='left']) .bubble { right: calc(100% + 7px); top: 50%; transform: translateY(-50%); }
  :host([placement='left']) .bubble::after { right: -3px; top: 50%; margin-top: -3.5px; }
  :host([placement='right']) .bubble { left: calc(100% + 7px); top: 50%; transform: translateY(-50%); }
  :host([placement='right']) .bubble::after { left: -3px; top: 50%; margin-top: -3.5px; }
</style>

<slot></slot>
<span class="bubble" role="tooltip" part="bubble"><slot name="content"></slot></span>
