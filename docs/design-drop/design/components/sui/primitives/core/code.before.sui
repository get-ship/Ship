<!--
  sui-code.before.sui — EXISTING look (repo). Inline code chip + a block variant
  (block=true wraps a <pre>). Flat muted fill, no header. Compiled as <x-code-before>.
  Props: block · lang (label only, unused in chrome).
-->
<prop name="block" type="bool" default="false" reflect />
<prop name="lang" type="string" default="" />
<style>
  :host { font-family: var(--font-mono); font-size: var(--text-sm); }
  code { display: inline; padding: 1px 5px; background: var(--muted); color: var(--foreground); border-radius: var(--radius-sm); white-space: pre-wrap; }
  :host([block]) { display: block; }
  :host([block]) code { display: block; padding: var(--space-3) var(--space-4); line-height: 1.6; overflow-x: auto; white-space: pre; border-radius: var(--radius-md); }
</style>
<code part="code"><slot></slot></code>
