<!--
  sui-file-upload.before.sui — EXISTING look (repo). A dropzone: dashed box +
  "Choose file"; once a file is picked (state='filled') it shows a plain row.
  Compiled as <x-file-upload-before>. Props: state (idle|dragover|filled).
-->
<prop name="state" values="idle|dragover|filled" default="idle" reflect />
<style>
  :host { display: block; font-family: var(--font-body); }
  .zone { display: block; border: 1px dashed var(--border); border-radius: var(--radius-md); padding: var(--space-6) var(--space-5); text-align: center; }
  .zone p { margin: 0 0 10px; color: var(--muted-foreground); font-size: var(--text-sm); }
  .zone button { height: 30px; padding: 0 14px; border: 1px solid var(--border); background: var(--card); color: var(--foreground); border-radius: var(--radius-sm); font: inherit; font-size: var(--text-sm); cursor: pointer; }
  .file { display: none; align-items: center; gap: 10px; padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-md); font-size: var(--text-sm); }
  .x { margin-left: auto; cursor: pointer; color: var(--muted-foreground); border: 0; background: none; font-size: 16px; line-height: 1; }
  :host([state='filled']) .zone { display: none; }
  :host([state='filled']) .file { display: flex; }
</style>
<div class="zone" part="dropzone"><p>Drop a file here</p><button type="button">Choose file</button></div>
<div class="file" part="file"><span>logs-2026.csv</span><span style="color:var(--muted-foreground)">2.4 MB</span><button class="x" type="button" aria-label="Remove">×</button></div>
