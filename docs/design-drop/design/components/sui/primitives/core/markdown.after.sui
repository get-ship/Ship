<!--
  sui-markdown.after.sui — ENHANCED. A real prose type-system off ship tokens: a
  measured column, a heading ramp with rhythmic top/bottom margins (first/last
  collapse), 1.7 reading line-height, marker-tinted lists, inline code as the
  bordered card/muted chip (matching sui-code), a blockquote with a --primary
  rail + soft wash, and a data-grid-styled table (--muted header, --border-subtle
  rules, tabular numerals). Same content as before. Compiled as <x-markdown-after>.
-->
<style>
  :host { display: block; font-family: var(--font-body); color: var(--foreground); font-size: var(--text-md); }
  .md { line-height: 1.7; max-width: 68ch; }
  .md > :first-child { margin-top: 0; }
  .md > :last-child { margin-bottom: 0; }
  .md h2 { font-family: var(--heading-font); font-weight: var(--heading-weight); letter-spacing: var(--heading-tracking); font-size: var(--text-2xl); line-height: 1.25; margin: var(--space-6) 0 var(--space-3); }
  .md h3 { font-family: var(--heading-font); font-weight: var(--font-weight-semibold); font-size: var(--text-lg); margin: var(--space-5) 0 var(--space-2); }
  .md p { margin: var(--space-3) 0; }
  .md strong { font-weight: var(--font-weight-semibold); }
  .md a { color: var(--primary); text-decoration: underline; text-decoration-color: color-mix(in oklch, var(--primary) 30%, transparent); text-underline-offset: 2px; }
  .md a:hover { text-decoration-color: var(--primary); }
  .md ol, .md ul { margin: var(--space-3) 0; padding-left: var(--space-5); }
  .md li { margin: var(--space-1) 0; }
  .md li::marker { color: var(--muted-foreground); }
  .md code { font-family: var(--font-mono); font-size: var(--text-sm); font-variant-numeric: tabular-nums; background: color-mix(in oklch, var(--card) 70%, var(--muted)); border: 1px solid var(--border-subtle); padding: 1px 5px; border-radius: var(--radius-sm); }
  .md blockquote { margin: var(--space-4) 0; padding: var(--space-2) var(--space-4); color: var(--muted-foreground); border-left: 3px solid var(--primary); background: color-mix(in oklch, var(--primary) 6%, transparent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .md table { border-collapse: collapse; width: 100%; margin: var(--space-3) 0; font-size: var(--text-sm); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; }
  .md thead th { background: var(--muted); color: var(--foreground); font-weight: var(--font-weight-semibold); }
  .md th, .md td { border-bottom: 1px solid var(--border-subtle); padding: var(--space-2) var(--space-3); text-align: left; font-variant-numeric: tabular-nums; }
  .md tbody tr:last-child td { border-bottom: 0; }
</style>
<div class="md" part="prose">
  <h2>Reindex runbook</h2>
  <p>Run a <strong>dry-run</strong> first. The reindex is idempotent per shard, so it's safe to retry. See <a href="#">the design doc</a> for the rollback path.</p>
  <h3>Steps</h3>
  <ol>
    <li>Pause the write queue.</li>
    <li>Trigger <code>ship reindex --dry-run</code>.</li>
    <li>Confirm the diff, then drop <code>--dry-run</code>.</li>
  </ol>
  <blockquote>Heads up: holding the queue past 5 minutes pages the on-call.</blockquote>
  <h3>Budgets</h3>
  <table>
    <thead><tr><th>Metric</th><th>Target</th></tr></thead>
    <tbody>
      <tr><td>p99 latency</td><td>240 ms</td></tr>
      <tr><td>Error rate</td><td>0.1%</td></tr>
    </tbody>
  </table>
</div>
