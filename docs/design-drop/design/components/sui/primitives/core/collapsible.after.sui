<!--
  sui-collapsible.after.sui — POLISH. Same native <details> mechanics, elevated
  chrome: the summary row gets a hover wash + a real focus-visible ring (was a
  bare browser outline), the caret is a drawn chevron that rotates smoothly, and
  the open body indents under the caret with token rhythm + a faint connecting
  rail so a long disclosure reads as "owned" by its header. Token-pure.
  Compiled as <x-collapsible-after>. Props: open. Slots: summary · (default).
-->
<prop name="open" type="bool" default="false" reflect />
<style>
  :host { display: block; font-family: var(--font-body); }
  details { border-top: 1px solid var(--border-subtle); }
  summary { display: flex; align-items: center; gap: 10px; padding: var(--space-3) var(--space-2); margin: 0 calc(-1 * var(--space-2)); border-radius: var(--radius-sm); cursor: pointer; list-style: none; color: var(--foreground); font-size: var(--text-sm); font-weight: var(--font-weight-semibold, 600); transition: background var(--duration-fast); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--hover-bg); }
  summary:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--card), 0 0 0 4px color-mix(in oklch, var(--primary) 35%, transparent); }
  .chev { width: 14px; height: 14px; flex: none; color: var(--muted-foreground); transition: transform var(--duration-medium) var(--ease-out); }
  details[open] .chev { transform: rotate(90deg); color: var(--foreground); }
  .body { margin-left: 7px; padding: 2px 0 var(--space-4) var(--space-4); border-left: 1px solid var(--border-subtle); color: var(--muted-foreground); font-size: var(--text-sm); line-height: 1.65; }
</style>
<details part="root" open={open() ? 'open' : null}>
  <summary part="summary">
    <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    <slot name="summary">Details</slot>
  </summary>
  <div class="body" part="body"><slot></slot></div>
</details>
