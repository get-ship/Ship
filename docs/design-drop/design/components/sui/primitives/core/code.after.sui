<!--
  sui-code.after.sui — ENHANCED. Inline gets a hairline border + a card/muted
  face (reads crisply on console/contrast where a flat --muted fill washes out)
  and tabular numerals. Block becomes a framed surface with a header bar
  (language label + a slotted action, e.g. a copy-button) over a --border-subtle
  frame. Token-pure. Compiled as <x-code-after>.
  Props: block · lang. Slots: (default) inline/pre body · actions (block header).
-->
<prop name="block" type="bool" default="false" reflect />
<prop name="lang" type="string" default="" reflect />
<style>
  :host { font-family: var(--font-mono); font-size: var(--text-sm); }
  /* inline (default) */
  code { display: inline; padding: 1px 5px; font-variant-numeric: tabular-nums; color: var(--foreground); background: color-mix(in oklch, var(--card) 70%, var(--muted)); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); white-space: pre-wrap; }
  /* block */
  .frame { display: none; }
  :host([block]) { display: block; }
  :host([block]) > code { display: none; }
  :host([block]) .frame { display: block; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 60%, var(--card)); }
  .lang { font-size: var(--text-xs); letter-spacing: .06em; text-transform: uppercase; color: var(--muted-foreground); }
  pre { margin: 0; padding: var(--space-3) var(--space-4); line-height: 1.6; overflow-x: auto; color: var(--foreground); background: color-mix(in oklch, var(--card) 40%, var(--muted)); font: inherit; }
</style>
<!-- inline path -->
<code part="code"><slot></slot></code>
<!-- block path -->
<div class="frame" part="frame">
  <div class="bar" part="bar">
    <span class="lang">{lang()}</span>
    <span class="actions"><slot name="actions"></slot></span>
  </div>
  <pre part="pre"><slot name="block"></slot></pre>
</div>
