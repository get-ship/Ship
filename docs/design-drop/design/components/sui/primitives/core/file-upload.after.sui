<!--
  sui-file-upload.after.sui — ENHANCED. The dropzone gets an upload glyph, an
  explicit "drag & drop or browse" affordance (browse reads as a link), a
  type/size caption, and a real drag-over state (a --primary dashed border + a
  soft fill tint — the feedback a bare box never gives). The filled state becomes
  a proper file row: a doc app-icon, name + size stacked, a complete progress
  hairline, and a hit-target remove. Token-pure. Compiled as <x-file-upload-after>.
  Props: state (idle|dragover|filled).
-->
<prop name="state" values="idle|dragover|filled" default="idle" reflect />
<style>
  :host { display: block; font-family: var(--font-body); }
  .zone { display: flex; flex-direction: column; align-items: center; gap: 10px; border: 1.5px dashed var(--border-strong); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; transition: border-color var(--duration-fast), background var(--duration-fast); }
  .ic { width: 38px; height: 38px; border-radius: var(--radius-lg); background: var(--muted); color: var(--muted-foreground); display: inline-flex; align-items: center; justify-content: center; }
  .ic svg { width: 20px; height: 20px; }
  .title { font-size: var(--text-sm); color: var(--foreground); }
  .browse { color: var(--primary); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
  .cap { font-size: var(--text-xs); color: var(--muted-foreground); font-family: var(--font-mono); }
  :host([state='dragover']) .zone { border-color: var(--primary); background: color-mix(in oklch, var(--primary) 8%, transparent); }
  :host([state='dragover']) .ic { background: var(--selected-bg); color: var(--primary); }
  /* filled */
  .file { display: none; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); }
  .doc { width: 34px; height: 34px; border-radius: var(--radius-md); background: var(--tone-info-bg); color: var(--tone-info-fg); display: inline-flex; align-items: center; justify-content: center; flex: none; }
  .doc svg { width: 17px; height: 17px; }
  .meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-size: var(--text-sm); color: var(--foreground); }
  .sub { font-size: var(--text-xs); color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
  .x { margin-left: auto; width: 28px; height: 28px; flex: none; cursor: pointer; color: var(--muted-foreground); border: 0; background: none; border-radius: var(--radius-sm); font-size: 16px; line-height: 1; }
  .x:hover { background: var(--muted); color: var(--foreground); }
  :host([state='filled']) .zone { display: none; }
  :host([state='filled']) .file { display: flex; }
</style>
<div class="zone" part="dropzone">
  <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg></span>
  <div class="title">Drag &amp; drop or <span class="browse">browse</span></div>
  <div class="cap">CSV, JSON · up to 10 MB</div>
</div>
<div class="file" part="file">
  <span class="doc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
  <span class="meta"><span class="name">logs-2026.csv</span><span class="sub">2.4 MB · uploaded</span></span>
  <button class="x" type="button" aria-label="Remove">×</button>
</div>
