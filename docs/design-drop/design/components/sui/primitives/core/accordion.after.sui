<!--
  sui-accordion.after.sui — ENHANCED. The loose stack of rules becomes one owned
  surface: a rounded --border container, rows divided by --border-subtle, the
  open row's header tinted (--muted) so the active section reads at a glance, a
  drawn chevron that rotates, hover wash, and a real focus ring. Exclusive open
  via native <details name>. Token-pure. Compiled as <x-accordion-after>.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .root { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); }
  details + details { border-top: 1px solid var(--border-subtle); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: var(--space-3) var(--space-4); cursor: pointer; list-style: none; color: var(--foreground); font-size: var(--text-sm); font-weight: var(--font-weight-semibold, 600); transition: background var(--duration-fast); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--hover-bg); }
  summary:focus-visible { outline: none; box-shadow: inset 0 0 0 2px color-mix(in oklch, var(--primary) 38%, transparent); }
  details[open] > summary { background: var(--muted); color: var(--foreground); }
  .chev { width: 14px; height: 14px; flex: none; color: var(--muted-foreground); transition: transform var(--duration-medium) var(--ease-out); }
  details[open] > summary .chev { transform: rotate(90deg); color: var(--foreground); }
  .body { padding: var(--space-1) var(--space-4) var(--space-4); color: var(--muted-foreground); font-size: var(--text-sm); line-height: 1.65; }
</style>
<div class="root" part="root">
  <details name="acc-after" open>
    <summary part="summary">Overview<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></summary>
    <div class="body">Run health, owner, and the active shard set for this service.</div>
  </details>
  <details name="acc-after">
    <summary part="summary">Permissions<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></summary>
    <div class="body">Who can trigger a reindex, pause the queue, or roll back a deploy.</div>
  </details>
  <details name="acc-after">
    <summary part="summary">Advanced<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></summary>
    <div class="body">Concurrency caps, retry budget, and the dry-run default.</div>
  </details>
</div>
