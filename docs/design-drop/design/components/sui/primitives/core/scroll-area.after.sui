<!--
  sui-scroll-area.after.sui — ENHANCED. Same overflow container, but the chunky
  native scrollbar becomes a thin, token-themed overlay bar (track transparent,
  thumb --border-strong, widening on hover), and top/bottom edge-fade masks cue
  that there's more content above/below — the affordance a bare overflow box
  can't express. Token-pure. Compiled as <x-scroll-area-after>.
-->
<style>
  :host { display: block; font-family: var(--font-body); }
  .area {
    height: 184px; overflow-y: auto; padding-right: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16px, #000 calc(100% - 18px), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 16px, #000 calc(100% - 18px), transparent 100%);
  }
  .area::-webkit-scrollbar { width: 8px; }
  .area::-webkit-scrollbar-track { background: transparent; }
  .area::-webkit-scrollbar-thumb { background: color-mix(in oklch, var(--border-strong) 80%, transparent); border-radius: var(--radius-full); border: 2px solid transparent; background-clip: padding-box; }
  .area:hover::-webkit-scrollbar-thumb { background: var(--border-strong); background-clip: padding-box; }
  .ln { padding: var(--space-2) var(--space-1); border-bottom: 1px solid var(--border-subtle); font-size: var(--text-sm); color: var(--foreground); display: flex; justify-content: space-between; gap: 12px; }
  .ln span { color: var(--muted-foreground); font-family: var(--font-mono); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .ln:last-child { border-bottom: 0; }
</style>
<div class="area" part="viewport">
  <div class="ln">Reindex logs-2026 <span>just now</span></div>
  <div class="ln">Compaction nightly <span>6h ago</span></div>
  <div class="ln">Shard rebalance <span>9h ago</span></div>
  <div class="ln">Deploy v4.18.2 <span>1d ago</span></div>
  <div class="ln">Snapshot full <span>1d ago</span></div>
  <div class="ln">Rollback v4.18.1 <span>2d ago</span></div>
  <div class="ln">Reindex logs-2025 <span>3d ago</span></div>
  <div class="ln">Vacuum analyze <span>4d ago</span></div>
  <div class="ln">Cache warm <span>5d ago</span></div>
  <div class="ln">Backup verify <span>6d ago</span></div>
  <div class="ln">Audit export <span>8d ago</span></div>
</div>
