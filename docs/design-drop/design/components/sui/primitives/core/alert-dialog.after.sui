<!--
  sui-alert-dialog.after.sui — ENHANCED. The bare confirm card gains the things
  an alert dialog needs to read as urgent + scannable: a leading tone icon badge
  (so destructive vs neutral is legible before reading), a tightened title/desc
  hierarchy, a footer with real button hierarchy (a ghost Cancel + a solid tone
  Confirm with a focus ring), --shadow-lg lift, and a default focus on the safe
  action. role=alertdialog + aria wiring kept. Token-pure. Rendered inline for
  the comparison. Compiled as <x-alert-dialog-after>. Props: tone.
-->
<prop name="tone" values="default|destructive" default="destructive" reflect />
<style>
  :host { display: block; font-family: var(--font-body); --ad-fg: var(--primary); --ad-bg: var(--selected-bg); }
  :host([tone='destructive']) { --ad-fg: var(--destructive); --ad-bg: var(--tone-destructive-bg); }
  .dlg { max-width: 420px; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: var(--space-5); box-shadow: var(--shadow-lg); }
  .head { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .badge { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius-lg); background: var(--ad-bg); color: var(--ad-fg); flex: none; }
  .badge svg { width: 19px; height: 19px; }
  h3 { margin: 2px 0 6px; font-size: var(--text-lg); font-weight: var(--font-weight-semibold); letter-spacing: var(--heading-tracking); }
  p { margin: 0; color: var(--muted-foreground); font-size: var(--text-sm); line-height: 1.55; }
  .actions { display: flex; gap: var(--space-2); justify-content: flex-end; margin-top: var(--space-5); }
  button { height: 34px; padding: 0 16px; border-radius: var(--radius-md); font: inherit; font-size: var(--text-sm); font-weight: var(--font-weight-medium, 500); cursor: pointer; transition: background var(--duration-fast); }
  button:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--card), 0 0 0 4px color-mix(in oklch, var(--ad-fg) 40%, transparent); }
  .cancel { background: transparent; border: 1px solid var(--border); color: var(--foreground); }
  .cancel:hover { background: var(--hover-bg); }
  .confirm { background: var(--ad-fg); color: var(--primary-foreground); border: 1px solid transparent; }
  :host([tone='destructive']) .confirm { color: var(--destructive-foreground); }
  .confirm:hover { background: color-mix(in oklch, var(--ad-fg) 88%, var(--foreground)); }
</style>
<div class="dlg" part="dialog" role="alertdialog" aria-labelledby="adt" aria-describedby="add">
  <div class="head">
    <span class="badge" part="badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
    </span>
    <div>
      <h3 id="adt">Delete this run?</h3>
      <p id="add">This permanently removes run logs-2026 and its artifacts. This action can't be undone.</p>
    </div>
  </div>
  <div class="actions"><button class="cancel" type="button">Cancel</button><button class="confirm" type="button">Delete run</button></div>
</div>
