<!--
  sui-collapsible.before.sui — EXISTING look (repo). A single disclosure region
  built on native <details>: a summary row with a leading caret + label, content
  below. Minimal chrome. Compiled as <x-collapsible-before>.
  Props: open. Slots: summary (header) · (default) body.
-->
<prop name="open" type="bool" default="false" reflect />
<style>
  :host { display: block; font-family: var(--font-body); }
  details { border-top: 1px solid var(--border); }
  summary { display: flex; align-items: center; gap: 8px; padding: var(--space-3) 0; cursor: pointer; list-style: none; color: var(--foreground); font-size: var(--text-sm); font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  .chev { color: var(--muted-foreground); transition: transform var(--duration-fast); }
  details[open] .chev { transform: rotate(90deg); }
  .body { padding: 0 0 var(--space-3); color: var(--muted-foreground); font-size: var(--text-sm); line-height: 1.6; }
</style>
<details part="root" open={open() ? 'open' : null}>
  <summary part="summary"><span class="chev" aria-hidden="true">›</span><slot name="summary">Details</slot></summary>
  <div class="body" part="body"><slot></slot></div>
</details>
