<!--
  sui-separator.before.sui — EXISTING look (repo). The structural sibling of
  divider: a plain hairline used inside lists / menus / toolbars (no label, no
  prose spacing). Horizontal or vertical. Compiled as <x-separator-before>.
  Props: orientation.
-->
<prop name="orientation" values="horizontal|vertical" default="horizontal" reflect />
<style>
  :host { display: block; }
  .sep { background: var(--border); }
  :host(:not([orientation='vertical'])) .sep { width: 100%; height: 1px; }
  :host([orientation='vertical']) { display: inline-block; height: 1em; vertical-align: middle; }
  :host([orientation='vertical']) .sep { width: 1px; height: 100%; }
</style>
<div class="sep" part="separator" role="separator" aria-orientation={orientation()}></div>
