<!--
  sui-separator.after.sui — ENHANCED. The list/menu/toolbar hairline, made to do
  its real jobs: (1) defaults to --border-subtle (a separator inside a surface
  should whisper, not draw a hard --border line like divider does), (2) inset —
  indents to align under list text past a leading icon/avatar, the menu-separator
  staple, (3) vertical stretches to its flex row's height (align-self) so a
  toolbar group-rule fills the bar instead of guessing 1em. Token-pure.
  Compiled as <x-separator-after>. Props: orientation · inset.
-->
<prop name="orientation" values="horizontal|vertical" default="horizontal" reflect />
<prop name="inset" type="bool" default="false" reflect />
<style>
  :host { display: block; }
  .sep { background: var(--border-subtle); }
  :host(:not([orientation='vertical'])) .sep { width: 100%; height: 1px; }
  :host(:not([orientation='vertical'])[inset]) .sep { margin-left: calc(var(--space-8) + var(--space-3)); width: auto; }
  /* vertical: become a flex item that fills the bar height */
  :host([orientation='vertical']) { display: inline-flex; align-self: stretch; height: auto; vertical-align: middle; }
  :host([orientation='vertical']) .sep { width: 1px; height: auto; align-self: stretch; min-height: 1em; background: var(--border); }
  :host([orientation='vertical'][inset]) { margin-block: var(--space-1); }
</style>
<div class="sep" part="separator" role="separator" aria-orientation={orientation()}></div>
