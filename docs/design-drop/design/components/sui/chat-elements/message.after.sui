<!--
  message.after.sui — "New" single chat message bubble (sui-message). The list
  (message-list) and composer already exist; this is the atomic bubble. Role-aware:
  assistant sits left with a tinted avatar + neutral bubble; user mirrors right with
  a primary-tinted bubble. Meta line carries author · time. Content is slotted.
  Compiled <message-after>.
-->
<prop name="role" values="user|assistant" default="assistant" reflect />
<prop name="author" type="string" default="Assistant" />
<prop name="time" type="string" default="" />

<style>
  :host { display: block; }
  .msg { display: flex; gap: 10px; align-items: flex-start; }
  :host([role='user']) .msg { flex-direction: row-reverse; }
  .av { width: 30px; height: 30px; flex: 0 0 auto; border-radius: var(--radius-md); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 12px; background: color-mix(in oklch, var(--accent) 16%, var(--card)); color: color-mix(in oklch, var(--accent) 86%, var(--foreground)); }
  :host([role='user']) .av { background: color-mix(in oklch, var(--primary) 16%, var(--card)); color: color-mix(in oklch, var(--primary) 86%, var(--foreground)); }
  .col { display: flex; flex-direction: column; gap: 4px; max-width: 80%; min-width: 0; }
  .meta { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  :host([role='user']) .meta { text-align: right; }
  .bubble { padding: 10px 13px; border-radius: var(--radius-lg); background: var(--card); border: 1px solid var(--border-subtle); font-size: var(--text-sm); line-height: 1.6; color: var(--foreground); }
  :host([role='user']) .bubble { background: color-mix(in oklch, var(--primary) 13%, var(--card)); border-color: color-mix(in oklch, var(--primary) 26%, transparent); }
</style>

<div class="msg" part="message">
  <span class="av" part="avatar">{author().slice(0,1)}</span>
  <div class="col">
    <span class="meta">{author()} · {time()}</span>
    <div class="bubble" part="bubble"><slot></slot></div>
  </div>
</div>
