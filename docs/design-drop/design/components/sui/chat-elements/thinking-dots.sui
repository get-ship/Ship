<!--
  sui-thinking-dots.sui — chat-elements pack. Animated three-dot "thinking"
  indicator. New component, pure CSS, no props/controller. Reduced-motion aware.
-->
<style>
  :host { display: inline-flex; align-items: center; gap: 4px; padding: 8px 2px; }
  :host([hidden]) { display: none; }
  .d { width: 6px; height: 6px; border-radius: 50%; background: var(--muted-foreground); animation: td 1.2s var(--ease-out) infinite; }
  .d:nth-child(2) { animation-delay: .18s; }
  .d:nth-child(3) { animation-delay: .36s; }
  @keyframes td { 0%, 60%, 100% { opacity: .35; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) { .d { animation: none; opacity: .6; } }
</style>
<span class="d"></span><span class="d"></span><span class="d"></span>
