<!--
  sui-tool-call.after.sui — BOLD REDESIGN (not unification). vs the current card:
    • state-colored left rail (success/error/running) — instant scannability
    • status as a real pill, not a dot+word; duration badge on success
    • structured body: a labeled "args" row → an "output" block with a check,
      instead of one flat mono blob
    • function-call header glyph + tighter type hierarchy
    • running: animated rail shimmer + Cancel; error: full-width red footer + Retry
  State + visibility attribute-driven (no controller). Tokens only.
  Props: name · state(running|success|error) · args · result · error · ms.
-->
<prop name="name" type="string" default="tool" />
<prop name="state" values="running|success|error" default="success" reflect />
<prop name="args" type="string" default="" />
<prop name="result" type="string" default="" />
<prop name="error" type="string" default="" />
<prop name="ms" type="string" default="" />

<style>
  :host { display: block; font-family: var(--font-body); max-width: 100%; --rail: var(--muted-foreground); --tint: var(--muted); }
  :host([hidden]) { display: none; }
  :host([state='running']) { --rail: var(--warning); --tint: var(--tone-warning-bg); }
  :host([state='success']) { --rail: var(--success); --tint: var(--tone-success-bg); }
  :host([state='error'])   { --rail: var(--destructive); --tint: var(--tone-destructive-bg); }

  .tool { position: relative; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); overflow: hidden; box-shadow: var(--shadow-xs); padding-left: 4px; }
  .tool::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--rail); }
  :host([state='running']) .tool::before { background: linear-gradient(var(--rail), color-mix(in oklch, var(--rail) 30%, transparent), var(--rail)); background-size: 100% 200%; animation: tc-rail 1.1s linear infinite; }
  @keyframes tc-rail { to { background-position: 0 -200%; } }

  .hd { display: flex; align-items: center; gap: 9px; padding: 9px 12px 9px 11px; }
  .fn { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--foreground); min-width: 0; }
  .fn svg { width: 14px; height: 14px; color: var(--rail); flex-shrink: 0; }
  .fn .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fn .paren { color: var(--muted-foreground); font-weight: 400; }

  .pill { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0;
    font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    padding: 3px 9px; border-radius: var(--radius-full); background: var(--tint); color: var(--rail); }
  .pill .lbl { display: none; }
  :host([state='running']) .pill .lbl.run { display: inline; }
  :host([state='success']) .pill .lbl.ok { display: inline; }
  :host([state='error']) .pill .lbl.er { display: inline; }
  .pill .spin { width: 9px; height: 9px; border: 1.6px solid color-mix(in oklch, var(--rail) 35%, transparent); border-top-color: var(--rail); border-radius: 50%; display: none; }
  :host([state='running']) .pill .spin { display: inline-block; animation: tc-spin .7s linear infinite; }
  @keyframes tc-spin { to { transform: rotate(360deg); } }
  .pill .ms { display: none; font-variant-numeric: tabular-nums; }
  :host([state='success']) .pill .ms { display: inline; }

  .row { display: flex; align-items: flex-start; gap: 8px; padding: 0 12px 9px 11px; font-family: var(--font-mono); font-size: 11px; line-height: 1.5; }
  .tag { flex-shrink: 0; font-size: 8.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--muted-foreground); background: var(--muted); border-radius: var(--radius-sm); padding: 2px 5px; margin-top: 1px; }
  .args { color: var(--muted-foreground); white-space: pre-wrap; word-break: break-word; min-width: 0; }

  .out { display: none; align-items: flex-start; gap: 8px; margin: 0 12px 10px 11px; padding: 8px 10px; border-radius: var(--radius-sm); background: color-mix(in oklch, var(--success) 7%, var(--card)); border: 1px solid var(--tone-success-border); font-family: var(--font-mono); font-size: 11px; line-height: 1.5; color: var(--foreground); }
  :host([state='success']) .out { display: flex; }
  .out svg { width: 13px; height: 13px; color: var(--success); flex-shrink: 0; margin-top: 1px; }

  .err { display: none; align-items: center; gap: 10px; padding: 9px 12px; border-top: 1px solid var(--tone-destructive-border); background: color-mix(in oklch, var(--destructive) 9%, var(--card)); color: var(--destructive); font-size: var(--text-sm); }
  :host([state='error']) .err { display: flex; }
  .err svg { width: 15px; height: 15px; flex-shrink: 0; }
  .err .msg { flex: 1; }

  .btn { border: 1px solid var(--border); background: var(--card); color: var(--foreground); font: inherit; font-size: 10.5px; font-weight: 600; padding: 3px 10px; border-radius: var(--radius-sm); cursor: pointer; }
  .btn:hover { background: var(--hover-bg); }
  .cancel { display: none; } :host([state='running']) .cancel { display: inline-flex; }
  .retry { border-color: color-mix(in oklch, var(--destructive) 45%, var(--border)); color: var(--destructive); }
  .retry:hover { background: color-mix(in oklch, var(--destructive) 10%, var(--card)); }
  .btn:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
</style>

<div class="tool" part="tool">
  <div class="hd">
    <span class="fn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"></path></svg>
      <span class="nm">{name()}</span><span class="paren">( )</span>
    </span>
    <span class="pill" part="status">
      <span class="spin"></span>
      <span class="lbl run">running</span>
      <span class="lbl ok">ok</span>
      <span class="lbl er">failed</span>
      <span class="ms">{ms()}</span>
      <button class="btn cancel" type="button">Cancel</button>
    </span>
  </div>
  <div class="row"><span class="tag">args</span><span class="args">{args()}</span></div>
  <div class="out" part="output">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
    <span class="args" style="color:var(--foreground)">{result()}</span>
  </div>
  <div class="err" part="error">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>
    <span class="msg">{error()}</span><button class="btn retry" type="button">Retry</button>
  </div>
</div>
