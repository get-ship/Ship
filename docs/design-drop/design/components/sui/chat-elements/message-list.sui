<!--
  sui-message-list.sui — chat-elements pack. Scrollable message thread: roles,
  bubbles, streaming caret, sticky-bottom auto-scroll (paired controller).
  NOTE: production wires the runtime virtualizer (createVirtualizer) for 10k+
  threads; this design pass renders the window directly to lock the VISUAL —
  the windowing swaps in behind the same template + `items` contract. Tokens only.
  Scope (controller): items signal · scrollEl ref. Prop: sticky-bottom.
-->
<prop name="sticky-bottom" type="bool" default="true" reflect />

<style>
  :host { display: block; }
  :host([hidden]) { display: none; }
  .scroll { display: flex; flex-direction: column; gap: 12px; max-height: 300px; overflow-y: auto; padding: 4px 2px; scrollbar-width: thin; }
  .msg { display: flex; gap: 10px; max-width: 88%; }
  .msg.user { align-self: flex-end; flex-direction: row-reverse; }
  .av { width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center; font: 700 10px var(--font-mono); }
  .msg.assistant .av { background: var(--muted); color: var(--muted-foreground); }
  .msg.user .av { background: var(--tone-primary-bg); color: var(--tone-primary-fg); }
  .bub { padding: 8px 12px; border-radius: var(--radius-lg); font-size: var(--text-sm); line-height: 1.5; }
  .msg.assistant .bub { background: var(--muted); color: var(--foreground); border-bottom-left-radius: var(--radius-sm); }
  .msg.user .bub { background: var(--primary); color: var(--primary-foreground); border-bottom-right-radius: var(--radius-sm); }
  .bub.stream::after { content: '\258B'; margin-left: 1px; color: var(--primary); animation: ml-blink 1s steps(2) infinite; }
  .msg.user .bub.stream::after { color: var(--primary-foreground); }
  @keyframes ml-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .bub.stream::after { animation: none; } }
</style>

<div class="scroll" part="scroll" bind:this={scrollEl}>
  {#for m of items() key={m.id}}
    <div class={'msg ' + m.role}>
      <span class="av">{m.av}</span>
      <div class={m.streaming ? 'bub stream' : 'bub'}>{m.text}</div>
    </div>
  {/for}
</div>
