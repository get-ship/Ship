<!--
  sui-message-list.before.sui — the EXISTING/grounded look. A plain "role: text"
  transcript: no avatars, no bubbles, no streaming caret — just stacked lines.
  Pairs with the SAME message-list.controller.js (`items` JS-property +
  sticky-bottom auto-scroll) so the data contract is identical; only the visual
  differs. Prop: sticky-bottom. Compiled as <x-ml-before>.
-->
<prop name="sticky-bottom" type="bool" default="true" reflect />

<style>
  :host { display: block; }
  :host([hidden]) { display: none; }
  .scroll { display: flex; flex-direction: column; gap: 8px; max-height: 300px; overflow-y: auto; padding: 4px 2px; scrollbar-width: thin; }
  .msg { display: flex; gap: 8px; font-size: var(--text-sm); line-height: 1.5; }
  .role { flex: 0 0 70px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .text { flex: 1; min-width: 0; color: var(--foreground); }
</style>

<div class="scroll" part="scroll" bind:this={scrollEl}>
  {#for m of items() key={m.id}}
    <div class="msg">
      <span class="role">{m.role}:</span>
      <span class="text">{m.text}</span>
    </div>
  {/for}
</div>
