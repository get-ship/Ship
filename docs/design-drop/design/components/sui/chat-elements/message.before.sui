<!--
  message.before.sui — "Existing" baseline single message: a flat labelled line,
  no avatar, no bubble, no role mirroring. Compiled <message-before>.
-->
<prop name="role" values="user|assistant" default="assistant" reflect />
<prop name="author" type="string" default="Assistant" />
<prop name="time" type="string" default="" />

<style>
  :host { display: block; padding: 4px 0; }
  .who { font-weight: 600; font-size: var(--text-sm); color: var(--foreground); }
  .body { font-size: var(--text-sm); color: var(--foreground); line-height: 1.5; }
  .time { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); margin-left: 6px; }
</style>

<div part="message">
  <span class="who">{author()}<span class="time">{time()}</span></span>
  <div class="body"><slot></slot></div>
</div>
