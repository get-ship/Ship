<!--
  sui-composer.sui — chat-elements pack. Message input with attachments slot +
  send button. New component (branch ships a controller, no template) — authored
  here, paired with composer.controller.js. Enter submits; Shift+Enter newlines
  in multiline. Tokens only.
  Props: multiline (bool) · disabled (bool) · placeholder (string).
  Scope (from controller): text signal · refs fieldEl, sendEl.
-->
<prop name="multiline" type="bool" default="false" reflect />
<prop name="disabled" type="bool" default="false" reflect />
<prop name="placeholder" type="string" default="Message…" />

<style>
  :host { display: block; width: 100%; font-family: var(--font-body); }
  :host([hidden]) { display: none; }

  .composer {
    display: flex; align-items: flex-end; gap: 8px;
    padding: 7px 8px 7px 12px;
    background: var(--card); color: var(--foreground);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  :host(:not([disabled])) .composer:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 1px var(--card), 0 0 0 3px var(--tone-primary-ring);
  }
  :host([disabled]) .composer { background: var(--muted); }

  .attach {
    flex: 0 0 auto; width: 28px; height: 28px; border-radius: var(--radius-md);
    border: 0; background: transparent; color: var(--muted-foreground);
    display: grid; place-items: center; cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .attach:hover { background: var(--hover-bg); color: var(--foreground); }
  .attach svg { width: 16px; height: 16px; }

  .field {
    flex: 1; min-width: 0; border: 0; outline: 0; resize: none;
    background: transparent; color: var(--foreground);
    font: inherit; font-size: var(--text-sm); line-height: 1.5;
    padding: 6px 0; max-height: 120px;
  }
  .field::placeholder { color: var(--muted-foreground); }

  .send {
    flex: 0 0 auto; width: 30px; height: 30px; border-radius: var(--radius-md);
    border: 0; background: var(--primary); color: var(--primary-foreground);
    display: grid; place-items: center; cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .send:hover:not(:disabled) { background: color-mix(in oklch, var(--primary) 92%, white); }
  .send:active:not(:disabled) { transform: scale(0.94); }
  .send:disabled { background: var(--muted); color: var(--muted-foreground); cursor: not-allowed; }
  .send svg { width: 15px; height: 15px; }
  .send:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
</style>

<div class="composer" part="composer">
  <button class="attach" part="attach" type="button" aria-label="Attach" tabindex="-1">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.05 12.25 20.2a5 5 0 0 1-7.07-7.07l9.19-9.19a3 3 0 1 1 4.24 4.24l-9.2 9.19a1 1 0 0 1-1.41-1.41l8.49-8.49"></path></svg>
  </button>
  {#if multiline()}
    <textarea class="field" part="field" rows="2" placeholder={placeholder()} disabled={disabled()} bind:value={text} bind:this={fieldEl}></textarea>
  {:else}
    <input class="field" part="field" type="text" placeholder={placeholder()} disabled={disabled()} bind:value={text} bind:this={fieldEl} />
  {/if}
  <button class="send" part="send" type="button" aria-label="Send" disabled={disabled()} bind:this={sendEl}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"></path></svg>
  </button>
</div>
