<!--
  sui-citation.sui — chat-elements pack. Inline numbered source chip that
  expands to the cited span on hover/focus. New component (the branch ships a
  controller but no template) — authored here. No controller needed; the
  expand is pure CSS :host(:hover)/:focus-within. Tokens only.
  Props: index (number) · source · section · quote.  Slot: default = chip label.
-->
<prop name="index" type="number" default="1" reflect />
<prop name="source" type="string" default="" />
<prop name="section" type="string" default="" />
<prop name="quote" type="string" default="" />

<style>
  :host { position: relative; display: inline-flex; vertical-align: baseline; font-family: var(--font-body); }
  :host([hidden]) { display: none; }

  .cite {
    display: inline-flex; align-items: center; gap: 4px; vertical-align: baseline;
    font-size: 10.5px; font-weight: 600; line-height: 1.4;
    padding: 0 6px; border-radius: var(--radius-full);
    background: var(--tone-info-bg); color: var(--tone-info-fg);
    border: 1px solid transparent; cursor: pointer; user-select: none;
    transition: background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  :host(:hover) .cite, :host(:focus-within) .cite {
    background: color-mix(in oklch, var(--info) 22%, transparent);
    border-color: var(--tone-info-border);
  }
  .cite:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
  .num { font-variant-numeric: tabular-nums; }
  .lbl { color: inherit; }
  ::slotted(*) { color: inherit; font: inherit; }

  .card {
    position: absolute; left: 0; bottom: calc(100% + 8px); z-index: 40;
    width: max-content; max-width: 320px;
    padding: 9px 12px; border-radius: var(--radius-md);
    background: var(--popover); color: var(--popover-foreground);
    border: 1px solid var(--border); box-shadow: var(--shadow-lg);
    opacity: 0; transform: translateY(4px); pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  :host(:hover) .card, :host(:focus-within) .card { opacity: 1; transform: translateY(0); }
  .src { font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); margin-bottom: 4px; }
  .q { font-size: var(--text-sm); line-height: 1.5; color: var(--foreground); }
  .q::before { content: '\201C'; } .q::after { content: '\201D'; }
</style>

<span class="cite" tabindex="0" part="chip"
  aria-describedby="cite-card"
  aria-label={'Citation ' + index()}>
  <span class="num" part="num">{index()}</span>
  <span class="lbl"><slot>source</slot></span>
</span>
<span class="card" id="cite-card" part="card" role="note">
  <span class="src">{source()}{section() ? ' \u00b7 ' + section() : ''}</span>
  <span class="q">{quote()}</span>
</span>
