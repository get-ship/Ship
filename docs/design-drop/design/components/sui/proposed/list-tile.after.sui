<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-list-tile.after.sui — ENHANCED. The free-flex row becomes a disciplined
  3-track grid [leading · text · trailing] so titles, subtitles, and trailing
  meta line up across a whole list regardless of leading size. Plus: a fixed
  leading box (icons/avatars don't reflow the text column), title/subtitle type
  ramp with truncation (single-line ellipsis — long values can't break the row),
  a proper selected state (--selected-bg + a --primary inset rail, not just a
  grey wash), hover, and a focus ring for interactive rows. Token-pure.
  Compiled as <x-list-tile-after>. Props/slots unchanged.
-->
<prop name="title" type="string" default="" />
<prop name="subtitle" type="string" default="" />
<prop name="interactive" type="bool" default="false" reflect />
<prop name="selected" type="bool" default="false" reflect />
<style>
  :host { display: block; font-family: var(--font-body); }
  .tile { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-3); border-radius: var(--radius-md); position: relative; transition: background var(--duration-fast); }
  :host([interactive]) .tile { cursor: pointer; }
  :host([interactive]) .tile:hover { background: var(--hover-bg); }
  :host([interactive]) .tile:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--card), 0 0 0 4px color-mix(in oklch, var(--primary) 35%, transparent); }
  :host([selected]) .tile { background: var(--selected-bg); }
  :host([selected]) .tile::before { content: ""; position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px; border-radius: var(--radius-full); background: var(--primary); }
  .lead { display: flex; align-items: center; justify-content: center; min-width: var(--space-8); }
  .lead:empty { display: none; }
  .txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .title { font-size: var(--text-md); font-weight: var(--font-weight-medium, 500); color: var(--foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sub { font-size: var(--text-sm); color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sub:empty { display: none; }
  .trail { display: flex; align-items: center; gap: var(--space-2); color: var(--muted-foreground); }
</style>
<div class="tile" part="tile" tabindex={interactive() ? '0' : null}>
  <span class="lead" part="leading"><slot name="leading"></slot></span>
  <span class="txt"><span class="title">{title()}</span><span class="sub">{subtitle()}</span></span>
  <span class="trail" part="trailing"><slot name="trailing"></slot></span>
</div>
