<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-annotation-list.before.sui — fabricated sketch (not in source), rendered static
  with three fixed staged items (a host could drive these from a property +
  controller; hardcoded here for a controller-free visual). Plain bordered rows:
  uppercase kind, note, outline Remove. Compiled as <x-annlist-before>.
-->
<style>
  :host { display: block; font-family: var(--font-body); font-size: var(--text-sm); color: var(--foreground); }
  :host([hidden]) { display: none; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  li { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--background); }
  .kind { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted-foreground); min-width: 48px; }
  .note { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  button { background: transparent; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--muted-foreground); cursor: pointer; font-size: var(--text-xs); padding: 2px 6px; }
  button:hover { color: var(--destructive); border-color: var(--destructive); }
</style>

<ol part="list">
  <li part="item"><span class="kind">point</span><span class="note">p99 chart axis is mislabeled</span><button type="button" aria-label="Remove annotation">Remove</button></li>
  <li part="item"><span class="kind">region</span><span class="note">this header block feels cramped — more air</span><button type="button" aria-label="Remove annotation">Remove</button></li>
  <li part="item"><span class="kind">point</span><span class="note">wrong tone on the success badge</span><button type="button" aria-label="Remove annotation">Remove</button></li>
</ol>
