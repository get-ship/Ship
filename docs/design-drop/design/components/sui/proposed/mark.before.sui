<prop name="tone" values="default" default="default" reflect />
<style>
  :host { display: inline; }
  mark { background: color-mix(in oklch, var(--warning) 35%, transparent); color: inherit; padding: 0 2px; border-radius: 2px; }
</style>
<mark part="mark"><slot></slot></mark>
