<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-app-icon.after.sui — ENHANCED. The flat tile becomes a proper app/
  integration icon: a softer squircle (--radius-lg), a tone-tinted fill off the
  shared ramp with the glyph in the matching tone-fg (so a tile reads its
  category at a glance), a hairline tone border + an inset top highlight for a
  little dimensionality, and a size scale. Token-pure. Compiled as
  <x-app-icon-after>. Props: tone · size. Slot: an <svg> / glyph.
-->
<prop name="tone" values="default|info|success|warning" default="default" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<style>
  :host { display: inline-flex; --ai-fg: var(--foreground); --ai-bg: var(--muted); --ai-bd: var(--border-subtle); --ai-box: 40px; --ai-glyph: 20px; }
  :host([tone='info'])    { --ai-fg: var(--tone-info-fg);    --ai-bg: var(--tone-info-bg);    --ai-bd: var(--tone-info-border); }
  :host([tone='success']) { --ai-fg: var(--tone-success-fg); --ai-bg: var(--tone-success-bg); --ai-bd: var(--tone-success-border); }
  :host([tone='warning']) { --ai-fg: var(--tone-warning-fg); --ai-bg: var(--tone-warning-bg); --ai-bd: var(--tone-warning-border); }
  :host([size='sm']) { --ai-box: 32px; --ai-glyph: 16px; }
  :host([size='lg']) { --ai-box: 52px; --ai-glyph: 26px; }
  .tile { display: inline-flex; align-items: center; justify-content: center; width: var(--ai-box); height: var(--ai-box); background: var(--ai-bg); color: var(--ai-fg); border: 1px solid var(--ai-bd); border-radius: var(--radius-lg); box-shadow: inset 0 1px 0 color-mix(in oklch, var(--background) 50%, transparent); }
  .tile ::slotted(svg) { width: var(--ai-glyph); height: var(--ai-glyph); }
</style>
<span class="tile" part="tile"><slot></slot></span>
