<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-divider.after.sui — ENHANCED. Adds an optional centered label (a slotted
  caption sits between two rule segments) — the common "OR" / section divider that
  the bare <hr> can't express; collapses to a continuous line when the slot is
  empty. Tone/variant kept. Compiled as <x-divider-after>.
  Props: orientation · variant · tone. Slot: (default) optional label.
-->
<prop name="orientation" values="horizontal|vertical" default="horizontal" reflect />
<prop name="variant" values="solid|dashed" default="solid" reflect />
<prop name="tone" values="default|muted|primary|destructive" default="default" reflect />
<style>
  :host { display: block; --tone-bg: var(--border); }
  :host([tone='muted'])       { --tone-bg: color-mix(in oklch, var(--border) 50%, transparent); }
  :host([tone='primary'])     { --tone-bg: color-mix(in oklch, var(--primary) 50%, var(--border)); }
  :host([tone='destructive']) { --tone-bg: color-mix(in oklch, var(--destructive) 50%, var(--border)); }
  .wrap { display: flex; align-items: center; gap: 10px; margin: var(--space-2) 0; }
  :host([data-no-label]) .wrap { gap: 0; }
  .seg { flex: 1; height: 1px; background: var(--tone-bg); }
  :host([variant='dashed']) .seg { background: transparent; border-top: 1px dashed var(--tone-bg); height: 0; }
  .lbl { font-family: var(--font-mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-foreground); white-space: nowrap; }
  :host([data-no-label]) .lbl { display: none; }
  :host([orientation='vertical']) { display: inline-block; vertical-align: middle; }
  :host([orientation='vertical']) .wrap { flex-direction: column; height: 100%; margin: 0 var(--space-2); }
  :host([orientation='vertical']) .seg { width: 1px; height: auto; flex: 1; }
</style>
<div class="wrap" part="line" role="separator" aria-orientation={orientation()}>
  <span class="seg"></span>
  <span class="lbl"><slot reflect-empty="data-no-label"></slot></span>
  <span class="seg"></span>
</div>
