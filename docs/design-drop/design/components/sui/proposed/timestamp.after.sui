<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-timestamp.after.sui — POLISH. Same muted relative string, but: (1) tabular
  numerals so a ticking "12s / 13s / 14s" doesn't jitter, (2) an optional leading
  live-dot (success tone) that marks fresh/streaming items, (3) a tone for stale
  rows (warning) so an aging item reads at a glance. Static dot — no decorative
  loop. Token-pure. Compiled as <x-timestamp-after>.
  Props: datetime (title) · live · tone.
-->
<prop name="datetime" type="string" default="" />
<prop name="live" type="bool" default="false" reflect />
<prop name="tone" values="default|stale" default="default" reflect />
<style>
  :host { display: inline-flex; align-items: baseline; gap: 5px; font-family: var(--font-body); }
  .dot { display: none; align-self: center; width: 6px; height: 6px; border-radius: var(--radius-full); background: var(--tone-success-fg); box-shadow: 0 0 0 3px var(--tone-success-bg); flex: none; }
  :host([live]) .dot { display: inline-block; }
  time { color: var(--muted-foreground); font-size: var(--text-sm); font-variant-numeric: tabular-nums; white-space: nowrap; }
  :host([tone='stale']) time { color: var(--tone-warning-fg); }
</style>
<span class="dot" aria-hidden="true"></span>
<time part="time" datetime={datetime()} title={datetime()}><slot></slot></time>
