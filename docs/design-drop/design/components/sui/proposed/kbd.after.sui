<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-kbd.after.sui — POLISH. Reads more like a physical key cap: a top inset
  highlight + a card-surface face (vs flat muted), the 2px bottom border kept as
  the key "lip", tabular numerals. Compiled as <x-kbd-after>.
-->
<prop name="keys" type="string" default="" />
<prop name="size" values="sm|md" default="md" reflect />
<style>
  :host { display: inline-flex; align-items: center; vertical-align: baseline; }
  kbd { display: inline-flex; align-items: center; justify-content: center; min-width: 19px; padding: 2px 6px; font-family: var(--font-mono); font-weight: var(--font-weight-semibold, 600); font-size: 11px; font-variant-numeric: tabular-nums; line-height: 1.2; color: var(--foreground); background: color-mix(in oklch, var(--card) 80%, var(--muted)); border: 1px solid var(--border-strong); border-bottom-width: 2px; border-radius: var(--radius-sm); box-shadow: var(--shadow-xs), inset 0 1px 0 color-mix(in oklch, var(--background) 60%, transparent); white-space: nowrap; }
  :host([size='sm']) kbd { font-size: 10px; padding: 1px 5px; min-width: 16px; }
</style>
<kbd part="kbd"><slot></slot></kbd>
