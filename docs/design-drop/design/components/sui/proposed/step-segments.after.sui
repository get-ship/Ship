<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-step-segments.after.sui — ENHANCED. Three distinct states instead of two:
  completed segments are a solid --primary, the CURRENT segment reads as
  in-progress (a partial --primary fill over a tinted track + a soft --primary
  ring so it's the focal point), and upcoming stay --muted. Rounded caps + a
  wider gap give it rhythm. role=progressbar with real value. Static snapshot at
  "step 3 of 5". Token-pure. Compiled as <x-step-segments-after>.
  Props: total · current (API; snapshot hardcoded here).
-->
<prop name="total" type="number" default="5" />
<prop name="current" type="number" default="3" />
<style>
  :host { display: block; }
  .seg { display: flex; gap: 5px; }
  .s { position: relative; flex: 1; height: 6px; border-radius: var(--radius-full); background: var(--muted); overflow: hidden; }
  .s.done { background: var(--primary); }
  .s.cur { background: color-mix(in oklch, var(--primary) 22%, var(--muted)); box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 20%, transparent); overflow: visible; }
  .s.cur::after { content: ""; position: absolute; inset: 0; width: 55%; background: var(--primary); border-radius: var(--radius-full); }
</style>
<div class="seg" part="track" role="progressbar" aria-valuemin="0" aria-valuemax={total()} aria-valuenow={current()}>
  <span class="s done"></span><span class="s done"></span><span class="s cur"></span><span class="s"></span><span class="s"></span>
</div>
