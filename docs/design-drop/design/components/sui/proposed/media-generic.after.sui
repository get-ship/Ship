<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!-- sui-media.after.sui — ELEVATED. One consistent media frame across the trio:
  a toolbar (filename + mono size + actions), a rounded --card surface, a typed body
  (striped image placeholder w/ label, two-tone played/unplayed waveform, a data-grid
  CSV with --muted header + zebra + tabular nums), and a caption/status bar. NOTE:
  pdf + map are ship-* (routed by ship-viewer), not in this primitive — see handoff.
  Compiled as <x-media-after>. Props: type · name. -->
<prop name="type" values="image|audio|csv" default="image" reflect />
<prop name="name" type="string" default="screenshot.png" />
<style>
  :host { display: block; font-family: var(--font-body); width: 320px; }
  .frame { border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }
  .tb { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 55%, var(--card)); }
  .tb .nm { font-size: 12px; color: var(--foreground); font-weight: var(--font-weight-medium, 500); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tb .sz { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .tb .act { display: inline-flex; gap: 2px; }
  .tb .act button { width: 22px; height: 22px; border: 0; background: transparent; color: var(--muted-foreground); border-radius: var(--radius-sm); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .tb .act button:hover { background: var(--muted); color: var(--foreground); }
  .tb .act svg { width: 14px; height: 14px; }
  .body { position: relative; }
  .ph { aspect-ratio: 16 / 10; display: flex; align-items: center; justify-content: center; color: var(--muted-foreground); font-family: var(--font-mono); font-size: 11px; background: repeating-linear-gradient(45deg, var(--muted), var(--muted) 7px, color-mix(in oklch, var(--muted) 50%, var(--card)) 7px, color-mix(in oklch, var(--muted) 50%, var(--card)) 14px); }
  .wave { display: none; height: 70px; align-items: flex-end; gap: 2px; padding: 12px; }
  .wave i { flex: 1; background: color-mix(in oklch, var(--muted-foreground) 40%, transparent); border-radius: 1.5px; }
  .wave i.p { background: var(--primary); }
  :host([type='audio']) .ph { display: none; } :host([type='audio']) .wave { display: flex; }
  table { display: none; width: 100%; border-collapse: collapse; font-size: 12px; }
  :host([type='csv']) .ph { display: none; } :host([type='csv']) table { display: table; }
  thead th { background: var(--muted); color: var(--foreground); font-weight: var(--font-weight-semibold, 600); }
  th, td { border-bottom: 1px solid var(--border-subtle); padding: 6px 10px; text-align: left; color: var(--foreground); font-variant-numeric: tabular-nums; }
  tbody tr:nth-child(even) td { background: color-mix(in oklch, var(--muted) 30%, transparent); }
  tbody tr:last-child td { border-bottom: 0; }
  .cap { display: flex; gap: 10px; padding: 6px 10px; border-top: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-foreground); }
</style>
<div class="frame" part="frame">
  <div class="tb">
    <span class="nm">{name()}</span>
    <span class="sz">1.2 MB</span>
    <span class="act">
      <button type="button" aria-label="Zoom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg></button>
      <button type="button" aria-label="Download"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 11l5 5 5-5M5 21h14"/></svg></button>
    </span>
  </div>
  <div class="body">
    <div class="ph">1280 × 800</div>
    <div class="wave"><i class="p" style="height:37%"></i><i class="p" style="height:49%"></i><i class="p" style="height:56%"></i><i class="p" style="height:53%"></i><i class="p" style="height:43%"></i><i class="p" style="height:30%"></i><i class="p" style="height:20%"></i><i class="p" style="height:18%"></i><i class="p" style="height:25%"></i><i class="p" style="height:37%"></i><i class="p" style="height:49%"></i><i class="" style="height:56%"></i><i class="" style="height:53%"></i><i class="" style="height:43%"></i><i class="" style="height:30%"></i><i class="" style="height:20%"></i><i class="" style="height:18%"></i><i class="" style="height:25%"></i><i class="" style="height:38%"></i><i class="" style="height:50%"></i><i class="" style="height:56%"></i><i class="" style="height:53%"></i><i class="" style="height:43%"></i><i class="" style="height:30%"></i><i class="" style="height:20%"></i><i class="" style="height:18%"></i></div>
    <table><thead><tr><th>shard</th><th>p99</th><th>errors</th></tr></thead><tbody><tr><td>logs-2026</td><td>238ms</td><td>0.1%</td></tr><tr><td>logs-2025</td><td>past</td><td>0.3%</td></tr><tr><td>events</td><td>190ms</td><td>0.0%</td></tr></tbody></table>
  </div>
  <div class="cap"><span>image/png</span><span>1280×800</span><span>sRGB</span></div>
</div>
