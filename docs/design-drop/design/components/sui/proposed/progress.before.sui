<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-progress.before.sui — fabricated sketch (not in source). Linear bar, determinate
  (value/max) or indeterminate. Tone mappings added for the compare. Compiled as
  <x-progress-before>. Props: value · max · tone · size · indeterminate · label.
-->
<prop name="value" type="number" default="0" />
<prop name="max" type="number" default="100" />
<prop name="tone" values="default|primary|info|success|warning|destructive|accent" default="primary" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />
<prop name="indeterminate" type="bool" default="false" reflect />
<prop name="label" type="string" default="" />

<style>
  :host { display: block; --tone: var(--primary); --h: 6px; }
  :host([hidden]) { display: none; }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  :host([tone='accent'])      { --tone: var(--accent); }
  :host([size='sm']) { --h: 4px; }
  :host([size='md']) { --h: 6px; }
  :host([size='lg']) { --h: 10px; }

  .track { width: 100%; height: var(--h); background: var(--muted); border-radius: var(--radius-full); overflow: hidden; position: relative; }
  .fill { height: 100%; background: var(--tone); border-radius: var(--radius-full); transition: width var(--duration-fast) var(--ease-out); }
  :host([indeterminate]) .fill { width: 30%; animation: sui-progress-indet 1.4s ease-in-out infinite; }
  @keyframes sui-progress-indet { 0% { transform: translateX(-100%); } 50% { transform: translateX(150%); } 100% { transform: translateX(350%); } }
  @media (prefers-reduced-motion: reduce) { :host([indeterminate]) .fill { animation-duration: 3s; } }
</style>

<div class="track" part="track" role="progressbar" aria-valuenow={indeterminate() ? null : value()} aria-valuemin="0" aria-valuemax={max()} aria-busy={indeterminate() ? 'true' : 'false'} aria-label={label()}>
  <div class="fill" part="fill" style={indeterminate() ? '' : ('width: clamp(0%, ' + (value() / (max() || 1) * 100) + '%, 100%)')}></div>
</div>
