<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-toolbar.after.sui — ENHANCED. The bare flex row becomes a real bar: an
  inline --card surface with a --border frame + --shadow-xs, tight token padding,
  a tighter inter-control gap (groups are separated by <sui-separator vertical>
  instead of one flat gap), wrap so it never overflows, and a normalized control
  height via ::slotted so mixed buttons/inputs line up. role=toolbar kept.
  Token-pure. Compiled as <x-toolbar-after>. Props: orientation. Slot: controls.
-->
<prop name="orientation" values="horizontal|vertical" default="horizontal" reflect />
<style>
  :host { display: inline-block; font-family: var(--font-body); max-width: 100%; }
  .bar { display: inline-flex; align-items: center; gap: var(--space-1); flex-wrap: wrap; padding: var(--space-1); background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-xs); }
  :host([orientation='vertical']) .bar { flex-direction: column; align-items: stretch; flex-wrap: nowrap; }
  /* normalize slotted control height so buttons/separators align */
  .bar ::slotted(button) { height: 30px; }
</style>
<div class="bar" part="toolbar" role="toolbar" aria-orientation={orientation()}><slot></slot></div>
