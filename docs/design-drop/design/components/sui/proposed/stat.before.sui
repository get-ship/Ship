<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-stat.before.sui — fabricated sketch (not in source). KPI tile: label · large
  value · optional trend/hint slots, tone-colored value. Tone mappings added so
  the compare shows color (repo relies on a shared tone channel). Compiled as
  <x-stat-before>. Props: tone · interactive · size. Slots: label · default · trend · hint.
-->
<prop name="tone" values="default|primary|info|success|warning|destructive|accent" default="default" reflect />
<prop name="interactive" type="bool" default="false" reflect />
<prop name="size" values="sm|md|lg" default="md" reflect />

<style>
  :host {
    display: flex; flex-direction: column; gap: 4px;
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 16px 18px; font-family: var(--font-body); --tone-fg: var(--foreground);
    transition: border-color var(--duration-medium) var(--ease-out), transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  :host([hidden]) { display: none; }
  :host([tone='primary'])     { --tone-fg: var(--primary); }
  :host([tone='info'])        { --tone-fg: var(--info); }
  :host([tone='success'])     { --tone-fg: var(--success); }
  :host([tone='warning'])     { --tone-fg: var(--warning); }
  :host([tone='destructive']) { --tone-fg: var(--destructive); }
  :host([tone='accent'])      { --tone-fg: var(--accent); }

  :host([interactive]) { cursor: pointer; }
  :host([interactive]:hover) { border-color: color-mix(in oklch, var(--border) 180%, transparent); transform: translateY(-1px); box-shadow: var(--shadow-sm); }

  .label { font-size: var(--text-xs); font-weight: var(--font-weight-medium); letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted-foreground); }
  .value-row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .value { font-family: var(--heading-font, var(--font-body)); font-weight: var(--font-weight-bold); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--tone-fg); }
  :host([size='sm']) .value { font-size: var(--text-xl, 20px); }
  :host([size='md']) .value { font-size: var(--text-3xl, 30px); }
  :host([size='lg']) .value { font-size: var(--text-4xl, 36px); }
  .trend { display: inline-flex; align-items: center; }
  .hint { font-size: 11px; color: var(--muted-foreground); }
  ::slotted([slot='trend']) { font-size: var(--text-sm); }
</style>

<span class="label" part="label"><slot name="label"></slot></span>
<span class="value-row" part="value-row">
  <span class="value" part="value"><slot></slot></span>
  <span class="trend" part="trend"><slot name="trend"></slot></span>
</span>
<span class="hint" part="hint"><slot name="hint"></slot></span>
