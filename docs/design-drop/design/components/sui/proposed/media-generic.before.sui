<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!-- sui-media.before.sui — fabricated sketch (not in source). Renders a media payload
  (image / audio / csv) with minimal chrome: a bordered box, no toolbar, no caption,
  flat placeholders. type switches the body. Compiled as <x-media-before>. Props: type. -->
<prop name="type" values="image|audio|csv" default="image" reflect />
<style>
  :host { display: block; font-family: var(--font-body); width: 320px; }
  .media { border: 1px solid var(--border); background: var(--card); overflow: hidden; }
  .ph { aspect-ratio: 16 / 10; display: flex; align-items: center; justify-content: center; background: var(--muted); color: var(--muted-foreground); font-family: var(--font-mono); font-size: 11px; }
  .wave { display: none; height: 70px; align-items: flex-end; gap: 2px; padding: 12px; }
  .wave i { flex: 1; background: var(--muted-foreground); opacity: .45; border-radius: 1px; }
  :host([type='audio']) .ph { display: none; } :host([type='audio']) .wave { display: flex; }
  table { display: none; width: 100%; border-collapse: collapse; font-size: 12px; }
  :host([type='csv']) .ph { display: none; } :host([type='csv']) table { display: table; }
  th, td { border: 1px solid var(--border); padding: 5px 8px; text-align: left; color: var(--foreground); }
</style>
<div class="media" part="media">
  <div class="ph">screenshot.png</div>
  <div class="wave"><i style="height:37%"></i><i style="height:49%"></i><i style="height:56%"></i><i style="height:53%"></i><i style="height:43%"></i><i style="height:30%"></i><i style="height:20%"></i><i style="height:18%"></i><i style="height:25%"></i><i style="height:37%"></i><i style="height:49%"></i><i style="height:56%"></i><i style="height:53%"></i><i style="height:43%"></i><i style="height:30%"></i><i style="height:20%"></i><i style="height:18%"></i><i style="height:25%"></i><i style="height:38%"></i><i style="height:50%"></i><i style="height:56%"></i><i style="height:53%"></i><i style="height:43%"></i><i style="height:30%"></i><i style="height:20%"></i><i style="height:18%"></i></div>
  <table><tr><th>shard</th><th>p99</th><th>errors</th></tr><tr><td>logs-2026</td><td>238ms</td><td>0.1%</td></tr><tr><td>logs-2025</td><td>past</td><td>0.3%</td></tr><tr><td>events</td><td>190ms</td><td>0.0%</td></tr></table>
</div>
