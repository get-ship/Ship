<!--
  sui-kbd.before.sui — fabricated sketch (not in source). Keyboard key cap. Compiled as <x-kbd-before>.
-->
<prop name="keys" type="string" default="" />
<prop name="size" values="sm|md" default="md" reflect />
<style>
  :host { display: inline-flex; align-items: center; vertical-align: baseline; }
  kbd { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; padding: 2px 5px; font-family: var(--font-mono); font-weight: var(--font-weight-medium, 500); font-size: 11px; line-height: 1.2; color: var(--foreground); background: var(--muted); border: 1px solid var(--border); border-bottom-width: 2px; border-radius: var(--radius-sm); box-shadow: var(--shadow-xs); white-space: nowrap; }
  :host([size='sm']) kbd { font-size: 10px; padding: 1px 4px; min-width: 16px; }
</style>
<kbd part="kbd"><slot></slot></kbd>
