<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-list-tile.before.sui — fabricated sketch (not in source). A list row: optional leading
  slot, a stacked title + subtitle, optional trailing slot. Simple flex, fixed
  gaps. Compiled as <x-list-tile-before>.
  Props: title · subtitle · interactive · selected. Slots: leading · trailing.
-->
<prop name="title" type="string" default="" />
<prop name="subtitle" type="string" default="" />
<prop name="interactive" type="bool" default="false" reflect />
<prop name="selected" type="bool" default="false" reflect />
<style>
  :host { display: block; font-family: var(--font-body); }
  .tile { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); }
  :host([interactive]) .tile { cursor: pointer; }
  :host([interactive]) .tile:hover { background: var(--muted); }
  :host([selected]) .tile { background: var(--muted); }
  .txt { display: flex; flex-direction: column; }
  .title { font-size: var(--text-md); color: var(--foreground); }
  .sub { font-size: var(--text-sm); color: var(--muted-foreground); }
  .lead, .trail { display: flex; align-items: center; }
  .trail { margin-left: auto; }
</style>
<div class="tile" part="tile">
  <span class="lead" part="leading"><slot name="leading"></slot></span>
  <span class="txt"><span class="title">{title()}</span><span class="sub">{subtitle()}</span></span>
  <span class="trail" part="trailing"><slot name="trailing"></slot></span>
</div>
