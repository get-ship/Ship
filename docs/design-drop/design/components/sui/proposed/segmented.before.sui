<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-segmented.before.sui — fabricated sketch (not in source), rendered as a
  static visual with three fixed options (no controller / MutationObserver). The
  `value` prop selects. Container --muted + --border, selected button --card +
  --shadow-xs, focus ring via the offset/width token stack. Compiled as
  <x-segmented-before>. Props: value · size · disabled.
-->
<prop name="value" type="string" default="list" reflect />
<prop name="size" values="sm|md" default="md" reflect />
<prop name="disabled" type="bool" default="false" reflect />

<style>
  :host { display: inline-flex; }
  :host([hidden]) { display: none; }
  .container { display: inline-flex; padding: 2px; background: var(--muted); border: 1px solid var(--border); border-radius: var(--radius-md); gap: 1px; }
  .btn {
    appearance: none; border: 0; background: transparent; border-radius: var(--radius-sm);
    font-family: var(--font-body); color: var(--muted-foreground); cursor: pointer;
    display: inline-flex; align-items: center; gap: var(--space-1); white-space: nowrap; line-height: 1;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  :host(:not([size])) .btn, :host([size='md']) .btn { padding: 5px var(--space-3); font-size: var(--text-sm); }
  :host([size='sm']) .btn { padding: 4px var(--space-2); font-size: var(--text-xs); }
  .btn[aria-checked='true'] { background: var(--card); color: var(--foreground); box-shadow: var(--shadow-xs); }
  .btn:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--background), 0 0 0 4px color-mix(in oklch, var(--primary) 60%, transparent); }
  :host([disabled]) .btn { opacity: 0.5; cursor: not-allowed; pointer-events: none; }
</style>

<div class="container" part="container" role="radiogroup">
  <button class="btn" role="radio" type="button" data-value="list"
    aria-checked={value() === 'list' ? 'true' : 'false'} tabindex={value() === 'list' ? '0' : '-1'}>List</button>
  <button class="btn" role="radio" type="button" data-value="board"
    aria-checked={value() === 'board' ? 'true' : 'false'} tabindex={value() === 'board' ? '0' : '-1'}>Board</button>
  <button class="btn" role="radio" type="button" data-value="timeline"
    aria-checked={value() === 'timeline' ? 'true' : 'false'} tabindex={value() === 'timeline' ? '0' : '-1'}>Timeline</button>
</div>
