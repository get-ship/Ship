<!-- ⚠ FABRICATED — this component does NOT exist in madvib/Ship@job/sui-framework. Hallucinated during a session that ran before real source was imported. Treat as a rough sketch only; see ./README.md for triage (drop / kind-of-X / possible real gap). -->
<!--
  sui-theme-toggle.after.sui — ENHANCED. A proper pill segmented control: a
  --muted track, each option a sun/moon glyph + label, and the checked option
  rides up as a --card "thumb" with --shadow-xs (the iOS-style segmented read),
  hover + a real focus-visible ring. Still native radios + :has(), no controller.
  Compiled as <x-theme-toggle-after>.
-->
<style>
  :host { display: inline-block; font-family: var(--font-body); }
  .seg { display: inline-flex; gap: 2px; padding: 3px; background: var(--muted); border-radius: var(--radius-full); }
  label { display: inline-flex; align-items: center; gap: 6px; padding: 5px 13px; border-radius: var(--radius-full); font-size: var(--text-sm); font-weight: var(--font-weight-medium, 500); color: var(--muted-foreground); cursor: pointer; transition: color var(--duration-fast), background var(--duration-fast); }
  label:hover { color: var(--foreground); }
  input { position: absolute; opacity: 0; width: 0; height: 0; }
  label:has(input:checked) { background: var(--card); color: var(--foreground); box-shadow: var(--shadow-xs); }
  label:has(input:focus-visible) { outline: none; box-shadow: 0 0 0 2px var(--muted), 0 0 0 4px color-mix(in oklch, var(--primary) 35%, transparent); }
  .ico { width: 14px; height: 14px; }
</style>
<div class="seg" part="toggle" role="radiogroup" aria-label="Theme">
  <label>
    <input type="radio" name="tt-after" checked />
    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
    Light
  </label>
  <label>
    <input type="radio" name="tt-after" />
    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
    Dark
  </label>
</div>
