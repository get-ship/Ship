<!--
  draw.after.sui — "New" freehand draw layer (sui-draw), the third canvas surface
  alongside canvas + board. The drawing area is a PixiJS engine at runtime (mocked
  here as a dotted grid); the DESIGN is the floating tool palette — tool group,
  colour swatches, stroke widths — token-pure so it re-themes. Compiled <draw-after>.
-->
<style>
  :host { display: block; }
  .draw { position: relative; height: 300px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }
  .surface { position: absolute; inset: 0; background-image: radial-gradient(color-mix(in oklch, var(--foreground) 12%, transparent) 1px, transparent 1px); background-size: 18px 18px; background-position: 9px 9px; }
  .palette { position: absolute; left: 14px; top: 14px; display: flex; align-items: center; gap: 4px; padding: 5px; border-radius: var(--radius-full); background: color-mix(in oklch, var(--card) 88%, transparent); backdrop-filter: blur(8px); border: 1px solid var(--border); box-shadow: var(--shadow-md); }
  .tool { width: 30px; height: 30px; border: 0; border-radius: var(--radius-full); background: transparent; color: var(--muted-foreground); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .tool:hover { background: color-mix(in oklch, var(--foreground) 8%, transparent); color: var(--foreground); }
  .tool.on { background: var(--primary); color: var(--primary-foreground); }
  .tool svg { width: 16px; height: 16px; }
  .div { width: 1px; align-self: stretch; margin: 3px 4px; background: var(--border); }
  .sw { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--card); cursor: pointer; box-shadow: 0 0 0 1px var(--border); }
  .sw.on { box-shadow: 0 0 0 2px var(--foreground); }
  .c-ink { background: var(--foreground); } .c-pri { background: var(--primary); } .c-suc { background: var(--success); } .c-dst { background: var(--destructive); }
  .stroke { display: inline-flex; align-items: center; gap: 5px; padding: 0 6px; }
  .stroke i { display: block; border-radius: 50%; background: var(--muted-foreground); }
  .stroke i.s1 { width: 4px; height: 4px; } .stroke i.s2 { width: 7px; height: 7px; } .stroke i.s3 { width: 10px; height: 10px; }
  .hint { position: absolute; right: 14px; bottom: 12px; font-family: var(--font-mono); font-size: 10px; color: var(--muted-foreground); }
</style>

<div class="draw" part="draw">
  <div class="surface" part="surface"></div>
  <div class="palette" part="palette">
    <button class="tool on" type="button" aria-label="Pen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg></button>
    <button class="tool" type="button" aria-label="Eraser"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20H7L3 16a2 2 0 0 1 0-3l9-9a2 2 0 0 1 3 0l5 5a2 2 0 0 1 0 3l-7 8"/></svg></button>
    <button class="tool" type="button" aria-label="Rectangle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/></svg></button>
    <button class="tool" type="button" aria-label="Arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19L19 5M19 5h-8M19 5v8"/></svg></button>
    <span class="div"></span>
    <span class="sw c-ink on" role="button" aria-label="Ink"></span>
    <span class="sw c-pri" role="button" aria-label="Primary"></span>
    <span class="sw c-suc" role="button" aria-label="Green"></span>
    <span class="sw c-dst" role="button" aria-label="Red"></span>
    <span class="div"></span>
    <span class="stroke"><i class="s1"></i><i class="s2"></i><i class="s3"></i></span>
  </div>
  <span class="hint">draw layer · pixi</span>
</div>
