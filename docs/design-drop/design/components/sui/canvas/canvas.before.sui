<!--
  sui-canvas.before.sui — EXISTING look (repo styling) of the agent-paired
  authoring surface, rendered static (no kernel wire / morph). `hascontent`
  toggles the empty state vs the slotted content (repo uses a controller
  hasContent() signal). Plain surface; centered empty state with an image glyph,
  title, and subtitle. Compiled as <x-canvas-before>. Props: full-height · hascontent.
-->
<prop name="full-height" type="bool" default="false" reflect />
<prop name="hascontent" type="bool" default="false" reflect />

<style>
  :host { display: block; position: relative; background: var(--background); color: var(--foreground); font-family: var(--font-body); overflow: auto; }
  :host([hidden]) { display: none; }
  :host([full-height]) { height: 100%; }
  .canvas-surface { min-height: 100%; padding: var(--space-6); box-sizing: border-box; }
  .canvas-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: 240px; gap: var(--space-3); color: var(--muted-foreground);
    font-size: var(--text-sm); text-align: center; padding: var(--space-8);
  }
  .canvas-empty svg { width: 28px; height: 28px; color: var(--muted-foreground); }
  .canvas-empty-title { font-family: var(--font-display); font-size: var(--text-base); font-weight: var(--font-weight-semibold); color: var(--foreground); }
</style>

<div class="canvas-surface" part="surface">
  {#if hascontent()}
    <slot></slot>
  {:else}
    <div class="canvas-empty" part="empty">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-2.8 0L6 21"></path></svg>
      <div class="canvas-empty-title">Canvas ready</div>
      <div>Paired agent will render content here.</div>
    </div>
  {/if}
</div>
