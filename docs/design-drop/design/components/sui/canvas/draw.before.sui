<!--
  draw.before.sui — "Existing" baseline draw layer: a bare canvas box with a plain
  native-style tool row above it. No floating palette, no grid, no swatches.
  Compiled <draw-before>.
-->
<style>
  :host { display: block; }
  .tb { display: flex; gap: 6px; padding: 6px; border: 1px solid var(--border); border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0; background: var(--card); }
  .tb button { font: inherit; font-size: 12px; padding: 3px 8px; border: 1px solid var(--border); background: var(--card); color: var(--foreground); border-radius: var(--radius-sm); cursor: pointer; }
  .surface { height: 264px; border: 1px solid var(--border); border-radius: 0 0 var(--radius-sm) var(--radius-sm); background: var(--card); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
</style>

<div part="draw">
  <div class="tb"><button type="button">Pen</button><button type="button">Eraser</button><button type="button">Color</button></div>
  <div class="surface">canvas</div>
</div>
