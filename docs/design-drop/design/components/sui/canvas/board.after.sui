<!-- sui-board.after.sui — FIXED (review: changes / launch-critical). Edges now
  stroke --border-strong (read on every theme incl. console/contrast), the
  failure path is a --destructive "incident" edge and a not-yet-run path is a
  dashed --primary "pending" edge, all with arrowheads. Ports grow their HIT area
  (18px transparent target) while the visible dot stays small, and gain a
  --primary ring. Nodes get a tone header strip + --shadow-xs. Token-pure. Static
  snapshot. Compiled as <x-board-after>. -->
<style>
  :host { display: block; font-family: var(--font-body); }
  .board { position: relative; width: 480px; height: 240px; max-width: 100%; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); background-image: radial-gradient(var(--border-subtle) 1px, transparent 1px); background-size: 16px 16px; overflow: hidden; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .edge { fill: none; stroke: var(--border-strong); stroke-width: 2; }
  .edge.incident { stroke: var(--destructive); stroke-width: 2.5; }
  .edge.pending { stroke: var(--primary); stroke-width: 2; stroke-dasharray: 5 4; }
  .ah { fill: var(--border-strong); }
  .ah.incident { fill: var(--destructive); }
  .node { position: absolute; width: 120px; height: 52px; box-sizing: border-box; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-xs); overflow: hidden; }
  .node .bar { height: 4px; background: var(--primary); }
  .node.warn .bar { background: var(--warning); }
  .node.err .bar { background: var(--destructive); }
  .node .body { padding: 6px 10px; }
  .node .t { font-size: 12px; font-weight: var(--font-weight-semibold, 600); color: var(--foreground); }
  .node .s { font-size: 10px; color: var(--muted-foreground); }
  /* port = big transparent hit area + small visible dot */
  .port { position: absolute; width: 18px; height: 18px; display: grid; place-items: center; cursor: crosshair; }
  .port::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--card); border: 2px solid var(--border-strong); }
  .port:hover::after { border-color: var(--primary); box-shadow: 0 0 0 3px var(--selected-bg); }
</style>
<div class="board" part="board">
  <svg viewBox="0 0 480 240" aria-hidden="true">
    <path class="edge" d="M136 50 C162 50 154 122 180 122"></path>
    <path class="edge" d="M300 122 C326 122 318 50 344 50"></path>
    <polygon class="ah" points="344,50 336,46 336,54"></polygon>
    <path class="edge incident" d="M240 148 L240 174"></path>
    <polygon class="ah incident" points="240,178 236,170 244,170"></polygon>
    <path class="edge pending" d="M136 44 C220 8 300 8 344 42"></path>
  </svg>
  <div class="node" style="left:16px;top:24px"><div class="bar"></div><div class="body"><div class="t">Ingest</div><div class="s">source</div></div><span class="port" style="right:-9px;top:18px"></span></div>
  <div class="node warn" style="left:180px;top:96px"><div class="bar"></div><div class="body"><div class="t">Transform</div><div class="s">map · filter</div></div><span class="port" style="left:-9px;top:18px"></span><span class="port" style="right:-9px;top:18px"></span><span class="port" style="left:51px;bottom:-9px"></span></div>
  <div class="node" style="left:344px;top:24px"><div class="bar"></div><div class="body"><div class="t">Index</div><div class="s">sink</div></div><span class="port" style="left:-9px;top:18px"></span></div>
  <div class="node err" style="left:180px;top:176px"><div class="bar"></div><div class="body"><div class="t">Alert</div><div class="s">on fail</div></div><span class="port" style="left:51px;top:-9px"></span></div>
</div>
