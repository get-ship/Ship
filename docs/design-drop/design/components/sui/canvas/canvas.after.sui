<!--
  sui-canvas.after.sui — ELEVATED authoring surface. Same contract; diffs:
    • surface reads as a real canvas: a faint dot-grid background (token-based
      radial-gradient) instead of flat fill — signals an open authoring space
    • empty state becomes an inviting authoring affordance: a dashed framed drop
      zone, the glyph seated in a --tone-primary tinted disc, a clearer title,
      and a hint line so the user knows the agent + annotation flow is live
  Static visual (no controller). Compiled as <x-canvas-after>.
  Props: full-height · hascontent.
-->
<prop name="full-height" type="bool" default="false" reflect />
<prop name="hascontent" type="bool" default="false" reflect />

<style>
  :host { display: block; position: relative; background: var(--background); color: var(--foreground); font-family: var(--font-body); overflow: auto; }
  :host([hidden]) { display: none; }
  :host([full-height]) { height: 100%; }
  .canvas-surface {
    min-height: 100%; padding: var(--space-6); box-sizing: border-box;
    background-image: radial-gradient(color-mix(in oklch, var(--border) 55%, transparent) 1px, transparent 1.4px);
    background-size: 16px 16px; background-position: -1px -1px;
  }
  .canvas-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: 240px; gap: var(--space-3); color: var(--muted-foreground);
    font-size: var(--text-sm); text-align: center; padding: var(--space-8);
    border: 1.5px dashed var(--border-strong); border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--card) 70%, transparent);
  }
  .disc { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: var(--tone-primary-bg); }
  .disc svg { width: 22px; height: 22px; color: var(--primary); }
  .canvas-empty-title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: var(--font-weight-semibold); color: var(--foreground); }
  .hint { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); color: var(--muted-foreground); }
  .hint kbd { font-family: var(--font-mono); font-size: 10px; background: var(--muted); border: 1px solid var(--border); border-bottom-width: 2px; border-radius: var(--radius-sm); padding: 1px 5px; color: var(--foreground); }
</style>

<div class="canvas-surface" part="surface">
  {#if hascontent()}
    <slot></slot>
  {:else}
    <div class="canvas-empty" part="empty">
      <span class="disc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-2.8 0L6 21"></path></svg></span>
      <div class="canvas-empty-title">Canvas ready</div>
      <div>The paired agent renders here — annotate any element to send feedback.</div>
      <span class="hint"><kbd>drag</kbd> to draw a region<kbd>click</kbd> to drop a pin</span>
    </div>
  {/if}
</div>
