<!-- sui-heatmap.new.sui — ELEVATED on identical data. Rounded cells with a real
  gap, a coherent tone ramp built on the cell tone (empty = faint --muted, filled =
  tone at stepped color-mix so low values stay legible on every theme), plus
  weekday axis labels and a less→more legend. Compiled as <x-heatmap-new>. Props: tone. -->
<prop name="tone" values="primary|info|success|warning|destructive" default="success" reflect />
<style>
  :host { display: block; font-family: var(--font-body); --tone: var(--success); }
  :host([tone='primary']) { --tone: var(--primary); }
  :host([tone='info']) { --tone: var(--info); }
  :host([tone='warning']) { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  .row { display: flex; align-items: flex-start; gap: 8px; }
  .days { display: flex; flex-direction: column; justify-content: space-between; font-family: var(--font-mono); font-size: 9px; color: var(--muted-foreground); padding: 1px 0; }
  svg { display: block; width: 100%; height: auto; max-width: 360px; }
  .c { rx: 2.5px; ry: 2.5px; }
  .i0 { fill: color-mix(in oklch, var(--muted) 70%, var(--card)); }
  .i1 { fill: color-mix(in oklch, var(--tone) 28%, var(--card)); }
  .i2 { fill: color-mix(in oklch, var(--tone) 50%, var(--card)); }
  .i3 { fill: color-mix(in oklch, var(--tone) 74%, var(--card)); }
  .i4 { fill: var(--tone); }
  .legend { display: flex; align-items: center; justify-content: flex-end; gap: 5px; margin-top: 8px; font-size: 10px; color: var(--muted-foreground); }
  .legend .k { width: 11px; height: 11px; border-radius: 2.5px; }
  .legend .k0 { background: color-mix(in oklch, var(--muted) 70%, var(--card)); }
  .legend .k1 { background: color-mix(in oklch, var(--tone) 28%, var(--card)); }
  .legend .k2 { background: color-mix(in oklch, var(--tone) 50%, var(--card)); }
  .legend .k3 { background: color-mix(in oklch, var(--tone) 74%, var(--card)); }
  .legend .k4 { background: var(--tone); }
</style>
<div class="row">
  <div class="days"><span>Mon</span><span>Wed</span><span>Fri</span><span>Sun</span></div>
  <svg viewBox="0 0 194 96" part="chart" role="img" aria-label="Heatmap">
    <rect class="c i4" x="0" y="0" width="12" height="12"></rect>
    <rect class="c i4" x="14" y="0" width="12" height="12"></rect>
    <rect class="c i4" x="28" y="0" width="12" height="12"></rect>
    <rect class="c i3" x="42" y="0" width="12" height="12"></rect>
