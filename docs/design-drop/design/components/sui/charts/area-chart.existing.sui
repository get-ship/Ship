<!-- sui-area-chart.existing.sui — EXISTING look (repo). Single-series area: flat
  tone fill + a thin line, no baseline/grid, butt joins. Static sample geometry
  (same series as .new). Compiled as <x-area-existing>. Props: tone. -->
<prop name="tone" values="primary|accent|info|success|warning|destructive" default="primary" reflect />
<style>
  :host { display: block; width: 100%; --tone: var(--primary); }
  :host([tone='accent']) { --tone: var(--accent); }
  :host([tone='info']) { --tone: var(--info); }
  :host([tone='success']) { --tone: var(--success); }
  :host([tone='warning']) { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .area { fill: var(--tone); fill-opacity: 0.12; stroke: none; }
  .line { fill: none; stroke: var(--tone); stroke-width: 1.5; }
</style>
<svg viewBox="0 0 240 96" part="chart" role="img" aria-label="Area chart">
  <path class="area" d="M4 88 L4 88 L29.8 71.3 L55.6 79.6 L81.3 54.6 L107.1 65.7 L132.9 40.6 L158.7 49 L184.4 26.7 L210.2 35.1 L236 10 L236 88 Z"></path>
  <path class="line" d="M4 88 L29.8 71.3 L55.6 79.6 L81.3 54.6 L107.1 65.7 L132.9 40.6 L158.7 49 L184.4 26.7 L210.2 35.1 L236 10"></path>
</svg>
