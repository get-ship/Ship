<!-- sui-donut.new.sui — ELEVATED single-value ring on the IDENTICAL pathLength
  geometry (stroke-dasharray={value} 100, no controller). Adds: a tone-tinted
  track for figure/ground, round caps, an animated sweep, a faint containment
  hairline, a start tick for the 0/100 origin, and refined center typography
  (tabular value + uppercase mono label). Same plain number readout as existing
  — no unit suffix, since donut values aren't all percentages. Tokens only.
  Compiled as
  <x-donut-new>. Props: value (0–100) · tone · label. -->
<prop name="value" type="number" default="0" reflect />
<prop name="tone" values="primary|accent|info|success|warning|destructive" default="primary" reflect />
<prop name="label" type="string" default="" />

<style>
  :host { display: inline-block; --tone: var(--primary); }
  :host([hidden]) { display: none; }
  :host([tone='accent'])      { --tone: var(--accent); }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  svg { display: block; width: 96px; height: 96px; }
  .hair { fill: none; stroke: var(--border-subtle); stroke-width: 1; }
  .track { fill: none; stroke: color-mix(in oklch, var(--tone) 16%, var(--muted)); stroke-width: 9; }
  .arc { fill: none; stroke: var(--tone); stroke-width: 9; stroke-linecap: round; transition: stroke-dasharray var(--duration-medium) var(--ease-out); }
  .tick { stroke: color-mix(in oklch, var(--tone) 55%, var(--border)); stroke-width: 1.5; }
  .val { fill: var(--foreground); font-family: var(--font-body); font-weight: var(--font-weight-semibold); font-size: 19px; font-variant-numeric: tabular-nums; }
  .lab { fill: var(--muted-foreground); font-family: var(--font-mono); font-size: 7px; letter-spacing: .12em; text-transform: uppercase; }
</style>

<svg viewBox="0 0 80 80" part="chart" role="img">
  <circle class="hair" cx="40" cy="40" r="37.5"></circle>
  <circle class="track" cx="40" cy="40" r="32" pathLength="100"></circle>
  <circle class="arc" cx="40" cy="40" r="32" pathLength="100"
    stroke-dasharray={value() + ' 100'} transform="rotate(-90 40 40)"></circle>
  <line class="tick" x1="40" y1="3.5" x2="40" y2="9.5"></line>
  <text class="val" x="40" y="39" text-anchor="middle" dominant-baseline="central">{value()}</text>
  <text class="lab" x="40" y="55" text-anchor="middle">{label()}</text>
</svg>
