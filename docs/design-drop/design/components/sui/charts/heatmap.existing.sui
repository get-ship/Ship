<!-- sui-heatmap.existing.sui — EXISTING look (repo). A value grid: square cells,
  one harsh tone stepped by opacity, no gap, no labels/legend. Static sample data
  (same as .new). Compiled as <x-heatmap-existing>. Props: tone. -->
<prop name="tone" values="primary|info|success|warning|destructive" default="success" reflect />
<style>
  :host { display: block; font-family: var(--font-body); --tone: var(--success); }
  :host([tone='primary']) { --tone: var(--primary); }
  :host([tone='info']) { --tone: var(--info); }
  :host([tone='warning']) { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  svg { display: block; width: 100%; height: auto; max-width: 360px; }
  .c { fill: var(--tone); }
  .i0 { fill: var(--muted); }
  .i1 { fill-opacity: 0.35; }
  .i2 { fill-opacity: 0.55; }
  .i3 { fill-opacity: 0.78; }
  .i4 { fill-opacity: 1; }
</style>
<svg viewBox="0 0 194 96" part="chart" role="img" aria-label="Heatmap">
    <rect class="c i4" x="0" y="0" width="12" height="12"></rect>
    <rect class="c i4" x="14" y="0" width="12" height="12"></rect>
    <rect class="c i4" x="28" y="0" width="12" height="12"></rect>
    <rect class="c i3" x="42" y="0" width="12" height="12"></rect>
