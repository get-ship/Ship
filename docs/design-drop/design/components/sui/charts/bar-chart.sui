<!--
  sui-bar-chart.sui — charts pack. Data-driven bars in a 240×80 viewBox,
  scaled to fit. New component. Geometry (bar x/y/w/h) computed in the paired
  controller from `data`; template paints <rect>s. Tone-colored, hover-lift.
  Props: data (JSON number[]) · tone. Scope (controller): bars derived.
-->
<prop name="data" type="string" default="[]" />
<prop name="tone" values="primary|accent|info|success|warning|destructive" default="primary" reflect />

<style>
  :host { display: block; width: 100%; --tone: var(--primary); }
  :host([hidden]) { display: none; }
  :host([tone='accent'])      { --tone: var(--accent); }
  :host([tone='info'])        { --tone: var(--info); }
  :host([tone='success'])     { --tone: var(--success); }
  :host([tone='warning'])     { --tone: var(--warning); }
  :host([tone='destructive']) { --tone: var(--destructive); }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .bar { fill: color-mix(in oklch, var(--tone) 82%, transparent); transition: fill var(--duration-fast) var(--ease-out); }
  .bar:hover { fill: var(--tone); }
  .base { stroke: var(--border); stroke-width: 1; }
</style>

<svg viewBox="0 0 240 80" part="chart" role="img">
  <line class="base" x1="0" y1="80" x2="240" y2="80"></line>
  {#for b of bars() key={b.i}}
    <rect class="bar" x={b.x} y={b.y} width={b.w} height={b.h} rx="2"></rect>
  {/for}
</svg>
