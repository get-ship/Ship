<!-- sui-bar-chart.new.sui — ELEVATED, on IDENTICAL engine geometry (same shared
  controller → same barGeometry). Adds: a baseline axis + two faint gridlines for
  read-off, value labels above each bar, rounded caps, and a hover-brighten.
  The only diff vs existing is this template/style — a true grounded redesign.
  Compiled as <x-bar-new>. -->
<prop name="data" type="string" default="" />
<prop name="tone" values="primary|accent|info|success|warning|destructive" default="primary" reflect />
<prop name="labels" type="string" default="" />

<style>
  :host { display: block; width: 100%; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid { stroke: var(--border-subtle); stroke-width: .5; }
  .base { stroke: var(--border); stroke-width: 1; }
  .bar { opacity: .85; transition: opacity var(--duration-fast) var(--ease-out); }
  .bar:hover { opacity: 1; }
  .lbl { fill: var(--muted-foreground); font-family: var(--font-mono); font-size: 6px; }
</style>

<svg viewBox="0 0 240 92" part="chart" role="img">
  <line class="grid" x1="0" y1="20" x2="240" y2="20"></line>
  <line class="grid" x1="0" y1="50" x2="240" y2="50"></line>
  <line class="base" x1="0" y1="80" x2="240" y2="80"></line>
  {#for b of bars() key={b.id}}
    <rect class="bar" x={b.x} y={b.y} width={b.w} height={b.h} rx="3" fill={b.color}><title>{b.title}</title></rect>
    <text class="lbl" x={b.x + b.w / 2} y={b.y - 3} text-anchor="middle">{b.raw}</text>
  {/for}
</svg>
