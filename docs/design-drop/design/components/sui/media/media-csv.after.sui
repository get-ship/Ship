<!--
  media-csv.after.sui — "New" designed CSV renderer. PROPOSAL (media was not in
  _repo-src). A real table over the live parser (media-csv.controller.js): a
  filename/row-count bar, sticky header, zebra rows, right-aligned numerics,
  monospace cells. Compiled <media-csv-after>. media-csv.before is the raw dump.
-->
<prop name="data" type="string" default="" />
<prop name="name" type="string" default="data.csv" />

<style>
  :host { display: block; }
  .csv { border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); box-shadow: var(--shadow-xs); overflow: hidden; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 12px; border-bottom: 1px solid var(--border-subtle); background: color-mix(in oklch, var(--muted) 40%, transparent); }
  .fn { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; }
  .cnt { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .scroll { max-height: 320px; overflow: auto; }
  table { border-collapse: collapse; width: 100%; font-family: var(--font-mono); font-size: 12px; }
  thead th { position: sticky; top: 0; z-index: 1; text-align: left; padding: 8px 12px; background: var(--card); color: var(--muted-foreground); font-weight: 600; font-size: 10px; letter-spacing: .05em; text-transform: uppercase; border-bottom: 1px solid var(--border); white-space: nowrap; }
  tbody td { padding: 7px 12px; color: var(--foreground); border-bottom: 1px solid var(--border-subtle); white-space: nowrap; }
  tbody tr:nth-child(even) { background: color-mix(in oklch, var(--muted) 26%, transparent); }
  tbody tr:hover { background: var(--hover-bg, color-mix(in oklch, var(--primary) 7%, transparent)); }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
</style>

<div class="csv" part="table">
  <div class="bar"><span class="fn">{name()}</span><span class="cnt">{count()} rows</span></div>
  <div class="scroll">
    <table>
      <thead><tr>{#for h of headers() key={h.key}}<th>{h.label}</th>{/for}</tr></thead>
      <tbody>{#for r of rows() key={r.key}}<tr>{#for c of r.cells key={c.key}}<td class={c.cls}>{c.v}</td>{/for}</tr>{/for}</tbody>
    </table>
  </div>
</div>
