<!--
  media-av.before.sui — "Existing" baseline: a bare native-style control row —
  a play glyph, a flat progress line, a time. No poster, no design. Compiled
  <media-av-before>.
-->
<prop name="name" type="string" default="walkthrough.mp4" />
<prop name="time" type="string" default="1:24" />
<prop name="dur" type="string" default="3:42" />

<style>
  :host { display: block; }
  .row { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card); }
  .pp { border: 1px solid var(--border); background: var(--card); color: var(--foreground); border-radius: var(--radius-sm); padding: 3px 9px; font-size: 12px; cursor: pointer; }
  .track { flex: 1; height: 3px; background: color-mix(in oklch, var(--foreground) 18%, transparent); border-radius: 2px; position: relative; }
  .fill { position: absolute; left: 0; top: 0; bottom: 0; width: 38%; background: var(--muted-foreground); border-radius: 2px; }
  .t { font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
</style>

<div class="row" part="player">
  <button class="pp" type="button" aria-label="Play">▶</button>
  <span class="t">{time()}</span>
  <div class="track"><div class="fill"></div></div>
  <span class="t">{dur()}</span>
</div>
