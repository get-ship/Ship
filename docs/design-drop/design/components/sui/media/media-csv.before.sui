<!--
  media-csv.before.sui — "Existing" baseline: the raw text dump you get with no
  renderer. No controller needed. Compiled <media-csv-before>.
-->
<prop name="data" type="string" default="" />
<prop name="name" type="string" default="data.csv" />

<style>
  :host { display: block; }
  .raw { margin: 0; padding: 12px; font-family: var(--font-mono); font-size: 12px; line-height: 1.5; color: var(--foreground); background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: auto; max-height: 320px; white-space: pre; }
</style>

<pre class="raw" part="raw">{data()}</pre>
