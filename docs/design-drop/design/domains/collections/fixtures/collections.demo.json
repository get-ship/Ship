  "_meta": {
    "purpose": "UI demo fixtures for the collections Data Studio + sui-collection-* pack. DESIGNER-READABLE: schema_json and data_json are shown DECODED here. On the wire they are base64-of-JSON bytes (see proto/fixtures/collection_service.json for the wire-roundtrip conformance fixture — that one has placeholders, this one has real data). The UI client decodes data_json/schema_json before rendering, so it consumes shapes like those shown below.",
    "differs_from": "proto/fixtures/collection_service.json is proto-conformance (test-id placeholders). THIS file is rich demo data for building/screenshotting the UI before backend wiring.",
    "scope": "device/account/space-agnostic; treat all as one space's collections."
  },

  "List.response": {
    "collections": [
      { "id": "notes",       "title": "Notes",    "item_count": 3,  "system": false },
      { "id": "tasks",       "title": "Tasks",    "item_count": 5,  "system": false },
      { "id": "contacts",    "title": "Contacts", "item_count": 2,  "system": false },
      { "id": "feedback",    "title": "Feedback", "item_count": 8,  "system": true },
      { "id": "annotations", "title": "Annotations", "item_count": 14, "system": true }
    ]
  },

  "schemas": {
    "_note": "Decoded schema_json. Demonstrates the full type vocabulary + constraints the schema editor must render. notes=simple, tasks=rich (every type + constraints), contacts=has a ref-ish field as plain text (relations deferred).",
    "notes": {
      "title": "Notes",
      "fields": [
        { "name": "title",    "type": "text",      "required": true },
        { "name": "content",  "type": "text" },
        { "name": "priority", "type": "integer",   "default": 1, "indexed": true },
        { "name": "pinned",   "type": "bool",      "default": false }
      ]
    },
    "tasks": {
      "title": "Tasks",
      "fields": [
        { "name": "title",       "type": "text",      "required": true },
        { "name": "status",      "type": "text",      "required": true, "default": "todo", "indexed": true },
        { "name": "estimate_h",  "type": "real" },
        { "name": "priority",    "type": "integer",   "default": 2, "indexed": true },
        { "name": "done",        "type": "bool",      "default": false },
        { "name": "due",         "type": "timestamp", "indexed": true },
        { "name": "labels",      "type": "json" },
        { "name": "external_id", "type": "text",      "unique": true }
      ]
    },
    "contacts": {
      "title": "Contacts",
      "fields": [
        { "name": "name",     "type": "text", "required": true },
        { "name": "email",    "type": "text", "unique": true },
        { "name": "company",  "type": "text" }
      ]
    },
    "feedback": {
      "title": "Feedback",
      "system": true,
      "fields": [
        { "name": "target",  "type": "text", "required": true },
        { "name": "body",    "type": "text", "required": true },
        { "name": "rating",  "type": "integer" }
      ]
    }
  },

