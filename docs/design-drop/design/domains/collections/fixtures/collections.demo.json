  "watch_stream": {
    "_note": "Live sequence for sui-collection-table on collection=notes. Frame 1 = set-at-root snapshot. Then incremental patches mirroring patch.ts ops. Values shown decoded.",
    "frames": [
      { "seq": 1, "kind": "snapshot", "patches": [
        { "op": "set", "path": "", "value": { "items": [
          { "id": "note-checkout", "data": { "title": "Checkout notes", "priority": 3, "pinned": true } },
          { "id": "note-jwt", "data": { "title": "Auth via JWT", "priority": 5, "pinned": true } },
          { "id": "note-kysely", "data": { "title": "Spike kysely", "priority": 1, "pinned": false } }
        ] } }
      ]},
      { "seq": 2, "kind": "patch", "_why": "new item created elsewhere", "patches": [
        { "op": "append", "path": "items", "value": { "id": "note-new", "data": { "title": "Gate ship-collection", "priority": 4, "pinned": false } } }
      ]},
      { "seq": 3, "kind": "patch", "_why": "note-kysely pinned toggled", "patches": [
        { "op": "merge", "path": "items[2]", "value": { "pinned": true } }
      ]},
      { "seq": 4, "kind": "patch", "_why": "note-checkout deleted", "patches": [
        { "op": "remove", "path": "items[0]" }
      ]},
      { "seq": 5, "kind": "heartbeat", "ts": "2026-05-31T22:45:00Z" }
    ]
  },

  "errors": {
    "_note": "Error states the UI must render. Match repo tone semantics: validation → warning, hard failure → destructive.",
    "validation_unknown_field": {
      "rpc": "CreateItem",
      "tone": "warning",
      "message": "Field 'piority' is not in the notes schema. Did you mean 'priority'?"
    },
    "validation_type_mismatch": {
      "rpc": "UpdateItem",
      "tone": "warning",
      "message": "Field 'priority' expects integer, got \"high\"."
    },
    "query_unsupported_ast": {
      "rpc": "QueryItems",
      "tone": "destructive",
      "message": "Query rejected: JOINs are not supported. Collections query a single table."
    },
    "schema_reserved_id": {
      "rpc": "CreateSchema",
      "tone": "destructive",
      "message": "'feedback' is a reserved system collection id."
    },
    "reproject_warning": {
      "rpc": "UpdateSchema",
      "tone": "warning",
      "message": "Removing field 'estimate_h' will rebuild the projection from the event log. Existing item data is preserved; the column is dropped from the table. Continue?"
    }
  },

  "empty_states": {
    "no_collections": { "title": "No collections yet", "body": "Create one to start storing structured data.", "cta": "New collection" },
    "empty_collection": { "title": "No items in tasks", "body": "Add the first item, or edit the schema.", "cta": "New item" },
    "empty_filtered": { "title": "No matches", "body": "5 items stored, none match the current filters.", "cta": "Clear filters" },
    "query_no_results": { "title": "0 rows", "body": "The query ran in 0.6ms and matched nothing." }
  }
