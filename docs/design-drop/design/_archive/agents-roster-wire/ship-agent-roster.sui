<!--
  ship-agent-roster.sui — @ship/agents surface (the /agents roster). NET-NEW
  feature mock (no imported source); authored to the agents domain. A grid of
  agent cards: tinted initial tile, name, status dot + label, model chip, and
  last-active / run-count meta. Static realistic content. Compiled <ship-agent-roster>.
-->
<style>
  :host { display: block; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(228px, 1fr)); gap: 12px; }
  .ag { display: flex; flex-direction: column; gap: 10px; padding: 14px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); box-shadow: var(--shadow-xs); }
  .top { display: flex; align-items: center; gap: 10px; }
  .tile { width: 36px; height: 36px; flex: 0 0 auto; border-radius: var(--radius-md); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 14px; }
  .t-a { background: color-mix(in oklch, var(--primary) 16%, var(--card)); color: color-mix(in oklch, var(--primary) 88%, var(--foreground)); }
  .t-b { background: color-mix(in oklch, var(--accent) 16%, var(--card)); color: color-mix(in oklch, var(--accent) 88%, var(--foreground)); }
  .t-c { background: color-mix(in oklch, var(--info) 16%, var(--card)); color: color-mix(in oklch, var(--info) 88%, var(--foreground)); }
  .t-d { background: color-mix(in oklch, var(--success) 16%, var(--card)); color: color-mix(in oklch, var(--success) 88%, var(--foreground)); }
  .who { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .nm { font-weight: 600; font-size: var(--text-sm); }
  .st { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); }
  .dot { width: 7px; height: 7px; border-radius: 50%; }
  .on { background: var(--success); } .idle { background: var(--warning); } .err { background: var(--destructive); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { font-family: var(--font-mono); font-size: 10px; padding: 2px 8px; border-radius: var(--radius-full); background: var(--muted); border: 1px solid var(--border-subtle); color: var(--foreground); }
  .meta { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; color: var(--muted-foreground); border-top: 1px solid var(--border-subtle); padding-top: 9px; }
</style>

<div class="grid" part="roster">
  <div class="ag">
    <div class="top"><span class="tile t-a">RX</span><div class="who"><span class="nm">reindex-bot</span><span class="st"><span class="dot on"></span>online</span></div></div>
    <div class="chips"><span class="chip">claude-sonnet</span><span class="chip">4 tools</span></div>
    <div class="meta"><span>active now</span><span>1,204 runs</span></div>
  </div>
  <div class="ag">
    <div class="top"><span class="tile t-b">TR</span><div class="who"><span class="nm">triage-agent</span><span class="st"><span class="dot on"></span>online</span></div></div>
    <div class="chips"><span class="chip">claude-opus</span><span class="chip">7 tools</span></div>
    <div class="meta"><span>2m ago</span><span>88 runs</span></div>
  </div>
  <div class="ag">
    <div class="top"><span class="tile t-c">DG</span><div class="who"><span class="nm">digest-writer</span><span class="st"><span class="dot idle"></span>idle</span></div></div>
    <div class="chips"><span class="chip">claude-haiku</span><span class="chip">2 tools</span></div>
    <div class="meta"><span>3h ago</span><span>342 runs</span></div>
  </div>
  <div class="ag">
    <div class="top"><span class="tile t-d">OC</span><div class="who"><span class="nm">oncall-router</span><span class="st"><span class="dot err"></span>error</span></div></div>
    <div class="chips"><span class="chip">claude-sonnet</span><span class="chip">5 tools</span></div>
    <div class="meta"><span>failed 11:02</span><span>56 runs</span></div>
  </div>
</div>
