#!/bin/sh
# Debian pre-remove for the `ship` package.
#
# Stops and unregisters the systemd --user unit for the target user
# before dpkg removes /usr/bin/shipd.
set -eu

TARGET_USER="${SUDO_USER:-}"
TARGET_UID="${SUDO_UID:-}"

if [ -z "$TARGET_USER" ] || [ -z "$TARGET_UID" ] || [ "$TARGET_USER" = "root" ]; then
    exit 0
fi

USER_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6 2>/dev/null || echo '/home/'"$TARGET_USER")"
XDG_RUNTIME_DIR="/run/user/${TARGET_UID}"
export XDG_RUNTIME_DIR

su - "$TARGET_USER" -c "\
    XDG_RUNTIME_DIR='${XDG_RUNTIME_DIR}' \
    HOME='${USER_HOME}' \
    /usr/bin/shipctl daemon uninstall-service \
" >/dev/null 2>&1 || true
