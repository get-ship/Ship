# Dependencies
**/node_modules/
node_modules/
.tanstack/

# Cloudflare / Cloud
.wrangler/
.dev.vars
out-tsc/
*.tsbuildinfo

# Generated by apps/shipd/build.rs
apps/shipd/templates/_urls.html.j2
packages/sdk/src/generated/
packages/ship-set/src/generated.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
/coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-temporary-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm
.pnpm-store

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Mac files
.DS_Store

dist/

# Added by cargo
/target

# Ship worktrees — ephemeral, never commit
.ship/worktrees/

# Workspace .cargo/config.toml is committed (per devx-01, target-dir is workspace-relative).
# Per-user overrides go in .cargo/config.local.toml (gitignored).
.cargo/config.local.toml

# Ship runtime state — local-only, never commit
.ship/platform.db
.ship/platform.db-*
.ship/*.db
.ship/*.db-journal
.ship/*.db-wal
.ship/*.db-shm

# Ship — generated agent config (never commit these)
CLAUDE.md
GEMINI.md
AGENTS.md
.mcp.json
.agents/
.agent/
.qwen/
.claude/
.gemini/
.codex/
skills-lock.json
.gstack/
.artifacts/
.cursor/
.opencode/
opencode.json
.ship-session/
.playwright-cli/
test-results/

# Canvas agent scratch — canvas artifacts live in the artifacts collection
# (data.db + ~/.ship/artifacts/<project>/blobs/), never on disk under .ship/.
.artifacts/canvas/
.ship/views/datastar.min.js
.ship/views/*.min.js

# Shell build output — populated by `pnpm -F shell build`.
apps/shell/dist/
apps/shell/qa-evidence/

# JS asset bundles — built on demand by `pnpm build:bundles` from
# packages/ship-set/src/web-components/. The daemon `include_str!`s them at
# compile time, so they must exist before `cargo build -p shipd`.
# datastar.js is a tiny 3rd-party client — kept tracked.
apps/shipd/assets/ship-elements.js
apps/shipd/assets/ship-code-editor.js
apps/shipd/assets/ship-markdown-editor.js
apps/shipd/assets/ship-terminal.js
apps/shipd/assets/custom-elements.json
apps/shipd/assets/ship-elements.md
apps/shipd/assets/sui-runtime.js
apps/shipd/assets/sui-dom.js
apps/shipd/assets/sui-sdk-client.js
apps/shipd/assets/sui-components.js
apps/shipd/assets/.cache/

# Legacy shell vendor dir — shell now loads bundles via /api/runtime/assets/*.
apps/shell/public/vendor/

# loop test results — local only
tests/loops/results/

# Playwright e2e output — local only
tests/e2e/report/
tests/e2e/screenshots/
playwright-report/
views/*/view.js
views/*/view.schema.json
# sui-compiler emits <file>.sui.d.ts alongside each .sui; regenerated artifact.
**/*.sui.d.ts

# SUI components AOT artifacts. sui-compiler emits
# <tag>.compiled.js + <tag>.schema.json next to each .sui source;
# index.ts side-effect-imports each .compiled.js. esbuild inlines
# them into apps/shipd/assets/sui-components.js so only the
# bundle ships.
packages/ui-components/src/*/*.compiled.js
packages/ui-components/src/*/*.schema.json
packages/ui-components/src/*/*.custom-elements.json

# Per-view compile cache emitted by sui-compiler / build-bundles.
views/*/.compiled/
