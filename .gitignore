.agent/
.claude/
.gemini/
skills-lock.json
.artifacts/*
.cursor/
.opencode/
opencode.json
.ship-session/
.playwright-cli/
.playwright/
test-results/

# Canvas agent scratch — canvas artifacts live in the artifacts collection
# (per-space space.db + ~/.ship/artifacts/<project>/blobs/), never on disk
# under .ship/.
.artifacts/canvas/

.ship/views/datastar.min.js
.ship/views/*.min.js

# deck's OWN baked product — sui-runtime/dom/sdk-client + the primitives
# umbrella (sui-components.js). Canonical bake target is .deck/framework/
# (covered by the `.deck/` rule below). build.rs copies .deck/framework/sui-*.js
# → crates/deck/deck-core/assets/ at compile time (the include_str! staging path).
# The crate-assets *.js copies are build-script-owned artifacts — gitignored here.
# NOT tracked — produced on demand by:
#   * `cargo run -p deck-cli -- build-assets` (in-process Rolldown, the only bundler)
#   * `dispatch.sh`, which bootstraps fresh worktrees from the launching repo
# `view-host.html` and `live-reload.js` are hand-authored source and stay
# tracked — they're `include_str!`'d into the crate, not bundler output.
crates/deck/deck-core/assets/*.js
!crates/deck/deck-core/assets/live-reload.js
# lucide-icons.json IS committed source — it's the embedded set the daemon
# serves per-icon via `/_deck/icons/{name}.svg`. Regenerate after a
# lucide-static version bump: `cargo run -p xtask -- gen-icons`.
crates/deck/deck-core/assets/sui-custom-elements.json

# deck build output — app/user view + chrome bundles (deck's `.next/`-equivalent).
# View bundles (.deck/views/<name>/view.js) and code-split chrome/islands
# (.deck/sui-components/<tag>.js) build here; deck-core reads them from the
# project's `.deck/` at runtime via read_deck_asset. Never tracked.
.deck/

# apps/shipd/assets/ holds committed source (view-tokens.css). Generated or
# vendored *.js files that appear here (e.g. from build tooling) are ignored
# so they are never accidentally committed. The build cache is also local-only.
apps/shipd/assets/*.js
apps/shipd/assets/.cache/

# Legacy shell vendor dir — shell now loads bundles via /api/runtime/assets/*.
apps/shell/public/vendor/

# Third-party vendored source is never committed. Per the component-architecture
# ADR, external engines are declared deps (ship-tier: dependency; sui-tier:
# devDependency) inlined at build by the bundler — pinning is the lockfile,
# license control is `just license-check` (scripts/check-licenses.mjs) in CI.
# Any future `vendor/` dir under a package holds third-party bytes and must not
# be tracked. (Hand-authored files like `*/test/vendor-*.test.ts` are NOT in a
# vendor/ directory, so this does not touch them.)
packages/**/vendor/

# loop test results — local only

# Playwright e2e output — local only
tests/e2e/report/
tests/e2e/screenshots/
tests/e2e/tests/
tests/e2e/test-results/
tests/e2e/**/*-snapshots/
playwright-report/
# sui-compiler emits <file>.sui.d.ts alongside each .sui; regenerated artifact.
# d.ts stays next to source so `import type { Scope } from './foo.sui'` resolves.
**/*.sui.d.ts

# Per-view compile cache emitted by sui-compiler / build-bundles.
views/*/.compiled/
.sui-build-cache.json

# tree-sitter outputs — generated by `tree-sitter generate` in the external
# sui repo post-carve (the sui-grammar Rust crate builds there). The

# OpenAPI snapshot is generated by `just openapi-regen` but IS expected
# to be committed — apps/shipd's routes::openapi::tests reads the file
# from disk to verify the committed spec stays in sync with the live
# utoipa-derived spec. Run `just openapi-regen` after touching route
# handlers + commit the regenerated file.

# SDK manifests are BUILD INPUTS to shipd (embedded via include_str! in
# apps/shipd/src/routes/sdk_manifest.rs). Tracked so `cargo build` works
# without first running `just gen-sdk`. Refresh with `just gen-sdk` after
# touching the routes that the manifest reflects.

# Per-worktree isolation marker — created by `just init-worktree`, never committed.
.ship/.boundary
.artifacts/

# Generated view artifacts — bundler outputs to crates/deck/deck-core/assets/
views/*/view.js
views/*/dist/
views/*/node_modules/
views/*/*.d.ts

# Local daemon runtime state created when shipd runs with cwd=repo
/machine/

# Chrome Lighthouse profile dumps — WSL receives Windows paths as literal
# directory names with backslashes when astro/lighthouse runs from Windows.
apps/site/C:*
apps/*/C:*

# Site generated assets (produced by apps/site/scripts/copy-sui-assets.ts).
# Source of truth is the SUI build; the site only re-publishes them.
apps/site/public/_deck/icons/
apps/site/public/_deck/syntax-tokens.css
apps/site/public/sui-components/

# sui-eval is a local dogfood harness. Its scripts are acceptable pipeline
# machinery (tracked), but the per-job task spec + reference mockups are job
# artifacts and must never be committed (CLAUDE.md: artifacts → .artifacts/).
.ship/pipelines/sui-eval/task-spec.md
.ship/pipelines/sui-eval/mockups/

# Spikes — scratch directories, never tracked
/spikes

# Local helmd build output (Rust, similar to /target but scoped).
apps/helmd/target/

# Codex local IDE scratch — config.toml, agents/, hooks.json. Per-user
# tool state, never committed. (`.codex/` shows up in fresh clones as a
# stale empty dir from a prior local dev run.)
.codex/

# Local loop-test results — dev-time probe scratch only. tests/loops/
# itself was untracked and dropped from source in the post-multi-repo
# cleanup (the loops harness lives elsewhere); the `results/` is the
# final untracked residue.
tests/loops/
