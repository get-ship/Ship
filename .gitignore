# Shell build output now lives at .deck/hub-scaffold/ (daemon-served like
# spaces); apps/shell/dist/ is retired. The `.deck/` rule below covers it.
apps/shell/qa-evidence/

# Lit `<ship-*>` web-component bundles — built by `bun run --filter @ship/set build`
# from packages/ship-set/src/web-components/. Embedded into shipd via
# include_str! at compile time, so they must exist before `cargo build -p shipd`.
# datastar.js is a tiny 3rd-party client — kept tracked.
apps/shipd/assets/ship-elements.js
apps/shipd/assets/ship-code-editor.js
apps/shipd/assets/ship-markdown-editor.js
apps/shipd/assets/ship-terminal.js
apps/shipd/assets/ship-git.js
apps/shipd/assets/custom-elements.json
apps/shipd/assets/ship-elements.md
apps/docs/public/ship-elements.js
apps/docs/public/ship-*.js
# deck's OWN baked product — sui-runtime/dom/sdk-client + the primitives
# umbrella (sui-components.js) + lucide. Generated build outputs consumed by
# `cargo build -p shipd` via include_str! in crates/deck/deck-core/src/assets.rs
# (build.rs panics if missing). NOT tracked — produced on demand by:
#   * `just bootstrap` / `just dev-build-all` (bun packages/deck/bundler/index.ts)
#   * the in-daemon Bun worker (`~/.ship/runtime/bundler.ts`) in dev mode
#   * `dispatch.sh`, which bootstraps fresh worktrees from the launching repo
# `view-host.html` and `live-reload.js` are hand-authored source and stay
# tracked — they're `include_str!`'d into the crate, not bundler output.
crates/deck/deck-core/assets/*.js
!crates/deck/deck-core/assets/live-reload.js
# lucide-icons.json IS committed source — it's the embedded set the daemon
# serves per-icon via `/_sui/icons/{name}.svg`. Regenerate after a
# lucide-static version bump: `cargo run -p xtask -- gen-icons`.
crates/deck/deck-core/assets/sui-custom-elements.json

# deck build output — app/user view + chrome bundles (deck's `.next/`-equivalent).
# View bundles (.deck/views/<name>/view.js) and code-split chrome/islands
# (.deck/sui-components/<tag>.js) build here; deck-core reads them from the
# project's `.deck/` at runtime via read_deck_asset. Never tracked.
.deck/
# Stale dir retired by islands-rename — bundler now emits to
# crates/deck/deck-core/assets/ exclusively. Keep ignored in case
# any stale tooling tries to write here.
crates/sui/ship-ui-framework/
# Same — bundler used to mis-target this path; nothing consumes it.
crates/deck/deck/assets/
# Stale wrong-path: a pre-reorg daemon bundler emitted view bundles here
# (the crate is now crates/deck/deck-core). Ignored so stray writes from an
# un-updated runtime bundler never get committed again.
crates/sui/ship-sui-server/

# Stale sui-* dupes that used to be emitted into apps/shipd/assets/ — the
# bundle scripts now target crates/deck/deck-core/assets/ exclusively.
# The daemon's `.cache` is gitignored separately.
apps/shipd/assets/sui-runtime.js
apps/shipd/assets/sui-dom.js
apps/shipd/assets/sui-sdk-client.js
apps/shipd/assets/sui-components.js
apps/shipd/assets/sui-custom-elements.json
apps/shipd/assets/sui-code-editor.js
apps/shipd/assets/sui-command-bar.js
apps/shipd/assets/sui-devtools.js
apps/shipd/assets/sui-launcher.js
apps/shipd/assets/sui-markdown-editor.js
apps/shipd/assets/sui-nav-top.js
apps/shipd/assets/sui-panel-dock.js
apps/shipd/assets/sui-terminal.js
apps/shipd/assets/sui-components/
apps/shipd/assets/views/
apps/shipd/assets/.cache/

# Legacy shell vendor dir — shell now loads bundles via /api/runtime/assets/*.
apps/shell/public/vendor/

