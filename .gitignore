# Shell build output — populated by `pnpm -F shell build`.
apps/shell/dist/
apps/shell/qa-evidence/

# Lit `<ship-*>` web-component bundles — built by `pnpm -F @ship/set build`
# from packages/ship-set/src/web-components/. Embedded into shipd via
# include_str! at compile time, so they must exist before `cargo build -p shipd`.
# datastar.js is a tiny 3rd-party client — kept tracked.
apps/shipd/assets/ship-elements.js
apps/shipd/assets/ship-code-editor.js
apps/shipd/assets/ship-markdown-editor.js
apps/shipd/assets/ship-terminal.js
apps/shipd/assets/custom-elements.json
apps/shipd/assets/ship-elements.md
# SUI framework + view bundles are BUILD INPUTS to `cargo build -p shipd`
# (via include_str! in crates/ship-sui-server/src/assets.rs; build.rs panics
# if missing). Tracked so `cargo build` works on a fresh clone without first
# running the JS toolchain. Producers regenerate them on demand:
#   `pnpm -F @ship/sui-runtime bundle`, `@ship/sui-dom bundle`,
#   `@ship/sdk-client bundle`, `pnpm -F @ship/ui-components build`,
#   `pnpm -F @ship/set icons`, plus the in-daemon Bun worker in dev mode.
# To refresh in a worktree: `just bundle` (or the producers above).
# The daemon's `.cache` is gitignored separately.
# Stale sui-* dupes that used to be emitted into apps/shipd/assets/ — the
# bundle scripts now target crates/ship-sui-server/assets/ exclusively.
apps/shipd/assets/sui-runtime.js
apps/shipd/assets/sui-dom.js
apps/shipd/assets/sui-sdk-client.js
apps/shipd/assets/sui-components.js
apps/shipd/assets/sui-custom-elements.json
apps/shipd/assets/sui-code-editor.js
apps/shipd/assets/sui-command-bar.js
apps/shipd/assets/sui-devtools.js
apps/shipd/assets/sui-launcher.js
apps/shipd/assets/sui-markdown-editor.js
apps/shipd/assets/sui-nav-top.js
apps/shipd/assets/sui-panel-dock.js
apps/shipd/assets/sui-terminal.js
apps/shipd/assets/sui-islands/
apps/shipd/assets/views/
apps/shipd/assets/.cache/

# Legacy shell vendor dir — shell now loads bundles via /api/runtime/assets/*.
apps/shell/public/vendor/

# loop test results — local only
tests/loops/results/

# Playwright e2e output — local only
tests/e2e/report/
tests/e2e/screenshots/
playwright-report/
# sui-compiler emits <file>.sui.d.ts alongside each .sui; regenerated artifact.
# d.ts stays next to source so `import type { Scope } from './foo.sui'` resolves.
**/*.sui.d.ts

# Per-view compile cache emitted by sui-compiler / build-bundles.
views/*/.compiled/
.sui-build-cache.json

# tree-sitter outputs — generated from grammar.js by `tree-sitter generate`.
# Regenerated by dispatch.sh's bootstrap on fresh worktrees.
# tree-sitter outputs are BUILD INPUTS to `cargo build -p sui-grammar`
# (binding.gyp + Cargo build.rs compile parser.c). Tracked so the Rust crate
# builds without first running `pnpm exec tree-sitter generate`.
# To refresh: `cd packages/sui-grammar && pnpm exec tree-sitter generate`.

# Committed OpenAPI snapshot is regenerated by `apps/docs` prebuild
# (`pnpm run openapi:generate`) — no need to track.
apps/docs/openapi.json

# SDK manifests are BUILD INPUTS to shipd (embedded via include_str! in
# apps/shipd/src/routes/sdk_manifest.rs). Tracked so `cargo build` works
# without first running `just gen-sdk`. Refresh with `just gen-sdk` after
# touching the routes that the manifest reflects.
