.DS_Store

dist/

# sui-compiler tooling output mirror (dev-time only). Default `.ship/sui-out`
# (configurable via SUI_OUT_DIR) — this monorepo is a Ship project, so the
# mirror lives under `.ship/` exactly as it does on customer machines.
.ship/sui-out/

# Added by cargo
/target

# Ship worktrees — ephemeral, never commit
.ship/worktrees/

# Workspace .cargo/config.toml is committed (per devx-01, target-dir is workspace-relative).
# Per-user overrides go in .cargo/config.local.toml (gitignored).
.cargo/config.local.toml

# Ship runtime state — local-only, never commit
.ship/platform.db
.ship/platform.db-*
.ship/*.db
.ship/*.db-journal

# Stray project-local trash — canonical trash lives in ~/.ship/trash/ (substrate
# trash.rs). Nothing should write trash into the committed .ship/ config dir.
.ship/.trash/
.ship/*.db-wal
.ship/*.db-shm

