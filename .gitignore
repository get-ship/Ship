# Specta-generated TS bindings. Checked in (post-carve `cargo xtask gen-types`
# no longer reaches this repo from a clean checkout) so tsc/build stays green
# without an out-of-band `cargo xtask gen-types` step. Refresh after touching
# the specta-derive Rust structs: `cargo xtask gen-types --check` reports
# drift; regenerate with `cargo xtask gen-types` and commit the diff.
packages/cloud-types/src/generated.ts
# deck routes/meta codegen (deck-bundler `deck routes` output — regenerated on build)
apps/*/routes.gen.ts
**/components.gen.ts
views/*.gen.ts

# Playwright visual-baseline output (actual screenshots + diffs).
# Baselines under tests/e2e/visual/baselines/ ARE committed.
tests/e2e/visual/output/
tests/e2e/visual/report/

