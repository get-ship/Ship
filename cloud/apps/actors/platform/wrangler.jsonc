{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "platform-handler",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Platform",
        "name": "PLATFORM"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Platform"],
      "tag": "v1"
    }
  ],
  "observability": {
    "enabled": true
  }
}
